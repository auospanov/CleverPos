        '110132348=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_OFFIC' +
        'IAL'#39';'
      
        '110132349=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110132350=begin'
      '110132351='
      '110132352=  -- '#1053#1045#1051#1068#1047#1071' '#1059#1044#1040#1051#1048#1058#1068' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '110132353=  SELECT ID'
      '110132354=    FROM CUR_PARAMS'
      '110132355=   WHERE CUR_PARAMS = 1'
      '110132356=     AND (SELECT COUNT(*) FROM G_OFFICIAL) > 1'
      '110132357=    INTO G_OFFICIAL_CUR_;'
      '110132358='
      
        '110132359=  if (COALESCE(G_OFFICIAL_CUR_, 0) = G_OFFICIAL_) then' +
        ' BEGIN'
      '110132360=    ERR_CODE = -20500;'
      
        '110132361=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076 +
        #1072#1083#1080#1090#1100' '#1089#1072#1084#1086#1075#1086' '#1089#1077#1073#1103'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110132362=    EXIT;'
      '110132363=  END'
      '110132364='
      '110132365=  DELETE FROM G_OFFICIAL_RIGHT R'
      '110132366=    WHERE R.G_OFFICIAL = :G_OFFICIAL_;'
      '110132367='
      '110132368=  delete from G_OFFICIAL g'
      '110132369=    where g.G_OFFICIAL = :G_OFFICIAL_;'
      '110132370='
      '110132371=when sqlcode -530 DO'
      '110132372=  begin'
      '110132373=    /*ERR_CODE = -20500;'
      
        '110132374=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110132375=    ERR_MSG = PROCNAME||ERR_MSG;*/'
      '110132376=    UPDATE G_OFFICIAL G'
      '110132377=       SET G.IS_ACTIVE = 0'
      '110132378=     where g.G_OFFICIAL = :G_OFFICIAL_;'
      '110132379=  end'
      '110132380=end'
      '110132381=;'
      '110132382='
      '110132383=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110132384=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110132385=RETURNS ('
      
        '110132386=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110132387=  ARTICUL_ VARCHAR(30),'
      '110132388=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110132389=  BARCODE_ VARCHAR(30),'
      '110132390=  NAME_ VARCHAR(500),'
      '110132391=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110132392=  PRICE_ NUMERIC(15,2),'
      '110132393=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110132394=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110132395=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110132396=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110132397=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110132398=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110132399=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110132400=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110132401=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110132402=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110132403=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110132404=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      
        '110132405=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110132406=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110132407=  ERR_CODE INTEGER,'
      '110132408=  ERR_MSG VARCHAR(1024))'
      '110132409=AS'
      '110132410=begin'
      '110132411=    SELECT'
      '110132412=        G_PRODUCT_PAR,'
      '110132413=        ARTICUL,'
      '110132414=        NOMENCLATUR_NUM,'
      '110132415=        BARCODE,'
      '110132416=        NAME,'
      '110132417=        G_UNIT,'
      '110132418=        PRICE,'
      '110132419=        VOLUME_PRICE,'
      '110132420=        PACK_AMOUNT,'
      '110132421=        MF_COUNTRY,'
      '110132422=        NOTE,'
      '110132423=        CROSSCODE,'
      '110132424=        IS_KIT,'
      '110132425=        MIN_AMOUNT,'
      '110132426=        PLACE,'
      '110132427=        SALES_COMM,'
      '110132428=        KOD_TNVD,'
      '110132429=        FAST_TOVAR,'
      '110132430=        DO_NOT_SHOW_RMK,'
      '110132431=        DO_NOT_CHARGE_BONUS,'
      
        '110132432=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1))'
      '110132433=    FROM G_PRODUCT T'
      '110132434=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110132435=    INTO'
      '110132436=        :G_PRODUCT_PAR_,'
      '110132437=        :ARTICUL_,'
      '110132438=        :NOMENCLATUR_NUM_,'
      '110132439=        :BARCODE_,'
      '110132440=        :NAME_,'
      '110132441=        :G_UNIT_,'
      '110132442=        :PRICE_,'
      '110132443=        :VOLUME_PRICE_,'
      '110132444=        :PACK_AMOUNT_,'
      '110132445=        :MF_COUNTRY_,'
      '110132446=        :NOTE_,'
      '110132447=        :CROSSCODE_,'
      '110132448=        :IS_KIT_,'
      '110132449=        :MIN_AMOUNT_,'
      '110132450=        :PLACE_,'
      '110132451=        :SALES_COMM_,'
      '110132452=        :KOD_TNVD_,'
      '110132453=        :FAST_TOVAR_,'
      '110132454=        :DO_NOT_SHOW_RMK_,'
      '110132455=        :DO_NOT_CHARGE_BONUS_,'
      '110132456=        :LAST_PRICE_;'
      '110132457='
      '110132458=    INSERT INTO LT_BARCODE_TMP'
      
        '110132459=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110132460='
      '110132461=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110132462=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110132463='
      '110132464=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '110132465=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '110132466=end'
      '110132467=;'
      '110132468='
      '110132469=ALTER PROCEDURE G_INS_G_OFFICIAL('
      '110132470=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110132471=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110132472=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110132473=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110132474=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110132475=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110132476=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110132477=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110132478=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110132479=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110132480=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110132481=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110132482=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110132483=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110132484=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110132485=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110132486=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110132487=  RIGHTS_ARR_ VARCHAR(500),'
      
        '110132488=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.DO_NOT_' +
        'SALES_COMM,'
      '110132489=  KOD_ TYPE OF COLUMN G_OFFICIAL.KOD)'
      '110132490=RETURNS ('
      '110132491=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110132492=  ERR_CODE INTEGER,'
      '110132493=  ERR_MSG VARCHAR(1024))'
      '110132494=AS'
      
        '110132495=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110132496=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110132497=begin'
      '110132498='
      
        '110132499=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110132500=      UPDATE G_OFFICIAL G'
      '110132501=         SET G.IS_ISPOLNITEL = 0;'
      '110132502='
      
        '110132503=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110132504=      UPDATE G_OFFICIAL G'
      '110132505=         SET G.IS_RUKOVODITEL = 0;'
      '110132506='
      
        '110132507=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110132508=      UPDATE G_OFFICIAL G'
      '110132509=         SET G.IS_GLAVBUH = 0;'
      '110132510='
      
        '110132511=    insert into G_OFFICIAL (G_OFFICIAL, FM, NM, FT, FI' +
        'O_DOC, RNN, IDN, DT, G_ID_KIND, ID_NUM, ID_DATE, ID_ISSUER,'
      
        '110132512=                            G_APPOINTMENT, IS_RUKOVODI' +
        'TEL, IS_GLAVBUH, IS_ISPOLNITEL, PASS, G_TOCHKA, DO_NOT_SALES_COM' +
        'M, KOD,'
      '110132513=                            IS_ACTIVE)'
      
        '110132514=    values (GEN_ID(GEN_G_OFFICIAL, 1), :FM_, :NM_, :FT' +
        '_, :FIO_DOC_, :RNN_, :IDN_, :DT_, :G_ID_KIND_, :ID_NUM_, :ID_DAT' +
        'E_, :ID_ISSUER_,'
      
        '110132515=            :G_APPOINTMENT_, :IS_RUKOVODITEL_, :IS_GLA' +
        'VBUH_, :IS_ISPOLNITEL_, :PASSWORD_, :G_TOCHKA_, :DO_NOT_SALES_CO' +
        'MM_, :KOD_,'
      '110132516=            1)'
      '110132517=    returning G_OFFICIAL'
      '110132518=    into :G_OFFICIAL_;'
      '110132519='
      '110132520=    FOR SELECT T.RIGHTS_ITEM'
      '110132521=        FROM RIGHTS_ITEM T'
      '110132522=       WHERE T.IS_CATEGORY = 0'
      
        '110132523=         AND :RIGHTS_ARR_ CONTAINING '#39'-'#39'||T.RIGHTS_ITE' +
        'M||'#39'-'#39
      '110132524=        INTO :RIGHTS_ITEM_'
      '110132525=    DO BEGIN'
      
        '110132526=      INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT, ' +
        'RIGHTS_ITEM, G_OFFICIAL)'
      
        '110132527=      VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGHTS' +
        '_ITEM_, :G_OFFICIAL_);'
      '110132528=    END'
      '110132529='
      
        '110132530=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110132531=    SELECT COUNT(G.G_OFFICIAL)'
      '110132532=      FROM G_OFFICIAL G'
      '110132533=     WHERE EXISTS (SELECT 1'
      '110132534=                     FROM G_OFFICIAL_RIGHT R'
      '110132535=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110132536=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110132537=    INTO :CNT_;'
      '110132538='
      '110132539=    IF (:CNT_ = 0) THEN BEGIN'
      '110132540=      ERR_CODE = -20500;'
      
        '110132541=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1086#1073#1093#1086#1076 +
        #1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087#1088 +
        #1072#1074#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110132542=      EXIT;'
      '110132543=    END'
      '110132544=end'
      '110132545=;'
      '110132546='
      '110132547=ALTER PROCEDURE G_READ_G_OFFICIAL_LIST'
      '110132548=RETURNS ('
      '110132549=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110132550=  FM TYPE OF COLUMN G_OFFICIAL.FM,'
      '110132551=  NM TYPE OF COLUMN G_OFFICIAL.NM,'
      '110132552=  FT TYPE OF COLUMN G_OFFICIAL.FT,'
      '110132553=  FIO VARCHAR(200),'
      '110132554=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110132555=  RNN TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110132556=  IDN TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110132557=  DT TYPE OF COLUMN G_OFFICIAL.DT,'
      '110132558=  G_ID_KIND TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110132559=  ID_NUM TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110132560=  ID_DATE TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110132561=  ID_ISSUER TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110132562=  G_APPOINTMENT TYPE OF COLUMN G_OFFICIAL.G_APPOINTMEN' +
        'T,'
      
        '110132563=  IS_RUKOVODITEL TYPE OF COLUMN G_OFFICIAL.IS_RUKOVODI' +
        'TEL,'
      '110132564=  IS_GLAVBUH TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      '110132565=  APP_NAME TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '110132566=  PASS TYPE OF COLUMN G_OFFICIAL.PASS)'
      '110132567=AS'
      '110132568=begin'
      '110132569=    FOR'
      '110132570=    SELECT t.G_OFFICIAL,'
      '110132571=           T.FM,'
      '110132572=           T.NM,'
      '110132573=           T.FT,'
      
        '110132574=           COALESCE(T.FM, '#39#39')||COALESCE('#39' '#39'||T.NM, '#39#39')' +
        '||COALESCE('#39' '#39'||T.FT,  '#39#39'),'
      
        '110132575=           DECODE(CHAR_LENGTH(T.FIO_DOC), 0, T.FM||'#39' '#39 +
        '||T.NM||'#39' '#39'||T.FT, T.FIO_DOC),'
      '110132576=           T.RNN,'
      '110132577=           T.IDN,'
      '110132578=           T.DT,'
      '110132579=           T.G_ID_KIND,'
      '110132580=           T.ID_NUM,'
      '110132581=           T.ID_DATE,'
      '110132582=           T.ID_ISSUER,'
      '110132583=           T.G_APPOINTMENT,'
      '110132584=           T.IS_RUKOVODITEL,'
      '110132585=           T.IS_GLAVBUH,'
      '110132586=           G.NAME APP_NAME'
      '110132587=           ,T.PASS'
      
        '110132588=      FROM g_OFFICIAL t LEFT OUTER JOIN G_APPOINTMENT ' +
        'G ON T.G_APPOINTMENT = G.G_APPOINTMENT'
      '110132589=     WHERE t.IS_ACTIVE = 1'
      '110132590=    ORDER BY T.G_OFFICIAL, T.FM, T.NM, T.FT'
      '110132591=    INTO :G_OFFICIAL,'
      '110132592=        :FM,'
      '110132593=        :NM,'
      '110132594=        :FT,'
      '110132595=        :FIO,'
      '110132596=        :FIO_DOC,'
      '110132597=        :RNN,'
      '110132598=        :IDN,'
      '110132599=        :DT,'
      '110132600=        :G_ID_KIND,'
      '110132601=        :ID_NUM,'
      '110132602=        :ID_DATE,'
      '110132603=        :ID_ISSUER,'
      '110132604=        :G_APPOINTMENT,'
      '110132605=        :IS_RUKOVODITEL,'
      '110132606=        :IS_GLAVBUH,'
      '110132607=        :APP_NAME'
      '110132608=        ,:PASS'
      '110132609=    DO'
      '110132610=      SUSPEND;'
      '110132611=end'
      '110132612=;'
      '110132613='
      '110132614=ALTER PROCEDURE G_READ_RUKOVODITEL_LIST('
      '110132615=  GLAVBUH_OR_RUKOVODITEL_ INTEGER)'
      '110132616=RETURNS ('
      '110132617=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110132618=  FM TYPE OF COLUMN G_OFFICIAL.FM,'
      '110132619=  NM TYPE OF COLUMN G_OFFICIAL.NM,'
      '110132620=  FT TYPE OF COLUMN G_OFFICIAL.FT,'
      '110132621=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110132622=  RNN TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110132623=  IDN TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110132624=  DT TYPE OF COLUMN G_OFFICIAL.DT,'
      '110132625=  G_ID_KIND TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110132626=  ID_NUM TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110132627=  ID_DATE TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110132628=  ID_ISSUER TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110132629=  G_APPOINTMENT TYPE OF COLUMN G_OFFICIAL.G_APPOINTMEN' +
        'T,'
      
        '110132630=  IS_RUKOVODITEL TYPE OF COLUMN G_OFFICIAL.IS_RUKOVODI' +
        'TEL,'
      '110132631=  IS_GLAVBUH TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      '110132632=  APP_NAME TYPE OF COLUMN G_APPOINTMENT.NAME)'
      '110132633=AS'
      '110132634=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '110132635=begin'
      '110132636=  IF (GLAVBUH_OR_RUKOVODITEL_ = 1) THEN'
      '110132637=    FOR'
      '110132638=      SELECT t.G_OFFICIAL,'
      '110132639=             T.FM,'
      '110132640=             T.NM,'
      '110132641=             T.FT,'
      '110132642=             T.FIO_DOC,'
      '110132643=             T.RNN,'
      '110132644=             T.IDN,'
      '110132645=             T.DT,'
      '110132646=             T.G_ID_KIND,'
      '110132647=             T.ID_NUM,'
      '110132648=             T.ID_DATE,'
      '110132649=             T.ID_ISSUER,'
      '110132650=             T.G_APPOINTMENT,'
      '110132651=             T.IS_RUKOVODITEL,'
      '110132652=             T.IS_GLAVBUH,'
      '110132653=             G.NAME'
      '110132654=        FROM g_OFFICIAL t,'
      '110132655=             G_APPOINTMENT G'
      '110132656=       WHERE T.G_APPOINTMENT = G.G_APPOINTMENT'
      '110132657=         AND T.IS_RUKOVODITEL = 1'
      '110132658=         AND T.IS_ACTIVE = 1'
      '110132659=      INTO :G_OFFICIAL,'
      '110132660=           :FM,'
      '110132661=           :NM,'
      '110132662=           :FT,'
      '110132663=           :FIO_DOC,'
      '110132664=           :RNN,'
      '110132665=           :IDN,'
      '110132666=           :DT,'
      '110132667=           :G_ID_KIND,'
      '110132668=           :ID_NUM,'
      '110132669=           :ID_DATE,'
      '110132670=           :ID_ISSUER,'
      '110132671=           :G_APPOINTMENT,'
      '110132672=           :IS_RUKOVODITEL,'
      '110132673=           :IS_GLAVBUH,'
      '110132674=           :APP_NAME'
      '110132675=    DO'
      '110132676=      SUSPEND;'
      '110132677=  ELSE BEGIN'
      '110132678=    SELECT COUNT(*)'
      '110132679=      FROM g_OFFICIAL t'
      '110132680=     WHERE T.IS_GLAVBUH = 1'
      '110132681=     INTO :CNT_;'
      '110132682='
      '110132683=    IF (CNT_ > 0) THEN'
      '110132684=      FOR'
      
        '110132685=          SELECT t.G_OFFICIAL, t.FM, t.NM, t.FT, t.FIO' +
        '_DOC, t.RNN, t.IDN, t.DT, t.G_ID_KIND, t.ID_NUM, t.ID_DATE, t.ID' +
        '_ISSUER, t.G_APPOINTMENT, t.IS_RUKOVODITEL, t.IS_GLAVBUH,'
      '110132686=                 G.NAME APP_NAME'
      '110132687=            FROM g_OFFICIAL t,'
      '110132688=                 G_APPOINTMENT G'
      '110132689=           WHERE T.G_APPOINTMENT = G.G_APPOINTMENT'
      '110132690=             AND T.IS_GLAVBUH = 1'
      '110132691=             AND T.IS_ACTIVE = 1'
      
        '110132692=          INTO :G_OFFICIAL, :FM, :NM, :FT, :FIO_DOC, :' +
        'RNN, :IDN, :DT, :G_ID_KIND, :ID_NUM, :ID_DATE, :ID_ISSUER, :G_AP' +
        'POINTMENT,'
      '110132693=               :IS_RUKOVODITEL, :IS_GLAVBUH, :APP_NAME'
      '110132694=      DO'
      '110132695=        SUSPEND;'
      '110132696=    ELSE'
      '110132697=      FOR'
      '110132698=          SELECT 0,'
      '110132699=                 '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39
      '110132700=            FROM RDB$DATABASE'
      '110132701=          INTO :G_OFFICIAL, :FIO_DOC'
      '110132702=      DO'
      '110132703=        SUSPEND;'
      '110132704=  END'
      '110132705=end'
      '110132706=;'
      '110132707='
      '110132708=ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '110132709=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110132710=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110132711=  MODE_ INTEGER)'
      '110132712=RETURNS ('
      '110132713=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '110132714=AS'
      '110132715=/*'
      
        '110132716=11.04.2019 '#1047#1053#1040#1052#1045#1053#1040#1058#1045#1051#1068#1053#1067#1049' '#1044#1045#1053#1068', '#1056#1045#1064#1048#1051' '#1058#1045#1055#1045#1056#1068' '#1048#1057#1050#1040#1058#1068' '#1053#1045 +
        ' '#1055#1054' IS_LAST, '#1040' '#1055#1054' MAX DATE_RECEIPT'
      '110132717=*/'
      
        '110132718=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE;'
      '110132719=BEGIN'
      '110132720=  IF (G_TOCHKA_ IS NULL) THEN'
      '110132721=    SELECT ID'
      '110132722=      FROM CUR_PARAMS'
      '110132723=     WHERE CUR_PARAMS = 2'
      '110132724=      INTO :G_TOCHKA_;'
      '110132725='
      '110132726=  IF (COALESCE(MODE_, 0) = 0) THEN'
      '110132727=      SELECT S.price'
      '110132728=        FROM SKLAD S'
      '110132729=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110132730=         AND S.g_product = :G_PRODUCT_'
      '110132731=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '110132732=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECE' +
        'IPT)'
      '110132733=                                 FROM SKLAD DD'
      
        '110132734=                                WHERE DD.g_product = :' +
        'G_PRODUCT_'
      
        '110132735=                                  AND DD.G_TOCHKA = :G' +
        '_TOCHKA_'
      
        '110132736=                                  AND DD.IS_VOZVRAT IN' +
        ' (0, 4)'
      '110132737=                                )'
      '110132738=        ORDER BY S.SKLAD DESC'
      '110132739=        ROWS 1 TO 1'
      '110132740=        INTO :PRICE_;'
      '110132741=      /*SELECT S.PRICE'
      '110132742=        FROM SKLAD S'
      '110132743=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110132744=         AND S.IS_LAST = 1'
      '110132745=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110132746=        INTO :PRICE_;*/'
      '110132747='
      
        '110132748=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047 +
        #1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '110132749=  ELSE BEGIN'
      '110132750=    SELECT S.S_VALUE'
      '110132751=      FROM SYSTEM_SETUP S'
      '110132752=     WHERE S.SYSTEM_SETUP = 1'
      '110132753=      INTO :FORMULA_;'
      '110132754='
      '110132755=    IF (FORMULA_ = 1) THEN BEGIN'
      '110132756=      SELECT S.price'
      '110132757=        FROM SKLAD S'
      '110132758=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110132759=         AND S.g_product = :G_PRODUCT_'
      '110132760=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '110132761=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECE' +
        'IPT)'
      '110132762=                                 FROM SKLAD DD'
      
        '110132763=                                WHERE DD.g_product = :' +
        'G_PRODUCT_'
      
        '110132764=                                  AND DD.G_TOCHKA = :G' +
        '_TOCHKA_'
      
        '110132765=                                  AND DD.IS_VOZVRAT IN' +
        ' (0, 4)'
      '110132766=                                )'
      '110132767=        ORDER BY 1 DESC'
      '110132768=        ROWS 1 TO 1'
      '110132769=        INTO :PRICE_;'
      '110132770=      /*SELECT S.PRICE'
      '110132771=        FROM SKLAD S'
      '110132772=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110132773=         AND S.IS_LAST = 1'
      '110132774=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110132775=        INTO :PRICE_;*/'
      '110132776='
      
        '110132777=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045 +
        #1058' '#1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052 +
        #1048'" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '110132778=      IF (ROW_COUNT = 0) THEN'
      '110132779=        SELECT S.PRICE'
      '110132780=          FROM SKLAD S'
      '110132781=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110132782=                            FROM SKLAD SS'
      
        '110132783=                           WHERE /*SS.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '110132784=                             AND */SS.G_PRODUCT = :G_P' +
        'RODUCT_'
      
        '110132785=                             AND SS.DATE_RECEIPT = (SE' +
        'LECT MAX(SSS.DATE_RECEIPT)'
      
        '110132786=                                                      ' +
        'FROM SKLAD SSS'
      
        '110132787=                                                     W' +
        'HERE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '110132788=                                                      ' +
        ' AND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '110132789=                                                      ' +
        ' AND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '110132790=                                                   )'
      
        '110132791=                             AND SS.IS_VOZVRAT IN (0, ' +
        '4) --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '110132792=                         )'
      '110132793=          INTO :PRICE_;'
      '110132794=    END ELSE BEGIN'
      
        '110132795=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUN' +
        'T), 2)'
      '110132796=        FROM (SELECT S.AMOUNT, S.PRICE'
      '110132797=                FROM SKLAD_PARENT SP,'
      '110132798=                     SKLAD S'
      '110132799=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '110132800=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '110132801=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '110132802=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '110132803=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.' +
        'IS_VOZVRAT IN (0, 3, 4)'
      
        '110132804=                ORDER BY S.DATE_RECEIPT DESC, S.SKLAD ' +
        'DESC ROWS 1 TO 5) T'
      '110132805=        INTO :PRICE_;'
      '110132806='
      
        '110132807=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045 +
        #1058' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048'"' +
        ' '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '110132808=      IF (PRICE_ IS NULL) THEN'
      
        '110132809=        SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMO' +
        'UNT), 2)'
      '110132810=        FROM (SELECT S.AMOUNT, S.PRICE'
      '110132811=                FROM SKLAD_PARENT SP,'
      '110132812=                     SKLAD S'
      '110132813=               WHERE SP.DATE_RECEIPT <= CURRENT_DATE'
      '110132814=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '110132815=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '110132816=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.' +
        'IS_VOZVRAT IN (0, 3, 4)'
      
        '110132817=                ORDER BY S.DATE_RECEIPT DESC, S.SKLAD ' +
        'DESC ROWS 1 TO 5) T'
      '110132818=          INTO :PRICE_;'
      '110132819=    END'
      '110132820=  END'
      '110132821='
      '110132822=  PRICE_ = COALESCE(:PRICE_, 0);'
      '110132823=  SUSPEND;'
      '110132824=END'
      '110132825=;'
      '110132826='
      '110132827=ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '110132828=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110132829=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '110132830=RETURNS ('
      '110132831=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110132832=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110132833=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110132834=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110132835=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110132836=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110132837=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110132838=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110132839=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110132840=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110132841=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110132842=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110132843=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110132844=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110132845=  CNT_Z_ INTEGER,'
      
        '110132846=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110132847=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110132848=  HAVERIGHT_ INTEGER,'
      '110132849=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110132850=  NOT_MINUS_OSTATOK_ TYPE OF COLUMN SKLAD_PARENT.IS_EX' +
        'PECTED,'
      '110132851=  ERR_CODE INTEGER,'
      '110132852=  ERR_MSG VARCHAR(1024))'
      '110132853=AS'
      '110132854=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      
        '110132855=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110132856=begin'
      '110132857='
      '110132858=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1086#1076#1072#1078', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110132859=  /*CNT_Z_ = 0;'
      '110132860=  SELECT COUNT(*)'
      '110132861=    FROM (SELECT Z.ZAKAZ'
      '110132862=            FROM ZAKAZ Z ROWS 1 TO 100)'
      '110132863=    INTO :CNT_Z_;*/'
      '110132864='
      
        '110132865=  --**************************************************' +
        '**************'
      '110132866=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '110132867=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110132868=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '110132869=          SELECT'
      '110132870=            T.G_TOCHKA,'
      '110132871=            T.Z_DATE,'
      '110132872=            T.Z_TIME,'
      '110132873=            T.G_CLIENT,'
      '110132874=            T.G_PAYMENT_TYPE,'
      '110132875=            T.OSNOVANIE,'
      '110132876=            T.NOTE,'
      '110132877=            T.SUMM,'
      '110132878=            T.SUMM_FACT,'
      '110132879=            T.SUMM_BONUS,'
      '110132880=            T.summ_bonus_got,'
      '110132881=            T.IS_PAYED_ALL,'
      '110132882=            COALESCE(T.BY_RECIPE, 0)'
      '110132883=            ,IS_RESERVE'
      '110132884=          FROM ZAKAZ T'
      '110132885=          WHERE T.ZAKAZ = :ZAKAZ_'
      '110132886=          INTO'
      '110132887=            :G_TOCHKA_,'
      '110132888=            :Z_DATE_,'
      '110132889=            :Z_TIME_,'
      '110132890=            :G_CLIENT_,'
      '110132891=            :G_PAYMENT_TYPE_,'
      '110132892=            :OSNOVANIE_,'
      '110132893=            :NOTE_,'
      '110132894=            :SUMM_,'
      '110132895=            :SUMM_FACT_,'
      '110132896=            :SUMM_PAY_BONUS_,'
      '110132897=            :SUMM_GOT_BONUS_,'
      '110132898=            :IS_PAYED_ALL_,'
      '110132899=            :BY_RECIPE_,'
      '110132900=            :IS_RESERVE_;'
      '110132901='
      '110132902=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '110132903=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS,' +
        ' ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_' +
        'TENGE,'
      
        '110132904=                                        DISCOUNT_SUMM,' +
        ' NDS, NDS_SUMM, COST_PRICE)'
      
        '110132905=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AM' +
        'OUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110132906=                   DISCOUNT_SUMM, NDS, NDS_SUMM, COST_' +
        'PRICE'
      '110132907=              FROM ZAKAZ_DETAILS'
      '110132908=             WHERE ZAKAZ = :ZAKAZ_'
      '110132909=             ORDER BY 1;'
      '110132910='
      '110132911=          -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110132912=          SELECT K.G_PRIHOD_RASHOD,'
      '110132913=                 K.SUMM'
      
        '110132914=            FROM (SELECT * FROM KASSA UNION SELECT * F' +
        'ROM KASSA_BEZNAL) K'
      '110132915=           WHERE K.ZAKAZ = :ZAKAZ_'
      '110132916=             AND K.G_PRIHOD_RASHOD NOT IN (1, -5)'
      '110132917=            INTO :G_PRIHOD_,'
      '110132918=                 :SUMM_PRIHOD_;'
      '110132919=      END'
      '110132920='
      
        '110132921=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RET' +
        'URNING_VALUES :PAYMENTS_;'
      '110132922=  END'
      '110132923=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110132924=  --*************************************************'
      '110132925=  --*************************************************'
      '110132926=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110132927=  ELSE BEGIN'
      '110132928=    SELECT'
      '110132929=        T.G_CLIENT,'
      '110132930=        T.DATE_RECEIPT,'
      '110132931=        T.TIME_RECEIPT,'
      '110132932=        T.G_TOCHKA,'
      '110132933=        T.G_PAYMENT_TYPE,'
      '110132934=        T.OSNOVANIE,'
      '110132935=        T.NOTE,'
      '110132936=        T.SUMM,'
      '110132937=        T.SUMM_FACT,'
      '110132938=        0,'
      '110132939=        0,'
      '110132940=        0,'
      '110132941=        T.IS_EXPECTED'
      '110132942=      FROM SKLAD_PARENT T'
      '110132943=      WHERE T.SKLAD = :ZAKAZ_'
      '110132944=      INTO'
      '110132945=        :G_TOCHKA_,'
      '110132946=        :Z_DATE_,'
      '110132947=        :Z_TIME_,'
      '110132948=        :G_CLIENT_,'
      '110132949=        :G_PAYMENT_TYPE_,'
      '110132950=        :OSNOVANIE_,'
      '110132951=        :NOTE_,'
      '110132952=        :SUMM_,'
      '110132953=        :SUMM_FACT_,'
      '110132954=        :SUMM_PAY_BONUS_,'
      '110132955=        :IS_PAYED_ALL_,'
      '110132956=        :BY_RECIPE_,'
      '110132957=        :NOT_MINUS_OSTATOK_;'
      '110132958='
      '110132959=      -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110132960=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '110132961=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '110132962=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE,' +
        ' SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047#1040 +
        #1055#1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '110132963=        FROM SKLAD'
      '110132964=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '110132965=      ORDER BY 1;'
      '110132966=  END'
      '110132967='
      
        '110132968=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110132969=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110132970=  HaveRight_ = 1;'
      '110132971=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '110132972=    SELECT ID'
      '110132973=      FROM CUR_PARAMS'
      '110132974=     WHERE CUR_PARAMS = 1'
      '110132975=      INTO :G_OFFICIAL_CUR_;'
      '110132976='
      
        '110132977=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110132978=      HaveRight_ = 1;'
      '110132979=    else'
      
        '110132980=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110132981='
      '110132982=    /* '#1040#1053#1040#1051#1048#1047' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045
      '110132983=    if (HaveRight_ = 0) then begin'
      
        '110132984=      ERR_CODE = -20500; // '#1053#1077' '#1076#1086#1089#1090#1072#1090#1086#1095#1085#1086' '#1087#1088#1072#1074' '#1076#1083#1103' '#1074#1099#1087 +
        #1086#1083#1085#1077#1085#1080#1103' '#1086#1087#1077#1088#1072#1094#1080#1080
      
        '110132985=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' '#1085#1077' '#1086 +
        #1073#1083#1072#1076#1072#1077#1090#1077' '#1087#1088#1072#1074#1086#1084' '#1076#1083#1103' '#1088#1077#1076#1072#1082#1090#1080#1088#1086#1074#1072#1085#1080#1103' '#1085#1072#1082#1083#1072#1076#1085#1099#1093#39'||ascii_char(10)||'#39 +
        #1079#1072' '#1087#1088#1086#1096#1083#1099#1077' '#1076#1072#1090#1099'.'#39') RETURNING_VALUES(:ERR_MSG);'
      '110132986=      EXIT;'
      '110132987=    end*/'
      '110132988=  END'
      '110132989=end'
      '110132990=;'
      '110132991='
      '110132992=ALTER PROCEDURE INS_ZAKAZ('
      '110132993=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110132994=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110132995=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110132996=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110132997=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110132998=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110132999=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101321000=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101321001=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101321002=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101321003=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101321004=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101321005=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101321006=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101321007=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101321008=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101321009=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101321010=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101321011=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101321012=  IS_MEBEL_ INTEGER = 0,'
      
        '1101321013=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1101321014=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      '1101321015=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '1101321016=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1101321017=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101321018=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1101321019=  NOT_MINUS_OSTATOK_ INTEGER = 0)'
      '1101321020=RETURNS ('
      '1101321021=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101321022=  ERR_CODE INTEGER,'
      '1101321023=  ERR_MSG VARCHAR(1024))'
      '1101321024=AS'
      '1101321025=/*'
      '1101321026=IS_SPISANIE_'
      '1101321027=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101321028=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101321029=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101321030=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101321031='
      '1101321032='
      
        '1101321033=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '1101321034=*/'
      '1101321035=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '1101321036=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101321037=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101321038=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '1101321039=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '1101321040=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '1101321041=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      
        '1101321042=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '1101321043=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '1101321044=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '1101321045=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        ';'
      
        '1101321046=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.NDS_SUMM;'
      
        '1101321047=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '1101321048=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1101321049=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101321050=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '1101321051=DECLARE VARIABLE CNT_ INTEGER;'
      '1101321052=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1101321053=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1101321054=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1101321055=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101321056=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101321057=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1101321058=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101321059=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101321060=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1101321061=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101321062=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101321063=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101321064=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1101321065=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1101321066=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101321067=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLI' +
        'ENT.SKIDKA;'
      
        '1101321068=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.N_PERCENT;'
      
        '1101321069=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DI' +
        'SCONT_CARD.SUMM_ALL;'
      '1101321070=BEGIN'
      '1101321071='
      
        '1101321072=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057 +
        #1057#1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' ' +
        #1055#1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '1101321073=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044 +
        #1045#1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '1101321074=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '1101321075=  IF (CNT_ = 0) THEN BEGIN'
      '1101321076=    ERR_CODE = -20500;'
      
        '1101321077=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101321078=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '1101321079=    EXIT;'
      '1101321080=  END'
      '1101321081='
      '1101321082=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101321083=    SELECT ID'
      '1101321084=      FROM CUR_PARAMS'
      '1101321085=     WHERE CUR_PARAMS = 2'
      '1101321086=      INTO :G_TOCHKA_;'
      '1101321087='
      '1101321088=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101321089=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '1101321090=      PNT_ = '#39'01'#39';'
      
        '1101321091=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101321092=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101321093=      ELSE'
      '1101321094=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101321095='
      '1101321096=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1101321097=      SELECT G.G_OFFICIAL,'
      '1101321098=             G.DO_NOT_SALES_COMM,'
      '1101321099=             G.FM||'#39' '#39'||G.NM'
      '1101321100=        FROM G_OFFICIAL G'
      
        '1101321101=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (S' +
        'ELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '1101321102=        INTO :G_OFFICIAL_,'
      '1101321103=             :DO_NOT_SALES_COMM_,'
      '1101321104=             :OFFICIAL_NAME_;'
      '1101321105='
      '1101321106=      INSERT INTO ZAKAZ'
      '1101321107=      ('
      '1101321108=       ZAKAZ,'
      '1101321109=       G_TOCHKA,'
      '1101321110=       Z_DATE,'
      '1101321111=       Z_TIME,'
      '1101321112=       G_CLIENT,'
      '1101321113=       G_PAYMENT_TYPE,'
      '1101321114=       OSNOVANIE,'
      '1101321115=       IS_SPISANIE,'
      '1101321116=       NOTE,'
      '1101321117=       SUMM,'
      '1101321118=       SUMM_FACT,'
      '1101321119=       SUMM_BONUS,'
      '1101321120=       IS_PAYED_ALL'
      '1101321121=       ,G_OFFICIAL'
      '1101321122=       ,BY_RECIPE'
      '1101321123=       ,SUMM_BONUS_GOT'
      '1101321124=       ,IS_RESERVE'
      '1101321125=       ,SUMM_CASH'
      '1101321126=       ,SUMM_NONCASH'
      '1101321127=      ) VALUES ('
      '1101321128=       GEN_ID(GEN_ZAKAZ, 1),'
      '1101321129=       :G_TOCHKA_,'
      '1101321130=       :Z_DATE_,'
      '1101321131=       :Z_TIME_,'
      '1101321132=       :G_CLIENT_,'
      '1101321133=       :G_PAYMENT_TYPE_,'
      '1101321134=       :OSNOVANIE_,'
      '1101321135=       :IS_SPISANIE_,'
      '1101321136=       :NOTE_,'
      '1101321137=       :SUMM_,'
      '1101321138=       :SUMM_FACT_1_,'
      '1101321139=       COALESCE(:SUMM_BONUS_, 0),'
      
        '1101321140=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM' +
        '_BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057 +
        #1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101321141=       ,:G_OFFICIAL_'
      '1101321142=       ,:BY_RECIPE_'
      '1101321143=       ,:SUMM_BONUS_GOT_'
      '1101321144=       ,:IS_RESERVE_'
      '1101321145=       ,COALESCE(:SUMM_CASH_, 0)'
      '1101321146=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '1101321147=      )'
      '1101321148=      RETURNING'
      '1101321149=        ZAKAZ'
      '1101321150=      INTO'
      '1101321151=        :ZAKAZ_;'
      '1101321152='
      '1101321153=      PNT_ = '#39'02'#39';'
      
        '1101321154=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOU' +
        'NT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOU' +
        'NT_SUMM,'
      
        '1101321155=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.S' +
        'ALES_COMM'
      '1101321156=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '1101321157=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '1101321158=          INTO :ZAKAZ_DETAILS_TMP_,'
      '1101321159=              :G_PRODUCT,'
      '1101321160=              :AMOUNT,'
      '1101321161=              :PRICE,'
      '1101321162=              :SUMM,'
      '1101321163=              :DISCOUNT_PERC,'
      '1101321164=              :DISCOUNT_TENGE,'
      '1101321165=              :DISCOUNT_SUMM,'
      '1101321166=              :NDS,'
      '1101321167=              :NDS_SUMM,'
      '1101321168=              :COST_PRICE,'
      '1101321169=              :SALES_COMM_'
      '1101321170=      DO BEGIN'
      
        '1101321171=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101321172=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1101321173=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1101321174=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101321175=        END'
      '1101321176='
      '1101321177=        INSERT INTO ZAKAZ_DETAILS'
      '1101321178=        VALUES('
      '1101321179=          :ZAKAZ_DETAILS_TMP_,'
      '1101321180=          :ZAKAZ_,'
      '1101321181=          :G_PRODUCT,'
      '1101321182=          :AMOUNT,'
      '1101321183=          :PRICE,'
      '1101321184=          :SUMM,'
      '1101321185=          :DISCOUNT_PERC,'
      '1101321186=          :DISCOUNT_TENGE,'
      '1101321187=          :DISCOUNT_SUMM,'
      '1101321188=          :NDS,'
      '1101321189=          :NDS_SUMM,'
      '1101321190=          :COST_PRICE,'
      '1101321191=          :SALES_COMM_SUMM_ITER_'
      '1101321192=        );'
      '1101321193='
      '1101321194=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1101321195=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '1101321196=            UPDATE LT_SKLAD_PRODUCT L'
      '1101321197=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101321198=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101321199=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101321200='
      '1101321201=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101321202=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040',' +
        ' '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' ' +
        #1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101321203=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047 +
        #1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '1101321204=            PNT_ = '#39'04'#39';'
      
        '1101321205=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE ' +
        'FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101321206=              Err_Code = -20500;'
      
        '1101321207=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE,' +
        ' '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PROD' +
        'UCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087 +
        #1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101321208=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101321209=              EXIT;'
      '1101321210=            END ELSE if (ROW_COUNT = 0) then'
      
        '1101321211=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101321212=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1101321213=        END'
      '1101321214='
      '1101321215=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101321216=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101321217=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1101321218=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERV' +
        'E + :AMOUNT'
      '1101321219=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101321220=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101321221=      END'
      '1101321222='
      '1101321223=      ----------------------------------------'
      
        '1101321224=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1101321225=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1101321226=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1101321227='
      
        '1101321228=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1101321229=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1101321230=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1101321231=                PNT_ = '#39'05'#39';'
      
        '1101321232=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1101321233=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101321234=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1101321235=                                              :Z_DATE' +
        '_,'
      
        '1101321236=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101321237=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1101321238=                                              NULL,'
      
        '1101321239=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1101321240=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101321241=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101321242=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101321243=                  EXIT;'
      '1101321244=                END'
      '1101321245=            END'
      '1101321246='
      '1101321247=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1101321248=        END ELSE BEGIN'
      '1101321249=            PNT_ = '#39'06'#39';'
      
        '1101321250=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1101321251=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101321252=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101321253=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101321254=                ELSE'
      
        '1101321255=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101321256='
      
        '1101321257=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101321258=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101321259='
      
        '1101321260=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101321261='
      '1101321262=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101321263=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101321264=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1101321265=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101321266=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101321267=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101321268=                                                  :ZA' +
        'KAZ_,'
      
        '1101321269=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1101321270=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101321271=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101321272=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101321273=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101321274=                      EXIT;'
      '1101321275=                    END'
      '1101321276=                END'
      '1101321277=            END'
      '1101321278=        END'
      '1101321279=      END'
      '1101321280='
      
        '1101321281=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1101321282=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1101321283=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1101321284=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1101321285=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1101321286=          UPDATE G_DISCONT_CARD D'
      
        '1101321287=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1101321288=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1101321289=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1101321290=          RETURNING'
      '1101321291=            D.SUMM_ALL'
      '1101321292=          INTO'
      '1101321293=            :CLIENT_SUMM_ALL_;'
      '1101321294='
      '1101321295=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1101321296=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1101321297=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1101321298=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1101321299=          ORDER BY G.SUMM_FROM'
      '1101321300=          ROWS 1 TO 1'
      '1101321301=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1101321302='
      '1101321303=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1101321304=            UPDATE G_CLIENT G'
      '1101321305=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1101321306=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1101321307=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1101321308='
      '1101321309=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1101321310=            UPDATE G_DISCONT_CARD D'
      '1101321311=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1101321312=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1101321313=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1101321314=      END'
      '1101321315='
      '1101321316=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1101321317=      PNT_ = '#39'07'#39';'
      
        '1101321318=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN ' +
        'BEGIN'
      '1101321319=        SELECT S.S_VALUE'
      '1101321320=          FROM SYSTEM_SETUP S'
      '1101321321=         WHERE S.SYSTEM_SETUP = 4'
      '1101321322=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101321323='
      '1101321324=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101321325=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101321326=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101321327='
      
        '1101321328=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1101321329=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1101321330=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1101321331='
      '1101321332=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101321333=        ELSE'
      
        '1101321334=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1101321335='
      '1101321336=        KASSA_ = NULL;'
      '1101321337=        SELECT K.KASSA, K.SUMM'
      '1101321338=        FROM KASSA K'
      '1101321339=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1101321340=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101321341=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101321342=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1101321343=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1101321344='
      '1101321345=        IF (KASSA_ IS NULL) THEN'
      
        '1101321346=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101321347=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101321348=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101321349=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101321350=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1101321351=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1101321352=                                          NULL,     -' +
        '-:SKLAD_,'
      '1101321353=                                          1,'
      '1101321354=                                          :G_TOCHKA_,'
      
        '1101321355=                                          :G_OFFICIAL' +
        '_'
      
        '1101321356=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101321357=        ELSE'
      '1101321358=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '1101321359=                                          1,     -- A' +
        'CTION_'
      
        '1101321360=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101321361=                                          :SALES_COMM' +
