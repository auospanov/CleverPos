        '110223753=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110223754='
      
        '110223755=    --================================================' +
        '========='
      '110223756=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110223757=    --================================================' +
        '========='
      '110223758=    PNT_ = '#39'02b'#39';'
      '110223759=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110223760='
      '110223761=        IF (PRICE_ = -999) THEN'
      '110223762=          PRICE_ = 0;'
      '110223763=        IF (VOLUME_PRICE_ = -999) THEN'
      '110223764=          VOLUME_PRICE_ = 0;'
      '110223765=        IF (PACK_AMOUNT_ = -999) THEN'
      '110223766=          PACK_AMOUNT_ = 0;'
      '110223767='
      
        '110223768=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110223769=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110223770=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110223771=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110223772=        RETURNING G_PRODUCT'
      '110223773=        INTO :G_PRODUCT_;'
      '110223774='
      
        '110223775=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110223776=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110223777='
      '110223778=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110223779=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110223780=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110223781=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G' +
        '_PRODUCT_, 1);'
      '110223782=    end'
      '110223783='
      
        '110223784=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110223785=    PNT_ = '#39'03'#39';'
      '110223786=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110223787=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110223788=                                       :AMOUNT_,'
      '110223789=                                       :SELF_PRICE_,'
      
        '110223790=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110223791=                                       0, --nds_,'
      '110223792=                                       0 --nds_summ_,'
      
        '110223793=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110223794=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110223795=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110223796=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110223797=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110223798=          EXIT;'
      '110223799=        END'
      '110223800=    END'
      '110223801='
      
        '110223802=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110223803=    PNT_ = '#39'04'#39';'
      '110223804=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110223805=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110223806=        FROM SKLAD_TMP T'
      '110223807=        INTO :CNT_;'
      '110223808='
      '110223809=      if (CNT_ > 0) then BEGIN'
      '110223810=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110223811=          FROM SKLAD_TMP T'
      '110223812=          INTO :SUMM_, :SUMM_UE_;'
      '110223813='
      '110223814=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110223815=                                DATE_RECEIPT,'
      '110223816=                                TIME_RECEIPT,'
      '110223817=                                G_CLIENT,'
      '110223818=                                G_PAYMENT_TYPE,'
      '110223819=                                OSNOVANIE,'
      '110223820=                                NOTE,'
      '110223821=                                SUMM,'
      '110223822=                                SUMM_FACT,'
      '110223823=                                SUMM_CURRENCY,'
      '110223824=                                IS_PAYED_ALL,'
      '110223825=                                IS_VOZVRAT,'
      '110223826=                                G_TOCHKA)'
      '110223827=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110223828=                CURRENT_DATE,'
      '110223829=                CURRENT_TIME,'
      '110223830=                :G_CLIENT_,'
      '110223831=                1,'
      '110223832=                NULL,  --:OSNOVANIE_,'
      '110223833=                NULL,  -- :NOTE_,'
      '110223834=                :SUMM_,'
      '110223835=                :SUMM_,'
      '110223836=                :SUMM_UE_,'
      
        '110223837=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110223838=                0,'
      '110223839=                :G_TOCHKA_)'
      '110223840=        RETURNING'
      '110223841=          SKLAD'
      '110223842=        INTO'
      '110223843=          :SKLAD_PARENT_;'
      '110223844='
      '110223845=        PNT_ = '#39'05'#39';'
      '110223846=        FOR SELECT SKLAD,'
      '110223847=                   G_PRODUCT,'
      '110223848=                   AMOUNT,'
      '110223849=                   PRICE,'
      '110223850=                   SUMM'
      '110223851=                   ,PRICE_CURRENCY'
      '110223852=                   ,SUMM_CURRENCY'
      '110223853=              FROM SKLAD_TMP'
      '110223854=             ORDER BY 1'
      '110223855=              INTO :SKLAD_TMP_,'
      '110223856=                   :RG_PRODUCT_,'
      '110223857=                   :RAMOUNT_,'
      '110223858=                   :RPRICE_,'
      '110223859=                   :RSUMM_'
      '110223860=                   ,:RPRICE_UE_'
      '110223861=                   ,:RSUMM_UE_'
      '110223862=        DO BEGIN'
      '110223863='
      '110223864=            UPDATE SKLAD SK'
      '110223865=               SET SK.IS_LAST = 0'
      '110223866=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110223867=               AND SK.IS_LAST = 1;'
      '110223868='
      '110223869=            INSERT INTO SKLAD'
      '110223870=            ('
      '110223871=             SKLAD,'
      '110223872=             SKLAD_PARENT,'
      '110223873=             DATE_RECEIPT,'
      '110223874=             G_CLIENT,'
      '110223875=             G_PRODUCT,'
      '110223876=             AMOUNT,'
      '110223877=             PRICE,'
      '110223878=             SUMM,'
      '110223879=             G_PAYMENT_TYPE,'
      '110223880=             OSNOVANIE,'
      '110223881=             NOTE,'
      '110223882=             NDS,'
      '110223883=             NDS_SUMM,'
      '110223884=             IS_LAST,'
      '110223885=             IS_VOZVRAT,'
      '110223886=             G_TOCHKA'
      '110223887=             ,PRICE_CURRENCY'
      '110223888=             ,SUMM_CURRENCY'
      '110223889=            ) VALUES ('
      '110223890=             :SKLAD_TMP_,'
      '110223891=             :SKLAD_PARENT_,'
      '110223892=             CURRENT_DATE,'
      '110223893=             :G_CLIENT_,'
      '110223894=             :RG_PRODUCT_,'
      '110223895=             :RAMOUNT_,'
      '110223896=             :RPRICE_,'
      '110223897=             :RSUMM_,'
      '110223898=             1,       --:G_PAYMENT_TYPE_,'
      '110223899=             NULL,    --:OSNOVANIE_,'
      '110223900=             NULL,    --:NOTE_,'
      '110223901=             0,       --:RNDS_,'
      '110223902=             0,       --:RNDS_SUMM_,'
      '110223903=             1,       --IS_LAST_'
      '110223904=             0,        --:IS_VOZVRAT_'
      '110223905=             :G_TOCHKA_'
      '110223906=             ,:RPRICE_UE_'
      '110223907=             ,:RSUMM_UE_'
      '110223908=            );'
      '110223909='
      
        '110223910=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110223911=            PNT_ = '#39'06'#39';'
      '110223912=            UPDATE LT_SKLAD_PRODUCT L'
      '110223913=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      
        '110223914=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_A' +
        'PP_'
      '110223915=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110223916=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110223917='
      '110223918=            PNT_ = '#39'06a'#39';'
      '110223919=            IF (ROW_COUNT = 0) THEN'
      
        '110223920=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXP' +
        'ORT)'
      
        '110223921=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110223922=        END'
      '110223923='
      '110223924=        PNT_ = '#39'07'#39';'
      
        '110223925=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110223926=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110223927=                                :SUMM_,'
      '110223928=                                CURRENT_DATE,'
      
        '110223929=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110223930=                                NULL,   --ZAKAZ_'
      '110223931=                                :SKLAD_PARENT_,'
      '110223932=                                1,'
      '110223933=                                :G_TOCHKA_,'
      
        '110223934=                                :UPLOAD_TO_EXT_APP_) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110223935=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110223936=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110223937=          EXIT;'
      '110223938=        END'
      '110223939='
      '110223940=        DELETE FROM SKLAD_TMP;'
      '110223941='
      '110223942=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110223943=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110223944=          INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJE' +
        'CT_TYPE, ID, OPER)'
      
        '110223945=          VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKL' +
        'AD_, 1);'
      '110223946=      END'
      '110223947=    END'
      '110223948='
      
        '110223949=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110223950=    if (ERR_MSG_ IS NOT NULL) then'
      '110223951=      ERR_MSG = ERR_MSG_;'
      '110223952='
      '110223953=WHEN ANY DO BEGIN'
      '110223954=    IF (GDSCODE = 335544652) THEN BEGIN'
      '110223955=        Err_code = GDSCODE;'
      
        '110223956=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1042#1099' '#1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1080#1084 +
        #1087#1086#1088#1090#1080#1088#1086#1074#1072#1090#1100' '#1090#1086#1074#1072#1088#1099' '#1089' '#1086#1076#1080#1085#1072#1082#1086#1074#1099#1084' '#1079#1085#1072#1095#1077#1085#1080#1077#1084'!'#39';'
      '110223957=        IF (PNT_ = '#39'02'#39') THEN'
      
        '110223958=            ERR_MSG = ERR_MSG || '#39' '#1040#1088#1090#1080#1082#1091#1083' '#39' || ARTICU' +
        'L_ || '#39'.'#39';'
      '110223959=        ELSE'
      
        '110223960=            ERR_MSG = ERR_MSG || '#39' '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110223961=    END ELSE BEGIN'
      '110223962=        Err_code = gdscode;'
      
        '110223963=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode|' +
        '|'#39' --> PNT_ '#39'||PNT_;'
      '110223964=    END'
      '110223965=  END'
      '110223966=END'
      '110223967=;'
      '110223968='
      '110223969=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '110223970=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110223971=  ARTICUL_ VARCHAR(30),'
      '110223972=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110223973=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110223974=  NAME_ VARCHAR(500),'
      '110223975=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110223976=  PRICE_ NUMERIC(15,2),'
      '110223977=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110223978=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110223979=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110223980=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110223981=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110223982=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110223983=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110223984=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110223985=  IS_CATEGORY_ INTEGER,'
      '110223986=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110223987=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110223988=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110223989=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110223990=  IS_MARKED_ INTEGER,'
      '110223991=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110223992=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '110223993=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '110223994=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE,'
      
        '110223995=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = null' +
        ','
      '110223996=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = null,'
      '110223997=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '110223998=  IS_KASPI_SHOP_ SMALLINT = 0)'
      '110223999=RETURNS ('
      '1102231000=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102231001=  ERR_CODE INTEGER,'
      '1102231002=  ERR_MSG VARCHAR(1024))'
      '1102231003=AS'
      
        '1102231004=declare variable PROCNAME varchar(15) = '#39'G_INS_G_PROD' +
        'UCT'#39';'
      
        '1102231005=declare variable G_PRODUCT_SOSTAV_AMOUNT_ type of col' +
        'umn LT_SKLAD_PRODUCT.AMOUNT;'
      '1102231006=begin'
      
        '1102231007=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1102231008=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1102231009=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1102231010=                      FROM G_PRODUCT G'
      
        '1102231011=                     WHERE UPPER(G.ARTICUL) = UPPER(T' +
        'RIM(:ARTICUL_))'
      '1102231012=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '1102231013=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1102231014=          ERR_CODE = -20500;'
      
        '1102231015=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1102231016=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1102231017=          EXIT;'
      '1102231018=        END'
      '1102231019=    end'
      '1102231020='
      
        '1102231021=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1102231022=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      
        '1102231023=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) the' +
        'n begin'
      '1102231024=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1102231025=                     FROM G_PRODUCT G'
      
        '1102231026=                    WHERE UPPER(G.NOMENCLATUR_NUM) = ' +
        'UPPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '1102231027=                      AND TRIM(G.NOMENCLATUR_NUM) <> ' +
        #39#39
      
        '1102231028=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1102231029=          ERR_CODE = -20500;'
      
        '1102231030=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1102231031=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1102231032=          EXIT;'
      '1102231033=        END'
      '1102231034=    end*/'
      '1102231035='
      '1102231036=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1102231037=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1102231038=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '1102231039=                      FROM G_PRODUCT G'
      
        '1102231040=                     WHERE UPPER(G.BARCODE) = UPPER(T' +
        'RIM(:BARCODE_))'
      '1102231041=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '1102231042=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1102231043=          ERR_CODE = -20500;'
      
        '1102231044=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1102231045=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1102231046=          EXIT;'
      '1102231047=        END'
      '1102231048='
      '1102231049=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1102231050=                     FROM G_PRODUCT G, LT_BARCODE L'
      '1102231051=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1102231052=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '1102231053=                      AND TRIM(L.BARCODE) <> '#39#39
      
        '1102231054=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1102231055=          ERR_CODE = -20500;'
      
        '1102231056=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1102231057=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1102231058=          EXIT;'
      '1102231059=        END'
      '1102231060=    end'
      '1102231061='
      
        '1102231062=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_P' +
        'RICE,'
      
        '1102231063=                           IS_CATEGORY, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_CO' +
        'MM, KOD_TNVD,'
      
        '1102231064=                           FAST_TOVAR, DO_NOT_CHARGE_' +
        'BONUS, IS_MARKED, BRAND, IS_WEIGHT, VES_GRAMM, VES_GRAMM_PRICE, ' +
        'IS_KASPI_SHOP)'
      
        '1102231065=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PR' +
        'ICE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1102231066=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CRO' +
        'SSCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNV' +
        'D_,'
      
        '1102231067=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_' +
        'MARKED_, :BRAND_, :IS_WEIGHT_, :VES_GRAMM_, :VES_GRAMM_PRICE_, :' +
        'IS_KASPI_SHOP_)'
      '1102231068=    RETURNING G_PRODUCT'
      '1102231069=    INTO :G_PRODUCT_;'
      '1102231070='
      '1102231071=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1102231072=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1102231073=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1102231074=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1102231075='
      '1102231076=        INSERT INTO LT_BARCODE'
      
        '1102231077=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1102231078='
      
        '1102231079=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089 +
        #1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '1102231080=        INSERT into G_PRODUCT_IMAGE'
      
        '1102231081=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TY' +
        'PE from G_PRODUCT_IMAGE_TMP;'
      '1102231082='
      
        '1102231083=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074 +
        #1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '1102231084=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076 +
        #1091#1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '1102231085=        IF (is_kit_ > 0) THEN begin'
      '1102231086=            INSERT INTO G_PRODUCT_KIT'
      
        '1102231087=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP;'
      '1102231088='
      '1102231089=            if (is_kit_ = 1) then begin'
      
        '1102231090=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1102231091=                  FROM G_PRODUCT_KIT K,'
      '1102231092=                       LT_SKLAD_PRODUCT L'
      '1102231093=                 WHERE K.g_product = :G_PRODUCT_'
      '1102231094=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1102231095=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1102231096=                 GROUP BY K.G_PRODUCT'
      '1102231097=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1102231098='
      '1102231099=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102231100=                   SET L.AMOUNT = COALESCE(:G_PRODUCT' +
        '_SOSTAV_AMOUNT_, 0)'
      '1102231101=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1102231102=            end'
      '1102231103=        END'
      '1102231104=    END'
      '1102231105='
      '1102231106=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102231107=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '1102231108='
      '1102231109=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1102231110=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102231111=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1102231112=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PR' +
        'ODUCT_, 1);'
      '1102231113=end'
      '1102231114=;'
      '1102231115='
      '1102231116=ALTER PROCEDURE G_PRODUCT_SET_NEW_PRICES('
      '1102231117=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102231118=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102231119=  CHANGE_PRICE_ INTEGER,'
      '1102231120=  MODE_ INTEGER,'
      '1102231121=  WHAT_PRICE_ INTEGER,'
      '1102231122=  NEW_VAL_ NUMERIC(15,2),'
      '1102231123=  COURSE_OLD_ NUMERIC(15,2),'
      '1102231124=  COURSE_NEW_ NUMERIC(15,2),'
      '1102231125=  ROUND_MODE_ INTEGER,'
      '1102231126=  CHANGE_CATEGORY_ INTEGER,'
      '1102231127=  NEW_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102231128=  CHANGE_MIN_AMOUNT_ INTEGER,'
      
        '1102231129=  NEW_MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT' +
        ','
      '1102231130=  CHANGE_SALES_COMM_ INTEGER,'
      
        '1102231131=  NEW_SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM' +
        ','
      '1102231132=  CHANGE_KIT_TYPE_ INTEGER,'
      '1102231133=  IS_KASPI_SHOP_ SMALLINT,'
      '1102231134=  IS_KASPI_SHOP_MODE_ SMALLINT)'
      '1102231135=RETURNS ('
      '1102231136=  ERR_CODE INTEGER,'
      '1102231137=  ERR_MSG VARCHAR(1000))'
      '1102231138=AS'
      
        '1102231139=/*ROUND_MODE_ 0 - '#1076#1077#1089#1103#1090#1099#1077', 1 - '#1094#1077#1083#1099#1077', 2 '#1076#1077#1089#1103#1090#1082#1080', 3 '#1089#1086 +
        #1090#1085#1080', 4 '#1090#1099#1089#1103#1095#1080
      '1102231140='
      '1102231141=CHANGE_KIT_TYPE_ - '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040
      '1102231142=*/'
      
        '1102231143=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT;'
      
        '1102231144=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRIC' +
        'E;'
      
        '1102231145=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.' +
        'VOLUME_PRICE;'
      '1102231146=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '1102231147=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '1102231148=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102231149=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '1102231150=BEGIN'
      '1102231151='
      '1102231152=  SQL_STR_ = '#39'UPDATE G_PRODUCT P'#39'||'
      '1102231153=               '#39' SET '#39';'
      '1102231154='
      '1102231155=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1102231156='
      '1102231157=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '1102231158=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '1102231159=      IF (ROUND_MODE_ = 0) THEN'
      '1102231160=          ROUND_ = 1;'
      '1102231161=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '1102231162=          ROUND_ = 0;'
      '1102231163=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '1102231164=          ROUND_ = -1;'
      '1102231165=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '1102231166=          ROUND_ = -2;'
      '1102231167=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '1102231168=          ROUND_ = -3;'
      '1102231169='
      '1102231170=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' %'
      '1102231171=      IF (MODE_ = 0) THEN'
      
        '1102231172=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '1102231173=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '1102231174='
      '1102231175=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '1102231176=      ELSE IF (MODE_ = 1) THEN'
      
        '1102231177=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '1102231178=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '1102231179='
      '1102231180=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' %'
      '1102231181=      ELSE IF (MODE_ = 2) THEN'
      
        '1102231182=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E * (1 - '#39'||:NEW_VAL_||'#39'/100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '1102231183=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE * (1 - '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '1102231184='
      '1102231185=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '1102231186=      ELSE IF (MODE_ = 3) THEN'
      
        '1102231187=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '1102231188=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '1102231189='
      '1102231190=      --'#1048#1047#1052#1045#1053#1048#1058#1068' '#1055#1054' '#1042#1040#1051#1070#1058#1045
      '1102231191=      ELSE IF (MODE_ = 4) THEN'
      
        '1102231192=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '1102231193=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '1102231194='
      '1102231195=      ELSE BEGIN'
      '1102231196=        SELECT ID'
      '1102231197=          FROM CUR_PARAMS'
      '1102231198=         WHERE CUR_PARAMS = 2'
      '1102231199=          INTO :G_TOCHKA_;'
      '1102231200='
      '1102231201=        IF (WHAT_PRICE_ = 0) THEN'
      
        '1102231202=          SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND((SEL' +
        'ECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_||'#39', 0)' +
        ') * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '1102231203=        ELSE'
      
        '1102231204=          SQL_STR_ = SQL_STR_ ||'#39'P.VOLUME_PRICE = ROU' +
        'ND((SELECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_' +
        '||'#39', 0)) * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '1102231205=      END'
      '1102231206=  END'
      '1102231207='
      '1102231208=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '1102231209=  IF (CHANGE_CATEGORY_ = 1) THEN BEGIN'
      '1102231210=    IF (CHANGE_PRICE_ = 1) THEN'
      '1102231211=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1102231212='
      
        '1102231213=    SQL_STR_ = SQL_STR_ ||'#39'P.G_PRODUCT_PAR = '#39'||:NEW_' +
        'CATEGORY_;'
      '1102231214=  END'
      '1102231215='
      '1102231216=  -- '#1052#1045#1053#1071#1070' '#1052#1048#1053' '#1054#1057#1058#1040#1058#1054#1050
      '1102231217=  IF (CHANGE_MIN_AMOUNT_ = 1) THEN BEGIN'
      '1102231218=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_) > 0) THEN'
      '1102231219=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1102231220='
      
        '1102231221=    SQL_STR_ = SQL_STR_ ||'#39'P.MIN_AMOUNT = '#39'||:NEW_MIN' +
        '_AMOUNT_;'
      '1102231222=  END'
      '1102231223='
      '1102231224=  -- '#1052#1045#1053#1071#1070' '#1050#1054#1052#1048#1057#1057#1048#1070' '#1055#1056#1054#1044#1040#1042#1062#1040
      '1102231225=  IF (CHANGE_SALES_COMM_ = 1) THEN BEGIN'
      
        '1102231226=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MI' +
        'N_AMOUNT_) > 0) THEN'
      '1102231227=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1102231228='
      
        '1102231229=    SQL_STR_ = SQL_STR_ ||'#39'P.SALES_COMM = '#39'||:NEW_SAL' +
        'ES_COMM_;'
      '1102231230=  END'
      '1102231231='
      
        '1102231232=  -- '#1052#1045#1053#1071#1070' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040' - '#1057' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1053#1040' '#1055#1056#1054#1044#1059#1050#1058' '#1048#1051#1048' ' +
        #1053#1040#1054#1041#1054#1056#1054#1058
      '1102231233=  IF (CHANGE_KIT_TYPE_ > 1) THEN BEGIN'
      
        '1102231234=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MI' +
        'N_AMOUNT_ + CHANGE_SALES_COMM_) > 0) THEN'
      '1102231235=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1102231236='
      
        '1102231237=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KIT = '#39'||:CHANGE_KIT_' +
        'TYPE_;'
      '1102231238='
      
        '1102231239=    -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1058#1048#1055' '#1058#1054#1042#1040#1056#1040' '#1057' "'#1057#1054#1057#1058#1040#1042#1053#1054#1049'" '#1053#1040' "'#1055#1056#1054 +
        #1044#1059#1050#1058'", '#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1053#1059#1051#1048#1058#1068' '#1042#1057#1045' '#1054#1057#1058#1040#1058#1050#1048' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042
      '1102231240=    IF (CHANGE_KIT_TYPE_ = 2) THEN'
      '1102231241=      UPDATE LT_SKLAD_PRODUCT P'
      '1102231242=         SET P.AMOUNT = 0,'
      '1102231243=             P.NEED_TO_EXPORT = 1'
      '1102231244=       WHERE EXISTS (SELECT 1'
      '1102231245=                       FROM G_PRODUCT GP'
      
        '1102231246=                      WHERE GP.G_PRODUCT = P.G_PRODUC' +
        'T'
      '1102231247=                        AND GP.IS_KIT = 1'
      
        '1102231248=                        AND ((:G_PRODUCT_ CONTAINING ' +
        #39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102231249=                             OR'
      
        '1102231250=                             (GP.G_PRODUCT = GP.G_PRO' +
        'DUCT AND :G_PRODUCT_ IS NULL)'
      '1102231251=                            )'
      '1102231252=                        AND ('
      
        '1102231253=                             ((GP.G_PRODUCT_PAR IN (S' +
        'ELECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE :G_CATEGORY_ CONTAIN' +
        'ING '#39'~'#39'||PT.G_PRODUCT||'#39'~'#39')) AND :g_category_ IS NOT NULL)'
      '1102231254=                              OR'
      
        '1102231255=                             (GP.G_PRODUCT_PAR = GP.G' +
        '_PRODUCT_PAR AND :g_category_ IS NULL)'
      '1102231256=                            )'
      '1102231257=                    );'
      '1102231258=  END'
      '1102231259='
      
        '1102231260=  --'#1052#1045#1053#1071#1070' '#1055#1056#1048#1047#1053#1040#1050' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1058#1054#1042#1040#1056' '#1042' KASPI '#1052#1040#1043#1040#1047#1048#1053' '#1048#1051#1048 +
        ' '#1053#1045#1058
      '1102231261=  IF (:IS_KASPI_SHOP_ = 1) THEN'
      '1102231262=  BEGIN'
      
        '1102231263=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MI' +
        'N_AMOUNT_ + CHANGE_SALES_COMM_) > 0) THEN'
      '1102231264=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1102231265='
      
        '1102231266=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KASPI_SHOP = '#39'||:IS_K' +
        'ASPI_SHOP_MODE_;'
      '1102231267=  END'
      '1102231268='
      '1102231269=  SQL_STR_ = SQL_STR_ ||'#39'  WHERE P.IS_ACTIVE = 1'#39';'
      '1102231270='
      '1102231271=  IF (CHANGE_KIT_TYPE_ = 0) THEN'
      '1102231272=    SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_KIT <> 1'#39';'
      '1102231273='
      '1102231274=  SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_CATEGORY = 0'#39';'
      '1102231275='
      '1102231276=  IF (g_category_ IS NOT NULL) THEN'
      
        '1102231277=    SQL_STR_ = SQL_STR_ ||'#39' AND P.G_PRODUCT_PAR IN (S' +
        'ELECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE '#39#39#39'||G_CATEGORY_||'#39#39 +
        #39' CONTAINING '#39#39'~'#39#39'||PT.G_PRODUCT||'#39#39'~'#39#39')'#39';'
      '1102231278='
      '1102231279='
      '1102231280=  IF (G_PRODUCT_ IS NOT NULL) THEN'
      
        '1102231281=    SQL_STR_ = SQL_STR_ ||'#39' AND '#39#39#39'||G_PRODUCT_||'#39#39#39' ' +
        'CONTAINING '#39#39'~'#39#39'||P.G_PRODUCT||'#39#39'~'#39#39#39';'
      '1102231282='
      '1102231285='
      '1102231286=  EXECUTE STATEMENT :SQL_STR_;'
      '1102231287=END'
      '1102231288=;'
      '1102231289='
      '1102231290=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1102231291=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1102231292=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1102231293=  ARTICUL_ VARCHAR(30),'
      '1102231294=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1102231295=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102231296=  NAME_ VARCHAR(500),'
      '1102231297=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1102231298=  PRICE_ NUMERIC(15,2),'
      '1102231299=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1102231300=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1102231301=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1102231302=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102231303=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102231304=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1102231305=  IS_CATEGORY_ INTEGER,'
      '1102231306=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1102231307=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102231308=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1102231309=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1102231310=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1102231311=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1102231312=  IS_MARKED_ INTEGER,'
      '1102231313=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102231314=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '1102231315=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '1102231316=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE,'
      
        '1102231317=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = nul' +
        'l,'
      '1102231318=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = null,'
      '1102231319=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102231320=  IS_KASPI_SHOP_ SMALLINT = 0)'
      '1102231321=RETURNS ('
      '1102231322=  ERR_CODE INTEGER,'
      '1102231323=  ERR_MSG VARCHAR(1024))'
      '1102231324=AS'
      
        '1102231325=declare variable PROCNAME varchar(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      
        '1102231326=declare variable G_PRODUCT_SOSTAV_AMOUNT_ type of col' +
        'umn LT_SKLAD_PRODUCT.AMOUNT;'
      '1102231327=begin'
      
        '1102231328=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1102231329=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '1102231330=                  FROM G_PRODUCT G'
      
        '1102231331=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(' +
        ':ARTICUL_))'
      '1102231332=                   AND TRIM(G.ARTICUL) <> '#39#39
      '1102231333=                   AND TRIM(:ARTICUL_) <> '#39#39
      '1102231334=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1102231335=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1102231336=      ERR_CODE = -20500;'
      
        '1102231337=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '1102231338=      EXIT;'
      '1102231339=    END'
      '1102231340='
      
        '1102231341=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1102231342=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1102231343=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1102231344=                  FROM G_PRODUCT G'
      
        '1102231345=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPP' +
        'ER(TRIM(:NOMENCLATUR_NUM_))'
      '1102231346=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1102231347=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1102231348=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1102231349=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1102231350=      ERR_CODE = -20500;'
      
        '1102231351=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1102231352=      EXIT;'
      '1102231353=    END'
      '1102231354=    */'
      '1102231355='
      '1102231356=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1102231357=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1102231358=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1102231359=                  FROM G_PRODUCT G'
      
        '1102231360=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(' +
        ':BARCODE_))'
      '1102231361=                   AND TRIM(G.BARCODE) <> '#39#39
      '1102231362=                   AND TRIM(:BARCODE_) <> '#39#39
      '1102231363=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1102231364=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1102231365=          ERR_CODE = -20500;'
      
        '1102231366=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1102231367=          EXIT;'
      '1102231368=        END'
      '1102231369='
      '1102231370=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1102231371=                    FROM G_PRODUCT G, LT_BARCODE L'
      '1102231372=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1102231373=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '1102231374=                     AND TRIM(L.BARCODE) <> '#39#39
      '1102231375=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1102231376=          ERR_CODE = -20500;'
      
        '1102231377=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1102231378=          EXIT;'
      '1102231379=        END'
      '1102231380=    END'
      '1102231381='
      '1102231382=    update G_PRODUCT'
      '1102231383=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1102231384=        ARTICUL = :ARTICUL_,'
      '1102231385=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1102231386=        BARCODE = :BARCODE_,'
      '1102231387=        NAME = :NAME_,'
      '1102231388=        G_UNIT = :G_UNIT_,'
      '1102231389=        PRICE = :PRICE_,'
      '1102231390=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1102231391=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1102231392=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1102231393=        NOTE         = :NOTE_,'
      '1102231394=        CROSSCODE    = :CROSSCODE_,'
      '1102231395=        IS_KIT       = :IS_KIT_,'
      '1102231396=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1102231397=        PLACE        = :PLACE_,'
      '1102231398=        SALES_COMM   = :SALES_COMM_,'
      '1102231399=        KOD_TNVD     = :KOD_TNVD_,'
      '1102231400=        FAST_TOVAR   = :FAST_TOVAR_,'
      '1102231401=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '1102231402=        IS_MARKED    = :IS_MARKED_,'
      '1102231403=        BRAND        = :BRAND_,'
      '1102231404=        IS_WEIGHT    = :IS_WEIGHT_,'
      '1102231405=        VES_GRAMM    = :VES_GRAMM_,'
      '1102231406=        VES_GRAMM_PRICE = :VES_GRAMM_PRICE_,'
      '1102231407=        IS_KASPI_SHOP = :IS_KASPI_SHOP_'
      '1102231408=    where (G_PRODUCT = :G_PRODUCT_);'
      '1102231409='
      '1102231410=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1102231411=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1102231412='
      '1102231413=        INSERT INTO LT_BARCODE'
      
        '1102231414=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1102231415='
      '1102231416=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1102231417=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1102231418=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1102231419='
      
        '1102231420=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1102231421=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1102231422='
      '1102231423=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1102231424=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1102231425=            /*INSERT INTO G_PRODUCT_KIT'
      
        '1102231426=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1102231427=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1102231428=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1102231429=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1102231430='
      
        '1102231431=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1102231432=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1102231433='
      '1102231434=            UPDATE G_PRODUCT_KIT G'
      
        '1102231435=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1102231436=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1102231437=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1102231438=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1102231439='
      
        '1102231440=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' ' +
        #1074#1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '1102231441=            */'
      
        '1102231442=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PRO' +
        'DUCT = :G_PRODUCT_;'
      '1102231443=            INSERT INTO G_PRODUCT_KIT'
      
        '1102231444=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '1102231445=            FROM G_PRODUCT_KIT_TMP T;'
      '1102231446='
      
        '1102231447=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1102231448=            if (is_kit_ = 1) then begin'
      
        '1102231449=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1102231450=                  FROM G_PRODUCT_KIT K,'
      '1102231451=                       LT_SKLAD_PRODUCT L'
      '1102231452=                 WHERE K.g_product = :G_PRODUCT_'
      '1102231453=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1102231454=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1102231455=                 GROUP BY K.G_PRODUCT'
      '1102231456=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1102231457='
      '1102231458=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102231459=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1102231460=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1102231461=            end'
      '1102231462=        END'
      '1102231463=    END'
      '1102231464='
      '1102231465=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102231466=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1102231467='
      
        '1102231468=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1102231469=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102231470=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1102231471=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 2'
      '1102231472=          FROM RDB$DATABASE'
      
        '1102231473=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP' +
        ' AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_L' +
        'OADING = 0);'
      '1102231474=end'
      '1102231475=;'
      '1102231476='
      '1102231477=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '1102231478=  DATE_BEGIN_ DATE,'
      '1102231479=  DATE_END_ DATE,'
      '1102231480=  IS_SPISANIE_ INTEGER,'
      '1102231481=  SALE_OF_GOODS_ INTEGER)'
      '1102231482=RETURNS ('
      '1102231483=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102231484=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102231485=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1102231486=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102231487=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102231488=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1102231489=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102231490=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102231491=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102231492=  DETAILS_STR VARCHAR(3000),'
      '1102231493=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102231494=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1102231495=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '1102231496=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '1102231497=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1102231498=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102231499=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102231500=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102231501=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102231502=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1102231503=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '1102231504=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102231505=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102231506=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102231507=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102231508=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      
        '1102231509=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      
        '1102231510=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PA' +
        'Y_TYPE.NAME)'
      '1102231511=AS'
      '1102231512=/*'
      '1102231513=IS_SPISANIE_'
      '1102231514=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102231515=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102231516=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102231517=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102231518=*/'
      '1102231519=declare variable CNT_ integer = 0;'
      
        '1102231520=declare variable G_OFFICIAL_LOCAL_ type of column G_O' +
        'FFICIAL.G_OFFICIAL;'
      
        '1102231521=declare variable G_OFFICIAL_APPOINT_ type of column G' +
        '_OFFICIAL.IS_ISPOLNITEL;'
      '1102231522=BEGIN'
      '1102231523=  sale_of_goods_ = COALESCE(sale_of_goods_, 0);'
      '1102231524=  if (sale_of_goods_ = 0) then'
      '1102231525=  begin'
      '1102231526=    G_OFFICIAL_LOCAL_ = 0;'
      '1102231527=    G_OFFICIAL_APPOINT_ = 0;'
      '1102231528=  end'
      '1102231529=  else'
      '1102231530=  begin'
      '1102231531=      SELECT G.G_OFFICIAL,'
      '1102231532=             G.IS_ISPOLNITEL'
      '1102231533=        FROM CUR_PARAMS C,'
      '1102231534=             G_OFFICIAL G'
      '1102231535=       WHERE C.ID = G.G_OFFICIAL'
      '1102231536=         AND C.CUR_PARAMS = 1'
      '1102231537=        INTO :G_OFFICIAL_LOCAL_,'
      '1102231538=             :G_OFFICIAL_APPOINT_;'
      '1102231539=  end'
      '1102231540='
      '1102231541='
      '1102231542=  G_OFFICIAL_LOCAL_ = COALESCE(G_OFFICIAL_LOCAL_, 0);'
      
        '1102231543=  G_OFFICIAL_APPOINT_ = COALESCE(G_OFFICIAL_APPOINT_,' +
        ' 0);'
      '1102231544='
      '1102231545=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102231546=      SELECT COUNT(*)'
      '1102231547=        FROM ZAKAZ T'
      
        '1102231548=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '1102231549=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1102231550=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '1102231551=        INTO CNT_;'
      '1102231552='
      '1102231553=      if (CNT_ = 0) then'
      '1102231554=        SELECT MAX(T.Z_DATE)'
      '1102231555=          FROM ZAKAZ T'
      '1102231556=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '1102231557=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '1102231558=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102231559=          INTO :DATE_BEGIN_;'
      '1102231560='
      '1102231561=  END ELSE BEGIN'
      '1102231562=      SELECT COUNT(*)'
      '1102231563=        FROM SKLAD_PARENT T'
      
        '1102231564=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1102231565=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1102231566=        INTO CNT_;'
      '1102231567='
      '1102231568=      if (CNT_ = 0) then'
      '1102231569=        SELECT MAX(T.DATE_RECEIPT)'
      '1102231570=          FROM SKLAD_PARENT T'
      '1102231571=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1102231572=           AND T.IS_VOZVRAT = 3'
      
        '1102231573=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102231574=          INTO :DATE_BEGIN_;'
      '1102231575=  END'
      '1102231576='
      '1102231577=  -- '#1055#1056#1054#1044#1040#1046#1048
      '1102231578=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '1102231579=      FOR'
      '1102231580=        SELECT T.ZAKAZ,'
      
        '1102231581=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102231582=               T.G_TOCHKA,'
      '1102231583=               T.Z_DATE,'
      '1102231584=               T.Z_TIME,'
      '1102231585=               T.G_CLIENT,'
      '1102231586=               T.OSNOVANIE,'
      '1102231587=               T.NOTE,'
      '1102231588=               gc.name,'
      
        '1102231589=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AM' +
        'OUNT||'#39')'#39', '#39', '#39')'
      
        '1102231590=                            FROM (SELECT G.name, SUM(' +
        'D.amount) AMOUNT'
      
        '1102231591=                                    FROM ZAKAZ Z, ZAK' +
        'AZ_DETAILS D, G_PRODUCT G'
      
        '1102231592=                                   WHERE D.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1102231593=                                     AND D.ZAKAZ = Z.' +
        'ZAKAZ'
      
        '1102231594=                                     AND Z.ZAKAZ = T.' +
        'ZAKAZ'
      '1102231595=                                   GROUP BY G.name)'
      
        '1102231596=                          ) FROM 1 FOR 1500)*/'#39' '#39' DET' +
        'AILS_STR,'
      '1102231597=               T.IS_SPISANIE,'
      
        '1102231598=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_A' +
        'LL,'
      '1102231599=               IP.INVOICE_PAY,'
      '1102231600=               I.INVOICE,'
      '1102231601=               W.WAYBILL,'
      '1102231602=               T.SUMM,'
      '1102231603=               T.SUMM_FACT,'
      '1102231604=               COALESCE(t.SUMM_BONUS, 0),'
      '1102231605=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '1102231606=               COALESCE(T.BY_RECIPE, 0)'
      '1102231607=               ,IS_RESERVE'
      '1102231608=               ,T.SUMM_CASH'
      '1102231609=               ,T.SUMM_NONCASH'
      '1102231610=               ,O.g_official'
      '1102231611=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '1102231612=               ,T.DELIVERY_ADDRESS'
      '1102231613=               ,GN.G_NONCASH_PAY_TYPE'
      '1102231614=               ,GN.NAME'
      '1102231615=          FROM ZAKAZ T'
      
        '1102231616=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1102231617=                    LEFT OUTER JOIN INVOICE_PAY IP ON' +
        ' T.ZAKAZ = IP.ZAKAZ'
      
        '1102231618=                    LEFT OUTER JOIN INVOICE I ON T.ZA' +
        'KAZ = I.ZAKAZ'
      
        '1102231619=                    LEFT OUTER JOIN WAYBILL W ON T.ZA' +
        'KAZ = W.ZAKAZ'
      
        '1102231620=                    LEFT OUTER JOIN G_OFFICIAL O ON T' +
        '.g_official = O.g_official'
      
        '1102231621=                    LEFT OUTER JOIN G_NONCASH_PAY_TYP' +
        'E GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '1102231622=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102231623=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISA' +
        'NIE_ = 0'
      '1102231624=                 AND'
      
        '1102231625=                 ((:G_OFFICIAL_APPOINT_ = 1 AND T.G_O' +
        'FFICIAL = :G_OFFICIAL_LOCAL_)'
      '1102231626=                   OR'
      '1102231627=                  (:G_OFFICIAL_APPOINT_ = 0 )'
      '1102231628=                 )'
      '1102231629=                )'
      '1102231630=                or'
      
        '1102231631=                (T.IS_SPISANIE = :IS_SPISANIE_ AND :I' +
        'S_SPISANIE_ <> 0)'
      '1102231632=               )'
      
        '1102231633=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102231634=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1102231635=        INTO :ZAKAZ,'
      '1102231636=             :Z_NUM,'
      '1102231637=             :G_TOCHKA,'
      '1102231638=             :Z_DATE,'
      '1102231639=             :Z_TIME,'
      '1102231640=             :G_CLIENT,'
      '1102231641=             :OSNOVANIE,'
      '1102231642=             :NOTE,'
      '1102231643=             :CLIENT_NAME,'
      '1102231644=             :DETAILS_STR,'
      '1102231645=             :IS_SPISANIE,'
      '1102231646=             :IS_PAYED_ALL,'
      '1102231647=             :INVOICE_PAY,'
      '1102231648=             :INVOICE,'
      '1102231649=             :WAYBILL,'
      '1102231650=             :SUM_ZAKAZ,'
      '1102231651=             :SUM_FACT,'
      '1102231652=             :SUMM_PAY_BONUS,'
      '1102231653=             :SUMM_BONUS_GOT,'
      '1102231654=             :BY_RECIPE'
      '1102231655=             ,:IS_RESERVE'
      '1102231656=             ,:summ_cash'
      '1102231657=             ,:SUMM_NONCASH'
      '1102231658=             ,:G_OFFICIAL'
      '1102231659=             ,:G_OFFICIAL_FIO'
      '1102231660=             ,:ADDRESS'
      '1102231661=             ,:G_NONCASH_PAY_TYPE'
      '1102231662=             ,:G_NONCASH_PAY_TYPE_NAME'
      '1102231663=      DO'
      '1102231664=        suspend;'
      '1102231665='
      '1102231666=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '1102231667=  END ELSE IF (IS_SPISANIE_ = 1) THEN BEGIN'
      '1102231668=      FOR'
      '1102231669=        SELECT T.ZAKAZ,'
      
        '1102231670=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102231671=               T.G_TOCHKA,'
      '1102231672=               T.Z_DATE,'
      '1102231673=               T.Z_TIME,'
      '1102231674=               T.G_CLIENT,'
      '1102231675=               T.OSNOVANIE,'
      '1102231676=               T.NOTE,'
      '1102231677=               NULL,'
      '1102231678=               SUBSTRING((SELECT'
      
        '1102231679=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT|' +
        '|'#39')'#39', '#39', '#39')'
      
        '1102231680=                        FROM ZAKAZ_DETAILS D, G_PRODU' +
        'CT G'
      
        '1102231681=                        WHERE D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '1102231682=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '1102231683=                          GROUP BY ZAKAZ) FROM 1 FOR ' +
        '999) DETAILS_STR,'
      '1102231684=               T.IS_SPISANIE,'
      '1102231685=               0,'
      '1102231686=               NULL,'
      '1102231687=               NULL,'
      '1102231688=               NULL,'
      '1102231689=               T.SUMM,'
      '1102231690=               T.SUMM_FACT,'
      '1102231691=               0,'
      '1102231692=               0'
      '1102231693=          FROM ZAKAZ T'
      
        '1102231694=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1102231695=           AND T.IS_SPISANIE  = 1'
      
        '1102231696=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102231697=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1102231698=        INTO :ZAKAZ,'
      '1102231699=             :Z_NUM,'
      '1102231700=             :G_TOCHKA,'
      '1102231701=             :Z_DATE,'
      '1102231702=             :Z_TIME,'
      '1102231703=             :G_CLIENT,'
      '1102231704=             :OSNOVANIE,'
      '1102231705=             :NOTE,'
      '1102231706=             :CLIENT_NAME,'
      '1102231707=             :DETAILS_STR,'
      '1102231708=             :IS_SPISANIE,'
      '1102231709=             :IS_PAYED_ALL,'
      '1102231710=             :INVOICE_PAY,'
      '1102231711=             :INVOICE,'
      '1102231712=             :WAYBILL,'
      '1102231713=             :SUM_ZAKAZ,'
      '1102231714=             :SUM_FACT,'
      '1102231715=             :SUMM_PAY_BONUS,'
      '1102231716=             :SUMM_BONUS_GOT'
      '1102231717=      DO'
      '1102231718=        suspend;'
      '1102231719='
      '1102231720=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102231721=  END ELSE BEGIN'
      '1102231722=      FOR'
      '1102231723=        SELECT T.SKLAD,'
      
        '1102231724=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1102231725=               T.G_TOCHKA,'
      '1102231726=               T.DATE_RECEIPT,'
      '1102231727=               T.TIME_RECEIPT,'
      '1102231728=               T.G_CLIENT,'
      '1102231729=               T.OSNOVANIE,'
      '1102231730=               T.NOTE,'
      '1102231731=               gc.name,'
      '1102231732=               /*SUBSTRING((SELECT'
      
        '1102231733=                            LIST(G.NAME||'#39'('#39'||D.AMOUN' +
        'T||'#39')'#39', '#39', '#39')'
      '1102231734=                            FROM SKLAD D, G_PRODUCT G'
      
        '1102231735=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1102231736=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1102231737=                            GROUP BY SKLAD_PARENT) FR' +
        'OM 1 FOR 999)*/ '#39#39' DETAILS_STR,'
      '1102231738=               T.SUMM,'
      '1102231739=               T.IS_VOZVRAT,'
      '1102231740=               W.WAYBILL'
      
        '1102231741=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL' +
        ' W ON T.SKLAD = W.ZAKAZ,'
      '1102231742=               G_TOCHKA GC'
      
        '1102231743=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1102231744=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1102231745=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '1102231746=           AND T.IS_VOZVRAT = 3'
      '1102231747=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '1102231748=        INTO :ZAKAZ,'
      '1102231749=             :Z_NUM,'
      '1102231750=             :G_TOCHKA,'
      '1102231751=             :Z_DATE,'
      '1102231752=             :Z_TIME,'
      '1102231753=             :G_CLIENT,'
      '1102231754=             :OSNOVANIE,'
      '1102231755=             :NOTE,'
      '1102231756=             :CLIENT_NAME,'
      '1102231757=             :DETAILS_STR,'
      '1102231758=             :SUM_ZAKAZ,'
      '1102231759=             :IS_SPISANIE,'
      '1102231760=             :WAYBILL'
      '1102231761=      DO'
      '1102231762=        suspend;'
      '1102231763=  END'
      '1102231764=end'
      '1102231765=;'
      '1102231766='
      '1102231767='
      
        '1102231768=UPDATE SYSTEM_SETUP SET S_VALUE = 110223 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102231769=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102231770=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1102240=UPDATE SYSTEM_SETUP SET S_VALUE = 110224 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1102241=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1102242=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102250='
      '1102251=ALTER PROCEDURE DEL_SKLAD('
      '1102252=  SKLAD_ /* TYPE OF COLUMN SKLAD.SKLAD */ BIGINT,'
      '1102253=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1102254=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102255=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ BI' +
        'GINT = NULL,'
      
        '1102256=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SUB_' +
        'TYPE 1 SEGMENT SIZE 16384 = NULL)'
      '1102257=RETURNS ('
      '1102258=  ERR_CODE INTEGER,'
      '1102259=  ERR_MSG VARCHAR(1024))'
      '11022510=AS'
      '11022511=BEGIN'
      '11022512=  SUSPEND;'
