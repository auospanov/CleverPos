        '11019441=  P_REP_PROFIT_TABLE /* TYPE OF COLUMN P_REP_PROFIT_TAB' +
        'LE.P_REP_PROFIT_TABLE */ INTEGER,'
      
        '11019442=  ZAKAZ /* TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ */ B' +
        'IGINT,'
      
        '11019443=  G_TOCHKA /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHK' +
        'A */ BIGINT,'
      
        '11019444=  Z_DATE /* TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE */' +
        ' DATE,'
      
        '11019445=  G_CLIENT /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIEN' +
        'T */ BIGINT,'
      
        '11019446=  CLIENT_NAME /* TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIE' +
        'NT_NAME */ VARCHAR(500),'
      
        '11019447=  G_PAYMENT_TYPE /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G' +
        '_PAYMENT_TYPE */ BIGINT,'
      
