      '11020265='
      '11020266='
      
        '11020267=/******************************************************' +
        '************************/'
      
        '11020268=/****                           Altering tables        ' +
        '                    ****/'
      
        '11020269=/******************************************************' +
        '************************/'
      '11020270='
      '11020271=ALTER TABLE LOGS'
      '11020272=  ADD ID_ORIGINAL DM_BIGINT;'
      '11020273='
      '11020274=ALTER TABLE LOGS'
      '11020275=  ADD TTABLE VR_50;'
      '11020276='
      '11020277='
      
        '11020278=/******************************************************' +
        '************************/'
      
        '11020279=/****                      Updating column positions   ' +
        '                    ****/'
      
        '11020280=/******************************************************' +
        '************************/'
      '11020281=ALTER TABLE LOGS ALTER COLUMN ID POSITION 1;'
      '11020282='
      '11020283=ALTER TABLE LOGS ALTER COLUMN ID_ORIGINAL POSITION 2;'
      '11020284='
      '11020285=ALTER TABLE LOGS ALTER COLUMN SQLSTMT POSITION 3;'
      '11020286='
      '11020287=ALTER TABLE LOGS ALTER COLUMN TTABLE POSITION 4;'
      '11020288='
      '11020289=ALTER TABLE LOGS ALTER COLUMN USR POSITION 5;'
      '11020290='
      '11020291=ALTER TABLE LOGS ALTER COLUMN RR POSITION 6;'
      '11020292='
      '11020293=ALTER TABLE LOGS ALTER COLUMN DAT POSITION 7;'
      '11020294='
      '11020295=ALTER TABLE LOGS ALTER COLUMN IS_TRANSFERED POSITION 8;'
      '11020296='
      '11020297=ALTER TABLE LOGS ALTER COLUMN SYSDATE POSITION 9;'
      '11020298='
      '11020299=ALTER TABLE LOGS ALTER COLUMN ERR_CODE POSITION 10;'
      '110202100='
      '110202101='
      
        '110202102=/*****************************************************' +
        '*************************/'
      
        '110202103=/****            Altering stored procedures (with empt' +
        'y bodies)            ****/'
      
        '110202104=/*****************************************************' +
        '*************************/'
      '110202105='
      '110202106=ALTER PROCEDURE SYNC_UPLOAD('
      
        '110202107=  SYNC_COMPS_ /* TYPE OF COLUMN SYNC_COMPS.SYNC_COMPS ' +
        '*/ INTEGER)'
      '110202108=RETURNS ('
      '110202109=  ID /* TYPE OF COLUMN LOGS.ID */ BIGINT,'
      
        '110202110=  SQLSTMT /* TYPE OF COLUMN LOGS.SQLSTMT */ VARCHAR(30' +
        '000),'
      '110202111=  TTABLE /* TYPE OF COLUMN LOGS.TTABLE */ VARCHAR(50),'
      '110202112=  USR /* TYPE OF COLUMN LOGS.USR */ VARCHAR(50),'
      '110202113=  RR /* TYPE OF COLUMN LOGS.RR */ VARCHAR(50),'
      
        '110202114=  DAT /* TYPE OF COLUMN LOGS.DAT */ BLOB SEGMENT SIZE ' +
        '16384)'
      '110202115=AS'
      '110202116=BEGIN'
      '110202117=  SUSPEND;'
      '110202118=END'
      '110202119=;'
      '110202120='
      '110202121='
      
        '110202122=/*****************************************************' +
        '*************************/'
      
        '110202123=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110202124=/*****************************************************' +
        '*************************/'
      '110202125=ALTER PROCEDURE K_RECALC_KASSA('
      '110202126=  ACTION_DATE_ DATE,'
      '110202127=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110202128=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110202129=RETURNS ('
      '110202130=  ERR_CODE INTEGER,'
      '110202131=  ERR_MSG VARCHAR(1024))'
      '110202132=AS'
      
        '110202133=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASS' +
        'A'#39';'
      '110202134=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110202135=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '110202136=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_STATE.K_' +
        'DATE;'
      '110202137=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '110202138=BEGIN'
      '110202139='
      '110202140=  IF (G_TOCHKA_ IS NULL) THEN'
      '110202141=    SELECT ID'
      '110202142=      FROM CUR_PARAMS'
      '110202143=     WHERE CUR_PARAMS = 2'
      '110202144=      INTO :G_TOCHKA_;'
      '110202145='
      
        '110202146=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047 +
        #1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043 +
        #1054#1044#1053#1071' 21.02.'
      
        '110202147=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057 +
        #1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      '110202148=  PNT_ = '#39'00'#39';'
      
        '110202149=  IF ((SELECT COUNT(*) FROM KASSA_STATE K WHERE K.K_DA' +
        'TE = CURRENT_DATE AND G_TOCHKA = :G_TOCHKA_) = 0) THEN BEGIN'
      '110202150=    INSERT INTO KASSA_STATE'
      
        '110202151=      (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT, OUTP' +
        'UT, G_TOCHKA, NEED_TO_EXPORT)'
      '110202152=    VALUES'
      
        '110202153=      (GEN_ID(GEN_KASSA_STATE, 1), CURRENT_DATE, 0 , 0' +
        ', 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110202154='
      
        '110202155=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202156=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110202157=      SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110202158=                 '#39'USING (select CAST('#39#39#39'||CURRENT_DATE' +
        '||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '110202159=                 '#39' from RDB$DATABASE) cd '#39'||'
      
        '110202160=                 '#39'ON (c.K_DATE = cd.K_DATE AND C.G_TOC' +
        'HKA = CD.G_TOCHKA) '#39'||'
      '110202161=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110202162=                 '#39' INSERT (KASSA_STATE, K_DATE, "INPUT' +
        '", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '110202163=                 '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_STATE, ' +
        '0)||'#39', '#39#39#39'||CURRENT_DATE||'#39#39#39', 0, 0, 0, 0, '#39'||G_TOCHKA_||'#39');'#39';'
      
        '110202164=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110202165=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202166=    END'
      '110202167=    */'
      '110202168=  END'
      '110202169='
      
        '110202170=  ----------------------------------------------------' +
        '------------------'
      
        '110202171=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055#1056 +
        #1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      
        '110202172=  -- '#1040' '#1058#1040#1050#1046#1045' '#1053#1059#1046#1053#1054' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1047#1040#1056#1055#1051 +
        #1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040#1052', '#1058#1040#1052' '#1047#1040#1055#1048#1057#1068' '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040#1058#1054#1049
      '110202173=  PNT_ = '#39'01'#39';'
      '110202174=  IF (ACTION_DATE_ >= CURRENT_DATE) THEN BEGIN'
      '110202175=    SELECT ST."OUTPUT",'
      '110202176=           ST.K_DATE'
      '110202177=      FROM KASSA_STATE ST'
      
        '110202178=     WHERE ST.K_DATE < CURRENT_DATE   -- '#1047#1044#1045#1057#1068' '#1069#1058#1054' '#1057#1055#1045 +
        #1062#1048#1040#1051#1068#1053#1054' '#1057#1044#1045#1051#1040#1053#1054', '#1063#1058#1054#1041#1067' '#1055#1045#1056#1045#1041#1048#1042#1040#1051#1040#1057#1068' '#1048' '#1047#1040#1055#1048#1057#1068' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' '#1058#1054#1046#1045', '#1040' ' +
        #1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1057#1054#1047#1044#1040#1051#1040#1057#1068', '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040' '#1053#1045#1058
      '110202179=       AND ST.G_TOCHKA = :G_TOCHKA_'
      '110202180=     ORDER BY ST.K_DATE DESC'
      '110202181=     ROWS 1'
      '110202182=     INTO :OUTPUT_,'
      '110202183=          :ACTION_DATE_;'
      '110202184='
      '110202185=    IF (OUTPUT_ IS NULL) THEN'
      '110202186=      SELECT ST."OUTPUT",'
      '110202187=             ST.K_DATE'
      '110202188=        FROM KASSA_STATE ST'
      '110202189=       WHERE ST.K_DATE = CURRENT_DATE'
      '110202190=         AND ST.G_TOCHKA = :G_TOCHKA_'
      '110202191=       ORDER BY ST.K_DATE DESC'
      '110202192=       INTO :OUTPUT_,'
      '110202193=            :ACTION_DATE_;'
      '110202194='
      '110202195=  END ELSE BEGIN'
      '110202196=    SELECT K.OUTPUT'
      '110202197=      FROM KASSA_STATE K'
      '110202198=     WHERE K.K_DATE = :ACTION_DATE_'
      '110202199=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110202200=      INTO :OUTPUT_;'
      '110202201='
      
        '110202202=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202203=    -- '#1045#1057#1051#1048' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067' '#1048#1047#1052#1045#1053#1045#1053#1048#1045', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040' '#1044#1056#1059#1043 +
        #1054#1052' '#1050#1054#1052#1055#1045' '#1058#1054#1046#1045' '#1047#1040#1055#1059#1057#1050#1040#1058#1068' K_RECALC_KASSA'
      
        '110202204=    -- '#1058#1045#1055#1045#1056#1068', '#1055#1056#1048' '#1050#1040#1046#1044#1054#1052' '#1048#1047#1052#1045#1053#1045#1053#1048#1048' '#1041#1059#1044#1045#1058' '#1042' LOG '#1055#1040#1044#1040#1058#1068 +
        ' '#1057#1058#1056#1054#1050#1040' "EXECUTE K_RECALC_KASSA" - '#1069#1058#1054' '#1053#1045#1055#1056#1048#1045#1052#1051#1045#1052#1054','
      
        '110202205=    -- '#1044#1056#1059#1043#1054#1049' '#1050#1054#1052#1055' '#1052#1054#1046#1045#1058' '#1053#1045' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1048#1053#1060#1059' '#1053#1045#1044#1045#1051#1071#1052#1048', '#1057#1054 +
        #1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1053#1059#1046#1053#1054', '#1063#1058#1054#1041#1067' '#1041#1067#1051#1040' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' '#1048' '#1047#1040#1055#1059#1057#1050#1040#1051#1040#1057#1068' ' +
        #1054#1053#1040
      '110202206=    -- '#1042' '#1050#1054#1053#1062#1045' SYNC_DOWNLOAD '#1054#1044#1048#1053' '#1056#1040#1047'.'
      
        '110202207=    -- '#1044#1051#1071' '#1069#1058#1054#1043#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1042' LOG "EXE' +
        'CUTE K_RECALC_KASSA" '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_TRANSFERED = 0 '#1048' '#1047#1040#1052#1045#1053#1071#1058#1068' '#1045#1045 +
        ' '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054
      
        '110202208=    -- '#1055#1054' '#1059#1052#1059' '#1053#1059#1046#1053#1054' '#1041#1067' '#1059#1044#1040#1051#1071#1058#1068' "EXECUTE K_RECALC_KASSA' +
        '" '#1057' '#1044#1040#1058#1054#1049' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1063#1058#1054#1041#1067' '#1053#1045' '#1041#1067#1051#1054' '#1044#1042#1054#1049#1053#1054#1043#1054' '#1055#1045#1056#1045#1057#1063#1045#1058#1040', '#1053#1054' '#1058 +
        #1040#1052' '#1058#1054#1043#1044#1040
      
        '110202209=    -- '#1053#1059#1046#1053#1054' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1044#1040#1058#1067' '#1048' G_TOCHKA - '#1069#1058#1054' '#1042#1057#1045' '#1057#1051#1048#1064 +
        #1050#1054#1052' '#1057#1051#1054#1046#1053#1054
      
        '110202210=    IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM' +
        '_SETUP = 5) > 0 AND (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39 +
        ') IS NULL)) THEN BEGIN'
      
        '110202211=      SQL_STMT_ = '#39'EXECUTE BLOCK AS DECLARE VARIABLE E' +
        'RR_CODE INTEGER;DECLARE VARIABLE ERR_MSG VARCHAR(1024); BEGIN '#39'|' +
        '|'
      
        '110202212=        '#39' EXECUTE PROCEDURE K_RECALC_KASSA('#39#39#39'||:ACTIO' +
        'N_DATE_||'#39#39#39', '#39'||:G_TOCHKA_||'#39', '#39'||:UPLOAD_TO_EXT_APP_||'#39') RETUR' +
        'NING_VALUES :ERR_CODE, :ERR_MSG; END'#39';'
      '110202213='
      
        '110202214=      -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1059#1044#1040#1051#1071#1070', '#1045#1057#1051#1048' '#1059#1046#1045' '#1041#1067#1051#1040' '#1054#1058#1055#1056#1040#1042#1050#1040 +
        ' '#1055#1045#1056#1045#1057#1063#1045#1058#1040' '#1047#1040' '#1069#1058#1059' '#1044#1040#1058#1059
      '110202215=      DELETE FROM LOGS'
      '110202216=      WHERE SQLSTMT = :SQL_STMT_'
      '110202217=        AND IS_TRANSFERED = 0'
      '110202218=        AND USR = '#39'SYSDBA'#39';'
      '110202219='
      
        '110202220=      INSERT INTO LOGS (ID, SQLSTMT, TTABLE, USR, IS_T' +
        'RANSFERED, SYSDATE, ERR_CODE)'
      
        '110202221=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'KASSA_' +
        'STATE'#39', '#39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202222=    END'
      '110202223=  END'
      '110202224='
      '110202225=  PNT_ = '#39'02'#39';'
      '110202226=  FOR SELECT K.K_DATE'
      '110202227=        FROM KASSA_STATE K'
      '110202228=       WHERE K.K_DATE > :ACTION_DATE_'
      '110202229=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110202230=      ORDER BY K.K_DATE, K.KASSA_STATE'
      '110202231=        INTO :K_DATE_'
      '110202232=  DO BEGIN'
      '110202233=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110202234=    UPDATE KASSA_STATE K'
      '110202235=       SET K.INPUT = :OUTPUT_,'
      
        '110202236=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESCE' +
        '(K.DEBET, 0) + COALESCE(K.CREDIT, 0),'
      '110202237=           K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110202238=     WHERE K.K_DATE = :K_DATE_'
      '110202239=       AND K.G_TOCHKA = :G_TOCHKA_;'
      '110202240='
      
        '110202241=    -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058 +
        #1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202242=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110202243=      SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      '110202244=                 '#39'    SET K.INPUT = '#39'||OUTPUT_||'#39', '#39'||'
      
        '110202245=                 '#39'    K.OUTPUT = '#39'||COALESCE(OUTPUT_, ' +
        '0)||'#39' - COALESCE(K.DEBET, 0) + COALESCE(K.CREDIT, 0) '#39'||'
      
        '110202246=                 '#39'WHERE K.K_DATE = '#39#39#39'||:K_DATE_||'#39#39#39#39 +
        '||'
      
        '110202247=                 '#39'  AND K.G_TOCHKA = '#39'||G_TOCHKA_||'#39';'#39 +
        ';'
      
        '110202248=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110202249=      VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39'SYSDBA' +
        #39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110202250=    END'
      '110202251=    */'
      '110202252='
      '110202253=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '110202254=    SELECT K.OUTPUT'
      '110202255=      FROM KASSA_STATE K'
      '110202256=     WHERE K.K_DATE = :K_DATE_'
      '110202257=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110202258=      INTO :OUTPUT_;'
      '110202259=  END'
      '110202260='
      '110202261=WHEN ANY DO BEGIN'
      '110202262=    Err_code = -20500;'
      
        '110202263=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110202264=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110202265=  END'
      '110202266=end'
      '110202267=;'
      '110202268='
      '110202269=ALTER PROCEDURE K_RECALC_KASSA_BEZNAL('
      '110202270=  ACTION_DATE_ DATE)'
      '110202271=RETURNS ('
      '110202272=  ERR_CODE INTEGER,'
      '110202273=  ERR_MSG VARCHAR(1024))'
      '110202274=AS'
      
        '110202275=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASS' +
        'A_BEZNAL'#39';'
      '110202276=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110202277=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '110202278=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_BEZNAL_S' +
        'TATE.K_DATE;'
      '110202279=DECLARE VARIABLE SQL_STMT_ VARCHAR(1000);'
      '110202280=BEGIN'
      '110202281='
      
        '110202282=  -- 21.02.2019 '#1045#1057#1051#1048' '#1047#1040' '#1058#1045#1050#1059#1065#1059#1070' '#1050#1040#1051#1045#1053#1044#1040#1056#1053#1059#1070' '#1044#1040#1058#1059' '#1053#1045#1058' '#1047 +
        #1040#1055#1048#1057#1048', '#1058#1054' '#1057#1054#1047#1044#1040#1052' '#1045#1045'. '#1042#1045#1044#1068' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' 20.02, '#1040' '#1057#1045#1043 +
        #1054#1044#1053#1071' 21.02.'
      
        '110202283=  -- '#1055#1054' '#1048#1044#1045#1045' '#1056#1040#1053#1068#1064#1045' '#1069#1058#1054#1043#1054' '#1053#1045' '#1041#1067#1051#1054', '#1053#1054' '#1041#1045#1047' '#1069#1058#1054#1043#1054' '#1042#1040#1051#1048#1058#1057 +
        #1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071'.'
      
        '110202284=  -- '#1052#1054#1046#1053#1054' '#1042#1045#1047#1044#1045' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' 0, '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1044#1040#1051#1068#1064#1045' '#1054#1053#1054' '#1041#1059#1044 +
