        '1101521985=                                              :Z_DATE' +
        '_,'
      
        '1101521986=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101521987=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1101521988=                                              NULL,'
      
        '1101521989=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1101521990=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101521991=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101521992=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101521993=                  EXIT;'
      '1101521994=                END'
      '1101521995=            END'
      '1101521996='
      '1101521997=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1101521998=        END ELSE BEGIN'
      '1101521999=            PNT_ = '#39'06'#39';'
      
        '1101522000=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1101522001=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101522002=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101522003=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101522004=                ELSE'
      
        '1101522005=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101522006='
      
        '1101522007=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101522008=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101522009='
      
        '1101522010=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101522011='
      '1101522012=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101522013=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101522014=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
