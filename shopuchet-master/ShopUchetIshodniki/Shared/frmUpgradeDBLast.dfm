      '110682219=ALTER PROCEDURE R_DEL_REVISION('
      '110682220=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110682221=AS'
      '110682222=BEGIN'
      '110682223=  IF (G_TOCHKA_ IS NULL) THEN'
      '110682224=    SELECT ID'
      '110682225=      FROM CUR_PARAMS'
      '110682226=     WHERE CUR_PARAMS = 2'
      '110682227=      INTO :G_TOCHKA_;'
      '110682228='
      '110682229=  DELETE FROM REVISION WHERE G_TOCHKA = :G_TOCHKA_;'
      '110682230=END'
      '110682231=;'
      '110682232='
      '110682233=ALTER PROCEDURE R_IMPORT_REVISION('
      '110682234=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110682235=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110682236=  AMOUNT_ TYPE OF COLUMN REVISION.AMOUNT_REAL)'
      '110682237=RETURNS ('
      '110682238=  ERR_CODE INTEGER,'
      '110682239=  ERR_MSG VARCHAR(1024))'
      '110682240=AS'
      
        '110682241=DECLARE VARIABLE G_PRODUCT_     TYPE OF COLUMN LT_SKLA' +
        'D_PRODUCT.G_PRODUCT = NULL;'
      
        '110682242=DECLARE VARIABLE ID_            TYPE OF COLUMN REVISIO' +
        'N.REVISION;'
      '110682243=DECLARE VARIABLE POS_           INTEGER;'
      '110682244=DECLARE VARIABLE POS2_          INTEGER;'
      '110682245=DECLARE VARIABLE POS3_          INTEGER;'
      '110682246=DECLARE VARIABLE STRR           VARCHAR(100);'
      '110682247=BEGIN'
      '110682248=  SELECT G_PRODUCT'
      '110682249=    FROM G_PRODUCT G'
      '110682250=   WHERE G.BARCODE = :BARCODE_'
      '110682251=     AND G.IS_ACTIVE = 1'
      '110682252=    INTO :G_PRODUCT_;'
      '110682253='
      '110682254=  IF (G_PRODUCT_ IS NOT NULL) THEN BEGIN'
      '110682255=      UPDATE REVISION R'
      '110682256=         SET R.AMOUNT_REAL = :AMOUNT_'
      '110682257=       WHERE R.G_PRODUCT = :G_PRODUCT_'
      '110682258=         AND R.G_TOCHKA = :G_TOCHKA_;'
      '110682259='
      '110682260=      IF (ROW_COUNT = 0) THEN BEGIN'
      
        '110682261=        INSERT INTO REVISION (REVISION, G_PRODUCT, AMO' +
        'UNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '110682262=        VALUES ((SELECT COALESCE(MAX(REVISION), 0) + 1' +
        ' FROM REVISION),'
      '110682263=                :G_PRODUCT_,'
      '110682264=                COALESCE((SELECT AMOUNT'
      '110682265=                            FROM LT_SKLAD_PRODUCT'
      
        '110682266=                           WHERE G_TOCHKA = :G_TOCHKA_' +
        ' AND G_PRODUCT = :G_PRODUCT_), 0),'
      '110682267=                :AMOUNT_,'
      '110682268=                0,'
      '110682269=                :G_TOCHKA_);'
      '110682270=      END'
      '110682271=  END ELSE BEGIN'
      '110682272=    ERR_CODE = 0;'
      
        '110682273=    ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' ' +
        #1085#1072#1081#1076#1077#1085'.'#39';'
      '110682274=  END'
      '110682275='
      '110682276=WHEN ANY DO BEGIN'
      '110682277=    IF (gdscode = 335544652) THEN BEGIN'
      '110682278=      ERR_CODE = 0;'
      
        '110682279=      ERR_MSG = '#39#1053#1072#1081#1076#1077#1085#1086' '#1085#1077#1089#1082#1086#1083#1100#1082#1086' '#1090#1086#1074#1072#1088#1086#1074' '#1089' '#1090#1072#1082#1080#1084' '#1096#1090#1088 +
        #1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_;'
      '110682280=    END ELSE BEGIN'
      '110682281=      ERR_CODE = 0;'
      
        '110682282=      ERR_MSG = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1096#1090#1088#1080#1093#1082#1086#1076#1072' '#39'||BARC' +
        'ODE_||'#39'. '#1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||gdscode;'
      '110682283=    END'
      '110682284=  END'
      '110682285=END'
      '110682286=;'
      '110682287='
      '110682288=ALTER PROCEDURE RECREATE_TRGS'
      '110682289=AS'
      
        '110682290=DECLARE VARIABLE SETUP_ TYPE OF COLUMN SYSTEM_SETUP.S_' +
        'VALUE;'
      '110682291=BEGIN'
      '110682292=  SELECT S.S_VALUE'
      '110682293=    FROM SYSTEM_SETUP S'
      '110682294=   WHERE S.SYSTEM_SETUP = 5'
      '110682295=    INTO :SETUP_;'
      '110682296='
      '110682297=  IF (SETUP_ > 0) THEN BEGIN'
      '110682298=      EXECUTE PROCEDURE LOG_DEINIT;'
      '110682299=      EXECUTE PROCEDURE LOG_INIT;'
      '110682300=  END'
      '110682301=END'
      '110682302=;'
      
        '110682304=UPDATE SYSTEM_SETUP SET S_VALUE = 11068 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '110682305=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110682306=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110690=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110691=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110692=RETURNS ('
      '110693=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '110694=  ARTICUL_ VARCHAR(30),'
      '110695=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110696=  BARCODE_ VARCHAR(30),'
      '110697=  NAME_ VARCHAR(500),'
      '110698=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110699=  PRICE_ NUMERIC(15,2),'
      '1106910=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1106911=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1106912=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1106913=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1106914=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1106915=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1106916=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1106917=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1106918=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1106919=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1106920=  ERR_CODE INTEGER,'
      '1106921=  ERR_MSG VARCHAR(1024))'
      '1106922=AS'
      '1106923=begin'
      '1106924=    SELECT'
      '1106925=        G_PRODUCT_PAR,'
      '1106926=        ARTICUL,'
      '1106927=        NOMENCLATUR_NUM,'
      '1106928=        BARCODE,'
      '1106929=        NAME,'
      '1106930=        G_UNIT,'
      '1106931=        PRICE,'
      '1106932=        VOLUME_PRICE,'
      '1106933=        PACK_AMOUNT,'
      '1106934=        MF_COUNTRY,'
      '1106935=        NOTE,'
      '1106936=        CROSSCODE,'
      '1106937=        IS_KIT,'
      '1106938=        MIN_AMOUNT,'
      '1106939=        PLACE,'
      '1106940=        SALES_COMM,'
      '1106941=        KOD_TNVD'
      '1106942=    FROM G_PRODUCT T'
      '1106943=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1106944=    INTO'
      '1106945=        :G_PRODUCT_PAR_,'
      '1106946=        :ARTICUL_,'
      '1106947=        :NOMENCLATUR_NUM_,'
      '1106948=        :BARCODE_,'
      '1106949=        :NAME_,'
      '1106950=        :G_UNIT_,'
      '1106951=        :PRICE_,'
      '1106952=        :VOLUME_PRICE_,'
      '1106953=        :PACK_AMOUNT_,'
      '1106954=        :MF_COUNTRY_,'
      '1106955=        :NOTE_,'
      '1106956=        :CROSSCODE_,'
      '1106957=        :IS_KIT_,'
      '1106958=        :MIN_AMOUNT_,'
      '1106959=        :PLACE_,'
      '1106960=        :SALES_COMM_,'
      '1106961=        :KOD_TNVD_;'
      '1106962='
      '1106963=    INSERT INTO LT_BARCODE_TMP'
      
        '1106964=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARCOD' +
        'E WHERE G_PRODUCT = :G_PRODUCT_;'
      '1106965='
      '1106966=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '1106967=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1106968='
      '1106969=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '1106970=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '1106971=end'
      '1106972=;'
      '1106973='
      '1106974=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1106975=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1106976=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1106977=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1106978=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106979=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106980=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1106981=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1106982=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1106983=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1106984=  SELF_PRICE_ NUMERIC(15,2),'
      '1106985=  AMOUNT_ MY_NUMERIC_5,'
      '1106986=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1106987=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1106988=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1106989=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1106990=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1106991=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1106992=  IS_THIS_LAST_ INTEGER,'
      '1106993=  UPDATE_IF_EXIST_ INTEGER)'
      '1106994=RETURNS ('
      '1106995=  ERR_CODE INTEGER,'
      '1106996=  ERR_MSG VARCHAR(1024))'
      '1106997=AS'
      
        '1106998=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PROD' +
        'UCT'#39';'
      '1106999=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11069100=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '11069101=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11069102=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11069103=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11069104=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11069105=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11069106=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11069107=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11069108=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11069109=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11069110=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11069111=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11069112=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11069113=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11069114=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11069115=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11069116=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11069117=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11069118=BEGIN'
      '11069119=    ERR_MSG = '#39#39';'
      '11069120='
      '11069121=    SELECT ID'
      '11069122=      FROM CUR_PARAMS'
      '11069123=    WHERE CUR_PARAMS = 2'
      '11069124=      INTO :G_TOCHKA_;'
      '11069125='
      '11069126=    SELECT G.G_UNIT'
      '11069127=      FROM G_UNIT G'
      
        '11069128=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11069129=      INTO :G_UNIT_;'
      '11069130=    if (ROW_COUNT = 0) then'
      '11069131=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11069132='
      '11069133=    PNT_ = '#39'02'#39';'
      
        '11069134=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11069135=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11069136=        SELECT G.G_PRODUCT,'
      '11069137=               G.NAME'
      '11069138=          FROM G_PRODUCT G'
      
        '11069139=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11069140=           AND TRIM(G.ARTICUL) <> '#39#39
      '11069141=          INTO :G_PRODUCT_,'
      '11069142=               :G_PRODUCT_NAME_;'
      '11069143='
      
        '11069144=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11069145=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11069146=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11069147=              UPDATE G_PRODUCT G'
      '11069148=                 SET G.NAME = :NAME_,'
      '11069149=                     G.G_UNIT = :G_UNIT_,'
      '11069150=                     G.PRICE  = :PRICE_,'
      '11069151=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11069152=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11069153=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11069154=                     G.PLACE = :PLACE_,'
      
        '11069155=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11069156=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11069157=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11069158=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11069159=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11069160='
      
        '11069161=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11069162=            END ELSE'
      
        '11069163=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11069164=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||U' +
        'PPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME_' +
        '||'#39'.'#39';'
      '11069165=        END'
      '11069166=    END ELSE'
      
        '11069167=      EXECUTE PROCEDURE get_free_articul RETURNING_VALU' +
        'ES (:ARTICUL_);'
      '11069168='
      
        '11069169=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052',' +
        ' '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11069170=    PNT_ = '#39'02a'#39';'
      
        '11069171=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11069172=        SELECT G.G_PRODUCT,'
      '11069173=               G.NAME'
      '11069174=          FROM G_PRODUCT G'
      
        '11069175=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_NU' +
        'M_)'
      '11069176=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '11069177=          INTO :G_PRODUCT_,'
      '11069178=               :G_PRODUCT_NAME_;'
      '11069179='
      
        '11069180=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11069181=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11069182=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11069183=              UPDATE G_PRODUCT G'
      '11069184=                 SET G.NAME = :NAME_,'
      '11069185=                     G.G_UNIT = :G_UNIT_,'
      '11069186=                     G.PRICE  = :PRICE_,'
      '11069187=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11069188=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11069189=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11069190=                     G.PLACE = :PLACE_,'
      
        '11069191=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11069192=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11069193=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11069194=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11069195=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11069196='
      
        '11069197=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077 +
        #1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11069198=            END ELSE'
      
        '11069199=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11069200=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39 +
        '||G_PRODUCT_NAME_||'#39'.'#39';'
      '11069201=        END'
      '11069202=    end'
      '11069203='
      
        '11069204=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11069205=    PNT_ = '#39'02b'#39';'
      
        '11069206=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11069207=        SELECT G.G_PRODUCT,'
      '11069208=               G.NAME'
      '11069209=          FROM G_PRODUCT G'
      '11069210=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11069211=           AND TRIM(G.BARCODE) <> '#39#39
      '11069212=          INTO :G_PRODUCT_,'
      '11069213=               :G_PRODUCT_NAME_;'
      '11069214='
      '11069215=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11069216=          SELECT G.G_PRODUCT,'
      '11069217=                 G.NAME'
      '11069218=            FROM G_PRODUCT G, LT_BARCODE L'
      '11069219=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11069220=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11069221=             AND TRIM(L.BARCODE) <> '#39#39
      '11069222=            INTO :G_PRODUCT_,'
      '11069223=                 :G_PRODUCT_NAME_;'
      '11069224='
      
        '11069225=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11069226=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11069227=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11069228=              UPDATE G_PRODUCT G'
      '11069229=                 SET G.NAME = :NAME_,'
      '11069230=                     G.G_UNIT = :G_UNIT_,'
      '11069231=                     G.PRICE  = :PRICE_,'
      '11069232=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11069233=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11069234=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11069235=                     G.PLACE = :PLACE_,'
      
        '11069236=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11069237=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11069238=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11069239=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11069240=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11069241='
      
        '11069242=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'|' +
        '|UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11069243=            END ELSE'
      
        '11069244=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11069245=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NA' +
        'ME_||'#39'.'#39';'
      '11069246=        END'
      '11069247=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN'
      
        '11069248=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RETU' +
        'RNING_VALUES (:BARCODE_);'
      '11069249='
      '11069250=    PNT_ = '#39'02b'#39';'
      '11069251=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '11069252=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR' +
        ', ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME' +
        '_PRICE,'
      
        '11069253=                               IS_CATEGORY, PACK_AMOUNT' +
        ', MF_COUNTRY, NOTE, PLACE, KOD_TNVD)'
      
        '11069254=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PA' +
        'R_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :' +
        'PRICE_,'
      
        '11069255=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_C' +
        'OUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_)'
      '11069256=        returning G_PRODUCT'
      '11069257=        into :G_PRODUCT_;'
      '11069258='
      
        '11069259=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11069260=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, 0, :G_TOCHKA_);'
      '11069261=    end'
      '11069262='
      
        '11069263=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045#1051 +
        #1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11069264=    PNT_ = '#39'03'#39';'
      '11069265=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '11069266=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '11069267=                                       :AMOUNT_,'
      '11069268=                                       :SELF_PRICE_,'
      
        '11069269=                                       :AMOUNT_ * :SELF' +
        '_PRICE_,'
      '11069270=                                       0, --nds_,'
      '11069271=                                       0 --nds_summ_,'
      '11069272=                                       ,:SELF_PRICE_UE_'
      
        '11069273=                                       ,:AMOUNT_ * :SEL' +
        'F_PRICE_UE_'
      
        '11069274=                                       ) RETURNING_VALU' +
        'ES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '11069275=        IF (ERR_CODE <> 0) THEN BEGIN'
      '11069276=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '11069277=          EXIT;'
      '11069278=        END'
      '11069279=    END'
      '11069280='
      
        '11069281=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' ' +
        #1047#1040#1055#1048#1057#1068
      '11069282=    PNT_ = '#39'04'#39';'
      '11069283=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '11069284=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061#1054 +
        #1044
      '11069285=        FROM SKLAD_TMP T'
      '11069286=        INTO :CNT_;'
      '11069287='
      '11069288=      if (CNT_ > 0) then BEGIN'
      '11069289=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '11069290=          FROM SKLAD_TMP T'
      '11069291=          INTO :SUMM_, :SUMM_UE_;'
      '11069292='
      '11069293=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '11069294=                                DATE_RECEIPT,'
      '11069295=                                TIME_RECEIPT,'
      '11069296=                                G_CLIENT,'
      '11069297=                                G_PAYMENT_TYPE,'
      '11069298=                                OSNOVANIE,'
      '11069299=                                NOTE,'
      '11069300=                                SUMM,'
      '11069301=                                SUMM_FACT,'
      '11069302=                                SUMM_CURRENCY,'
      '11069303=                                IS_PAYED_ALL,'
      '11069304=                                IS_VOZVRAT,'
      '11069305=                                G_TOCHKA)'
      '11069306=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11069307=                CURRENT_DATE,'
      '11069308=                CURRENT_TIME,'
      '11069309=                :G_CLIENT_,'
      '11069310=                1,'
      '11069311=                NULL,  --:OSNOVANIE_,'
      '11069312=                NULL,  -- :NOTE_,'
      '11069313=                :SUMM_,'
      '11069314=                :SUMM_,'
      '11069315=                :SUMM_UE_,'
      
        '11069316=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040 +
        ' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11069317=                0,'
      '11069318=                :G_TOCHKA_)'
      '11069319=        RETURNING'
      '11069320=          SKLAD'
      '11069321=        INTO'
      '11069322=          :SKLAD_PARENT_;'
      '11069323='
      '11069324=        PNT_ = '#39'05'#39';'
      '11069325=        FOR SELECT SKLAD,'
      '11069326=                   G_PRODUCT,'
      '11069327=                   AMOUNT,'
      '11069328=                   PRICE,'
      '11069329=                   SUMM'
      '11069330=                   ,PRICE_CURRENCY'
      '11069331=                   ,SUMM_CURRENCY'
      '11069332=              FROM SKLAD_TMP'
      '11069333=             ORDER BY 1'
      '11069334=              INTO :SKLAD_TMP_,'
      '11069335=                   :RG_PRODUCT_,'
      '11069336=                   :RAMOUNT_,'
      '11069337=                   :RPRICE_,'
      '11069338=                   :RSUMM_'
      '11069339=                   ,:RPRICE_UE_'
      '11069340=                   ,:RSUMM_UE_'
      '11069341=        DO BEGIN'
      '11069342='
      '11069343=            UPDATE SKLAD SK'
      '11069344=               SET SK.IS_LAST = 0'
      '11069345=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11069346=               AND SK.IS_LAST = 1;'
      '11069347='
      '11069348=            INSERT INTO SKLAD'
      '11069349=            ('
      '11069350=             SKLAD,'
      '11069351=             SKLAD_PARENT,'
      '11069352=             DATE_RECEIPT,'
      '11069353=             G_CLIENT,'
      '11069354=             G_PRODUCT,'
      '11069355=             AMOUNT,'
      '11069356=             PRICE,'
      '11069357=             SUMM,'
      '11069358=             G_PAYMENT_TYPE,'
      '11069359=             OSNOVANIE,'
      '11069360=             NOTE,'
      '11069361=             NDS,'
      '11069362=             NDS_SUMM,'
      '11069363=             IS_LAST,'
      '11069364=             IS_VOZVRAT,'
      '11069365=             G_TOCHKA'
      '11069366=             ,PRICE_CURRENCY'
      '11069367=             ,SUMM_CURRENCY'
      '11069368=            ) VALUES ('
      '11069369=             :SKLAD_TMP_,'
      '11069370=             :SKLAD_PARENT_,'
      '11069371=             CURRENT_DATE,'
      '11069372=             :G_CLIENT_,'
      '11069373=             :RG_PRODUCT_,'
      '11069374=             :RAMOUNT_,'
      '11069375=             :RPRICE_,'
      '11069376=             :RSUMM_,'
      '11069377=             1,       --:G_PAYMENT_TYPE_,'
      '11069378=             NULL,    --:OSNOVANIE_,'
      '11069379=             NULL,    --:NOTE_,'
      '11069380=             0,       --:RNDS_,'
      '11069381=             0,       --:RNDS_SUMM_,'
      '11069382=             1,       --IS_LAST_'
      '11069383=             0,        --:IS_VOZVRAT_'
      '11069384=             :G_TOCHKA_'
      '11069385=             ,:RPRICE_UE_'
      '11069386=             ,:RSUMM_UE_'
      '11069387=            );'
      '11069388='
      
        '11069389=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11069390=            PNT_ = '#39'06'#39';'
      '11069391=            UPDATE LT_SKLAD_PRODUCT L'
      '11069392=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11069393=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11069394=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11069395='
      '11069396=            PNT_ = '#39'06a'#39';'
      '11069397=            IF (ROW_COUNT = 0) THEN'
      
        '11069398=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11069399=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11069400=        END'
      '11069401='
      '11069402=        PNT_ = '#39'07'#39';'
      
        '11069403=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_' +
        ' => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11069404=                                2,    --:G_PRIHOD_RASHO' +
        'D_,'
      '11069405=                                :SUMM_,'
      '11069406=                                CURRENT_DATE,'
      
        '11069407=                                NULL,   --NOTE_ => :NOT' +
        'E_,'
      '11069408=                                NULL,   --ZAKAZ_'
      '11069409=                                :SKLAD_PARENT_,'
      '11069410=                                1,'
      
        '11069411=                                :G_TOCHKA_) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11069412=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11069413=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11069414=          EXIT;'
      '11069415=        END'
      '11069416='
      '11069417=        DELETE FROM SKLAD_TMP;'
      '11069418=      END'
      '11069419=    END'
      '11069420='
      
        '11069421=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054#1069 +
        #1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '11069422=    if (ERR_MSG_ IS NOT NULL) then'
      '11069423=      ERR_MSG = ERR_MSG_;'
      '11069424='
      '11069425=WHEN ANY DO BEGIN'
      '11069426=    Err_code = gdscode;'
      
        '11069427=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' --' +
        '> PNT_ '#39'||PNT_;'
      '11069428=  END'
      '11069429=END'
      '11069430=;'
      '11069431='
      '11069432=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '11069433=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11069434=  ARTICUL_ VARCHAR(30),'
      '11069435=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11069436=  BARCODE_ VARCHAR(30),'
      '11069437=  NAME_ VARCHAR(500),'
      '11069438=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11069439=  PRICE_ NUMERIC(15,2),'
      '11069440=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11069441=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11069442=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11069443=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11069444=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11069445=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11069446=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11069447=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11069448=  IS_CATEGORY_ INTEGER,'
      '11069449=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11069450=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD)'
      '11069451=RETURNS ('
      '11069452=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11069453=  ERR_CODE INTEGER,'
      '11069454=  ERR_MSG VARCHAR(1024))'
      '11069455=AS'
      
        '11069456=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODUC' +
        'T'#39';'
      '11069457=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11069458=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11069459=begin'
      
        '11069460=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11069461=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '11069462=        SELECT COUNT(*)'
      '11069463=          FROM G_PRODUCT G'
      
        '11069464=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11069465=           AND TRIM(G.ARTICUL) <> '#39#39
      '11069466=           AND G.IS_ACTIVE = 1'
      '11069467=          INTO :CNT_;'
      '11069468='
      '11069469=        IF (CNT_ > 0) THEN BEGIN'
      '11069470=          ERR_CODE = -20500;'
      
        '11069471=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '11069472=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11069473=          EXIT;'
      '11069474=        END'
      '11069475=    end'
      '11069476='
      '11069477=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '11069478=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then ' +
        'begin'
      '11069479=        SELECT COUNT(*)'
      '11069480=          FROM G_PRODUCT G'
      
        '11069481=         WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:N' +
        'OMENCLATUR_NUM_))'
      '11069482=           AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11069483=           AND G.IS_ACTIVE = 1'
      '11069484=        INTO :CNT_;'
      '11069485=        IF (CNT_ > 0) THEN BEGIN'
      '11069486=          ERR_CODE = -20500;'
      
        '11069487=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RE' +
        'TURNING_VALUES (:ERR_MSG);'
      '11069488=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11069489=          EXIT;'
      '11069490=        END'
      '11069491=    end'
      '11069492='
      '11069493=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11069494=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11069495=        SELECT COUNT(*)'
      '11069496=          FROM G_PRODUCT G'
      
        '11069497=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_)' +
        ')'
      '11069498=           AND TRIM(G.BARCODE) <> '#39#39
      '11069499=           AND G.IS_ACTIVE = 1'
      '11069500=          INTO :CNT_;'
      '11069501='
      '11069502=        IF (CNT_ = 0) then'
      '11069503=          SELECT COUNT(*)'
      '11069504=            FROM G_PRODUCT G, LT_BARCODE L'
      '11069505=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11069506=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11069507=             AND TRIM(L.BARCODE) <> '#39#39
      '11069508=             AND G.IS_ACTIVE = 1'
      '11069509=            INTO :CNT_;'
      '11069510='
      '11069511=        IF (CNT_ > 0) THEN BEGIN'
      '11069512=          ERR_CODE = -20500;'
      
        '11069513=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11069514=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11069515=          EXIT;'
      '11069516=        END'
      '11069517=    end'
      '11069518='
      
        '11069519=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PRI' +
        'CE,'
      
        '11069520=                           IS_CATEGORY, PACK_AMOUNT, MF' +
        '_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM' +
        ', KOD_TNVD)'
      
        '11069521=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_, ' +
        ':ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRIC' +
        'E_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '11069522=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROSS' +
        'CODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNVD_' +
        ')'
      '11069523=    RETURNING G_PRODUCT'
      '11069524=    INTO :G_PRODUCT_;'
      '11069525='
      '11069526=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '11069527=    if (:IS_CATEGORY_ = 0) then begin'
      
        '11069528=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11069529=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '11069530='
      '11069531=        INSERT INTO LT_BARCODE'
      
        '11069532=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT' +
        '_BARCODE_TMP;'
      '11069533='
      
        '11069534=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086 +
        #1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '11069535=        INSERT into G_PRODUCT_IMAGE'
      
        '11069536=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYPE' +
        ' from G_PRODUCT_IMAGE_TMP;'
      '11069537='
      
        '11069538=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089#1090 +
        #1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '11069539=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091#1082 +
        #1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '11069540=        IF (is_kit_ > 0) THEN begin'
      '11069541=            INSERT INTO G_PRODUCT_KIT'
      
        '11069542=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP;'
      '11069543='
      '11069544=            if (is_kit_ = 1) then begin'
      
        '11069545=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE' +
        ')/K.amount)'
      '11069546=                  FROM G_PRODUCT_KIT K,'
      '11069547=                       LT_SKLAD_PRODUCT L'
      '11069548=                 WHERE K.g_product = :G_PRODUCT_'
      '11069549=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11069550=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11069551=                 GROUP BY K.G_PRODUCT'
      '11069552=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11069553='
      '11069554=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11069555=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_S' +
        'OSTAV_AMOUNT_, 0)'
      '11069556=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11069557=            end'
      '11069558=        END'
      '11069559=    END'
      '11069560=end'
      '11069561=;'
      '11069562='
      '11069563=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '11069564=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '11069565=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11069566=  ARTICUL_ VARCHAR(30),'
      '11069567=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11069568=  BARCODE_ VARCHAR(30),'
      '11069569=  NAME_ VARCHAR(500),'
      '11069570=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11069571=  PRICE_ NUMERIC(15,2),'
      '11069572=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11069573=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11069574=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11069575=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11069576=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11069577=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11069578=  IS_CATEGORY_ INTEGER,'
      '11069579=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11069580=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11069581=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11069582=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD)'
      '11069583=RETURNS ('
      '11069584=  ERR_CODE INTEGER,'
      '11069585=  ERR_MSG VARCHAR(1024))'
      '11069586=AS'
      
        '11069587=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODUC' +
        'T'#39';'
      '11069588=DECLARE VARIABLE N_CURR_ INTEGER;'
      '11069589=DECLARE VARIABLE N INTEGER;'
      '11069590=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11069591=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11069592=begin'
      
        '11069593=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11069594=    SELECT COUNT(*)'
      '11069595=      FROM G_PRODUCT G'
      '11069596=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '11069597=       AND TRIM(G.ARTICUL) <> '#39#39
      '11069598=       AND TRIM(:ARTICUL_) <> '#39#39
      '11069599=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '11069600=       AND G.IS_ACTIVE = 1'
      '11069601=      INTO :CNT_;'
      '11069602='
      '11069603=    IF (CNT_ > 0) THEN BEGIN'
      '11069604=      ERR_CODE = -20500;'
      
        '11069605=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' ' +
        #1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '11069606=      EXIT;'
      '11069607=    END'
      '11069608='
      '11069609=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11069610=    SELECT COUNT(*)'
      '11069611=      FROM G_PRODUCT G'
      
        '11069612=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOMEN' +
        'CLATUR_NUM_))'
      '11069613=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11069614=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '11069615=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '11069616=       AND G.IS_ACTIVE = 1'
      '11069617=    INTO :CNT_;'
      '11069618=    IF (CNT_ > 0) THEN BEGIN'
      '11069619=      ERR_CODE = -20500;'
      
        '11069620=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLAT' +
        'UR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '11069621=      EXIT;'
      '11069622=    END'
      '11069623='
      '11069624=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11069625=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11069626=        SELECT COUNT(*)'
      '11069627=          FROM G_PRODUCT G'
      
        '11069628=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_)' +
        ')'
      '11069629=           AND TRIM(G.BARCODE) <> '#39#39
      '11069630=           AND TRIM(:BARCODE_) <> '#39#39
      '11069631=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '11069632=           AND G.IS_ACTIVE = 1'
      '11069633=          INTO :CNT_;'
      '11069634='
      '11069635=        IF (CNT_ = 0) then'
      '11069636=          SELECT COUNT(*)'
      '11069637=            FROM G_PRODUCT G, LT_BARCODE L'
      '11069638=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11069639=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11069640=             AND TRIM(L.BARCODE) <> '#39#39
      '11069641=             AND G.IS_ACTIVE = 1'
      '11069642=            INTO :CNT_;'
      '11069643='
      '11069644=        IF (CNT_ > 0) THEN BEGIN'
      '11069645=          ERR_CODE = -20500;'
      
        '11069646=          ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_|' +
        '|'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '11069647=          EXIT;'
      '11069648=        END'
      '11069649=    END'
      '11069650='
      '11069651=    update G_PRODUCT'
      '11069652=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '11069653=        ARTICUL = :ARTICUL_,'
      '11069654=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '11069655=        BARCODE = :BARCODE_,'
      '11069656=        NAME = :NAME_,'
      '11069657=        G_UNIT = :G_UNIT_,'
      '11069658=        PRICE = :PRICE_,'
      '11069659=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '11069660=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '11069661=        MF_COUNTRY   = :MF_COUNTRY_,'
      '11069662=        NOTE         = :NOTE_,'
      '11069663=        CROSSCODE    = :CROSSCODE_,'
      '11069664=        IS_KIT       = :IS_KIT_,'
      '11069665=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '11069666=        PLACE        = :PLACE_,'
      '11069667=        SALES_COMM   = :SALES_COMM_,'
      '11069668=        KOD_TNVD     = :KOD_TNVD_'
      '11069669=    where (G_PRODUCT = :G_PRODUCT_);'
      '11069670='
      '11069671=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '11069672=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '11069673='
      '11069674=        INSERT INTO LT_BARCODE'
      
        '11069675=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT' +
        '_BARCODE_TMP;'
      '11069676='
      '11069677=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '11069678=        INSERT INTO G_PRODUCT_IMAGE'
      
        '11069679=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT E' +
        'XISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.G' +
        '_PRODUCT_IMAGE);'
      '11069680='
      
        '11069681=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS ' +
        '(SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_P' +
        'RODUCT_IMAGE)'
      '11069682=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '11069683='
      '11069684=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '11069685=        IF (IS_KIT_ > 0) THEN BEGIN'
      '11069686=            INSERT INTO G_PRODUCT_KIT'
      
        '11069687=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP T'
      
        '11069688=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_K' +
        'IT'
      
        '11069689=                               WHERE G_PRODUCT_ITEM = T' +
        '.G_PRODUCT_ITEM'
      
        '11069690=                                 AND G_PRODUCT = T.g_pr' +
        'oduct);'
      '11069691='
      
        '11069692=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_PR' +
        'ODUCT_ITEM)'
      '11069693=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '11069694='
      '11069695=            UPDATE G_PRODUCT_KIT G'
      
        '11069696=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '11069697=                   G.PRICE  = (SELECT PRICE FROM G_PROD' +
        'UCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '11069698=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT_' +
        'TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AMO' +
        'UNT or PRICE <> G.PRICE))'
      '11069699=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '11069700='
      
        '11069701=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090 +
        #1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '11069702=            if (is_kit_ = 1) then begin'
      '11069703=                SELECT MIN(L.AMOUNT)'
      '11069704=                  FROM G_PRODUCT_KIT K,'
      '11069705=                       LT_SKLAD_PRODUCT L'
      '11069706=                 WHERE K.g_product = :G_PRODUCT_'
      '11069707=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11069708=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11069709=                 GROUP BY K.G_PRODUCT'
      '11069710=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11069711='
      '11069712=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11069713=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMO' +
        'UNT_'
      '11069714=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11069715=            end'
      '11069716=        END'
      '11069717=    END'
      '11069718=end'
      '11069719=;'
      
        '11069720=UPDATE SYSTEM_SETUP SET S_VALUE = 11069 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11069721=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11069722=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110700=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      
        '110701=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGINT' +
        ','
      
        '110702=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T */ BIGINT,'
      
        '110703=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT,'
      '110704=  DATE_BEGIN_ DATE,'
      '110705=  DATE_END_ DATE,'
      '110706=  TIME_BEGIN_ TIME,'
      '110707=  TIME_END_ TIME,'
      '110708=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110709=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1107010=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1107011=RETURNS ('
      
        '1107012=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUMER' +
        'IC(18,5),'
      
        '1107013=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERIC' +
        '(15,2),'
      
        '1107014=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(1' +
        '5,2),'
      
        '1107015=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE */ NUMERIC(15,2),'
      
        '1107016=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM */ NUMERIC(15,2),'
      
        '1107017=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHAR' +
        '(250),'
      
        '1107018=  PAYMENT_NAME /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME */ ' +
        'VARCHAR(256),'
      
        '1107019=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR' +
        '(250),'
      
        '1107020=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1107021=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '1107022=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      '1107023=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '1107024=  Z_DATE BLOB SUB_TYPE 1,'
      '1107025=  ROW INTEGER,'
      '1107026=  ERR_CODE INTEGER,'
      '1107027=  ERR_MSG VARCHAR(1024))'
      '1107028=AS'
      '1107029=BEGIN'
      '1107030=  SUSPEND;'
      '1107031=END'
      '1107032=;'
      '1107033='
      '1107034='
      
