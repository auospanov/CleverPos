      '1102520='
      '1102521=ALTER PROCEDURE G_GET_DCARD_BY_CODE('
      
        '1102522=  G_DISCONT_CARD_ /* TYPE OF COLUMN G_DISCONT_CARD.G_DIS' +
        'CONT_CARD */ BIGINT,'
      '1102523=  CARD_CODE_ VARCHAR(30))'
      '1102524=RETURNS ('
      
        '1102525=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      
        '1102526=  CLIENT_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHA' +
        'R(250),'
      
        '1102527=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '1102528=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      
        '1102529=  SUMM_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM */ NUMERIC' +
        '(15,2),'
      
        '11025210=  SUMM_ALL_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL *' +
        '/ NUMERIC(15,2),'
      
        '11025211=  LAST_PURCHASE_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */' +
        ' DATE,'
      
        '11025212=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50' +
        '),'
      '11025213=  ERR_CODE INTEGER,'
      '11025214=  ERR_MSG VARCHAR(1024))'
      '11025215=AS'
      '11025216=BEGIN'
      '11025217=  SUSPEND;'
      '11025218=END'
      '11025219=;'
      '11025220='
      '11025221=ALTER PROCEDURE R_EDIT_REVISION('
      
        '11025222=  REVISION_PARENT_ /* TYPE OF COLUMN REVISION_PARENT.RE' +
        'VISION_PARENT */ BIGINT,'
      
        '11025223=  AMOUNT_REAL_ /* TYPE OF COLUMN REVISION.AMOUNT_REAL *' +
        '/ NUMERIC(18,5),'
      
        '11025224=  G_PRODUCT_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ B' +
        'IGINT,'
      
        '11025225=  DATETIME_ /* TYPE OF COLUMN REVISION.DATETIME_CREATED' +
        ' */ TIMESTAMP,'
      
        '11025226=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT,'
      
        '11025227=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(150) = '#39#39','
      '11025228=  PREFIX_ VARCHAR(2) = '#39#39','
      '11025229=  INS_TOVAR_BY_SCANER_ INTEGER = 0)'
      '11025230=RETURNS ('
      
        '11025231=  REVISION_ /* TYPE OF COLUMN REVISION.REVISION */ BIGI' +
        'NT,'
      '11025232=  ERR_CODE INTEGER,'
      '11025233=  ERR_MSG VARCHAR(1024))'
      '11025234=AS'
      '11025235=BEGIN'
      '11025236=  SUSPEND;'
      '11025237=END'
      '11025238=;'
      '11025239='
      '11025240='
      
        '11025241=/******************************************************' +
        '************************/'
      
        '11025242=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11025243=/******************************************************' +
        '************************/'
      '11025244=ALTER PROCEDURE G_GET_DCARD_BY_CODE('
      
        '11025245=  G_DISCONT_CARD_ TYPE OF COLUMN G_DISCONT_CARD.G_DISCO' +
        'NT_CARD,'
      '11025246=  CARD_CODE_ VARCHAR(30))'
      '11025247=RETURNS ('
      '11025248=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11025249=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11025250=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11025251=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11025252=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '11025253=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '11025254=  LAST_PURCHASE_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11025255=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11025256=  ERR_CODE INTEGER,'
      '11025257=  ERR_MSG VARCHAR(1024))'
      '11025258=AS'
      '11025259=/**/'
      
        '11025260=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_GET_DCARD_BY' +
        '_CODE'#39';'
      '11025261=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11025262=BEGIN'
      '11025263=  SELECT'
      '11025264=    C.G_CLIENT,'
      '11025265=    C.NAME,'
      '11025266=    C.PHONE,'
      '11025267=    D.BARCODE,'
      '11025268=    D.N_PERCENT,'
      '11025269=    D.SUMM,'
      '11025270=    D.SUMM_ALL'
      '11025271=  FROM G_DISCONT_CARD D, G_CLIENT C'
      '11025272=  WHERE ('
      
        '11025273=            ((BARCODE = :CARD_CODE_ AND CHAR_LENGTH(:CA' +
        'RD_CODE_) > 0)  -- '#1063#1058#1054#1041#1067' '#1057#1058#1056#1054#1050#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1051#1048#1057#1068' '#1055#1054' '#1055#1059#1057#1058#1054#1058#1045
      '11025274=             OR'
      
        '11025275=             (C.PHONE LIKE '#39'%'#39'||:CARD_CODE_||'#39'%'#39' AND CH' +
        'AR_LENGTH(:CARD_CODE_) > 0)'
      '11025276=             )'
      
        '11025277=         or (D.G_DISCONT_CARD = COALESCE(:G_DISCONT_CAR' +
        'D_, 0))'
      '11025278=        )'
      '11025279=    AND D.G_CLIENT = C.G_CLIENT'
      '11025280=  INTO'
      '11025281=    :G_CLIENT_,'
      '11025282=    :CLIENT_NAME_,'
      '11025283=    :PHONE_,'
      '11025284=    :BARCODE_,'
      '11025285=    :N_PERCENT_,'
      '11025286=    :SUMM_,'
      '11025287=    :SUMM_ALL_;'
      '11025288='
      '11025289=    SELECT MAX(Z.Z_DATE)'
      '11025290=      FROM ZAKAZ Z'
      '11025291=     WHERE Z.G_CLIENT = :G_CLIENT_'
      '11025292=     INTO :LAST_PURCHASE_DATE_;'
      '11025293=END'
      '11025294=;'
      '11025295='
      '11025296=ALTER PROCEDURE P_REP_SALESMAN_RATING('
      '11025297=  DATE_BEGIN_ DATE,'
      '11025298=  DATE_END_ DATE,'
      '11025299=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '110252100=RETURNS ('
      '110252101=  DATE_ VARCHAR(50),'
      '110252102=  G_OFFICIAL_FM TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110252103=  SUMM TYPE OF COLUMN ZAKAZ.SUMM,'
      '110252104=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110252105=  BILL_CNT INTEGER)'
      '110252106=AS'
      '110252107=BEGIN'
      '110252108='
      
        '110252109=  DATE_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE_B' +
        'EGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110252110=               lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRA' +
        'CT(YEAR FROM DATE_END_);'
      '110252111='
      '110252112=  FOR'
      
        '110252113=    SELECT DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FM||'#39 +
        ' '#39'||GG.NM||'#39' '#39'||GG.FT, GG.FIO_DOC),'
      '110252114=           TT.SUMM,'
      '110252115=           TT.SUMM_AMOUNT,'
      '110252116=           TT.BILL_CNT'
      '110252117=      FROM G_OFFICIAL GG,'
      '110252118=           (SELECT SUM(ZD.SUMM) SUMM,'
      '110252119=                   SUM(ZD.AMOUNT) SUMM_AMOUNT,'
      
        '110252120=                   (SELECT COUNT(ZZ.ZAKAZ) FROM ZAKAZ ' +
        'ZZ WHERE ZZ.G_OFFICIAL = Z.G_OFFICIAL AND ZZ.Z_DATE BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_) BILL_CNT,'
      '110252121=                   Z.G_OFFICIAL'
      '110252122=              FROM ZAKAZ Z,'
      '110252123=                   ZAKAZ_DETAILS ZD'
      '110252124=             WHERE Z.ZAKAZ = ZD.ZAKAZ'
      
        '110252125=               AND Z.G_OFFICIAL = (CASE WHEN :G_OFFICI' +
        'AL_ IS NULL THEN Z.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      
        '110252126=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '110252127=               AND Z.IS_SPISANIE = 0'
      '110252128=             GROUP BY Z.G_OFFICIAL) TT'
      '110252129=     WHERE GG.G_OFFICIAL = TT.G_OFFICIAL'
      
        '110252130=       AND GG.G_OFFICIAL = (CASE WHEN :G_OFFICIAL_ IS ' +
        'NULL THEN GG.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      '110252131=    ORDER BY 2 DESC'
      '110252132=     INTO :G_OFFICIAL_FM'
      '110252133=          ,:SUMM'
      '110252134=          ,:AMOUNT'
      '110252135=          ,:BILL_CNT'
      '110252136=  DO SUSPEND;'
      '110252137='
      '110252138=end'
      '110252139=;'
      '110252140='
      '110252141=ALTER PROCEDURE P_REP_SALESMAN_RATING_BY_GROUP('
      '110252142=  DATE_BEGIN_ DATE,'
      '110252143=  DATE_END_ DATE,'
      '110252144=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110252145=  G_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110252146=RETURNS ('
      '110252147=  DATE_ VARCHAR(50),'
      '110252148=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110252149=  G_OFFICIAL_FM TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110252150=  SUMM TYPE OF COLUMN ZAKAZ.SUMM,'
      '110252151=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT)'
      '110252152=AS'
      '110252153=BEGIN'
      '110252154='
      
        '110252155=  DATE_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE_B' +
        'EGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110252156=               lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRA' +
        'CT(YEAR FROM DATE_END_);'
      '110252157='
      '110252158=  FOR'
      '110252159=    SELECT GP.NAME,'
      
        '110252160=           DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FM||'#39 +
        ' '#39'||GG.NM||'#39' '#39'||GG.FT, GG.FIO_DOC),'
      '110252161=           TT.SUMM,'
      '110252162=           TT.SUMM_AMOUNT'
      '110252163=      FROM G_PRODUCT GP,'
      '110252164=           G_OFFICIAL GG,'
      '110252165=           (SELECT SUM(ZD.SUMM) SUMM,'
      '110252166=                   SUM(ZD.AMOUNT) SUMM_AMOUNT,'
      '110252167=                   Z.G_OFFICIAL,'
      '110252168=                   GG.G_PRODUCT'
      '110252169=              FROM ZAKAZ Z,'
      '110252170=                   ZAKAZ_DETAILS ZD,'
      '110252171=                   G_PRODUCT G,'
      '110252172=                   G_PRODUCT GG'
      '110252173=             WHERE Z.IS_SPISANIE = 0'
      '110252174=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110252175=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110252176=               AND G.G_PRODUCT_PAR = GG.G_PRODUCT'
      
        '110252177=               AND Z.G_OFFICIAL = (CASE WHEN :G_OFFICI' +
        'AL_ IS NULL THEN Z.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      
        '110252178=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110252179=               AND GG.G_PRODUCT = (CASE WHEN :G_CATEGO' +
        'RY_ IS NULL THEN GG.G_PRODUCT ELSE :G_CATEGORY_ END)'
      '110252180=             GROUP BY Z.G_OFFICIAL, GG.G_PRODUCT) TT'
      '110252181=     WHERE GG.G_OFFICIAL = TT.G_OFFICIAL'
      '110252182=       AND GP.G_PRODUCT = TT.G_PRODUCT'
      
        '110252183=       AND GG.G_OFFICIAL = (CASE WHEN :G_OFFICIAL_ IS ' +
        'NULL THEN GG.G_OFFICIAL ELSE :G_OFFICIAL_ END)'
      
        '110252184=       AND GP.G_PRODUCT = (CASE WHEN :G_CATEGORY_ IS N' +
        'ULL THEN GP.G_PRODUCT ELSE :G_CATEGORY_ END)'
      '110252185=    ORDER BY 3 DESC'
      '110252186=     INTO :CATEGORY_NAME'
      '110252187=          ,:G_OFFICIAL_FM'
      '110252188=          ,:SUMM'
      '110252189=          ,:AMOUNT'
      '110252190=  DO SUSPEND;'
      '110252191='
      '110252192=end'
      '110252193=;'
      '110252194='
      '110252195=ALTER PROCEDURE R_EDIT_REVISION('
      
        '110252196=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REVI' +
        'SION_PARENT,'
      '110252197=  AMOUNT_REAL_ TYPE OF COLUMN REVISION.AMOUNT_REAL,'
      '110252198=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110252199=  DATETIME_ TYPE OF COLUMN REVISION.DATETIME_CREATED,'
      '110252200=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110252201=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE = '#39#39','
      '110252202=  PREFIX_ VARCHAR(2) = '#39#39','
      '110252203=  INS_TOVAR_BY_SCANER_ INTEGER = 0)'
      '110252204=RETURNS ('
      '110252205=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '110252206=  ERR_CODE INTEGER,'
      '110252207=  ERR_MSG VARCHAR(1024))'
      '110252208=AS'
      
        '110252209=--  INS_TOVAR_BY_SCANER_ '#1044#1054#1041#1040#1042#1051#1071#1058#1068' '#1053#1054#1042#1067#1045' '#1057#1058#1056#1054#1050#1048' '#1058#1054#1042#1040#1056#1054 +
        #1042' '#1057#1050#1040#1053#1045#1056#1054#1052' '#1048#1051#1048' '#1053#1045#1058', 0 - '#1053#1045#1058', 1 - '#1044#1040
      
        '110252210=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'R_EDIT_REVISI' +
        'ON'#39';'
      '110252211=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110252212=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_PR' +
        'ODUCT.AMOUNT;'
      '110252213=DECLARE VARIABLE I INTEGER = 1;'
      
        '110252214=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      
        '110252215=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE' +
        ';'
      
        '110252216=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      
        '110252217=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110252218=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110252219=DECLARE VARIABLE IS_MARKED_ TYPE OF COLUMN G_PRODUCT.I' +
        'S_MARKED;'
      
        '110252220=DECLARE VARIABLE IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.I' +
        'S_WEIGHT;'
      
        '110252221=DECLARE VARIABLE VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRO' +
        'DUCT.VES_GRAMM_PRICE;'
      '110252222=BEGIN'
      '110252223=  PNT_ = '#39'00'#39';'
      '110252224=  IF (BARCODE_ <> '#39#39') THEN BEGIN'
      
        '110252225=    EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARC' +
        'ODE_, '#39#39'/*:ARTICUL_*/, '#39#39'/*:NOMER_*/, '#39#39'/*:NAME_*/, :PREFIX_)'
      
        '110252226=        RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEG' +
        'ORY_, :PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :IS_MARKED_,'
      
        '110252227=        :IS_WEIGHT_, :VES_GRAMM_PRICE_, :ERR_CODE, :ER' +
        'R_MSG;'
      '110252228='
      
        '110252229=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) TH' +
        'EN'
      '110252230=      AMOUNT_REAL_ = AMOUNT_;'
      '110252231='
      '110252232=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110252233=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110252234=      EXIT;'
      '110252235=    END'
      '110252236=  END'
      '110252237='
      
        '110252238=  -- '#1045#1057#1051#1048' '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1042#1040#1053#1040' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070 +
        ' 1 ('#1045#1057#1051#1048' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045')'
      '110252239=  -- '#1045#1057#1051#1048' '#1053#1045' '#1063#1045#1056#1045#1047' '#1057#1050#1040#1053#1045#1056', '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1064#1045#1044#1064#1045#1045' '#1050#1054#1051'-'#1042#1054
      '110252240=  PNT_ = '#39'01'#39';'
      '110252241=  UPDATE REVISION R'
      
        '110252242=     SET R.AMOUNT_REAL = DECODE(:BARCODE_, '#39#39', :AMOUNT' +
        '_REAL_, (CASE WHEN SUBSTRING(:BARCODE_ FROM 1 FOR 2) = :PREFIX_ ' +
        'THEN R.AMOUNT_REAL + :AMOUNT_REAL_ ELSE R.AMOUNT_REAL + 1 END))'
      '110252243=   WHERE R.G_PRODUCT = :G_PRODUCT_'
      '110252244=     AND R.REVISION_PARENT = :REVISION_PARENT_'
      '110252245=  RETURNING'
      '110252246=    REVISION'
      '110252247=  INTO'
      '110252248=    :REVISION_;'
      '110252249='
      '110252250=  PNT_ = '#39'02'#39';'
      '110252251=  IF (ROW_COUNT = 0) THEN BEGIN'
      
        '110252252=      -- '#1045#1057#1051#1048' '#1057#1058#1054#1048#1058' '#1047#1040#1055#1056#1045#1058' '#1053#1040' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1040' '#1057#1050#1040#1053#1045#1056 +
        #1054#1052', '#1058#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      
        '110252253=      IF (BARCODE_ <> '#39#39' AND INS_TOVAR_BY_SCANER_ = 0)' +
        ' THEN BEGIN'
      '110252254=        ERR_CODE = -20500;'
      
        '110252255=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088 +
        #1072' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077#1090' '#1074' '#1089#1087#1080#1089#1082#1077'.'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      
        '110252256=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110252257=        EXIT;'
      '110252258=      END'
      '110252259='
      '110252260=      SELECT LT.AMOUNT + LT.AMOUNT_RESERVE'
      '110252261=        FROM LT_SKLAD_PRODUCT LT'
      '110252262=       WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110252263=         AND LT.G_TOCHKA = :G_TOCHKA_'
      '110252264=        INTO :AMOUNT_BD_;'
      '110252265='
      '110252266=      AMOUNT_BD_ = COALESCE(AMOUNT_BD_, 0);'
      '110252267='
      '110252268=      PNT_ = '#39'03'#39';'
      
        '110252269=      INSERT INTO REVISION (REVISION, REVISION_PARENT,' +
        ' G_PRODUCT, AMOUNT_BD, AMOUNT_REAL, DATETIME_CREATED)'
      
        '110252270=      VALUES (GEN_ID(GEN_REVISION, 1), :REVISION_PAREN' +
        'T_, :G_PRODUCT_, :AMOUNT_BD_, :AMOUNT_REAL_, :DATETIME_)'
      '110252271=      RETURNING'
      '110252272=        REVISION'
      '110252273=      INTO'
      '110252274=        :REVISION_;'
      '110252275=  END'
      '110252276='
      '110252277=WHEN ANY DO BEGIN'
      '110252278=    ERR_CODE = -20500;'
      
        '110252279=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1042#1057 +
        #1058#1040#1042#1050#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110252280=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110252281=  END'
      '110252282=END'
      '110252283=;'
      '110252284='
      '110252285='
      
        '110252286=UPDATE SYSTEM_SETUP SET S_VALUE = 110252 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110252287=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110252288=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      '')
    TabOrder = 6
    ColWidths = (
      150
      1828)
  end
  inherited dxEditStyleController: TcxEditStyleController
    PixelsPerInch = 96
  end
  object Timer: TTimer
    Enabled = False
    Interval = 200
    OnTimer = TimerTimer
    Left = 304
    Top = 200
  end
  object spUpdateDb: TpFIBDataSet
    Transaction = tranMainWrite
    Database = MainDM.dbMain
    Left = 96
    Top = 232
  end
  object tranMainWrite: TpFIBTransaction
    DefaultDatabase = MainDM.dbMain
    TRParams.Strings = (
      'write'
      'nowait'
      'rec_version'
      'read_committed')
    TPBMode = tpbDefault
    Left = 128
    Top = 232
  end
  object spUpdateData: TpFIBDataSet
    Transaction = tranMainWrite
    Database = MainDM.dbMain
    Left = 160
    Top = 232
  end
  object scriptUpdate: TpFIBScripter
    Database = MainDM.dbMain
    Transaction = tranMainWrite
    OnExecuteError = scriptUpdateExecuteError
    AutoDDL = False
    BeforeStatementExecute = scriptUpdateBeforeStatementExecute
    Left = 48
    Top = 208
  end
end
