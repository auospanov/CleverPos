      '110607877=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      
        '110607878=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL)'
      '110607879=RETURNS ('
      
        '110607880=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110607881=  ERR_CODE INTEGER,'
      '110607882=  ERR_MSG VARCHAR(1024))'
      '110607883=AS'
      '110607884=/*'
      
        '110607885='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1053#1059#1046#1053#1040' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1044#1054#1041#1040#1042#1051#1071#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1042' '#1053#1040#1050 +
        #1051#1040#1044#1053#1059#1070' '#1042' '#1056#1045#1046#1048#1052#1045' "'#1054#1055#1051#1040#1058#1048#1058#1068'" - '#1042#1067#1044#1040#1063#1040' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070'.'
      
        '110607886='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1053#1054#1042#1054#1049' '#1060#1054#1056#1052#1045' frmOplataTovaraReal, '#1050#1054#1043#1044#1040' '#1053#1040 +
        #1046#1048#1052#1040#1045#1058#1057#1071' '#1050#1053#1054#1055#1050#1040' "'#1044#1054#1041#1040#1042#1048#1058#1068'"'
      
        '110607887='#1055#1056#1048' '#1069#1058#1054#1052' '#1058#1054#1042#1040#1056#1067' '#1058#1040#1050#1046#1045', '#1050#1040#1050' '#1048' '#1055#1056#1048' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1045', '#1055#1054#1055#1040 +
        #1044#1040#1070#1058' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_DETAILS_TMP_REAL, '#1053#1054' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045
      
        '110607888='#1058#1040#1050#1046#1045' '#1047#1040#1055#1054#1051#1053#1071#1045#1058#1057#1071' '#1050#1054#1051#1054#1053#1050#1040' ZAKAZ_NA_REAL, '#1044#1040#1051#1068#1064#1045' '#1054#1053#1040' '#1041#1059 +
        #1044#1045#1058' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068#1057#1071' '#1044#1051#1071' '#1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1044#1040#1053#1053#1067#1061' '#1042' '#1058#1040#1041#1051#1048#1062#1045' ZAKAZ_NA_REAL' +
        ','
      '110607889='#1058#1048#1055#1040' '#1050#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1044#1040#1053' '#1048' '#1057#1050#1054#1051#1068#1050#1054' '#1048' '#1058'.'#1044'.'
      '110607890=*/'
      
        '110607891=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP_REAL'#39';'
      
        '110607892=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT = 0;'
      
        '110607893=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.AMOUNT = 0;'
      
        '110607894=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110607895=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045' */'
      '110607896=begin'
      '110607897=  INSERT INTO ZAKAZ_DETAILS_TMP_REAL'
      '110607898=  ('
      '110607899=   ZAKAZ_DETAILS,'
      '110607900=   G_PRODUCT,'
      '110607901=   AMOUNT,'
      '110607902=   PRICE,'
      '110607903=   SUMM,'
      '110607904=   DISCOUNT_PERC,'
      '110607905=   DISCOUNT_TENGE,'
      '110607906=   DISCOUNT_SUMM,'
      '110607907=   NDS,'
      '110607908=   NDS_SUMM,'
      '110607909=   IS_ADDED_FOR_UPDATE,'
      '110607910=   ZAKAZ_NA_REAL,'
      '110607911=   COST_PRICE'
      '110607912=  ) VALUES ('
      '110607913=   GEN_ID(GEN_DETAILS_TMP, 1),'
      '110607914=   :G_PRODUCT_,'
      '110607915=   :AMOUNT_,'
      '110607916=   :PRICE_,'
      '110607917=   :SUMM_,'
      '110607918=   :DISCOUNT_PERC_,'
      '110607919=   :DISCOUNT_TENGE_,'
      '110607920=   :DISCOUNT_SUMM_,'
      '110607921=   :NDS_,'
      '110607922=   :NDS_SUMM_,'
      
        '110607923=   0,             -- '#1057#1058#1040#1042#1051#1070' '#1047#1044#1045#1057#1068' 0, '#1050#1040#1050' '#1055#1056#1048#1047#1053#1040#1050', '#1063#1058#1054' ' +
        #1058#1054#1042#1040#1056' '#1044#1054#1041#1040#1042#1051#1045#1053' '#1048#1047' '#1048#1053#1058#1045#1056#1060#1045#1049#1057#1040', '#1040' '#1053#1045' '#1040#1042#1058#1054#1052#1040#1058#1054#1052' '#1055#1056#1048' GET_ZAKAZ_DETAI' +
        'LS'
      '110607924=   :ZAKAZ_NA_REAL_,'
      '110607925=   :COST_PRICE_'
      '110607926=  )'
      '110607927=  RETURNING'
      '110607928=    ZAKAZ_DETAILS'
      '110607929=  INTO'
      '110607930=    :ZAKAZ_DETAILS_;'
      '110607931='
      
        '110607932=  -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1045#1065#1045' '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048 +
        ' '#1044#1054#1057#1058#1059#1055#1053#1054#1043#1054' '#1050' '#1054#1055#1051#1040#1058#1045
      
        '110607933=  SELECT (L.AMOUNT_ALL - L.AMOUNT_PAYED - L.AMOUNT_RET' +
        'URNED)'
      '110607934=    FROM ZAKAZ_NA_REAL L'
      '110607935=   WHERE L.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110607936=   INTO :AMOUNT_CUR_;'
      '110607937='
      
        '110607938=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058 +
        #1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1056#1045#1040#1051 +
        #1048#1047#1040#1062#1048#1048' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '110607939=  -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040 +
        #1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110607940=  -- '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058 +
        '. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110607941=  -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048#1063#1045#1057#1058 +
        #1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110607942=  -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051#1054', '#1047 +
        #1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068#1050#1054
      
        '110607943=  -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068' '#1055#1056#1048 +
        #1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110607944=  SELECT Z.ZAKAZ'
      '110607945=    FROM ZAKAZ Z,'
      '110607946=         ZAKAZ_DETAILS ZD'
      '110607947=   WHERE Z.ZAKAZ = ZD.ZAKAZ'
      '110607948=     AND ZD.ZAKAZ_DETAILS IN (SELECT T.ZAKAZ_DETAILS'
      
        '110607949=                                FROM ZAKAZ_DETAILS_TMP' +
        '_REAL T'
      
        '110607950=                               WHERE T.IS_ADDED_FOR_UP' +
        'DATE = 1'
      
        '110607951=                                 AND T.ZAKAZ_NA_REAL =' +
        ' :ZAKAZ_NA_REAL_)'
      '110607952=    INTO :ZAKAZ_;'
      '110607953='
      '110607954=  IF (ROW_COUNT <> 0) THEN BEGIN'
      '110607955=    SELECT SUM(AMOUNT)'
      '110607956=      FROM ZAKAZ_DETAILS T'
      '110607957=     WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110607958=       AND T.ZAKAZ = :ZAKAZ_'
      '110607959=      INTO :AMOUNT_OLD_;'
      '110607960=  END'
      '110607961='
      '110607962=  -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110607963=  SELECT SUM(AMOUNT)'
      '110607964=    FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110607965=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110607966=     AND T.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110607967=   INTO :AMOUNT_CUR_ZAKAZ_;'
      '110607968='
      
        '110607969=  IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:A' +
        'MOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110607970=    ERR_CODE = -20500;'
      
        '110607971=    ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1076#1086#1089 +
        #1090#1091#1087#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1076#1083#1103' '#1086#1087#1083#1072#1090#1099'! '#1044#1086#1089#1090#1091#1087#1085#1086' '#39'||'
      
        '110607972=              CAST((AMOUNT_CUR_ - (AMOUNT_CUR_ZAKAZ_ -' +
        ' AMOUNT_ - COALESCE(:AMOUNT_OLD_, 0))) AS VARCHAR(10))||'
      '110607973=              '#39', '#1042#1099' '#1074#1074#1086#1076#1080#1090#1077' '#39'||AMOUNT_;'
      
        '110607974=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_MSG) R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '110607975=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110607976=    EXIT;'
      '110607977=  END'
      '110607978=end'
      '110607979=;'
      '110607980='
      '110607981=ALTER PROCEDURE K_READ_KASSA_LIST('
      '110607982=  DATE_BEGIN_ DATE,'
      '110607983=  DATE_END_ DATE,'
      '110607984=  ACTION_ INTEGER,'
      '110607985=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE)'
      '110607986=RETURNS ('
      '110607987=  KASSA TYPE OF COLUMN KASSA.KASSA,'
      '110607988=  ACTION INTEGER,'
      
        '110607989=  G_PRIHOD_RASHOD TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRI' +
        'HOD_RASHOD,'
      '110607990=  SUMM NUMERIC(15,2),'
      '110607991=  ACTION_DATE DATE,'
      '110607992=  NOTE VARCHAR(1024),'
      '110607993=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110607994=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '110607995=  STATYA_NAME VARCHAR(500),'
      
        '110607996=  G_PAYMENT_TYPE TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYME' +
        'NT_TYPE,'
      '110607997=  PAYMENT_TYPE TYPE OF COLUMN G_PAYMENT_TYPE.NAME)'
      '110607998=AS'
      '110607999=begin'
      '110608000=  FOR SELECT'
      '110608001=          T.KASSA,'
      '110608002=          T.ACTION,'
      '110608003=          T.G_PRIHOD_RASHOD,'
      '110608004=          T.SUMM,'
      '110608005=          T.ACTION_DATE,'
      '110608006=          T.NOTE,'
      '110608007=          T.ZAKAZ,'
      '110608008=          T.SKLAD,'
      '110608009=          g.name'
      '110608010=          ,PT.NAME'
      '110608011=          ,T.PAYMENT_TYPE'
      
        '110608012=      FROM (SELECT KASSA, "ACTION", G_PRIHOD_RASHOD, S' +
        'UMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, 1 PAYMENT_TYPE F' +
        'ROM KASSA WHERE :G_PAYMENT_TYPE_ IN (0, 1)'
      
        '110608013=              AND ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110608014=            UNION ALL'
      
        '110608015=            SELECT KASSA_BEZNAL KASSA, "ACTION", G_PRI' +
        'HOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, 2 P' +
        'AYMENT_TYPE FROM KASSA_BEZNAL WHERE :G_PAYMENT_TYPE_ IN (0, 2)'
      
        '110608016=              AND ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_) t,'
      '110608017=           G_PRIHOD_RASHOD G,'
      '110608018=           G_PAYMENT_TYPE PT'
      '110608019=      WHERE T.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110608020=        AND G.DO_ACTION = :ACTION_'
      
        '110608021=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '110608022=        AND T.PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      '110608023=      ORDER BY T.ACTION_DATE, T.KASSA'
      '110608024=      INTO :KASSA,'
      '110608025=            :action,'
      '110608026=            :G_PRIHOD_RASHOD,'
      '110608027=            :SUMM,'
      '110608028=            :ACTION_DATE,'
      '110608029=            :NOTE,'
      '110608030=            :ZAKAZ,'
      '110608031=            :SKLAD,'
      '110608032=            :STATYA_NAME'
      '110608033=            ,:PAYMENT_TYPE'
      '110608034=            ,:G_PAYMENT_TYPE'
      '110608035=  DO'
      '110608036=  suspend;'
      '110608037='
      '110608038=  /*if (G_PAYMENT_TYPE_ = 1) then BEGIN'
      '110608039=      FOR SELECT'
      '110608040=          T.KASSA,'
      '110608041=          T.ACTION,'
      '110608042=          T.G_PRIHOD_RASHOD,'
      '110608043=          T.SUMM,'
      '110608044=          T.ACTION_DATE,'
      '110608045=          T.NOTE,'
      '110608046=          T.ZAKAZ,'
      '110608047=          T.SKLAD,'
      '110608048=          g.name'
      '110608049=      FROM KASSA t,'
      '110608050=           G_PRIHOD_RASHOD G'
      '110608051=      WHERE T.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110608052=        AND G.DO_ACTION = :ACTION_'
      
        '110608053=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '110608054=      ORDER BY T.ACTION_DATE DESC'
      '110608055=      INTO :KASSA,'
      '110608056=            :action,'
      '110608057=            :G_PRIHOD_RASHOD,'
      '110608058=            :SUMM,'
      '110608059=            :ACTION_DATE,'
      '110608060=            :NOTE,'
      '110608061=            :ZAKAZ,'
      '110608062=            :SKLAD,'
      '110608063=            :STATYA_NAME'
      '110608064=      DO'
      '110608065=      suspend;'
      '110608066=  END ELSE BEGIN'
      '110608067=      FOR SELECT'
      '110608068=          T.KASSA_BEZNAL,'
      '110608069=          T.ACTION,'
      '110608070=          T.G_PRIHOD_RASHOD,'
      '110608071=          T.SUMM,'
      '110608072=          T.ACTION_DATE,'
      '110608073=          T.NOTE,'
      '110608074=          T.ZAKAZ,'
      '110608075=          T.SKLAD,'
      '110608076=          g.name'
      '110608077=      FROM KASSA_BEZNAL t,'
      '110608078=           G_PRIHOD_RASHOD G'
      '110608079=      WHERE T.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '110608080=        AND G.DO_ACTION = :ACTION_'
      
        '110608081=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '110608082=      ORDER BY T.ACTION_DATE DESC'
      '110608083=      INTO :KASSA,'
      '110608084=            :action,'
      '110608085=            :G_PRIHOD_RASHOD,'
      '110608086=            :SUMM,'
      '110608087=            :ACTION_DATE,'
      '110608088=            :NOTE,'
      '110608089=            :ZAKAZ,'
      '110608090=            :SKLAD,'
      '110608091=            :STATYA_NAME'
      '110608092=      DO'
      '110608093=      suspend;'
      '110608094=  END */'
      '110608095=end'
      '110608096=;'
      '110608097='
      '110608098=ALTER PROCEDURE LOG_DEINIT'
      '110608099=AS'
      '110608100=DECLARE VARIABLE TN VARCHAR(64);'
      '110608101=DECLARE VARIABLE SQL BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110608102=BEGIN'
      '110608103='
      '110608104=  FOR SELECT RDB$TRIGGER_NAME'
      '110608105=        FROM RDB$TRIGGERS'
      '110608106=       WHERE RDB$SYSTEM_FLAG = 0'
      
        '110608107=         AND RDB$TRIGGER_NAME NOT IN ('#39'IBE$TODO_ITEM_I' +
        'D_BI'#39', '#39'LT_SKLAD_PRODUCT_BU0'#39', '#39'PRODUCT_AMOUNT_AI0'#39', '#39'PRODUCT_AM' +
        'OUNT_BI0'#39')'
      '110608108=        INTO :TN'
      '110608109=  DO BEGIN'
      '110608110=    SQL = '#39'DROP TRIGGER '#39'||TN||'#39';'#39';'
      '110608111=      execute statement :SQL;'
      '110608112=  END'
      '110608113=END'
      '110608114=;'
      '110608115='
      '110608116=ALTER PROCEDURE LOG_INIT'
      '110608117=AS'
      '110608118=DECLARE VARIABLE TN VARCHAR(64);'
      '110608119=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110608120=DECLARE VARIABLE FN VARCHAR(64);'
      '110608121=DECLARE VARIABLE TP INTEGER;'
      
        '110608122=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110608123=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110608124=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110608125=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110608126=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110608127=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110608128=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110608129=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110608130=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110608131=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      '110608132=DECLARE VARIABLE ANZ INTEGER;'
      '110608133=DECLARE VARIABLE L INTEGER;'
      '110608134=DECLARE VARIABLE P INTEGER;'
      '110608135=DECLARE VARIABLE S INTEGER;'
      '110608136=DECLARE VARIABLE FT CHAR(1);'
      '110608137=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110608138=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110608139=BEGIN'
      '110608140=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110608141='
      '110608142=  TN_ALT='#39#39';'
      '110608143=  TRGI='#39#39';'
      '110608144=  TRGU='#39#39';'
      '110608145=  TRGD='#39#39';'
      '110608146=  TRGIX='#39#39';'
      '110608147=  TRGUX='#39#39';'
      '110608148=  TRGDX='#39#39';'
      '110608149=  SQLF='#39#39';'
      '110608150=  SQLV='#39#39';'
      '110608151=  SQLU='#39#39';'
      '110608152=  FT='#39#39';'
      '110608153='
      '110608154=  /*SQLLOOP = '#39'   FOR SELECT SYNC_COMPS'#39'||CRLF||'
      '110608155=            '#39'         FROM SYNC_COMPS S'#39'||CRLF||'
      
        '110608156=            '#39'        WHERE S.SYNC_COMPS <> (SELECT S_V' +
        'ALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 5)'#39'||CRLF||'
      
        '110608157=            '#39'          AND (SELECT S_VALUE FROM SYSTEM' +
        '_SETUP WHERE SYSTEM_SETUP = 5) = (SELECT S_VALUE FROM SYSTEM_SET' +
        'UP WHERE SYSTEM_SETUP = 4)'#39'||CRLF||'
      '110608158=            '#39'       UNION'#39'||CRLF||'
      '110608159=            '#39'       SELECT SYNC_COMPS'#39'||CRLF||'
      '110608160=            '#39'         FROM SYNC_COMPS S'#39'||CRLF||'
      
        '110608161=            '#39'        WHERE S.SYNC_COMPS = (SELECT S_VA' +
        'LUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 5)'#39'||CRLF||'
      
        '110608162=            '#39'          AND (SELECT S_VALUE FROM SYSTEM' +
        '_SETUP WHERE SYSTEM_SETUP = 5) <> (SELECT S_VALUE FROM SYSTEM_SE' +
        'TUP WHERE SYSTEM_SETUP = 4)'#39'||CRLF||'
      '110608163=            '#39'         INTO :SYNC_COMPS_'#39'||CRLF||'
      '110608164=            '#39'   DO BEGIN'#39'||CRLF;*/'
      '110608165='
      '110608166=  FOR SELECT R.RDB$RELATION_NAME,'
      '110608167=            R.RDB$FIELD_NAME,'
      '110608168=            F.RDB$FIELD_TYPE,'
      '110608169=            F.RDB$FIELD_LENGTH,'
      '110608170=            F.RDB$FIELD_PRECISION,'
      '110608171=            F.RDB$FIELD_SCALE'
      '110608172=        FROM RDB$RELATION_FIELDS R,'
      '110608173=             RDB$FIELDS F'
      '110608174=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110608175=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110608176=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110608177=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110608178=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110608179=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110608180=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110608181=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110608182=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110608183=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39')'
      '110608184=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110608185=              OR'
      
        '110608186=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110608187=             )'
      
        '110608188=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110608189=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110608190=  DO BEGIN'
      '110608191=    TN=TRIM(TN);'
      '110608192=    FN=TRIM(FN);'
      '110608193='
      '110608194=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110608195=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110608196=      EXECUTE STATEMENT TRGI;'
      '110608197=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110608198=      EXECUTE STATEMENT TRGU;'
      '110608199=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110608200=      EXECUTE STATEMENT TRGD;'
      '110608201='
      '110608202=      SQLF='#39#39';'
      '110608203=      SQLV='#39#39';'
      '110608204=      SQLU='#39#39';'
      '110608205=    END'
      '110608206='
      '110608207=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110608208=      ID_COLUMN = FN;'
      '110608209='
      '110608210=    S=-S;'
      
        '110608211=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110608212=      ft='#39'N'#39';   --numerisch'
      '110608213=    else'
      '110608214=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110608215=        ft='#39'Z'#39';   --zeit'
      '110608216=      else'
      '110608217=        ft='#39'T'#39';'
      '110608218='
      '110608219='
      '110608220=    IF (SQLF='#39#39') THEN'
      '110608221=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110608222=    ELSE'
      '110608223=      SQLF=SQLF||'#39','#39'||FN;'
      '110608224='
      '110608225=    if (ft='#39'N'#39') then begin'
      '110608226=      IF (SQLV='#39#39') THEN'
      
        '110608227=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110608228=      ELSE'
      
        '110608229=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110608230='
      '110608231=      IF (SQLU='#39#39') THEN'
      
        '110608232=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110608233=      ELSE'
      
        '110608234=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110608235=    end'
      '110608236=    else'
      '110608237=      if (ft='#39'Z'#39') then begin'
      '110608238=        IF (SQLV='#39#39') THEN'
      
        '110608239=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110608240=        ELSE'
      
        '110608241=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110608242='
      '110608243=        IF (SQLU='#39#39') THEN'
      
        '110608244=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'U' +
        'PDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||' +
        'FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110608245=        ELSE'
      
        '110608246=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39 +
        '||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),' +
        #39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110608247=    end'
      '110608248=    else begin'
      '110608249=      IF (SQLV='#39#39') THEN'
      
        '110608250=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||repl' +
        'ace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRL' +
        'F;'
      '110608251=      ELSE'
      
        '110608252=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||repl' +
        'ace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRL' +
        'F;'
      '110608253='
      '110608254=      IF (SQLU='#39#39') THEN'
      
        '110608255=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39 +
        #39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110608256=      ELSE'
      
        '110608257=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39 +
        ')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110608258=    end'
      '110608259='
      '110608260=    SELECT COUNT(*)'
      '110608261=      FROM RDB$TRIGGERS'
      '110608262=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGI'#39
      '110608263=      INTO :ANZ;'
      '110608264='
      '110608265=    IF (ANZ>0) THEN'
      '110608266=      TRGIX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGI'#39';'
      '110608267=    ELSE'
      '110608268=      TRGIX='#39#39';'
      '110608269='
      
        '110608270=    TRGI='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGI FOR '#39'||TN||'#39' AC' +
        'TIVE AFTER INSERT POSITION 255 AS '#39'||CRLF||'
      
        '110608271=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEG' +
        'MENT SIZE 80;'#39'||CRLF||'
      '110608272=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '110608273=         '#39'BEGIN'#39'||CRLF||'
      
        '110608274=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39' ||CRLF||'
      
        '110608275=         '#39'  SQLSTMT='#39#39#39'||SQLF||'#39') VALUES ('#39#39';'#39'||CRLF||' +
        'SQLV||'
      '110608276=         '#39'  SQLSTMT=SQLSTMT||'#39#39');'#39#39';'#39'||CRLF||'
      '110608277=         '#39'  ID=GEN_ID(GEN_LOGS,1);'#39'||CRLF||'
      
        '110608278=         '#39'  INSERT INTO LOGS(ID,SQLSTMT,USR) VALUES (:' +
        'ID, :SQLSTMT, '#39#39'SYSDBA'#39#39');'#39'||CRLF||'
      '110608279=         '#39'END'#39';'
      '110608280='
      '110608281=    SELECT COUNT(*)'
      '110608282=      FROM RDB$TRIGGERS'
      '110608283=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGU'#39
      '110608284=      INTO :ANZ;'
      '110608285='
      '110608286=    IF (ANZ>0) THEN'
      '110608287=      TRGUX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGU'#39';'
      '110608288=    ELSE'
      '110608289=      TRGUX='#39#39';'
      '110608290='
      
        '110608291=    TRGU='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGU FOR '#39'||TN||'#39' AC' +
        'TIVE AFTER UPDATE POSITION 255 AS '#39'||CRLF||'
      
        '110608292=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEG' +
        'MENT SIZE 80;'#39'||CRLF||'
      '110608293=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '110608294=         '#39'BEGIN'#39'||CRLF||'
      
        '110608295=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      '110608296=         SQLU||'
      
        '110608297=         '#39'  SQLSTMT=SQLSTMT||'#39#39' WHERE '#39'||ID_COLUMN||'#39'=' +
        #39#39'||OLD.'#39'||ID_COLUMN||'#39';'#39' ||CRLF||'
      '110608298=         '#39'  ID=GEN_ID(GEN_LOGS,1);'#39'||CRLF||'
      
        '110608299=         '#39'  INSERT INTO LOGS(ID,SQLSTMT,USR) VALUES (:' +
        'ID,:SQLSTMT, '#39#39'SYSDBA'#39#39');'#39' ||CRLF||'
      '110608300=         '#39'END'#39';'
      '110608301='
      '110608302=    SELECT COUNT(*)'
      '110608303=      FROM RDB$TRIGGERS'
      '110608304=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGD'#39
      '110608305=      INTO :ANZ;'
      '110608306='
      '110608307=    IF (ANZ>0) THEN'
      '110608308=      TRGDX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGD'#39';'
      '110608309=    ELSE'
      '110608310=      TRGDX='#39#39';'
      '110608311='
      
        '110608312=    TRGD='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGD FOR '#39'||TN||'#39' AC' +
        'TIVE AFTER DELETE POSITION 255 AS '#39'||CRLF||'
      
        '110608313=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEG' +
        'MENT SIZE 80;'#39'||CRLF||'
      '110608314=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '110608315=         '#39'BEGIN'#39'||CRLF||'
      
        '110608316=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '110608317=         '#39'  SQLSTMT='#39#39'DELETE FROM '#39'||TN||'#39' WHERE '#39'||ID' +
        '_COLUMN||'#39'='#39#39'||OLD.'#39'||ID_COLUMN||'#39';'#39'||CRLF||'
      '110608318=         '#39'  ID=GEN_ID(GEN_LOGS,1);'#39'||CRLF||'
      
        '110608319=         '#39'  INSERT INTO LOGS(ID,SQLSTMT,USR) VALUES (:' +
        'ID, :SQLSTMT, '#39#39'SYSDBA'#39#39');'#39'||CRLF||'
      '110608320=         '#39'END'#39';'
      '110608321='
      '110608322=    TN_ALT=TN;'
      '110608323=  END'
      '110608324='
      '110608325=  IF (TRGIX<>'#39#39') THEN'
      '110608326=    EXECUTE STATEMENT TRGIX;'
      '110608327='
      '110608328=  EXECUTE STATEMENT TRGI;'
      '110608329=  IF (TRGUX<>'#39#39') THEN'
      '110608330=    EXECUTE STATEMENT TRGUX;'
      '110608331='
      '110608332=  EXECUTE STATEMENT TRGU;'
      '110608333='
      '110608334=  IF (TRGDX<>'#39#39') THEN'
      '110608335=    EXECUTE STATEMENT TRGDX;'
      '110608336=  EXECUTE STATEMENT TRGD;'
      '110608337='
      '110608338=  -- BLOB-'#1055#1054#1051#1071' '#1054#1058#1044#1045#1051#1068#1053#1067#1045' '#1058#1056#1048#1043#1043#1045#1056#1067
      '110608339=  TN_ALT    = '#39#39';'
      '110608340=  ID_COLUMN = '#39#39';'
      
        '110608341=  FOR SELECT TRIM(RDB$RELATION_FIELDS.RDB$RELATION_NAM' +
        'E),'
      '110608342=             TRIM(RDB$RELATION_FIELDS.RDB$FIELD_NAME)'
      
        '110608343=        FROM RDB$RELATION_FIELDS JOIN RDB$FIELDS ON RD' +
        'B$RELATION_FIELDS.RDB$FIELD_SOURCE=RDB$FIELDS.RDB$FIELD_NAME'
      
        '110608344=       WHERE RDB$RELATION_FIELDS.RDB$RELATION_NAME NOT' +
        ' CONTAINING '#39'$'#39
      '110608345=         AND RDB$FIELDS.RDB$FIELD_TYPE = 261'
      '110608346=         AND RDB$FIELDS.RDB$FIELD_SUB_TYPE = 0'
      
        '110608347=         AND RDB$RELATION_FIELDS.RDB$RELATION_NAME NOT' +
        ' IN ('#39'CUR_PARAMS'#39', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_S' +
        'IZES'#39','
      
        '110608348=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110608349=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110608350=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110608351=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110608352=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110608353=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_TOCH' +
        'KA'#39')'
      '110608354=        INTO :TN,'
      '110608355=             :FN'
      '110608356=  DO BEGIN'
      '110608357=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN BEGIN'
      '110608358=      SELECT TRIM(F.RDB$FIELD_NAME)'
      '110608359=        FROM RDB$RELATION_FIELDS F'
      '110608360=       WHERE F.RDB$RELATION_NAME = :TN'
      '110608361=         AND F.RDB$FIELD_POSITION = 0'
      '110608362=        INTO :ID_COLUMN;'
      '110608363=    END'
      '110608364='
      
        '110608365=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110608366=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '110608367=        '#39'AS '#39'||CRLF||'
      '110608368=        '#39'BEGIN '#39'||CRLF||'
      
        '110608369=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      '110608370=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF||'
      
        '110608371=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110608372=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110608373=        '#39'END;'#39';'
      '110608374=    EXECUTE STATEMENT :TRGI;'
      '110608375='
      
        '110608376=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN||' +
        #39' '#39'||CRLF||'
      '110608377=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '110608378=        '#39'AS '#39'||CRLF||'
      '110608379=        '#39'BEGIN '#39'||CRLF||'
      
        '110608380=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'RE' +
        'PLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '110608381=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRLF' +
        '||'
      
        '110608382=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR,' +
        ' DAT)'#39'||CRLF||'
      
        '110608383=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39#39 +
        ', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', NE' +
        'W.'#39'||FN||'#39');'#39'||CRLF||'
      '110608384=        '#39'END;'#39';'
      '110608385=    EXECUTE STATEMENT :TRGI;'
      '110608386='
      '110608387=    TN_ALT = TN;'
      '110608388=  END'
      '110608389='
      '110608390=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '110608391=        FROM RDB$RELATIONS R'
      '110608392=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110608393=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '110608394=       ORDER BY R.RDB$RELATION_NAME'
      '110608395=        INTO :TN'
      '110608396=  DO BEGIN'
      '110608397=    TN=TRIM(TN);'
      '110608398=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '110608399='
      '110608400=    EXECUTE STATEMENT :SQLSTMT;'
      '110608401=  END'
      '110608402=END'
      '110608403=;'
      '110608404='
      '110608405=ALTER PROCEDURE P_REP_AKT_SVERKI('
      '110608406=  DATE_BEGIN_ DATE,'
      '110608407=  DATE_END_ DATE,'
      '110608408=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110608409=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110608410=  CLIENT_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110608411=  CLIENT_DIR_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110608412=  FIRM_NAME_IN_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '110608413=  G_OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110608414=  CURRENCY_ INTEGER)'
      '110608415=RETURNS ('
      '110608416=  STR1_ VARCHAR(500),'
      '110608417=  STR2_ VARCHAR(700),'
      '110608418=  STR3_ VARCHAR(500),'
      '110608419=  STR3_DOWN_ VARCHAR(500),'
      '110608420=  STR4_ VARCHAR(500),'
      '110608421=  STR5_ VARCHAR(500),'
      '110608422=  STR_SALDO_IN_ VARCHAR(50),'
      '110608423=  STR_SALDO_OUT_ VARCHAR(50),'
      '110608424=  STR_OT1_ VARCHAR(500),'
      '110608425=  STR_OT2_ VARCHAR(500),'
      '110608426=  DEBET_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110608427=  DEBET_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110608428=  CREDIT_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110608429=  CREDIT_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110608430=  DEBET_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110608431=  CREDIT_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110608432=  FIRM_NAME_OUT_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '110608433=  CLIENT_NAME_OUT_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110608434=  STR_TEXT VARCHAR(100),'
      '110608435=  OPER_DATE TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '110608436=  SUMM_DEBET TYPE OF COLUMN SKLAD.SUMM,'
      '110608437=  SUMM_CREDIT TYPE OF COLUMN SKLAD.SUMM,'
      '110608438=  SUMM_DEBET_CONTR TYPE OF COLUMN SKLAD.SUMM,'
      '110608439=  SUMM_CREDIT_CONTR TYPE OF COLUMN SKLAD.SUMM)'
      '110608440=AS'
      
        '110608441=DECLARE VARIABLE IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.' +
        'IS_SUPPLIER;'
      '110608442=DECLARE VARIABLE ID  TYPE OF COLUMN CUR_PARAMS.ID;'
      '110608443=DECLARE VARIABLE ROW INTEGER;'
      '110608444=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '110608445=DECLARE VARIABLE SUMM_IN_DEBET_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM;'
      
        '110608446=DECLARE VARIABLE SUMM_IN_CREDIT_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '110608447=DECLARE VARIABLE SUMM_IN_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM;'
      
        '110608448=DECLARE VARIABLE SUMM_OUT_DEBET_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '110608449=DECLARE VARIABLE SUMM_OUT_CREDIT_ TYPE OF COLUMN SKLAD' +
        '_PARENT.SUMM;'
      
        '110608450=DECLARE VARIABLE SUMM_OUT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110608451=DECLARE VARIABLE SUMM_OUT_1 TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      
        '110608452=DECLARE VARIABLE SUMM_OUT_2 TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      '110608453=DECLARE VARIABLE CURR_STR_ VARCHAR(5);'
      '110608454=DECLARE VARIABLE SORT_ROW DATE;'
      '110608455=BEGIN'
      '110608456=  CLRF = ascii_char( 10 );'
      '110608457='
      '110608458=  if (CURRENCY_ = 0) then'
      '110608459=    CURR_STR_ = '#39' KZT'#39';'
      '110608460=  else if (CURRENCY_ = 1) then'
      '110608461=    CURR_STR_ = '#39' '#1088#1091#1073'.'#39';'
      '110608462=  else'
      '110608463=    CURR_STR_ = '#39' '#1075#1088#1085'.'#39';'
      '110608464='
      '110608465=  if (G_OFFICIAL_NAME_ IS NULL) then BEGIN'
      '110608466=      SELECT J.FIO_DOC'
      '110608467=        FROM G_OFFICIAL J'
      '110608468=       WHERE J.IS_RUKOVODITEL = 1'
      '110608469=        INTO G_OFFICIAL_NAME_;'
      '110608470='
      '110608471=      if (G_OFFICIAL_NAME_ IS NULL) then'
      '110608472=        SELECT J.FIO_DOC'
      '110608473=          FROM G_OFFICIAL J'
      
        '110608474=         WHERE J.G_OFFICIAL = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 1)'
      '110608475=         INTO G_OFFICIAL_NAME_;'
      '110608476=  END'
      '110608477='
      '110608478=  CLIENT_NAME_OUT_  = CLIENT_NAME_IN_;'
      '110608479=  FIRM_NAME_OUT_    = FIRM_NAME_IN_;'
      '110608480='
      
        '110608481=  if (TRIM(G_OFFICIAL_NAME_) IS NULL or TRIM(G_OFFICIA' +
        'L_NAME_) = '#39#39') then'
      '110608482=    G_OFFICIAL_NAME_ = '#39'________________'#39';'
      '110608483='
      
        '110608484=  if (TRIM(CLIENT_DIR_NAME_IN_) IS NULL or TRIM(CLIENT' +
        '_DIR_NAME_IN_) = '#39#39') then'
      '110608485=    CLIENT_DIR_NAME_IN_ = '#39'________________'#39';'
      '110608486='
      
        '110608487=  STR1_ = '#39#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1079#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRA' +
        'CT(DAY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM ' +
        'DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'
      
        '110608488=          '#39' '#1087#1086' '#39'||lpad(EXTRACT(DAY FROM DATE_END_), 2,' +
        ' '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EX' +
        'TRACT(YEAR FROM DATE_END_)||clrf||'
      '110608489=          '#39' '#1084#1077#1078#1076#1091' '#39'||FIRM_NAME_OUT_||clrf||'
      '110608490=          '#39' '#1080' '#39'||CLIENT_NAME_OUT_;'
      '110608491='
      
        '110608492=  STR2_ = '#39#1052#1099', '#1085#1080#1078#1077#1087#1086#1076#1087#1080#1089#1072#1074#1096#1080#1077#1089#1103', ________________ '#39'||' +
        'FIRM_NAME_OUT_||'#39' '#39'||G_OFFICIAL_NAME_||'#39', '#1089' '#1086#1076#1085#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '110608493=          '#39#1080' ________________ '#39'||CLIENT_NAME_OUT_||'#39' '#39 +
        '||CLIENT_DIR_NAME_IN_||'#39', '#1089' '#1076#1088#1091#1075#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '110608494=          '#39#1089#1086#1089#1090#1072#1074#1080#1083#1080' '#1085#1072#1089#1090#1086#1103#1097#1080#1081' '#1072#1082#1090' '#1089#1074#1077#1088#1082#1080' '#1074' '#1090#1086#1084', '#1095#1090#1086' '#1089 +
        #1086#1089#1090#1086#1103#1085#1080#1077' '#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1087#1086' '#1076#1072#1085#1085#1099#1084' '#1091#1095#1077#1090#1072' '#1089#1083#1077#1076#1091#1102#1097#1077#1077':'#39';'
      '110608495='
      
        '110608496=  STR3_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_||'#39','#39'||CURR_STR_' +
        ';'
      '110608497=  STR3_DOWN_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_;'
      
        '110608498=  STR4_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||CLIENT_NAME_OUT_||'#39','#39'||CURR_ST' +
        'R_;'
      '110608499='
      
        '110608500=  STR_SALDO_IN_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1085#1072#1095#1072#1083#1086' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110608501=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_BEGIN_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DAT' +
        'E_BEGIN_)||'#39' '#1075'.'#39';'
      '110608502='
      
        '110608503=  STR_SALDO_OUT_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1082#1086#1085#1077#1094' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_END_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110608504=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_END_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DATE_' +
        'END_)||'#39' '#1075'.'#39';'
      '110608505='
      '110608506=  STR_OT1_ = '#39#1054#1090' '#39'||FIRM_NAME_OUT_;'
      '110608507=  STR_OT2_ = '#39#1054#1090' '#39'||CLIENT_NAME_OUT_;'
      '110608508='
      '110608509=  SELECT IS_SUPPLIER'
      '110608510=    FROM G_CLIENT G'
      '110608511=   WHERE G.G_CLIENT = :G_CLIENT_'
      '110608512=    INTO :IS_SUPPLIER_;'
      '110608513='
      '110608514=  DEBET_IN_   = 0;'
      '110608515=  DEBET_OUT_  = 0;'
      '110608516=  CREDIT_IN_  = 0;'
      '110608517=  CREDIT_OUT_ = 0;'
      '110608518='
      
        '110608519=  STR5_ = '#39#1085#1072' '#39'||LPAD(EXTRACT(DAY FROM CURRENT_DATE), ' +
        '2, '#39'0'#39')||'#39'.'#39'||LPAD(EXTRACT(MONTH FROM CURRENT_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110608520='
      
        '110608521=  --**************************************************' +
        '*****************'
      '110608522=  -- '#1055#1054#1057#1058#1040#1042#1065#1048#1050
      
        '110608523=  --**************************************************' +
        '*****************'
      '110608524=  IF (IS_SUPPLIER_ = 1) THEN BEGIN'
      '110608525=    ----------------------'
      '110608526=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110608527=    SELECT SUM(S.SUMM)'
      '110608528=      FROM SKLAD_PARENT S'
      '110608529=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608530=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110608531=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608532=    GROUP BY S.G_CLIENT'
      '110608533=      INTO :SUMM_IN_DEBET_;'
      '110608534='
      '110608535=    SELECT SUM(K.SUMM)'
      '110608536=      FROM SKLAD_PARENT S,'
      
        '110608537=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608538=             from KASSA'
      
        '110608539=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608540=              AND ZAKAZ IS NULL'
      '110608541=           union all'
      
        '110608542=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608543=             from kassa_beznal'
      
        '110608544=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608545=              AND ZAKAZ IS NULL) K'
      '110608546=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608547=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608548=       AND K.SKLAD = S.SKLAD'
      '110608549=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110608550=       AND K.G_PRIHOD_RASHOD = 2'
      '110608551=    GROUP BY S.G_CLIENT'
      '110608552=      INTO :SUMM_IN_CREDIT_;'
      '110608553='
      
        '110608554=    SELECT :SUMM_IN_DEBET_ + SUM(S.SUMM)              ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110608555=      FROM ZAKAZ S'
      '110608556=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608557=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110608558=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608559=    GROUP BY S.G_CLIENT'
      '110608560=      INTO :SUMM_IN_DEBET_;'
      '110608561='
      
        '110608562=    SELECT :SUMM_IN_CREDIT_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110608563=      FROM ZAKAZ S,'
      '110608564=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110608565=             from KASSA'
      
        '110608566=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608567=              AND SKLAD IS NULL'
      '110608568=           union all'
      '110608569=           select ZAKAZ, SUMM, ACTION_DATE'
      '110608570=             from kassa_beznal'
      
        '110608571=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608572=              AND SKLAD IS NULL) K'
      '110608573=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608574=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608575=       AND K.zakaz = S.ZAKAZ'
      '110608576=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110608577=    GROUP BY S.G_CLIENT'
      '110608578=      INTO :SUMM_IN_CREDIT_;'
      '110608579='
      '110608580=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110608581='
      '110608582=    ----------------------'
      '110608583=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110608584=    SELECT SUM(S.SUMM)'
      '110608585=      FROM SKLAD_PARENT S'
      '110608586=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608587=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110608588=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608589=    GROUP BY S.G_CLIENT'
      '110608590=      INTO :SUMM_OUT_DEBET_;'
      '110608591='
      '110608592=    SELECT SUM(K.SUMM)'
      '110608593=      FROM SKLAD_PARENT S,'
      
        '110608594=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608595=             from KASSA'
      
        '110608596=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608597=              AND ZAKAZ IS NULL'
      '110608598=           union all'
      
        '110608599=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608600=             from kassa_beznal'
      
        '110608601=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608602=              AND ZAKAZ IS NULL) K'
      '110608603=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608604=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608605=       AND K.SKLAD = S.SKLAD'
      '110608606=       AND K.ACTION_DATE <= :DATE_END_'
      '110608607=       AND K.G_PRIHOD_RASHOD = 2'
      '110608608=    GROUP BY S.G_CLIENT'
      '110608609=      INTO :SUMM_OUT_CREDIT_;'
      '110608610='
      
        '110608611=    SELECT :SUMM_OUT_CREDIT_ +SUM(S.SUMM)             ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110608612=      FROM ZAKAZ S'
      '110608613=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608614=       AND S.Z_DATE <= :DATE_END_'
      
        '110608615=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608616=    GROUP BY S.G_CLIENT'
      '110608617=      INTO :SUMM_OUT_CREDIT_;'
      '110608618='
      
        '110608619=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110608620=      FROM ZAKAZ S,'
      '110608621=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110608622=             from KASSA'
      
        '110608623=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608624=              AND SKLAD IS NULL'
      '110608625=           union all'
      '110608626=           select ZAKAZ, SUMM, ACTION_DATE'
      '110608627=             from kassa_beznal'
      
        '110608628=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608629=              AND SKLAD IS NULL) K'
      '110608630=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608631=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608632=       AND K.zakaz = S.ZAKAZ'
      '110608633=       AND K.ACTION_DATE <= :DATE_END_'
      '110608634=    GROUP BY S.G_CLIENT'
      '110608635=      INTO :SUMM_OUT_DEBET_;'
      '110608636='
      '110608637=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110608638=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110608639=    -------------------------'
      '110608640='
      '110608641=    if (COALESCE(SUMM_IN_, 0) < 0) then'
      '110608642=      DEBET_IN_ = SUMM_IN_;'
      '110608643=    ELSE'
      '110608644=      CREDIT_IN_ = SUMM_IN_;'
      '110608645='
      '110608646=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110608647=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110608648='
      '110608649=    if (COALESCE(SUMM_OUT_, 0) < 0) then'
      '110608650=      DEBET_OUT_ = ABS(SUMM_OUT_);'
      '110608651=    ELSE'
      '110608652=      CREDIT_OUT_ = SUMM_OUT_;'
      '110608653='
      '110608654=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110608655=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110608656='
      '110608657=        if (DEBET_OUT_ > 0) then'
      
        '110608658=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110608659=        else'
      
        '110608660=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110608661=    end else'
      '110608662=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110608663='
      '110608664=    FOR SELECT 1 ROW,'
      
        '110608665=               '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1058#1052#1047' '#39'||S.SKLAD||'#39' '#1086#1090' '#39'||S.' +
        'DATE_RECEIPT str,'
      '110608666=               S.SKLAD ID,'
      '110608667=               S.DATE_RECEIPT OPER_DATE,'
      '110608668=               NULL SUMM_DEBET,'
      '110608669=               S.SUMM SUMM_CREDIT,'
      '110608670=               S.DATE_RECEIPT SORT_ROW'
      '110608671=          FROM SKLAD_PARENT S'
      '110608672=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608673=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110608674=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110608675=        UNION ALL'
      '110608676=        SELECT 2 ROW,'
      
        '110608677=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' '#1086#1090' '#39'||SP' +
        'P.DATE_RECEIPT STR,'
      '110608678=               K.SKLAD ID,'
      '110608679=               K.ACTION_DATE OPER_DATE,'
      '110608680=               K.SUMM SUMM_DEBET,'
      '110608681=               NULL SUMM_CREDIT,'
      '110608682=               K.ACTION_DATE SORT_ROW'
      
        '110608683=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110608684=                  from KASSA'
      
        '110608685=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110608686=                union all'
      
        '110608687=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110608688=                  from kassa_beznal'
      
        '110608689=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110608690=               SKLAD_PARENT SPP'
      '110608691=         WHERE K.ZAKAZ IS NULL'
      '110608692=           AND K.SKLAD = SPP.SKLAD'
      
        '110608693=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110608694=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110608695=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110608696=           AND K.G_PRIHOD_RASHOD = 2'
      '110608697=        UNION ALL'
      '110608698=        SELECT 3 ROW,'
      
        '110608699=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#39'||Z.ZAKAZ||'#39' '#1086 +
        #1090' '#39'||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT' +
        '(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE)' +
        ' str,'
      '110608700=               Z.ZAKAZ ID,'
      '110608701=               Z.Z_DATE OPER_DATE,'
      '110608702=               Z.SUMM SUMM_DEBET,'
      '110608703=               NULL SUMM_CREDIT,'
      '110608704=               Z.Z_DATE SORT_ROW'
      '110608705=          FROM ZAKAZ Z'
      '110608706=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110608707=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110608708=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110608709=        UNION ALL'
      '110608710=        SELECT 4 ROW,'
      
        '110608711=               '#39#1054#1087#1083#1072#1090#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' '#39 +
        '||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(M' +
        'ONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE)' +
        ' STR,'
      '110608712=               K.ZAKAZ ID,'
      '110608713=               K.ACTION_DATE OPER_DATE,'
      '110608714=               NULL SUMM_DEBET,'
      '110608715=               K.SUMM SUMM_CREDIT,'
      '110608716=               K.ACTION_DATE SORT_ROW'
      
        '110608717=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA'
      '110608718=                  from KASSA'
      
        '110608719=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110608720=                union all'
      
        '110608721=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA'
      '110608722=                  from kassa_beznal'
      
        '110608723=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '110608724=               zakaz zz'
      '110608725=         WHERE K.sklad IS NULL'
      '110608726=           AND K.zakaz = zz.ZAKAZ'
      
        '110608727=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110608728=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110608729=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110608730=        UNION ALL'
      '110608731=        SELECT 5 ROW,'
      '110608732=               NULL STR,'
      '110608733=               NULL ID,'
      '110608734=               NULL OPER_DATE,'
      '110608735=               NULL SUMM_DEBET,'
      '110608736=               NULL SUMM_CREDIT,'
      
        '110608737=               '#39'31.12.2199'#39' SORT_ROW    -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072 +
        #1103' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110608738=          FROM RDB$DATABASE'
      '110608739=        ORDER BY 7, 3, 1'
      '110608740=        INTO :ROW,'
      '110608741=             :STR_TEXT,'
      '110608742=             :ID,'
      '110608743=             :OPER_DATE,'
      '110608744=             :SUMM_DEBET,'
      '110608745=             :SUMM_CREDIT,'
      '110608746=             :SORT_ROW'
      '110608747=    DO BEGIN'
      '110608748=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110608749=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110608750=      SUSPEND;'
      '110608751=    END'
      '110608752=  END'
      '110608753='
      
        '110608754=  --**************************************************' +
        '*************'
      '110608755=  -- '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068
      
        '110608756=  --**************************************************' +
        '*************'
      '110608757=  ELSE BEGIN'
      '110608758=    ----------------------'
      '110608759=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110608760=    SELECT SUM(S.SUMM)'
      '110608761=      FROM ZAKAZ S'
      '110608762=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608763=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110608764=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608765=       AND S.is_spisanie <> 1'
      '110608766=    GROUP BY S.G_CLIENT'
      '110608767=      INTO :SUMM_IN_DEBET_;'
      '110608768='
      '110608769=    SELECT SUM(K.SUMM)'
      '110608770=      FROM ZAKAZ S,'
      
        '110608771=          (select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608772=             from KASSA'
      
        '110608773=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608774=              AND SKLAD IS NULL'
      '110608775=           union all'
      
        '110608776=           select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608777=             from kassa_beznal'
      
        '110608778=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608779=              AND SKLAD IS NULL'
      '110608780=           union all'
      
        '110608781=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110608782=             from zakaz Z'
      
        '110608783=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608784=              AND Z.summ_bonus > 0) K'
      '110608785=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608786=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608787=       AND K.zakaz = S.ZAKAZ'
      '110608788=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110608789=       AND S.is_spisanie <> 1'
      '110608790=       AND K.G_PRIHOD_RASHOD = 1'
      '110608791=    GROUP BY S.G_CLIENT'
      '110608792=      INTO :SUMM_IN_CREDIT_;'
      '110608793='
      
        '110608794=    SELECT :SUMM_IN_DEBET_ + SUM(K.SUMM)              ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110608795=      FROM SKLAD_PARENT S,'
      
        '110608796=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608797=             from KASSA'
      
        '110608798=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608799=              AND ZAKAZ IS NULL'
      '110608800=           union all'
      
        '110608801=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110608802=             from kassa_beznal'
      
        '110608803=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608804=              AND ZAKAZ IS NULL) K'
      '110608805=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608806=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608807=       AND K.SKLAD = S.SKLAD'
      '110608808=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110608809=       AND K.G_PRIHOD_RASHOD = 3'
      '110608810=    GROUP BY S.G_CLIENT'
      '110608811=      INTO :SUMM_IN_DEBET_;'
      '110608812='
      
        '110608813=    SELECT :SUMM_IN_CREDIT_ + SUM(S.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110608814=      FROM SKLAD_PARENT S'
      '110608815=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608816=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110608817=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608818=    GROUP BY S.G_CLIENT'
      '110608819=      INTO :SUMM_IN_CREDIT_;'
      '110608820='
      '110608821=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110608822='
      '110608823=    ----------------------'
      '110608824=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110608825=    SELECT SUM(S.SUMM)'
      '110608826=      FROM ZAKAZ S'
      '110608827=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608828=       AND S.Z_DATE <= :DATE_END_'
      
        '110608829=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608830=       AND S.is_spisanie <> 1'
      '110608831=    GROUP BY S.G_CLIENT'
      '110608832=      INTO :SUMM_OUT_DEBET_;'
      '110608833='
      '110608834=    SELECT SUM(K.SUMM)'
      '110608835=      FROM ZAKAZ S,'
      
        '110608836=          (select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110608837=             from KASSA'
      
        '110608838=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608839=              AND SKLAD IS NULL'
      '110608840=           union all'
      
        '110608841=           select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110608842=             from kassa_beznal'
      
        '110608843=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608844=              AND SKLAD IS NULL'
      '110608845=           union all'
      
        '110608846=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110608847=             from zakaz Z'
      
        '110608848=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608849=              AND Z.summ_bonus > 0) K'
      '110608850=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608851=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608852=       AND K.zakaz = S.ZAKAZ'
      '110608853=       AND K.ACTION_DATE <= :DATE_END_'
      '110608854=       AND K.G_PRIHOD_RASHOD = 1'
      '110608855=    GROUP BY S.G_CLIENT'
      '110608856=      INTO :SUMM_OUT_CREDIT_;'
      '110608857='
      
        '110608858=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110608859=      FROM SKLAD_PARENT S,'
      
        '110608860=          (select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110608861=             from KASSA'
      
        '110608862=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608863=              AND ZAKAZ IS NULL'
      '110608864=           union all'
      
        '110608865=           select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110608866=             from kassa_beznal'
      
        '110608867=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110608868=              AND ZAKAZ IS NULL) K'
      '110608869=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608870=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608871=       AND K.SKLAD = S.SKLAD'
      '110608872=       AND K.ACTION_DATE <= :DATE_END_'
      '110608873=       AND K.G_PRIHOD_RASHOD = 3'
      '110608874=    GROUP BY S.G_CLIENT'
      '110608875=      INTO :SUMM_OUT_DEBET_;'
      '110608876='
      
        '110608877=    SELECT :SUMM_OUT_CREDIT_ + SUM(S.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110608878=      FROM SKLAD_PARENT S'
      '110608879=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110608880=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110608881=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110608882=    GROUP BY S.G_CLIENT'
      '110608883=      INTO :SUMM_OUT_CREDIT_;'
      '110608884='
      '110608885=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110608886=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110608887=    -------------------------'
      '110608888='
      '110608889=    IF (COALESCE(SUMM_IN_, 0) > 0) then'
      '110608890=      DEBET_IN_ = SUMM_IN_;'
      '110608891=    ELSE'
      '110608892=      CREDIT_IN_ = SUMM_IN_;'
      '110608893='
      '110608894=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110608895=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110608896='
      '110608897=    if (COALESCE(SUMM_OUT_, 0) > 0) then'
      '110608898=      DEBET_OUT_ = SUMM_OUT_;'
      '110608899=    ELSE'
      '110608900=      CREDIT_OUT_ = ABS(SUMM_OUT_);'
      '110608901='
      '110608902=    --------------------'
      '110608903=    -- '#1047#1040#1044#1054#1051#1046#1045#1053#1053#1054#1057#1058#1068
      '110608904=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110608905=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110608906='
      '110608907=        if (DEBET_OUT_ > 0) then'
      
        '110608908=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110608909=        else'
      
        '110608910=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110608911=    end else'
      '110608912=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110608913='
      '110608914=    FOR SELECT 1 ROW,'
      
        '110608915=               '#39#1055#1088#1086#1076#1072#1078#1072', '#1085#1072#1082#1083#1072#1076#1085#1072#1103' '#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39'|' +
        '|lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MON' +
        'TH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE) str' +
        ','
      '110608916=               Z.ZAKAZ ID,'
      '110608917=               Z.Z_DATE OPER_DATE,'
      '110608918=               Z.SUMM SUMM_DEBET,'
      '110608919=               NULL SUMM_CREDIT,'
      '110608920=               Z.Z_DATE SORT_ROW'
      '110608921=          FROM ZAKAZ Z'
      '110608922=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110608923=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110608924=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110608925=        UNION ALL'
      '110608926=        SELECT 2 ROW,'
      
        '110608927=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1085#1072#1082#1083#1072#1076#1085#1091#1102' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(' +
        'MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE' +
        ') STR,'
      '110608928=               K.ZAKAZ ID,'
      '110608929=               K.ACTION_DATE OPER_DATE,'
      '110608930=               NULL SUMM_DEBET,'
      '110608931=               K.SUMM SUMM_CREDIT,'
      '110608932=               K.ACTION_DATE SORT_ROW'
      
        '110608933=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA, G_PRIHOD_RASHOD'
      '110608934=                  from KASSA'
      
        '110608935=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110608936=                union all'
      
        '110608937=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA, G_PRIHOD_RASHOD'
      '110608938=                  from kassa_beznal'
      
        '110608939=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110608940=                union all'
      
        '110608941=                select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z' +
        '_date ACTION_DATE, NULL SKLAD, NULL KASSA, 1 G_PRIHOD_RASHOD'
      '110608942=                  from zakaz Z'
      
        '110608943=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110608944=                   AND Z.summ_bonus > 0) K,'
      '110608945=               zakaz zz'
      '110608946=         WHERE K.sklad IS NULL'
      '110608947=           AND K.zakaz = zz.ZAKAZ'
      
        '110608948=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110608949=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110608950=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110608951=           AND K.G_PRIHOD_RASHOD = 1'
      '110608952=        UNION ALL'
      '110608953=        SELECT 3 ROW,'
      
        '110608954=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1082#1083#1080#1077#1085#1090#1086#1084' '#39'||S.SKLAD||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXT' +
        'RACT(MONTH FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM' +
        ' S.DATE_RECEIPT) str,'
      '110608955=               S.SKLAD ID,'
      '110608956=               S.DATE_RECEIPT OPER_DATE,'
      '110608957=               NULL SUMM_DEBET,'
      '110608958=               S.SUMM SUMM_CREDIT,'
      '110608959=               S.DATE_RECEIPT SORT_ROW'
      '110608960=          FROM SKLAD_PARENT S'
      '110608961=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110608962=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110608963=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110608964=        UNION ALL'
      '110608965=        SELECT 4 ROW,'
      
        '110608966=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' ' +
        #1086#1090' '#39'||lpad(EXTRACT(DAY FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpa' +
        'd(EXTRACT(MONTH FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM SPP.DATE_RECEIPT) STR,'
      '110608967=               K.SKLAD ID,'
      '110608968=               K.ACTION_DATE OPER_DATE,'
      '110608969=               K.SUMM SUMM_DEBET,'
      '110608970=               NULL SUMM_CREDIT,'
      '110608971=               K.ACTION_DATE SORT_ROW'
      
        '110608972=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110608973=                  from KASSA'
      
        '110608974=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110608975=                union all'
      
        '110608976=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110608977=                  from kassa_beznal'
      
        '110608978=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110608979=               SKLAD_PARENT SPP'
      '110608980=         WHERE K.ZAKAZ IS NULL'
      '110608981=           AND K.SKLAD = SPP.SKLAD'
      
        '110608982=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110608983=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110608984=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110608985=           AND K.G_PRIHOD_RASHOD = 3'
      '110608986=        UNION ALL'
      '110608987=        SELECT 5 ROW,'
      '110608988=               NULL STR,'
      '110608989=               NULL ID,'
      '110608990=               NULL OPER_DATE,'
      '110608991=               NULL SUMM_DEBET,'
      '110608992=               NULL SUMM_CREDIT,'
      
        '110608993=               '#39'31.12.2199'#39' SORT_ROW  -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072#1103' ' +
        #1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110608994=          FROM RDB$DATABASE'
      '110608995=        ORDER BY 7, 3, 1'
      '110608996=        INTO :ROW,'
      '110608997=             :STR_TEXT,'
      '110608998=             :ID,'
      '110608999=             :OPER_DATE,'
      '110609000=             :SUMM_DEBET,'
      '110609001=             :SUMM_CREDIT,'
      '110609002=             :SORT_ROW'
      '110609003=    DO BEGIN'
      '110609004=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110609005=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110609006='
      '110609007=      SUSPEND;'
      '110609008=    END'
      '110609009=  END'
      '110609010='
      '110609011=END'
      '110609012=;'
      '110609013='
      '110609014=ALTER PROCEDURE P_REP_DENEJ_MASSA('
      '110609015=  DATE_BEGIN_ DATE,'
      '110609016=  DATE_END_ DATE,'
      '110609017=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110609018=RETURNS ('
      '110609019=  PERIOD_ VARCHAR(40),'
      '110609020=  SUMM NUMERIC(15,2),'
      '110609021=  PROFIT NUMERIC(15,2),'
      '110609022=  ERR_CODE INTEGER,'
      '110609023=  ERR_MSG VARCHAR(1024))'
      '110609024=AS'
      
        '110609025=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_DENEJ_M' +
        'ASSA'#39';'
      '110609026=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110609027=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110609028=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110609029=DECLARE VARIABLE PRICE_SELF_ TYPE OF COLUMN SKLAD.PRIC' +
        'E; /* '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1040' */'
      
        '110609030=DECLARE VARIABLE SUMM_SELF_ TYPE OF COLUMN SKLAD.SUMM ' +
        '= 0; /* '#1057#1059#1052#1052#1040' '#1047#1040#1050#1059#1055#1040' */'
      
        '110609031=DECLARE VARIABLE SUMM_SALE_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'FACT = 0; /* '#1057#1059#1052#1052#1040' '#1055#1056#1054#1044#1040#1046' */'
      '110609032=BEGIN'
      '110609033='
      
        '110609034=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110609035=               lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0' +
        #39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRA' +
        'CT(YEAR FROM DATE_END_);'
      '110609036='
      '110609037=  SELECT SUM(ZD.AMOUNT * ZD.COST_PRICE)'
      '110609038=    FROM ZAKAZ Z,'
      '110609039=        ZAKAZ_DETAILS ZD'
      
        '110609040=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110609041=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110609042=     AND Z.ZAKAZ = ZD.ZAKAZ'
      '110609043=     AND Z.IS_SPISANIE in (0,2)'
      '110609044=     AND Z.is_reserve = 0'
      '110609045=    INTO :SUMM_SELF_;'
      '110609046='
      '110609047=  SELECT SUM(Z.SUMM_FACT)'
      '110609048=    FROM ZAKAZ Z'
      
        '110609049=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110609050=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '110609051=     AND Z.IS_SPISANIE in (0,2)'
      '110609052=     AND Z.IS_RESERVE = 0'
      '110609053=    INTO :SUMM_SALE_;'
      '110609054='
      '110609055=  FOR'
      '110609056=  SELECT :SUMM_SALE_, :SUMM_SALE_ - :SUMM_SELF_'
      '110609057=    FROM RDB$DATABASE R'
      '110609058=    INTO :SUMM, :PROFIT'
      '110609059=  DO'
      '110609060=    SUSPEND;'
      '110609061='
      '110609062=WHEN ANY DO BEGIN'
      '110609063=    Err_code = -20500;'
      
        '110609064=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110609065=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110609066=  END'
      '110609067=end'
      '110609068=;'
      '110609069='
      '110609070=ALTER PROCEDURE P_REP_DISCONT_CARD_LIST'
      '110609071=RETURNS ('
      '110609072=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110609073=  BARCODE TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110609074=  N_PERCENT TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110609075=  SUMM TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110609076=  SUMM_ALL TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110609077=  SKIDKA TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '110609078=  ERR_CODE INTEGER,'
      '110609079=  ERR_MSG VARCHAR(1024))'
      '110609080=AS'
      
        '110609081=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_DISCONT' +
        '_CARD_LIST'#39';'
      '110609082=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110609083=BEGIN'
      '110609084='
      
        '110609085=  FOR SELECT C.BARCODE, C.N_PERCENT, C.SUMM, C.SUMM_AL' +
        'L, G.NAME, G.SKIDKA'
      '110609086=      FROM G_DISCONT_CARD C, G_CLIENT G'
      '110609087=      WHERE C.G_CLIENT = G.G_CLIENT'
      '110609088=      AND G.IS_SUPPLIER = 0'
      '110609089=      --AND C.N_PERCENT > 0'
      '110609090=      AND TRIM(C.BARCODE) <> '#39#39
      '110609091=      ORDER BY 1'
      
        '110609092=      INTO :BARCODE, :N_PERCENT, :SUMM, :SUMM_ALL, :CL' +
        'IENT_NAME, :SKIDKA'
      '110609093=  DO'
      '110609094=    SUSPEND;'
      '110609095='
      '110609096=WHEN ANY DO BEGIN'
      '110609097=    Err_code = -20500;'
      
        '110609098=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1050#1040#1056#1058#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110609099=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110609100=  END'
      '110609101=end'
      '110609102=;'
      '110609103='
      '110609104=ALTER PROCEDURE P_REP_DOC('
      '110609105=  DOC_ TYPE OF COLUMN DOCS.DOCS,'
      '110609106=  CURRENCY_ INTEGER,'
      '110609107=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110609108=  DOC_TYPE_ INTEGER)'
      '110609109=RETURNS ('
      '110609110=  NUM_ VARCHAR(50),'
      '110609111=  DOCS_DATE_ VARCHAR(20),'
      '110609112=  G_FIRM_ VARCHAR(1000),'
      '110609113=  G_FIRM_ADDRESS_ VARCHAR(1000),'
      '110609114=  G_FIRM_ACCOUNT_ VARCHAR(1000),'
      '110609115=  G_FIRM_BANK_ VARCHAR(1000),'
      '110609116=  G_FIRM_AND_ADDRESS_ VARCHAR(1000),'
      '110609117=  G_FIRM_OKPO_ TYPE OF COLUMN G_FIRM_REKVIZIT.OKPO,'
      '110609118=  G_FIRM_BIN_ TYPE OF COLUMN G_FIRM_REKVIZIT.IDN,'
      '110609119=  G_CLIENT_ VARCHAR(1000),'
      '110609120=  G_CLIENT_ADDRESS_ VARCHAR(1000),'
      '110609121=  G_CLIENT_ACCOUNT_ VARCHAR(1000),'
      '110609122=  G_CLIENT_AND_ADDRESS_ VARCHAR(1000),'
      '110609123=  G_CLIENT_BIN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '110609124=  G_OFFICIAL_ VARCHAR(1000),'
      '110609125=  G_OFFICIAL_ID_KIND_ VARCHAR(1000),'
      '110609126=  G_OFFICIAL_ID_NUM_ VARCHAR(1000),'
      '110609127=  G_OFFICIAL_ID_DATE_ VARCHAR(1000),'
      '110609128=  G_OFFICIAL_ID_ISSUER_ VARCHAR(1000),'
      '110609129=  APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '110609130=  RUKOVODITEL_ VARCHAR(1000),'
      '110609131=  GLAVBUH_ VARCHAR(1000),'
      '110609132=  NOTE_ TYPE OF COLUMN DOCS.NOTE,'
      '110609133=  PARAM1_ TYPE OF COLUMN DOCS.PARAM1,'
      '110609134=  PARAM2_ TYPE OF COLUMN DOCS.PARAM2,'
      '110609135=  PARAM3_ TYPE OF COLUMN DOCS.PARAM3,'
      '110609136=  PARAM4_ TYPE OF COLUMN DOCS.PARAM4,'
      '110609137=  PARAM5_ TYPE OF COLUMN DOCS.PARAM5,'
      '110609138=  SUMM_ VARCHAR(1000),'
      '110609139=  SUMM_STR_ VARCHAR(1000),'
      '110609140=  AMOUNT_ MY_NUMERIC_5,'
      '110609141=  ROW_NUM VARCHAR(10),'
      '110609142=  NAME VARCHAR(1000),'
      '110609143=  UNIT_NAME VARCHAR(1000),'
      '110609144=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110609145=  ZDATE VARCHAR(20),'
      '110609146=  AMOUNT MY_NUMERIC_5,'
      '110609147=  PRICE VARCHAR(500),'
      '110609148=  SUMM VARCHAR(500),'
      '110609149=  ERR_CODE INTEGER,'
      '110609150=  ERR_MSG VARCHAR(1024))'
      '110609151=AS'
      '110609152=/*'
      '110609153=DOC_:'
      '110609154=- 0 '#1069#1058#1054' '#1055#1050#1054';'
      '110609155=- 1 '#1069#1058#1054' '#1040#1050#1058' '#1042#1067#1055#1054#1051#1053#1045#1053#1053#1067#1061' '#1056#1040#1041#1054#1058
      '110609156=- 2 '#1069#1058#1054' '#1044#1054#1042#1045#1056#1050#1040';'
      '110609157=- 3 '#1069#1058#1054' '#1044#1045#1060#1045#1050#1058#1054#1042#1054#1063#1053#1067#1049' '#1040#1050#1058
      '110609158='
      '110609159='#1042#1067#1061#1054#1044#1053#1067#1045' '#1055#1040#1056#1040#1052#1045#1058#1056#1067':'
      '110609160='#1055#1050#1054', '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1063#1045#1058' '#1044#1045#1041#1045#1058', '#1055#1040#1056#1040#1052#1045#1058#1056' 2 - '#1057#1063#1045#1058' '#1050#1056#1045#1044#1048#1058
      '110609161='#1040#1050#1058'  '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1074#1077#1076#1077#1085#1080#1103' '#1086#1073' '#1080#1089#1087#1086#1083#1100#1079#1086#1074#1072#1085#1080#1080' '#1079#1072#1087#1072#1089#1086#1074
      
        '110609162='#1044#1054#1042#1045#1056#1045#1053#1053#1054#1057#1058#1068' '#1055#1040#1056#1040#1052#1045#1058#1056' 1 - '#1057#1056#1054#1050' '#1044#1045#1049#1057#1058#1042#1048#1071' '#1044#1054#1042#1045#1056#1050#1048', '#1055#1040#1056#1040#1052 +
        #1045#1058#1056' 2 - '#1057#1063#1045#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1050#1054#1058#1054#1056#1054#1043#1054' '#1044#1045#1051#1040#1051#1048
      '110609163=*/'
      '110609164=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_DOC'#39';'
      '110609165=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110609166=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVIZ' +
        'IT.NOL_VMESTO_BEZ;'
      '110609167=DECLARE VARIABLE I INTEGER = 1;'
      '110609168=DECLARE VARIABLE BL_ TYPE OF COLUMN DOCS.PARAM6;'
      '110609169=DECLARE VARIABLE STR_ VARCHAR(500);'
      
        '110609170=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110609171=DECLARE VARIABLE AMOUNT_ITOG_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0;'
      '110609172=DECLARE VARIABLE STR_NAME_ VARCHAR(500);'
      '110609173=DECLARE VARIABLE STR_AMOUNT_ VARCHAR(500);'
      '110609174=DECLARE VARIABLE STR_UNIT_ VARCHAR(500);'
      '110609175=DECLARE VARIABLE POS_ INTEGER;'
      '110609176=DECLARE VARIABLE POS2_ INTEGER;'
      '110609177=BEGIN'
      '110609178='
      '110609179=  select D.num,'
      
        '110609180=         lpad(EXTRACT(DAY FROM D.DOCS_DATE), 2, '#39'0'#39')||' +
        #39'.'#39'||lpad(EXTRACT(MONTH FROM D.DOCS_DATE), 2, 0)||'#39'.'#39'||EXTRACT(Y' +
        'EAR FROM D.DOCS_DATE),'
      '110609181=         F.name,'
      '110609182=         FD.address,'
      '110609183=         FA.account,'
      '110609184=         FA.BANK_NAME,'
      '110609185=         F.OKPO,'
      '110609186=         F.IDN,'
      
        '110609187=         COALESCE(F.NAME, '#39#39')||DECODE(D.doc_type, 3, C' +
        'OALESCE('#39', '#1048#1048#1053'/'#1041#1048#1053#39'||F.idn, '#39#39'), '#39#39')||COALESCE('#39', '#39'||FD.ADDRESS,' +
        ' '#39#39'),'
      
        '110609188=         DECODE(COALESCE(c.name_FULL, '#39#39'), '#39#39', C.NAME,' +
        ' c.name_FULL),'
      '110609189=         GD.address,'
      '110609190=         GA.account,'
      '110609191=         C.IDN,'
      
        '110609192=         DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39'))' +
        ', 0, C.NAME, c.name_FULL)||DECODE(D.doc_type, 3, COALESCE('#39', '#1048#1048#1053 +
        '/'#1041#1048#1053#39'||C.idn, '#39#39'), '#39#39')||COALESCE('#39', '#39'||GD.ADDRESS, '#39#39'),'
      
        '110609193=         DECODE(D.doc_type, 2, O.APP_NAME||'#39' '#39', '#39#39')||O' +
        '.fio_doc,'
      '110609194=         O.G_ID_KIND,'
      '110609195=         O.ID_NUM,'
      
        '110609196=         lpad(EXTRACT(DAY FROM O.ID_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM O.ID_DATE), 2, 0)||'#39'.'#39'||EXTRACT(YEAR ' +
        'FROM O.ID_DATE),'
      '110609197=         '#39#1074#1099#1076#1072#1085' '#39'||O.ID_ISSUER,'
      '110609198=         O.APP_NAME,'
      '110609199=         O1.FIO_DOC,'
      '110609200=         COALESCE(O2.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '110609201=         D.note,'
      '110609202=         D.param1,'
      '110609203=         D.param2,'
      '110609204=         D.param3,'
      '110609205=         D.param4,'
      '110609206=         D.param5,'
      '110609207=         D.PARAM6'
      '110609208=  FROM docs D'
      
        '110609209=       LEFT OUTER JOIN G_FIRM_ADDRESS FD ON FD.g_addre' +
        'ss = D.g_firm_address'
      
        '110609210=       LEFT outer JOIN (SELECT GG.G_ACCOUNT, GG.accoun' +
        't, GB.name||'#39', '#1041#1048#1050' '#39'||GB.BIK BANK_NAME FROM G_FIRM_ACCOUNT GG, G' +
        '_BANK GB WHERE GG.g_bank = GB.g_bank) FA ON FA.g_account = D.g_f' +
        'irm_account'
      
        '110609211=       LEFT outer JOIN G_ADDRESS GD ON GD.g_address = ' +
        'D.g_client_address'
      
        '110609212=       LEFT outer JOIN G_ACCOUNT GA ON GA.g_account = ' +
        'D.g_client_account'
      
        '110609213=       LEFT outer JOIN (SELECT OO.G_OFFICIAL, OO.FIO_D' +
        'OC, OO.G_ID_KIND, OO.ID_NUM, OO.ID_DATE, OO.ID_ISSUER, APP.NAME ' +
        'APP_NAME FROM G_OFFICIAL OO, G_APPOINTMENT APP WHERE OO.G_APPOIN' +
        'TMENT = APP.G_APPOINTMENT) O ON O.g_official = D.g_official'
      
        '110609214=       LEFT outer JOIN G_OFFICIAL O1 ON O1.g_official ' +
        '= D.G_OFFICIAL_RUKOVOD'
      
        '110609215=       LEFT outer JOIN G_OFFICIAL O2 ON O2.g_official ' +
        '= D.GLAVBUH,'
      '110609216=       G_FIRM_REKVIZIT F,'
      '110609217=       g_client C'
      '110609218= WHERE D.DOCS = :DOC_'
      '110609219=   AND D.g_firm = F.g_firm_rekvizit'
      '110609220=   AND D.G_CLIENT = C.g_client'
      '110609221=  into :num_,'
      '110609222=       :DOCS_DATE_,'
      '110609223=       :g_firm_,'
      '110609224=       :g_firm_address_,'
      '110609225=       :g_firm_account_,'
      '110609226=       :G_FIRM_BANK_,'
      '110609227=       :G_FIRM_OKPO_,'
      '110609228=       :G_FIRM_BIN_,'
      '110609229=       :g_firm_AND_ADDRESS_,'
      '110609230=       :g_client_,'
      '110609231=       :g_client_address_,'
      '110609232=       :g_client_account_,'
      '110609233=       :G_CLIENT_BIN_,'
      '110609234=       :G_CLIENT_AND_ADDRESS_,'
      '110609235=       :g_official_,'
      '110609236=       :G_OFFICIAL_ID_KIND_,'
      '110609237=       :G_OFFICIAL_ID_NUM_,'
      '110609238=       :G_OFFICIAL_ID_DATE_,'
      '110609239=       :G_OFFICIAL_ID_ISSUER_,'
      '110609240=       :APPOINTMENT_,'
      '110609241=       :RUKOVODITEL_,'
      '110609242=       :GLAVBUH_,'
      '110609243=       :note_,'
      '110609244=       :param1_,'
      '110609245=       :param2_,'
      '110609246=       :param3_,'
      '110609247=       :param4_,'
      '110609248=       :param5_,'
      '110609249=       :BL_;'
      '110609250='
      '110609251=  IF (DOC_TYPE_ <> 2) THEN BEGIN'
      
        '110609252=      -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086 +
        #1074' ('#1088#1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080 +
        #1079#1072#1094#1080#1080'"'
      
        '110609253=      -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052 +
        #1059' '#1063#1058#1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048 +
        #1058#1040#1045#1058#1057#1071
      
        '110609254=      SELECT REPLACE(CAST(SUM(ZD.SUMM) AS VARCHAR(10))' +
        ', '#39'.'#39', '#39','#39'),'
      '110609255=             SUM(ZD.AMOUNT),'
      
        '110609256=             (SELECT CURR_STR from CURRENCYSTR(SUM(ZD.' +
        'SUMM), :CURRENCY_))'
      '110609257=        FROM ZAKAZ Z,'
      '110609258=             ZAKAZ_DETAILS ZD'
      '110609259=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110609260=         AND Z.ZAKAZ = ZD.ZAKAZ'
      '110609261=        INTO :SUMM_,'
      '110609262=             :AMOUNT_,'
      '110609263=             :SUMM_STR_;'
      '110609264='
      '110609265=      FOR'
      '110609266=        SELECT :I,'
      '110609267=               G.NAME||DECODE(G.articul,'
      '110609268=                              NULL, '#39#39','
      '110609269=                              '#39#39', '#39#39','
      '110609270=                              '#39', '#1072#1088#1090'. '#39'||G.articul),'
      '110609271=               U.SHORT_NAME,'
      '110609272=               G.barcode,'
      '110609273=               CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '110609274=               REPLACE(CAST((ZD.PRICE - COALESCE(ZD.DI' +
        'SCOUNT_TENGE, 0)) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '110609275=               REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39 +
        '.'#39', '#39','#39'),'
      
        '110609276=               lpad(EXTRACT(DAY FROM Z.z_date), 2, '#39'0'#39 +
        ')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.z_date), 2, 0)||'#39'.'#39'||EXTRACT(Y' +
        'EAR FROM Z.z_date)'
      '110609277=          FROM ZAKAZ Z,'
      '110609278=               ZAKAZ_DETAILS ZD,'
      '110609279=               G_PRODUCT G,'
      '110609280=               G_UNIT U'
      '110609281=         WHERE Z.ZAKAZ = :ZAKAZ_'
      '110609282=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110609283=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110609284=           AND G.G_UNIT = U.G_UNIT'
      '110609285=        INTO :ROW_NUM,'
      '110609286=            :NAME,'
      '110609287=            :UNIT_NAME,'
      '110609288=            :BARCODE,'
      '110609289=            :AMOUNT,'
      '110609290=            :PRICE,'
      '110609291=            :SUMM,'
      '110609292=            :ZDATE'
      '110609293=      DO BEGIN'
      '110609294=        I = I + 1;'
      '110609295=        SUSPEND;'
      '110609296=      END'
      '110609297=  END'
      '110609298='
      '110609299=  -- '#1044#1054#1042#1045#1056#1050#1040
      '110609300=  ELSE BEGIN'
      
        '110609301=          -- '#1057#1053#1040#1063#1040#1051#1040' '#1059#1047#1053#1040#1070' '#1048#1058#1054#1043#1054#1042#1059#1070' '#1057#1059#1052#1052#1059', '#1063#1058#1054#1041#1067' '#1042#1067#1042#1045#1057 +
        #1058#1048' '#1045#1045' '#1057#1056#1040#1047#1059' '#1042' SUSPEND'
      
        '110609302=          POS_ = POSITION('#39'<amount_itog_val>'#39' IN BL_);' +
        '       --'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110609303=          POS2_ = POSITION('#39'</amount_itog_val>'#39' IN BL_' +
        ');     --'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110609304=          STR_  = SUBSTRING(BL_ FROM POS_+17 FOR POS2_' +
        ' - POS_-17);'
      
        '110609305=          SUMM_STR_ = STR_||'#39' ('#39'||(SELECT CURR_STR fro' +
        'm CURRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39')'#39'; -- -1 - '#1053 +
        #1045' '#1055#1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '110609306='
      '110609307=          WHILE (I > 0) DO BEGIN'
      '110609308=            ROW_NUM = I;'
      
        '110609309=            POS_ = POSITION('#39'<id>'#39' IN BL_);     --'#1055#1056#1054#1055 +
        #1059#1057#1050#1040#1070' '#1042#1057#1045', '#1048' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1061#1054#1046#1059' '#1050' ID'
      
        '110609310=            POS2_ = POSITION('#39'</id>'#39' IN BL_);     --'#1047#1040 +
        #1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110609311=            STR_ = SUBSTRING(BL_ FROM POS_+4 FOR POS2_' +
        ' - POS_-4);'
      '110609312=            g_product_ = CAST(STR_ AS INTEGER);'
      '110609313='
      
        '110609314=            POS_ = POSITION('#39'<name>'#39' IN BL_);       --' +
        #1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110609315=            POS2_ = POSITION('#39'</name>'#39' IN BL_);     --' +
        #1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110609316=            NAME = SUBSTRING(BL_ FROM POS_+6 FOR POS2_' +
        ' - POS_-6);'
      '110609317='
      
        '110609318=            POS_ = POSITION('#39'<amount>'#39' IN BL_);       ' +
        '--'#1054#1058#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110609319=            POS2_ = POSITION('#39'</amount>'#39' IN BL_);     ' +
        '--'#1047#1040#1050#1056#1067#1042#1040#1070#1065#1048#1049' '#1058#1045#1043
      
        '110609320=            STR_  = SUBSTRING(BL_ FROM POS_+8 FOR POS2' +
        '_ - POS_-8);'
      
        '110609321=            SUMM = STR_||'#39' ('#39'||(SELECT CURR_STR from C' +
        'URRENCYSTR(CAST(:STR_ AS NUMERIC(15,2)), -2))||'#39')'#39'; -- -1 - '#1053#1045' '#1055 +
        #1054#1050#1040#1047#1067#1042#1040#1058#1068' '#1042#1040#1051#1070#1058#1059' - '#1058#1045#1053#1043#1045' 00 '#1058#1048#1067#1053
      '110609322='
      '110609323=            SELECT U.short_name'
      '110609324=              FROM G_PRODUCT G, G_UNIT U'
      '110609325=             WHERE G.g_unit = U.g_unit'
      '110609326=               AND G.g_product = :G_PRODUCT_'
      '110609327=              INTO :UNIT_NAME;'
      '110609328='
      
        '110609329=            --'#1085#1072#1093#1086#1078#1091' '#1090#1077#1075', '#1079#1072#1082#1088#1099#1074#1072#1102#1097#1080#1081' '#1090#1077#1075' '#1090#1086#1074#1072#1088#1072', '#1080' '#1091#1076 +
        #1072#1083#1103#1102' '#1101#1090#1086#1090' '#1090#1086#1074#1072#1088' '#1080#1079' '#1089#1087#1080#1089#1082#1072
      '110609330=            I = I + 1;'
      '110609331=            POS_ = POSITION('#39'</tovar>'#39' IN BL_);'
      
        '110609332=            BL_ = SUBSTRING(BL_ FROM POS_ + 8 FOR char' +
        '_length(BL_)-POS_);'
      '110609333=            IF (POSITION('#39'<tovar>'#39' IN BL_) = 0) THEN'
      '110609334=              I = -1;'
      '110609335='
      '110609336=            SUSPEND;'
      '110609337=          END'
      '110609338=  END'
      '110609339='
      '110609340=WHEN ANY DO BEGIN'
      '110609341=    Err_code = -20500;'
      
        '110609342=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110609343=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110609344=  END'
      '110609345=end'
      '110609346=;'
      '110609347='
      '110609348=ALTER PROCEDURE P_REP_OSTATKI_ZAKAZ_NA_REAL('
      '110609349=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110609350=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110609351=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110609352=RETURNS ('
      '110609353=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110609354=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110609355=  AMOUNT TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '110609356=  SUMM TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      '110609357=  IS_CATEGORY INTEGER)'
      '110609358=AS'
      
        '110609359=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      '110609360=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      '110609361=BEGIN'
      '110609362=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110609363='
      '110609364=  FOR SELECT F.G_PRODUCT,'
      '110609365=             F.PATH'
      '110609366=        FROM P_REP_TREE F'
      
        '110609367=       WHERE (:G_CATEGORY_ CONTAINING '#39'~'#39'||F.G_PRODUCT' +
        '||'#39'~'#39' or :G_CATEGORY_ IS NULL)'
      '110609368=       AND EXISTS (SELECT 1'
      '110609369=                   FROM ZAKAZ_REAL_PARENT ZP,'
      '110609370=                        ZAKAZ_NA_REAL Z,'
      '110609371=                        G_PRODUCT P'
      
        '110609372=                  WHERE Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ' +
        '_REAL_PARENT'
      '110609373=                    AND Z.G_PRODUCT = P.G_PRODUCT'
      '110609374=                    AND P.G_PRODUCT_PAR = F.G_PRODUCT'
      '110609375=                    AND Z.IS_PAYED_ALL = 0'
      
        '110609376=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|ZP.G_TOCHKA||'#39'-'#39
      
        '110609377=                    AND (:G_PRODUCT_ CONTAINING '#39'~'#39'||P' +
        '.G_PRODUCT||'#39'~'#39' OR :G_PRODUCT_ IS NULL))'
      '110609378=       ORDER BY PATH'
      '110609379=       INTO :G_PRODUCT__,'
      '110609380=            :PATH_'
      '110609381=  DO BEGIN'
      '110609382=      FOR SELECT :PATH_,'
      '110609383=                 NULL,'
      '110609384=                 NULL,'
      '110609385=                 NULL,'
      '110609386=                 1'
      '110609387=            FROM RDB$DATABASE'
      '110609388=          UNION ALL'
      '110609389=          SELECT P.ARTICUL,'
      '110609390=                 P.NAME,'
      
        '110609391=                 SUM(Z.AMOUNT_ALL - Z.AMOUNT_PAYED - C' +
        'OALESCE(Z.AMOUNT_RETURNED, 0)) AMOUNT,'
      
        '110609392=                 SUM(Z.SUMM_ALL - Z.SUMM_PAYED - COALE' +
        'SCE(Z.SUMM_RETURNED, 0)) SUMM,'
      '110609393=                 0'
      '110609394=            FROM ZAKAZ_REAL_PARENT ZP,'
      '110609395=                 ZAKAZ_NA_REAL Z,'
      '110609396=                 G_PRODUCT P'
      
        '110609397=           WHERE Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_P' +
        'ARENT'
      '110609398=             AND Z.G_PRODUCT = P.G_PRODUCT'
      '110609399=             AND P.G_PRODUCT_PAR = :G_PRODUCT__'
      '110609400=             AND Z.IS_PAYED_ALL = 0'
      
        '110609401=             AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZP.G_T' +
        'OCHKA||'#39'-'#39
      
        '110609402=             AND (:G_PRODUCT_ CONTAINING '#39'~'#39'||P.G_PROD' +
        'UCT||'#39'~'#39' OR :G_PRODUCT_ IS NULL)'
      '110609403=           GROUP BY P.ARTICUL, P.NAME'
      '110609404=          ORDER BY 5 DESC, 2'
      
        '110609405=           INTO :ARTICUL, :NAME, :AMOUNT, :SUMM, :IS_C' +
        'ATEGORY'
      '110609406=      DO'
      '110609407=        SUSPEND;'
      '110609408=  END'
      '110609409=end'
      '110609410=;'
      '110609411='
      '110609412=ALTER PROCEDURE P_REP_OSTATOK_DENEG('
      '110609413=  DATE_ DATE,'
      '110609414=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110609415=RETURNS ('
      '110609416=  PERIOD_ VARCHAR(40),'
      '110609417=  KASSA_SUMM NUMERIC(15,2),'
      '110609418=  KASSA_BEZNAL NUMERIC(15,2),'
      '110609419=  KASSA_DOLG NUMERIC(15,2),'
      '110609420=  ERR_CODE INTEGER,'
      '110609421=  ERR_MSG VARCHAR(1024))'
      '110609422=AS'
      
        '110609423=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK' +
        '_DENEG'#39';'
      '110609424=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110609425=DECLARE VARIABLE KASSA_SUMM_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      
        '110609426=DECLARE VARIABLE KASSA_BEZNAL_ TYPE OF COLUMN SKLAD.SU' +
        'MM = 0;'
      
        '110609427=DECLARE VARIABLE KASSA_DOLG_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT = 0;'
      '110609428=BEGIN'
      '110609429='
      
        '110609430=  PERIOD_ = '#39#1047#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM DATE_), ' +
        '2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_), 2, 0)||'#39'.'#39'||EXTRAC' +
        'T(YEAR FROM DATE_);'
      '110609431='
      '110609432=  SELECT S."OUTPUT"'
      '110609433=    FROM KASSA_STATE S'
      
        '110609434=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-' +
        #39
      '110609435=     AND S.K_DATE = :DATE_'
      '110609436=    INTO KASSA_SUMM_;'
      '110609437='
      '110609438=  if (row_count = 0) then begin'
      '110609439=    SELECT S."OUTPUT"'
      '110609440=      FROM KASSA_STATE S'
      '110609441=     WHERE S.K_DATE = (select max(k_date)'
      '110609442=                         from kassa_state'
      
        '110609443=                        WHERE :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39'-'#39'||G_TOCHKA||'#39'-'#39')'
      
        '110609444=      AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      '110609445=      INTO KASSA_SUMM_;'
      '110609446=  end'
      '110609447='
      '110609448=  SELECT S."OUTPUT"'
      '110609449=    FROM KASSA_BEZNAL_STATE S'
      '110609450=   WHERE S.K_DATE = :DATE_'
      '110609451=    INTO KASSA_BEZNAL_;'
      '110609452='
      '110609453=  if (row_count = 0) then begin'
      '110609454=    SELECT S."OUTPUT"'
      '110609455=      FROM KASSA_BEZNAL_STATE S'
      '110609456=     WHERE S.K_DATE = (select max(k_date)'
      '110609457=                         from kassa_BEZNAL_state)'
      '110609458=      INTO KASSA_BEZNAL_;'
      '110609459=  end'
      '110609460='
      '110609461=  SELECT COALESCE(SUM(Z.SUMM - Z.SUMM_FACT), 0)'
      '110609462=    FROM ZAKAZ Z'
      
        '110609463=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-' +
        #39
      '110609464=     AND Z.is_spisanie = 0'
      '110609465=     AND Z.IS_PAYED_ALL = 0'
      '110609466=    INTO :KASSA_DOLG_;'
      '110609467='
      '110609468=  FOR'
      '110609469=  SELECT :KASSA_SUMM_, :KASSA_DOLG_, :KASSA_BEZNAL_'
      '110609470=    FROM RDB$DATABASE R'
      '110609471=    INTO :KASSA_SUMM, :KASSA_DOLG, :KASSA_BEZNAL'
      '110609472=  DO'
      '110609473=    SUSPEND;'
      '110609474='
      '110609475=WHEN ANY DO BEGIN'
      '110609476=    Err_code = -20500;'
      
        '110609477=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110609478=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110609479=  END'
      '110609480=end'
      '110609481=;'
      '110609482='
      '110609483=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110609484=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110609485=  INCLUDE_NOL_ INTEGER,'
      '110609486=  INCLUDE_FEW_ INTEGER,'
      '110609487=  SORT_BY_NAME_ INTEGER,'
      '110609488=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110609489=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110609490=RETURNS ('
      '110609491=  PERIOD_ VARCHAR(40),'
      '110609492=  ROW_NUM VARCHAR(15),'
      '110609493=  ARTICUL VARCHAR(1000),'
      '110609494=  BARCODE VARCHAR(30),'
      
        '110609495=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110609496=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110609497=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110609498=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110609499=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110609500=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110609501=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110609502=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110609503=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110609504=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110609505=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110609506=  TOVAR_NAME VARCHAR(250),'
      '110609507=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110609508=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110609509=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110609510=  ERR_CODE INTEGER,'
      '110609511=  ERR_MSG VARCHAR(1024))'
      '110609512=AS'
      
        '110609513=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110609514=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110609515=DECLARE VARIABLE I INTEGER = 1;'
      '110609516=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110609517=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110609518=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110609519=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110609520=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110609521=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110609522=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110609523=BEGIN'
      '110609524='
      
        '110609525=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110609526=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110609527='
      '110609528=  SELECT S.S_VALUE'
      '110609529=    FROM SYSTEM_SETUP S'
      '110609530=   WHERE S.SYSTEM_SETUP = 1'
      '110609531=    INTO :FORMULA_;'
      '110609532='
      '110609533=  FOR SELECT GP.PATH,'
      '110609534=             GP.G_PRODUCT'
      '110609535=        FROM P_REP_TREE GP'
      '110609536=       WHERE EXISTS (SELECT 1'
      '110609537=                       FROM G_PRODUCT'
      '110609538=                      WHERE IS_CATEGORY = 0'
      
        '110609539=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110609540=                    )'
      
        '110609541=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110609542=              OR'
      '110609543=              (:G_CATEGORY_ is NULL)'
      '110609544=             )'
      '110609545=       ORDER BY 1, 2'
      '110609546=       INTO :PATH_NAME_,'
      '110609547=            :G_PRODUCT_'
      '110609548=  DO BEGIN'
      
        '110609549=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110609550=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110609551=      SELECT COUNT(G.G_PRODUCT)'
      
        '110609552=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110609553=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110609554=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110609555=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110609556=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110609557=              OR'
      
        '110609558=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110609559=              or'
      
        '110609560=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110609561=             )'
      '110609562=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110609563=         AND ((EXISTS (SELECT 1'
      '110609564=                       FROM SKLAD S'
      '110609565=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110609566=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110609567=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110609568=              OR'
      '110609569=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110609570=        INTO :CNT_;'
      '110609571='
      '110609572=      IF (CNT_ > 0) THEN BEGIN'
      
        '110609573=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110609574=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110609575='
      
        '110609576=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110609577=                                              ARTICUL,'
      '110609578=                                              BARCODE,'
      
        '110609579=                                              NOMENCLA' +
        'TUR_NUM,'
      '110609580=                                              NAME,'
      
        '110609581=                                              UNIT_NAM' +
        'E,'
      '110609582=                                              PRICE,'
      
        '110609583=                                              VOLUME_P' +
        'RICE,'
      
        '110609584=                                              SKIDKA_P' +
        'RICE,'
      '110609585=                                              AMOUNT,'
      
        '110609586=                                              AMOUNT_R' +
        'ESERVE,'
      '110609587=                                              SUMM,'
      
        '110609588=                                              PRICE_SE' +
        'LF,'
      
        '110609589=                                              SORT_COL' +
        ','
      
        '110609590=                                              IS_CATEG' +
        'ORY,'
      '110609591=                                              NOTE,'
      
        '110609592=                                              CROSSCOD' +
        'E)'
      
        '110609593=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110609594=                 G.ARTICUL,'
      '110609595=                 G.BARCODE,'
      '110609596=                 G.NOMENCLATUR_NUM,'
      '110609597=                 G.NAME,'
      '110609598=                 U.SHORT_NAME,'
      '110609599=                 G.PRICE,'
      '110609600=                 G.VOLUME_PRICE,'
      '110609601=                 G.PRICE - GD.SKIDKA_SUM,'
      '110609602=                 COALESCE(S.AMOUNT, 0),'
      '110609603=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      '110609604=                 COALESCE(S.AMOUNT, 0) * G.PRICE,'
      '110609605=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110609606=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110609607=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110609608=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110609609=                  DECODE(:FORMULA_,'
      '110609610=                         0,'
      
        '110609611=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110609612=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110609613=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110609614=                                         SKLAD S'
      
        '110609615=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110609616=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110609617=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110609618=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110609619=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110609620=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC ROWS 1 TO 5) T),'
      '110609621=                         1,'
      '110609622=                         (SELECT S.PRICE'
      '110609623=                            FROM SKLAD S'
      
        '110609624=                           WHERE S.SKLAD = (SELECT MAX' +
        '(SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST' +
        ' = 1'
      
        '110609625=                                              FROM SKL' +
        'AD SS'
      
        '110609626=                                             WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39
      
        '110609627=                                               AND SS.' +
        'G_PRODUCT = G.G_PRODUCT'
      
        '110609628=                                               AND SS.' +
        'IS_LAST = 1)'
      '110609629=                         ))), 0) spr,'
      
        '110609630=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110609631=                 0'
      '110609632=                 ,G.NOTE'
      
        '110609633=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      
        '110609634=            FROM G_PRODUCT G LEFT OUTER JOIN G_DISCOUN' +
        'T GD ON G.G_PRODUCT = GD.G_PRODUCT'
      
        '110609635=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110609636=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110609637=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110609638=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110609639=             AND G.IS_CATEGORY = 0'
      '110609640=             AND G.is_active = 1'
      '110609641=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110609642=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110609643=                  OR'
      
        '110609644=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110609645=                  or'
      
        '110609646=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110609647=                 )'
      '110609648=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110609649=             AND ((EXISTS (SELECT 1'
      '110609650=                           FROM SKLAD S'
      
        '110609651=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110609652=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110609653=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110609654=                  OR'
      '110609655=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110609656=           ORDER BY 14;'
      '110609657=      END'
      '110609658=  END'
      '110609659='
      
        '110609660=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110609661='
      
        '110609662=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKIDKA_PRIC' +
        'E, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, ' +
        'IS_CATEGORY,'
      '110609663=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110609664=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110609665=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE,' +
        ' :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :S' +
        'UMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110609666=  DO BEGIN'
      '110609667=    I = I + 1;'
      '110609668=    SUSPEND;'
      '110609669=  END'
      '110609670='
      '110609671=     /*'
      '110609672=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110609673='
      '110609674=     SELECT :I,'
      
        '110609675=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110609676=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110609677=             U.SHORT_NAME UNIT_NAME,'
      '110609678=             SS.PRICE,'
      '110609679=             SS.VOLUME_PRICE,'
      '110609680=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110609681=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110609682=             SS.IS_CATEGORY'
      '110609683=        FROM (WITH RECURSIVE TREE'
      '110609684=              AS (SELECT T.G_PRODUCT,'
      '110609685=                       T.NAME AS ARTICUL,'
      
        '110609686=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110609687=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110609688=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110609689=                       T.IS_CATEGORY,'
      '110609690=                       NULL G_UNIT'
      '110609691=                  FROM G_PRODUCT T'
      '110609692=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110609693=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110609694=                UNION ALL'
      '110609695=                SELECT T.G_PRODUCT,'
      '110609696=                       DECODE(T. T.ARTICUL,'
      '110609697=                       T.NAME,'
      '110609698=                       T.PRICE,'
      '110609699=                       T.VOLUME_PRICE,'
      '110609700=                       T.IS_CATEGORY,'
      '110609701=                       T.G_UNIT'
      
        '110609702=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110609703=                 WHERE T.IS_ACTIVE = 1'
      '110609704=                )'
      '110609705=             SELECT * FROM TREE) SS'
      
        '110609706=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110609707=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110609708=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110609709=    INTO :ROW_NUM,'
      '110609710=        :ARTICUL,'
      '110609711=        :NAME,'
      '110609712=        :UNIT_NAME,'
      '110609713=        :PRICE,'
      '110609714=        :VOLUME_PRICE,'
      '110609715=        :SKIDKA_PRICE,'
      '110609716=        :AMOUNT,'
      '110609717=        :IS_CATEGORY'
      '110609718=    DO BEGIN'
      '110609719=      I = I + 1;'
      '110609720=      SUSPEND;'
      '110609721=    END  */'
      '110609722=WHEN ANY DO BEGIN'
      '110609723=    Err_code = -20500;'
      
        '110609724=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110609725=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110609726=  END'
      '110609727=end'
      '110609728=;'
      '110609729='
      '110609730=ALTER PROCEDURE P_REP_PRODUCTION_WAYBILL('
      '110609731=  OTHER_ TYPE OF COLUMN OTHER.OTHER,'
      '110609732=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110609733=  CURRENCY_ INTEGER)'
      '110609734=RETURNS ('
      '110609735=  NUMBER_STR_ VARCHAR(200),'
      '110609736=  ROW_NUM INTEGER,'
      '110609737=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110609738=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110609739=  AMOUNT TYPE OF COLUMN OTHER_DETAILS.AMOUNT,'
      '110609740=  PRICE_N TYPE OF COLUMN OTHER_DETAILS.COST_PRICE,'
      '110609741=  SUMM_N TYPE OF COLUMN OTHER_DETAILS.COST_PRICE,'
      '110609742=  AMOUNT_VSEGO_ TYPE OF COLUMN OTHER_DETAILS.AMOUNT,'
      '110609743=  SUMM_VSEGO_ NUMERIC(15,2),'
      '110609744=  SUMM_STR_ VARCHAR(500),'
      '110609745=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110609746=  PRODUCT_STR_ VARCHAR(500),'
      '110609747=  ERR_CODE NUMERIC(15,2),'
      '110609748=  ERR_MSG VARCHAR(1024))'
      '110609749=AS'
      '110609750=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1040'*/'
      
        '110609751=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRODUCT' +
        'ION_WAYBILL'#39';'
      '110609752=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110609753=DECLARE VARIABLE I INTEGER = 1;'
      
        '110609754=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110609755=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS' +
        '_SUMM;'
      '110609756=BEGIN'
      '110609757='
      
        '110609758=  SELECT '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||P.NAME||'#39'", '#1074' '#1082#1086#1083#1080#1095#1077 +
        #1089#1090#1074#1077' '#39'||CAST(S.amount AS INTEGER) ||'#39' '#39'||U.SHORT_NAME'
      '110609759=    FROM SKLAD_PARENT SP,'
      '110609760=         SKLAD S,'
      '110609761=         G_PRODUCT P,'
      '110609762=         G_UNIT U'
      '110609763=   WHERE SP.sklad = :SKLAD_'
      '110609764=     AND S.sklad_parent = SP.sklad'
      '110609765=     AND S.g_product = P.g_product'
      '110609766=     AND P.G_UNIT = U.g_unit'
      '110609767=    INTO :PRODUCT_STR_;'
      '110609768='
      
        '110609769=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.OTHER||'#39' '#1086#1090' '#39'||lpad(EXTRACT(' +
        'DAY FROM P.OP_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P.OP_' +
        'DATE), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.OP_DATE)'
      '110609770=    FROM OTHER P'
      '110609771=   WHERE P.OTHER = :OTHER_'
      '110609772=    INTO :NUMBER_STR_;'
      '110609773='
      
        '110609774=  SELECT SUM(S.amount) --REPLACE(CAST(SUM(S.amount) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '110609775=         ,SUM(CAST(S.amount * S.cost_price AS NUMERIC(' +
        '15,2)))  --,REPLACE(CAST(SUM(CAST(S.amount * S.cost_price AS NUM' +
        'ERIC(15,2))) AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '110609776=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.amou' +
        'nt * S.cost_price), :CURRENCY_))'
      '110609777=    FROM OTHER_DETAILS S'
      '110609778=   WHERE S.OTHER = :OTHER_'
      '110609779=   GROUP BY S.OTHER'
      '110609780=    INTO :AMOUNT_VSEGO_,'
      '110609781=         :SUMM_VSEGO_,'
      '110609782=         :summ_str_;'
      '110609783='
      '110609784=  SELECT NAME'
      '110609785=    FROM CUR_PARAMS'
      '110609786=   WHERE CUR_PARAMS = 1'
      '110609787=    INTO :G_OFFICIAL_FM_;'
      '110609788='
      '110609789=  FOR SELECT :I,'
      '110609790=             G.name,'
      '110609791=             U.short_name,'
      
        '110609792=             S.amount, --REPLACE(CAST(S.amount AS VARC' +
        'HAR(10)), '#39'.'#39', '#39','#39'),'
      
        '110609793=             S.COST_price, --REPLACE(CAST(S.COST_price' +
        ' AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '110609794=             CAST(S.amount * S.cost_price AS NUMERIC(1' +
        '5,2)) --REPLACE(CAST(CAST(S.amount * S.cost_price AS NUMERIC(15,' +
        '2)) AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      '110609795=        FROM OTHER_DETAILS S, G_PRODUCT G, G_UNIT U'
      '110609796=       WHERE S.OTHER = :OTHER_'
      '110609797=         AND S.g_product = G.g_product'
      '110609798=         AND G.g_unit = U.g_unit'
      '110609799=        INTO :ROW_NUM,'
      '110609800=            :NAME,'
      '110609801=            :SHORT_NAME,'
      '110609802=            :AMOUNT,'
      '110609803=            :PRICE_N,'
      '110609804=            :SUMM_N'
      '110609805=  DO BEGIN'
      '110609806=    I = I + 1;'
      '110609807=    SUSPEND;'
      '110609808=  END'
      '110609809=WHEN ANY DO BEGIN'
      '110609810=    Err_code = -20500;'
      
        '110609811=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110609812=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110609813=  END'
      '110609814=end'
      '110609815=;'
      '110609816='
      '110609817=ALTER PROCEDURE P_REP_PROFIT('
      '110609818=  DATE_BEGIN_ DATE,'
      '110609819=  DATE_END_ DATE,'
      '110609820=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110609821=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110609822=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110609823=RETURNS ('
      '110609824=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110609825=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110609826=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
      '110609827=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110609828=  SUMM_ALL_ NUMERIC(15,2),'
      '110609829=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110609830=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110609831=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110609832=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110609833=  PROFIT_ALL_ NUMERIC(15,2),'
      '110609834=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110609835=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      '110609836=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '110609837=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '110609838=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '110609839=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '110609840=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT' +
        '_NAME,'
      
        '110609841=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_P' +
        'AYMENT_TYPE,'
      
        '110609842=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYME' +
        'NT_NAME,'
      
        '110609843=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANI' +
        'E,'
      
        '110609844=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUC' +
        'T,'
      
        '110609845=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PR' +
        'ODUCT_PAR,'
      
        '110609846=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110609847=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110609848=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110609849=  AMOUNT MY_NUMERIC_5,'
      '110609850=  PRICE NUMERIC(15,2),'
      '110609851=  SUMM NUMERIC(15,2),'
      '110609852=  DISCOUNT_PERC NUMERIC(15,2),'
      '110609853=  DISCOUNT_SUMM NUMERIC(15,2),'
      '110609854=  NDS NUMERIC(15,2),'
      '110609855=  NDS_SUMM NUMERIC(15,2),'
      '110609856=  PRICE_SELF NUMERIC(15,2),'
      '110609857=  SUM_SELF NUMERIC(15,2),'
      '110609858=  PROFIT NUMERIC(15,2),'
      '110609859=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110609860=  ERR_CODE INTEGER,'
      '110609861=  ERR_MSG VARCHAR(1024))'
      '110609862=AS'
      '110609863=/*'
      '110609864='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110609865='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050 +
        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110609866='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110609867='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110609868='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110609869='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110609870='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110609871=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110609872=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110609873=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110609874='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110609875='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110609876=***'
      '110609877=*/'
      
        '110609878=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39 +
        ';'
      '110609879=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110609880=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110609881=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110609882=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110609883=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110609884=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110609885=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '110609886=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '110609887=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '110609888=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '110609889=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110609890=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '110609891=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '110609892=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ' +
        ';'
      
        '110609893=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_' +
        'TOCHKA;'
      
        '110609894=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DA' +
        'TE;'
      
        '110609895=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_' +
        'CLIENT;'
      
        '110609896=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLI' +
        'ENT.NAME;'
      
        '110609897=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110609898=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.NAME;'
      
        '110609899=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.O' +
        'SNOVANIE;'
      
        '110609900=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110609901=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      
        '110609902=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110609903=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110609904=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.PRICE;'
      
        '110609905=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110609906=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_PERC;'
      
        '110609907=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM;'
      
        '110609908=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS;'
      
        '110609909=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110609910=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.' +
        'PRICE;'
      
        '110609911=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110609912=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '110609913=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110609914=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_' +
        'RASHOD.NAME;'
      '110609915=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110609916=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.' +
        'DATE_RECEIPT;'
      
        '110609917=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '110609918=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110609919=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ';'
      '110609920=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110609921=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110609922=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110609923=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110609924=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110609925=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110609926=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      '110609927=BEGIN'
      
        '110609928=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110609929=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110609930='
      '110609931=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110609932=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110609933=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110609934='
      '110609935=  FOR SELECT GP.PATH,'
      '110609936=             GP.G_PRODUCT'
      '110609937=       FROM P_REP_TREE GP'
      '110609938=      WHERE EXISTS (SELECT 1'
      
        '110609939=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, ' +
        'G_PRODUCT G'
      
        '110609940=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '110609941=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110609942=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110609943=                       AND G.G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '110609944=                       AND Z.IS_SPISANIE = 0'
      '110609945=                       AND Z.is_reserve = 0'
      '110609946=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110609947=                       AND Z.Z_DATE BETWEEN :DATE_BEGI' +
        'N_ AND :DATE_END_'
      
        '110609948=                       AND COALESCE(Z.G_CLIENT, 0) = C' +
        'OALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046 +
        #1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110609949=                       AND COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110609950=                       )'
      '110609951=      ORDER BY 1, 2'
      '110609952=  INTO :RECCAT_NAME_,'
      '110609953=       :RECCAT_PRODUCT_'
      '110609954=  DO BEGIN'
      '110609955=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110609956=    insert into p_rep_profit_table'
      '110609957=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110609958=    values'
      
        '110609959=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME' +
        '_, 1);'
      '110609960='
      '110609961=    FOR SELECT Z.ZAKAZ,'
      '110609962=               Z.G_TOCHKA,'
      '110609963=               Z.Z_DATE,'
      '110609964=               Z.G_CLIENT,'
      '110609965=               C.NAME CLIENT_NAME,'
      '110609966=               Z.G_PAYMENT_TYPE,'
      '110609967=               P.NAME PAYMENT_NAME,'
      '110609968=               Z.OSNOVANIE,'
      '110609969=               G.G_PRODUCT,'
      '110609970=               G.G_PRODUCT_PAR,'
      '110609971=               G.NAME TOVAR_NAME,'
      '110609972=               ZD.AMOUNT,'
      '110609973=               ZD.PRICE,'
      '110609974=               ZD.SUMM,'
      '110609975=               ZD.DISCOUNT_PERC,'
      '110609976=               ZD.DISCOUNT_SUMM,'
      '110609977=               ZD.NDS,'
      '110609978=               ZD.NDS_SUMM,'
      '110609979=               COALESCE(ZD.COST_PRICE, 0)'
      
        '110609980=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z' +
        '.G_CLIENT = C.G_CLIENT,'
      '110609981=               ZAKAZ_DETAILS ZD,'
      '110609982=               G_PRODUCT G,'
      '110609983=               G_PAYMENT_TYPE P'
      
        '110609984=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110609985=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '110609986=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110609987=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110609988=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- ' +
        #1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110609989=           AND Z.IS_SPISANIE = 0                   -- ' +
        #1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '110609990=           AND Z.IS_RESERVE = 0                    -- ' +
        #1058#1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '110609991=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110609992=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110609993=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_C' +
        'LIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058 +
        #1067#1052
      
        '110609994=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESC' +
        'E(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110609995=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, Z' +
        'D.ZAKAZ_DETAILS, G.NAME'
      '110609996=    INTO :REC_ZAKAZ_,'
      '110609997=        :REC_G_TOCHKA_,'
      '110609998=        :REC_Z_DATE_,'
      '110609999=        :REC_G_CLIENT_,'
      '1106010000=        :REC_CLIENT_NAME_,'
      '1106010001=        :REC_G_PAYMENT_TYPE_,'
      '1106010002=        :REC_PAYMENT_NAME_,'
      '1106010003=        :REC_OSNOVANIE_,'
      '1106010004=        :REC_G_PRODUCT_,'
      '1106010005=        :REC_G_PRODUCT_PAR_,'
      '1106010006=        :REC_TOVAR_NAME_,'
      '1106010007=        :REC_AMOUNT_,'
      '1106010008=        :REC_PRICE_,'
      '1106010009=        :REC_SUMM_,'
      '1106010010=        :REC_DISCOUNT_PERC_,'
      '1106010011=        :REC_DISCOUNT_SUMM_,'
      '1106010012=        :REC_NDS_,'
      '1106010013=        :REC_NDS_SUMM_,'
      '1106010014=        :REC_PRICE_SELF_'
      '1106010015=    DO BEGIN'
      '1106010016=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '1106010017=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_' +
        'SUM_COST_;'
      '1106010018='
      '1106010019=      insert into p_rep_profit_table'
      
        '1106010020=        (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '1106010021=         osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '1106010022=         nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '1106010023=      values'
      '1106010024=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1106010025=        :REC_ZAKAZ_,'
      '1106010026=        :REC_g_tochka_,'
      
        '1106010027=        :REC_z_date_, :REC_g_client_, :REC_client_nam' +
        'e_, :REC_g_payment_type_, :REC_payment_name_,'
      '1106010028=         :REC_osnovanie_,'
      '1106010029=         :REC_g_product_,'
      '1106010030=         :REC_g_product_par_,'
      '1106010031=         :REC_tovar_name_,'
      '1106010032=         :REC_amount_,'
      '1106010033=         :REC_price_,'
      '1106010034=         :REC_summ_,'
      '1106010035=         :REC_discount_perc_,'
      '1106010036=         :REC_discount_summ_,'
      
        '1106010037=         :REC_nds_, :REC_nds_summ_, :REC_price_self_,' +
        ' :REC_SUM_COST_, :REC_profit_, 0);'
      '1106010038='
      
        '1106010039=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0' +
        ');'
      
        '1106010040=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_' +
        ', 0);'
      
        '1106010041=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1106010042=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0)' +
        ';'
      '1106010043=    END'
      '1106010044='
      '1106010045=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010046=    insert into p_rep_profit_table'
      
        '1106010047=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106010048=    values'
      
        '1106010049=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1106010050='
      '1106010051=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1106010052=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1106010053=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1106010054=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1106010055='
      '1106010056=    SUM_ZAKAZ_ = 0;'
      '1106010057=    SUM_COST_  = 0;'
      '1106010058=    NDS_SUMM_  = 0;'
      '1106010059=    PROFIT_    = 0;'
      '1106010060=  END'
      '1106010061='
      '1106010062=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1106010063=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1106010064=      insert into p_rep_profit_table'
      
        '1106010065=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1106010066=      values'
      
        '1106010067=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1106010068='
      
        '1106010069=  --*************************************************' +
        '****************************************'
      '1106010070=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1106010071=  ---------------------------------------------------' +
        '----'
      '1106010072=  SELECT COUNT(*)'
      
        '1106010073=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1106010074=          UNION ALL'
      
        '1106010075=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUM' +
        'M NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BE' +
        'ZNAL) K,'
      '1106010076=         G_PRIHOD_RASHOD G'
      
        '1106010077=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39 +
        '-'#39
      '1106010078=    AND K.ACTION = 1'
      
        '1106010079=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1106010080=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1106010081=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053 +
        #1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106010082=  INTO :CNT_;'
      '1106010083='
      '1106010084=  IF (CNT_ > 0) THEN BEGIN'
      '1106010085=    SUM_COST_  = 0;'
      '1106010086=    PROFIT_    = 0;'
      '1106010087='
      '1106010088=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010089=    INSERT INTO P_REP_PROFIT_TABLE'
      '1106010090=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1106010091=    VALUES'
      
        '1106010092=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39', ' +
        '1);'
      '1106010093='
      '1106010094=    FOR SELECT K.ACTION_DATE,'
      '1106010095=               K.SUMM,'
      
        '1106010096=               G.NAME||DECODE(K.G_PRIHOD_RASHOD, -1, ' +
        #39' ('#39'||K.NOTE||'#39')'#39', '#39#39')'
      
        '1106010097=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZ' +
        'NAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM KASSA'
      
        '1106010098=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39
      '1106010099=              UNION ALL'
      
        '1106010100=              SELECT KASSA_BEZNAL kassa, ACTION_DATE,' +
        ' SUMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA, NOTE FROM ka' +
        'ssa_beznal'
      
        '1106010101=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G' +
        '_TOCHKA||'#39'-'#39') k,'
      '1106010102=              G_PRIHOD_RASHOD G'
      '1106010103=        WHERE K.ACTION = 1'
      
        '1106010104=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1106010105=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1106010106=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)  ' +
        '  -- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106010107=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1106010108=    INTO :ACTION_DATE_,'
      '1106010109=         :SUMM_,'
      '1106010110=         :ACTION_NAME_'
      '1106010111=    DO BEGIN'
      '1106010112=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1106010113=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1106010114=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1106010115=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1106010116=        VALUES'
      
        '1106010117=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, 0,'
      
        '1106010118=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALE' +
        'SCE(:SUMM_, 0), 0);'
      '1106010119='
      '1106010120=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1106010121=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1106010122=    END'
      '1106010123='
      '1106010124=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1106010125=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1106010126=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1106010127=    insert into p_rep_profit_table'
      
        '1106010128=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106010129=    values'
      
        '1106010130=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1106010131=  END'
      '1106010132=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1106010133=  --*************************************************' +
        '****************************************'
      '1106010134='
      
        '1106010135=  --*************************************************' +
        '****************************************'
      '1106010136=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1106010137=  ---------------------------------------------------' +
        '----'
      '1106010138=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010139=  SELECT COUNT(*)'
      
        '1106010140=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZN' +
        'AL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1106010141=          UNION ALL'
      
        '1106010142=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUM' +
        'M NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BE' +
        'ZNAL) K,'
      '1106010143=         G_PRIHOD_RASHOD G'
      
        '1106010144=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA||'#39 +
        '-'#39
      '1106010145=    AND K.ACTION = 0'
      
        '1106010146=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1106010147=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1106010148=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056 +
        #1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106010149=  INTO :CNT_;'
      '1106010150='
      '1106010151=  IF (CNT_ > 0) THEN BEGIN'
      '1106010152=    PRIHOD_ALL_  = 0;'
      '1106010153=    PRIHOD_ALL_NAL_  = 0;'
      '1106010154=    PRIHOD_ALL_BEZNAL_  = 0;'
      '1106010155=    PROFIT_     = 0;'
      '1106010156='
      '1106010157=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010158=    INSERT INTO P_REP_PROFIT_TABLE'
      '1106010159=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1106010160=    VALUES'
      
        '1106010161=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39', ' +
        '1);'
      '1106010162='
      '1106010163=    FOR SELECT K.ACTION_DATE,'
      '1106010164=               K.NAL,'
      '1106010165=               K.BEZNAL,'
      '1106010166=               G.NAME'
      
        '1106010167=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0' +
        ' BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1106010168=               UNION ALL'
      
        '1106010169=               SELECT kassa_BEZNAL KASSA, ACTION_DATE' +
        ', 0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kas' +
        'sa_beznal) K,'
      '1106010170=              G_PRIHOD_RASHOD G'
      
        '1106010171=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCH' +
        'KA||'#39'-'#39
      '1106010172=          AND K.ACTION = 0'
      
        '1106010173=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '1106010174=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1106010175=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106010176=        ORDER BY K.ACTION_DATE, K.KASSA'
      '1106010177=    INTO :ACTION_DATE_,'
      '1106010178=         :SUMM_NAL_,'
      '1106010179=         :SUMM_BEZNAL_,'
      '1106010180=         :ACTION_NAME_'
      '1106010181=    DO BEGIN'
      '1106010182=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '1106010183=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SU' +
        'MM,'
      '1106010184=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1106010185=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFI' +
        'T, IS_HEAD)'
      '1106010186=        VALUES'
      
        '1106010187=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION' +
        '_DATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '1106010188=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNA' +
        'L_, 0);'
      '1106010189='
      
        '1106010190=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_' +
        ';'
      
        '1106010191=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUM' +
        'M_BEZNAL_;'
      
        '1106010192=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_' +
        'BEZNAL_;'
      
        '1106010193=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BE' +
        'ZNAL_;'
      '1106010194=    END'
      '1106010195='
      '1106010196=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1106010197=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1106010198=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1106010199=    insert into p_rep_profit_table'
      
        '1106010200=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106010201=    values'
      
        '1106010202=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1106010203=  END'
      '1106010204='
      '1106010205=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1106010206=  --*************************************************' +
        '****************************************'
      '1106010207='
      
        '1106010208=  --*************************************************' +
        '****************************************'
      '1106010209=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1106010210=  --*************************************************' +
        '****************************************'
      '1106010211=  SELECT COUNT(*)'
      '1106010212=    FROM ZAKAZ Z'
      
        '1106010213=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1106010214=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1106010215=     AND Z.IS_SPISANIE = 1'
      
        '1106010216=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1106010217=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106010218=  INTO :CNT_;'
      '1106010219='
      '1106010220=  IF (CNT_ > 0) THEN BEGIN'
      '1106010221=      SUM_ZAKAZ_ = 0;'
      '1106010222=      SUM_COST_  = 0;'
      '1106010223=      PROFIT_    = 0;'
      '1106010224='
      '1106010225=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010226=      insert into p_rep_profit_table'
      '1106010227=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106010228=      values'
      
        '1106010229=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1106010230='
      '1106010231=      FOR SELECT Z.ZAKAZ,'
      '1106010232=                 Z.G_TOCHKA,'
      '1106010233=                 Z.Z_DATE,'
      '1106010234=                 Z.G_CLIENT,'
      '1106010235=                 '#39#39' CLIENT_NAME,'
      '1106010236=                 Z.G_PAYMENT_TYPE,'
      '1106010237=                 '#39#39' PAYMENT_NAME,'
      '1106010238=                 Z.OSNOVANIE,'
      '1106010239=                 G.G_PRODUCT,'
      '1106010240=                 G.G_PRODUCT_PAR,'
      '1106010241=                 G.NAME TOVAR_NAME,'
      '1106010242=                 ZD.AMOUNT,'
      '1106010243=                 ZD.PRICE,'
      '1106010244=                 ZD.SUMM,'
      '1106010245=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '1106010246=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '1106010247=                 0 NDS, --ZD.NDS,'
      '1106010248=                 0 NDS_SUMM'
      
        '1106010249=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT' +
        ' G'
      
        '1106010250=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_T' +
        'OCHKA||'#39'-'#39
      '1106010251=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106010252=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1106010253=             AND Z.IS_SPISANIE = 1                   ' +
        ' -- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '1106010254=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106010255=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '1106010256=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:' +
        'G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '1106010257=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COAL' +
        'ESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '1106010258=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKA' +
        'Z_DETAILS'
      '1106010259=      INTO :REC_ZAKAZ_,'
      '1106010260=            :REC_G_TOCHKA_,'
      '1106010261=            :REC_Z_DATE_,'
      '1106010262=            :REC_G_CLIENT_,'
      '1106010263=            :REC_CLIENT_NAME_,'
      '1106010264=            :REC_G_PAYMENT_TYPE_,'
      '1106010265=            :REC_PAYMENT_NAME_,'
      '1106010266=            :REC_OSNOVANIE_,'
      '1106010267=            :REC_G_PRODUCT_,'
      '1106010268=            :REC_G_PRODUCT_PAR_,'
      '1106010269=            :REC_TOVAR_NAME_,'
      '1106010270=            :REC_AMOUNT_,'
      '1106010271=            :REC_PRICE_,'
      '1106010272=            :REC_SUMM_,'
      '1106010273=            :REC_DISCOUNT_PERC_,'
      '1106010274=            :REC_DISCOUNT_SUMM_,'
      '1106010275=            :REC_NDS_,'
      '1106010276=            :REC_NDS_SUMM_'
      '1106010277=      DO BEGIN'
      '1106010278=        -- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1106010279=        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053 +
        #1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044#1054
      '1106010280=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '1106010281=        REC_profit_   = -REC_SUMM_;'
      '1106010282='
      '1106010283=        insert into p_rep_profit_table'
      
        '1106010284=          (p_rep_profit_table, zakaz, g_tochka, z_dat' +
        'e, g_client, client_name, g_payment_type, payment_name,'
      
        '1106010285=           osnovanie, g_product, g_product_par, tovar' +
        '_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1106010286=           nds, nds_summ, price_self, sum_self, profi' +
        't, is_head)'
      '1106010287=        values'
      
        '1106010288=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZA' +
        'KAZ_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '1106010289=         :REC_osnovanie_, :REC_g_product_, :REC_g_pro' +
        'duct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_p' +
        'erc_, :REC_discount_summ_,'
      
        '1106010290=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC' +
        '_SUM_COST_, :REC_profit_, 0);'
      '1106010291='
      
        '1106010292=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COS' +
        'T_, 0);'
      
        '1106010293=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_,' +
        ' 0);'
      '1106010294=      END'
      '1106010295='
      '1106010296=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010297=      insert into p_rep_profit_table'
      
        '1106010298=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1106010299=      values'
      
        '1106010300=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', ' +
        '0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1106010301='
      '1106010302=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1106010303=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1106010304=  END'
      '1106010305=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1106010306=  --*************************************************' +
        '****************************************'
      '1106010307='
      
        '1106010308=  --*************************************************' +
        '****************************************'
      '1106010309=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1106010310=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1106010311=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1106010312=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1106010313='
      
        '1106010314=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1106010315=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1106010316=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1106010317=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      
        '1106010318=  --*************************************************' +
        '****************************************'
      '1106010319=  SELECT COUNT(*)'
      '1106010320=    FROM SKLAD S'
      
        '1106010321=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      
        '1106010322=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1106010323=     AND S.IS_VOZVRAT IN (1,2)'
      
        '1106010324=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S' +
        '.G_CLIENT, 0))'
      
        '1106010325=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_' +
        ', COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1106010326=  INTO :CNT_;'
      '1106010327='
      '1106010328=  IF (CNT_ > 0) THEN BEGIN'
      '1106010329=    SUM_ZAKAZ_ = 0;'
      '1106010330=    PROFIT_    = 0;'
      '1106010331=    SUM_COST_  = 0;'
      '1106010332='
      '1106010333=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010334=    insert into p_rep_profit_table'
      '1106010335=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106010336=    values'
      
        '1106010337=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054 +
        #1042#1040#1056#1040#39', 1);'
      '1106010338='
      '1106010339=    FOR SELECT S.DATE_RECEIPT,'
      '1106010340=               S.G_PRODUCT,'
      '1106010341=               G.NAME TOVAR_NAME,'
      '1106010342=               S.AMOUNT,'
      '1106010343=               S.PRICE,'
      '1106010344=               S.SUMM,'
      '1106010345=               SP.G_TOCHKA'
      '1106010346=         FROM SKLAD_PARENT SP,'
      '1106010347=              SKLAD S,'
      '1106010348=              G_PRODUCT G'
      
        '1106010349=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOC' +
        'HKA||'#39'-'#39
      
        '1106010350=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1106010351=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '1106010352=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COAL' +
        'ESCE(S.G_CLIENT, 0))'
      
        '1106010353=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT' +
        '_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1106010354=          AND SP.SKLAD = S.SKLAD_PARENT'
      '1106010355=          AND S.G_PRODUCT = G.G_PRODUCT'
      '1106010356=        ORDER BY 1'
      '1106010357=    INTO :V_DATE_RECEIPT_,'
      '1106010358=         :V_G_PRODUCT_,'
      '1106010359=         :V_TOVAR_NAME_,'
      '1106010360=         :V_AMOUNT_,'
      '1106010361=         :V_PRICE_,'
      '1106010362=         :V_SUMM_,'
      '1106010363=         :REC_G_TOCHKA_'
      '1106010364=    DO BEGIN'
      '1106010365=      --REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '1106010366=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;  ' +
        '  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054 +
        #1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' ' +
        #1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1106010367='
      '1106010368='
      '1106010369=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '1106010370=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR' +
        '_NAME, AMOUNT, PRICE, SUMM,'
      '1106010371=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1106010372=         NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '1106010373=      VALUES'
      
        '1106010374=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_R' +
        'ECEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, 0 /*:REC_PRI' +
        'CE_SELF_*/, 0/*:REC_SUM_COST_*/,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051 +
        #1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', ' +
        #1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1106010375=         0, 0, 0, 0, :V_PRICE_, :V_SUMM_, :REC_profit' +
        '_, 0);'
      '1106010376='
      
        '1106010377=      --SUM_COST_  = SUM_COST_  + COALESCE(REC_SUM_CO' +
        'ST_, 0);     -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1106010378=      SUM_COST_ = 0;'
      '1106010379=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      
        '1106010380=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0)' +
        ';'
      '1106010381=    END'
      '1106010382='
      '1106010383='
      '1106010384=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_COST_;'
      '1106010385=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1106010386=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1106010387='
      '1106010388=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010389=    insert into p_rep_profit_table'
      
        '1106010390=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106010391=    values'
      
        '1106010392=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '1106010393=  END'
      '1106010394=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1106010395=  --*************************************************' +
        '****************************************'
      '1106010396='
      
        '1106010397=  --*************************************************' +
        '****************************************'
      
        '1106010398=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045 +
        #1051#1054' '#1052#1045#1057#1058#1054
      '1106010399=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '1106010400=  --*************************************************' +
        '****************************************'
      '1106010401=  /*SELECT COUNT(*)'
      '1106010402=    FROM ZAKAZ Z'
      
        '1106010403=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1106010404=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1106010405=     AND Z.IS_SPISANIE = 4'
      
        '1106010406=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1106010407=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106010408=  INTO :CNT_;'
      '1106010409='
      '1106010410=  IF (CNT_ > 0) THEN BEGIN'
      '1106010411=      SUM_ZAKAZ_ = 0;'
      '1106010412=      SUM_COST_  = 0;'
      '1106010413=      PROFIT_    = 0;'
      '1106010414=      NDS_SUMM_  = 0;'
      '1106010415='
      '1106010416=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010417=      insert into p_rep_profit_table'
      '1106010418=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106010419=      values'
      
        '1106010420=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '1106010421='
      '1106010422=      FOR SELECT Z.ZAKAZ,'
      '1106010423=               Z.G_TOCHKA,'
      '1106010424=               Z.Z_DATE,'
      '1106010425=               Z.G_CLIENT,'
      '1106010426=               C.NAME CLIENT_NAME,'
      '1106010427=               Z.G_PAYMENT_TYPE,'
      '1106010428=               P.NAME PAYMENT_NAME,'
      '1106010429=               Z.OSNOVANIE,'
      '1106010430=               G.G_PRODUCT,'
      '1106010431=               G.G_PRODUCT_PAR,'
      '1106010432=               G.NAME TOVAR_NAME,'
      '1106010433=               ZD.AMOUNT,'
      '1106010434=               ZD.PRICE,'
      '1106010435=               ZD.SUMM,'
      '1106010436=               ZD.DISCOUNT_PERC,'
      '1106010437=               ZD.DISCOUNT_SUMM,'
      '1106010438=               ZD.NDS,'
      '1106010439=               ZD.NDS_SUMM,'
      '1106010440=               COALESCE(ZD.COST_PRICE, 0)'
      
        '1106010441=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON ' +
        'Z.G_CLIENT = C.G_CLIENT,'
      '1106010442=               ZAKAZ_DETAILS ZD,'
      '1106010443=               G_PRODUCT G,'
      '1106010444=               G_PAYMENT_TYPE P'
      
        '1106010445=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1106010446=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106010447=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106010448=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '1106010449=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1106010450=           AND Z.IS_SPISANIE = 4                   --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1106010451=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106010452=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1106010453=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '1106010454=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '1106010455=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ' +
        'ZD.ZAKAZ_DETAILS, G.NAME'
      '1106010456=    INTO :REC_ZAKAZ_,'
      '1106010457=        :REC_G_TOCHKA_,'
      '1106010458=        :REC_Z_DATE_,'
      '1106010459=        :REC_G_CLIENT_,'
      '1106010460=        :REC_CLIENT_NAME_,'
      '1106010461=        :REC_G_PAYMENT_TYPE_,'
      '1106010462=        :REC_PAYMENT_NAME_,'
      '1106010463=        :REC_OSNOVANIE_,'
      '1106010464=        :REC_G_PRODUCT_,'
      '1106010465=        :REC_G_PRODUCT_PAR_,'
      '1106010466=        :REC_TOVAR_NAME_,'
      '1106010467=        :REC_AMOUNT_,'
      '1106010468=        :REC_PRICE_,'
      '1106010469=        :REC_SUMM_,'
      '1106010470=        :REC_DISCOUNT_PERC_,'
      '1106010471=        :REC_DISCOUNT_SUMM_,'
      '1106010472=        :REC_NDS_,'
      '1106010473=        :REC_NDS_SUMM_,'
      '1106010474=        :REC_PRICE_SELF_'
      '1106010475=    DO BEGIN'
      '1106010476=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '1106010477=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '1106010478='
      '1106010479=      insert into p_rep_profit_table'
      
        '1106010480=        (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '1106010481=         osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '1106010482=         nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '1106010483=      values'
      '1106010484=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1106010485=        :REC_ZAKAZ_,'
      '1106010486=        :REC_g_tochka_,'
      
        '1106010487=        :REC_z_date_, :REC_g_client_, :REC_client_nam' +
        'e_, :REC_g_payment_type_, :REC_payment_name_,'
      '1106010488=         :REC_osnovanie_,'
      '1106010489=         :REC_g_product_,'
      '1106010490=         :REC_g_product_par_,'
      '1106010491=         :REC_tovar_name_,'
      '1106010492=         :REC_amount_,'
      '1106010493=         :REC_price_,'
      '1106010494=         :REC_summ_,'
      '1106010495=         :REC_discount_perc_,'
      '1106010496=         :REC_discount_summ_,'
      
        '1106010497=         :REC_nds_, :REC_nds_summ_, :REC_price_self_,' +
        ' :REC_SUM_COST_, :REC_profit_, 0);'
      '1106010498='
      
        '1106010499=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0' +
        ');'
      
        '1106010500=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_' +
        ', 0);'
      
        '1106010501=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1106010502=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0)' +
        ';'
      '1106010503=    END'
      '1106010504='
      '1106010505=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010506=    insert into p_rep_profit_table'
      
        '1106010507=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106010508=    values'
      
        '1106010509=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1106010510='
      '1106010511=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1106010512=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '1106010513=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1106010514=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1106010515='
      '1106010516=    SUM_ZAKAZ_ = 0;'
      '1106010517=    SUM_COST_  = 0;'
      '1106010518=    NDS_SUMM_  = 0;'
      '1106010519=    PROFIT_    = 0;'
      '1106010520=  END'
      '1106010521=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '1106010522=  --*************************************************' +
        '****************************************'
      '1106010523='
      
        '1106010524=  --*************************************************' +
        '****************************************'
      
        '1106010525=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1106010526=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1106010527=  --*************************************************' +
        '****************************************'
      '1106010528=  SELECT COUNT(*)'
      '1106010529=    FROM ZAKAZ S'
      
        '1106010530=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      '1106010531=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1106010532=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106010533=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1106010534=     AND S.IS_SPISANIE = 2'
      '1106010535=  INTO :CNT_;'
      '1106010536='
      '1106010537=  IF (CNT_ > 0) THEN BEGIN'
      '1106010538=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010539=      insert into p_rep_profit_table'
      '1106010540=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106010541=      values'
      
        '1106010542=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1106010543='
      '1106010544=      SUM_ZAKAZ_ = 0;'
      '1106010545=      SUM_COST_  = 0;'
      '1106010546=      NDS_SUMM_  = 0;'
      '1106010547=      PROFIT_    = 0;'
      '1106010548=      FOR SELECT GP.NAME,'
      '1106010549=                 GP.G_PRODUCT'
      '1106010550=           FROM G_PRODUCT GP'
      '1106010551=          WHERE IS_CATEGORY = 1'
      '1106010552=            AND EXISTS (SELECT 1'
      
        '1106010553=                          FROM ZAKAZ Z, ZAKAZ_DETAILS' +
        ' ZD, G_PRODUCT G'
      
        '1106010554=                         WHERE :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1106010555=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '1106010556=                           AND ZD.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1106010557=                           AND G.G_PRODUCT_PAR = GP.G' +
        '_PRODUCT'
      '1106010558=                           AND Z.IS_SPISANIE = 2'
      '1106010559=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106010560=                           AND Z.Z_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '1106010561=                           AND COALESCE(Z.G_CLIENT, 0' +
        ') = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053 +
        #1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106010562=                           AND COALESCE(Z.G_PAYMENT_T' +
        'YPE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0))'
      '1106010563=                           )'
      '1106010564=          ORDER BY 1'
      '1106010565=      INTO :RECCAT_NAME_,'
      '1106010566=           :RECCAT_PRODUCT_'
      '1106010567=      DO BEGIN'
      '1106010568=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010569=        insert into p_rep_profit_table'
      '1106010570=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106010571=        values'
      
        '1106010572=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT' +
        '_NAME_, 1);'
      '1106010573='
      '1106010574=        FOR SELECT Z.ZAKAZ,'
      '1106010575=                   Z.G_TOCHKA,'
      '1106010576=                   Z.Z_DATE,'
      '1106010577=                   Z.G_CLIENT,'
      '1106010578=                   C.NAME CLIENT_NAME,'
      '1106010579=                   Z.G_PAYMENT_TYPE,'
      '1106010580=                   P.NAME PAYMENT_NAME,'
      '1106010581=                   Z.OSNOVANIE,'
      '1106010582=                   G.G_PRODUCT,'
      '1106010583=                   G.G_PRODUCT_PAR,'
      '1106010584=                   G.NAME TOVAR_NAME,'
      '1106010585=                   ZD.AMOUNT,'
      '1106010586=                   ZD.PRICE,'
      '1106010587=                   ZD.SUMM,'
      '1106010588=                   ZD.DISCOUNT_PERC,'
      '1106010589=                   ZD.DISCOUNT_SUMM,'
      '1106010590=                   ZD.NDS,'
      '1106010591=                   ZD.NDS_SUMM,'
      '1106010592=                   ZD.COST_PRICE'
      
        '1106010593=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C' +
        ' ON Z.G_CLIENT = C.G_CLIENT,'
      '1106010594=                   ZAKAZ_DETAILS ZD,'
      '1106010595=                   G_PRODUCT G,'
      '1106010596=                   G_PAYMENT_TYPE P'
      
        '1106010597=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G' +
        '_TOCHKA||'#39'-'#39
      '1106010598=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106010599=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1106010600=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYP' +
        'E'
      
        '1106010601=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_' +
        '  -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1106010602=               AND Z.IS_SPISANIE = 2                 ' +
        '   -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '1106010603=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106010604=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1106010605=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE' +
        '(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '1106010606=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = CO' +
        'ALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '1106010607=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAK' +
        'AZ, ZD.ZAKAZ_DETAILS, G.NAME'
      '1106010608=        INTO :REC_ZAKAZ_,'
      '1106010609=            :REC_G_TOCHKA_,'
      '1106010610=            :REC_Z_DATE_,'
      '1106010611=            :REC_G_CLIENT_,'
      '1106010612=            :REC_CLIENT_NAME_,'
      '1106010613=            :REC_G_PAYMENT_TYPE_,'
      '1106010614=            :REC_PAYMENT_NAME_,'
      '1106010615=            :REC_OSNOVANIE_,'
      '1106010616=            :REC_G_PRODUCT_,'
      '1106010617=            :REC_G_PRODUCT_PAR_,'
      '1106010618=            :REC_TOVAR_NAME_,'
      '1106010619=            :REC_AMOUNT_,'
      '1106010620=            :REC_PRICE_,'
      '1106010621=            :REC_SUMM_,'
      '1106010622=            :REC_DISCOUNT_PERC_,'
      '1106010623=            :REC_DISCOUNT_SUMM_,'
      '1106010624=            :REC_NDS_,'
      '1106010625=            :REC_NDS_SUMM_,'
      '1106010626=            :REC_PRICE_SELF_'
      '1106010627=        DO BEGIN'
      
        '1106010628=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SEL' +
        'F_;'
      
        '1106010629=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ -' +
        ' REC_NDS_SUMM_;'
      '1106010630='
      '1106010631=          insert into p_rep_profit_table'
      
        '1106010632=            (p_rep_profit_table, zakaz, g_tochka, z_d' +
        'ate, g_client, client_name, g_payment_type, payment_name,'
      
        '1106010633=             osnovanie, g_product, g_product_par, tov' +
        'ar_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1106010634=             nds, nds_summ, price_self, sum_self, pro' +
        'fit, is_head)'
      '1106010635=          values'
      '1106010636=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1106010637=            :REC_ZAKAZ_,'
      '1106010638=            :REC_g_tochka_,'
      
        '1106010639=            :REC_z_date_, :REC_g_client_, :REC_client' +
        '_name_, :REC_g_payment_type_, :REC_payment_name_,'
      '1106010640=             :REC_osnovanie_,'
      '1106010641=             :REC_g_product_,'
      '1106010642=             :REC_g_product_par_,'
      '1106010643=             :REC_tovar_name_,'
      '1106010644=             :REC_amount_,'
      '1106010645=             :REC_price_,'
      '1106010646=             :REC_summ_,'
      '1106010647=             :REC_discount_perc_,'
      '1106010648=             :REC_discount_summ_,'
      
        '1106010649=             :REC_nds_, :REC_nds_summ_, :REC_price_se' +
        'lf_, :REC_SUM_COST_, :REC_profit_, 0);'
      '1106010650='
      
        '1106010651=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM' +
        '_, 0);'
      
        '1106010652=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_C' +
        'OST_, 0);'
      
        '1106010653=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_S' +
        'UMM_, 0);'
      
        '1106010654=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_' +
        ', 0);'
      '1106010655=        END'
      '1106010656='
      '1106010657=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106010658=        insert into p_rep_profit_table'
      
        '1106010659=          (p_rep_profit_table, tovar_name, summ, sum_' +
        'self, NDS_SUMM, profit, is_head)'
      '1106010660=        values'
      
        '1106010661=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1106010662='
      
        '1106010663=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ' +
        '_;'
      '1106010664=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '1106010665=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '1106010666=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '1106010667='
      '1106010668=        SUM_ZAKAZ_ = 0;'
      '1106010669=        SUM_COST_  = 0;'
      '1106010670=        NDS_SUMM_  = 0;'
      '1106010671=        PROFIT_    = 0;'
      '1106010672=      END'
      '1106010673='
      '1106010674=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1106010675=      insert into p_rep_profit_table'
      
        '1106010676=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1106010677=      values'
      
        '1106010678=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '1106010679='
      
        '1106010680=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REA' +
        'L_;'
      
        '1106010681=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REA' +
        'L_;'
      
        '1106010682=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_' +
        ';'
      '1106010683=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '1106010684=  END'
      '1106010685=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106010686=  --*************************************************' +
        '****************************************'
      '1106010687=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '1106010688='
      '1106010689=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1106010690=  insert into p_rep_profit_table'
      '1106010691=    (p_rep_profit_table, is_head)'
      '1106010692=  values'
      '1106010693=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1106010694='
      '1106010695=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1106010696=  insert into p_rep_profit_table'
      
        '1106010697=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1106010698=  values'
      
        '1106010699=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1106010700='
      '1106010701=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1106010702=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1106010703=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1106010704=         SUM(Z.SUMM_BONUS)'
      '1106010705=    FROM ZAKAZ Z'
      
        '1106010706=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1106010707=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1106010708=     AND Z.IS_RESERVE = 0'
      '1106010709=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1106010710=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106010711=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106010712=    INTO :SUMM_CASH_ALL_,'
      '1106010713=         :SUMM_NONCASH_ALL_,'
      '1106010714=         :SUMM_BONUS_ALL_;'
      '1106010715='
      '1106010716=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '1106010717=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '1106010718=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1106010719='
      '1106010720=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1106010721='
      
        '1106010722=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1106010723=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1106010724='
      '1106010725=/*  insert into p_rep_profit_table'
      
        '1106010726=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1106010727=  values'
      
        '1106010728=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1106010729='
      '1106010730=  insert into p_rep_profit_table'
      '1106010731=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1106010732=  values'
      
        '1106010733=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1106010734='
      '1106010735=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1106010736=    SELECT G.NAME'
      '1106010737=      FROM G_CLIENT G'
      '1106010738=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1106010739=    INTO :CLIENT_NAME_;'
      '1106010740=  ELSE'
      '1106010741=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1106010742='
      '1106010743=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1106010744=    SELECT G.NAME'
      '1106010745=      FROM G_PAYMENT_TYPE G'
      '1106010746=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1106010747=    INTO :PAYMENT_NAME_;'
      '1106010748=  ELSE'
      '1106010749=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1106010750='
      '1106010751=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1106010752=        P.ZAKAZ,'
      '1106010753=        P.G_TOCHKA,'
      '1106010754=        P.Z_DATE,'
      '1106010755=        P.G_CLIENT,'
      '1106010756=        P.CLIENT_NAME,'
      '1106010757=        P.G_PAYMENT_TYPE,'
      '1106010758=        P.PAYMENT_NAME,'
      '1106010759=        P.OSNOVANIE,'
      '1106010760=        P.G_PRODUCT,'
      '1106010761=        P.G_PRODUCT_PAR,'
      '1106010762=        P.TOVAR_NAME,'
      '1106010763=        G.ARTICUL,'
      '1106010764=        G.NOMENCLATUR_NUM,'
      '1106010765=        P.AMOUNT,'
      
        '1106010766=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1106010767=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1106010768=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1106010769=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1106010770=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1106010771=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1106010772=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1106010773=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1106010774=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1106010775=        P.IS_HEAD'
      
        '1106010776=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1106010777=    ORDER BY 1'
      '1106010778=  INTO :P_REP_PROFIT_TABLE,'
      '1106010779=       :ZAKAZ,'
      '1106010780=       :G_TOCHKA,'
      '1106010781=       :Z_DATE,'
      '1106010782=       :G_CLIENT,'
      '1106010783=       :CLIENT_NAME,'
      '1106010784=       :G_PAYMENT_TYPE,'
      '1106010785=       :PAYMENT_NAME,'
      '1106010786=       :OSNOVANIE,'
      '1106010787=       :G_PRODUCT,'
      '1106010788=       :G_PRODUCT_PAR,'
      '1106010789=       :TOVAR_NAME,'
      '1106010790=       :ARTICUL,'
      '1106010791=       :NOMENCLATUR_NUM,'
      '1106010792=       :AMOUNT,'
      '1106010793=       :PRICE,'
      '1106010794=       :SUMM,'
      '1106010795=       :DISCOUNT_PERC,'
      '1106010796=       :DISCOUNT_SUMM,'
      '1106010797=       :NDS,'
      '1106010798=       :NDS_SUMM,'
      '1106010799=       :PRICE_SELF,'
      '1106010800=       :SUM_SELF,'
      '1106010801=       :PROFIT,'
      '1106010802=       :IS_HEAD'
      '1106010803=  DO'
      '1106010804=    suspend;'
      '1106010805='
      '1106010806=WHEN ANY DO BEGIN'
      '1106010807=    Err_code = -20500;'
      
        '1106010808=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106010809=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106010810=  END'
      '1106010811=end'
      '1106010812=;'
      '1106010813='
      '1106010814=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '1106010815=  DATE_BEGIN_ DATE,'
      '1106010816=  DATE_END_ DATE,'
      '1106010817=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1106010818=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      '1106010819=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106010820=RETURNS ('
      '1106010821=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1106010822=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '1106010823=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SU' +
        'MM,'
      '1106010824=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1106010825=  SUMM_ALL_ NUMERIC(15,2),'
      '1106010826=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1106010827=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1106010828=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1106010829=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1106010830=  PROFIT_ALL_ NUMERIC(15,2),'
      '1106010831=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1106010832=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABL' +
        'E.P_REP_PROFIT_TABLE,'
      
        '1106010833=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_' +
        'NAME,'
      '1106010834=  SUMM NUMERIC(15,2),'
      '1106010835=  NDS_SUMM NUMERIC(15,2),'
      '1106010836=  SUM_SELF NUMERIC(15,2),'
      '1106010837=  PROFIT NUMERIC(15,2),'
      '1106010838=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1106010839=  ERR_CODE INTEGER,'
      '1106010840=  ERR_MSG VARCHAR(1024))'
      '1106010841=AS'
      '1106010842=/*'
      '1106010843='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1106010844='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1106010845='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1106010846='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1106010847='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1106010848='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1106010849='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1106010850=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1106010851=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1106010852=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1106010853='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1106010854='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1106010855=*/'
      
        '1106010856=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT' +
        #39';'
      '1106010857=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106010858=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1106010859=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1106010860=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1106010861=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1106010862=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1106010863=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1106010864=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1106010865=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM;'
      
        '1106010866=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.NDS_SUMM;'
      
        '1106010867=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.S' +
        'UMM;'
      '1106010868=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '1106010869=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '1106010870=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1106010871=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059 +
        #1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1106010872=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /' +
        '* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1106010873=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0' +
        '; /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '1106010874=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1106010875=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      '1106010876=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '1106010877=BEGIN'
      
        '1106010878=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_T' +
        'ABLE = P_REP_PROFIT_TABLE;'
      '1106010879=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1106010880='
      '1106010881=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '1106010882=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '1106010883=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '1106010884='
      '1106010885=  FOR SELECT SUM(ZD.SUMM)'
      '1106010886=           ,TR.PATH'
      '1106010887=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1106010888=           ,SUM(ZD.nds_summ)'
      '1106010889=      FROM ZAKAZ Z,'
      '1106010890=           ZAKAZ_DETAILS ZD,'
      '1106010891=           G_PRODUCT GP,'
      '1106010892=           P_REP_TREE TR'
      
        '1106010893=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1106010894=       AND Z.IS_SPISANIE = 0'
      '1106010895=       AND Z.IS_RESERVE = 0'
      '1106010896=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106010897=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1106010898=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106010899=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106010900=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1106010901=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106010902=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106010903=     GROUP BY TR.PATH'
      '1106010904=     ORDER BY TR.PATH'
      
        '1106010905=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, ' +
        'NDS_SUMM_'
      '1106010906=  DO BEGIN'
      '1106010907=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '1106010908='
      '1106010909=    insert into p_rep_profit_table'
      
        '1106010910=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1106010911=    values'
      '1106010912=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1106010913=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :S' +
        'UM_COST_, :PROFIT_, 0);'
      '1106010914='
      '1106010915=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1106010916=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1106010917=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1106010918=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1106010919=  END'
      '1106010920='
      '1106010921=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1106010922=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL' +
        '_ + PROFIT_ALL_) > 0) then'
      '1106010923=      insert into p_rep_profit_table'
      
        '1106010924=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1106010925=      values'
      
        '1106010926=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '1106010927='
      
        '1106010928=  --*************************************************' +
        '****************************************'
      '1106010929=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '1106010930=  ---------------------------------------------------' +
        '----'
      '1106010931=  IS_FIRST_ = 1;'
      '1106010932=  SUM_COST_ = 0;'
      '1106010933=  PROFIT_   = 0;'
      '1106010934='
      '1106010935=  FOR SELECT G.NAME,'
      '1106010936=             SUM(K.SUMM)'
      
        '1106010937=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRI' +
        'HOD_RASHOD, G_TOCHKA FROM KASSA'
      '1106010938=              UNION ALL'
      
        '1106010939=              SELECT ACTION_DATE, SUMM NAL, ACTION, G' +
        '_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1106010940=             G_PRIHOD_RASHOD G'
      
        '1106010941=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1106010942=        AND K.ACTION = 1'
      
        '1106010943=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1106010944=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1106010945=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    ' +
        '-- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106010946=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1106010947=        INTO :REC_TOVAR_NAME_'
      '1106010948=             ,:SUMM_'
      '1106010949=  DO BEGIN'
      '1106010950=    IF (IS_FIRST_ = 1) then BEGIN'
      '1106010951=      INSERT INTO P_REP_PROFIT_TABLE'
      '1106010952=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1106010953=      VALUES'
      
        '1106010954=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39 +
        ', 1);'
      '1106010955='
      '1106010956=      IS_FIRST_ = 0;'
      '1106010957=    END'
      '1106010958='
      '1106010959=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1106010960=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1106010961=    VALUES'
      
        '1106010962=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '1106010963='
      '1106010964=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '1106010965=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '1106010966=  END'
      '1106010967='
      '1106010968=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '1106010969=  IF (SUM_COST_ > 0) then BEGIN'
      '1106010970=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1106010971=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1106010972=    insert into p_rep_profit_table'
      
        '1106010973=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106010974=    values'
      
        '1106010975=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '1106010976=  END'
      '1106010977=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '1106010978=  --*************************************************' +
        '****************************************'
      '1106010979='
      
        '1106010980=  --*************************************************' +
        '****************************************'
      '1106010981=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '1106010982=  ---------------------------------------------------' +
        '----'
      '1106010983=  IS_FIRST_ = 1;'
      '1106010984=  PROFIT_   = 0;'
      '1106010985=  PRIHOD_ALL_  = 0;'
      '1106010986=  PRIHOD_ALL_NAL_  = 0;'
      '1106010987=  PRIHOD_ALL_BEZNAL_  = 0;'
      '1106010988='
      '1106010989=  FOR SELECT G.NAME,'
      '1106010990=             SUM(K.NAL),'
      '1106010991=             SUM(K.BEZNAL)'
      
        '1106010992=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '1106010993=              UNION ALL'
      
        '1106010994=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL,' +
        ' ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '1106010995=             G_PRIHOD_RASHOD G'
      
        '1106010996=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHK' +
        'A||'#39'-'#39
      '1106010997=        AND K.ACTION = 0'
      
        '1106010998=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1106010999=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '1106011000=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1106011001=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '1106011002=        INTO :REC_TOVAR_NAME_'
      '1106011003=             ,:SUMM_NAL_'
      '1106011004=             ,:SUMM_BEZNAL_'
      '1106011005=  DO BEGIN'
      '1106011006=    IF (IS_FIRST_ = 1) then BEGIN'
      '1106011007=      INSERT INTO P_REP_PROFIT_TABLE'
      '1106011008=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '1106011009=      VALUES'
      
        '1106011010=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39 +
        ', 1);'
      '1106011011='
      '1106011012=      IS_FIRST_ = 0;'
      '1106011013=    END'
      '1106011014='
      '1106011015=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1106011016=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_' +
        'SUMM, SUMM, PROFIT, IS_HEAD)'
      '1106011017=    VALUES'
      
        '1106011018=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZN' +
        'AL_, 0);'
      '1106011019='
      '1106011020=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '1106011021=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BE' +
        'ZNAL_;'
      
        '1106011022=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      
        '1106011023=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL' +
        '_;'
      '1106011024=  END'
      '1106011025='
      '1106011026=  IF (PROFIT_ > 0) then BEGIN'
      '1106011027=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '1106011028=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1106011029=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '1106011030=    insert into p_rep_profit_table'
      
        '1106011031=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106011032=    values'
      
        '1106011033=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '1106011034=  END'
      '1106011035=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '1106011036=  --*************************************************' +
        '****************************************'
      '1106011037='
      
        '1106011038=  --*************************************************' +
        '****************************************'
      '1106011039=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1106011040=  --*************************************************' +
        '****************************************'
      '1106011041=  IS_FIRST_ = 1;'
      '1106011042=  SUM_COST_ = 0;'
      '1106011043=  PROFIT_   = 0;'
      
        '1106011044=  FOR SELECT SUM(ZD.SUMM)        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040 +
        #1053#1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040 +
        #1044#1054
      '1106011045=           ,TR.PATH'
      '1106011046=      FROM ZAKAZ Z,'
      '1106011047=           ZAKAZ_DETAILS ZD,'
      '1106011048=           G_PRODUCT GP,'
      '1106011049=           P_REP_TREE TR'
      
        '1106011050=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1106011051=       AND Z.IS_SPISANIE = 1'
      '1106011052=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106011053=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1106011054=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106011055=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106011056=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1106011057=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106011058=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106011059=     GROUP BY TR.PATH'
      '1106011060=     ORDER BY TR.PATH'
      '1106011061=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '1106011062=  DO BEGIN'
      '1106011063='
      '1106011064=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1106011065=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106011066=      insert into p_rep_profit_table'
      '1106011067=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106011068=      values'
      
        '1106011069=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39', 1);'
      '1106011070='
      '1106011071=      IS_FIRST_ = 0;'
      '1106011072=    END'
      '1106011073='
      '1106011074=    insert into p_rep_profit_table'
      
        '1106011075=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1106011076=    values'
      '1106011077=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1106011078=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZA' +
        'KAZ_, 0);'
      '1106011079='
      '1106011080=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '1106011081=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '1106011082=  END'
      '1106011083='
      '1106011084=  if (SUM_COST_ > 0) then BEGIN'
      '1106011085=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106011086=    insert into p_rep_profit_table'
      
        '1106011087=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106011088=    values'
      
        '1106011089=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', 0,' +
        ' :SUM_COST_, 0, :PROFIT_, 2);'
      '1106011090='
      '1106011091=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '1106011092=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1106011093=  END'
      '1106011094=  -- '#1050#1054#1053#1045#1062' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1106011095=  --*************************************************' +
        '****************************************'
      '1106011096='
      
        '1106011097=  --*************************************************' +
        '****************************************'
      '1106011098=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1106011099=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1106011100=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1106011101=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1106011102='
      
        '1106011103=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1106011104=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1106011105=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1106011106=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      
        '1106011107=  --*************************************************' +
        '****************************************'
      '1106011108=  IS_FIRST_  = 1;'
      '1106011109=  SUM_ZAKAZ_ = 0;'
      '1106011110=  PROFIT_    = 0;'
      '1106011111=  FOR SELECT SUM(S.SUMM)'
      '1106011112=             ,TR.PATH'
      '1106011113=     FROM SKLAD_PARENT SP,'
      '1106011114=          SKLAD S,'
      '1106011115=          G_PRODUCT G,'
      '1106011116=          P_REP_TREE TR'
      
        '1106011117=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOCHKA|' +
        '|'#39'-'#39
      
        '1106011118=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '1106011119=      AND SP.IS_VOZVRAT IN (1,2)'
      '1106011120=      and G.g_product_PAR = TR.g_product'
      
        '1106011121=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(S.G_CLIENT, 0))'
      
        '1106011122=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYP' +
        'E_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1106011123=      AND SP.SKLAD = S.SKLAD_PARENT'
      '1106011124=      AND S.G_PRODUCT = G.G_PRODUCT'
      '1106011125=     GROUP BY TR.PATH'
      '1106011126=     ORDER BY TR.PATH'
      '1106011127=     INTO :V_SUMM_,'
      '1106011128=          :REC_TOVAR_NAME_'
      '1106011129=  DO BEGIN'
      '1106011130=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '1106011131=      insert into p_rep_profit_table'
      '1106011132=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106011133=      values'
      
        '1106011134=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040#39', 1);'
      '1106011135='
      '1106011136=      IS_FIRST_ = 0;'
      '1106011137=    END'
      '1106011138='
      
        '1106011139=    REC_profit_   = 0 - V_SUMM_;    -- 26.05.2016 '#1055#1054#1057 +
        #1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050 +
        #1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      '1106011140=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '1106011141=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM' +
        ', SUM_SELF, PROFIT, IS_HEAD)'
      '1106011142=    VALUES'
      
        '1106011143=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_' +
        'NAME_, 0, 0, :V_SUMM_, :REC_profit_, 0);'
      '1106011144='
      '1106011145=    SUM_COST_ = 0;'
      '1106011146=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '1106011147=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '1106011148=  END'
      '1106011149='
      '1106011150=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1106011151=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '1106011152=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '1106011153='
      '1106011154=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106011155=    insert into p_rep_profit_table'
      
        '1106011156=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106011157=    values'
      
        '1106011158=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '1106011159=  END'
      '1106011160=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1106011161=  --*************************************************' +
        '****************************************'
      '1106011162='
      
        '1106011163=  --*************************************************' +
        '****************************************'
      
        '1106011164=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1106011165=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1106011166=  --*************************************************' +
        '****************************************'
      '1106011167=  IS_FIRST_  = 1;'
      '1106011168=  SUM_ZAKAZ_ = 0;'
      '1106011169=  SUM_COST_  = 0;'
      '1106011170=  PROFIT_    = 0;'
      '1106011171=  NDS_SUMM_  = 0;'
      '1106011172=  FOR SELECT SUM(ZD.SUMM)'
      '1106011173=           ,TR.PATH'
      '1106011174=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '1106011175=           ,SUM(ZD.nds_summ)'
      '1106011176=      FROM ZAKAZ Z,'
      '1106011177=           ZAKAZ_DETAILS ZD,'
      '1106011178=           G_PRODUCT GP,'
      '1106011179=           P_REP_TREE TR'
      
        '1106011180=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1106011181=       AND Z.IS_SPISANIE = 2'
      '1106011182=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106011183=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1106011184=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106011185=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106011186=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '1106011187=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIE' +
        'NT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106011188=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:' +
        'G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106011189=     GROUP BY TR.PATH'
      '1106011190=     ORDER BY TR.PATH'
      
        '1106011191=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST' +
        '_, REC_NDS_SUMM_'
      '1106011192=  DO BEGIN'
      '1106011193=    IF (IS_FIRST_ = 1) then BEGIN'
      '1106011194=      insert into p_rep_profit_table'
      '1106011195=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1106011196=      values'
      
        '1106011197=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1106011198='
      '1106011199=      IS_FIRST_ = 0;'
      '1106011200=    END'
      '1106011201='
      
        '1106011202=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS' +
        '_SUMM_;'
      '1106011203='
      '1106011204=    insert into p_rep_profit_table'
      
        '1106011205=        (p_rep_profit_table, tovar_name, summ, nds_su' +
        'mm, sum_self, profit, is_head)'
      '1106011206=    values'
      '1106011207=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '1106011208=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_,' +
        ' :REC_SUM_COST_, :REC_PROFIT_, 0);'
      '1106011209='
      '1106011210=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '1106011211=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '1106011212=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '1106011213=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '1106011214=  END'
      '1106011215='
      '1106011216=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '1106011217=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1106011218=    insert into p_rep_profit_table'
      
        '1106011219=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1106011220=    values'
      
        '1106011221=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFI' +
        'T_, 2);'
      '1106011222='
      '1106011223=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1106011224=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '1106011225=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1106011226=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '1106011227=  END'
      '1106011228=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106011229=  --*************************************************' +
        '****************************************'
      '1106011230=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1106011231=  insert into p_rep_profit_table'
      '1106011232=    (p_rep_profit_table, is_head)'
      '1106011233=  values'
      '1106011234=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1106011235='
      '1106011236=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1106011237=  insert into p_rep_profit_table'
      
        '1106011238=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1106011239=  values'
      
        '1106011240=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1106011241='
      '1106011242=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1106011243=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1106011244=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1106011245=         SUM(Z.SUMM_BONUS)'
      '1106011246=    FROM ZAKAZ Z'
      
        '1106011247=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1106011248=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1106011249=     AND Z.IS_RESERVE = 0'
      '1106011250=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1106011251=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106011252=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106011253=    INTO :SUMM_CASH_ALL_,'
      '1106011254=         :SUMM_NONCASH_ALL_,'
      '1106011255=         :SUMM_BONUS_ALL_;'
      '1106011256='
      '1106011257=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '1106011258=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '1106011259=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1106011260='
      '1106011261=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1106011262='
      
        '1106011263=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1106011264=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1106011265='
      '1106011266=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1106011267=    SELECT G.NAME'
      '1106011268=      FROM G_CLIENT G'
      '1106011269=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1106011270=    INTO :CLIENT_NAME_;'
      '1106011271=  ELSE'
      '1106011272=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1106011273='
      '1106011274=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1106011275=    SELECT G.NAME'
      '1106011276=      FROM G_PAYMENT_TYPE G'
      '1106011277=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1106011278=    INTO :PAYMENT_NAME_;'
      '1106011279=  ELSE'
      '1106011280=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1106011281='
      '1106011282=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1106011283=        P.TOVAR_NAME,'
      
        '1106011284=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1106011285=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1106011286=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1106011287=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1106011288=        P.IS_HEAD'
      
        '1106011289=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1106011290=    ORDER BY 1'
      '1106011291=  INTO :P_REP_PROFIT_TABLE,'
      '1106011292=       :TOVAR_NAME,'
      '1106011293=       :SUMM,'
      '1106011294=       :NDS_SUMM,'
      '1106011295=       :SUM_SELF,'
      '1106011296=       :PROFIT,'
      '1106011297=       :IS_HEAD'
      '1106011298=  DO'
      '1106011299=    suspend;'
      '1106011300='
      '1106011301=WHEN ANY DO BEGIN'
      '1106011302=    Err_code = -20500;'
      
        '1106011303=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106011304=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106011305=  END'
      '1106011306=end'
      '1106011307=;'
      '1106011308='
      '1106011309=ALTER PROCEDURE P_REP_RASHODY_PROFIT('
      '1106011310=  DATE_BEGIN_ DATE,'
      '1106011311=  DATE_END_ DATE,'
      '1106011312=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1106011313=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      '1106011314=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106011315=RETURNS ('
      '1106011316=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1106011317=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1106011318=  PERIOD_ VARCHAR(40),'
      
        '1106011319=  TOVAR_NAME TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABL' +
        'E.TOVAR_NAME,'
      
        '1106011320=  AMOUNT TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABLE.AM' +
        'OUNT,'
      
        '1106011321=  CLIENT_NAME TYPE OF COLUMN P_REP_RASHODY_PROFIT_TAB' +
        'LE.CLIENT_NAME,'
      
        '1106011322=  SUMM_NAL TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABLE.' +
        'SUMM_NAL,'
      
        '1106011323=  SUMM_BEZNAL TYPE OF COLUMN P_REP_RASHODY_PROFIT_TAB' +
        'LE.SUMM_BEZNAL,'
      
        '1106011324=  OPER_TYPE TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABLE' +
        '.OPER_TYPE,'
      
        '1106011325=  SELF_PRICE TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABL' +
        'E.SELF_PRICE,'
      
        '1106011326=  SUMM_SELF TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABLE' +
        '.SUMM_SELF,'
      
        '1106011327=  NDS_SUMM TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABLE.' +
        'NDS_SUMM,'
      
        '1106011328=  PROFIT TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABLE.PR' +
        'OFIT,'
      
        '1106011329=  PRIHOD_SUMM TYPE OF COLUMN P_REP_RASHODY_PROFIT_TAB' +
        'LE.PRIHOD_SUMM,'
      
        '1106011330=  IS_HEAD TYPE OF COLUMN P_REP_RASHODY_PROFIT_TABLE.I' +
        'S_HEAD,'
      '1106011331=  ERR_CODE INTEGER,'
      '1106011332=  ERR_MSG VARCHAR(1024))'
      '1106011333=AS'
      '1106011334=/*'
      '1106011335='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '1106011336='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068 +
        #1050#1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056 +
        #1048#1054#1044
      
        '1106011337='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054 +
        #1055#1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '1106011338='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - ' +
        #1069#1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054 +
        #1053#1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '1106011339='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '1106011340='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '1106011341='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '1106011342=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '1106011343=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '1106011344=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '1106011345='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*17' +
        '50 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '1106011346='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059 +
        ' '#1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '1106011347=*/'
      
        '1106011348=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_RASHOD' +
        'Y_PROFIT'#39';'
      '1106011349=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106011350=DECLARE VARIABLE SUM_NAL_ NUMERIC(15,2) = 0;'
      
        '1106011351=DECLARE VARIABLE IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS' +
        '_SPISANIE;'
      '1106011352=DECLARE VARIABLE SUM_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '1106011353=DECLARE VARIABLE OPER_TYPE_ TYPE OF COLUMN P_REP_RASH' +
        'ODY_PROFIT_TABLE.OPER_TYPE;'
      '1106011354=DECLARE VARIABLE SUM_ZAKAZ_NAL_ NUMERIC(15,2) = 0;'
      '1106011355=DECLARE VARIABLE SUM_ZAKAZ_BEZNAL_ NUMERIC(15,2) = 0;'
      
        '1106011356=DECLARE VARIABLE SUM_ZAKAZ_NAL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      
        '1106011357=DECLARE VARIABLE SUM_ZAKAZ_BEZNAL_ALL_ NUMERIC(15,2) ' +
        '= 0;'
      '1106011358=DECLARE VARIABLE SUM_FACT_NAL_ALL_ NUMERIC(15,2) = 0;'
      
        '1106011359=DECLARE VARIABLE SUM_FACT_BEZNAL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1106011360=DECLARE VARIABLE SUM_PAY_BONUS_NAL_ALL_ NUMERIC(15,2)' +
        ' = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1041#1054#1053#1059#1057#1040#1052#1048' '#1042#1057#1045#1043#1054' '#1055#1054' '#1053#1040#1051#1059' */'
      
        '1106011361=DECLARE VARIABLE SUM_PAY_BONUS_BEZNAL_ALL_ NUMERIC(15' +
        ',2) = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1054#1055#1051#1040#1063#1045#1053#1054' '#1041#1054#1053#1059#1057#1040#1052#1048' '#1042#1057#1045#1043#1054' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059' */'
      
        '1106011362=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      '1106011363=DECLARE VARIABLE PRIHOD_SUMM_ NUMERIC(15,2) = 0;'
      '1106011364=DECLARE VARIABLE PRIHOD_SUMM_ALL_ NUMERIC(15,2) = 0;'
      '1106011365=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1106011366=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1106011367=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1106011368=DECLARE VARIABLE SUM_COST_ALL_ NUMERIC(15,2) = 0;'
      '1106011369=DECLARE VARIABLE NDS_SUMM_ALL_ NUMERIC(15,2) = 0;'
      '1106011370=DECLARE VARIABLE PROFIT_ALL_ NUMERIC(15,2) = 0;'
      
        '1106011371=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CL' +
        'IENT.NAME;'
      
        '1106011372=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1106011373=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.NDS_SUMM;'
      
        '1106011374=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      
        '1106011375=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD' +
        '.PRICE;'
      
        '1106011376=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.S' +
        'UMM;'
      '1106011377=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '1106011378=DECLARE VARIABLE K_SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '1106011379=DECLARE VARIABLE I INTEGER = 1;'
      
        '1106011380=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1106011381=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1106011382=BEGIN'
      
        '1106011383=  DELETE FROM P_REP_RASHODY_PROFIT_TABLE WHERE P_REP_' +
        'RASHODY_PROFIT_TABLE = P_REP_RASHODY_PROFIT_TABLE;'
      '1106011384=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1106011385='
      '1106011386=    FOR SELECT G.NAME,'
      '1106011387=               ZD.PRICE,'
      '1106011388=               ZD.AMOUNT,'
      
        '1106011389=               DECODE(Z.IS_SPISANIE, 1, '#39#39', C.NAME) C' +
        'LIENT_NAME,'
      
        '1106011390=               CASE Z.IS_SPISANIE   -- '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054 +
        #1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1048' '#1058#1054#1051#1068#1050#1054' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058
      
        '1106011391=                 WHEN 1 THEN 0 ELSE DECODE(Z.G_PAYMEN' +
        'T_TYPE, 1, ZD.SUMM, 0) END SUMM_NAL,'
      
        '1106011392=               CASE Z.IS_SPISANIE   -- '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054 +
        #1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1048' '#1058#1054#1051#1068#1050#1054' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058
      
        '1106011393=                 WHEN 1 THEN 0 ELSE DECODE(Z.G_PAYMEN' +
        'T_TYPE, 2, ZD.SUMM, 0) END SUMM_BEZNAL,'
      
        '1106011394=               DECODE(Z.IS_SPISANIE, 1, '#39#1089#1087#1080#1089#1072#1085#1080#1077#39', '#39 +
        #1087#1088#1086#1076#1072#1078#1072#39') OPER_TYPE,'
      '1106011395=               Z.IS_SPISANIE,'
      '1106011396=               ZD.NDS_SUMM,'
      '1106011397=               ZD.COST_PRICE,'
      '1106011398=               COALESCE(K.SUMM, 0),'
      '1106011399=               TR.PATH'
      
        '1106011400=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON ' +
        'Z.G_CLIENT = C.G_CLIENT'
      
        '1106011401=               LEFT OUTER JOIN (SELECT ZAKAZ, SUMM FR' +
        'OM KASSA WHERE G_PRIHOD_RASHOD <> 1) K ON Z.ZAKAZ = K.ZAKAZ,'
      '1106011402=               ZAKAZ_DETAILS ZD,'
      '1106011403=               G_PRODUCT G,'
      '1106011404=               P_REP_TREE TR'
      
        '1106011405=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1106011406=           AND Z.IS_RESERVE = 0'
      '1106011407=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106011408=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106011409=           AND G.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106011410=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106011411=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1106011412=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '1106011413=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '1106011414=        ORDER BY TR.PATH, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ' +
        '_DETAILS, G.NAME'
      '1106011415=    INTO :TOVAR_NAME_,'
      '1106011416=         :REC_PRICE_,'
      '1106011417=         :REC_AMOUNT_,'
      '1106011418=         :REC_CLIENT_NAME_,'
      '1106011419=         :SUM_NAL_,'
      '1106011420=         :SUM_BEZNAL_,'
      '1106011421=         :OPER_TYPE_,'
      '1106011422=         :IS_SPISANIE_,'
      '1106011423=         :REC_NDS_SUMM_,'
      '1106011424=         :REC_PRICE_SELF_,'
      '1106011425=         :K_SUMM_,'
      '1106011426=         :PATH_'
      '1106011427=    DO BEGIN'
      '1106011428=      IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1106011429=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106011430=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106011431=            INSERT INTO P_REP_RASHODY_PROFIT_TABLE (P' +
        '_REP_RASHODY_PROFIT_TABLE, TOVAR_NAME, SUMM_NAL,'
      
        '1106011432=                                                    S' +
        'UMM_BEZNAL, SUMM_SELF, NDS_SUMM, PROFIT, PRIHOD_SUMM,'
      
        '1106011433=                                                    I' +
        'S_HEAD)'
      
        '1106011434=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :SUM_ZA' +
        'KAZ_NAL_, :SUM_ZAKAZ_BEZNAL_,'
      
        '1106011435=                    :SUM_COST_, :NDS_SUMM_, :PROFIT_,' +
        ' :PRIHOD_SUMM_, 2);'
      '1106011436='
      
        '1106011437=            SUM_ZAKAZ_NAL_ALL_    = SUM_ZAKAZ_NAL_ALL' +
        '_ + SUM_ZAKAZ_NAL_;'
      
        '1106011438=            SUM_ZAKAZ_BEZNAL_ALL_ = SUM_ZAKAZ_BEZNAL_' +
        'ALL_ + SUM_ZAKAZ_BEZNAL_;'
      
        '1106011439=            SUM_COST_ALL_       = SUM_COST_ALL_ + SUM' +
        '_COST_;'
      
        '1106011440=            NDS_SUMM_ALL_       = NDS_SUMM_ALL_ + NDS' +
        '_SUMM_;'
      
        '1106011441=            PROFIT_ALL_         = PROFIT_ALL_ + PROFI' +
        'T_;'
      
        '1106011442=            PRIHOD_SUMM_ALL_    = PRIHOD_SUMM_ALL_ + ' +
        'PRIHOD_SUMM_;'
      '1106011443='
      '1106011444=            SUM_ZAKAZ_NAL_ = 0;'
      '1106011445=            SUM_ZAKAZ_BEZNAL_ = 0;'
      '1106011446=            SUM_COST_    = 0;'
      '1106011447=            NDS_SUMM_    = 0;'
      '1106011448=            PROFIT_      = 0;'
      '1106011449=            PRIHOD_SUMM_ = 0;'
      '1106011450='
      '1106011451=            I = I + 1;'
      '1106011452=        END'
      '1106011453='
      '1106011454=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106011455=        insert into P_REP_RASHODY_PROFIT_TABLE'
      
        '1106011456=          (P_REP_RASHODY_PROFIT_TABLE, tovar_name, IS' +
        '_HEAD)'
      '1106011457=        values'
      '1106011458=          (:I, :PATH_, 1);'
      '1106011459='
      '1106011460=        I = I + 1;'
      '1106011461=      END'
      '1106011462='
      '1106011463=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '1106011464='
      '1106011465=      IF (IS_SPISANIE_ IN (0,2)) THEN'
      
        '1106011466=        REC_profit_ = (SUM_NAL_+SUM_BEZNAL_) - REC_SU' +
        'M_COST_;  --'#1042#1057#1045#1043#1044#1040' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1048#1047' '#1053#1048#1061' '#1041#1059#1044#1045#1058' '#1041#1054#1051#1068#1064#1045' 0, '#1058#1040#1050' '#1063#1058#1054' '#1052#1054 +
        #1046#1053#1054' '#1057#1052#1045#1051#1054' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068
      '1106011467=      ELSE BEGIN'
      
        '1106011468=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_' +
        ';'
      
        '1106011469=        REC_profit_   = -(REC_PRICE_SELF_ * REC_AMOUN' +
        'T_);'
      '1106011470=      END'
      '1106011471='
      
        '1106011472=      INSERT INTO P_REP_RASHODY_PROFIT_TABLE (P_REP_R' +
        'ASHODY_PROFIT_TABLE, TOVAR_NAME, AMOUNT, CLIENT_NAME, SUMM_NAL,'
      
        '1106011473=                                              SUMM_BE' +
        'ZNAL, OPER_TYPE, SELF_PRICE, SUMM_SELF, NDS_SUMM, PROFIT, PRIHOD' +
        '_SUMM,'
      
        '1106011474=                                              IS_HEAD' +
        ')'
      
        '1106011475=      VALUES (:I, :TOVAR_NAME_, :REC_AMOUNT_, :REC_CL' +
        'IENT_NAME_, :SUM_NAL_, :SUM_BEZNAL_, :OPER_TYPE_,'
      
        '1106011476=              :REC_PRICE_SELF_, :REC_SUM_COST_, :REC_' +
        'NDS_SUMM_, :REC_profit_, :K_SUMM_, 0);'
      '1106011477='
      '1106011478=      I = I +1;'
      '1106011479='
      
        '1106011480=      SUM_ZAKAZ_NAL_ = SUM_ZAKAZ_NAL_ + COALESCE(SUM_' +
        'NAL_, 0);'
      
        '1106011481=      SUM_ZAKAZ_BEZNAL_ = SUM_ZAKAZ_BEZNAL_ + COALESC' +
        'E(SUM_BEZNAL_, 0);'
      '1106011482='
      
        '1106011483=      SUM_COST_    = SUM_COST_ + COALESCE(REC_SUM_COS' +
        'T_, 0);'
      
        '1106011484=      NDS_SUMM_    = NDS_SUMM_ + COALESCE(REC_NDS_SUM' +
        'M_, 0);'
      
        '1106011485=      PROFIT_      = PROFIT_ + COALESCE(REC_PROFIT_, ' +
        '0);'
      
        '1106011486=      PRIHOD_SUMM_ = PRIHOD_SUMM_ + COALESCE(K_SUMM_,' +
        ' 0);'
      '1106011487='
      '1106011488=      LAST_PATH_ = PATH_;'
      '1106011489=    END'
      '1106011490='
      '1106011491=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106011492=    INSERT INTO P_REP_RASHODY_PROFIT_TABLE (P_REP_RAS' +
        'HODY_PROFIT_TABLE, TOVAR_NAME, SUMM_NAL,'
      
        '1106011493=                                            SUMM_BEZN' +
        'AL, SUMM_SELF, NDS_SUMM, PROFIT, PRIHOD_SUMM,'
      '1106011494=                                            IS_HEAD)'
      
        '1106011495=    VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1082#1072#1090#1077#1075#1086#1088#1080#1080#39', :SUM_ZAKAZ_NAL_' +
        ', :SUM_ZAKAZ_BEZNAL_,'
      
        '1106011496=            :SUM_COST_, :NDS_SUMM_, :PROFIT_, :PRIHOD' +
        '_SUMM_, 2);'
      '1106011497='
      
        '1106011498=    SUM_ZAKAZ_NAL_ALL_    = SUM_ZAKAZ_NAL_ALL_ + SUM_' +
        'ZAKAZ_NAL_;'
      
        '1106011499=    SUM_ZAKAZ_BEZNAL_ALL_ = SUM_ZAKAZ_BEZNAL_ALL_ + S' +
        'UM_ZAKAZ_BEZNAL_;'
      '1106011500=    SUM_COST_ALL_       = SUM_COST_ALL_ + SUM_COST_;'
      '1106011501=    NDS_SUMM_ALL_       = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1106011502=    PROFIT_ALL_         = PROFIT_ALL_ + PROFIT_;'
      
        '1106011503=    PRIHOD_SUMM_ALL_    = PRIHOD_SUMM_ALL_ + PRIHOD_S' +
        'UMM_;'
      '1106011504='
      '1106011505=    I = I + 1;'
      '1106011506='
      '1106011507=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '1106011508=  INSERT INTO P_REP_RASHODY_PROFIT_TABLE (P_REP_RASHO' +
        'DY_PROFIT_TABLE, TOVAR_NAME, SUMM_NAL,'
      
        '1106011509=                                            SUMM_BEZN' +
        'AL, SUMM_SELF, NDS_SUMM, PROFIT, PRIHOD_SUMM,'
      '1106011510=                                            IS_HEAD)'
      
        '1106011511=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUM_ZAKAZ_NAL_ALL_, :SUM_ZAKA' +
        'Z_BEZNAL_ALL_,'
      
        '1106011512=            :SUM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT_A' +
        'LL_, :PRIHOD_SUMM_ALL_, 1);'
      '1106011513='
      '1106011514=  I = I + 1;'
      '1106011515='
      '1106011516=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1059#1055#1051#1040#1063#1045#1053#1054
      '1106011517=  SELECT COALESCE(SUM(Z.SUMM_FACT), 0),'
      '1106011518=         COALESCE(SUM(Z.SUMM_BONUS), 0)'
      '1106011519=    FROM ZAKAZ Z'
      
        '1106011520=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1106011521=     AND Z.IS_SPISANIE IN (0,2)'
      '1106011522=     AND Z.IS_RESERVE = 0'
      '1106011523=     AND Z.G_PAYMENT_TYPE = 1'
      '1106011524=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1106011525=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106011526=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106011527=    INTO :SUM_FACT_NAL_ALL_,'
      '1106011528=         :SUM_PAY_BONUS_NAL_ALL_;'
      '1106011529='
      '1106011530=  SELECT COALESCE(SUM(Z.SUMM_FACT), 0),'
      '1106011531=         COALESCE(SUM(Z.SUMM_BONUS), 0)'
      '1106011532=    FROM ZAKAZ Z'
      
        '1106011533=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1106011534=     AND Z.IS_SPISANIE IN (0, 2)'
      '1106011535=     AND Z.G_PAYMENT_TYPE = 2'
      '1106011536=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1106011537=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1106011538=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1106011539=    INTO :SUM_FACT_BEZNAL_ALL_,'
      '1106011540=         :SUM_PAY_BONUS_BEZNAL_ALL_;'
      '1106011541='
      
        '1106011542=  INSERT INTO P_REP_RASHODY_PROFIT_TABLE (P_REP_RASHO' +
        'DY_PROFIT_TABLE, TOVAR_NAME, SUMM_NAL,'
      
        '1106011543=                                            SUMM_BEZN' +
        'AL, SUMM_SELF, NDS_SUMM,'
      '1106011544=                                            PROFIT,'
      
        '1106011545=                                            PRIHOD_SU' +
        'MM,'
      '1106011546=                                            IS_HEAD)'
      
        '1106011547=  VALUES (:I, '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095#1077#1085#1086#39', :SUM_FACT_NAL_ALL_,' +
        ' :SUM_FACT_BEZNAL_ALL_,'
      '1106011548=            :SUM_COST_ALL_, :NDS_SUMM_ALL_,'
      
        '1106011549=            :SUM_FACT_NAL_ALL_ + :SUM_FACT_BEZNAL_ALL' +
        '_ - :SUM_COST_ALL_,'
      '1106011550=            :PRIHOD_SUMM_ALL_, 3);'
      '1106011551='
      '1106011552=  I = I + 1;'
      
        '1106011553=  INSERT INTO P_REP_RASHODY_PROFIT_TABLE (P_REP_RASHO' +
        'DY_PROFIT_TABLE, TOVAR_NAME, SUMM_NAL,'
      
        '1106011554=                                            SUMM_BEZN' +
        'AL,'
      '1106011555=                                            IS_HEAD)'
      
        '1106011556=  VALUES (:I, '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072#1095#1077#1085#1086#39', :SUM_PAY_BONUS_NAL' +
        '_ALL_, :SUM_PAY_BONUS_BEZNAL_ALL_, 3);'
      '1106011557='
      '1106011558=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1106011559=    SELECT G.NAME'
      '1106011560=      FROM G_CLIENT G'
      '1106011561=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1106011562=    INTO :CLIENT_NAME_;'
      '1106011563=  ELSE'
      '1106011564=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1106011565='
      '1106011566=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1106011567=    SELECT G.NAME'
      '1106011568=      FROM G_PAYMENT_TYPE G'
      '1106011569=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1106011570=    INTO :PAYMENT_NAME_;'
      '1106011571=  ELSE'
      '1106011572=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1106011573='
      
        '1106011574=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1106011575=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1106011576='
      
        '1106011577=  FOR SELECT TOVAR_NAME, AMOUNT, CLIENT_NAME, SUMM_NA' +
        'L, SUMM_BEZNAL, OPER_TYPE, SELF_PRICE,'
      
        '1106011578=             SUMM_SELF, NDS_SUMM, PROFIT, PRIHOD_SUMM' +
        ', IS_HEAD'
      '1106011579=      FROM P_REP_RASHODY_PROFIT_TABLE'
      '1106011580=      ORDER BY P_REP_RASHODY_PROFIT_TABLE'
      
        '1106011581=      INTO :TOVAR_NAME, :AMOUNT, :CLIENT_NAME, :SUMM_' +
        'NAL, :SUMM_BEZNAL, :OPER_TYPE,'
      
        '1106011582=           :SELF_PRICE, :SUMM_SELF, :NDS_SUMM, :PROFI' +
        'T, :PRIHOD_SUMM, :IS_HEAD'
      '1106011583=  DO'
      '1106011584=    suspend;'
      '1106011585='
      '1106011586=WHEN ANY DO BEGIN'
      '1106011587=    Err_code = -20500;'
      
        '1106011588=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106011589=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106011590=  END'
      '1106011591=end'
      '1106011592=;'
      '1106011593='
      '1106011594=ALTER PROCEDURE P_REP_TOVAR_HISTORY('
      '1106011595=  G_PRODUCT_ARR_ BLOB SUB_TYPE 1,'
      '1106011596=  DATE_BEGIN_ DATE,'
      '1106011597=  DATE_END_ DATE,'
      '1106011598=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106011599=RETURNS ('
      '1106011600=  ROW INTEGER,'
      '1106011601=  DATE_ACT DATE,'
      '1106011602=  OPER VARCHAR(500),'
      '1106011603=  PRICE_PRIHOD NUMERIC(15,2),'
      '1106011604=  AMOUNT_PRIHOD MY_NUMERIC_5,'
      '1106011605=  SUMM_PRIHOD NUMERIC(15,2),'
      '1106011606=  PRICE_UHOD NUMERIC(15,2),'
      '1106011607=  AMOUNT_UHOD MY_NUMERIC_5,'
      '1106011608=  SUMM_UHOD NUMERIC(15,2),'
      '1106011609=  ERR_CODE INTEGER,'
      '1106011610=  ERR_MSG VARCHAR(1024))'
      '1106011611=AS'
      
        '1106011612=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1106011613=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106011614=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      '1106011615=DECLARE VARIABLE DATE_SORT DATE;'
      '1106011616=BEGIN'
      '1106011617='
      '1106011618=  FOR SELECT F.G_PRODUCT'
      '1106011619=        FROM G_PRODUCT F'
      
        '1106011620=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39'~'#39'||F.G_PROD' +
        'UCT||'#39'~'#39
      '1106011621=       AND EXISTS (SELECT 1'
      '1106011622=                     FROM SKLAD SS'
      
        '1106011623=                    WHERE SS.DATE_RECEIPT BETWEEN :DA' +
        'TE_BEGIN_ AND :DATE_END_'
      '1106011624=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '1106011625=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||SS.G_TOCHKA||'#39'-'#39
      '1106011626=                   UNION ALL'
      '1106011627=                   SELECT 1'
      '1106011628=                     FROM ZAKAZ ZZ,'
      '1106011629=                          ZAKAZ_DETAILS ZZD'
      '1106011630=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '1106011631=                      AND ZZ.IS_RESERVE = 0'
      
        '1106011632=                      AND ZZ.Z_DATE BETWEEN :DATE_BEG' +
        'IN_ AND :DATE_END_'
      '1106011633=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      '1106011634=                      AND ZZ.IS_SPISANIE <> 2'
      
        '1106011635=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||ZZ.G_TOCHKA||'#39'-'#39
      '1106011636=                   UNION ALL'
      '1106011637=                   SELECT 1'
      '1106011638=                     FROM ZAKAZ_REAL_PARENT Z,'
      '1106011639=                          ZAKAZ_NA_REAL D'
      
        '1106011640=                    WHERE Z.ZAKAZ_REAL_PARENT = D.ZAK' +
        'AZ_REAL_PARENT'
      
        '1106011641=                      AND Z.ZAKAZ_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1106011642=                      AND D.G_PRODUCT = F.G_PRODUCT'
      
        '1106011643=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1106011644=                   UNION ALL'
      '1106011645=                   SELECT 1'
      '1106011646=                     FROM OTHER ZZ,'
      '1106011647=                          OTHER_DETAILS ZZD'
      '1106011648=                    WHERE ZZ.OTHER = ZZD.OTHER'
      
        '1106011649=                      AND ZZ.OP_DATE BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '1106011650=                      AND ZZD.G_PRODUCT = F.G_PRODUCT'
      
        '1106011651=                      AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||ZZ.G_TOCHKA||'#39'-'#39
      '1106011652=                   )'
      '1106011653=       ORDER BY F.NAME'
      '1106011654=       INTO :G_PRODUCT_'
      '1106011655=  DO BEGIN'
      '1106011656=      FOR SELECT -2,'
      
        '1106011657=                 CAST('#39'01.01.1985'#39' AS DATE) DATE_SORT' +
        ','
      '1106011658=                 NULL,'
      '1106011659=                 NAME,'
      '1106011660=                 NULL,'
      '1106011661=                 NULL,'
      '1106011662=                 NULL,'
      '1106011663=                 NULL,'
      '1106011664=                 NULL,'
      '1106011665=                 NULL'
      '1106011666=            FROM G_PRODUCT G'
      '1106011667=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1106011668=          UNION ALL'
      '1106011669=          SELECT -1,'
      
        '1106011670=                 CAST('#39'01.01.1990'#39' AS DATE) DATE_SORT' +
        ','
      '1106011671=                 NULL,'
      '1106011672=                 '#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1085#1072#1095#1072#1083#1086#39','
      '1106011673=                 NULL,'
      
        '1106011674=                 (select (select amount from lt_sklad' +
        '_product where g_product = G.G_PRODUCT'
      
        '1106011675=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1106011676=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1106011677=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1106011678=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1106011679=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1106011680=                        and zrp.ZAKAZ_DATE >= :DATE_B' +
        'EGIN_)'
      '1106011681=                       +'
      
        '1106011682=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1106011683=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1106011684=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      
        '1106011685=                        and z.IS_SPISANIE <> 2)   -- ' +
        #1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072 +
        ' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      '1106011686=                       +'
      
        '1106011687=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1106011688=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1106011689=                       +'
      
        '1106011690=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1106011691=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1106011692=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1106011693=                       -'
      
        '1106011694=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_' +
        'ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1106011695=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_)'
      '1106011696=                       -'
      
        '1106011697=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1106011698=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1106011699=                  from rdb$database) PRICE,'
      '1106011700=                 NULL,'
      '1106011701=                 NULL,'
      '1106011702=                 NULL,'
      '1106011703=                 NULL'
      '1106011704=            FROM G_PRODUCT G'
      '1106011705=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1106011706=          UNION ALL'
      '1106011707=          SELECT SP.IS_VOZVRAT,'
      '1106011708=                 SP.DATE_RECEIPT DATE_SORT,'
      '1106011709=                 SP.DATE_RECEIPT DATE_ACT,'
      '1106011710=                 DECODE(SP.IS_VOZVRAT,'
      
        '1106011711=                        0, '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072', '#1087#1086#1089#1090#1072 +
        #1074#1097#1080#1082' '#39'||SUBSTRING(COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39') FROM 1 FOR 300),'
      
        '1106011712=                        1, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39'|' +
        '|COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39'),'
      
        '1106011713=                        2, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072', '#1082#1083#1080#1077#1085#1090' '#39'|' +
        '|COALESCE(c.NAME, '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39'),'
      
        '1106011714=                        5, '#39#1042#1099#1088#1072#1074#1085#1080#1074#1072#1085#1080#1077' '#1086#1089#1090#1072#1090#1082#1086#1074' ('#1088#1077 +
        #1074#1080#1079#1080#1103')'#39'),'
      '1106011715=                 S.PRICE,'
      '1106011716=                 S.AMOUNT,'
      '1106011717=                 S.SUMM,'
      '1106011718=                 NULL,'
      '1106011719=                 NULL,'
      '1106011720=                 NULL'
      
        '1106011721=            FROM SKLAD_PARENT SP LEFT OUTER JOIN G_CL' +
        'IENT C ON SP.G_CLIENT = C.G_CLIENT,'
      '1106011722=                 SKLAD S,'
      '1106011723=                 G_PRODUCT G'
      
        '1106011724=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_' +
        'TOCHKA||'#39'-'#39
      
        '1106011725=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_' +
        ' AND :DATE_END_'
      '1106011726=             AND SP.SKLAD = S.SKLAD_PARENT'
      '1106011727=             AND S.G_PRODUCT = G.G_PRODUCT'
      '1106011728=             AND G.G_PRODUCT = :G_PRODUCT_'
      '1106011729=             AND SP.IS_VOZVRAT NOT IN (2, 3, 4)'
      '1106011730=          UNION ALL'
      '1106011731=          SELECT SP.IS_VOZVRAT,'
      '1106011732=                 SP.DATE_RECEIPT DATE_SORT,'
      '1106011733=                 SP.DATE_RECEIPT DATE_ACT,'
      
        '1106011734=                 '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1090#1086#1074#1072#1088#1072' '#1089#1086' '#1089#1082#1083#1072#1076#1072' "'#39'||CO' +
        'ALESCE(c.NAME, '#39#1053#1045' '#1059#1057#1058#1040#1053#1054#1042#1051#1045#1053#39')||'#39'"'#39','
      '1106011735=                 S.PRICE,'
      '1106011736=                 S.AMOUNT,'
      '1106011737=                 S.SUMM,'
      '1106011738=                 NULL,'
      '1106011739=                 NULL,'
      '1106011740=                 NULL'
      
        '1106011741=            FROM SKLAD_PARENT SP LEFT OUTER JOIN G_TO' +
        'CHKA C ON SP.G_CLIENT = C.G_TOCHKA,'
      '1106011742=                 SKLAD S,'
      '1106011743=                 G_PRODUCT G'
      
        '1106011744=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_' +
        'TOCHKA||'#39'-'#39
      
        '1106011745=             AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_' +
        ' AND :DATE_END_'
      '1106011746=             AND SP.SKLAD = S.SKLAD_PARENT'
      '1106011747=             AND S.G_PRODUCT = G.G_PRODUCT'
      '1106011748=             AND G.G_PRODUCT = :G_PRODUCT_'
      '1106011749=             AND SP.IS_VOZVRAT = 3'
      '1106011750=          UNION ALL'
      
        '1106011751=          SELECT DECODE(Z.IS_SPISANIE,          --0, ' +
