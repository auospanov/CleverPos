      '1106015905=ALTER PROCEDURE G_DEL_G_FIRM_REKVIZIT('
      
        '1106015906=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_F' +
        'IRM_REKVIZIT)'
      '1106015907=RETURNS ('
      '1106015908=  ERR_CODE INTEGER,'
      '1106015909=  ERR_MSG VARCHAR(1024))'
      '1106015910=AS'
      '1106015911=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1106015912=DECLARE VARIABLE IS_DEFAULT_ TYPE OF COLUMN G_FIRM_RE' +
        'KVIZIT.IS_DEFAULT;'
      '1106015913=begin'
      '1106015914=  SELECT COUNT(*)'
      '1106015915=     FROM DOCS D'
      '1106015916=    WHERE D.G_FIRM = :G_FIRM_REKVIZIT_'
      '1106015917=     INTO :CNT_;'
      '1106015918='
      '1106015919=  if (CNT_ > 0) then BEGIN'
      '1106015920=    ERR_CODE = -20500;'
      
        '1106015921=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1082 +
        #1086#1084#1087#1072#1085#1080#1103' '#1091#1082#1072#1079#1072#1085#1072' '#1074' '#1092#1080#1085#1072#1085#1089#1086#1074#1099#1093' '#1076#1086#1082#1091#1084#1077#1085#1090#1072#1093'! '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1106015922=    EXIT;'
      '1106015923=  END'
      '1106015924='
      '1106015925=  SELECT IS_DEFAULT'
      '1106015926=    FROM G_FIRM_REKVIZIT G'
      '1106015927=   WHERE G.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_'
      '1106015928=   INTO :IS_DEFAULT_;'
      '1106015929='
      
        '1106015930=  DELETE FROM G_FIRM_ADDRESS A WHERE A.G_FIRM_REKVIZI' +
        'T = :G_FIRM_REKVIZIT_;'
      
        '1106015931=  DELETE FROM G_FIRM_ACCOUNT AC WHERE AC.G_FIRM_REKVI' +
        'ZIT = :G_FIRM_REKVIZIT_;'
      '1106015932='
      
        '1106015933=  DELETE FROM G_FIRM_REKVIZIT G WHERE G.G_FIRM_REKVIZ' +
        'IT = :G_FIRM_REKVIZIT_;'
      '1106015934='
      '1106015935=  IF (IS_DEFAULT_ = 1) THEN'
      '1106015936=    UPDATE G_FIRM_REKVIZIT G'
      '1106015937=      SET G.IS_DEFAULT = 1'
      
        '1106015938=     WHERE G.G_FIRM_REKVIZIT = (SELECT MIN(G_FIRM_REK' +
        'VIZIT) FROM G_FIRM_REKVIZIT);'
      '1106015939=end'
      '1106015940=;'
      '1106015941='
      '1106015942=ALTER PROCEDURE G_DEL_G_OFFICIAL('
      '1106015943=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '1106015944=RETURNS ('
      '1106015945=  ERR_CODE INTEGER,'
      '1106015946=  ERR_MSG VARCHAR(1024))'
      '1106015947=AS'
      
        '1106015948=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_OFFI' +
        'CIAL'#39';'
      
        '1106015949=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFF' +
        'ICIAL.G_OFFICIAL;'
      '1106015950=begin'
      '1106015951='
      '1106015952=  -- '#1053#1045#1051#1068#1047#1071' '#1059#1044#1040#1051#1048#1058#1068' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '1106015953=  SELECT ID'
      '1106015954=    FROM CUR_PARAMS'
      '1106015955=   WHERE CUR_PARAMS = 1'
      '1106015956=     AND (SELECT COUNT(*) FROM G_OFFICIAL) > 1'
      '1106015957=    INTO G_OFFICIAL_CUR_;'
      '1106015958='
      
        '1106015959=  if (COALESCE(G_OFFICIAL_CUR_, 0) = G_OFFICIAL_) the' +
        'n BEGIN'
      '1106015960=    ERR_CODE = -20500;'
      
        '1106015961=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091 +
        #1076#1072#1083#1080#1090#1100' '#1089#1072#1084#1086#1075#1086' '#1089#1077#1073#1103'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1106015962=    EXIT;'
      '1106015963=  END'
      '1106015964='
      '1106015965=  DELETE FROM G_OFFICIAL_RIGHT R'
      '1106015966=    WHERE R.G_OFFICIAL = :G_OFFICIAL_;'
      '1106015967='
      '1106015968=  delete from G_OFFICIAL g'
      '1106015969=    where g.G_OFFICIAL = :G_OFFICIAL_;'
      '1106015970='
      '1106015971=when sqlcode -530 DO'
      '1106015972=  begin'
      '1106015973=    ERR_CODE = -20500;'
      
        '1106015974=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106015975=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106015976=  end'
      '1106015977=end'
      '1106015978=;'
