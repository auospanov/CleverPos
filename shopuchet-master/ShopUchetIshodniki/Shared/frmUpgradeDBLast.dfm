      '110752274=              END'
      '110752275='
      
        '110752276=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', ' +
        #1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110752277=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', ' +
        #1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110752278=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110752279=                PNT_ = '#39'11'#39';'
      '110752280=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110752281=                    EXECUTE PROCEDURE K_DEL_KASSA(:KAS' +
        'SA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR' +
        '_MSG);'
      '110752282=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110752283=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110752284=                      EXIT;'
      '110752285=                    END'
      '110752286='
      
        '110752287=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110752288=                                                  :G_P' +
