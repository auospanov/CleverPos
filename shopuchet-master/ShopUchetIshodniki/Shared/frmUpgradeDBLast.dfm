        '1102252942=                                              :G_TOCH' +
        'KA_,'
      
        '1102252943=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102252944=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102252945='
      
        '1102252946=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1102252947=            ELSE BEGIN'
      
        '1102252948=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1102252949=                SELECT 1'
      '1102252950=                  FROM KASSA K'
      '1102252951=                 WHERE K.KASSA = :KASSA_'
      '1102252952=                UNION ALL'
      '1102252953=                SELECT 2'
      '1102252954=                  FROM KASSA_BEZNAL KB'
      '1102252955=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102252956=                 INTO :PAYMENT_TYPE_OLD_;'
      '1102252957='
      
        '1102252958=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102252959=                      PNT_ = '#39'010'#39';'
      
        '1102252960=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1102252961=                                                    1' +
        ',     -- ACTION_'
      
        '1102252962=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1102252963=                                                    :' +
