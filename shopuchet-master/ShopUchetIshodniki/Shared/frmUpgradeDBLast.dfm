        '1102015252=              :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_,' +
        ' :AMOUNT_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '1102015253='
      '1102015254=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '1102015255=            AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ +' +
        ' AMOUNT_PRIHOD_;'
      
        '1102015256=            SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + S' +
        'UMM_PRIHOD_;'
      
        '1102015257=            AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + A' +
        'MOUNT_UHOD_;'
      
        '1102015258=            SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUM' +
        'M_UHOD_;'
      
