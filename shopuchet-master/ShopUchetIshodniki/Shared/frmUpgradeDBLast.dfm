      '110240863=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '110240864=      PNT_ = '#39'25'#39';'
      
        '110240865=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
