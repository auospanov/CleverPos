      '11022898='
      '11022899=ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '110228100=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110228101=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110228102=  DATE_BEGIN_ DATE,'
      '110228103=  DATE_END_ DATE,'
      
        '110228104=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIG' +
        'INT,'
      '110228105=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '110228106=RETURNS ('
      '110228107=  DATE_BEGIN_OUT_ DATE,'
      '110228108=  DATE_END_OUT_ DATE,'
      '110228109=  STR_ VARCHAR(500),'
      '110228110=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '110228111=  NAME VARCHAR(1000),'
      
        '110228112=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110228113=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(150),'
      
        '110228114=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(1' +
        '5,2),'
      '110228115=  AMOUNT_IN /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      
        '110228116=  AMOUNT_PRIHOD /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT */ NUMERIC(18,5),'
      '110228117=  SUMM_PRIHOD NUMERIC(15,2),'
      
        '110228118=  AMOUNT_UHOD /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T */ NUMERIC(18,5),'
      '110228119=  SUMM_UHOD NUMERIC(15,2),'
      
        '110228120=  AMOUNT_SPISANO /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT */ NUMERIC(18,5),'
      '110228121=  SUMM_SPISANO NUMERIC(15,2),'
      
        '110228122=  AMOUNT_VOZVRAT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT */ NUMERIC(18,5),'
      '110228123=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '110228124=  AMOUNT_PRIHOD_SKL /* TYPE OF COLUMN LT_SKLAD_PRODUCT' +
        '.AMOUNT */ NUMERIC(18,5),'
      '110228125=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '110228126=  AMOUNT_UHOD_SKL /* TYPE OF COLUMN LT_SKLAD_PRODUCT.A' +
        'MOUNT */ NUMERIC(18,5),'
      '110228127=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '110228128=  AMOUNT_OUT /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      
        '110228129=  LAST_SUPPLIER /* TYPE OF COLUMN G_CLIENT.NAME */ VAR' +
        'CHAR(250),'
      '110228130=  IS_HEAD INTEGER,'
      '110228131=  ERR_CODE INTEGER,'
      '110228132=  ERR_MSG VARCHAR(1024))'
      '110228133=AS'
      '110228134=BEGIN'
      '110228135=  SUSPEND;'
      '110228136=END'
      '110228137=;'
      '110228138='
      '110228139=ALTER PROCEDURE SYNC_DOWNLOAD('
      '110228140=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110228141=RETURNS ('
      '110228142=  ERR_CODE INTEGER,'
      '110228143=  ERR_MSG VARCHAR(1024),'
      '110228144=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '110228145=AS'
