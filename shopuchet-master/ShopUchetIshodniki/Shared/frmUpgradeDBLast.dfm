        'WHERE AP.OBJECT_TYPE = 2 AND AP.ID = :SKLAD_PARENT_ AND AP.IS_LO' +
        'ADING = 0);'
      '1102282754='
      '1102282755=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
