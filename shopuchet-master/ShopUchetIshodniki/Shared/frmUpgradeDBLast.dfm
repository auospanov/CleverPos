      '110153225='
      '110153226=  /* '#1044#1077#1083#1072#1077#1084' '#1087#1077#1088#1074#1091#1102' '#1073#1091#1082#1074#1091' '#1087#1088#1086#1087#1080#1089#1085#1086#1081' */'
      
        '110153227=  curr_str = UPPER(SUBSTRING(curr_str FROM 1 FOR 1)) |' +
        '| SUBSTRING(curr_str FROM 2);'
      '110153228='
      '110153229=  suspend;'
      '110153230=end'
      '110153231=;'
      '110153232='
