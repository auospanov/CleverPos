        'ATUR_NUM POSITION 6;'
      '1107057='
      
        '1107058=ALTER TABLE P_REP_ZAKAZI_LIST_TABLE ALTER COLUMN NAME PO' +
        'SITION 7;'
      '1107059='
      
        '1107060=ALTER TABLE P_REP_ZAKAZI_LIST_TABLE ALTER COLUMN AMOUNT ' +
        'POSITION 8;'
      '1107061='
      
        '1107062=ALTER TABLE P_REP_ZAKAZI_LIST_TABLE ALTER COLUMN PRICE P' +
        'OSITION 9;'
      '1107063='
      
        '1107064=ALTER TABLE P_REP_ZAKAZI_LIST_TABLE ALTER COLUMN DISCOUN' +
        'T POSITION 10;'
      '1107065='
      
        '1107066=ALTER TABLE P_REP_ZAKAZI_LIST_TABLE ALTER COLUMN SUMM PO' +
        'SITION 11;'
      '1107067='
      
