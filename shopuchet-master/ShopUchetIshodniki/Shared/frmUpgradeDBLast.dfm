        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102462017=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102462018=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102462019=      RETURNING SKLAD'
