        '11044105=  CATEGORY_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VAR' +
        'CHAR(250),'
      
        '11044106=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '11044107=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11044108=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
