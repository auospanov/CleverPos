      '110237218=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '110237219=  IF (CHANGE_CATEGORY_ = 1) THEN BEGIN'
      '110237220=    IF (CHANGE_PRICE_ = 1) THEN'
      '110237221=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110237222='
      
        '110237223=    SQL_STR_ = SQL_STR_ ||'#39'P.G_PRODUCT_PAR = '#39'||:NEW_C' +
        'ATEGORY_;'
