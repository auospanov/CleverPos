        '110751420=            SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE ' +
        'c '#39'||'
      
        '110751421=                       '#39'USING (select CAST('#39#39#39'||ACTION' +
        '_DATE_||'#39#39#39' AS DATE) as K_DATE'#39'||'
      '110751422=                       '#39' from RDB$DATABASE) cd '#39'||'
      '110751423=                       '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '110751424=                       '#39'WHEN MATCHED THEN '#39'||'
      '110751425=                       '#39' UPDATE SET '#39'||'
      
        '110751426=                       '#39'  C.INPUT  = COALESCE((SELECT ' +
        '"OUTPUT" FROM KASSA_BEZNAL_STATE WHERE K_DATE = (SELECT MAX(K_DA' +
        'TE) '#39'||'
      
        '110751427=                                                      ' +
        '                                          '#39' FROM KASSA_BEZNAL_ST' +
        'ATE '#39'||'
      
        '110751428=                                                      ' +
        '                                          '#39' WHERE K_DATE < CD.K_' +
        'DATE) '#39'||'
      
