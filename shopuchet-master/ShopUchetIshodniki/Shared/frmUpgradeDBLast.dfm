      '1102503784=                FROM KASSA_BEZNAL K'
      '1102503785=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1102503786=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1102503787=                 INTO :KASSA_POP_;'
      '1102503788='
      
        '1102503789=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102503790=              PNT_ = '#39'09'#39';'
      
        '1102503791=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' ' +
        #1054#1053#1040' '#1045#1057#1058#1068
      '1102503792=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '1102503793=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
