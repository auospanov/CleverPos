      '1106016181=;'
      '1106016182='
      '1106016183=ALTER PROCEDURE G_GET_G_FIRM_ADDRESS('
      '1106016184=  G_ADDRESS_ TYPE OF COLUMN G_FIRM_ADDRESS.G_ADDRESS)'
      '1106016185=RETURNS ('
      
        '1106016186=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_FIRM_ADDRESS.G_ADD' +
        'RESS_TYPE,'
      
        '1106016187=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_ADDRESS.G_FI' +
        'RM_REKVIZIT,'
      '1106016188=  ADDRESS_ TYPE OF COLUMN G_FIRM_ADDRESS.ADDRESS,'
      '1106016189=  PHONE_ TYPE OF COLUMN G_FIRM_ADDRESS.PHONE,'
      '1106016190=  FAX_ TYPE OF COLUMN G_FIRM_ADDRESS.FAX,'
      
        '1106016191=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_ADDRESS.IS_DEFAUL' +
        'T,'
      '1106016192=  ERR_CODE INTEGER,'
      '1106016193=  ERR_MSG VARCHAR(1024))'
      '1106016194=AS'
      '1106016195=begin'
      
        '1106016196=    select G_ADDRESS_TYPE, G_FIRM_REKVIZIT, ADDRESS, ' +
        'PHONE, FAX, IS_DEFAULT'
      '1106016197=    from G_FIRM_ADDRESS'
      '1106016198=    WHERE g_address = :g_address_'
      
        '1106016199=    into :G_ADDRESS_TYPE_, :G_FIRM_REKVIZIT_, :ADDRES' +
        'S_, :PHONE_, :FAX_, :IS_DEFAULT_;'
      '1106016200=end'
      '1106016201=;'
      '1106016202='
      '1106016203=ALTER PROCEDURE G_GET_G_FIRM_REKVIZIT('
      
        '1106016204=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_F' +
        'IRM_REKVIZIT)'
      '1106016205=RETURNS ('
      
        '1106016206=  G_FIRM_REKVIZIT__ TYPE OF COLUMN G_FIRM_REKVIZIT.G_' +
        'FIRM_REKVIZIT,'
      '1106016207=  NAME_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      
        '1106016208=  SHORT_NAME_ TYPE OF COLUMN G_FIRM_REKVIZIT.SHORT_NA' +
        'ME,'
      '1106016209=  RNN_ TYPE OF COLUMN G_FIRM_REKVIZIT.RNN,'
      '1106016210=  IDN_ TYPE OF COLUMN G_FIRM_REKVIZIT.IDN,'
      '1106016211=  KPP_ TYPE OF COLUMN G_FIRM_REKVIZIT.KPP,'
      '1106016212=  OGRN_ TYPE OF COLUMN G_FIRM_REKVIZIT.OGRN,'
      '1106016213=  KBE_ TYPE OF COLUMN G_FIRM_REKVIZIT.KBE,'
      '1106016214=  OKPO_ TYPE OF COLUMN G_FIRM_REKVIZIT.OKPO,'
      '1106016215=  IS_NDS_ TYPE OF COLUMN G_FIRM_REKVIZIT.IS_NDS,'
      
        '1106016216=  NDS_SERIAL_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_SERI' +
        'AL,'
      '1106016217=  NDS_NUM_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_NUM,'
      '1106016218=  NDS_DATE_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_DATE,'
      
        '1106016219=  NDS_ORGAN_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_ORGAN' +
        ','
      
        '1106016220=  NDS_VALUE_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_VALUE' +
        ','
      
        '1106016221=  NOL_VMESTO_BEZ_ TYPE OF COLUMN G_FIRM_REKVIZIT.NOL_' +
        'VMESTO_BEZ,'
      '1106016222=  HEAD_ TYPE OF COLUMN G_FIRM_REKVIZIT.HEAD,'
      
        '1106016223=  MAIN_CHIEF_ TYPE OF COLUMN G_FIRM_REKVIZIT.MAIN_CHI' +
        'EF,'
      '1106016224=  EMAIL_ TYPE OF COLUMN G_FIRM_REKVIZIT.EMAIL,'
      '1106016225=  WEBSITE_ TYPE OF COLUMN G_FIRM_REKVIZIT.WEBSITE,'
      
        '1106016226=  IP_OR_JUR_ TYPE OF COLUMN G_FIRM_REKVIZIT.IP_OR_JUR' +
        ','
      
        '1106016227=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_REKVIZIT.IS_DEFAU' +
        'LT,'
      '1106016228=  ERR_CODE INTEGER,'
      '1106016229=  ERR_MSG VARCHAR(1024))'
      '1106016230=AS'
      '1106016231=begin'
      
        '1106016232=    select G_FIRM_REKVIZIT, NAME, SHORT_NAME, RNN, ID' +
        'N, KPP, OGRN, KBE, OKPO, IS_NDS, NDS_SERIAL, NDS_NUM, NDS_DATE, ' +
        'NDS_ORGAN, NDS_VALUE,'
      
        '1106016233=           NOL_VMESTO_BEZ, HEAD, MAIN_CHIEF, EMAIL, W' +
        'EBSITE, IP_OR_JUR, IS_DEFAULT'
      '1106016234=    from G_FIRM_REKVIZIT'
      
        '1106016235=    where ((G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_ AND C' +
        'OALESCE(:G_FIRM_REKVIZIT_, 0)  > 0)'
      '1106016236=           OR'
      
        '1106016237=           (IS_DEFAULT = 1 AND COALESCE(:G_FIRM_REKVI' +
        'ZIT_, 0) = 0)'
      '1106016238=          )'
      
        '1106016239=    into :G_FIRM_REKVIZIT__, :NAME_, :SHORT_NAME_, :R' +
        'NN_, :IDN_, :KPP_, :OGRN_, :KBE_, :OKPO_, :IS_NDS_, :NDS_SERIAL_' +
        ', :NDS_NUM_, :NDS_DATE_,'
      
        '1106016240=         :NDS_ORGAN_, :NDS_VALUE_, :NOL_VMESTO_BEZ_, ' +
        ':HEAD_, :MAIN_CHIEF_, :EMAIL_, :WEBSITE_, :IP_OR_JUR_, :IS_DEFAU' +
        'LT_;'
      '1106016241=end'
      '1106016242=;'
      '1106016243='
      '1106016244=ALTER PROCEDURE G_GET_G_OFFICIAL('
      '1106016245=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '1106016246=RETURNS ('
      '1106016247=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '1106016248=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '1106016249=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '1106016250=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106016251=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '1106016252=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '1106016253=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '1106016254=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '1106016255=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '1106016256=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '1106016257=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '1106016258=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTM' +
        'ENT,'
      
        '1106016259=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVO' +
        'DITEL,'
      '1106016260=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '1106016261=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNI' +
        'TEL,'
      '1106016262=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '1106016263=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106016264=  RIGHTS_ARR_ VARCHAR(1000),'
      
        '1106016265=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.DO_NOT' +
        '_SALES_COMM,'
      '1106016266=  ERR_CODE INTEGER,'
      '1106016267=  ERR_MSG VARCHAR(1024))'
      '1106016268=AS'
      
        '1106016269=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_I' +
        'TEM.RIGHTS_ITEM;'
      '1106016270=begin'
      
        '1106016271=    select FM, NM, FT, FIO_DOC, RNN, IDN, DT, G_ID_KI' +
        'ND, ID_NUM, ID_DATE, ID_ISSUER, G_APPOINTMENT,'
      
        '1106016272=           IS_RUKOVODITEL, IS_GLAVBUH, IS_ISPOLNITEL,' +
        ' PASS, G_TOCHKA, DO_NOT_SALES_COMM'
      '1106016273=    from G_OFFICIAL'
      '1106016274=    where G_OFFICIAL = :G_OFFICIAL_'
      
        '1106016275=    into :FM_, :NM_, :FT_, :FIO_DOC_, :RNN_, :IDN_, :' +
        'DT_, :G_ID_KIND_, :ID_NUM_, :ID_DATE_, :ID_ISSUER_, :G_APPOINTME' +
        'NT_,'
      
        '1106016276=         :IS_RUKOVODITEL_, :IS_GLAVBUH_, :IS_ISPOLNIT' +
        'EL_, :PASSWORD_, :G_TOCHKA_, :DO_NOT_SALES_COMM_;'
      '1106016277='
      '1106016278=    -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1052#1040#1057#1057#1048#1042' '#1055#1056#1040#1042
      '1106016279=    FOR SELECT RIGHTS_ITEM'
      '1106016280=        FROM G_OFFICIAL_RIGHT'
      '1106016281=       WHERE G_OFFICIAL = :G_OFFICIAL_'
      '1106016282=        INTO :RIGHTS_ITEM_'
      '1106016283=    DO BEGIN'
      '1106016284=      if (RIGHTS_ARR_ IS NULL) then'
      
        '1106016285=        RIGHTS_ARR_ = '#39'-'#39'||CAST(RIGHTS_ITEM_ AS VARCH' +
        'AR(5))||'#39'-'#39';'
      '1106016286=      ELSE'
      
        '1106016287=        RIGHTS_ARR_ = RIGHTS_ARR_||CAST(RIGHTS_ITEM_ ' +
        'AS VARCHAR(5))||'#39'-'#39';'
      '1106016288=    END'
      '1106016289=end'
      '1106016290=;'
      '1106016291='
      '1106016292=ALTER PROCEDURE G_GET_G_PRIHOD_RASHOD('
      
        '1106016293=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_P' +
        'RIHOD_RASHOD)'
      '1106016294=RETURNS ('
      '1106016295=  ACTION_ TYPE OF COLUMN G_PRIHOD_RASHOD.DO_ACTION,'
      '1106016296=  NAME_ TYPE OF COLUMN G_PRIHOD_RASHOD.NAME,'
      '1106016297=  ERR_CODE INTEGER,'
      '1106016298=  ERR_MSG VARCHAR(1024))'
      '1106016299=AS'
      '1106016300=begin'
      '1106016301=    select G_PRIHOD_RASHOD, DO_ACTION, NAME'
      '1106016302=    from G_PRIHOD_RASHOD'
      '1106016303=    WHERE'
      '1106016304=        G_PRIHOD_RASHOD =: G_PRIHOD_RASHOD_'
      '1106016305=    into :G_PRIHOD_RASHOD_, :ACTION_, :NAME_;'
      '1106016306=end'
      '1106016307=;'
      '1106016308='
      '1106016309=ALTER PROCEDURE G_GET_G_PRODUCT_BY_BARCODE('
      '1106016310=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106016311=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106016312=  NOMER_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_NUM,'
      '1106016313=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106016314=  PREFIX_ VARCHAR(2))'
      '1106016315=RETURNS ('
      '1106016316=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1106016317=  G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT_PAR,'
      '1106016318=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1106016319=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1106016320=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106016321=  ERR_CODE INTEGER,'
      '1106016322=  ERR_MSG VARCHAR(1024))'
      '1106016323=AS'
      
        '1106016324=declare variable PROCNAME varchar(26) = '#39'G_GET_G_PROD' +
        'UCT_BY_BARCODE'#39';'
      '1106016325=BEGIN'
      '1106016326='
      '1106016327=  IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN BEGIN'
      '1106016328=    ERR_CODE = -20500;'
      
        '1106016329=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1064#1090#1088#1080#1093#1082#1086#1076 +
        ' '#1087#1091#1089#1090'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1106016330=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106016331=    EXIT;'
      '1106016332=  END'
      '1106016333='
      
        '1106016334=    IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) T' +
        'HEN BEGIN'
      '1106016335=        SELECT T.G_PRODUCT_PAR,'
      '1106016336=               T.G_PRODUCT,'
      '1106016337=               T.PRICE,'
      '1106016338=               T.VOLUME_PRICE'
      '1106016339=          FROM G_PRODUCT T'
      
        '1106016340=          WHERE SUBSTRING(T.BARCODE FROM 3 FOR 5) = S' +
        'UBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '1106016341=          INTO :G_PRODUCT_CATEGORY_,'
      '1106016342=               :G_PRODUCT_,'
      '1106016343=               :PRICE_,'
      '1106016344=               :VOLUME_PRICE_;'
      '1106016345='
      
        '1106016346=        AMOUNT_ = ROUND(CAST(SUBSTRING(BARCODE_ FROM ' +
        '8 FOR 5) AS NUMERIC)/1000.00, 2);'
      '1106016347=    END ELSE'
      '1106016348=        SELECT T.G_PRODUCT_PAR,'
      '1106016349=               T.G_PRODUCT,'
      '1106016350=               T.PRICE,'
      '1106016351=               T.VOLUME_PRICE'
      '1106016352=          FROM G_PRODUCT T'
      '1106016353=          WHERE T.BARCODE = :BARCODE_'
      '1106016354=          INTO :G_PRODUCT_CATEGORY_,'
      '1106016355=               :G_PRODUCT_,'
      '1106016356=               :PRICE_,'
      '1106016357=               :VOLUME_PRICE_;'
      '1106016358='
      '1106016359=    if (ROW_COUNT = 0) then BEGIN'
      
        '1106016360=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' ' +
        #1044#1054#1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '1106016361=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_)' +
        ' THEN'
      '1106016362=          SELECT T.G_PRODUCT_PAR,'
      '1106016363=                 T.G_PRODUCT,'
      '1106016364=                 T.PRICE,'
      '1106016365=                 T.VOLUME_PRICE'
      '1106016366=            FROM G_PRODUCT T, LT_BARCODE D'
      '1106016367=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      
        '1106016368=              AND SUBSTRING(D.BARCODE FROM 3 FOR 5) =' +
        ' SUBSTRING(:BARCODE_ FROM 3 FOR 5)'
      '1106016369=            INTO'
      '1106016370=                :G_PRODUCT_CATEGORY_,'
      '1106016371=                :G_PRODUCT_,'
      '1106016372=                :PRICE_,'
      '1106016373=                :VOLUME_PRICE_;'
      '1106016374=      ELSE'
      '1106016375=          SELECT T.G_PRODUCT_PAR,'
      '1106016376=                 T.G_PRODUCT,'
      '1106016377=                 T.PRICE,'
      '1106016378=                 T.VOLUME_PRICE'
      '1106016379=            FROM G_PRODUCT T, LT_BARCODE D'
      '1106016380=            WHERE T.G_PRODUCT = D.G_PRODUCT'
      '1106016381=              AND D.BARCODE = :BARCODE_'
      '1106016382=            INTO'
      '1106016383=                :G_PRODUCT_CATEGORY_,'
      '1106016384=                :G_PRODUCT_,'
      '1106016385=                :PRICE_,'
      '1106016386=                :VOLUME_PRICE_;'
      '1106016387='
      '1106016388=      if (ROW_COUNT = 0) then BEGIN'
      '1106016389=          ERR_CODE = -20500;'
      
        '1106016390=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||BARCODE_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1106016391=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1106016392=          EXIT;'
      '1106016393=      END'
      '1106016394=    END'
      '1106016395='
      
        '1106016396=  /*END ELSE if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) th' +
        'en BEGIN'
      '1106016397=    SELECT T.G_PRODUCT_PAR,'
      '1106016398=        T.G_PRODUCT,'
      '1106016399=        T.PRICE,'
      '1106016400=        T.VOLUME_PRICE'
      '1106016401=    FROM G_PRODUCT T'
      '1106016402=    WHERE T.ARTICUL = :ARTICUL_'
      '1106016403=    INTO'
      '1106016404=        G_PRODUCT_CATEGORY_,'
      '1106016405=        :G_PRODUCT_,'
      '1106016406=        :PRICE_,'
      '1106016407=        :VOLUME_PRICE_;'
      '1106016408='
      '1106016409=    if (ROW_COUNT = 0) then BEGIN'
      '1106016410=      ERR_CODE = -20500;'
      
        '1106016411=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES (:ERR_M' +
        'SG);'
      '1106016412=      ERR_MSG = PROCNAME||ERR_MSG;'
      '1106016413=      EXIT;'
      '1106016414=    END'
      '1106016415='
      
        '1106016416=  END ELSE if (CHAR_LENGTH(TRIM(:NOMER_)) > 0) then B' +
        'EGIN'
      '1106016417=    SELECT T.G_PRODUCT_PAR,'
      '1106016418=        T.G_PRODUCT,'
      '1106016419=        T.PRICE,'
      '1106016420=        T.VOLUME_PRICE'
      '1106016421=    FROM G_PRODUCT T'
      '1106016422=    WHERE T.NOMENCLATUR_NUM = :NOMER_'
      '1106016423=    INTO'
      '1106016424=        G_PRODUCT_CATEGORY_,'
      '1106016425=        :G_PRODUCT_,'
      '1106016426=        :PRICE_,'
      '1106016427=        :VOLUME_PRICE_;'
      '1106016428='
      '1106016429=    if (ROW_COUNT = 0) then BEGIN'
      '1106016430=      ERR_CODE = -20500;'
      
        '1106016431=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083#1072#1090#1091#1088#1085#1099#1084' '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMER_||'#39' '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '1106016432=      ERR_MSG = PROCNAME||ERR_MSG;'
      '1106016433=      EXIT;'
      '1106016434=    END'
      '1106016435='
      
        '1106016436=  END ELSE if (CHAR_LENGTH(TRIM(:NAME_)) > 0) then BE' +
        'GIN'
      
        '1106016437=      --'#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MAX '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042#1044#1056#1059#1043' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1058 +
        #1054#1042#1040#1056#1054#1042' '#1057' '#1058#1040#1050#1048#1052' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1052
      '1106016438=      EXECUTE STATEMENT'
      
        '1106016439=      '#39'SELECT G_PRODUCT, G_PRODUCT_PAR, PRICE FROM G_' +
        'PRODUCT '#39'||'
      '1106016440=      '#39' WHERE G_PRODUCT = '#39'||'
      
        '1106016441=                  '#39'(SELECT MAX(G_PRODUCT) FROM G_PROD' +
        'UCT '#39'||'
      
        '1106016442=                  '#39' WHERE UPPER(NAME) LIKE '#39#39'%'#39'||:NAM' +
        'E_||'#39'%'#39#39')'#39
      
        '1106016443=      INTO :G_PRODUCT_, :G_PRODUCT_CATEGORY_, :PRICE_' +
        ' ;'
      '1106016444=      if (G_PRODUCT_ = 0) then BEGIN'
      '1106016445=          ERR_CODE = -20500;'
      
        '1106016446=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1077#1084' "'#39'||NAME_||'#39'" '#1085#1077' '#1085#1072#1081#1076#1077#1085'.'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '1106016447=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1106016448=          EXIT;'
      '1106016449=      END'
      '1106016450=  END  */'
      '1106016451=end'
      '1106016452=;'
      '1106016453='
      '1106016454=ALTER PROCEDURE G_GET_G_UNIT('
      '1106016455=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT)'
      '1106016456=RETURNS ('
      '1106016457=  NAME_ TYPE OF COLUMN G_UNIT.NAME,'
      '1106016458=  SHORT_NAME_ TYPE OF COLUMN G_UNIT.SHORT_NAME,'
      '1106016459=  ERR_CODE INTEGER,'
      '1106016460=  ERR_MSG VARCHAR(1024))'
      '1106016461=AS'
      '1106016462=begin'
      '1106016463=    SELECT D.NAME, D.SHORT_NAME'
      '1106016464=    FROM G_UNIT D'
      '1106016465=    WHERE d.G_UNIT = :G_UNIT_'
      '1106016466=    INTO :NAME_, :SHORT_NAME_;'
      '1106016467=end'
      '1106016468=;'
      '1106016469='
      '1106016470=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '1106016471=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1106016472=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1106016473=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM,'
      '1106016474=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106016475=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106016476=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1106016477=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1106016478=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1106016479=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1106016480=  SELF_PRICE_ NUMERIC(15,2),'
      '1106016481=  AMOUNT_ MY_NUMERIC_5,'
      '1106016482=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1106016483=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1106016484=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1106016485=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1106016486=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1106016487=  IS_THIS_LAST_ INTEGER,'
      '1106016488=  UPDATE_IF_EXIST_ INTEGER)'
      '1106016489=RETURNS ('
      '1106016490=  ERR_CODE INTEGER,'
      '1106016491=  ERR_MSG VARCHAR(1024))'
      '1106016492=AS'
      
        '1106016493=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_P' +
        'RODUCT'#39';'
      '1106016494=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106016495=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1106016496=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT' +
        ';'
      
        '1106016497=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT = 0;'
      
        '1106016498=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1106016499=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD;'
      
        '1106016500=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1106016501=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM_CURRENCY;'
      '1106016502=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1106016503=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106016504=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      
        '1106016505=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1106016506=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1106016507=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1106016508=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1106016509=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1106016510=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1106016511=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1106016512=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106016513=BEGIN'
      '1106016514=    ERR_MSG = '#39#39';'
      '1106016515='
      '1106016516=    SELECT ID'
      '1106016517=      FROM CUR_PARAMS'
      '1106016518=    WHERE CUR_PARAMS = 2'
      '1106016519=      INTO :G_TOCHKA_;'
      '1106016520='
      '1106016521=    SELECT G.G_UNIT'
      '1106016522=      FROM G_UNIT G'
      
        '1106016523=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAM' +
        'E_G_UNIT_))'
      '1106016524=      INTO :G_UNIT_;'
      '1106016525=    if (ROW_COUNT = 0) then'
      '1106016526=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1106016527='
      '1106016528=    PNT_ = '#39'02'#39';'
      
        '1106016529=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1106016530=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1106016531=        SELECT G.G_PRODUCT,'
      '1106016532=               G.NAME'
      '1106016533=          FROM G_PRODUCT G'
      
        '1106016534=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1106016535=           AND TRIM(G.ARTICUL) <> '#39#39
      '1106016536=          INTO :G_PRODUCT_,'
      '1106016537=               :G_PRODUCT_NAME_;'
      '1106016538='
      
        '1106016539=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
