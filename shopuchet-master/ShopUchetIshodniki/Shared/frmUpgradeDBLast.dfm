      '1106017841=ALTER PROCEDURE G_UPD_G_ACCOUNT('
      '1106017842=  G_ACCOUNT_ TYPE OF COLUMN G_ADDRESS.G_ADDRESS,'
      '1106017843=  ACCOUNT_ TYPE OF COLUMN G_ACCOUNT.ACCOUNT,'
      '1106017844=  G_CLIENT_ TYPE OF COLUMN G_ACCOUNT.G_CLIENT,'
      '1106017845=  G_BANK_ TYPE OF COLUMN G_ACCOUNT.G_BANK,'
      '1106017846=  IS_DEFAULT_ TYPE OF COLUMN G_ACCOUNT.IS_DEFAULT)'
      '1106017847=RETURNS ('
      '1106017848=  ERR_CODE INTEGER,'
      '1106017849=  ERR_MSG VARCHAR(1024))'
      '1106017850=AS'
      '1106017851=begin'
      
        '1106017852=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106017853=  IF (:IS_DEFAULT_ = 1) THEN'
      '1106017854=    UPDATE G_ACCOUNT G'
      '1106017855=       SET G.IS_DEFAULT = 0'
      '1106017856=     WHERE G.G_CLIENT = :G_CLIENT_;'
      '1106017857='
      '1106017858=  UPDATE G_ACCOUNT'
      '1106017859=  SET'
      '1106017860=   ACCOUNT  =  COALESCE(:ACCOUNT_, ACCOUNT),'
      '1106017861=   G_CLIENT  =  COALESCE(:G_CLIENT_, G_CLIENT),'
      '1106017862=   G_BANK  =  COALESCE(:G_BANK_, G_BANK),'
      '1106017863=   IS_DEFAULT  =  COALESCE(:IS_DEFAULT_, IS_DEFAULT)'
      '1106017864=  WHERE'
      '1106017865=    G_ACCOUNT = :G_ACCOUNT_;'
      '1106017866=end'
      '1106017867=;'
      '1106017868='
      '1106017869=ALTER PROCEDURE G_UPD_G_ADDRESS('
      '1106017870=  G_ADDRESS_ TYPE OF COLUMN G_ADDRESS.G_ADDRESS,'
      
        '1106017871=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_ADDRESS.G_ADDRESS_' +
        'TYPE,'
      '1106017872=  G_CLIENT_ TYPE OF COLUMN G_ADDRESS.G_CLIENT,'
      '1106017873=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '1106017874=  PHONE_ TYPE OF COLUMN G_ADDRESS.PHONE,'
      '1106017875=  FAX_ TYPE OF COLUMN G_ADDRESS.FAX,'
      '1106017876=  EMAIL_ TYPE OF COLUMN G_ADDRESS.EMAIL,'
      '1106017877=  WEBSITE_ TYPE OF COLUMN G_ADDRESS.WEBSITE,'
      '1106017878=  IS_DEFAULT_ TYPE OF COLUMN G_ADDRESS.IS_DEFAULT)'
      '1106017879=RETURNS ('
      '1106017880=  ERR_CODE INTEGER,'
      '1106017881=  ERR_MSG VARCHAR(1024))'
      '1106017882=AS'
      '1106017883=begin'
      
        '1106017884=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106017885=  IF (:IS_DEFAULT_ = 1) THEN'
      '1106017886=    UPDATE G_ADDRESS G'
      '1106017887=       SET G.IS_DEFAULT = 0'
      '1106017888=     WHERE G.G_CLIENT = :G_CLIENT_;'
      '1106017889='
      '1106017890=  UPDATE G_ADDRESS'
      '1106017891=  SET'
      '1106017892=   G_ADDRESS_TYPE = :G_ADDRESS_TYPE_,'
      '1106017893=   G_CLIENT =       :G_CLIENT_,'
      '1106017894=   ADDRESS  =       :ADDRESS_,'
      '1106017895=   PHONE    =       :PHONE_,'
      '1106017896=   FAX      =       :FAX_,'
      '1106017897=   EMAIL    =       :EMAIL_,'
      '1106017898=   WEBSITE  =       :WEBSITE_,'
      '1106017899=   IS_DEFAULT   =   :IS_DEFAULT_'
      '1106017900=  WHERE'
      '1106017901=    G_ADDRESS = :G_ADDRESS_;'
      '1106017902=end'
      '1106017903=;'
      '1106017904='
      '1106017905=ALTER PROCEDURE G_UPD_G_ADDRESS_TYPE('
      
        '1106017906=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_ADDRESS_TYPE.G_ADD' +
