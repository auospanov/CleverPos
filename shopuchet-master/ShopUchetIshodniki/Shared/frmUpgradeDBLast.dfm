      '1102283200='
      '1102283201=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102283202=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102283203=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102283204='
      
        '1102283205=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1102283206=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
