      '11096589=          END'
      '11096590='
      '11096591=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '11096592=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '11096593=                FROM ZAKAZ_DETAILS_TMP Z'
      '11096594=              INTO :G_PRODUCT_,'
      '11096595=                  :Z_AMOUNT_,'
      '11096596=                  :PRICE_,'
      '11096597=                  :SUMMM_'
      '11096598=          DO BEGIN'
      '11096599=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '11096600=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1053#1045#1058
      '11096601=            IS_THIS_LAST_ = 0;'
      '11096602=            SELECT MAX(SK.DATE_RECEIPT)'
      '11096603=                FROM SKLAD SK'
      '11096604=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11096605=                 AND SK.IS_LAST = 1'
      '11096606=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '11096607=                INTO :DATE_LAST_;'
      '11096608='
      
        '11096609=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALESCE' +
        '(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040 +
        ' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11096610=                UPDATE SKLAD SK'
      '11096611=                   SET SK.IS_LAST = 0'
      '11096612=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '11096613=                   AND SK.IS_LAST = 1'
      '11096614=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '11096615='
      '11096616=                IS_THIS_LAST_ = 1;'
      '11096617=            END'
      '11096618='
      '11096619='
      '11096620=            INSERT INTO SKLAD'
      '11096621=            ('
      '11096622=             SKLAD,'
      '11096623=             SKLAD_PARENT,'
      '11096624=             DATE_RECEIPT,'
      '11096625=             G_CLIENT,'
