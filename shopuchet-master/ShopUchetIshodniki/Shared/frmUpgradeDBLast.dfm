      '11026941=  END'
      '11026942='
      '11026943=  -- '#1055#1056#1048#1061#1054#1044
      '11026944=  FIRST_ITER = 0;'
      
        '11026945=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2, ' +
        #39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39#39'0'#39#39 +
        ')||'#39#39'.'#39#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receipt' +
        ' AS VARCHAR(10)) DATE_STR'
      '11026946=           ,S.date_receipt'
      '11026947=           ,GP.ARTICUL'
      '11026948=           ,GP.BARCODE'
      '11026949=           ,GP.NAME'
      '11026950=           ,SUM(SD.AMOUNT)  AMOUNT'
      '11026951=           ,SUM(SD.summ)    SUMM'
      '11026952=      FROM SKLAD_PARENT S'
      '11026953=           ,SKLAD SD'
      '11026954=           ,G_PRODUCT GP'
      '11026955=     WHERE S.is_vozvrat = 0'
      '11026956=       AND S.sklad = SD.sklad_parent'
      '11026957=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '11026958=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11026959=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '11026960=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '11026961=     GROUP BY S.date_receipt, GP.articul, GP.barcode, G' +
        'P.NAME'
      '11026962=     INTO :date_str,'
      '11026963=           :Z_DATE,'
      '11026964=           :ARTICUL,'
      '11026965=           :BARCODE,'
      '11026966=           :NAME,'
      '11026967=           :AMOUNT,'
      '11026968=           :SUMM'
      '11026969=  DO BEGIN'
      '11026970=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '11026971=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR)'
      '11026972=      VALUES (6, 1, '#39#39#1055#1088#1080#1093#1086#1076' '#1090#1086#1074#1072#1088#1072#39#39');'
      '11026973=      FIRST_ITER = 1;'
      '11026974=    END'
      '11026975='
      
        '11026976=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '11026977=      VALUES (7, 10, :DATE_STR, :z_date,  :ARTICUL, :BA' +
        'RCODE, :NAME, :AMOUNT, :SUMM);'
      '11026978=  END'
      '11026979='
      '11026980=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '11026981=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '11026982=        VALUES (8, 2, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39#39', COALESCE((SELEC' +
        'T SUM(K.summ)'
      
        '11026983=                                                 FROM K' +
        'ASSA K'
      
        '11026984=                                                WHERE E' +
        'XISTS (SELECT 1'
      
        '11026985=                                                       ' +
        '         FROM sklad_parent P'
      
        '11026986=                                                       ' +
        '        WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11026987=                                                       ' +
        '          AND P.G_TOCHKA = :G_TOCHKA_'
      
        '11026988=                                                       ' +
        '          AND P.is_vozvrat = 0'
      
        '11026989=                                                       ' +
        '          AND P.sklad = K.SKLAD'
      
        '11026990=                                                       ' +
        '          AND P.date_receipt = K.action_date)),0)'
      '11026991=               )'
      '11026992=      RETURNING'
      '11026993=        SUMM'
      '11026994=      INTO'
      '11026995=        :summ_rashod_all_;'
      '11026996='
      
        '11026997=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '11026998=        VALUES (9, 2, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39#39', COALESCE((SE' +
        'LECT SUM(K.summ)'
      
        '11026999=                                                     FR' +
        'OM KASSA_BEZNAL K'
      
        '110261000=                                                    WH' +
        'ERE EXISTS (SELECT 1'
      
        '110261001=                                                      ' +
        '              FROM sklad_parent P'
      
        '110261002=                                                      ' +
