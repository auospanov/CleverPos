        'Z_REAL_PARENT_,'
      '1102491292=                  :G_PRODUCT,'
      
        '1102491293=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1102491294=                  :AMOUNT, :SUMM,'
      '1102491295=                  0, --AMOUNT_PAYED,'
      '1102491296=                  0, --SUMM_PAYED,'
      '1102491297=                  0, --IS_PAYED_ALL,'
      '1102491298=                  :DISCOUNT_PERC,'
      '1102491299=                  :DISCOUNT_TENGE,'
