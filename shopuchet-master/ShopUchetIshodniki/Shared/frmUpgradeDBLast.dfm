        '5,2),'
      
        '110103257=  SUMM /* TYPE OF COLUMN SKLAD_TMP.SUMM */ NUMERIC(15,' +
        '2),'
      
        '110103258=  PRICE_CURRENCY /* TYPE OF COLUMN SKLAD.PRICE_CURRENC' +
        'Y */ NUMERIC(15,2),'
      
        '110103259=  SUMM_CURRENCY /* TYPE OF COLUMN SKLAD.SUMM_CURRENCY ' +
        '*/ NUMERIC(15,2),'
      
        '110103260=  NDS /* TYPE OF COLUMN SKLAD_TMP.NDS */ NUMERIC(15,2)' +
        ','
      
        '110103261=  NDS_SUMM /* TYPE OF COLUMN SKLAD_TMP.NDS_SUMM */ NUM' +
        'ERIC(15,2),'
      
        '110103262=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250' +
        '),'
      
        '110103263=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(30),'
      
        '110103264=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110103265=  CHARGE_ROZN_PROC /* TYPE OF COLUMN SKLAD_TMP.CHARGE_' +
        'ROZN_PROC */ NUMERIC(15,2),'
      
        '110103266=  PRICE_ROZN /* TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN */' +
        ' NUMERIC(15,2),'
      
        '110103267=  CHARGE_OPT_PROC /* TYPE OF COLUMN SKLAD_TMP.CHARGE_O' +
        'PT_PROC */ NUMERIC(15,2),'
      
        '110103268=  PRICE_OPT /* TYPE OF COLUMN SKLAD_TMP.PRICE_OPT */ N' +
        'UMERIC(15,2))'
