      '110225997=     :OSNOVANIE_,'
      '110225998=     :NOTE_,'
      '110225999=     :RNDS_,'
      '1102251000=     :RNDS_SUMM_,'
      
        '1102251001=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056 +
        #1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059 +
        #1044#1045#1058' 0'
      '1102251002=     :IS_VOZVRAT_,'
      '1102251003=     :G_TOCHKA_'
      '1102251004=     ,:PRICE_CURRENCY_'
      '1102251005=     ,:SUMM_CURRENCY_TMP_'
      '1102251006=     ,:MARK_CODE_'
      '1102251007=     ,:COST_PRICE_'
      '1102251008=    );'
      '1102251009='
      
        '1102251010=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1102251011=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102251012=        PNT_ = '#39'02'#39';'
      '1102251013=        UPDATE LT_SKLAD_PRODUCT L'
      '1102251014=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '1102251015=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102251016=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1102251017=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102251018='
      '1102251019=        IF (ROW_COUNT = 0) THEN'
      
        '1102251020=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT' +
        ')'
      
        '1102251021=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :R' +
        'G_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102251022=    END'
      '1102251023='
      
        '1102251024=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061 +
        #1054#1044#1045
      '1102251025=      UPDATE G_PRODUCT G'
      '1102251026=         SET G.PRICE = :SALE_PRICE_'
      '1102251027=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '1102251028=  END'
      '1102251029=  ----------------------------------------'
      '1102251030='
      
        '1102251031=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1102251032=  PNT_ = '#39'05'#39';'
      
        '1102251033=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1102251034=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1102251035=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102251036=      ELSE'
      '1102251037=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1102251038='
      
        '1102251039=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1102251040=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1102251041=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102251042=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1102251043=                                        :SUMM_FACT_,'
      
        '1102251044=                                        :DATE_RECEIPT' +
        '_,'
      
        '1102251045=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1102251046=                                        NULL,   --ZAK' +
        'AZ_'
      '1102251047=                                        :SKLAD_,'
      
        '1102251048=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1102251049=                                        :G_TOCHKA_,'
      
        '1102251050=                                        :UPLOAD_TO_EX' +
        'T_APP_'
      
        '1102251051=                                        ) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102251052=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102251053=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102251054=            EXIT;'
      '1102251055=          END'
      '1102251056=      END ELSE BEGIN'
      '1102251057=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102251058=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102251059=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102251060=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102251061=            ELSE'
      
        '1102251062=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102251063='
      '1102251064=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102251065=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102251066='
      
        '1102251067=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102251068='
      '1102251069=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102251070=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102251071=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1102251072=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1102251073=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1102251074=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102251075=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1102251076=                                              :SKLAD_' +
        ','
      
        '1102251077=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1102251078=                                              :G_TOCH' +
        'KA_,'
      
        '1102251079=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102251080=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102251081=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102251082=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102251083=                  EXIT;'
      '1102251084=                END'
      '1102251085=            END'
      '1102251086=          END'
      '1102251087=      END'
      '1102251088=  END'
      '1102251089='
      '1102251090=  -- 28.04.2022'
      
        '1102251091=  -- '#1045#1057#1051#1048' '#1054#1060#1054#1056#1052#1051#1071#1045#1058#1057#1071' '#1042#1054#1047#1042#1056#1040#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1058#1054' '#1053 +
        #1040#1044#1054' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042' '#1047#1040' '#1069#1058#1059' '#1055#1056#1054#1044#1040#1046#1059
      
        '1102251092=  -- '#1055#1056#1048#1063#1045#1052' '#1042#1045#1056#1053#1059#1058#1068' '#1048#1047' '#1042#1057#1045#1049' '#1055#1056#1054#1044#1040#1046#1048' '#1052#1054#1043#1059#1058' '#1058#1054#1051#1068#1050#1054' '#1063#1040#1057#1058 +
        #1068', '#1055#1054#1069#1058#1054#1052#1059' '#1053#1040#1044#1054' '#1057#1063#1048#1058#1040#1058#1068
      
        '1102251093=  -- '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1050' '#1052#1054#1052#1045#1053#1058#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1052#1054#1046#1045#1058' '#1048#1047#1052#1045#1053#1048#1058#1068 +
        #1057#1071', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1050#1040#1050#1054#1049' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1058#1054#1043#1044#1040' '#1041#1067#1051
      
        '1102251094=  -- '#1055#1054' '#1061#1054#1056#1054#1064#1045#1052#1059' '#1045#1065#1045' '#1053#1040#1044#1054' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1043#1054' '#1055#1056#1054 +
        #1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1042' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1048#1048' '#1057' '#1051#1045#1057#1045#1053#1050#1054#1049', '#1053#1054' '#1055#1054#1050#1040' '#1053#1045' '#1041#1059#1044#1059' '#1069#1058#1054#1043#1054' '#1044#1045#1051 +
        #1040#1058#1068
      
        '1102251095=  IF (ZAKAZ_ IS NOT NULL AND IS_VOZVRAT_ = 1) THEN BE' +
        'GIN'
      '1102251096=     /*SELECT Z.SUMM_BONUS_GOT,'
      '1102251097=            Z.SUMM'
      '1102251098=       FROM ZAKAZ Z'
      '1102251099=      WHERE ZAKAZ = :ZAKAZ_'
      '1102251100=       INTO :SUMM_BONUS_GOT_,'
      '1102251101=            :ZAKAZ_SUMM_;'
      '1102251102='
      '1102251103=     IF (ZAKAZ_SUMM_ = SUMM_) THEN'
      '1102251104=       BONUS_TO_MINUS_ = SUMM_BONUS_GOT_;'
      '1102251105='
      '1102251106=     ELSE BEGIN'
      
        '1102251107=       BONUS_PERCENT_ = SUMM_BONUS_GOT_ / ZAKAZ_SUMM_' +
        ';  -- '#1053#1040#1061#1054#1046#1059' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058
      '1102251108='
      
        '1102251109=       BONUS_TO_MINUS_ = ROUND(SUMM_ * BONUS_PERCENT_' +
        ', 2);   -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040#1058#1040
      '1102251110=     END'
      '1102251111='
      '1102251112=     UPDATE G_DISCONT_CARD G'
      '1102251113=        SET G.SUMM = G.SUMM - :BONUS_TO_MINUS_,'
      '1102251114=            G.SUMM_ALL = G.SUMM_ALL - :SUMM_'
      '1102251115=      WHERE G.G_CLIENT = :G_CLIENT_;*/'
      '1102251116='
      '1102251117=    SELECT G.SUMM'
      '1102251118=      FROM G_DISCONT_CARD G'
      '1102251119=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102251120=      INTO :SUMM_BONUS_;'
      '1102251121='
      '1102251122=    IF (:SUMM_BONUS_ > 0) THEN BEGIN'
      '1102251123=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '1102251124=              SUM(Z.SUMM)'
      '1102251125=         FROM ZAKAZ Z'
      '1102251126=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '1102251127=         INTO :SUMM_BONUS_GOT_,'
      '1102251128=              :SUMM_ALL_;'
      '1102251129='
      
        '1102251130=       SELECT ROUND( SUM(SP.SUMM * (Z.SUMM_BONUS_GOT ' +
        '/ Z.SUMM)), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042 +
        #1056#1040#1058#1040
      '1102251131=              SUM(SP.SUMM)'
      '1102251132=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '1102251133=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '1102251134=          AND SP.ZAKAZ = Z.ZAKAZ'
      '1102251135=         INTO :BONUS_TO_MINUS_,'
      '1102251136=              :SUMM_TO_MINUS_;'
      '1102251137='
      '1102251138=       UPDATE G_DISCONT_CARD G'
      
        '1102251139=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_M' +
        'INUS_,'
      
        '1102251140=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINU' +
        'S_'
      '1102251141=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '1102251142=    END'
      '1102251143=  END'
      '1102251144='
      '1102251145=  DELETE FROM SKLAD_TMP;'
      '1102251146='
      
        '1102251147=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1102251148=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102251149=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1102251150=                                  G_PRIHOD_,'
      '1102251151=                                  :SUMM_PRIHOD_,'
      '1102251152=                                  :DATE_RECEIPT_,'
      
        '1102251153=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102251154=                                  NULL,   --:ZAKAZ_,'
      '1102251155=                                  :SKLAD_,'
      '1102251156=                                  :G_PAYMENT_TYPE_,'
      '1102251157=                                  :G_TOCHKA_,'
      '1102251158=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102251159=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102251160=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102251161=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102251162=      EXIT;'
      '1102251163=    END'
      '1102251164=  END'
      '1102251165='
      
        '1102251166=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102251167=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, ' +
        '1, 2)) THEN'
      
        '1102251168=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      '1102251169=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '1102251170=            2,'
      '1102251171=            :SKLAD_,'
      '1102251172=            1,'
      
        '1102251173=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1' +
        ' ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052 +
        ' '#1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102251174=           );'
      '1102251175='
      '1102251176=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102251177=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1102251178=END'
      '1102251179=;'
      '1102251180='
      '1102251181=ALTER PROCEDURE P_REP_AKT_SVERKI('
      '1102251182=  DATE_BEGIN_ DATE,'
      '1102251183=  DATE_END_ DATE,'
      '1102251184=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1102251185=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102251186=  CLIENT_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1102251187=  CLIENT_DIR_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      
        '1102251188=  G_FIRM_IN_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_FIRM_RE' +
        'KVIZIT,'
      '1102251189=  FIRM_NAME_IN_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '1102251190=  G_OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102251191=  CURRENCY_ INTEGER,'
      '1102251192=  MODE_ SMALLINT)'
      '1102251193=RETURNS ('
      '1102251194=  STR1_ VARCHAR(500),'
      '1102251195=  STR2_ VARCHAR(700),'
      '1102251196=  STR3_ VARCHAR(500),'
      '1102251197=  STR3_DOWN_ VARCHAR(500),'
      '1102251198=  STR4_ VARCHAR(500),'
      '1102251199=  STR5_ VARCHAR(500),'
      '1102251200=  STR_SALDO_IN_ VARCHAR(50),'
      '1102251201=  STR_SALDO_OUT_ VARCHAR(50),'
      '1102251202=  STR_OT1_ VARCHAR(500),'
      '1102251203=  STR_OT2_ VARCHAR(500),'
      '1102251204=  DEBET_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102251205=  DEBET_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102251206=  CREDIT_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102251207=  CREDIT_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102251208=  DEBET_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102251209=  CREDIT_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102251210=  FIRM_NAME_OUT_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '1102251211=  CLIENT_NAME_OUT_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1102251212=  STR_TEXT VARCHAR(100),'
      '1102251213=  OPER_DATE TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '1102251214=  SUMM_DEBET TYPE OF COLUMN SKLAD.SUMM,'
      '1102251215=  SUMM_CREDIT TYPE OF COLUMN SKLAD.SUMM,'
      '1102251216=  SUMM_DEBET_CONTR TYPE OF COLUMN SKLAD.SUMM,'
      '1102251217=  SUMM_CREDIT_CONTR TYPE OF COLUMN SKLAD.SUMM)'
      '1102251218=AS'
      '1102251219=/*'
      
        '1102251220=MODE_ - '#1056#1045#1046#1048#1052', 0 - '#1055#1054' '#1042#1057#1045#1052' '#1055#1056#1054#1044#1040#1046#1040#1052', 1 - '#1055#1054' '#1057#1060#1054#1056#1052#1048#1056#1054#1042 +
        #1040#1053#1053#1067#1052' '#1057#1060
      '1102251221=*/'
      
        '1102251222=DECLARE VARIABLE IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT' +
        '.IS_SUPPLIER;'
      '1102251223=DECLARE VARIABLE ID TYPE OF COLUMN CUR_PARAMS.ID;'
      '1102251224=DECLARE VARIABLE ROW INTEGER;'
      '1102251225=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1102251226=DECLARE VARIABLE SUMM_IN_DEBET_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '1102251227=DECLARE VARIABLE SUMM_IN_CREDIT_ TYPE OF COLUMN SKLAD' +
        '_PARENT.SUMM;'
      
        '1102251228=DECLARE VARIABLE SUMM_IN_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '1102251229=DECLARE VARIABLE SUMM_OUT_DEBET_ TYPE OF COLUMN SKLAD' +
        '_PARENT.SUMM;'
      
        '1102251230=DECLARE VARIABLE SUMM_OUT_CREDIT_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM;'
      
        '1102251231=DECLARE VARIABLE SUMM_OUT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      
        '1102251232=DECLARE VARIABLE SUMM_OUT_1 TYPE OF COLUMN SKLAD_PARE' +
        'NT.SUMM;'
      
        '1102251233=DECLARE VARIABLE SUMM_OUT_2 TYPE OF COLUMN SKLAD_PARE' +
        'NT.SUMM;'
      '1102251234=DECLARE VARIABLE CURR_STR_ VARCHAR(5);'
      '1102251235=DECLARE VARIABLE SORT_ROW DATE;'
      '1102251236=BEGIN'
      '1102251237=  CLRF = ascii_char( 10 );'
      '1102251238='
      '1102251239=  if (CURRENCY_ = 0) then'
      '1102251240=    CURR_STR_ = '#39' KZT'#39';'
      '1102251241=  else if (CURRENCY_ = 1) then'
      '1102251242=    CURR_STR_ = '#39' '#1088#1091#1073'.'#39';'
      '1102251243=  else if (CURRENCY_ = 2) then'
      '1102251244=    CURR_STR_ = '#39' '#1075#1088#1085'.'#39';'
      '1102251245=  else if (CURRENCY_ = 3) then'
      '1102251246=    CURR_STR_ = '#39' '#1089#1091#1084#39';'
      '1102251247=  else if (CURRENCY_ = 4) then'
      '1102251248=    CURR_STR_ = '#39' '#1089#1086#1084#39';'
      '1102251249=  else if (CURRENCY_ = 5) then'
      '1102251250=    CURR_STR_ = '#39' '#1076#1088#1072#1084#39';'
      '1102251251='
      '1102251252=  IF (G_OFFICIAL_NAME_ IS NULL) THEN BEGIN'
      '1102251253=      SELECT J.FIO_DOC'
      '1102251254=        FROM G_OFFICIAL J'
      '1102251255=       WHERE J.IS_RUKOVODITEL = 1'
      '1102251256=        INTO G_OFFICIAL_NAME_;'
      '1102251257='
      '1102251258=      if (G_OFFICIAL_NAME_ IS NULL) then'
      '1102251259=        SELECT J.FIO_DOC'
      '1102251260=          FROM G_OFFICIAL J'
      
        '1102251261=         WHERE J.G_OFFICIAL = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 1)'
      '1102251262=         INTO G_OFFICIAL_NAME_;'
      '1102251263=  END'
      '1102251264='
      '1102251265=  CLIENT_NAME_OUT_  = CLIENT_NAME_IN_;'
      '1102251266=  FIRM_NAME_OUT_    = FIRM_NAME_IN_;'
      '1102251267='
      
        '1102251268=  if (TRIM(G_OFFICIAL_NAME_) IS NULL or TRIM(G_OFFICI' +
        'AL_NAME_) = '#39#39') then'
      '1102251269=    G_OFFICIAL_NAME_ = '#39'________________'#39';'
      '1102251270='
      
        '1102251271=  if (TRIM(CLIENT_DIR_NAME_IN_) IS NULL or TRIM(CLIEN' +
        'T_DIR_NAME_IN_) = '#39#39') then'
      '1102251272=    CLIENT_DIR_NAME_IN_ = '#39'________________'#39';'
      '1102251273='
      
        '1102251274=  STR1_ = '#39#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1079#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTR' +
        'ACT(DAY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM' +
        ' DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'
      
        '1102251275=          '#39' '#1087#1086' '#39'||lpad(EXTRACT(DAY FROM DATE_END_), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||E' +
        'XTRACT(YEAR FROM DATE_END_)||clrf||'
      '1102251276=          '#39' '#1084#1077#1078#1076#1091' '#39'||FIRM_NAME_OUT_||clrf||'
      '1102251277=          '#39' '#1080' '#39'||CLIENT_NAME_OUT_;'
      '1102251278='
      
        '1102251279=  STR2_ = '#39#1052#1099', '#1085#1080#1078#1077#1087#1086#1076#1087#1080#1089#1072#1074#1096#1080#1077#1089#1103', ________________ '#39'|' +
        '|FIRM_NAME_OUT_||'#39' '#39'||G_OFFICIAL_NAME_||'#39', '#1089' '#1086#1076#1085#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '1102251280=          '#39#1080' ________________ '#39'||CLIENT_NAME_OUT_||'#39' ' +
        #39'||CLIENT_DIR_NAME_IN_||'#39', '#1089' '#1076#1088#1091#1075#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '1102251281=          '#39#1089#1086#1089#1090#1072#1074#1080#1083#1080' '#1085#1072#1089#1090#1086#1103#1097#1080#1081' '#1072#1082#1090' '#1089#1074#1077#1088#1082#1080' '#1074' '#1090#1086#1084', '#1095#1090#1086' ' +
        #1089#1086#1089#1090#1086#1103#1085#1080#1077' '#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1087#1086' '#1076#1072#1085#1085#1099#1084' '#1091#1095#1077#1090#1072' '#1089#1083#1077#1076#1091#1102#1097#1077#1077':'#39';'
      '1102251282='
      
        '1102251283=  STR3_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_||'#39','#39'||CURR_STR' +
        '_;'
      '1102251284=  STR3_DOWN_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_;'
      
        '1102251285=  STR4_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||CLIENT_NAME_OUT_||'#39','#39'||CURR_S' +
        'TR_;'
      '1102251286='
      
        '1102251287=  STR_SALDO_IN_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1085#1072#1095#1072#1083#1086' '#39'||lpad(EXTRACT(D' +
        'AY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '1102251288=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(' +
        'EXTRACT(MONTH FROM :DATE_BEGIN_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DA' +
        'TE_BEGIN_)||'#39' '#1075'.'#39';'
      '1102251289='
      
        '1102251290=  STR_SALDO_OUT_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1082#1086#1085#1077#1094' '#39'||lpad(EXTRACT(D' +
        'AY FROM DATE_END_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '1102251291=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(' +
        'EXTRACT(MONTH FROM :DATE_END_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DATE' +
        '_END_)||'#39' '#1075'.'#39';'
      '1102251292='
      '1102251293=  STR_OT1_ = '#39#1054#1090' '#39'||FIRM_NAME_OUT_;'
      '1102251294=  STR_OT2_ = '#39#1054#1090' '#39'||CLIENT_NAME_OUT_;'
      '1102251295='
      '1102251296=  SELECT IS_SUPPLIER'
      '1102251297=    FROM G_CLIENT G'
      '1102251298=   WHERE G.G_CLIENT = :G_CLIENT_'
      '1102251299=    INTO :IS_SUPPLIER_;'
      '1102251300='
      '1102251301=  DEBET_IN_   = 0;'
      '1102251302=  DEBET_OUT_  = 0;'
      '1102251303=  CREDIT_IN_  = 0;'
      '1102251304=  CREDIT_OUT_ = 0;'
      '1102251305='
      
        '1102251306=  STR5_ = '#39#1085#1072' '#39'||LPAD(EXTRACT(DAY FROM CURRENT_DATE),' +
        ' 2, '#39'0'#39')||'#39'.'#39'||LPAD(EXTRACT(MONTH FROM CURRENT_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1102251307='
      
        '1102251308=  --*************************************************' +
        '******************'
      '1102251309=  -- '#1055#1054#1057#1058#1040#1042#1065#1048#1050
      
        '1102251310=  --*************************************************' +
        '******************'
      '1102251311=  IF (IS_SUPPLIER_ = 1) THEN BEGIN'
      '1102251312=    ----------------------'
      '1102251313=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1102251314=    SELECT SUM(S.SUMM)'
      '1102251315=      FROM SKLAD_PARENT S'
      '1102251316=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251317=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1102251318=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251319=    GROUP BY S.G_CLIENT'
      '1102251320=      INTO :SUMM_IN_DEBET_;'
      '1102251321='
      '1102251322=    SELECT SUM(K.SUMM)'
      '1102251323=      FROM SKLAD_PARENT S,'
      
        '1102251324=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251325=             from KASSA'
      
        '1102251326=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251327=              AND ZAKAZ IS NULL'
      '1102251328=           union all'
      
        '1102251329=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251330=             from kassa_beznal'
      
        '1102251331=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251332=              AND ZAKAZ IS NULL) K'
      '1102251333=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251334=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251335=       AND K.SKLAD = S.SKLAD'
      '1102251336=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1102251337=       AND K.G_PRIHOD_RASHOD = 2'
      '1102251338=    GROUP BY S.G_CLIENT'
      '1102251339=      INTO :SUMM_IN_CREDIT_;'
      '1102251340='
      
        '1102251341=    SELECT :SUMM_IN_DEBET_ + SUM(S.SUMM)             ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102251342=      FROM ZAKAZ S'
      '1102251343=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251344=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '1102251345=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251346=    GROUP BY S.G_CLIENT'
      '1102251347=      INTO :SUMM_IN_DEBET_;'
      '1102251348='
      
        '1102251349=    SELECT :SUMM_IN_CREDIT_ + SUM(K.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102251350=      FROM ZAKAZ S,'
      '1102251351=          (select ZAKAZ, SUMM, ACTION_DATE'
      '1102251352=             from KASSA'
      
        '1102251353=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251354=              AND SKLAD IS NULL'
      '1102251355=           union all'
      '1102251356=           select ZAKAZ, SUMM, ACTION_DATE'
      '1102251357=             from kassa_beznal'
      
        '1102251358=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251359=              AND SKLAD IS NULL) K'
      '1102251360=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251361=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251362=       AND K.zakaz = S.ZAKAZ'
      '1102251363=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1102251364=    GROUP BY S.G_CLIENT'
      '1102251365=      INTO :SUMM_IN_CREDIT_;'
      '1102251366='
      '1102251367=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '1102251368='
      '1102251369=    ----------------------'
      '1102251370=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1102251371=    SELECT SUM(S.SUMM)'
      '1102251372=      FROM SKLAD_PARENT S'
      '1102251373=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251374=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '1102251375=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251376=    GROUP BY S.G_CLIENT'
      '1102251377=      INTO :SUMM_OUT_DEBET_;'
      '1102251378='
      '1102251379=    SELECT SUM(K.SUMM)'
      '1102251380=      FROM SKLAD_PARENT S,'
      
        '1102251381=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251382=             from KASSA'
      
        '1102251383=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251384=              AND ZAKAZ IS NULL'
      '1102251385=           union all'
      
        '1102251386=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251387=             from kassa_beznal'
      
        '1102251388=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251389=              AND ZAKAZ IS NULL) K'
      '1102251390=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251391=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251392=       AND K.SKLAD = S.SKLAD'
      '1102251393=       AND K.ACTION_DATE <= :DATE_END_'
      '1102251394=       AND K.G_PRIHOD_RASHOD = 2'
      '1102251395=    GROUP BY S.G_CLIENT'
      '1102251396=      INTO :SUMM_OUT_CREDIT_;'
      '1102251397='
      
        '1102251398=    SELECT :SUMM_OUT_CREDIT_ +SUM(S.SUMM)            ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102251399=      FROM ZAKAZ S'
      '1102251400=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251401=       AND S.Z_DATE <= :DATE_END_'
      
        '1102251402=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251403=    GROUP BY S.G_CLIENT'
      '1102251404=      INTO :SUMM_OUT_CREDIT_;'
      '1102251405='
      
        '1102251406=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102251407=      FROM ZAKAZ S,'
      '1102251408=          (select ZAKAZ, SUMM, ACTION_DATE'
      '1102251409=             from KASSA'
      
        '1102251410=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251411=              AND SKLAD IS NULL'
      '1102251412=           union all'
      '1102251413=           select ZAKAZ, SUMM, ACTION_DATE'
      '1102251414=             from kassa_beznal'
      
        '1102251415=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251416=              AND SKLAD IS NULL) K'
      '1102251417=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251418=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251419=       AND K.zakaz = S.ZAKAZ'
      '1102251420=       AND K.ACTION_DATE <= :DATE_END_'
      '1102251421=    GROUP BY S.G_CLIENT'
      '1102251422=      INTO :SUMM_OUT_DEBET_;'
      '1102251423='
      '1102251424=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '1102251425=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1102251426=    -------------------------'
      '1102251427='
      '1102251428=    if (COALESCE(SUMM_IN_, 0) < 0) then'
      '1102251429=      DEBET_IN_ = SUMM_IN_;'
      '1102251430=    ELSE'
      '1102251431=      CREDIT_IN_ = SUMM_IN_;'
      '1102251432='
      '1102251433=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '1102251434=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '1102251435='
      '1102251436=    if (COALESCE(SUMM_OUT_, 0) < 0) then'
      '1102251437=      DEBET_OUT_ = ABS(SUMM_OUT_);'
      '1102251438=    ELSE'
      '1102251439=      CREDIT_OUT_ = SUMM_OUT_;'
      '1102251440='
      '1102251441=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '1102251442=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '1102251443='
      '1102251444=        if (DEBET_OUT_ > 0) then'
      
        '1102251445=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE' +
        '(CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1102251446=        else'
      
        '1102251447=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLA' +
        'CE(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1102251448=    end else'
      '1102251449=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '1102251450='
      '1102251451=    FOR SELECT 1 ROW,'
      
        '1102251452=               '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1058#1052#1047' '#39'||S.SKLAD||'#39' '#1086#1090' '#39'||S' +
        '.DATE_RECEIPT str,'
      '1102251453=               S.SKLAD ID,'
      '1102251454=               S.DATE_RECEIPT OPER_DATE,'
      '1102251455=               NULL SUMM_DEBET,'
      '1102251456=               S.SUMM SUMM_CREDIT,'
      '1102251457=               S.DATE_RECEIPT SORT_ROW'
      '1102251458=          FROM SKLAD_PARENT S'
      '1102251459=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251460=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1102251461=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOC' +
        'HKA||'#39'-'#39
      '1102251462=        UNION ALL'
      '1102251463=        SELECT 2 ROW,'
      
        '1102251464=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' '#1086#1090' '#39'||S' +
        'PP.DATE_RECEIPT STR,'
      '1102251465=               K.SKLAD ID,'
      '1102251466=               K.ACTION_DATE OPER_DATE,'
      '1102251467=               K.SUMM SUMM_DEBET,'
      '1102251468=               NULL SUMM_CREDIT,'
      '1102251469=               K.ACTION_DATE SORT_ROW'
      
        '1102251470=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1102251471=                  from KASSA'
      
        '1102251472=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '1102251473=                union all'
      
        '1102251474=                select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1102251475=                  from kassa_beznal'
      
        '1102251476=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '1102251477=               SKLAD_PARENT SPP'
      '1102251478=         WHERE K.ZAKAZ IS NULL'
      '1102251479=           AND K.SKLAD = SPP.SKLAD'
      
        '1102251480=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1102251481=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '1102251482=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_T' +
        'OCHKA||'#39'-'#39
      '1102251483=           AND K.G_PRIHOD_RASHOD = 2'
      '1102251484=        UNION ALL'
      '1102251485=        SELECT 3 ROW,'
      
        '1102251486=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#39'||Z.ZAKAZ||'#39' ' +
        #1086#1090' '#39'||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRAC' +
        'T(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE' +
        ') str,'
      '1102251487=               Z.ZAKAZ ID,'
      '1102251488=               Z.Z_DATE OPER_DATE,'
      '1102251489=               Z.SUMM SUMM_DEBET,'
      '1102251490=               NULL SUMM_CREDIT,'
      '1102251491=               Z.Z_DATE SORT_ROW'
      '1102251492=          FROM ZAKAZ Z'
      '1102251493=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '1102251494=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102251495=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1102251496=        UNION ALL'
      '1102251497=        SELECT 4 ROW,'
      
        '1102251498=               '#39#1054#1087#1083#1072#1090#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(' +
        'MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE' +
        ') STR,'
      '1102251499=               K.ZAKAZ ID,'
      '1102251500=               K.ACTION_DATE OPER_DATE,'
      '1102251501=               NULL SUMM_DEBET,'
      '1102251502=               K.SUMM SUMM_CREDIT,'
      '1102251503=               K.ACTION_DATE SORT_ROW'
      
        '1102251504=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA'
      '1102251505=                  from KASSA'
      
        '1102251506=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39
      '1102251507=                union all'
      
        '1102251508=                select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA_BEZNAL KASSA'
      '1102251509=                  from kassa_beznal'
      
        '1102251510=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39') K,'
      '1102251511=               zakaz zz'
      '1102251512=         WHERE K.sklad IS NULL'
      '1102251513=           AND K.zakaz = zz.ZAKAZ'
      
        '1102251514=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1102251515=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '1102251516=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TO' +
        'CHKA||'#39'-'#39
      '1102251517=        UNION ALL'
      '1102251518=        SELECT 5 ROW,'
      '1102251519=               NULL STR,'
      '1102251520=               NULL ID,'
      '1102251521=               NULL OPER_DATE,'
      '1102251522=               NULL SUMM_DEBET,'
      '1102251523=               NULL SUMM_CREDIT,'
      
        '1102251524=               '#39'31.12.2199'#39' SORT_ROW    -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090 +
        #1072#1103' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '1102251525=          FROM RDB$DATABASE'
      '1102251526=        ORDER BY 7, 3, 1'
      '1102251527=        INTO :ROW,'
      '1102251528=             :STR_TEXT,'
      '1102251529=             :ID,'
      '1102251530=             :OPER_DATE,'
      '1102251531=             :SUMM_DEBET,'
      '1102251532=             :SUMM_CREDIT,'
      '1102251533=             :SORT_ROW'
      '1102251534=    DO BEGIN'
      '1102251535=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '1102251536=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '1102251537=      SUSPEND;'
      '1102251538=    END'
      '1102251539=  END'
      '1102251540='
      
        '1102251541=  --*************************************************' +
        '**************'
      '1102251542=  -- '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068
      
        '1102251543=  -- 12.12.2021 '#1058#1045#1055#1045#1056#1068' '#1041#1059#1044#1059' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1055#1054' '#1057#1063#1045#1058' '#1060#1040#1050#1058#1059#1056#1040#1052 +
        ', '#1050#1054#1058#1054#1056#1067#1045' '#1041#1067#1051#1048' '#1042#1067#1055#1048#1057#1040#1053#1067', '#1063#1058#1054#1041#1067' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040#1047#1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '1102251544=  -- 28.04.2022 '#1042#1057#1045' '#1053#1040#1063#1040#1051#1048' '#1042#1054#1047#1052#1059#1065#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1040#1050#1058' '#1057#1042#1045#1056#1050#1048 +
        ' '#1053#1045' '#1056#1040#1041#1054#1058#1040#1045#1058', '#1055#1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' MODE_'
      
        '1102251545=  --*************************************************' +
        '**************'
      '1102251546=  ELSE BEGIN'
      '1102251547=    ----------------------'
      '1102251548=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040' DEBET'
      '1102251549=    SELECT SUM(S.SUMM)'
      '1102251550=      FROM ZAKAZ S, INVOICE I'
      '1102251551=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251552=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '1102251553=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251554=       AND S.is_spisanie <> 1'
      '1102251555=       AND S.ZAKAZ = I.ZAKAZ'
      
        '1102251556=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_F' +
        'IRM, :G_FIRM_IN_)'
      '1102251557=       AND :MODE_ = 1'
      '1102251558=    GROUP BY S.G_CLIENT'
      '1102251559=    UNION'
      '1102251560=    SELECT SUM(S.SUMM)'
      '1102251561=      FROM ZAKAZ S'
      '1102251562=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251563=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '1102251564=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251565=       AND S.is_spisanie <> 1'
      '1102251566=       AND :MODE_ = 0'
      '1102251567=    GROUP BY S.G_CLIENT'
      '1102251568=      INTO :SUMM_IN_DEBET_;'
      '1102251569='
      '1102251570=    SUMM_IN_DEBET_ = COALESCE(SUMM_IN_DEBET_, 0);'
      '1102251571='
      '1102251572=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040' CREDIT'
      '1102251573=    SELECT SUM(K.SUMM)'
      '1102251574=      FROM ZAKAZ S,'
      '1102251575=           INVOICE I,'
      
        '1102251576=          (select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251577=             from KASSA'
      
        '1102251578=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251579=              AND SKLAD IS NULL'
      '1102251580=           union all'
      
        '1102251581=           select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251582=             from kassa_beznal'
      
        '1102251583=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251584=              AND SKLAD IS NULL'
      '1102251585=           union all'
      
        '1102251586=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_dat' +
        'e ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '1102251587=             from zakaz Z'
      
        '1102251588=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251589=              AND Z.summ_bonus > 0) K'
      '1102251590=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251591=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251592=       AND K.zakaz = S.ZAKAZ'
      '1102251593=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1102251594=       AND S.is_spisanie <> 1'
      '1102251595=       AND K.G_PRIHOD_RASHOD = 1'
      '1102251596=       AND S.ZAKAZ = I.ZAKAZ'
      
        '1102251597=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_F' +
        'IRM, :G_FIRM_IN_)'
      '1102251598=       AND :MODE_ = 1'
      '1102251599=    GROUP BY S.G_CLIENT'
      '1102251600=    UNION'
      '1102251601=    SELECT SUM(K.SUMM)'
      '1102251602=      FROM ZAKAZ S,'
      
        '1102251603=          (select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251604=             from KASSA'
      
        '1102251605=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251606=              AND SKLAD IS NULL'
      '1102251607=           union all'
      
        '1102251608=           select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251609=             from kassa_beznal'
      
        '1102251610=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251611=              AND SKLAD IS NULL'
      '1102251612=           union all'
      
        '1102251613=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_dat' +
        'e ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '1102251614=             from zakaz Z'
      
        '1102251615=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251616=              AND Z.summ_bonus > 0) K'
      '1102251617=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251618=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251619=       AND K.zakaz = S.ZAKAZ'
      '1102251620=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1102251621=       AND S.is_spisanie <> 1'
      '1102251622=       AND K.G_PRIHOD_RASHOD = 1'
      '1102251623=       AND :MODE_ = 0'
      '1102251624=    GROUP BY S.G_CLIENT'
      '1102251625=      INTO :SUMM_IN_CREDIT_;'
      '1102251626='
      '1102251627=    SUMM_IN_CREDIT_ = COALESCE(SUMM_IN_CREDIT_, 0);'
      '1102251628='
      
        '1102251629=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040 +
        #1047#1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '1102251630=    SELECT :SUMM_IN_DEBET_ + SUM(K.SUMM)             ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1102251631=      FROM SKLAD_PARENT S,'
      
        '1102251632=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251633=             from KASSA'
      
        '1102251634=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251635=              AND ZAKAZ IS NULL'
      '1102251636=           union all'
      
        '1102251637=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1102251638=             from kassa_beznal'
      
        '1102251639=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251640=              AND ZAKAZ IS NULL) K'
      '1102251641=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251642=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251643=       AND K.SKLAD = S.SKLAD'
      '1102251644=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1102251645=       AND K.G_PRIHOD_RASHOD = 3'
      '1102251646=    GROUP BY S.G_CLIENT'
      '1102251647=      INTO :SUMM_IN_DEBET_;'
      '1102251648='
      '1102251649=    SUMM_IN_DEBET_ = COALESCE(SUMM_IN_DEBET_, 0);'
      '1102251650='
      
        '1102251651=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040 +
        #1047#1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '1102251652=    SELECT :SUMM_IN_CREDIT_ + SUM(S.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1102251653=      FROM SKLAD_PARENT S'
      '1102251654=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251655=       AND S.IS_VOZVRAT = 1'
      '1102251656=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1102251657=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251658=    GROUP BY S.G_CLIENT'
      '1102251659=      INTO :SUMM_IN_CREDIT_;'
      '1102251660='
      '1102251661=    SUMM_IN_CREDIT_ = COALESCE(SUMM_IN_CREDIT_, 0);'
      '1102251662='
      '1102251663=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '1102251664='
      '1102251665=    ----------------------'
      '1102251666=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1102251667=    SELECT SUM(S.SUMM)'
      '1102251668=      FROM ZAKAZ S, INVOICE I'
      '1102251669=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251670=       AND S.Z_DATE <= :DATE_END_'
      
        '1102251671=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251672=       AND S.is_spisanie <> 1'
      '1102251673=       AND S.ZAKAZ = I.ZAKAZ'
      
        '1102251674=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_F' +
        'IRM, :G_FIRM_IN_)'
      '1102251675=       AND :MODE_ = 1'
      '1102251676=    GROUP BY S.G_CLIENT'
      '1102251677=    UNION'
      '1102251678=    SELECT SUM(S.SUMM)'
      '1102251679=      FROM ZAKAZ S'
      '1102251680=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251681=       AND S.Z_DATE <= :DATE_END_'
      
        '1102251682=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251683=       AND S.is_spisanie <> 1'
      '1102251684=       AND :MODE_ = 0'
      '1102251685=    GROUP BY S.G_CLIENT'
      '1102251686=      INTO :SUMM_OUT_DEBET_;'
      '1102251687='
      '1102251688=    SUMM_OUT_DEBET_ = COALESCE(SUMM_OUT_DEBET_, 0);'
      '1102251689='
      '1102251690=    SELECT SUM(K.SUMM)'
      '1102251691=      FROM ZAKAZ S, INVOICE I,'
      
        '1102251692=          (select ZAKAZ, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1102251693=             from KASSA'
      
        '1102251694=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251695=              AND SKLAD IS NULL'
      '1102251696=           union all'
      
        '1102251697=           select ZAKAZ, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1102251698=             from kassa_beznal'
      
        '1102251699=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251700=              AND SKLAD IS NULL'
      '1102251701=           union all'
      
        '1102251702=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_dat' +
        'e ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '1102251703=             from zakaz Z'
      
        '1102251704=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251705=              AND Z.summ_bonus > 0) K'
      '1102251706=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251707=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251708=       AND K.zakaz = S.ZAKAZ'
      '1102251709=       AND K.ACTION_DATE <= :DATE_END_'
      '1102251710=       AND K.G_PRIHOD_RASHOD in (1, -5)'
      '1102251711=       AND S.ZAKAZ = I.ZAKAZ'
      
        '1102251712=       AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I.G_F' +
        'IRM, :G_FIRM_IN_)'
      '1102251713=       AND :MODE_ = 1'
      '1102251714=    GROUP BY S.G_CLIENT'
      '1102251715=    UNION'
      '1102251716=    SELECT SUM(K.SUMM)'
      '1102251717=      FROM ZAKAZ S,'
      
        '1102251718=          (select ZAKAZ, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1102251719=             from KASSA'
      
        '1102251720=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251721=              AND SKLAD IS NULL'
      '1102251722=           union all'
      
        '1102251723=           select ZAKAZ, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1102251724=             from kassa_beznal'
      
        '1102251725=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251726=              AND SKLAD IS NULL'
      '1102251727=           union all'
      
        '1102251728=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_dat' +
        'e ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '1102251729=             from zakaz Z'
      
        '1102251730=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251731=              AND Z.summ_bonus > 0) K'
      '1102251732=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251733=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251734=       AND K.zakaz = S.ZAKAZ'
      '1102251735=       AND K.ACTION_DATE <= :DATE_END_'
      '1102251736=       AND K.G_PRIHOD_RASHOD in (1, -5)'
      '1102251737=       AND :MODE_ = 0'
      '1102251738=    GROUP BY S.G_CLIENT'
      '1102251739=      INTO :SUMM_OUT_CREDIT_;'
      '1102251740='
      '1102251741=    SUMM_OUT_CREDIT_ = COALESCE(SUMM_OUT_CREDIT_, 0);'
      '1102251742='
      
        '1102251743=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040 +
        #1047#1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '1102251744=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)            ' +
        '   -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1102251745=      FROM SKLAD_PARENT S,'
      
        '1102251746=          (select SKLAD, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1102251747=             from KASSA'
      
