      '110157186=    sign_of_val = '#39#39';'
      '110157187='
      
        '110157188=  /* '#1042#1099#1073#1080#1088#1072#1077#1084' '#1080' '#1079#1072#1087#1086#1084#1080#1085#1072#1077#1084' '#1082#1086#1087#1077#1081#1082#1080', '#1091#1073#1080#1088#1072#1077#1084' '#1080#1093' '#1080#1079' '#1095#1080#1089#1083 +
        #1072' */'
      '110157189=  val_str = cast(val as varchar(20));'
      '110157190=  i = position('#39'.'#39' in val_str);'
      
        '110157191=  cents = lpad(substring(val_str from i+1 for 2), 2, '#39 +
        '0'#39');'
      
        '110157192=  val_str = lpad(substring(val_str from 1 for i-1), (t' +
        'runc((i+1)/3)*3), '#39'0'#39');'
      
        '110157193=  val_str1 = val_str;  -- '#1085#1091#1078#1085#1086' '#1076#1072#1083#1077#1077' '#1076#1083#1103' '#1089#1082#1083#1086#1085#1077#1085#1080#1103' '#1074#1072 +
        #1083#1102#1090#1099', '#1072' val_str '#1087#1077#1088#1077#1090#1080#1088#1072#1077#1090#1089#1103
      '110157194='
      '110157195=  /* '#1056#1072#1079#1073#1080#1088#1072#1077#1084' '#1095#1080#1089#1083#1086' */'
      '110157196=  raz = 0; curr_str = '#39#39';'
      '110157197=  while (val_str != '#39#39') do begin'
      '110157198=    /* '#1041#1077#1088#1105#1084' '#1090#1088#1080#1072#1076#1091' '#1089#1080#1084#1074#1086#1083#1086#1074' */'
      '110157199=    num = right(val_str, 3);'
      '110157200=    /* '#1045#1089#1083#1080' '#1085#1077' '#1085#1091#1083#1077#1074#1086#1077' '#1095#1080#1089#1083#1086' */'
      '110157201=    if (num != '#39'000'#39') then begin'
      '110157202=      /* '#1041#1077#1088#1105#1084' '#1089#1086#1090#1085#1080' */'
      '110157203=      i = cast(substring(num from 1 for 1) as int);'
      
        '110157204=      buf = substring(hundreds from cast(substring(hun' +
        'dreds_idx from i*3+1 for 2) as int) for cast(substring(hundreds_' +
        'idx from i*3+3 for 1) as int));'
      '110157205='
      '110157206=      /* '#1044#1072#1083#1077#1077' '#1076#1077#1089#1103#1090#1082#1080' */'
      '110157207=      /* '#1044#1083#1103' "'#1076#1077#1089#1103#1090#1085#1072#1076#1094#1072#1090#1099#1093'" '#1091#1087#1088#1086#1097#1105#1085#1085#1072#1103' '#1086#1073#1088#1072#1073#1086#1090#1082#1072' */'
      
        '110157208=      if (substring(num from 2 for 1) = '#39'1'#39') then begi' +
        'n'
      '110157209=          /* '#1042#1089#1090#1072#1074#1083#1103#1077#1084' '#1085#1091#1078#1085#1091#1102' "'#1076#1077#1089#1103#1090#1085#1072#1076#1094#1072#1090#1100'" */'
      
        '110157210=          i = cast(substring(num from 2 for 2) as int)' +
        ';'
      
        '110157211=          buf1 = substring(ones from cast(substring(on' +
        'es_idx from i*5+1 for 3) as int) for cast(substring(ones_idx fro' +
        'm i*5+4 for 2) as int));'
      '110157212=          if (buf != '#39#39') then buf = buf || '#39' '#39';'
      '110157213=          buf = buf || buf1;'
      '110157214=      end else'
      '110157215=      /* '#1044#1083#1103' "'#1085#1086#1088#1084#1072#1083#1100#1085#1099#1093'" '#1095#1080#1089#1077#1083' '#1089#1074#1086#1103' '#1086#1073#1088#1072#1073#1086#1090#1082#1072' */'
      '110157216=      begin'
      '110157217=        /* '#1044#1077#1089#1103#1090#1082#1080' */'
      '110157218=        i = cast(substring(num from 2 for 1) as int);'
      
        '110157219=        buf1 = substring(tens from cast(substring(tens' +
        '_idx from i*4+1 for 2) as int) for cast(substring(tens_idx from ' +
        'i*4+3 for 2) as int));'
      
        '110157220=        if (buf != '#39#39' and buf1 != '#39#39') then buf = buf |' +
        '| '#39' '#39';'
      '110157221=        buf = buf || buf1;'
      '110157222='
      '110157223=        /* '#1045#1076#1080#1085#1080#1094#1099' */'
      '110157224=        i = cast(substring(num from 3 for 1) as int);'
      '110157225=        /* '#1057#1084#1086#1090#1088#1080#1084' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1076#1083#1103' '#1085#1091#1078#1085#1086#1075#1086' '#1086#1082#1086#1085#1095#1072#1085#1080#1103' */'
      '110157226=        if (i = 1) then begin'
      
        '110157227=          if (raz = 1) then buf1 = '#39#1086#1076#1085#1072#39'; else buf1 =' +
        ' '#39#1086#1076#1080#1085#39';'
      '110157228=        end else'
      '110157229=        if (i = 2) then begin'
      
        '110157230=          if (raz = 1) then buf1 = '#39#1076#1074#1077#39'; else buf1 = ' +
        #39#1076#1074#1072#39';'
      '110157231=        end else'
      
        '110157232=          buf1 = substring(ones from cast(substring(on' +
        'es_idx from i*5+1 for 3) as int) for cast(substring(ones_idx fro' +
        'm i*5+4 for 2) as int));'
      
        '110157233=        if (buf != '#39#39' and buf1 != '#39#39') then buf = buf |' +
