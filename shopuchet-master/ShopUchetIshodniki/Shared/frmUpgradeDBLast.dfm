        '1102252910=      -- 2) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052 +
        #1045#1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057 +
        #1058#1042#1045#1053#1053#1054')'
      
        '1102252911=      -- 3) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102252912=      -- 4) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054 +
        ' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102252913='
      
        '1102252914=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056 +
        ' '#1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '1102252915=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053 +
        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1102252916=      IF (IS_VOZVRAT_ = 0) THEN'
      '1102252917=        G_PRIHOD_RASHOD_ = 2;'
      '1102252918=      ELSE'
      '1102252919=        G_PRIHOD_RASHOD_ = 3;'
      '1102252920='
      '1102252921=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102252922=            PNT_ = '#39'09'#39';'
      '1102252923=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102252924=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102252925=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102252926=            ELSE'
      
        '1102252927=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102252928='
      '1102252929=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102252930=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102252931='
      
        '1102252932=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1102252933=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1102252934=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102252935=                                              :G_PRIH' +
