        '110202471=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048 +
        #1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202472=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
