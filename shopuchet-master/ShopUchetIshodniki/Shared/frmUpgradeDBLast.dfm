        'ICE = ROUND(P.PRICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39' /  P' +
        '.VES_GRAMM, '#39'||:ROUND_||'#39')'#39';'
      '110237160='
      '110237161=          END ELSE BEGIN'
      '110237162=            SELECT ID'
