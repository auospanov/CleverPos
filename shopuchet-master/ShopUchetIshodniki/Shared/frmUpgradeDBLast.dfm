        'SUMM, NDS,'
      '1101321426=                                     NDS_SUMM)'
      
        '1101321427=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
