      '11078219=  IS_CATEGORY_ INTEGER,'
      
        '11078220=  MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT */' +
        ' NUMERIC(15,2),'
      
        '11078221=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      
        '11078222=  SALES_COMM_ /* TYPE OF COLUMN G_PRODUCT.SALES_COMM */' +
        ' NUMERIC(15,2),'
      
        '11078223=  KOD_TNVD_ /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VAR' +
        'CHAR(50),'
      
        '11078224=  FAST_TOVAR_ /* TYPE OF COLUMN G_PRODUCT.FAST_TOVAR */' +
        ' INTEGER)'
      '11078225=RETURNS ('
      '11078226=  ERR_CODE INTEGER,'
      '11078227=  ERR_MSG VARCHAR(1024))'
      '11078228=AS'
      '11078229=BEGIN'
      '11078230=  SUSPEND;'
      '11078231=END'
      '11078232=;'
      '11078233='
      '11078234='
      
        '11078235=/******************************************************' +
        '************************/'
      
        '11078236=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11078237=/******************************************************' +
        '************************/'
      '11078238=ALTER PROCEDURE G_DEL_G_FIRM_REKVIZIT('
      
        '11078239=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_FIR' +
        'M_REKVIZIT)'
      '11078240=RETURNS ('
      '11078241=  ERR_CODE INTEGER,'
      '11078242=  ERR_MSG VARCHAR(1024))'
      '11078243=AS'
      '11078244=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11078245=DECLARE VARIABLE IS_DEFAULT_ TYPE OF COLUMN G_FIRM_REKV' +
        'IZIT.IS_DEFAULT;'
      '11078246=begin'
      '11078247='
      '11078248=  if (EXISTS(SELECT FIRST 1 D.DOCS'
      '11078249=               FROM DOCS D'
      
        '11078250=              WHERE D.G_FIRM = :G_FIRM_REKVIZIT_)) then' +
        ' BEGIN'
      '11078251=    ERR_CODE = -20500;'
      
        '11078252=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1082#1086#1084 +
        #1087#1072#1085#1080#1103' '#1091#1082#1072#1079#1072#1085#1072' '#1074' '#1092#1080#1085#1072#1085#1089#1086#1074#1099#1093' '#1076#1086#1082#1091#1084#1077#1085#1090#1072#1093'! '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RE' +
        'TURNING_VALUES (:ERR_MSG);'
      '11078253=    EXIT;'
      '11078254=  END'
      '11078255='
      '11078256=  if (EXISTS(SELECT FIRST 1 D.INVOICE'
      '11078257=               FROM INVOICE D'
      
        '11078258=              WHERE D.G_FIRM = :G_FIRM_REKVIZIT_)) then' +
        ' BEGIN'
      '11078259=    ERR_CODE = -20500;'
      
        '11078260=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1082#1086#1084 +
        #1087#1072#1085#1080#1103' '#1091#1082#1072#1079#1072#1085#1072' '#1074' '#1092#1080#1085#1072#1085#1089#1086#1074#1099#1093' '#1076#1086#1082#1091#1084#1077#1085#1090#1072#1093'! '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RE' +
        'TURNING_VALUES (:ERR_MSG);'
      '11078261=    EXIT;'
      '11078262=  END'
      '11078263='
      '11078264=  if (EXISTS(SELECT FIRST 1 D.INVOICE_PAY'
      '11078265=               FROM INVOICE_PAY D'
      
        '11078266=              WHERE D.G_FIRM = :G_FIRM_REKVIZIT_)) then' +
        ' BEGIN'
      '11078267=    ERR_CODE = -20500;'
      
        '11078268=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1082#1086#1084 +
        #1087#1072#1085#1080#1103' '#1091#1082#1072#1079#1072#1085#1072' '#1074' '#1092#1080#1085#1072#1085#1089#1086#1074#1099#1093' '#1076#1086#1082#1091#1084#1077#1085#1090#1072#1093'! '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RE' +
        'TURNING_VALUES (:ERR_MSG);'
      '11078269=    EXIT;'
      '11078270=  END'
      '11078271='
      '11078272=  SELECT IS_DEFAULT'
      '11078273=    FROM G_FIRM_REKVIZIT G'
      '11078274=   WHERE G.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_'
      '11078275=   INTO :IS_DEFAULT_;'
      '11078276='
      
        '11078277=  DELETE FROM G_FIRM_ADDRESS A WHERE A.G_FIRM_REKVIZIT ' +
        '= :G_FIRM_REKVIZIT_;'
      
        '11078278=  DELETE FROM G_FIRM_ACCOUNT AC WHERE AC.G_FIRM_REKVIZI' +
        'T = :G_FIRM_REKVIZIT_;'
      '11078279='
      
        '11078280=  DELETE FROM G_FIRM_REKVIZIT G WHERE G.G_FIRM_REKVIZIT' +
        ' = :G_FIRM_REKVIZIT_;'
      '11078281='
      '11078282=  IF (IS_DEFAULT_ = 1) THEN'
      '11078283=    UPDATE G_FIRM_REKVIZIT G'
      '11078284=      SET G.IS_DEFAULT = 1'
      
        '11078285=     WHERE G.G_FIRM_REKVIZIT = (SELECT MIN(G_FIRM_REKVI' +
        'ZIT) FROM G_FIRM_REKVIZIT);'
      '11078286=end'
      '11078287=;'
      '11078288='
      '11078289=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '11078290=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '11078291=RETURNS ('
      '11078292=  ERR_CODE INTEGER,'
      '11078293=  ERR_MSG VARCHAR(1024))'
      '11078294=AS'
      '11078295=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '11078296=DECLARE VARIABLE CNT_ INTEGER;'
      '11078297=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '11078298=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      '11078299=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '11078300=BEGIN'
      '11078301=  PROCNAME = '#39'G_DEL_G_PRODUCT'#39';'
      '11078302='
      '11078303=  IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11078304=                FROM G_PRODUCT'
      
        '11078305=               WHERE G_PRODUCT_PAR = :G_PRODUCT_)) then' +
        ' BEGIN'
      '11078306=    ERR_CODE = -20500;'
      
        '11078307=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076#1072 +
        #1083#1080#1090#1100' '#1076#1072#1085#1085#1091#1102' '#1075#1088#1091#1087#1087#1091', '#1090'.'#1082'. '#1074' '#1085#1077#1081' '#1089#1086#1089#1090#1086#1103#1090' '#1090#1086#1074#1072#1088#1099'/'#1075#1088#1091#1087#1087#1099'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085 +
        #1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11078308=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11078309=    EXIT;'
      '11078310=  END'
      '11078311='
      '11078312='
      '11078313=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', '#39')'
      '11078314=                    FROM g_product_kit K, g_product g'
      '11078315=                   WHERE K.g_product_item = :G_PRODUCT_'
      
        '11078316=                     and k.g_product = g.g_product) FRO' +
        'M 1 FOR 999)'
      '11078317=  FROM RDB$DATABASE'
      '11078318=   INTO :PROD_NAME_;'
      '11078319=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '11078320=    ERR_CODE = -20500;'
      
        '11078321=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086#1074 +
        #1072#1088' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083#1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'. '#1059#1076#1072#1083#1080#1090#1100 +
        ' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '11078322=                                  '#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090#1077 +
        ' '#1077#1075#1086' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1072' '#1090#1086#1074#1072#1088#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11078323=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11078324=    EXIT;'
      '11078325=  END'
      '11078326='
      
        '11078327=  SELECT ZA.zakaz||'#39' '#1086#1090' '#39'||lpad(extract(day from ZA.Z_D' +
        'ATE),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from ZA.Z_DATE),2,'#39'0'#39') ' +
        '|| '#39'.'#39' || extract(year from ZA.Z_DATE)'
      '11078328=    FROM ZAKAZ ZA'
      '11078329=   WHERE ZA.zakaz = (SELECT MIN(Z.ZAKAZ)'
      '11078330=                        FROM ZAKAZ_DETAILS Z'
      '11078331=                       WHERE Z.G_PRODUCT = :G_PRODUCT_)'
      '11078332=  INTO :NAKL_PROD_;'
      '11078333=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '11078334=    ERR_CODE = -20500;'
      
        '11078335=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086#1074 +
        #1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1091#1093#1086#1076#1072' ('#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '11078336='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.'#39 +
        '||'#39
      
        '11078337='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072 +
        #1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11078338=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11078339=    EXIT;'
      '11078340=  END'
      '11078341='
      
        '11078342=  SELECT SP.sklad||'#39' '#1086#1090' '#39'||lpad(extract(day from SP.dat' +
        'e_receipt),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from SP.date_rece' +
        'ipt),2,'#39'0'#39') || '#39'.'#39' || extract(year from SP.date_receipt)'
      '11078343=    FROM sklad_parent SP'
      '11078344=   WHERE SP.sklad = ( SELECT MIN(S.sklad_parent)'
      '11078345=                        FROM sklad s'
      '11078346=                       WHERE s.G_PRODUCT = :G_PRODUCT_)'
      '11078347=    INTO :NAKL_PROD_;'
      '11078348=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '11078349=    ERR_CODE = -20500;'
      
        '11078350=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086#1074 +
        #1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1087#1088#1080#1093#1086#1076#1072' ('#1086#1087#1088#1080#1093#1086#1076#1086#1074#1072#1085#1080#1077'/'#1074#1086#1079#1074#1088#1072#1090'/'#1087#1077#1088#1077#1084#1077 +
        #1097#1077#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '11078351='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. ' +
        #39'||'#39
      
        '11078352='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072 +
        #1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11078353=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11078354=    EXIT;'
      '11078355=  END'
      '11078356='
      
        '11078357=  SELECT lpad(extract(day from MIN(za.op_date)),2,'#39'0'#39') ' +
        '|| '#39'.'#39' || lpad(extract(month from MIN(za.op_date)),2,'#39'0'#39') || '#39'.'#39 +
        ' || extract(year from MIN(za.op_date))'
      '11078358=    FROM OTHER ZA, OTHER_DETAILS Z'
      '11078359=   WHERE ZA.OTHER = Z.other'
      '11078360=     AND Z.G_PRODUCT = :G_PRODUCT_'
      '11078361=  INTO :NAKL_PROD_;'
      '11078362=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '11078363=    ERR_CODE = -20500;'
      
        '11078364=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086#1074 +
        #1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072' '#1086#1090' '#39'||NAKL_PROD_||'#39' '#1095#1080#1089#1083#1072'. ' +
        #1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '11078365=                                  '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100 +
        ' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089 +
        #1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11078366=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11078367=    EXIT;'
      '11078368=  END'
      '11078369='
      '11078370=  delete from LT_SKLAD_PRODUCT g'
      '11078371=    where g.G_PRODUCT = :G_PRODUCT_;'
      '11078372='
      '11078373=  delete from lt_barcode g'
      '11078374=    where g.G_PRODUCT = :G_PRODUCT_;'
      '11078375='
      '11078376=  delete from revision g'
      '11078377=    where g.G_PRODUCT = :G_PRODUCT_;'
      '11078378='
      '11078379=  delete from g_product_image g'
      '11078380=    where g.G_PRODUCT = :G_PRODUCT_;'
      '11078381='
      '11078382=  delete from g_product_KIT g'
      '11078383=    where g.G_PRODUCT = :G_PRODUCT_;'
      '11078384='
      '11078385=  delete from G_PRODUCT g'
      '11078386=    where g.G_PRODUCT = :G_PRODUCT_;'
      '11078387='
      '11078388=when sqlcode -530 DO'
      '11078389=  begin'
      '11078390=    SELECT G.IS_CATEGORY'
      '11078391=      FROM G_PRODUCT G'
      '11078392=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11078393=      INTO :IS_CATEGORY_;'
      '11078394='
      '11078395=    ERR_CODE = -20500;'
      '11078396=    if (IS_CATEGORY_ = 0) then'
      
        '11078397=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085 +
        #1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '11078398=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077 +
        #1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089 +
        '-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11078399=    ELSE'
      
        '11078400=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085 +
        #1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETURN' +
        'ING_VALUES (:ERR_MSG);'
      '11078401=    ERR_MSG = PROCNAME||ERR_MSG;'
      '11078402=  end'
      '11078403=end'
      '11078404=;'
      '11078405='
      '11078406=ALTER PROCEDURE G_GET_G_PRODUCT('
      '11078407=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '11078408=RETURNS ('
      
        '11078409=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11078410=  ARTICUL_ VARCHAR(30),'
      '11078411=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11078412=  BARCODE_ VARCHAR(30),'
      '11078413=  NAME_ VARCHAR(500),'
      '11078414=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11078415=  PRICE_ NUMERIC(15,2),'
      '11078416=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11078417=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11078418=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11078419=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11078420=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11078421=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11078422=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11078423=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11078424=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11078425=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11078426=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      '11078427=  ERR_CODE INTEGER,'
      '11078428=  ERR_MSG VARCHAR(1024))'
      '11078429=AS'
      '11078430=begin'
      '11078431=    SELECT'
      '11078432=        G_PRODUCT_PAR,'
      '11078433=        ARTICUL,'
      '11078434=        NOMENCLATUR_NUM,'
      '11078435=        BARCODE,'
      '11078436=        NAME,'
      '11078437=        G_UNIT,'
      '11078438=        PRICE,'
      '11078439=        VOLUME_PRICE,'
      '11078440=        PACK_AMOUNT,'
      '11078441=        MF_COUNTRY,'
      '11078442=        NOTE,'
      '11078443=        CROSSCODE,'
      '11078444=        IS_KIT,'
      '11078445=        MIN_AMOUNT,'
      '11078446=        PLACE,'
      '11078447=        SALES_COMM,'
      '11078448=        KOD_TNVD,'
      '11078449=        FAST_TOVAR'
      '11078450=    FROM G_PRODUCT T'
      '11078451=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11078452=    INTO'
      '11078453=        :G_PRODUCT_PAR_,'
      '11078454=        :ARTICUL_,'
      '11078455=        :NOMENCLATUR_NUM_,'
      '11078456=        :BARCODE_,'
      '11078457=        :NAME_,'
      '11078458=        :G_UNIT_,'
      '11078459=        :PRICE_,'
      '11078460=        :VOLUME_PRICE_,'
      '11078461=        :PACK_AMOUNT_,'
      '11078462=        :MF_COUNTRY_,'
      '11078463=        :NOTE_,'
      '11078464=        :CROSSCODE_,'
      '11078465=        :IS_KIT_,'
      '11078466=        :MIN_AMOUNT_,'
      '11078467=        :PLACE_,'
      '11078468=        :SALES_COMM_,'
      '11078469=        :KOD_TNVD_,'
      '11078470=        :FAST_TOVAR_;'
      '11078471='
      '11078472=    INSERT INTO LT_BARCODE_TMP'
      
        '11078473=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARCO' +
        'DE WHERE G_PRODUCT = :G_PRODUCT_;'
      '11078474='
      '11078475=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '11078476=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G_' +
        'PRODUCT_;'
      '11078477='
      '11078478=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '11078479=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '11078480=end'
      '11078481=;'
      '11078482='
      '11078483=ALTER PROCEDURE G_INS_G_CLIENT('
      '11078484=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11078485=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGEN' +
        'T,'
      '11078486=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11078487=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11078488=  IDN_ VARCHAR(12),'
      '11078489=  KBE_ VARCHAR(5),'
      '11078490=  SKIDKA_ NUMERIC(15,2),'
      '11078491=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11078492=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11078493=  BY_DEFAULT_ INTEGER,'
      '11078494=  IS_SUPPLIER_ INTEGER,'
      '11078495=  IS_CATEGORY_ INTEGER,'
      '11078496=  IS_BEZNAL_ INTEGER,'
      '11078497=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11078498=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11078499=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11078500=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11078501=  NOTIFY_SKIDKA_ INTEGER,'
      '11078502=  NOTIFY_DR_ INTEGER,'
      '11078503=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '11078504=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11078505=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONUS' +
        '_PAY_SUMM)'
      '11078506=RETURNS ('
      '11078507=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11078508=  ERR_CODE INTEGER,'
      '11078509=  ERR_MSG VARCHAR(1024))'
      '11078510=AS'
      '11078511=DECLARE VARIABLE CNT_ INTEGER;'
      '11078512=begin'
      
        '11078513=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1' +
        ', '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11078514=    if (BY_DEFAULT_ = 1) then'
      '11078515=      UPDATE g_client'
      '11078516=         SET BY_DEFAULT = 0'
      '11078517=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11078518='
      
        '11078519=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G_' +
        'CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '11078520=                          IS_CATEGORY, IS_BEZNAL, PHONE' +
        ', NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR, MA' +
        'X_BONUS_PAY_SUMM)'
      
        '11078521=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_,' +
        ' :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_, ' +
        ':BY_DEFAULT_,'
      
        '11078522=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE_' +
        ', :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR_' +
        ', :MAX_BONUS_PAY_SUMM_)'
      '11078523=    returning G_CLIENT'
      '11078524=    into :G_CLIENT_;'
      '11078525='
      '11078526=    if (IS_CATEGORY_ = 0) then BEGIN'
      '11078527=        IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '11078528=            IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '11078529=                         FROM G_DISCONT_CARD'
      '11078530=                        WHERE BARCODE = :BARCODE_'
      
        '11078531=                          AND G_CLIENT <> :G_CLIENT_)) ' +
        'THEN BEGIN'
      '11078532=              ERR_CODE = -20500;'
      
        '11078533=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '11078534=              EXIT;'
      '11078535=            END'
      '11078536=        END'
      '11078537='
      
        '11078538=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11078539=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, 0, 0);'
      '11078540=    END'
      '11078541=end'
      '11078542=;'
      '11078543='
      '11078544=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '11078545=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11078546=  ARTICUL_ VARCHAR(30),'
      '11078547=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11078548=  BARCODE_ VARCHAR(30),'
      '11078549=  NAME_ VARCHAR(500),'
      '11078550=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11078551=  PRICE_ NUMERIC(15,2),'
      '11078552=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11078553=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11078554=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11078555=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11078556=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11078557=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11078558=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11078559=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11078560=  IS_CATEGORY_ INTEGER,'
      '11078561=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11078562=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11078563=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR)'
      '11078564=RETURNS ('
      '11078565=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11078566=  ERR_CODE INTEGER,'
      '11078567=  ERR_MSG VARCHAR(1024))'
      '11078568=AS'
      
        '11078569=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODUC' +
        'T'#39';'
      '11078570=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11078571=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11078572=begin'
      
        '11078573=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11078574=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '11078575=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11078576=                      FROM G_PRODUCT G'
      
        '11078577=                     WHERE UPPER(G.ARTICUL) = UPPER(TRI' +
        'M(:ARTICUL_))'
      '11078578=                       AND TRIM(G.ARTICUL) <> '#39#39
      '11078579=                       AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078580=          ERR_CODE = -20500;'
      
        '11078581=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      '11078582=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11078583=          EXIT;'
      '11078584=        END'
      '11078585=    end'
      '11078586='
      '11078587=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '11078588=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then ' +
        'begin'
      '11078589=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11078590=                     FROM G_PRODUCT G'
      
        '11078591=                    WHERE UPPER(G.NOMENCLATUR_NUM) = UP' +
        'PER(TRIM(:NOMENCLATUR_NUM_))'
      '11078592=                      AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11078593=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078594=          ERR_CODE = -20500;'
      
        '11078595=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RE' +
        'TURNING_VALUES (:ERR_MSG);'
      '11078596=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11078597=          EXIT;'
      '11078598=        END'
      '11078599=    end'
      '11078600='
      '11078601=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11078602=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11078603=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '11078604=                      FROM G_PRODUCT G'
      
        '11078605=                     WHERE UPPER(G.BARCODE) = UPPER(TRI' +
        'M(:BARCODE_))'
      '11078606=                       AND TRIM(G.BARCODE) <> '#39#39
      '11078607=                       AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078608=          ERR_CODE = -20500;'
      
        '11078609=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11078610=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11078611=          EXIT;'
      '11078612=        END'
      '11078613='
      '11078614=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '11078615=                     FROM G_PRODUCT G, LT_BARCODE L'
      '11078616=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11078617=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '11078618=                      AND TRIM(L.BARCODE) <> '#39#39
      '11078619=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078620=          ERR_CODE = -20500;'
      
        '11078621=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072 +
        #1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '11078622=          ERR_MSG = PROCNAME||ERR_MSG;'
      '11078623=          EXIT;'
      '11078624=        END'
      '11078625=    end'
      '11078626='
      
        '11078627=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PRI' +
        'CE,'
      
        '11078628=                           IS_CATEGORY, PACK_AMOUNT, MF' +
        '_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM' +
        ', KOD_TNVD,'
      '11078629=                           FAST_TOVAR)'
      
        '11078630=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_, ' +
        ':ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRIC' +
        'E_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '11078631=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROSS' +
        'CODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNVD_' +
        ','
      '11078632=            :FAST_TOVAR_)'
      '11078633=    RETURNING G_PRODUCT'
      '11078634=    INTO :G_PRODUCT_;'
      '11078635='
      '11078636=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '11078637=    if (:IS_CATEGORY_ = 0) then begin'
      
        '11078638=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11078639=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '11078640='
      '11078641=        INSERT INTO LT_BARCODE'
      
        '11078642=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT' +
        '_BARCODE_TMP;'
      '11078643='
      
        '11078644=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086 +
        #1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '11078645=        INSERT into G_PRODUCT_IMAGE'
      
        '11078646=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYPE' +
        ' from G_PRODUCT_IMAGE_TMP;'
      '11078647='
      
        '11078648=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089#1090 +
        #1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '11078649=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091#1082 +
        #1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '11078650=        IF (is_kit_ > 0) THEN begin'
      '11078651=            INSERT INTO G_PRODUCT_KIT'
      
        '11078652=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP;'
      '11078653='
      '11078654=            if (is_kit_ = 1) then begin'
      
        '11078655=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE' +
        ')/K.amount)'
      '11078656=                  FROM G_PRODUCT_KIT K,'
      '11078657=                       LT_SKLAD_PRODUCT L'
      '11078658=                 WHERE K.g_product = :G_PRODUCT_'
      '11078659=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11078660=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11078661=                 GROUP BY K.G_PRODUCT'
      '11078662=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11078663='
      '11078664=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11078665=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_S' +
        'OSTAV_AMOUNT_, 0)'
      '11078666=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11078667=            end'
      '11078668=        END'
      '11078669=    END'
      '11078670=end'
      '11078671=;'
      '11078672='
      '11078673=ALTER PROCEDURE G_UPD_G_CLIENT('
      '11078674=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11078675=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      '11078676=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '11078677=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11078678=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11078679=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '11078680=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '11078681=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '11078682=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11078683=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11078684=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '11078685=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '11078686=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '11078687=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '11078688=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11078689=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11078690=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11078691=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11078692=  NOTIFY_SKIDKA_ INTEGER,'
      '11078693=  NOTIFY_DR_ INTEGER,'
      '11078694=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '11078695=  G_CLIENT_PROMO_ INTEGER,'
      
        '11078696=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONUS' +
        '_PAY_SUMM)'
      '11078697=RETURNS ('
      '11078698=  ERR_CODE INTEGER,'
      '11078699=  ERR_MSG VARCHAR(1024))'
      '11078700=AS'
      '11078701=DECLARE VARIABLE CNT_ INTEGER;'
      '11078702=BEGIN'
      
        '11078703=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1, ' +
        #1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11078704=  if (BY_DEFAULT_ = 1) then'
      '11078705=    UPDATE g_client'
      '11078706=       SET BY_DEFAULT = 0'
      '11078707=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11078708='
      '11078709=  UPDATE g_client'
      '11078710=  SET'
      
        '11078711=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CLIE' +
        'NT_PARENT),'
      
        '11078712=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTRAG' +
        'ENT),'
      '11078713=   NAME = COALESCE(:NAME_, NAME),'
      '11078714=   IDN  = COALESCE(:IDN_, IDN),'
      '11078715=   KBE  = COALESCE(:KBE_, KBE),'
      '11078716=   PHONE = COALESCE(:PHONE_, PHONE),'
      '11078717=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '11078718=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      '11078719=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER),'
      '11078720=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '11078721=   ,DT    = COALESCE(:DT_, DT)'
      '11078722=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '11078723=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '11078724=   ,G_PROMOTION = :G_PROMOTION_'
      '11078725=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '11078726=   ,NOTIFY_DR = :NOTIFY_DR_'
      '11078727=   ,MAX_BONUS_PAY_SUMM = :MAX_BONUS_PAY_SUMM_'
      '11078728=  WHERE'
      '11078729=    g_client = :g_client_;'
      '11078730='
      '11078731=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '11078732=    IF (TRIM(BARCODE_) <> '#39#39') then BEGIN'
      '11078733=        IF (EXISTS(SELECT FIRST 1 G_DISCONT_CARD'
      '11078734=                     FROM G_DISCONT_CARD'
      '11078735=                    WHERE BARCODE = :BARCODE_'
      
        '11078736=                      AND G_CLIENT <> :G_CLIENT_)) THEN' +
        ' BEGIN'
      '11078737=          ERR_CODE = -20500;'
      
        '11078738=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1050#1072#1088#1090 +
        #1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39'||BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '11078739=          EXIT;'
      '11078740=        END'
      '11078741=    END'
      '11078742='
      '11078743=    UPDATE G_DISCONT_CARD G'
      '11078744=    SET G.BARCODE = :BARCODE_,'
      '11078745=        G.N_PERCENT = :N_PERCENT_,'
      '11078746=        G.summ = COALESCE(G.summ, 0),'
      '11078747=        G.summ_all = COALESCE(G.summ_all, 0)'
      '11078748=    WHERE G.G_CLIENT = :g_client_;'
      '11078749='
      '11078750=    if (ROW_COUNT = 0) then'
      
        '11078751=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_CLI' +
        'ENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11078752=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIENT_' +
        ', :BARCODE_, :N_PERCENT_, 0, (select Coalesce(sum(SUMM_FACT), 0)' +
        ' from zakaz where g_client = :g_client_));'
      '11078753=  END'
      '11078754=end'
      '11078755=;'
      '11078756='
      '11078757=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '11078758=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '11078759=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11078760=  ARTICUL_ VARCHAR(30),'
      '11078761=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11078762=  BARCODE_ VARCHAR(30),'
      '11078763=  NAME_ VARCHAR(500),'
      '11078764=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11078765=  PRICE_ NUMERIC(15,2),'
      '11078766=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11078767=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11078768=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11078769=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11078770=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11078771=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11078772=  IS_CATEGORY_ INTEGER,'
      '11078773=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11078774=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11078775=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11078776=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11078777=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR)'
      '11078778=RETURNS ('
      '11078779=  ERR_CODE INTEGER,'
      '11078780=  ERR_MSG VARCHAR(1024))'
      '11078781=AS'
      
        '11078782=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODUC' +
        'T'#39';'
      
        '11078783=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11078784=begin'
      
        '11078785=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11078786=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '11078787=                  FROM G_PRODUCT G'
      
        '11078788=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:A' +
        'RTICUL_))'
      '11078789=                   AND TRIM(G.ARTICUL) <> '#39#39
      '11078790=                   AND TRIM(:ARTICUL_) <> '#39#39
      '11078791=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11078792=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078793=      ERR_CODE = -20500;'
      
        '11078794=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:ER' +
        'R_MSG);'
      '11078795=      EXIT;'
      '11078796=    END'
      '11078797='
      '11078798=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11078799=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11078800=                  FROM G_PRODUCT G'
      
        '11078801=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER' +
        '(TRIM(:NOMENCLATUR_NUM_))'
      '11078802=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11078803=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '11078804=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11078805=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078806=      ERR_CODE = -20500;'
      
        '11078807=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURN' +
        'ING_VALUES (:ERR_MSG);'
      '11078808=      EXIT;'
      '11078809=    END'
      '11078810='
      '11078811=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11078812=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11078813=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11078814=                  FROM G_PRODUCT G'
      
        '11078815=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(:B' +
        'ARCODE_))'
      '11078816=                   AND TRIM(G.BARCODE) <> '#39#39
      '11078817=                   AND TRIM(:BARCODE_) <> '#39#39
      '11078818=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11078819=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078820=          ERR_CODE = -20500;'
      
        '11078821=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '11078822=          EXIT;'
      '11078823=        END'
      '11078824='
      '11078825=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '11078826=                    FROM G_PRODUCT G, LT_BARCODE L'
      '11078827=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11078828=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '11078829=                     AND TRIM(L.BARCODE) <> '#39#39
      '11078830=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11078831=          ERR_CODE = -20500;'
      
        '11078832=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '11078833=          EXIT;'
      '11078834=        END'
      '11078835=    END'
      '11078836='
      '11078837=    update G_PRODUCT'
      '11078838=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '11078839=        ARTICUL = :ARTICUL_,'
      '11078840=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '11078841=        BARCODE = :BARCODE_,'
      '11078842=        NAME = :NAME_,'
      '11078843=        G_UNIT = :G_UNIT_,'
      '11078844=        PRICE = :PRICE_,'
      '11078845=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '11078846=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '11078847=        MF_COUNTRY   = :MF_COUNTRY_,'
      '11078848=        NOTE         = :NOTE_,'
      '11078849=        CROSSCODE    = :CROSSCODE_,'
      '11078850=        IS_KIT       = :IS_KIT_,'
      '11078851=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '11078852=        PLACE        = :PLACE_,'
      '11078853=        SALES_COMM   = :SALES_COMM_,'
      '11078854=        KOD_TNVD     = :KOD_TNVD_,'
      '11078855=        FAST_TOVAR   = :FAST_TOVAR_'
      '11078856=    where (G_PRODUCT = :G_PRODUCT_);'
      '11078857='
      '11078858=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '11078859=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '11078860='
      '11078861=        INSERT INTO LT_BARCODE'
      
        '11078862=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT' +
        '_BARCODE_TMP;'
      '11078863='
      '11078864=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '11078865=        INSERT INTO G_PRODUCT_IMAGE'
      
        '11078866=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT E' +
        'XISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.G' +
        '_PRODUCT_IMAGE);'
      '11078867='
      
        '11078868=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS ' +
        '(SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_P' +
        'RODUCT_IMAGE)'
      '11078869=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '11078870='
      '11078871=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '11078872=        IF (IS_KIT_ > 0) THEN BEGIN'
      '11078873=            INSERT INTO G_PRODUCT_KIT'
      
        '11078874=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP T'
      
        '11078875=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_K' +
        'IT'
      
        '11078876=                               WHERE G_PRODUCT_ITEM = T' +
        '.G_PRODUCT_ITEM'
      
        '11078877=                                 AND G_PRODUCT = T.g_pr' +
        'oduct);'
      '11078878='
      
        '11078879=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_PR' +
        'ODUCT_ITEM)'
      '11078880=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '11078881='
      '11078882=            UPDATE G_PRODUCT_KIT G'
      
        '11078883=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '11078884=                   G.PRICE  = (SELECT PRICE FROM G_PROD' +
        'UCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '11078885=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT_' +
        'TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AMO' +
        'UNT or PRICE <> G.PRICE))'
      '11078886=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '11078887='
      
        '11078888=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090 +
        #1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '11078889=            if (is_kit_ = 1) then begin'
      '11078890=                SELECT MIN(L.AMOUNT)'
      '11078891=                  FROM G_PRODUCT_KIT K,'
      '11078892=                       LT_SKLAD_PRODUCT L'
      '11078893=                 WHERE K.g_product = :G_PRODUCT_'
      '11078894=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11078895=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11078896=                 GROUP BY K.G_PRODUCT'
      '11078897=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11078898='
      '11078899=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11078900=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMO' +
        'UNT_'
      '11078901=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11078902=            end'
      '11078903=        END'
      '11078904=    END'
      '11078905=end'
      '11078906=;'
      '11078907='
      '11078908=ALTER PROCEDURE GET_FREE_ARTICUL'
      '11078909=RETURNS ('
      '11078910=  ARTICUL_ VARCHAR(10))'
      '11078911=AS'
      '11078912=/*'#1058#1077#1084#1077#1082#1086#1074' '#1040'.'#1040'. 01.02.2015'
      '11078913=  '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1057#1042#1054#1041#1054#1044#1053#1067#1049' '#1040#1056#1058#1048#1050#1059#1051
      
        '11078914=  '#1063#1058#1054#1041#1067' '#1055#1056#1054#1057#1058#1054' '#1058#1040#1050' '#1053#1045' '#1043#1045#1053#1045#1056#1048#1058#1068' '#1040#1056#1058#1048#1050#1059#1051' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' - '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1042#1045#1056#1071#1058#1068', '#1040' '#1053#1045#1058' '#1051#1048' '#1042' '#1041#1040#1047#1045' '#1058#1045#1050#1059#1065#1045#1043#1054' '#1040#1056#1058#1048#1050#1059#1051#1040', '#1045#1057#1051#1048' '#1053#1045#1058', '#1058#1054' '#1055#1056#1054 +
        #1057#1058#1054' '#1042#1067#1044#1040#1070' '#1045#1043#1054'.'
      
        '11078915=  '#1042#1045#1044#1068' '#1052#1054#1043#1059#1058' '#1053#1040#1046#1040#1058#1068' '#1050#1053#1054#1055#1050#1059' '#1044#1054#1041#1040#1042#1048#1058#1068', '#1040#1056#1058#1048#1050#1059#1051' '#1057#1043#1045#1053#1045#1056#1048#1058#1057#1071 +
        ', '#1053#1054' "'#1054#1050'" '#1053#1045' '#1053#1040#1046#1040#1058#1068' '#1048' '#1058#1054#1042#1040#1056' '#1053#1045' '#1044#1054#1041#1040#1042#1048#1058#1057#1071', '#1040' '#1040#1056#1058#1048#1050#1059#1051' '#1057#1043#1045#1053#1045#1056#1048#1051#1057#1071' '#1055 +
        #1054#1063#1045#1052' '#1047#1056#1071
      '11078916=  */'
      '11078917=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '11078918=BEGIN'
      '11078919=  IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11078920=                FROM G_PRODUCT G'
      
        '11078921=               WHERE G.ARTICUL = LPAD(CAST(GEN_ID(GEN_A' +
        'RTICUL,  0) AS VARCHAR(10)), 9, '#39'0'#39'))) THEN'
      
        '11078922=    ARTICUL_ = LPAD(CAST(GEN_ID(GEN_ARTICUL,  1) AS VAR' +
        'CHAR(10)), 9, '#39'0'#39');'
      '11078923=  ELSE'
      
        '11078924=    ARTICUL_ = LPAD(CAST(GEN_ID(GEN_ARTICUL,  0) AS VAR' +
        'CHAR(10)), 9, '#39'0'#39');'
      '11078925=end'
      '11078926=;'
      '11078927='
      '11078928=ALTER PROCEDURE GET_SYS_PARAM_COUNT('
      '11078929=  MODE_ INTEGER,'
      '11078930=  PARAM1_ INTEGER)'
      '11078931=RETURNS ('
      '11078932=  PARAM1_OUT_ DM_BIGINT,'
      '11078933=  PARAM2_OUT_ DM_BIGINT,'
      '11078934=  PARAM1_STR_OUT_ VARCHAR(50),'
      '11078935=  PARAM2_STR_OUT_ VARCHAR(50))'
      '11078936=AS'
      '11078937=/*'
      '11078938='#1045#1057#1051#1048' MODE_ = 0'
      
        '11078939='#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1055#1056#1048' '#1047#1040#1055#1059#1057#1050#1045' '#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071', '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045#1049 +
        ' '#1041#1054#1051#1068#1064#1045' '#1054#1044#1053#1054#1043#1054','
      
        '11078940='#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043#1054' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054#1043#1044#1040' '#1042#1067#1044#1040 +
        #1042#1040#1058#1068' '#1054#1050#1053#1054' '#1057' '#1042#1067#1041#1054#1056#1054#1052' '#1051#1054#1043#1048#1053#1040'/'#1055#1040#1056#1054#1051#1071'.'
      
        '11078941='#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045#1049' '#1053#1045#1058', '#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043#1054' ' +
        #1053#1045' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054' '#1054#1050#1053#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      '11078942='
      '11078943='#1045#1057#1051#1048' MODE_ = 1'
      
        '11078944='#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1050#1051#1040#1044#1054#1042' '#1048' '#1042#1067#1044#1040#1045#1058#1057#1071' '#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052#1054#1051 +
        #1063#1040#1053#1048#1070'.'
      
        '11078945='#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1048#1065#1059' '#1055#1054' '#1070#1047#1045#1056#1059', '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1046#1059', '#1058#1054' '#1057#1058#1040 +
        #1042#1051#1070' '#1057#1050#1051#1040#1044' 1'
      '11078946=*/'
      '11078947=BEGIN'
      '11078948='
      '11078949=  IF (MODE_ = 0) THEN BEGIN'
      '11078950=      SELECT COUNT(*)'
      '11078951=        FROM G_OFFICIAL G'
      '11078952=        INTO :PARAM1_OUT_;'
      '11078953='
      '11078954=      if (PARAM1_OUT_ = 1) then'
      '11078955=        SELECT G.PASS'
      '11078956=          FROM G_OFFICIAL G'
      '11078957=          INTO :PARAM1_STR_OUT_;'
      '11078958='
      '11078959=  END ELSE BEGIN'
      '11078960=    SELECT COUNT(*)'
      '11078961=      FROM G_TOCHKA G'
      '11078962=      INTO :PARAM1_OUT_;'
      '11078963='
      '11078964=    IF (PARAM1_OUT_ > 1) THEN BEGIN'
      '11078965=      SELECT G.G_TOCHKA'
      '11078966=        FROM G_OFFICIAL G'
      
        '11078967=       WHERE G.G_OFFICIAL = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 1)'
      '11078968=        INTO :PARAM2_OUT_;'
      '11078969='
      '11078970=      if (COALESCE(PARAM2_OUT_, 0)  = 0) then'
      '11078971=        PARAM2_OUT_ = 1;'
      '11078972=    END'
      '11078973=  END'
      '11078974=END'
      '11078975=;'
      
        '11078976=UPDATE SYSTEM_SETUP SET S_VALUE = 11078 WHERE SYSTEM_SE' +
