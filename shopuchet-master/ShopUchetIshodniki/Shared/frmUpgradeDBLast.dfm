      '110228407='
      '110228408=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110228409=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
