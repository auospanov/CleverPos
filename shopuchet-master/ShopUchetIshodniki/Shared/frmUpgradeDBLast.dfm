      '1106016584=                     G.PLACE = :PLACE_,'
      
        '1106016585=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1106016586=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1106016587=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '1106016588=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1106016589='
      
        '1106016590=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1106016591=            END ELSE'
      
        '1106016592=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1106016593=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1106016594=        END'
      '1106016595=    end'
      '1106016596='
      
        '1106016597=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1106016598=    PNT_ = '#39'02b'#39';'
      
        '1106016599=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1106016600=        SELECT G.G_PRODUCT,'
      '1106016601=               G.NAME'
      '1106016602=          FROM G_PRODUCT G'
      '1106016603=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1106016604=           AND TRIM(G.BARCODE) <> '#39#39
      '1106016605=          INTO :G_PRODUCT_,'
      '1106016606=               :G_PRODUCT_NAME_;'
      '1106016607='
      '1106016608=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1106016609=          SELECT G.G_PRODUCT,'
      '1106016610=                 G.NAME'
      '1106016611=            FROM G_PRODUCT G, LT_BARCODE L'
      '1106016612=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1106016613=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1106016614=             AND TRIM(L.BARCODE) <> '#39#39
      '1106016615=            INTO :G_PRODUCT_,'
      '1106016616=                 :G_PRODUCT_NAME_;'
      '1106016617='
      
        '1106016618=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1106016619=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1106016620=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1106016621=              UPDATE G_PRODUCT G'
      '1106016622=                 SET G.NAME = :NAME_,'
      '1106016623=                     G.G_UNIT = :G_UNIT_,'
      '1106016624=                     G.PRICE  = :PRICE_,'
      '1106016625=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1106016626=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1106016627=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1106016628=                     G.PLACE = :PLACE_,'
      
        '1106016629=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1106016630=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1106016631=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '1106016632=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1106016633='
      
        '1106016634=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1106016635=            END ELSE'
      
        '1106016636=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1106016637=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1106016638=        END'
      
        '1106016639=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1106016640=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1106016641='
      '1106016642=    PNT_ = '#39'02b'#39';'
      '1106016643=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '1106016644=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1106016645=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE)'
      
        '1106016646=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_' +
        'PAR_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_,' +
        ' :PRICE_,'
      
        '1106016647=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_)'
      '1106016648=        returning G_PRODUCT'
      '1106016649=        into :G_PRODUCT_;'
      '1106016650='
      
        '1106016651=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1106016652=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_);'
      '1106016653=    end'
      '1106016654='
      
        '1106016655=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106016656=    PNT_ = '#39'03'#39';'
      '1106016657=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1106016658=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1106016659=                                       :AMOUNT_,'
      '1106016660=                                       :SELF_PRICE_,'
      
        '1106016661=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1106016662=                                       0, --nds_,'
      '1106016663=                                       0 --nds_summ_,'
      
        '1106016664=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1106016665=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1106016666=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1106016667=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1106016668=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1106016669=          EXIT;'
      '1106016670=        END'
      '1106016671=    END'
      '1106016672='
      
        '1106016673=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1106016674=    PNT_ = '#39'04'#39';'
      '1106016675=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1106016676=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1106016677=        FROM SKLAD_TMP T'
      '1106016678=        INTO :CNT_;'
      '1106016679='
      '1106016680=      if (CNT_ > 0) then BEGIN'
      '1106016681=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1106016682=          FROM SKLAD_TMP T'
      '1106016683=          INTO :SUMM_, :SUMM_UE_;'
      '1106016684='
      '1106016685=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1106016686=                                DATE_RECEIPT,'
      '1106016687=                                TIME_RECEIPT,'
      '1106016688=                                G_CLIENT,'
      '1106016689=                                G_PAYMENT_TYPE,'
      '1106016690=                                OSNOVANIE,'
      '1106016691=                                NOTE,'
      '1106016692=                                SUMM,'
      '1106016693=                                SUMM_FACT,'
      '1106016694=                                SUMM_CURRENCY,'
      '1106016695=                                IS_PAYED_ALL,'
      '1106016696=                                IS_VOZVRAT,'
      '1106016697=                                G_TOCHKA)'
      '1106016698=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1106016699=                CURRENT_DATE,'
      '1106016700=                CURRENT_TIME,'
      '1106016701=                :G_CLIENT_,'
      '1106016702=                1,'
      '1106016703=                NULL,  --:OSNOVANIE_,'
      '1106016704=                NULL,  -- :NOTE_,'
      '1106016705=                :SUMM_,'
      '1106016706=                :SUMM_,'
      '1106016707=                :SUMM_UE_,'
      
        '1106016708=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1106016709=                0,'
      '1106016710=                :G_TOCHKA_)'
      '1106016711=        RETURNING'
      '1106016712=          SKLAD'
      '1106016713=        INTO'
      '1106016714=          :SKLAD_PARENT_;'
      '1106016715='
      '1106016716=        PNT_ = '#39'05'#39';'
      '1106016717=        FOR SELECT SKLAD,'
      '1106016718=                   G_PRODUCT,'
      '1106016719=                   AMOUNT,'
      '1106016720=                   PRICE,'
      '1106016721=                   SUMM'
      '1106016722=                   ,PRICE_CURRENCY'
      '1106016723=                   ,SUMM_CURRENCY'
      '1106016724=              FROM SKLAD_TMP'
      '1106016725=             ORDER BY 1'
      '1106016726=              INTO :SKLAD_TMP_,'
      '1106016727=                   :RG_PRODUCT_,'
      '1106016728=                   :RAMOUNT_,'
      '1106016729=                   :RPRICE_,'
      '1106016730=                   :RSUMM_'
      '1106016731=                   ,:RPRICE_UE_'
      '1106016732=                   ,:RSUMM_UE_'
      '1106016733=        DO BEGIN'
      '1106016734='
      '1106016735=            UPDATE SKLAD SK'
      '1106016736=               SET SK.IS_LAST = 0'
      '1106016737=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1106016738=               AND SK.IS_LAST = 1;'
      '1106016739='
      '1106016740=            INSERT INTO SKLAD'
      '1106016741=            ('
      '1106016742=             SKLAD,'
      '1106016743=             SKLAD_PARENT,'
      '1106016744=             DATE_RECEIPT,'
      '1106016745=             G_CLIENT,'
      '1106016746=             G_PRODUCT,'
      '1106016747=             AMOUNT,'
      '1106016748=             PRICE,'
      '1106016749=             SUMM,'
      '1106016750=             G_PAYMENT_TYPE,'
      '1106016751=             OSNOVANIE,'
      '1106016752=             NOTE,'
      '1106016753=             NDS,'
      '1106016754=             NDS_SUMM,'
      '1106016755=             IS_LAST,'
      '1106016756=             IS_VOZVRAT,'
      '1106016757=             G_TOCHKA'
      '1106016758=             ,PRICE_CURRENCY'
      '1106016759=             ,SUMM_CURRENCY'
      '1106016760=            ) VALUES ('
      '1106016761=             :SKLAD_TMP_,'
      '1106016762=             :SKLAD_PARENT_,'
      '1106016763=             CURRENT_DATE,'
      '1106016764=             :G_CLIENT_,'
      '1106016765=             :RG_PRODUCT_,'
      '1106016766=             :RAMOUNT_,'
      '1106016767=             :RPRICE_,'
      '1106016768=             :RSUMM_,'
      '1106016769=             1,       --:G_PAYMENT_TYPE_,'
      '1106016770=             NULL,    --:OSNOVANIE_,'
      '1106016771=             NULL,    --:NOTE_,'
      '1106016772=             0,       --:RNDS_,'
      '1106016773=             0,       --:RNDS_SUMM_,'
      '1106016774=             1,       --IS_LAST_'
      '1106016775=             0,        --:IS_VOZVRAT_'
      '1106016776=             :G_TOCHKA_'
      '1106016777=             ,:RPRICE_UE_'
      '1106016778=             ,:RSUMM_UE_'
      '1106016779=            );'
      '1106016780='
      
        '1106016781=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1106016782=            PNT_ = '#39'06'#39';'
      '1106016783=            UPDATE LT_SKLAD_PRODUCT L'
      '1106016784=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1106016785=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1106016786=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106016787='
      '1106016788=            PNT_ = '#39'06a'#39';'
      '1106016789=            IF (ROW_COUNT = 0) THEN'
      
        '1106016790=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1106016791=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '1106016792=        END'
      '1106016793='
      '1106016794=        PNT_ = '#39'07'#39';'
      
        '1106016795=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106016796=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1106016797=                                :SUMM_,'
      '1106016798=                                CURRENT_DATE,'
      
        '1106016799=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1106016800=                                NULL,   --ZAKAZ_'
      '1106016801=                                :SKLAD_PARENT_,'
      '1106016802=                                1,'
      
        '1106016803=                                :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106016804=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106016805=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1106016806=          EXIT;'
      '1106016807=        END'
      '1106016808='
      '1106016809=        DELETE FROM SKLAD_TMP;'
      '1106016810=      END'
      '1106016811=    END'
      '1106016812='
      
        '1106016813=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1106016814=    if (ERR_MSG_ IS NOT NULL) then'
      '1106016815=      ERR_MSG = ERR_MSG_;'
      '1106016816='
      '1106016817=WHEN ANY DO BEGIN'
      '1106016818=    Err_code = gdscode;'
      
        '1106016819=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1106016820=  END'
      '1106016821=END'
      '1106016822=;'
      '1106016823='
      '1106016824=ALTER PROCEDURE G_INS_G_ACCOUNT('
      '1106016825=  ACCOUNT_ TYPE OF COLUMN G_ACCOUNT.ACCOUNT,'
      '1106016826=  G_CLIENT_ TYPE OF COLUMN G_ACCOUNT.G_CLIENT,'
      '1106016827=  G_BANK_ TYPE OF COLUMN G_ACCOUNT.G_BANK,'
      '1106016828=  IS_DEFAULT_ TYPE OF COLUMN G_ACCOUNT.IS_DEFAULT)'
      '1106016829=RETURNS ('
      '1106016830=  G_ACCOUNT_ TYPE OF COLUMN G_ADDRESS.G_ADDRESS,'
      '1106016831=  ERR_CODE INTEGER,'
      '1106016832=  ERR_MSG VARCHAR(1024))'
      '1106016833=AS'
      '1106016834=declare variable CNT_ integer;'
      '1106016835=begin'
      '1106016836=  CNT_ = 0;'
      
        '1106016837=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 0, '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070', '#1045#1057#1051#1048' '#1055#1054' '#1042#1057#1045#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' '#1053#1048#1043#1044#1045' '#1053#1045' '#1057#1058#1054#1048#1058' IS_DEFAULT = 1, '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1069#1058#1054' '#1047#1040#1055#1048#1057#1048
      '1106016838=  IF (:IS_DEFAULT_ = 0) THEN'
      '1106016839=    SELECT COUNT(*)'
      '1106016840=      FROM G_ACCOUNT G'
      '1106016841=     WHERE G.IS_DEFAULT = 1'
      '1106016842=       AND G.G_CLIENT = :G_CLIENT_'
      '1106016843=    INTO CNT_;'
      '1106016844='
      
        '1106016845=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106016846=  else IF (:IS_DEFAULT_ = 1) THEN'
      '1106016847=    UPDATE G_ACCOUNT G'
      '1106016848=       SET G.IS_DEFAULT = 0'
      '1106016849=     WHERE G.G_CLIENT = :G_CLIENT_;'
      '1106016850='
      
        '1106016851=  insert into G_ACCOUNT (G_ACCOUNT, ACCOUNT, G_CLIENT' +
        ', G_BANK, IS_DEFAULT)'
      '1106016852=  values (GEN_ID(GEN_G_ACCOUNT, 1),'
      '1106016853=            :ACCOUNT_,'
      '1106016854=            :G_CLIENT_,'
      '1106016855=            :G_BANK_,'
      '1106016856=            DECODE(:CNT_,'
      '1106016857=                   0, 1,'
      '1106016858=                   1, :IS_DEFAULT_))'
      '1106016859=  returning G_ACCOUNT'
      '1106016860=  into :G_ACCOUNT_;'
      '1106016861=end'
      '1106016862=;'
      '1106016863='
      '1106016864=ALTER PROCEDURE G_INS_G_ADDRESS('
      
        '1106016865=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_ADDRESS.G_ADDRESS_' +
        'TYPE,'
      '1106016866=  G_CLIENT_ TYPE OF COLUMN G_ADDRESS.G_CLIENT,'
      '1106016867=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '1106016868=  PHONE_ TYPE OF COLUMN G_ADDRESS.PHONE,'
      '1106016869=  FAX_ TYPE OF COLUMN G_ADDRESS.FAX,'
      '1106016870=  EMAIL_ TYPE OF COLUMN G_ADDRESS.EMAIL,'
      '1106016871=  WEBSITE_ TYPE OF COLUMN G_ADDRESS.WEBSITE,'
      '1106016872=  IS_DEFAULT_ TYPE OF COLUMN G_ADDRESS.IS_DEFAULT)'
      '1106016873=RETURNS ('
      '1106016874=  G_ADDRESS_ TYPE OF COLUMN G_ADDRESS.G_ADDRESS,'
      '1106016875=  ERR_CODE INTEGER,'
      '1106016876=  ERR_MSG VARCHAR(1024))'
      '1106016877=AS'
      '1106016878=declare variable CNT_ integer;'
      '1106016879=begin'
      '1106016880=  CNT_ = 0;'
      
        '1106016881=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 0, '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070', '#1045#1057#1051#1048' '#1055#1054' '#1042#1057#1045#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' '#1053#1048#1043#1044#1045' '#1053#1045' '#1057#1058#1054#1048#1058' IS_DEFAULT = 1, '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1069#1058#1054' '#1047#1040#1055#1048#1057#1048
      '1106016882=  IF (:IS_DEFAULT_ = 0) THEN'
      '1106016883=        SELECT COUNT(*)'
      '1106016884=          FROM G_ADDRESS G'
      '1106016885=         WHERE G.IS_DEFAULT = 1'
      '1106016886=           AND G.G_CLIENT = :G_CLIENT_'
      '1106016887=        INTO CNT_;'
      '1106016888='
      
        '1106016889=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106016890=  ELSE IF (:IS_DEFAULT_ = 1) THEN'
      '1106016891=        UPDATE G_ADDRESS G'
      '1106016892=           SET G.IS_DEFAULT = 0'
      '1106016893=         WHERE G.G_CLIENT = :G_CLIENT_;'
      '1106016894='
      
        '1106016895=  insert into G_ADDRESS (G_ADDRESS, G_ADDRESS_TYPE, G' +
        '_CLIENT, ADDRESS, PHONE, FAX, EMAIL, WEBSITE, IS_DEFAULT)'
      '1106016896=  values (GEN_ID(GEN_G_ADDRESS, 1),'
      '1106016897=            :G_ADDRESS_TYPE_,'
      '1106016898=            :G_CLIENT_,'
      '1106016899=            :ADDRESS_,'
      '1106016900=            :PHONE_,'
      '1106016901=            :FAX_,'
      '1106016902=            :EMAIL_,'
      '1106016903=            :WEBSITE_,'
      '1106016904=            DECODE(:CNT_, 0, 1, :IS_DEFAULT_))'
      '1106016905=  RETURNING'
      '1106016906=    G_ADDRESS'
      '1106016907=  INTO'
      '1106016908=    :G_ADDRESS_;'
      '1106016909=end'
      '1106016910=;'
      '1106016911='
      '1106016912=ALTER PROCEDURE G_INS_G_APPOINTMENT('
      '1106016913=  NAME_ TYPE OF COLUMN G_APPOINTMENT.NAME)'
      '1106016914=RETURNS ('
      
        '1106016915=  G_APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.G_APPOI' +
