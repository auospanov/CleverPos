      '110153266=  SUMM_DEBET_CONTR TYPE OF COLUMN SKLAD.SUMM,'
      '110153267=  SUMM_CREDIT_CONTR TYPE OF COLUMN SKLAD.SUMM)'
      '110153268=AS'
      
        '110153269=DECLARE VARIABLE IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.' +
        'IS_SUPPLIER;'
      '110153270=DECLARE VARIABLE ID TYPE OF COLUMN CUR_PARAMS.ID;'
      '110153271=DECLARE VARIABLE ROW INTEGER;'
      '110153272=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '110153273=DECLARE VARIABLE SUMM_IN_DEBET_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM;'
      
        '110153274=DECLARE VARIABLE SUMM_IN_CREDIT_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '110153275=DECLARE VARIABLE SUMM_IN_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM;'
      
        '110153276=DECLARE VARIABLE SUMM_OUT_DEBET_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '110153277=DECLARE VARIABLE SUMM_OUT_CREDIT_ TYPE OF COLUMN SKLAD' +
        '_PARENT.SUMM;'
      
        '110153278=DECLARE VARIABLE SUMM_OUT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110153279=DECLARE VARIABLE SUMM_OUT_1 TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      
        '110153280=DECLARE VARIABLE SUMM_OUT_2 TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      '110153281=DECLARE VARIABLE CURR_STR_ VARCHAR(5);'
      '110153282=DECLARE VARIABLE SORT_ROW DATE;'
      '110153283=BEGIN'
      '110153284=  CLRF = ascii_char( 10 );'
      '110153285='
      '110153286=  if (CURRENCY_ = 0) then'
      '110153287=    CURR_STR_ = '#39' KZT'#39';'
      '110153288=  else if (CURRENCY_ = 1) then'
      '110153289=    CURR_STR_ = '#39' '#1088#1091#1073'.'#39';'
      '110153290=  else if (CURRENCY_ = 2) then'
      '110153291=    CURR_STR_ = '#39' '#1075#1088#1085'.'#39';'
      '110153292=  else if (CURRENCY_ = 3) then'
      '110153293=    CURR_STR_ = '#39' '#1089#1091#1084#39';'
      '110153294=  else if (CURRENCY_ = 4) then'
      '110153295=    CURR_STR_ = '#39' '#1089#1086#1084#39';'
      '110153296=  else if (CURRENCY_ = 5) then'
      '110153297=    CURR_STR_ = '#39' '#1076#1088#1072#1084#39';'
      '110153298='
      '110153299=  if (G_OFFICIAL_NAME_ IS NULL) then BEGIN'
      '110153300=      SELECT J.FIO_DOC'
      '110153301=        FROM G_OFFICIAL J'
      '110153302=       WHERE J.IS_RUKOVODITEL = 1'
      '110153303=        INTO G_OFFICIAL_NAME_;'
      '110153304='
      '110153305=      if (G_OFFICIAL_NAME_ IS NULL) then'
      '110153306=        SELECT J.FIO_DOC'
      '110153307=          FROM G_OFFICIAL J'
      
        '110153308=         WHERE J.G_OFFICIAL = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 1)'
      '110153309=         INTO G_OFFICIAL_NAME_;'
      '110153310=  END'
      '110153311='
      '110153312=  CLIENT_NAME_OUT_  = CLIENT_NAME_IN_;'
      '110153313=  FIRM_NAME_OUT_    = FIRM_NAME_IN_;'
      '110153314='
      
        '110153315=  if (TRIM(G_OFFICIAL_NAME_) IS NULL or TRIM(G_OFFICIA' +
        'L_NAME_) = '#39#39') then'
      '110153316=    G_OFFICIAL_NAME_ = '#39'________________'#39';'
      '110153317='
      
        '110153318=  if (TRIM(CLIENT_DIR_NAME_IN_) IS NULL or TRIM(CLIENT' +
        '_DIR_NAME_IN_) = '#39#39') then'
      '110153319=    CLIENT_DIR_NAME_IN_ = '#39'________________'#39';'
      '110153320='
      
        '110153321=  STR1_ = '#39#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1079#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRA' +
        'CT(DAY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM ' +
        'DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'
      
        '110153322=          '#39' '#1087#1086' '#39'||lpad(EXTRACT(DAY FROM DATE_END_), 2,' +
        ' '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EX' +
        'TRACT(YEAR FROM DATE_END_)||clrf||'
      '110153323=          '#39' '#1084#1077#1078#1076#1091' '#39'||FIRM_NAME_OUT_||clrf||'
      '110153324=          '#39' '#1080' '#39'||CLIENT_NAME_OUT_;'
      '110153325='
      
        '110153326=  STR2_ = '#39#1052#1099', '#1085#1080#1078#1077#1087#1086#1076#1087#1080#1089#1072#1074#1096#1080#1077#1089#1103', ________________ '#39'||' +
        'FIRM_NAME_OUT_||'#39' '#39'||G_OFFICIAL_NAME_||'#39', '#1089' '#1086#1076#1085#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '110153327=          '#39#1080' ________________ '#39'||CLIENT_NAME_OUT_||'#39' '#39 +
        '||CLIENT_DIR_NAME_IN_||'#39', '#1089' '#1076#1088#1091#1075#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '110153328=          '#39#1089#1086#1089#1090#1072#1074#1080#1083#1080' '#1085#1072#1089#1090#1086#1103#1097#1080#1081' '#1072#1082#1090' '#1089#1074#1077#1088#1082#1080' '#1074' '#1090#1086#1084', '#1095#1090#1086' '#1089 +
        #1086#1089#1090#1086#1103#1085#1080#1077' '#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1087#1086' '#1076#1072#1085#1085#1099#1084' '#1091#1095#1077#1090#1072' '#1089#1083#1077#1076#1091#1102#1097#1077#1077':'#39';'
      '110153329='
      
        '110153330=  STR3_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_||'#39','#39'||CURR_STR_' +
        ';'
      '110153331=  STR3_DOWN_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_;'
      
        '110153332=  STR4_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||CLIENT_NAME_OUT_||'#39','#39'||CURR_ST' +
        'R_;'
      '110153333='
      
        '110153334=  STR_SALDO_IN_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1085#1072#1095#1072#1083#1086' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110153335=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_BEGIN_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DAT' +
        'E_BEGIN_)||'#39' '#1075'.'#39';'
      '110153336='
      
        '110153337=  STR_SALDO_OUT_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1082#1086#1085#1077#1094' '#39'||lpad(EXTRACT(DA' +
        'Y FROM DATE_END_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '110153338=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(E' +
        'XTRACT(MONTH FROM :DATE_END_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DATE_' +
        'END_)||'#39' '#1075'.'#39';'
      '110153339='
      '110153340=  STR_OT1_ = '#39#1054#1090' '#39'||FIRM_NAME_OUT_;'
      '110153341=  STR_OT2_ = '#39#1054#1090' '#39'||CLIENT_NAME_OUT_;'
      '110153342='
      '110153343=  SELECT IS_SUPPLIER'
      '110153344=    FROM G_CLIENT G'
      '110153345=   WHERE G.G_CLIENT = :G_CLIENT_'
      '110153346=    INTO :IS_SUPPLIER_;'
      '110153347='
      '110153348=  DEBET_IN_   = 0;'
      '110153349=  DEBET_OUT_  = 0;'
      '110153350=  CREDIT_IN_  = 0;'
      '110153351=  CREDIT_OUT_ = 0;'
      '110153352='
      
        '110153353=  STR5_ = '#39#1085#1072' '#39'||LPAD(EXTRACT(DAY FROM CURRENT_DATE), ' +
        '2, '#39'0'#39')||'#39'.'#39'||LPAD(EXTRACT(MONTH FROM CURRENT_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110153354='
      
        '110153355=  --**************************************************' +
        '*****************'
      '110153356=  -- '#1055#1054#1057#1058#1040#1042#1065#1048#1050
      
        '110153357=  --**************************************************' +
        '*****************'
      '110153358=  IF (IS_SUPPLIER_ = 1) THEN BEGIN'
      '110153359=    ----------------------'
      '110153360=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110153361=    SELECT SUM(S.SUMM)'
      '110153362=      FROM SKLAD_PARENT S'
      '110153363=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153364=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110153365=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153366=    GROUP BY S.G_CLIENT'
      '110153367=      INTO :SUMM_IN_DEBET_;'
      '110153368='
      '110153369=    SELECT SUM(K.SUMM)'
      '110153370=      FROM SKLAD_PARENT S,'
      
        '110153371=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153372=             from KASSA'
      
        '110153373=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153374=              AND ZAKAZ IS NULL'
      '110153375=           union all'
      
        '110153376=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153377=             from kassa_beznal'
      
        '110153378=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153379=              AND ZAKAZ IS NULL) K'
      '110153380=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153381=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153382=       AND K.SKLAD = S.SKLAD'
      '110153383=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110153384=       AND K.G_PRIHOD_RASHOD = 2'
      '110153385=    GROUP BY S.G_CLIENT'
      '110153386=      INTO :SUMM_IN_CREDIT_;'
      '110153387='
      
        '110153388=    SELECT :SUMM_IN_DEBET_ + SUM(S.SUMM)              ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110153389=      FROM ZAKAZ S'
      '110153390=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153391=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110153392=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153393=    GROUP BY S.G_CLIENT'
      '110153394=      INTO :SUMM_IN_DEBET_;'
      '110153395='
      
        '110153396=    SELECT :SUMM_IN_CREDIT_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110153397=      FROM ZAKAZ S,'
      '110153398=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110153399=             from KASSA'
      
        '110153400=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153401=              AND SKLAD IS NULL'
      '110153402=           union all'
      '110153403=           select ZAKAZ, SUMM, ACTION_DATE'
      '110153404=             from kassa_beznal'
      
        '110153405=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153406=              AND SKLAD IS NULL) K'
      '110153407=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153408=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153409=       AND K.zakaz = S.ZAKAZ'
      '110153410=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110153411=    GROUP BY S.G_CLIENT'
      '110153412=      INTO :SUMM_IN_CREDIT_;'
      '110153413='
      '110153414=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110153415='
      '110153416=    ----------------------'
      '110153417=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110153418=    SELECT SUM(S.SUMM)'
      '110153419=      FROM SKLAD_PARENT S'
      '110153420=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153421=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110153422=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153423=    GROUP BY S.G_CLIENT'
      '110153424=      INTO :SUMM_OUT_DEBET_;'
      '110153425='
      '110153426=    SELECT SUM(K.SUMM)'
      '110153427=      FROM SKLAD_PARENT S,'
      
        '110153428=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153429=             from KASSA'
      
        '110153430=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153431=              AND ZAKAZ IS NULL'
      '110153432=           union all'
      
        '110153433=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153434=             from kassa_beznal'
      
        '110153435=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153436=              AND ZAKAZ IS NULL) K'
      '110153437=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153438=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153439=       AND K.SKLAD = S.SKLAD'
      '110153440=       AND K.ACTION_DATE <= :DATE_END_'
      '110153441=       AND K.G_PRIHOD_RASHOD = 2'
      '110153442=    GROUP BY S.G_CLIENT'
      '110153443=      INTO :SUMM_OUT_CREDIT_;'
      '110153444='
      
        '110153445=    SELECT :SUMM_OUT_CREDIT_ +SUM(S.SUMM)             ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110153446=      FROM ZAKAZ S'
      '110153447=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153448=       AND S.Z_DATE <= :DATE_END_'
      
        '110153449=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153450=    GROUP BY S.G_CLIENT'
      '110153451=      INTO :SUMM_OUT_CREDIT_;'
      '110153452='
      
        '110153453=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110153454=      FROM ZAKAZ S,'
      '110153455=          (select ZAKAZ, SUMM, ACTION_DATE'
      '110153456=             from KASSA'
      
        '110153457=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153458=              AND SKLAD IS NULL'
      '110153459=           union all'
      '110153460=           select ZAKAZ, SUMM, ACTION_DATE'
      '110153461=             from kassa_beznal'
      
        '110153462=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153463=              AND SKLAD IS NULL) K'
      '110153464=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153465=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153466=       AND K.zakaz = S.ZAKAZ'
      '110153467=       AND K.ACTION_DATE <= :DATE_END_'
      '110153468=    GROUP BY S.G_CLIENT'
      '110153469=      INTO :SUMM_OUT_DEBET_;'
      '110153470='
      '110153471=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110153472=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110153473=    -------------------------'
      '110153474='
      '110153475=    if (COALESCE(SUMM_IN_, 0) < 0) then'
      '110153476=      DEBET_IN_ = SUMM_IN_;'
      '110153477=    ELSE'
      '110153478=      CREDIT_IN_ = SUMM_IN_;'
      '110153479='
      '110153480=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110153481=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110153482='
      '110153483=    if (COALESCE(SUMM_OUT_, 0) < 0) then'
      '110153484=      DEBET_OUT_ = ABS(SUMM_OUT_);'
      '110153485=    ELSE'
      '110153486=      CREDIT_OUT_ = SUMM_OUT_;'
      '110153487='
      '110153488=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110153489=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110153490='
      '110153491=        if (DEBET_OUT_ > 0) then'
      
        '110153492=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110153493=        else'
      
        '110153494=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110153495=    end else'
      '110153496=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110153497='
      '110153498=    FOR SELECT 1 ROW,'
      
        '110153499=               '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1058#1052#1047' '#39'||S.SKLAD||'#39' '#1086#1090' '#39'||S.' +
        'DATE_RECEIPT str,'
      '110153500=               S.SKLAD ID,'
      '110153501=               S.DATE_RECEIPT OPER_DATE,'
      '110153502=               NULL SUMM_DEBET,'
      '110153503=               S.SUMM SUMM_CREDIT,'
      '110153504=               S.DATE_RECEIPT SORT_ROW'
      '110153505=          FROM SKLAD_PARENT S'
      '110153506=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153507=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110153508=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110153509=        UNION ALL'
      '110153510=        SELECT 2 ROW,'
      
        '110153511=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' '#1086#1090' '#39'||SP' +
        'P.DATE_RECEIPT STR,'
      '110153512=               K.SKLAD ID,'
      '110153513=               K.ACTION_DATE OPER_DATE,'
      '110153514=               K.SUMM SUMM_DEBET,'
      '110153515=               NULL SUMM_CREDIT,'
      '110153516=               K.ACTION_DATE SORT_ROW'
      
        '110153517=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110153518=                  from KASSA'
      
        '110153519=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110153520=                union all'
      
        '110153521=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110153522=                  from kassa_beznal'
      
        '110153523=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110153524=               SKLAD_PARENT SPP'
      '110153525=         WHERE K.ZAKAZ IS NULL'
      '110153526=           AND K.SKLAD = SPP.SKLAD'
      
        '110153527=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110153528=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110153529=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110153530=           AND K.G_PRIHOD_RASHOD = 2'
      '110153531=        UNION ALL'
      '110153532=        SELECT 3 ROW,'
      
        '110153533=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#39'||Z.ZAKAZ||'#39' '#1086 +
        #1090' '#39'||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT' +
        '(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE)' +
        ' str,'
      '110153534=               Z.ZAKAZ ID,'
      '110153535=               Z.Z_DATE OPER_DATE,'
      '110153536=               Z.SUMM SUMM_DEBET,'
      '110153537=               NULL SUMM_CREDIT,'
      '110153538=               Z.Z_DATE SORT_ROW'
      '110153539=          FROM ZAKAZ Z'
      '110153540=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110153541=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110153542=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110153543=        UNION ALL'
      '110153544=        SELECT 4 ROW,'
      
        '110153545=               '#39#1054#1087#1083#1072#1090#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' '#39 +
        '||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(M' +
        'ONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE)' +
        ' STR,'
      '110153546=               K.ZAKAZ ID,'
      '110153547=               K.ACTION_DATE OPER_DATE,'
      '110153548=               NULL SUMM_DEBET,'
      '110153549=               K.SUMM SUMM_CREDIT,'
      '110153550=               K.ACTION_DATE SORT_ROW'
      
        '110153551=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA'
      '110153552=                  from KASSA'
      
        '110153553=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110153554=                union all'
      
        '110153555=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA'
      '110153556=                  from kassa_beznal'
      
        '110153557=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '110153558=               zakaz zz'
      '110153559=         WHERE K.sklad IS NULL'
      '110153560=           AND K.zakaz = zz.ZAKAZ'
      
        '110153561=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110153562=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110153563=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110153564=        UNION ALL'
      '110153565=        SELECT 5 ROW,'
      '110153566=               NULL STR,'
      '110153567=               NULL ID,'
      '110153568=               NULL OPER_DATE,'
      '110153569=               NULL SUMM_DEBET,'
      '110153570=               NULL SUMM_CREDIT,'
      
        '110153571=               '#39'31.12.2199'#39' SORT_ROW    -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072 +
        #1103' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110153572=          FROM RDB$DATABASE'
      '110153573=        ORDER BY 7, 3, 1'
      '110153574=        INTO :ROW,'
      '110153575=             :STR_TEXT,'
      '110153576=             :ID,'
      '110153577=             :OPER_DATE,'
      '110153578=             :SUMM_DEBET,'
      '110153579=             :SUMM_CREDIT,'
      '110153580=             :SORT_ROW'
      '110153581=    DO BEGIN'
      '110153582=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110153583=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110153584=      SUSPEND;'
      '110153585=    END'
      '110153586=  END'
      '110153587='
      
        '110153588=  --**************************************************' +
        '*************'
      '110153589=  -- '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068
      
        '110153590=  --**************************************************' +
        '*************'
      '110153591=  ELSE BEGIN'
      '110153592=    ----------------------'
      '110153593=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110153594=    SELECT SUM(S.SUMM)'
      '110153595=      FROM ZAKAZ S'
      '110153596=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153597=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '110153598=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153599=       AND S.is_spisanie <> 1'
      '110153600=    GROUP BY S.G_CLIENT'
      '110153601=      INTO :SUMM_IN_DEBET_;'
      '110153602='
      '110153603=    SELECT SUM(K.SUMM)'
      '110153604=      FROM ZAKAZ S,'
      
        '110153605=          (select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153606=             from KASSA'
      
        '110153607=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153608=              AND SKLAD IS NULL'
      '110153609=           union all'
      
        '110153610=           select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153611=             from kassa_beznal'
      
        '110153612=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153613=              AND SKLAD IS NULL'
      '110153614=           union all'
      
        '110153615=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110153616=             from zakaz Z'
      
        '110153617=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153618=              AND Z.summ_bonus > 0) K'
      '110153619=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153620=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153621=       AND K.zakaz = S.ZAKAZ'
      '110153622=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110153623=       AND S.is_spisanie <> 1'
      '110153624=       AND K.G_PRIHOD_RASHOD = 1'
      '110153625=    GROUP BY S.G_CLIENT'
      '110153626=      INTO :SUMM_IN_CREDIT_;'
      '110153627='
      
        '110153628=    SELECT :SUMM_IN_DEBET_ + SUM(K.SUMM)              ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110153629=      FROM SKLAD_PARENT S,'
      
        '110153630=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153631=             from KASSA'
      
        '110153632=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153633=              AND ZAKAZ IS NULL'
      '110153634=           union all'
      
        '110153635=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_R' +
        'ASHOD'
      '110153636=             from kassa_beznal'
      
        '110153637=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153638=              AND ZAKAZ IS NULL) K'
      '110153639=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153640=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153641=       AND K.SKLAD = S.SKLAD'
      '110153642=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '110153643=       AND K.G_PRIHOD_RASHOD = 3'
      '110153644=    GROUP BY S.G_CLIENT'
      '110153645=      INTO :SUMM_IN_DEBET_;'
      '110153646='
      
        '110153647=    SELECT :SUMM_IN_CREDIT_ + SUM(S.SUMM)             ' +
        '-- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110153648=      FROM SKLAD_PARENT S'
      '110153649=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153650=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110153651=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153652=    GROUP BY S.G_CLIENT'
      '110153653=      INTO :SUMM_IN_CREDIT_;'
      '110153654='
      '110153655=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '110153656='
      '110153657=    ----------------------'
      '110153658=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110153659=    SELECT SUM(S.SUMM)'
      '110153660=      FROM ZAKAZ S'
      '110153661=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153662=       AND S.Z_DATE <= :DATE_END_'
      
        '110153663=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153664=       AND S.is_spisanie <> 1'
      '110153665=    GROUP BY S.G_CLIENT'
      '110153666=      INTO :SUMM_OUT_DEBET_;'
      '110153667='
      '110153668=    SELECT SUM(K.SUMM)'
      '110153669=      FROM ZAKAZ S,'
      
        '110153670=          (select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110153671=             from KASSA'
      
        '110153672=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153673=              AND SKLAD IS NULL'
      '110153674=           union all'
      
        '110153675=           select ZAKAZ, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110153676=             from kassa_beznal'
      
        '110153677=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153678=              AND SKLAD IS NULL'
      '110153679=           union all'
      
        '110153680=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_date' +
        ' ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '110153681=             from zakaz Z'
      
        '110153682=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153683=              AND Z.summ_bonus > 0) K'
      '110153684=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153685=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153686=       AND K.zakaz = S.ZAKAZ'
      '110153687=       AND K.ACTION_DATE <= :DATE_END_'
      '110153688=       AND K.G_PRIHOD_RASHOD = 1'
      '110153689=    GROUP BY S.G_CLIENT'
      '110153690=      INTO :SUMM_OUT_CREDIT_;'
      '110153691='
      
        '110153692=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)             ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110153693=      FROM SKLAD_PARENT S,'
      
        '110153694=          (select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110153695=             from KASSA'
      
        '110153696=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153697=              AND ZAKAZ IS NULL'
      '110153698=           union all'
      
        '110153699=           select SKLAD, SUMM, ACTION_DATE, g_prihod_r' +
        'ashod'
      '110153700=             from kassa_beznal'
      
        '110153701=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TOC' +
        'HKA||'#39'-'#39
      '110153702=              AND ZAKAZ IS NULL) K'
      '110153703=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153704=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153705=       AND K.SKLAD = S.SKLAD'
      '110153706=       AND K.ACTION_DATE <= :DATE_END_'
      '110153707=       AND K.G_PRIHOD_RASHOD = 3'
      '110153708=    GROUP BY S.G_CLIENT'
      '110153709=      INTO :SUMM_OUT_DEBET_;'
      '110153710='
      
        '110153711=    SELECT :SUMM_OUT_CREDIT_ + SUM(S.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '110153712=      FROM SKLAD_PARENT S'
      '110153713=     WHERE S.G_CLIENT = :G_CLIENT_'
      '110153714=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '110153715=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||' +
        #39'-'#39
      '110153716=    GROUP BY S.G_CLIENT'
      '110153717=      INTO :SUMM_OUT_CREDIT_;'
      '110153718='
      '110153719=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '110153720=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '110153721=    -------------------------'
      '110153722='
      '110153723=    IF (COALESCE(SUMM_IN_, 0) > 0) then'
      '110153724=      DEBET_IN_ = SUMM_IN_;'
      '110153725=    ELSE'
      '110153726=      CREDIT_IN_ = SUMM_IN_;'
      '110153727='
      '110153728=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '110153729=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '110153730='
      '110153731=    if (COALESCE(SUMM_OUT_, 0) > 0) then'
      '110153732=      DEBET_OUT_ = SUMM_OUT_;'
      '110153733=    ELSE'
      '110153734=      CREDIT_OUT_ = ABS(SUMM_OUT_);'
      '110153735='
      '110153736=    --------------------'
      '110153737=    -- '#1047#1040#1044#1054#1051#1046#1045#1053#1053#1054#1057#1058#1068
      '110153738=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '110153739=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '110153740='
      '110153741=        if (DEBET_OUT_ > 0) then'
      
        '110153742=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE(' +
        'CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110153743=        else'
      
        '110153744=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLAC' +
        'E(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '110153745=    end else'
      '110153746=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '110153747='
      '110153748=    FOR SELECT 1 ROW,'
      
        '110153749=               '#39#1055#1088#1086#1076#1072#1078#1072', '#1085#1072#1082#1083#1072#1076#1085#1072#1103' '#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39'|' +
        '|lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MON' +
        'TH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE) str' +
        ','
      '110153750=               Z.ZAKAZ ID,'
      '110153751=               Z.Z_DATE OPER_DATE,'
      '110153752=               Z.SUMM SUMM_DEBET,'
      '110153753=               NULL SUMM_CREDIT,'
      '110153754=               Z.Z_DATE SORT_ROW'
      '110153755=          FROM ZAKAZ Z'
      '110153756=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '110153757=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110153758=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      '110153759=        UNION ALL'
      '110153760=        SELECT 2 ROW,'
      
        '110153761=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1085#1072#1082#1083#1072#1076#1085#1091#1102' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(' +
        'MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE' +
        ') STR,'
      '110153762=               K.ZAKAZ ID,'
      '110153763=               K.ACTION_DATE OPER_DATE,'
      '110153764=               NULL SUMM_DEBET,'
      '110153765=               K.SUMM SUMM_CREDIT,'
      '110153766=               K.ACTION_DATE SORT_ROW'
      
        '110153767=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA, G_PRIHOD_RASHOD'
      '110153768=                  from KASSA'
      
        '110153769=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110153770=                union all'
      
        '110153771=                select ZAKAZ, SUMM, ACTION_DATE, SKLAD' +
        ', KASSA_BEZNAL KASSA, G_PRIHOD_RASHOD'
      '110153772=                  from kassa_beznal'
      
        '110153773=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110153774=                union all'
      
        '110153775=                select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z' +
        '_date ACTION_DATE, NULL SKLAD, NULL KASSA, 1 G_PRIHOD_RASHOD'
      '110153776=                  from zakaz Z'
      
        '110153777=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '110153778=                   AND Z.summ_bonus > 0) K,'
      '110153779=               zakaz zz'
      '110153780=         WHERE K.sklad IS NULL'
      '110153781=           AND K.zakaz = zz.ZAKAZ'
      
        '110153782=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110153783=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '110153784=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOC' +
        'HKA||'#39'-'#39
      '110153785=           AND K.G_PRIHOD_RASHOD = 1'
      '110153786=        UNION ALL'
      '110153787=        SELECT 3 ROW,'
      
        '110153788=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1082#1083#1080#1077#1085#1090#1086#1084' '#39'||S.SKLAD||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXT' +
        'RACT(MONTH FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM' +
        ' S.DATE_RECEIPT) str,'
      '110153789=               S.SKLAD ID,'
      '110153790=               S.DATE_RECEIPT OPER_DATE,'
      '110153791=               NULL SUMM_DEBET,'
      '110153792=               S.SUMM SUMM_CREDIT,'
      '110153793=               S.DATE_RECEIPT SORT_ROW'
      '110153794=          FROM SKLAD_PARENT S'
      '110153795=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '110153796=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110153797=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCH' +
        'KA||'#39'-'#39
      '110153798=        UNION ALL'
      '110153799=        SELECT 4 ROW,'
      
        '110153800=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' ' +
        #1086#1090' '#39'||lpad(EXTRACT(DAY FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpa' +
        'd(EXTRACT(MONTH FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM SPP.DATE_RECEIPT) STR,'
      '110153801=               K.SKLAD ID,'
      '110153802=               K.ACTION_DATE OPER_DATE,'
      '110153803=               K.SUMM SUMM_DEBET,'
      '110153804=               NULL SUMM_CREDIT,'
      '110153805=               K.ACTION_DATE SORT_ROW'
      
        '110153806=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110153807=                  from KASSA'
      
        '110153808=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39
      '110153809=                union all'
      
        '110153810=                select SKLAD, SUMM, ACTION_DATE, ZAKAZ' +
        ', G_PRIHOD_RASHOD'
      '110153811=                  from kassa_beznal'
      
        '110153812=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||' +
        'G_TOCHKA||'#39'-'#39') K,'
      '110153813=               SKLAD_PARENT SPP'
      '110153814=         WHERE K.ZAKAZ IS NULL'
      '110153815=           AND K.SKLAD = SPP.SKLAD'
      
        '110153816=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '110153817=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '110153818=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_TO' +
        'CHKA||'#39'-'#39
      '110153819=           AND K.G_PRIHOD_RASHOD = 3'
      '110153820=        UNION ALL'
      '110153821=        SELECT 5 ROW,'
      '110153822=               NULL STR,'
      '110153823=               NULL ID,'
      '110153824=               NULL OPER_DATE,'
      '110153825=               NULL SUMM_DEBET,'
      '110153826=               NULL SUMM_CREDIT,'
      
        '110153827=               '#39'31.12.2199'#39' SORT_ROW  -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072#1103' ' +
        #1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '110153828=          FROM RDB$DATABASE'
      '110153829=        ORDER BY 7, 3, 1'
      '110153830=        INTO :ROW,'
      '110153831=             :STR_TEXT,'
      '110153832=             :ID,'
      '110153833=             :OPER_DATE,'
      '110153834=             :SUMM_DEBET,'
      '110153835=             :SUMM_CREDIT,'
      '110153836=             :SORT_ROW'
      '110153837=    DO BEGIN'
      '110153838=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '110153839=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '110153840='
      '110153841=      SUSPEND;'
      '110153842=    END'
      '110153843=  END'
      '110153844='
      '110153845=END'
      '110153846=;'
