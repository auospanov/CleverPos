        'YMENT_TYPE_,'
      
        '11096487=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11096488=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11096489=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '11096490=                      EXIT;'
      '11096491=                    END'
      '11096492=                END'
      '11096493=            END'
      
        '11096494=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068 +
        #1048
      
        '11096495=            --=========================================' +
        '========================'
      '11096496='
      
        '11096497=            --=========================================' +
        '========================'
      '11096498=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '11096499=            --=========================================' +
        '========================'
      '11096500=            PNT_ = '#39'12'#39';'
      
        '11096501=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALE' +
        'S_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) T' +
        'HEN BEGIN'
      '11096502=                KASSA_ = NULL;'
      '11096503='
      '11096504=                SELECT S.S_VALUE'
      '11096505=                  FROM SYSTEM_SETUP S'
      '11096506=                 WHERE S.SYSTEM_SETUP = 4'
      '11096507=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '11096508='
      '11096509=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11096510=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11096511=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11096512='
      
        '11096513=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071 +
        #1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '11096514=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) T' +
        'HEN'
      
        '11096515=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7 -' +
        ' DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDA' +
        'Y FROM CURRENT_DATE)));'
      '11096516='
      '11096517=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11096518=                ELSE'
      
        '11096519=                   ACTION_DATE_ZP_ = Current_date - EXT' +
        'RACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date' +
        ' - EXTRACT(DAY FROM current_date) + 32);'
      '11096520='
      '11096521=                SELECT K.KASSA, K.SUMM'
      '11096522=                FROM KASSA K'
      '11096523=                WHERE K.G_PRIHOD_RASHOD = -1'
      '11096524=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '11096525=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '11096526=                 AND K.G_TOCHKA = :G_TOCHKA_'
      '11096527=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '11096528='
      '11096529=                IF (KASSA_ IS NULL) THEN'
      
        '11096530=                    EXECUTE PROCEDURE K_INS_KASSA(1,   ' +
        '  -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11096531=                                                  -1,  ' +
        '   --:G_PRIHOD_RASHOD_,'
      
        '11096532=                                                  :SALE' +
        'S_COMM_SUMM_ALL_,'
      
        '11096533=                                                  :ACTI' +
        'ON_DATE_ZP_,'
      
        '11096534=                                                  :OFFI' +
        'CIAL_NAME_,'
      
        '11096535=                                                  NULL,' +
        '     --:ZAKAZ_,'
      
        '11096536=                                                  NULL,' +
        '     --:SKLAD_,'
      '11096537=                                                  1,'
      
        '11096538=                                                  :G_TO' +
        'CHKA_,'
      
        '11096539=                                                  :G_OF' +
        'FICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11096540=                ELSE BEGIN'
      
        '11096541=                    EXECUTE PROCEDURE K_UPD_KASSA(:KASS' +
        'A_,'
      
        '11096542=                                                  1,   ' +
        '  -- ACTION_'
      
        '11096543=                                                  -1,  ' +
