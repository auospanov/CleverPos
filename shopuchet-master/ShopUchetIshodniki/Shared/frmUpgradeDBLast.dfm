      '1104465='#39';'
      '1104466='
      '1104467=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_CLIENT('
      
        '1104468=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ INTEG' +
        'ER,'
      
        '1104469=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT */ INTEGER,'
      
        '1104470=  G_CONTRAGENT_ /* TYPE OF COLUMN G_CLIENT.G_CONTRAGENT ' +
        '*/ INTEGER,'
      '1104471=  NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHAR(250),'
      
        '1104472=  NAME_FULL_ /* TYPE OF COLUMN G_CLIENT.NAME_FULL */ VAR' +
        'CHAR(250),'
      '1104473=  IDN_ /* TYPE OF COLUMN G_CLIENT.IDN */ VARCHAR(12),'
      '1104474=  KBE_ /* TYPE OF COLUMN G_CLIENT.KBE */ VARCHAR(5),'
      
        '1104475=  SKIDKA_ /* TYPE OF COLUMN G_CLIENT.SKIDKA */ NUMERIC(1' +
        '5,2),'
      
        '1104476=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
