      '1106375=ALTER PROCEDURE FILL_FIRST_DATA('
      '1106376=  PRODUCTY_ INTEGER = 0,'
      '1106377=  HIM_ INTEGER = 0,'
      '1106378=  APTEKA_ INTEGER = 0)'
      '1106379=AS'
      '1106380=BEGIN'
      '1106381=  IF (PRODUCTY_ = 1 OR HIM_ = 1) THEN BEGIN'
      '1106382=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1106383=      VALUES (2, '#39#1073#1091#1090'.'#39', '#39#1073#1091#1090'.'#39');'
      '1106384=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1106385=      VALUES (3, '#39#1082#1075#39', '#39#1082#1075#39');'
      '1106386=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1106387=      VALUES (4, '#39#1096#1080#39', '#39#1096#1080#39');'
      '1106388=  END'
      '1106389='
      '1106390=  IF (APTEKA_ = 1) THEN BEGIN'
      '1106391=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1106392=      VALUES (18, '#39#1091#1087#1072#1082#39', '#39#1091#1087#1072#1082#39');'
      '1106393=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1106394=      VALUES (19, '#39#1092#1083#1072#1082#39', '#39#1092#1083#1072#1082#39');'
      '1106395=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1106396=      VALUES (20, '#39#1087#1086#1076#1075#1091#1079'..'#39', '#39#1087#1086#1076#1075#1091#1079'..'#39');'
      '1106397=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1106398=      VALUES (21, '#39#1064#1058#39', '#39#1064#1058#39');'
      '1106399=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063100=      VALUES (22, '#39#1055#1051#1040#1057#1058'.'#39', '#39#1055#1051#1040#1057#1058'.'#39');'
      '11063101=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063102=      VALUES (23, '#39#1087#1072#1082'.'#39', '#39#1087#1072#1082'.'#39');'
      '11063103=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11063104=      VALUES (24, '#39#1090#1072#1073'.'#39', '#39#1090#1072#1073'.'#39');'
      '11063105=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
