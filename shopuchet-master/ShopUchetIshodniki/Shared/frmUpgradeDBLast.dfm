      '110751817=  END'
      '110751818=END'
      '110751819=;'
      '110751820='
      '110751821=ALTER PROCEDURE SYNC_DOWNLOAD'
      '110751822=RETURNS ('
      '110751823=  ERR_CODE INTEGER,'
      '110751824=  ERR_MSG VARCHAR(1024),'
      '110751825=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '110751826=AS'
      '110751827=/*'
      '110751828='#1060#1048#1053#1040#1051' 07.02.2019'
      '110751829=*/'
      
        '110751830=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_DOWNLOAD' +
        #39';'
      '110751831=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110751832=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '110751833=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
      '110751834=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '110751835=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '110751836=DECLARE VARIABLE POS_ INTEGER;'
      '110751837=DECLARE VARIABLE POS1_ INTEGER;'
      '110751838=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110751839=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      '110751840=BEGIN'
      '110751841=  PNT_ = '#39'00'#39';'
      '110751842=  ERR_MSG = '#39#39';'
      '110751843=  ERR_BODY = '#39#39';'
      '110751844='
      '110751845=  FOR SELECT L.ID,'
      '110751846=             L.SQLSTMT'
      '110751847=        FROM LOGS L'
      '110751848=       WHERE L.USR = '#39'REPLICAT'#39
      '110751849=         AND L.DAT IS NULL'
      '110751850=         AND L.IS_TRANSFERED = 0'
      '110751851=        ORDER BY L.ID'
      '110751852=        INTO :LOGS_ID_,'
      '110751853=             :SQL_'
      '110751854=  DO BEGIN'
      '110751855=    BEGIN'
      '110751856=        SQLCODE_ = 0;'
      '110751857=        EXECUTE STATEMENT SQL_;'
      '110751858=    WHEN ANY DO'
      '110751859=        BEGIN'
      '110751860=            SQLCODE_ = GDSCODE;'
      '110751861=            IF (ERR_BODY = '#39#39') THEN'
      
        '110751862=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085#1080 +
        #1081'.'#39';'
      '110751863=            ERR_BODY = ERR_BODY ||'#39
      '110751864='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110751865=        END'
      '110751866=    END'
      '110751867='
      
        '110751868=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110751869=    UPDATE LOGS L'
      
        '110751870=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110751871=           L.ERR_CODE = :SQLCODE_'
      '110751872=     WHERE L.ID = :LOGS_ID_;'
      '110751873=  END'
      '110751874='
      '110751875=  FOR SELECT L.ID,'
      '110751876=             L.SQLSTMT,'
      '110751877=             L.DAT,'
      '110751878=             L.RR'
      '110751879=        FROM LOGS L'
      '110751880=       WHERE L.USR = '#39'REPLICAT'#39
      '110751881=         AND L.DAT IS NOT NULL'
      '110751882=         AND L.IS_TRANSFERED = 0'
      '110751883=        ORDER BY L.ID'
      '110751884=        INTO :LOGS_ID_,'
      '110751885=             :SQL_,'
      '110751886=             :DAT_,'
      '110751887=             :IDX_'
      '110751888=  DO BEGIN'
      '110751889=    POS_ = POSITION('#39'.'#39', SQL_);'
      '110751890=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '110751891=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR PO' +
        'S_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_ ' +
        '- 1)||'#39' = :DAT_'#39'||'
      
        '110751892=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ + ' +
        '1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '110751893='
      '110751894=    BEGIN'
      '110751895=        SQLCODE_ = 0;'
      '110751896=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '110751897=    WHEN ANY DO'
      '110751898=        BEGIN'
      '110751899=            SQLCODE_ = GDSCODE;'
      '110751900=            ERR_BODY = ERR_BODY ||'#39
      '110751901='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110751902=        END'
      '110751903=    END'
      '110751904='
      
        '110751905=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110751906='
      '110751907=    UPDATE LOGS L'
      
        '110751908=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110751909=           L.ERR_CODE = :SQLCODE_'
      '110751910=     WHERE L.ID = :LOGS_ID_;'
      '110751911=  END'
      '110751912=end'
      '110751913=;'
      '110751914='
      '110751915=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '110751916=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110751917=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110751918=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110751919=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110751920=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110751921=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110751922=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110751923=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110751924=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110751925=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110751926=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110751927=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110751928=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110751929=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110751930=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110751931=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110751932=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110751933=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110751934=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110751935=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110751936=RETURNS ('
      '110751937=  ERR_CODE INTEGER,'
      '110751938=  ERR_MSG VARCHAR(1024))'
      '110751939=AS'
      '110751940=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '110751941='#1055#1056#1048' '#1069#1058#1054#1052':'
      '110751942=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '110751943=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041#1067 +
        #1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '110751944='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040#1058 +
        #1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057#1048 +
        #1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '110751945=*/'
      
        '110751946=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ_' +
        'DETAIL'#39';'
      '110751947=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110751948=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110751949=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '110751950=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110751951=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      
        '110751952=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '110751953=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110751954=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM;'
      
        '110751955=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110751956=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      '110751957=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110751958=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110751959=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110751960=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      
        '110751961=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110751962=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110751963=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110751964=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM; ' +
        '/* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '110751965=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '110751966=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '110751967=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110751968=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110751969=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110751970=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110751971=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110751972=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110751973=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110751974=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044#1051 +
        #1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '110751975=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIENT' +
        '.G_CLIENT;'
      
        '110751976=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110751977=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110751978=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110751979=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110751980=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110751981=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110751982=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PROD' +
        'UCT.SALES_COMM;'
      
        '110751983=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110751984=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.SUMM;'
      
        '110751985=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110751986=BEGIN'
      '110751987='
      '110751988=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110751989=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110751990=      SELECT Z.G_PAYMENT_TYPE,'
      '110751991=             Z.G_TOCHKA,'
      '110751992=             Z.SUMM,'
      '110751993=             Z.SUMM_BONUS,'
      '110751994=             Z.SUMM_BONUS_GOT,'
      '110751995=             z.g_client,'
      '110751996=             Z.G_OFFICIAL,'
      '110751997=             G.DO_NOT_SALES_COMM,'
      '110751998=             G.FM||'#39' '#39'||G.NM'
      
        '110751999=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON Z' +
        '.G_OFFICIAL = G.G_OFFICIAL'
      '110752000=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110752001=        INTO :G_PAYMENT_TYPE_OLD_,'
      '110752002=             :G_TOCHKA_,'
      '110752003=             :SUMM_OLD_,'
      '110752004=             :SUMM_BONUS_OLD_,'
      '110752005=             :SUMM_BONUS_GOT_OLD_,'
      '110752006=             :g_client_old_,'
      '110752007=             :G_OFFICIAL_,'
      '110752008=             :DO_NOT_SALES_COMM_,'
      '110752009=             :OFFICIAL_NAME_;'
      '110752010='
      
        '110752011=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' '#1055 +
        #1056#1054#1044#1040#1042#1062#1059
      
        '110752012=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COM' +
        'M_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '110752013=        SELECT SUM(ZD.SALES_COMM)'
      '110752014=          FROM ZAKAZ_DETAILS ZD'
      '110752015=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110752016=          INTO :SALES_COMM_OLD_;'
      '110752017='
      '110752018=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '110752019=      PNT_ = '#39'02'#39';'
      
        '110752020=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110752021=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110752022=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110752023=        EXIT;'
      '110752024=      END'
      '110752025='
      
        '110752026=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110752027=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110752028=      ELSE'
      '110752029=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110752030='
      '110752031=      PNT_ = '#39'01'#39';'
      '110752032=      UPDATE zakaz'
      '110752033=      SET'
      '110752034=       G_TOCHKA = :G_TOCHKA_,'
      '110752035=       Z_DATE = :Z_DATE_,'
      '110752036=       Z_TIME = :Z_TIME_,'
      '110752037=       G_CLIENT = :G_CLIENT_,'
      '110752038=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110752039=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110752040=       NOTE = COALESCE(:NOTE_, NOTE),'
      '110752041=       SUMM = :SUMM_,'
      '110752042=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '110752043=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ + ' +
        ':SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' ' +
        #1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110752044=       ,BY_RECIPE = :BY_RECIPE_'
      '110752045=       ,IS_RESERVE = :IS_RESERVE_'
      '110752046=       ,SUMM_BONUS = :SUMM_BONUS_'
      '110752047=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '110752048=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '110752049=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '110752050=      WHERE'
      '110752051=        zakaz = :zakaz_;'
      '110752052='
      
        '110752053=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059','
      '110752054=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '110752055=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058' ' +
        #1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052#1040 +
        #1058#1068
      '110752056=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '110752057=          UPDATE G_DISCONT_CARD D'
      '110752058=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '110752059=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '110752060=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '110752061='
      
        '110752062=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059' ' +
        #1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '110752063=          SUMM_OLD_           = 0;'
      '110752064=      END'
      '110752065=      UPDATE G_DISCONT_CARD D'
      
        '110752066=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM_' +
        'BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '110752067=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :SU' +
        'MM_'
      '110752068=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110752069='
      '110752070=      PNT_ = '#39'03'#39';'
      '110752071=      FOR SELECT T.ZAKAZ_DETAILS,'
      '110752072=                 T.G_PRODUCT,'
      '110752073=                 T.AMOUNT,'
      '110752074=                 T.SUMM,'
      '110752075=                 G.SALES_COMM'
      '110752076=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '110752077=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '110752078=      INTO :ZAKAZ_DETAILS_,'
      '110752079=           :G_PRODUCT_,'
      '110752080=           :Z_AMOUNT_,'
      '110752081=           :DETAILS_SUMM_,'
      '110752082=           :SALES_COMM_'
      '110752083=      DO BEGIN'
      
        '110752084=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110752085=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = ' +
        '0) THEN BEGIN'
      
        '110752086=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SALE' +
        'S_COMM_/100;'
      
        '110752087=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110752088=        END'
      '110752089='
      
        '110752090=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110752091=                                   DISCOUNT_TENGE, DIS' +
        'COUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '110752092=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110752093=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS' +
        '_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '110752094=          FROM ZAKAZ_DETAILS_TMP Z'
      '110752095=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '110752096='
      
        '110752097=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050 +
        #1051#1040#1044#1040
      '110752098=        IF (IS_RESERVE_ = 0) THEN'
      '110752099=            UPDATE LT_SKLAD_PRODUCT L'
      '110752100=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '110752101=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110752102=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110752103='
      '110752104=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110752105=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110752106=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110752107=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :Z_AMOUNT_'
      '110752108=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110752109=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110752110=      END'
      '110752111='
      '110752112=      ----------------------------------------'
      
        '110752113=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058#1068 +
        ' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '110752114=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048' ' +
        #1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '110752115=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048 +
        #1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110752116=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '110752117=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047 +
        #1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068 +
        ' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '110752118=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042 +
        #1045#1053#1053#1054')'
      
        '110752119=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110752120=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059 +
        #1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '110752121=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '110752122=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      '110752123=                PNT_ = '#39'04'#39';'
      
        '110752124=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110752125=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110752126=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110752127=                ELSE'
      
        '110752128=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110752129='
      
        '110752130=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110752131=                    RETURNING_VALUES :KASSA_, :PAYMENT' +
        '_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110752132='
      
        '110752133=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110752134='
      '110752135=                PNT_ = '#39'05'#39';'
      
        '110752136=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) ' +
        'THEN'
      
        '110752137=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_'
      
        '110752138=                                                  1,  ' +
        '   -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110752139=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110752140=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110752141=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110752142=                                                  :ZAK' +
        'AZ_,   --ZAKAZ_'
      
        '110752143=                                                  NULL' +
        ','
      
        '110752144=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110752145=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110752146='
      
        '110752147=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057 +
        #1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '110752148=                ELSE BEGIN'
      
        '110752149=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053 +
        #1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '110752150=                    SELECT 1'
      '110752151=                      FROM KASSA K'
      '110752152=                     WHERE K.KASSA = :KASSA_'
      '110752153=                    UNION ALL'
      '110752154=                    SELECT 2'
      '110752155=                      FROM KASSA_BEZNAL KB'
      '110752156=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110752157=                     INTO :PAYMENT_TYPE_OLD_;'
      '110752158='
      '110752159=                    PNT_ = '#39'06'#39';'
      
        '110752160=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_TY' +
        'PE_) THEN'
      
        '110752161=                        EXECUTE PROCEDURE K_UPD_KASSA(' +
        ':KASSA_,'
      
        '110752162=                                                      ' +
        '0,     -- ACTION_'
      
        '110752163=                                                      ' +
        '1,     --:G_PRIHOD_RASHOD_,'
      
        '110752164=                                                      ' +
        ':PAYMENT_SUMM_,'
      
        '110752165=                                                      ' +
        ':PAYMENT_DATE_,'
      
        '110752166=                                                      ' +
        'NULL,   --NOTE_'
      
        '110752167=                                                      ' +
        ':ZAKAZ_,'
      
        '110752168=                                                      ' +
        'NULL,'
      
        '110752169=                                                      ' +
        ':PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '110752170=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055 +
        #1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110752171=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041 +
        #1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110752172=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110752173=                        PNT_ = '#39'07'#39';'
      
        '110752174=                        EXECUTE PROCEDURE K_DEL_KASSA(' +
        ':KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_M' +
        'SG);'
      '110752175=                        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110752176=                          ERR_MSG = PROCNAME||'#39' -> PNT' +
        '_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '110752177=                          EXIT;'
      '110752178=                        END'
      '110752179='
      '110752180=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '110752181=                           EXECUTE PROCEDURE K_INS_KAS' +
        'SA(0,     -- ACTION_ => :ACTION_'
      
        '110752182=                                                      ' +
        '    1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110752183=                                                      ' +
        '    :PAYMENT_SUMM_,'
      
        '110752184=                                                      ' +
        '    :PAYMENT_DATE_,'
      
        '110752185=                                                      ' +
        '    NULL,   --NOTE_ => :NOTE_,'
      
        '110752186=                                                      ' +
        '    :ZAKAZ_,   --ZAKAZ_'
      
        '110752187=                                                      ' +
        '    NULL,'
      
        '110752188=                                                      ' +
        '    :PAYMENT_TYPE_,'
      
        '110752189=                                                      ' +
        '    :G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110752190=                    END'
      '110752191=                END'
      '110752192=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110752193=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110752194=                  EXIT;'
      '110752195=                END'
      '110752196='
      
        '110752197=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39 +
        ';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '110752198=            END'
      '110752199='
      
        '110752200=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048 +
        ' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '110752201=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110752202=                FROM KASSA K'
      '110752203=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110752204=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K' +
        '.KASSA||'#39'~'#39
      '110752205=                UNION'
      '110752206=                SELECT KASSA, 1 PAYMENT_TYPE'
      '110752207=                  FROM KASSA K'
      '110752208=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '110752209=                   AND K.SUMM = 0'
      '110752210=                UNION'
      
        '110752211=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110752212=                FROM KASSA_BEZNAL K'
      '110752213=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110752214=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K' +
        '.KASSA_BEZNAL||'#39'~'#39
      '110752215=                UNION'
      
        '110752216=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110752217=                FROM KASSA_BEZNAL K'
      '110752218=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110752219=                 AND K.SUMM = 0'
      '110752220=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110752221=            DO BEGIN'
      '110752222=                PNT_ = '#39'08'#39';'
      
        '110752223=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_,' +
        ' :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110752224=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110752225=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||P' +
        'NT_||'#39' '#39'||ERR_MSG;'
      '110752226=                    EXIT;'
      '110752227=                END'
      '110752228=            END'
      '110752229='
      
        '110752230=            --========================================' +
        '========================='
      '110752231=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '110752232=            --========================================' +
        '========================='
      
        '110752233=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058 +
        #1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '110752234=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055 +
        #1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '110752235=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054 +
        ' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
