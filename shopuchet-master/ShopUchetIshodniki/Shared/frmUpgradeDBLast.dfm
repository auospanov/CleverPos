      '110221115=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110221116=  DATE_BEGIN_ DATE,'
      '110221117=  DATE_END_ DATE,'
      '110221118=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110221119=RETURNS ('
      '110221120=  PERIOD_ VARCHAR(40),'
      
        '110221121=  P_REP_PRIHOD_TABLE TYPE OF COLUMN P_REP_PRIHOD_TABLE' +
        '.P_REP_PRIHOD_TABLE,'
      
