        'Z_DATE_STR, SUMM)'
      
        '1102401701=  VALUES (41, 1, '#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1089' '#1088'/'#1089#1095#1077#1090#1072' '#1085#1072' '#1089#1091#1084#1084#1091#39', :SU' +
        'MM_RASHOD_ALL_BEZNAL_);'
      '1102401702='
      
        '1102401703=  OUT_SUMM_ = IN_SUMM_ + SUMM_PRIHOD_ALL_ - SUMM_RASH' +
        'OD_ALL_;'
      
        '1102401704=  OUT_SUMM_NONCASH_ = IN_SUMM_NONCASH_ + SUMM_PRIHOD_' +
        'ALL_BEZNAL_ - SUMM_RASHOD_ALL_BEZNAL_;'
      '1102401705='
      '1102401706=  FOR SELECT SORT_COL'
      '1102401707=            ,ROW_COL'
