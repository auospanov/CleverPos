        'KA), 0), '#39'||DEBET_||'#39', '#39'||CREDIT_||'#39', COALESCE((SELECT "OUTPUT" ' +
        'FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
