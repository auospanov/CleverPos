      '110237285='
      '110237286=  IF (g_category_ IS NOT NULL) THEN'
      
        '110237287=    SQL_STR_ = SQL_STR_ ||'#39' AND P.G_PRODUCT_PAR IN (SE' +
        'LECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE '#39#39#39'||G_CATEGORY_||'#39#39#39 +
        ' CONTAINING '#39#39'~'#39#39'||PT.G_PRODUCT||'#39#39'~'#39#39')'#39';'
      '110237288='
      '110237289='
      '110237290=  IF (G_PRODUCT_ IS NOT NULL) THEN'
      
        '110237291=    SQL_STR_ = SQL_STR_ ||'#39' AND '#39#39#39'||G_PRODUCT_||'#39#39#39' C' +
        'ONTAINING '#39#39'~'#39#39'||P.G_PRODUCT||'#39#39'~'#39#39#39';'
      '110237292='
      '110237293=  --ERR_CODE = -20500;'
      '110237294=  --ERR_MSG = SQL_STR_; EXIT;'
      '110237295='
      '110237296=  EXECUTE STATEMENT :SQL_STR_;'
      '110237297=END;'
      '110237298='
      '110237299=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '110237300=  DATE_BEGIN_ DATE,'
      '110237301=  DATE_END_ DATE,'
      '110237302=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110237303=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
