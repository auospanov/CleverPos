        '110223321=  BRAND_ /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(' +
        '150),'
      
        '110223322=  IS_WEIGHT_ /* TYPE OF COLUMN G_PRODUCT.IS_WEIGHT */ ' +
        'SMALLINT,'
      
        '110223323=  VES_GRAMM_ /* TYPE OF COLUMN G_PRODUCT.VES_GRAMM */ ' +
        'NUMERIC(15,2),'
      
        '110223324=  VES_GRAMM_PRICE_ /* TYPE OF COLUMN G_PRODUCT.VES_GRA' +
        'MM_PRICE */ NUMERIC(15,2),'
      
        '110223325=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT = null,'
      
        '110223326=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SU' +
        'B_TYPE 1 SEGMENT SIZE 16384 = null,'
      '110223327=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '110223328=  IS_KASPI_SHOP_ SMALLINT = 0)'
      '110223329=RETURNS ('
      '110223330=  ERR_CODE INTEGER,'
      '110223331=  ERR_MSG VARCHAR(1024))'
      '110223332=AS'
      '110223333=BEGIN'
      '110223334=  SUSPEND;'
      '110223335=END'
      '110223336=;'
      '110223337='
      '110223338=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '110223339=  DATE_BEGIN_ DATE,'
      '110223340=  DATE_END_ DATE,'
      '110223341=  IS_SPISANIE_ INTEGER,'
      '110223342=  SALE_OF_GOODS_ INTEGER)'
      '110223343=RETURNS ('
      '110223344=  ZAKAZ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '110223345=  Z_NUM /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '110223346=  G_TOCHKA /* TYPE OF COLUMN ZAKAZ.G_TOCHKA */ BIGINT,'
      '110223347=  Z_DATE /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '110223348=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '110223349=  G_CLIENT /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT,'
      
        '110223350=  OSNOVANIE /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCH' +
        'AR(150),'
      '110223351=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '110223352=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCH' +
        'AR(250),'
      '110223353=  DETAILS_STR VARCHAR(3000),'
      
        '110223354=  IS_SPISANIE /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ I' +
        'NTEGER,'
      
        '110223355=  IS_PAYED_ALL /* TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL */' +
        ' INTEGER,'
      
        '110223356=  INVOICE_PAY /* TYPE OF COLUMN INVOICE_PAY.INVOICE_PA' +
        'Y */ BIGINT,'
      '110223357=  INVOICE /* TYPE OF COLUMN INVOICE.INVOICE */ BIGINT,'
      '110223358=  WAYBILL /* TYPE OF COLUMN WAYBILL.WAYBILL */ BIGINT,'
      
        '110223359=  SUM_ZAKAZ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15' +
        ',2),'
      
        '110223360=  SUM_FACT /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERI' +
        'C(15,2),'
      
        '110223361=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMER' +
        'IC(15,2),'
      
        '110223362=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */' +
        ' NUMERIC(15,2),'
      
        '110223363=  SUMM_PAY_BONUS /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */' +
        ' NUMERIC(15,2),'
      
        '110223364=  SUMM_BONUS_GOT /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GO' +
        'T */ NUMERIC(15,2),'
      
        '110223365=  BY_RECIPE /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTEG' +
        'ER,'
      
        '110223366=  IS_RESERVE /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ INT' +
        'EGER,'
      
        '110223367=  G_OFFICIAL /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      
        '110223368=  G_OFFICIAL_FIO /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC ' +
        '*/ VARCHAR(150),'
      
        '110223369=  ADDRESS /* TYPE OF COLUMN G_ADDRESS.ADDRESS */ VARCH' +
        'AR(500),'
      
        '110223370=  G_NONCASH_PAY_TYPE /* TYPE OF COLUMN G_NONCASH_PAY_T' +
        'YPE.G_NONCASH_PAY_TYPE */ BIGINT,'
      
        '110223371=  G_NONCASH_PAY_TYPE_NAME /* TYPE OF COLUMN G_NONCASH_' +
        'PAY_TYPE.NAME */ VARCHAR(150))'
      '110223372=AS'
      '110223373=BEGIN'
      '110223374=  SUSPEND;'
      '110223375=END'
      '110223376=;'
      '110223377='
      
        '110223378=/*****************************************************' +
        '*************************/'
      
        '110223379=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110223380=/*****************************************************' +
        '*************************/'
      '110223381=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110223382=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110223383=  MODE_ INTEGER = 0)'
      '110223384=RETURNS ('
      
        '110223385=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110223386=  ARTICUL_ VARCHAR(30),'
      '110223387=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110223388=  BARCODE_ VARCHAR(30),'
      '110223389=  NAME_ VARCHAR(500),'
      '110223390=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110223391=  PRICE_ NUMERIC(15,2),'
      '110223392=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110223393=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110223394=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110223395=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110223396=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110223397=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110223398=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110223399=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110223400=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110223401=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110223402=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110223403=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      
        '110223404=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110223405=  LAST_PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110223406=  IS_MARKED_ TYPE OF COLUMN G_PRODUCT.IS_MARKED,'
      '110223407=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110223408=  IS_WEIGHT_ TYPE OF COLUMN G_PRODUCT.IS_WEIGHT,'
      '110223409=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      
        '110223410=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM_' +
        'PRICE,'
      '110223411=  IS_KASPI_SHOP_ SMALLINT,'
      '110223412=  ERR_CODE INTEGER,'
      '110223413=  ERR_MSG VARCHAR(1024))'
      '110223414=AS'
      '110223415=begin'
      '110223416=    SELECT'
      '110223417=        G_PRODUCT_PAR,'
      '110223418=        ARTICUL,'
      '110223419=        NOMENCLATUR_NUM,'
      '110223420=        BARCODE,'
      '110223421=        NAME,'
      '110223422=        G_UNIT,'
      '110223423=        PRICE,'
      '110223424=        VOLUME_PRICE,'
      '110223425=        PACK_AMOUNT,'
      '110223426=        MF_COUNTRY,'
      '110223427=        NOTE,'
      '110223428=        CROSSCODE,'
      '110223429=        IS_KIT,'
      '110223430=        MIN_AMOUNT,'
      '110223431=        PLACE,'
      '110223432=        SALES_COMM,'
      '110223433=        KOD_TNVD,'
      '110223434=        FAST_TOVAR,'
      '110223435=        DO_NOT_SHOW_RMK,'
      '110223436=        DO_NOT_CHARGE_BONUS,'
      '110223437=        IS_MARKED,'
      '110223438=        BRAND,'
      
        '110223439=        (SELECT * FROM GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', NULL, 1)),'
      '110223440=        IS_WEIGHT,'
      '110223441=        VES_GRAMM,'
      '110223442=        VES_GRAMM_PRICE,'
      '110223443=        IS_KASPI_SHOP'
      '110223444=    FROM G_PRODUCT T'
      '110223445=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110223446=    INTO'
      '110223447=        :G_PRODUCT_PAR_,'
      '110223448=        :ARTICUL_,'
      '110223449=        :NOMENCLATUR_NUM_,'
      '110223450=        :BARCODE_,'
      '110223451=        :NAME_,'
      '110223452=        :G_UNIT_,'
      '110223453=        :PRICE_,'
      '110223454=        :VOLUME_PRICE_,'
      '110223455=        :PACK_AMOUNT_,'
      '110223456=        :MF_COUNTRY_,'
      '110223457=        :NOTE_,'
      '110223458=        :CROSSCODE_,'
      '110223459=        :IS_KIT_,'
      '110223460=        :MIN_AMOUNT_,'
      '110223461=        :PLACE_,'
      '110223462=        :SALES_COMM_,'
      '110223463=        :KOD_TNVD_,'
      '110223464=        :FAST_TOVAR_,'
      '110223465=        :DO_NOT_SHOW_RMK_,'
      '110223466=        :DO_NOT_CHARGE_BONUS_,'
      '110223467=        :IS_MARKED_,'
      '110223468=        :BRAND_,'
      '110223469=        :LAST_PRICE_,'
      '110223470=        :IS_WEIGHT_,'
      '110223471=        :VES_GRAMM_,'
      '110223472=        :VES_GRAMM_PRICE_,'
      '110223473=        :IS_KASPI_SHOP_;'
      '110223474='
      '110223475=    INSERT INTO LT_BARCODE_TMP'
      
        '110223476=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110223477='
      '110223478=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110223479=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110223480='
      
        '110223481=    INSERT INTO G_PRODUCT_KIT_TMP (G_PRODUCT_KIT, G_PR' +
        'ODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3)'
      
        '110223482=    SELECT DECODE(:MODE_, 0, G_PRODUCT_KIT, GEN_ID(GEN' +
        '_G_PRODUCT_KIT, 1)), G_PRODUCT, G_PRODUCT_ITEM, AMOUNT, PRICE, P' +
        'RICE1, PRICE2, PRICE3'
      '110223483=    FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PRODUCT_;'
      '110223484=end'
      '110223485=;'
      '110223486='
      '110223487=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '110223488=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110223489=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110223490=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110223491=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110223492=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110223493=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110223494=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110223495=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110223496=  SELF_PRICE_ NUMERIC(15,2),'
      '110223497=  AMOUNT_ MY_NUMERIC_5,'
      '110223498=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110223499=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110223500=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110223501=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110223502=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '110223503=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110223504=  CATEGORY_NAME_ VARCHAR(1000),'
      '110223505=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110223506=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110223507=  IS_THIS_LAST_ INTEGER,'
      '110223508=  UPDATE_IF_EXIST_ INTEGER,'
      '110223509=  DO_SEARCH_CATEGORY_ INTEGER,'
      '110223510=  BARCODE_IS_MAIN_ INTEGER,'
      '110223511=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110223512=RETURNS ('
      '110223513=  ERR_CODE INTEGER,'
      '110223514=  ERR_MSG VARCHAR(1024))'
      '110223515=AS'
      
        '110223516=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PR' +
        'ODUCT'#39';'
      '110223517=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110223518=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110223519=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR = NULL;'
      
        '110223520=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110223521=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110223522=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110223523=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110223524=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110223525=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110223526=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM_CURRENCY;'
      '110223527=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110223528=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110223529=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110223530=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110223531=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110223532=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110223533=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '110223534=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110223535=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '110223536=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110223537=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110223538=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110223539=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110223540=BEGIN'
      '110223541=    ERR_MSG = '#39#39';'
      '110223542=    PNT_ = '#39'00'#39';'
      '110223543='
      
        '110223544=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045 +
        #1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '110223545=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS8898' +
        '8~98888~"'
      
        '110223546=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053 +
        #1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '110223547=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '110223548=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~' +
        #39');'
      '110223549=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '110223550=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '110223551=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '110223552=    END ELSE'
      '110223553=        CROSSCODE_ = NULL;'
      '110223554='
      
        '110223555=    --------------------------------------------------' +
        '----------------'
      
        '110223556=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058#1040#1050#1054 +
        #1049' '#1053#1045#1058
      
        '110223557=    -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~'#1052#1103#1075 +
        #1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '110223558=    -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '110223559=    -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053#1054' '#1058 +
        #1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      '110223560=    IF (DO_SEARCH_CATEGORY_ = 1) THEN BEGIN'
      
        '110223561=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEG' +
        'IN'
      '110223562=            G_PRODUCT_PAR_ = NULL;'
      
        '110223563=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME' +
        '_);'
      '110223564=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110223565=              STR_ = CATEGORY_NAME_;'
      '110223566=              CATEGORY_NAME_ = '#39#39';'
      '110223567=            END ELSE'
      
        '110223568=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '110223569='
      '110223570=            SELECT G_PRODUCT'
      '110223571=              FROM G_PRODUCT G'
      '110223572=             WHERE G.NAME = :STR_'
      '110223573=               AND G.IS_CATEGORY = 1'
      
        '110223574=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_' +
        'PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '110223575=                   OR'
      
        '110223576=                   (G.G_PRODUCT_PAR IS NULL AND :G_PRO' +
        'DUCT_PAR_PREV_ IS NULL))'
      '110223577=              INTO G_PRODUCT_PAR_;'
      '110223578=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110223579=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110223580=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110223581=                RETURNING G_PRODUCT'
      '110223582=                INTO :G_PRODUCT_PAR_;'
      '110223583='
      '110223584=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110223585=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110223586=        END'
      '110223587=    END'
      
        '110223588=    --------------------------------------------------' +
        '----------------'
      '110223589='
      '110223590=    PNT_ = '#39'01'#39';'
      '110223591=    SELECT ID'
      '110223592=      FROM CUR_PARAMS'
      '110223593=    WHERE CUR_PARAMS = 2'
      '110223594=      INTO :G_TOCHKA_;'
      '110223595='
      '110223596=    IF (CHAR_LENGTH(TRIM(:NAME_G_UNIT_)) > 0) THEN'
      '110223597=        SELECT G.G_UNIT'
      '110223598=          FROM G_UNIT G'
      
        '110223599=        WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:' +
        'NAME_G_UNIT_))'
      '110223600=          INTO :G_UNIT_;'
      
        '110223601=    if (ROW_COUNT = 0 OR CHAR_LENGTH(TRIM(:NAME_G_UNIT' +
        '_)) = 0 ) then'
      '110223602=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110223603='
      '110223604=    PNT_ = '#39'02'#39';'
      
