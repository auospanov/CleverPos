        '110404239=                                          RETURNING_VA' +
        'LUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110404240=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110404241=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077 +
        ' (02). '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3' +
