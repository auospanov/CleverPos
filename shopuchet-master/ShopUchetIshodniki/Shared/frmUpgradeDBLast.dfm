        '1108889=/****            Altering stored procedures (with empty ' +
        'bodies)            ****/'
      
        '1108890=/*******************************************************' +
        '***********************/'
      '1108891='
      '1108892=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '1108893=  ARTICUL_ /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '1108894=  NOMENCLATUR_NUM_ /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '1108895=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '1108896=  NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '1108897=  NAME_G_UNIT_ /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(' +
        '50),'
      
        '1108898=  PRICE_ /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      
        '1108899=  VOLUME_PRICE_ /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ' */ NUMERIC(15,2),'
      
        '11088100=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      '11088101=  SELF_PRICE_ NUMERIC(15,2),'
      '11088102=  AMOUNT_ /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      
        '11088103=  PACK_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT ' +
        '*/ NUMERIC(15,2),'
      
        '11088104=  MF_COUNTRY_ /* TYPE OF COLUMN G_PRODUCT.MF_COUNTRY */' +
        ' VARCHAR(150),'
      
        '11088105=  NOTE_ /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300' +
        '),'
      
        '11088106=  PLACE_ /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(2' +
        '50),'
      '11088107=  SELF_PRICE_UE_ NUMERIC(15,2),'
      
        '11088108=  KOD_TNVD_ /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VAR' +
        'CHAR(50),'
      '11088109=  CATEGORY_NAME_ VARCHAR(1000),'
      
        '11088110=  CROSSCODE_ /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ B' +
        'LOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      '11088111=  IS_THIS_LAST_ INTEGER,'
      '11088112=  UPDATE_IF_EXIST_ INTEGER)'
      '11088113=RETURNS ('
      '11088114=  ERR_CODE INTEGER,'
      '11088115=  ERR_MSG VARCHAR(1024))'
      '11088116=AS'
      '11088117=BEGIN'
      '11088118=  SUSPEND;'
      '11088119=END'
      '11088120=;'
      '11088121='
      '11088122=ALTER PROCEDURE P_REP_PRICE_LIST('
      '11088123=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11088124=  INCLUDE_NOL_ INTEGER,'
      '11088125=  INCLUDE_FEW_ INTEGER,'
      '11088126=  SORT_BY_NAME_ INTEGER,'
      
        '11088127=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGI' +
        'NT,'
      '11088128=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '11088129=RETURNS ('
      '11088130=  PERIOD_ VARCHAR(40),'
      '11088131=  ROW_NUM VARCHAR(15),'
      '11088132=  ARTICUL VARCHAR(1000),'
      '11088133=  BARCODE VARCHAR(30),'
      
        '11088134=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11088135=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '11088136=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      
        '11088137=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      
        '11088138=  VOLUME_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ' */ NUMERIC(15,2),'
      
        '11088139=  SKIDKA_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ' */ NUMERIC(15,2),'
      
        '11088140=  AMOUNT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT */ N' +
        'UMERIC(18,5),'
      
        '11088141=  AMOUNT_RESERVE /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT_RESERVE */ NUMERIC(18,5),'
      '11088142=  SUMM /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2),'
      
        '11088143=  PRICE_SELF /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(1' +
        '5,2),'
      
        '11088144=  SUMM_SELF /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,' +
        '2),'
      '11088145=  TOVAR_NAME VARCHAR(250),'
      
        '11088146=  CROSSCODE /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ BL' +
        'OB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '11088147=  NOTE /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300)' +
        ','
      
        '11088148=  IS_CATEGORY /* TYPE OF COLUMN G_PRODUCT.IS_CATEGORY *' +
        '/ INTEGER,'
      
        '11088149=  PLACE /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(25' +
        '0),'
      '11088150=  ERR_CODE INTEGER,'
      '11088151=  ERR_MSG VARCHAR(1024))'
      '11088152=AS'
      '11088153=BEGIN'
      '11088154=  SUSPEND;'
      '11088155=END'
      '11088156=;'
      '11088157='
      '11088158='
      
        '11088159=/******************************************************' +
        '************************/'
      
        '11088160=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11088161=/******************************************************' +
        '************************/'
      '11088162=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '11088163=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11088164=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '11088165=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11088166=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11088167=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '11088168=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11088169=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11088170=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11088171=  SELF_PRICE_ NUMERIC(15,2),'
      '11088172=  AMOUNT_ MY_NUMERIC_5,'
      '11088173=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11088174=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11088175=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11088176=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11088177=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11088178=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11088179=  CATEGORY_NAME_ VARCHAR(1000),'
      '11088180=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11088181=  IS_THIS_LAST_ INTEGER,'
      '11088182=  UPDATE_IF_EXIST_ INTEGER)'
      '11088183=RETURNS ('
      '11088184=  ERR_CODE INTEGER,'
      '11088185=  ERR_MSG VARCHAR(1024))'
      '11088186=AS'
      
        '11088187=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11088188=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11088189=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11088190=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR;'
      
        '11088191=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11088192=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11088193=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11088194=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11088195=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11088196=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11088197=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11088198=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11088199=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11088200=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11088201=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11088202=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11088203=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11088204=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11088205=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11088206=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11088207=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11088208=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11088209=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11088210=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11088211=BEGIN'
      '11088212=    ERR_MSG = '#39#39';'
      '11088213='
      
        '11088214=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11088215=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11088216=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11088217=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11088218=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11088219=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11088220=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11088221=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11088222=    END ELSE'
      '11088223=        CROSSCODE_ = NULL;'
      '11088224='
      '11088225=    SELECT ID'
      '11088226=      FROM CUR_PARAMS'
      '11088227=    WHERE CUR_PARAMS = 2'
      '11088228=      INTO :G_TOCHKA_;'
      '11088229='
      '11088230=    SELECT G.G_UNIT'
      '11088231=      FROM G_UNIT G'
      
        '11088232=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11088233=      INTO :G_UNIT_;'
      '11088234=    if (ROW_COUNT = 0) then'
      '11088235=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11088236='
      '11088237=    PNT_ = '#39'02'#39';'
      
        '11088238=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11088239=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11088240=        SELECT G.G_PRODUCT,'
      '11088241=               G.NAME'
      '11088242=          FROM G_PRODUCT G'
      
        '11088243=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11088244=           AND TRIM(G.ARTICUL) <> '#39#39
      '11088245=          INTO :G_PRODUCT_,'
      '11088246=               :G_PRODUCT_NAME_;'
      '11088247='
      
        '11088248=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11088249=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11088250=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11088251=              UPDATE G_PRODUCT G'
      '11088252=                 SET G.NAME = :NAME_,'
      '11088253=                     G.G_UNIT = :G_UNIT_,'
      '11088254=                     G.PRICE  = :PRICE_,'
      '11088255=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11088256=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11088257=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11088258=                     G.PLACE = :PLACE_,'
      
        '11088259=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11088260=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11088261=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11088262=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11088263=                     ,G.CROSSCODE      = :CROSSCODE_'
      '11088264=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11088265='
      
        '11088266=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11088267=            END ELSE'
      
        '11088268=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11088269=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||U' +
        'PPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME_' +
        '||'#39'.'#39';'
      '11088270=        END'
      '11088271=    END ELSE'
      
        '11088272=      EXECUTE PROCEDURE get_free_articul RETURNING_VALU' +
        'ES (:ARTICUL_);'
      '11088273='
      
        '11088274=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052',' +
        ' '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11088275=    PNT_ = '#39'02a'#39';'
      
        '11088276=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11088277=        SELECT G.G_PRODUCT,'
      '11088278=               G.NAME'
      '11088279=          FROM G_PRODUCT G'
      
        '11088280=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_NU' +
        'M_)'
      '11088281=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '11088282=          INTO :G_PRODUCT_,'
      '11088283=               :G_PRODUCT_NAME_;'
      '11088284='
      
        '11088285=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11088286=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11088287=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11088288=              UPDATE G_PRODUCT G'
      '11088289=                 SET G.NAME = :NAME_,'
      '11088290=                     G.G_UNIT = :G_UNIT_,'
      '11088291=                     G.PRICE  = :PRICE_,'
      '11088292=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11088293=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11088294=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11088295=                     G.PLACE = :PLACE_,'
      
        '11088296=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11088297=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11088298=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11088299=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11088300=                     ,G.CROSSCODE      = :CROSSCODE_'
      '11088301=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11088302='
      
        '11088303=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077 +
        #1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11088304=            END ELSE'
      
        '11088305=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11088306=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39 +
        '||G_PRODUCT_NAME_||'#39'.'#39';'
      '11088307=        END'
      '11088308=    end'
      '11088309='
      
        '11088310=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11088311=    PNT_ = '#39'02b'#39';'
      
        '11088312=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11088313=        SELECT G.G_PRODUCT,'
      '11088314=               G.NAME'
      '11088315=          FROM G_PRODUCT G'
      '11088316=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11088317=           AND TRIM(G.BARCODE) <> '#39#39
      '11088318=          INTO :G_PRODUCT_,'
      '11088319=               :G_PRODUCT_NAME_;'
      '11088320='
      '11088321=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11088322=          SELECT G.G_PRODUCT,'
      '11088323=                 G.NAME'
      '11088324=            FROM G_PRODUCT G, LT_BARCODE L'
      '11088325=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11088326=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11088327=             AND TRIM(L.BARCODE) <> '#39#39
      '11088328=            INTO :G_PRODUCT_,'
      '11088329=                 :G_PRODUCT_NAME_;'
      '11088330='
      
        '11088331=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11088332=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11088333=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11088334=              UPDATE G_PRODUCT G'
      '11088335=                 SET G.NAME = :NAME_,'
      '11088336=                     G.G_UNIT = :G_UNIT_,'
      '11088337=                     G.PRICE  = :PRICE_,'
      '11088338=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11088339=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11088340=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11088341=                     G.PLACE = :PLACE_,'
      
        '11088342=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11088343=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11088344=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11088345=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11088346=                     ,G.CROSSCODE      = :CROSSCODE_'
      '11088347=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11088348='
      
        '11088349=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'|' +
        '|UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11088350=            END ELSE'
      
        '11088351=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11088352=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NA' +
        'ME_||'#39'.'#39';'
      '11088353=        END'
      '11088354=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN'
      
        '11088355=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RETU' +
        'RNING_VALUES (:BARCODE_);'
      '11088356='
      
        '11088357=    --=================================================' +
        '========'
      '11088358=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '11088359=    --=================================================' +
        '========'
      '11088360=    PNT_ = '#39'02b'#39';'
      '11088361=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '11088362='
      
        '11088363=        -----------------------------------------------' +
        '-------------------'
      
        '11088364=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058 +
        #1040#1050#1054#1049' '#1053#1045#1058
      
        '11088365=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~' +
        #1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '11088366=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '11088367=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053 +
        #1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '11088368=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEGI' +
        'N'
      '11088369=            G_PRODUCT_PAR_ = NULL;'
      
        '11088370=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME_' +
        ');'
      '11088371=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '11088372=              STR_ = CATEGORY_NAME_;'
      '11088373=              CATEGORY_NAME_ = '#39#39';'
      '11088374=            END ELSE'
      
        '11088375=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '11088376='
      '11088377=            SELECT G_PRODUCT'
      '11088378=              FROM G_PRODUCT G'
      '11088379=             WHERE G.NAME = :STR_'
      '11088380=               AND G.IS_CATEGORY = 1'
      
        '11088381=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_P' +
        'REV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '11088382=                   OR'
      '11088383=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '11088384=              INTO G_PRODUCT_PAR_;'
      '11088385=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '11088386=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PRO' +
        'DUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '11088387=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PR' +
        'ODUCT_PAR_PREV_, :STR_, 1, 0)'
      '11088388=                RETURNING G_PRODUCT'
      '11088389=                INTO :G_PRODUCT_PAR_;'
      '11088390='
      '11088391=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '11088392=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_NA' +
        'ME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '11088393=        END'
      
        '11088394=        -----------------------------------------------' +
        '-------------------'
      '11088395='
      
        '11088396=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR' +
        ', ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME' +
        '_PRICE,'
      
        '11088397=                               IS_CATEGORY, PACK_AMOUNT' +
        ', MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '11088398=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_P' +
        'RODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME' +
        '_, :G_UNIT_, :PRICE_,'
      
        '11088399=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_C' +
        'OUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '11088400=        RETURNING G_PRODUCT'
      '11088401=        INTO :G_PRODUCT_;'
      '11088402='
      
        '11088403=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11088404=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, 0, :G_TOCHKA_);'
      '11088405=    end'
      '11088406='
      
        '11088407=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045#1051 +
        #1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11088408=    PNT_ = '#39'03'#39';'
      '11088409=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '11088410=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '11088411=                                       :AMOUNT_,'
      '11088412=                                       :SELF_PRICE_,'
      
        '11088413=                                       :AMOUNT_ * :SELF' +
        '_PRICE_,'
      '11088414=                                       0, --nds_,'
      '11088415=                                       0 --nds_summ_,'
      '11088416=                                       ,:SELF_PRICE_UE_'
      
        '11088417=                                       ,:AMOUNT_ * :SEL' +
        'F_PRICE_UE_'
      
        '11088418=                                       ) RETURNING_VALU' +
        'ES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '11088419=        IF (ERR_CODE <> 0) THEN BEGIN'
      '11088420=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '11088421=          EXIT;'
      '11088422=        END'
      '11088423=    END'
      '11088424='
      
        '11088425=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' ' +
        #1047#1040#1055#1048#1057#1068
      '11088426=    PNT_ = '#39'04'#39';'
      '11088427=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '11088428=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061#1054 +
        #1044
      '11088429=        FROM SKLAD_TMP T'
      '11088430=        INTO :CNT_;'
      '11088431='
      '11088432=      if (CNT_ > 0) then BEGIN'
      '11088433=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '11088434=          FROM SKLAD_TMP T'
      '11088435=          INTO :SUMM_, :SUMM_UE_;'
      '11088436='
      '11088437=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '11088438=                                DATE_RECEIPT,'
      '11088439=                                TIME_RECEIPT,'
      '11088440=                                G_CLIENT,'
      '11088441=                                G_PAYMENT_TYPE,'
      '11088442=                                OSNOVANIE,'
      '11088443=                                NOTE,'
      '11088444=                                SUMM,'
      '11088445=                                SUMM_FACT,'
      '11088446=                                SUMM_CURRENCY,'
      '11088447=                                IS_PAYED_ALL,'
      '11088448=                                IS_VOZVRAT,'
      '11088449=                                G_TOCHKA)'
      '11088450=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11088451=                CURRENT_DATE,'
      '11088452=                CURRENT_TIME,'
      '11088453=                :G_CLIENT_,'
      '11088454=                1,'
      '11088455=                NULL,  --:OSNOVANIE_,'
      '11088456=                NULL,  -- :NOTE_,'
      '11088457=                :SUMM_,'
      '11088458=                :SUMM_,'
      '11088459=                :SUMM_UE_,'
      
        '11088460=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040 +
        ' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11088461=                0,'
      '11088462=                :G_TOCHKA_)'
      '11088463=        RETURNING'
      '11088464=          SKLAD'
      '11088465=        INTO'
      '11088466=          :SKLAD_PARENT_;'
      '11088467='
      '11088468=        PNT_ = '#39'05'#39';'
      '11088469=        FOR SELECT SKLAD,'
      '11088470=                   G_PRODUCT,'
      '11088471=                   AMOUNT,'
      '11088472=                   PRICE,'
      '11088473=                   SUMM'
      '11088474=                   ,PRICE_CURRENCY'
      '11088475=                   ,SUMM_CURRENCY'
      '11088476=              FROM SKLAD_TMP'
      '11088477=             ORDER BY 1'
      '11088478=              INTO :SKLAD_TMP_,'
      '11088479=                   :RG_PRODUCT_,'
      '11088480=                   :RAMOUNT_,'
      '11088481=                   :RPRICE_,'
      '11088482=                   :RSUMM_'
      '11088483=                   ,:RPRICE_UE_'
      '11088484=                   ,:RSUMM_UE_'
      '11088485=        DO BEGIN'
      '11088486='
      '11088487=            UPDATE SKLAD SK'
      '11088488=               SET SK.IS_LAST = 0'
      '11088489=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11088490=               AND SK.IS_LAST = 1;'
      '11088491='
      '11088492=            INSERT INTO SKLAD'
      '11088493=            ('
      '11088494=             SKLAD,'
      '11088495=             SKLAD_PARENT,'
      '11088496=             DATE_RECEIPT,'
      '11088497=             G_CLIENT,'
      '11088498=             G_PRODUCT,'
      '11088499=             AMOUNT,'
      '11088500=             PRICE,'
      '11088501=             SUMM,'
      '11088502=             G_PAYMENT_TYPE,'
      '11088503=             OSNOVANIE,'
      '11088504=             NOTE,'
      '11088505=             NDS,'
      '11088506=             NDS_SUMM,'
      '11088507=             IS_LAST,'
      '11088508=             IS_VOZVRAT,'
      '11088509=             G_TOCHKA'
      '11088510=             ,PRICE_CURRENCY'
      '11088511=             ,SUMM_CURRENCY'
      '11088512=            ) VALUES ('
      '11088513=             :SKLAD_TMP_,'
      '11088514=             :SKLAD_PARENT_,'
      '11088515=             CURRENT_DATE,'
      '11088516=             :G_CLIENT_,'
      '11088517=             :RG_PRODUCT_,'
      '11088518=             :RAMOUNT_,'
      '11088519=             :RPRICE_,'
      '11088520=             :RSUMM_,'
      '11088521=             1,       --:G_PAYMENT_TYPE_,'
      '11088522=             NULL,    --:OSNOVANIE_,'
      '11088523=             NULL,    --:NOTE_,'
      '11088524=             0,       --:RNDS_,'
      '11088525=             0,       --:RNDS_SUMM_,'
      '11088526=             1,       --IS_LAST_'
      '11088527=             0,        --:IS_VOZVRAT_'
      '11088528=             :G_TOCHKA_'
      '11088529=             ,:RPRICE_UE_'
      '11088530=             ,:RSUMM_UE_'
      '11088531=            );'
      '11088532='
      
        '11088533=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11088534=            PNT_ = '#39'06'#39';'
      '11088535=            UPDATE LT_SKLAD_PRODUCT L'
      '11088536=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11088537=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11088538=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11088539='
      '11088540=            PNT_ = '#39'06a'#39';'
      '11088541=            IF (ROW_COUNT = 0) THEN'
      
        '11088542=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11088543=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11088544=        END'
      '11088545='
      '11088546=        PNT_ = '#39'07'#39';'
      
        '11088547=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_' +
        ' => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11088548=                                2,    --:G_PRIHOD_RASHO' +
        'D_,'
      '11088549=                                :SUMM_,'
      '11088550=                                CURRENT_DATE,'
      
        '11088551=                                NULL,   --NOTE_ => :NOT' +
        'E_,'
      '11088552=                                NULL,   --ZAKAZ_'
      '11088553=                                :SKLAD_PARENT_,'
      '11088554=                                1,'
      
        '11088555=                                :G_TOCHKA_) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11088556=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11088557=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11088558=          EXIT;'
      '11088559=        END'
      '11088560='
      '11088561=        DELETE FROM SKLAD_TMP;'
      '11088562=      END'
      '11088563=    END'
      '11088564='
      
        '11088565=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054#1069 +
        #1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '11088566=    if (ERR_MSG_ IS NOT NULL) then'
      '11088567=      ERR_MSG = ERR_MSG_;'
      '11088568='
      '11088569=WHEN ANY DO BEGIN'
      '11088570=    Err_code = gdscode;'
      
        '11088571=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' --' +
        '> PNT_ '#39'||PNT_;'
      '11088572=  END'
      '11088573=END'
      '11088574=;'
      '11088575='
      '11088576=ALTER PROCEDURE P_REP_PRICE_LIST('
      '11088577=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11088578=  INCLUDE_NOL_ INTEGER,'
      '11088579=  INCLUDE_FEW_ INTEGER,'
      '11088580=  SORT_BY_NAME_ INTEGER,'
      '11088581=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11088582=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '11088583=RETURNS ('
      '11088584=  PERIOD_ VARCHAR(40),'
      '11088585=  ROW_NUM VARCHAR(15),'
      '11088586=  ARTICUL VARCHAR(1000),'
      '11088587=  BARCODE VARCHAR(30),'
      
        '11088588=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11088589=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11088590=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11088591=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11088592=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11088593=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11088594=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '11088595=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        '_RESERVE,'
      '11088596=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '11088597=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '11088598=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '11088599=  TOVAR_NAME VARCHAR(250),'
      '11088600=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11088601=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11088602=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '11088603=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11088604=  ERR_CODE INTEGER,'
      '11088605=  ERR_MSG VARCHAR(1024))'
      '11088606=AS'
      
        '11088607=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_LI' +
        'ST'#39';'
      '11088608=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11088609=DECLARE VARIABLE I INTEGER = 1;'
      '11088610=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11088611=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11088612=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11088613=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11088614=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11088615=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11088616=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11088617=BEGIN'
      '11088618='
      
        '11088619=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11088620=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11088621='
      '11088622=  SELECT S.S_VALUE'
      '11088623=    FROM SYSTEM_SETUP S'
      '11088624=   WHERE S.SYSTEM_SETUP = 1'
      '11088625=    INTO :FORMULA_;'
      '11088626='
      '11088627=  FOR SELECT GP.PATH,'
      '11088628=             GP.G_PRODUCT'
      '11088629=        FROM P_REP_TREE GP'
      '11088630=       WHERE EXISTS (SELECT 1'
      '11088631=                       FROM G_PRODUCT'
      '11088632=                      WHERE IS_CATEGORY = 0'
      
        '11088633=                        AND G_PRODUCT_PAR = GP.G_PRODUC' +
        'T'
      '11088634=                    )'
      
        '11088635=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11088636=              OR'
      '11088637=              (:G_CATEGORY_ is NULL)'
      '11088638=             )'
      '11088639=       ORDER BY 1, 2'
      '11088640=       INTO :PATH_NAME_,'
      '11088641=            :G_PRODUCT_'
      '11088642=  DO BEGIN'
      
        '11088643=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057 +
        ' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054
      
        '11088644=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068 +
        ' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '11088645=      SELECT COUNT(G.G_PRODUCT)'
      
        '11088646=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL' +
        '.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11088647=                                          WHERE :G_TOCH' +
        'KA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT) ' +
        'L ON G.G_PRODUCT = L.G_PRODUCT'
      '11088648=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11088649=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11088650=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (CO' +
        'ALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11088651=              OR'
      
        '11088652=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_' +
        ', 0) = 1)'
      '11088653=              or'
      
        '11088654=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_' +
        ', 0) = 1))'
      '11088655=             )'
      '11088656=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11088657=         AND ((EXISTS (SELECT 1'
      '11088658=                       FROM SKLAD S'
      '11088659=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '11088660=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '11088661=                        AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11088662=              OR'
      '11088663=              COALESCE(:G_CLIENT_, 0) = 0)'
      '11088664=        INTO :CNT_;'
      '11088665='
      '11088666=      IF (CNT_ > 0) THEN BEGIN'
      
        '11088667=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE' +
        '_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '11088668=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), ' +
        ':PATH_NAME_, 1);'
      '11088669='
      
        '11088670=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE,'
      '11088671=                                              ARTICUL,'
      '11088672=                                              BARCODE,'
      
        '11088673=                                              NOMENCLAT' +
        'UR_NUM,'
      '11088674=                                              NAME,'
      
        '11088675=                                              UNIT_NAME' +
        ','
      '11088676=                                              PRICE,'
      
        '11088677=                                              VOLUME_PR' +
        'ICE,'
      
        '11088678=                                              SKIDKA_PR' +
        'ICE,'
      '11088679=                                              AMOUNT,'
      
        '11088680=                                              AMOUNT_RE' +
        'SERVE,'
      '11088681=                                              SUMM,'
      
        '11088682=                                              PRICE_SEL' +
        'F,'
      '11088683=                                              SORT_COL,'
      
        '11088684=                                              IS_CATEGO' +
        'RY,'
      '11088685=                                              NOTE,'
      
        '11088686=                                              CROSSCODE' +
        ','
      '11088687=                                              PLACE)'
      '11088688=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),'
      '11088689=                 G.ARTICUL,'
      '11088690=                 G.BARCODE,'
      '11088691=                 G.NOMENCLATUR_NUM,'
      '11088692=                 G.NAME,'
      '11088693=                 U.SHORT_NAME,'
      '11088694=                 G.PRICE,'
      '11088695=                 G.VOLUME_PRICE,'
      '11088696=                 G.PRICE - GD.SKIDKA_SUM,'
      '11088697=                 COALESCE(S.AMOUNT, 0),'
      '11088698=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      '11088699=                 COALESCE(S.AMOUNT, 0) * G.PRICE,'
      '11088700=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '11088701=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1053 +
        #1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '11088702=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 '#1047 +
        #1040#1050#1059#1055#1054#1050
      '11088703=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '11088704=                  DECODE(:FORMULA_,'
      '11088705=                         0,'
      
        '11088706=                         (SELECT ROUND(SUM(T.AMOUNT * T' +
        '.PRICE)/SUM(T.AMOUNT), 2)'
      
        '11088707=                            FROM (SELECT S.AMOUNT, S.PR' +
        'ICE'
      
        '11088708=                                    FROM SKLAD_PARENT S' +
        'P,'
      '11088709=                                         SKLAD S'
      
        '11088710=                                   WHERE :G_TOCHKA_ARR_' +
        ' CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '11088711=                                     AND SP.DATE_RECEIP' +
        'T <= CURRENT_DATE'
      
        '11088712=                                     AND SP.SKLAD = S.S' +
        'KLAD_PARENT'
      
        '11088713=                                     AND S.G_PRODUCT = ' +
        'G.G_PRODUCT'
      
        '11088714=                                     AND SP.IS_VOZVRAT ' +
        'IN (0, 3, 4)'
      
        '11088715=                                    ORDER BY S.DATE_REC' +
        'EIPT DESC ROWS 1 TO 5) T),'
      '11088716=                         1,'
      '11088717=                         (SELECT S.PRICE'
      '11088718=                            FROM SKLAD S'
      
        '11088719=                           WHERE S.SKLAD = (SELECT MAX(' +
        'SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST ' +
        '= 1'
      
        '11088720=                                              FROM SKLA' +
        'D SS'
      
        '11088721=                                             WHERE :G_T' +
        'OCHKA_ARR_ CONTAINING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39
      
        '11088722=                                               AND SS.G' +
        '_PRODUCT = G.G_PRODUCT'
      
        '11088723=                                               AND SS.I' +
        'S_LAST = 1)'
      '11088724=                         ))), 0) spr,'
      
        '11088725=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, 1' +
        ', G.NAME),'
      '11088726=                 0'
      '11088727=                 ,G.NOTE'
      
        '11088728=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSSC' +
        'ODE'
      '11088729=                 ,G.PLACE'
      
        '11088730=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G_' +
        'PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '11088731=                                                FROM G_' +
        'DISCOUNT D'
      
        '11088732=                                                WHERE (' +
        '(D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '11088733=                                                       ' +
        ' AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '11088734=                                                       ' +
        ' AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      '11088735=                                                      )'
      
        '11088736=                                                      O' +
        'R'
      
        '11088737=                                                      (' +
        'D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '11088738=                                                 AND ((' +
        ':G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      '11088739=                                                     OR'
      
        '11088740=                                                     (D' +
        '.G_TOCHKA IS NULL))'
      
        '11088741=                                              ) GD ON G' +
        '.G_PRODUCT = GD.G_PRODUCT'
      
        '11088742=                             LEFT OUTER JOIN G_UNIT U O' +
        'N G.G_UNIT = U.G_UNIT'
      
        '11088743=                             LEFT OUTER JOIN (SELECT SU' +
        'M(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.G' +
        '_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11088744=                                              WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODU' +
        'CT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '11088745=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11088746=             AND G.IS_CATEGORY = 0'
      '11088747=             AND G.is_active = 1'
      '11088748=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11088749=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND' +
        ' (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11088750=                  OR'
      
        '11088751=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE_' +
        'NOL_, 0) = 1)'
      '11088752=                  or'
      
        '11088753=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE_' +
        'FEW_, 0) = 1))'
      '11088754=                 )'
      '11088755=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11088756=             AND ((EXISTS (SELECT 1'
      '11088757=                           FROM SKLAD S'
      '11088758=                          WHERE S.G_CLIENT = :G_CLIENT_'
      
        '11088759=                            AND S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11088760=                            AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11088761=                  OR'
      '11088762=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '11088763=           ORDER BY 14;'
      '11088764=      END'
      '11088765=  END'
      '11088766='
      
        '11088767=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_D' +
        'ATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0)' +
        '||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '11088768='
      
        '11088769=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CRO' +
        'SSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKIDK' +
        'A_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_' +
        'SELF, IS_CATEGORY,'
      '11088770=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '11088771=      FROM P_REP_PRICE_LIST_TABLE'
      
        '11088772=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_N' +
        'UM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUM' +
        'E_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_' +
        'SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '11088773=  DO BEGIN'
      '11088774=    I = I + 1;'
      '11088775=    SUSPEND;'
      '11088776=  END'
      '11088777='
      '11088778=     /*'
      '11088779=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '11088780='
      '11088781=     SELECT :I,'
      
        '11088782=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044#1059 +
        ' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '11088783=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '11088784=             U.SHORT_NAME UNIT_NAME,'
      '11088785=             SS.PRICE,'
      '11088786=             SS.VOLUME_PRICE,'
      '11088787=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '11088788=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(S' +
        '.AMOUNT, 0)),'
      '11088789=             SS.IS_CATEGORY'
      '11088790=        FROM (WITH RECURSIVE TREE'
      '11088791=              AS (SELECT T.G_PRODUCT,'
      '11088792=                       T.NAME AS ARTICUL,'
      '11088793=                       CAST(NULL AS VARCHAR(500)) NAME,'
      
        '11088794=                       CAST(NULL AS NUMERIC(15,2)) PRIC' +
        'E,'
      
        '11088795=                       CAST(NULL AS NUMERIC(15,2)) VOLU' +
        'ME_PRICE,'
      '11088796=                       T.IS_CATEGORY,'
      '11088797=                       NULL G_UNIT'
      '11088798=                  FROM G_PRODUCT T'
      '11088799=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '11088800=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.G' +
        '_PRODUCT||'#39'~'#39
      '11088801=                UNION ALL'
      '11088802=                SELECT T.G_PRODUCT,'
      '11088803=                       DECODE(T. T.ARTICUL,'
      '11088804=                       T.NAME,'
      '11088805=                       T.PRICE,'
      '11088806=                       T.VOLUME_PRICE,'
      '11088807=                       T.IS_CATEGORY,'
      '11088808=                       T.G_UNIT'
      
        '11088809=                  FROM G_PRODUCT T INNER JOIN TREE PRIO' +
        'R ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '11088810=                 WHERE T.IS_ACTIVE = 1'
      '11088811=                )'
      '11088812=             SELECT * FROM TREE) SS'
      
        '11088813=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.G' +
        '_PRODUCT = S.G_PRODUCT'
      
        '11088814=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U.' +
        'G_UNIT'
      
        '11088815=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PROD' +
        'UCT = GD.G_PRODUCT'
      '11088816=    INTO :ROW_NUM,'
      '11088817=        :ARTICUL,'
      '11088818=        :NAME,'
      '11088819=        :UNIT_NAME,'
      '11088820=        :PRICE,'
      '11088821=        :VOLUME_PRICE,'
      '11088822=        :SKIDKA_PRICE,'
      '11088823=        :AMOUNT,'
      '11088824=        :IS_CATEGORY'
      '11088825=    DO BEGIN'
      '11088826=      I = I + 1;'
      '11088827=      SUSPEND;'
      '11088828=    END  */'
      '11088829=WHEN ANY DO BEGIN'
      '11088830=    Err_code = -20500;'
      
        '11088831=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11088832=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11088833=  END'
      '11088834=end'
      '11088835=;'
      
        '11088836=UPDATE SYSTEM_SETUP SET S_VALUE = 11088 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11088837=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11088838=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110890=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110891=  TYPE_ INTEGER = 0)'
      '110892=RETURNS ('
      '110893=  SORT_COL INTEGER,'
      
        '110894=  G_PRODUCT /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BIGI' +
        'NT,'
      
        '110895=  G_PRODUCT_PAR /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ' */ BIGINT,'
      '110896=  NAME VARCHAR(500))'
      '110897=AS'
      '110898=BEGIN'
      '110899=  SUSPEND;'
      '1108910=END'
      '1108911=;'
      '1108912='
      '1108913=ALTER PROCEDURE P_REP_WAYBILL('
      '1108914=  WAYBILL_ /* TYPE OF COLUMN WAYBILL.WAYBILL */ BIGINT,'
      '1108915=  CURRENCY_ INTEGER,'
      '1108916=  MODE_ INTEGER)'
      '1108917=RETURNS ('
      '1108918=  NUM_ /* TYPE OF COLUMN WAYBILL.NUM */ VARCHAR(20),'
      '1108919=  DATE_ /* TYPE OF COLUMN WAYBILL.INIT_DATE */ DATE,'
      
        '1108920=  OTPRAVITEL_ /* TYPE OF COLUMN WAYBILL.POSTAVSHIK */ VA' +
        'RCHAR(500),'
      '1108921=  IDN_ /* TYPE OF COLUMN WAYBILL.IDN */ VARCHAR(12),'
      
        '1108922=  GRUZOPOLUCHATEL_ /* TYPE OF COLUMN WAYBILL.GRUZOPOLUCH' +
        'ATEL */ VARCHAR(300),'
      
        '1108923=  OTVETST_ZA_POST_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC ' +
        '*/ VARCHAR(150),'
      
        '1108924=  TRANSP_ORG_ /* TYPE OF COLUMN WAYBILL.TRANSP_ORG */ VA' +
        'RCHAR(250),'
      
        '1108925=  TRANSP_NAKLAD_ /* TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD' +
        ' */ VARCHAR(150),'
      
        '1108926=  G_OFFICIAL_RUKOVOD_ /* TYPE OF COLUMN G_OFFICIAL.FIO_D' +
        'OC */ VARCHAR(150),'
      
        '1108927=  APPOINTMENT_ /* TYPE OF COLUMN G_APPOINTMENT.NAME */ V' +
        'ARCHAR(250),'
      
        '1108928=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */ VA' +
        'RCHAR(150),'
      
        '1108929=  GLAVBUH_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */ VARCH' +
        'AR(150),'
      '1108930=  SUMM_VSEGO_ VARCHAR(50),'
      '1108931=  SUMM_NDS_VSEGO_ VARCHAR(50),'
      '1108932=  COUNT_VSEGO_ VARCHAR(500),'
      '1108933=  STR_VSEGO_ VARCHAR(500),'
      '1108934=  ROW_NUM INTEGER,'
      '1108935=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1108936=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      
        '1108937=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1108938=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '1108939=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.SHORT_NAME */ VARC' +
        'HAR(10),'
      
        '1108940=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUMER' +
        'IC(18,5),'
      
        '1108941=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERIC' +
        '(15,2),'
      
        '1108942=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(1' +
        '5,2),'
      '1108943=  SUMM_NDS VARCHAR(50),'
      
        '1108944=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS.NDS */ NUMERIC(15,' +
        '2),'
      
        '1108945=  SUMM_WO_NDS /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NU' +
        'MERIC(15,2),'
      '1108946=  NDS_HEADER_ VARCHAR(50),'
      
        '1108947=  DOVERENNOST_ /* TYPE OF COLUMN WAYBILL.DOVERENNOST */ ' +
        'VARCHAR(250),'
      
        '1108948=  DOVERENNOST_FIO_ /* TYPE OF COLUMN WAYBILL.DOVERENNOST' +
        '_FIO */ VARCHAR(250),'
      '1108949=  ERR_CODE INTEGER,'
      '1108950=  ERR_MSG VARCHAR(1024))'
      '1108951=AS'
      '1108952=BEGIN'
      '1108953=  SUSPEND;'
      '1108954=END'
      '1108955=;'
      '1108956='
      '1108957='
      
        '1108958=/*******************************************************' +
        '***********************/'
      
        '1108959=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1108960=/*******************************************************' +
        '***********************/'
      '1108961=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '1108962=  TYPE_ INTEGER = 0)'
      '1108963=RETURNS ('
      '1108964=  SORT_COL INTEGER,'
      '1108965=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1108966=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1108967=  NAME VARCHAR(500))'
      '1108968=AS'
      '1108969=DECLARE VARIABLE LVL_  INTEGER;'
      '1108970=BEGIN'
      '1108971='
      '1108972=  IF (TYPE_ = 0) THEN'
      '1108973=      FOR'
      '1108974=        SELECT'
      
        '1108975=            DECODE(T.G_PRODUCT, -1, 0, T.g_product) SORT' +
        '_COL,'
      '1108976=            T.G_PRODUCT,'
      '1108977=            T.G_PRODUCT_PAR,'
      '1108978=            T.NAME,'
      '1108979=            0'
      '1108980=        FROM G_PRODUCT T'
      '1108981=        WHERE T.IS_CATEGORY = 1'
      '1108982=        ORDER BY NAME'
      '1108983=        INTO'
      '1108984=            :SORT_COL,'
      '1108985=            :G_PRODUCT,'
      '1108986=            :G_PRODUCT_PAR,'
      '1108987=            :NAME,'
      '1108988=            :LVL_'
      '1108989=      DO'
      '1108990=        suspend;'
      '1108991='
      
        '1108992=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059#1063#1040 +
        #1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '1108993=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054#1044#1048 +
        #1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '1108994=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1056#1054 +
        #1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '1108995=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048#1046#1045 +
        ' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '1108996=  ELSE'
      '1108997=    FOR WITH RECURSIVE TREE AS ('
      
        '1108998=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1108999=               T.G_PRODUCT,'
      '11089100=               T.G_PRODUCT_PAR,'
      
        '11089101=               DECODE(T.G_PRODUCT, -1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.' +
        'NAME) NAME,'
      '11089102=               1 LVL'
      '11089103=          FROM G_PRODUCT T'
      
        '11089104=         WHERE (T.G_PRODUCT_PAR IS NULL or T.g_product ' +
        '= -1)'
      '11089105=        UNION ALL'
      
        '11089106=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) ' +
        'SORTT,'
      '11089107=               T.G_PRODUCT,'
      '11089108=               T.G_PRODUCT_PAR,'
      '11089109=               T.NAME,'
      '11089110=               GG.LVL + 1 LVL'
      
        '11089111=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_P' +
        'RODUCT = T.G_PRODUCT_PAR'
      '11089112=         WHERE T.IS_CATEGORY = 1'
      '11089113=        )'
      '11089114=        SELECT * FROM TREE ORDER BY 1, 5, 3'
      '11089115=        INTO :SORT_COL,'
      '11089116=            :G_PRODUCT,'
      '11089117=            :G_PRODUCT_PAR,'
      '11089118=            :NAME,'
      '11089119=            :LVL_'
      '11089120=    DO'
      '11089121=        suspend;'
      '11089122='
      '11089123=    /*'
      
        '11089124=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT, ' +
        '-1, T.G_PRODUCT, 0) SORTT,'
      '11089125=                               T.G_PRODUCT,'
      '11089126=                               T.G_PRODUCT_PAR,'
      
        '11089127=                               DECODE(T.G_PRODUCT, -1, ' +
        #39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '11089128=                               T.NAME PATH,       --'#1076#1083#1103 +
        ' '#1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '11089129=                               1 LVL'
      '11089130=                          FROM G_PRODUCT T'
      
        '11089131=                         WHERE (T.G_PRODUCT_PAR IS NULL' +
        ' or T.g_product = -1)'
      '11089132=                        UNION ALL'
      
        '11089133=                        SELECT DECODE(T.G_PRODUCT, -1, ' +
        'T.G_PRODUCT, 0) SORTT,'
      '11089134=                               T.G_PRODUCT,'
      '11089135=                               T.G_PRODUCT_PAR,'
      '11089136=                               GG.LVL||T.NAME NAME,'
      
        '11089137=                               GG.PATH||'#39' - '#39'||T.NAME, ' +
        '    --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '11089138=                               GG.LVL + 1 LVL'
      
        '11089139=                          FROM G_PRODUCT T INNER JOIN T' +
        'REE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '11089140=                         WHERE T.IS_CATEGORY = 1'
      '11089141=                        )'
      '11089142=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '11089143=    */'
      '11089144=END'
      '11089145=;'
      '11089146='
      '11089147=ALTER PROCEDURE P_REP_WAYBILL('
      '11089148=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '11089149=  CURRENCY_ INTEGER,'
      '11089150=  MODE_ INTEGER)'
      '11089151=RETURNS ('
      '11089152=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '11089153=  DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '11089154=  OTPRAVITEL_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '11089155=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '11089156=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCHAT' +
        'EL,'
      '11089157=  OTVETST_ZA_POST_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11089158=  TRANSP_ORG_ TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      '11089159=  TRANSP_NAKLAD_ TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD,'
      
        '11089160=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC' +
        ','
      '11089161=  APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '11089162=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11089163=  GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11089164=  SUMM_VSEGO_ VARCHAR(50),'
      '11089165=  SUMM_NDS_VSEGO_ VARCHAR(50),'
      '11089166=  COUNT_VSEGO_ VARCHAR(500),'
      '11089167=  STR_VSEGO_ VARCHAR(500),'
      '11089168=  ROW_NUM INTEGER,'
      '11089169=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '11089170=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11089171=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11089172=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11089173=  SHORT_NAME TYPE OF COLUMN G_UNIT.SHORT_NAME,'
      '11089174=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11089175=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11089176=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '11089177=  SUMM_NDS VARCHAR(50),'
      '11089178=  NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS,'
      '11089179=  SUMM_WO_NDS TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '11089180=  NDS_HEADER_ VARCHAR(50),'
      '11089181=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
        '11089182=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST_F' +
        'IO,'
      '11089183=  ERR_CODE INTEGER,'
      '11089184=  ERR_MSG VARCHAR(1024))'
      '11089185=AS'
      
        '11089186=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_WAYBILL'#39 +
        ';'
      '11089187=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11089188=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11089189=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVIZI' +
        'T.NOL_VMESTO_BEZ;'
      
        '11089190=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NDS_VALUE;'
      '11089191=DECLARE VARIABLE I INTEGER;'
      
        '11089192=DECLARE VARIABLE DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.Z' +
        'AKAZ_DETAILS;'
      '11089193=BEGIN'
      '11089194='
      '11089195=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11089196=  SELECT W.NUM,'
      '11089197=         W.INIT_DATE,'
      '11089198=         W.POSTAVSHIK,'
      '11089199=         W.IDN,'
      '11089200=         W.GRUZOPOLUCHATEL,'
      
        '11089201=         DECODE(CHAR_LENGTH(G.FIO_DOC), 0, G.FM||'#39' '#39'||G' +
        '.NM||'#39' '#39'||G.FT, G.FIO_DOC) OTVETST_ZA_POST,'
      '11089202=         W.TRANSP_ORG,'
      '11089203=         W.TRANSP_NAKLAD,'
      
        '11089204=         DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FIO, GG.' +
        'FIO_DOC) G_OFFICIAL_RUKOVOD,'
      '11089205=         GG.APPOINT,'
      
        '11089206=         DECODE(CHAR_LENGTH(G2.FIO_DOC), 0, G2.FM||'#39' '#39'|' +
        '|G2.NM||'#39' '#39'||G2.FT, G2.FIO_DOC) G_OFFICIAL,'
      '11089207=         W.ZAKAZ,'
      '11089208=         GF.NOL_VMESTO_BEZ,'
      '11089209=         GF.NDS_VALUE,'
      '11089210=         COALESCE(GO.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '11089211=         W.doverennost,'
      '11089212=         W.doverennost_FIO'
      
        '11089213=    FROM WAYBILL W LEFT OUTER JOIN G_OFFICIAL G ON W.OT' +
        'VETST_ZA_POST = G.G_OFFICIAL'
      
        '11089214=                   LEFT OUTER JOIN (SELECT G1.G_OFFICIA' +
        'L, G1.FIO_DOC, G1.FM||'#39' '#39'||G1.NM||'#39' '#39'||G1.FT FIO, A.NAME APPOINT'
      
        '11089215=                                      FROM G_OFFICIAL G' +
        '1 LEFT OUTER JOIN G_APPOINTMENT A ON G1.G_APPOINTMENT = A.G_APPO' +
        'INTMENT) GG ON W.G_OFFICIAL_RUKOVOD = GG.G_OFFICIAL'
      
        '11089216=                   LEFT OUTER JOIN G_OFFICIAL G2 ON W.G' +
        '_OFFICIAL = G2.G_OFFICIAL'
      
        '11089217=                   LEFT OUTER JOIN G_OFFICIAL GO ON W.G' +
        'LAVBUH = GO.G_OFFICIAL,'
      '11089218='
      '11089219=         G_FIRM_REKVIZIT GF'
      '11089220=   WHERE W.WAYBILL = :WAYBILL_'
      
        '11089221=     AND ((W.g_firm = GF.g_firm_rekvizit AND W.g_firm I' +
        'S NOT NULL) OR (GF.is_default = 1 AND W.g_firm IS NULL))  -- '#1044#1054' ' +
        '02.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '11089222=    INTO :NUM_,'
      '11089223=        :DATE_,'
      '11089224=        :OTPRAVITEL_,'
      '11089225=        :IDN_,'
      '11089226=        :GRUZOPOLUCHATEL_,'
      '11089227=        :OTVETST_ZA_POST_,'
      '11089228=        :TRANSP_ORG_,'
      '11089229=        :TRANSP_NAKLAD_,'
      '11089230=        :G_OFFICIAL_RUKOVOD_,'
      '11089231=        :APPOINTMENT_,'
      '11089232=        :G_OFFICIAL_,'
      '11089233=        :ZAKAZ_,'
      '11089234=        :BEZ_NDS_,'
      '11089235=        :NDS_VALUE_,'
      '11089236=        :GLAVBUH_,'
      '11089237=        :doverennost_,'
      '11089238=        :doverennost_fio_;'
      '11089239='
      '11089240=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '11089241=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072 +
        #1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080 +
        '"'
      
        '11089242=  -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054 +
        ' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048#1058#1040#1045#1058#1057 +
        #1071
      '11089243=  IF (MODE_ <> 3) THEN'
      
        '11089244=      SELECT REPLACE(CAST(MAX(Z.SUMM) AS VARCHAR(10)), ' +
        #39'.'#39', '#39','#39'),'
      '11089245=             DECODE(:NDS_VALUE_,'
      
        '11089246=                     0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '11089247=                               0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '11089248=                               '#39'0,00'#39'),'
      
        '11089249=                     REPLACE(CAST(MAX(Z.SUMM) - CAST(RO' +
        'UND(MAX(Z.SUMM)/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS V' +
        'ARCHAR(10)), '#39'.'#39', '#39','#39')'
      '11089250=                    ),'
      
        '11089251=             (SELECT CURR_STR from CURRENCYSTR(SUM(ZD.A' +
        'MOUNT), -1)),'
      
        '11089252=             (SELECT CURR_STR from CURRENCYSTR(MAX(Z.SU' +
        'MM), :CURRENCY_)),'
      
        '11089253=             DECODE(:NDS_VALUE_, 0, '#39#1057#1091#1084#1084#1072' '#1073#1077#1079' '#1053#1044#1057', '#1074' K' +
        'ZT'#39', '#39#1057#1091#1084#1084#1072' '#1089' '#1053#1044#1057', '#1074' KZT'#39')'
      '11089254=        FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      '11089255=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '11089256=         AND Z.ZAKAZ = ZD.ZAKAZ'
      '11089257=        INTO :SUMM_VSEGO_,'
      '11089258=             :SUMM_NDS_VSEGO_,'
      '11089259=             :COUNT_VSEGO_,'
      '11089260=             :STR_VSEGO_,'
      '11089261=             :NDS_HEADER_;'
      '11089262=  ELSE'
      
        '11089263=      SELECT REPLACE(CAST(MAX(SP.SUMM) AS VARCHAR(10)),' +
        ' '#39'.'#39', '#39','#39'),'
      '11089264=             DECODE(:NDS_VALUE_,'
      
        '11089265=                     0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '11089266=                               0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '11089267=                               '#39'0,00'#39'),'
      
        '11089268=                     REPLACE(CAST(MAX(SP.SUMM) - CAST(R' +
        'OUND(MAX(SP.SUMM)/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      '11089269=                    ),'
      
        '11089270=             (SELECT CURR_STR from CURRENCYSTR(SUM(S.AM' +
        'OUNT), -1)),'
      
        '11089271=             (SELECT CURR_STR from CURRENCYSTR(MAX(SP.S' +
        'UMM), :CURRENCY_)),'
      
        '11089272=             DECODE(:NDS_VALUE_, 0, '#39#1057#1091#1084#1084#1072' '#1073#1077#1079' '#1053#1044#1057', '#1074' K' +
        'ZT'#39', '#39#1057#1091#1084#1084#1072' '#1089' '#1053#1044#1057', '#1074' KZT'#39')'
      '11089273=        FROM SKLAD_PARENT SP, SKLAD S'
      '11089274=       WHERE SP.SKLAD = :ZAKAZ_'
      '11089275=         AND SP.SKLAD = S.SKLAD_PARENT'
      '11089276=        INTO :SUMM_VSEGO_,'
      '11089277=             :SUMM_NDS_VSEGO_,'
      '11089278=             :COUNT_VSEGO_,'
      '11089279=             :STR_VSEGO_,'
      '11089280=             :NDS_HEADER_;'
      '11089281='
      '11089282=  ROW_NUM = 0;'
      '11089283=  FOR'
      '11089284=    SELECT --:I,'
      '11089285=           G.NAME,'
      '11089286=           G.NOMENCLATUR_NUM,'
      '11089287=           G.articul,'
      '11089288=           G.BARCODE,'
      '11089289=           U.SHORT_NAME,'
      '11089290=           ZD.AMOUNT,'
      '11089291=           ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE, 0),'
      '11089292=           ZD.SUMM,'
      '11089293=           DECODE(:NDS_VALUE_,'
      
        '11089294=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053#1045' ' +
        #1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '11089295=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '11089296=                             '#39'0,00'#39'),'
      
        '11089297=                   REPLACE(CAST(ZD.SUMM - CAST(ROUND(ZD' +
        '.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39')'
      '11089298=                   ),'
      '11089299=           :NDS_VALUE_,'
      '11089300=          ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2),'
      '11089301=          ZD.ZAKAZ_DETAILS'
      '11089302=      FROM ZAKAZ Z,'
      '11089303=           ZAKAZ_DETAILS ZD,'
      '11089304=           G_PRODUCT G,'
      '11089305=           G_UNIT U'
      '11089306=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '11089307=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11089308=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11089309=       AND G.G_UNIT = U.G_UNIT'
      '11089310=       AND :MODE_ <> 3'
      '11089311=    UNION ALL'
      '11089312=    SELECT --:I,'
      '11089313=           G.NAME,'
      '11089314=           G.NOMENCLATUR_NUM,'
      '11089315=           G.articul,'
      '11089316=           G.BARCODE,'
      '11089317=           U.SHORT_NAME,'
      '11089318=           S.AMOUNT,'
      '11089319=           S.PRICE,'
      '11089320=           S.SUMM,'
      '11089321=           DECODE(:NDS_VALUE_,'
      
        '11089322=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053#1045' ' +
        #1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '11089323=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '11089324=                             '#39'0,00'#39'),'
      
        '11089325=                   REPLACE(CAST(S.SUMM - CAST(ROUND(S.S' +
        'UMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS VARCHAR(10)),' +
        ' '#39'.'#39', '#39','#39')'
      '11089326=                   ),'
      '11089327=           :NDS_VALUE_,'
      '11089328=          ROUND(S.SUMM/(1 + :NDS_VALUE_/100), 2),'
      '11089329=          S.SKLAD ZAKAZ_DETAILS'
      '11089330=      FROM SKLAD_PARENT SP,'
      '11089331=           SKLAD S,'
      '11089332=           G_PRODUCT G,'
      '11089333=           G_UNIT U'
      '11089334=     WHERE SP.SKLAD = :ZAKAZ_'
      '11089335=       AND SP.SKLAD = S.SKLAD_PARENT'
      '11089336=       AND S.G_PRODUCT = G.G_PRODUCT'
      '11089337=       AND G.G_UNIT = U.G_UNIT'
      '11089338=       AND :MODE_ = 3'
      '11089339=     ORDER BY 1'
      '11089340=    INTO --:ROW_NUM,'
      '11089341=        :NAME,'
      '11089342=        :NOMENCLATUR_NUM,'
      '11089343=        :ARTICUL,'
      '11089344=        :BARCODE,'
      '11089345=        :SHORT_NAME,'
      '11089346=        :AMOUNT,'
      '11089347=        :PRICE,'
      '11089348=        :SUMM,'
      '11089349=        :SUMM_NDS,'
      '11089350=        :NDS,'
      '11089351=        :SUMM_WO_NDS,'
      '11089352=        :DETAILS'
      '11089353=  DO BEGIN'
      '11089354=    ROW_NUM = ROW_NUM + 1;'
      '11089355=    SUSPEND;'
      '11089356=  END'
      '11089357='
      '11089358=WHEN ANY DO BEGIN'
      '11089359=    Err_code = -20500;'
      
        '11089360=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11089361=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11089362=  END'
      '11089363=end'
      '11089364=;'
      
        '11089365=UPDATE SYSTEM_SETUP SET S_VALUE = 11089 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11089366=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11089367=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110900='
      '110901=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110902=  TYPE_ INTEGER = 0,'
      
        '110903=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R */ BIGINT = NULL)'
      '110904=RETURNS ('
      '110905=  SORT_COL INTEGER,'
      
        '110906=  G_PRODUCT /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BIGI' +
        'NT,'
      
        '110907=  G_PRODUCT_PAR /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ' */ BIGINT,'
      '110908=  NAME VARCHAR(500))'
      '110909=AS'
      '1109010=BEGIN'
      '1109011=  SUSPEND;'
      '1109012=END'
      '1109013=;'
      '1109014='
      '1109015='
      
        '1109016=/*******************************************************' +
        '***********************/'
      
        '1109017=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1109018=/*******************************************************' +
        '***********************/'
      '1109019=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '1109020=  TYPE_ INTEGER = 0,'
      
        '1109021=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR ' +
        '= NULL)'
      '1109022=RETURNS ('
      '1109023=  SORT_COL INTEGER,'
      '1109024=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1109025=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1109026=  NAME VARCHAR(500))'
      '1109027=AS'
      '1109028=DECLARE VARIABLE LVL_ INTEGER;'
      '1109029=BEGIN'
      '1109030='
      '1109031=  IF (TYPE_ = 0) THEN'
      '1109032=      FOR'
      '1109033=        SELECT'
      
        '1109034=            DECODE(T.G_PRODUCT, -1, 0, T.g_product) SORT' +
        '_COL,'
      '1109035=            T.G_PRODUCT,'
      '1109036=            T.G_PRODUCT_PAR,'
      '1109037=            T.NAME,'
      '1109038=            0'
      '1109039=        FROM G_PRODUCT T'
      '1109040=        WHERE T.IS_CATEGORY = 1'
      '1109041=        ORDER BY NAME'
      '1109042=        INTO'
      '1109043=            :SORT_COL,'
      '1109044=            :G_PRODUCT,'
      '1109045=            :G_PRODUCT_PAR,'
      '1109046=            :NAME,'
      '1109047=            :LVL_'
      '1109048=      DO'
      '1109049=        suspend;'
      '1109050='
      
        '1109051=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059#1063#1040 +
        #1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '1109052=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054#1044#1048 +
        #1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '1109053=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1056#1054 +
        #1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '1109054=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048#1046#1045 +
        ' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '1109055=  ELSE'
      '1109056=    FOR WITH RECURSIVE TREE AS ('
      
        '1109057=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109058=               T.G_PRODUCT,'
      '1109059=               T.G_PRODUCT_PAR,'
      '1109060=               T.NAME,'
      '1109061=               1 LVL'
      '1109062=          FROM G_PRODUCT T'
      
        '1109063=         WHERE ((T.G_PRODUCT_PAR IS NULL or T.g_product ' +
        '= -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '1109064=               OR'
      '1109065=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_)'
      '1109066=        UNION ALL'
      
        '1109067=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109068=               T.G_PRODUCT,'
      '1109069=               T.G_PRODUCT_PAR,'
      '1109070=               T.NAME,'
      '1109071=               GG.LVL + 1 LVL'
      
        '1109072=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_PR' +
        'ODUCT = T.G_PRODUCT_PAR'
      '1109073=         WHERE T.IS_CATEGORY = 1'
      '1109074=        )'
      '1109075=        SELECT * FROM TREE ORDER BY 1, 5, 3'
      '1109076=        INTO :SORT_COL,'
      '1109077=            :G_PRODUCT,'
      '1109078=            :G_PRODUCT_PAR,'
      '1109079=            :NAME,'
      '1109080=            :LVL_'
      '1109081=    DO'
      '1109082=        suspend;'
      '1109083='
      '1109084=    /*'
      
        '1109085=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT, -' +
        '1, T.G_PRODUCT, 0) SORTT,'
      '1109086=                               T.G_PRODUCT,'
      '1109087=                               T.G_PRODUCT_PAR,'
      
        '1109088=                               DECODE(T.G_PRODUCT, -1, '#39 +
        #1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '1109089=                               T.NAME PATH,       --'#1076#1083#1103' ' +
        #1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '1109090=                               1 LVL'
      '1109091=                          FROM G_PRODUCT T'
      
        '1109092=                         WHERE (T.G_PRODUCT_PAR IS NULL ' +
        'or T.g_product = -1)'
      '1109093=                        UNION ALL'
      
        '1109094=                        SELECT DECODE(T.G_PRODUCT, -1, T' +
        '.G_PRODUCT, 0) SORTT,'
      '1109095=                               T.G_PRODUCT,'
      '1109096=                               T.G_PRODUCT_PAR,'
      '1109097=                               GG.LVL||T.NAME NAME,'
      
        '1109098=                               GG.PATH||'#39' - '#39'||T.NAME,  ' +
        '   --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '1109099=                               GG.LVL + 1 LVL'
      
        '11090100=                          FROM G_PRODUCT T INNER JOIN T' +
        'REE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '11090101=                         WHERE T.IS_CATEGORY = 1'
      '11090102=                        )'
      '11090103=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '11090104=    */'
      '11090105=END'
      '11090106=;'
      
        '11090107=UPDATE SYSTEM_SETUP SET S_VALUE = 11090 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11090108=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11090109=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110910=ALTER PROCEDURE INS_ZAKAZ('
      
        '110911=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGINT' +
        ','
      '110912=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '110913=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '110914=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT,'
      
        '110915=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE ' +
        '*/ BIGINT,'
      
        '110916=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCHAR' +
        '(150),'
      
        '110917=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ INT' +
        'EGER,'
      '110918=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '110919=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '1109110=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERI' +
        'C(15,2),'
      
        '1109111=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMERI' +
        'C(15,2),'
      
        '1109112=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */ ' +
        'NUMERIC(15,2),'
      
        '1109113=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NUME' +
        'RIC(15,2),'
      
        '1109114=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ' */ NUMERIC(15,2),'
      
        '1109115=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD */ BIGINT,'
      
        '1109116=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(1' +
        '5,2),'
      
        '1109117=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTEGE' +
        'R,'
      
        '1109118=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ INTE' +
        'GER,'
      '1109119=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1109120=  IS_MEBEL_ INTEGER = 0,'
      
        '1109121=  DOSTAVSHIK_ /* TYPE OF COLUMN DELIVERY.DOSTAVSHIK */ B' +
        'IGINT = NULL,'
      
        '1109122=  DELIVERY_DATE_ /* TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E */ DATE = NULL,'
      
        '1109123=  ADDRESS_ /* TYPE OF COLUMN DELIVERY.ADDRESS */ VARCHAR' +
        '(250) = NULL,'
      
        '1109124=  PRICE_ /* TYPE OF COLUMN DELIVERY.PRICE */ NUMERIC(15,' +
        '2) = NULL,'
      '1109125=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1109126=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT = NULL)'
      '1109127=RETURNS ('
      '1109128=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1109129=  ERR_CODE INTEGER,'
      '1109130=  ERR_MSG VARCHAR(1024))'
      '1109131=AS'
      '1109132=BEGIN'
      '1109133=  SUSPEND;'
      '1109134=END'
      '1109135=;'
      '1109136='
      '1109137='
      
        '1109138=/*******************************************************' +
        '***********************/'
      
        '1109139=/****                   Creating generators (sequences) ' +
        '                   ****/'
      
        '1109140=/*******************************************************' +
        '***********************/'
      '1109141='
      '1109142=CREATE GENERATOR GEN_G_CLIENT_DISC_VAL_GRID;'
      '1109143='
      '1109144='
      
        '1109145=/*******************************************************' +
        '***********************/'
      
        '1109146=/****              Creating tables (without computed fie' +
        'lds)               ****/'
      
        '1109147=/*******************************************************' +
        '***********************/'
      '1109148=CREATE TABLE G_CLIENT_DISC_VAL_GRID ('
      '1109149=    G_CLIENT_DISC_VAL_GRID INTEGER NOT NULL,'
      '1109150=    SUMM_FROM MY_NUMERIC,'
      '1109151=    SUMM_TO MY_NUMERIC,'
      '1109152=    SKIDKA_VAL MY_NUMERIC,'
      '1109153=    BONUS_VAL MY_NUMERIC);'
      '1109154='
      '1109155='
      
        '1109156=/*******************************************************' +
        '***********************/'
      
        '1109157=/****                   Creating primary key constraints' +
        '                   ****/'
      
        '1109158=/*******************************************************' +
        '***********************/'
      '1109159=RECONNECT;'
      '1109160='
      
        '1109161=ALTER TABLE G_CLIENT_DISC_VAL_GRID ADD CONSTRAINT PK_G_C' +
        'LIENT_DISC_VAL_GRID PRIMARY KEY (G_CLIENT_DISC_VAL_GRID);'
      '1109162='
      '1109163='
      
        '1109164=/*******************************************************' +
        '***********************/'
      
        '1109165=/****            Altering stored procedures (with empty ' +
        'bodies)            ****/'
      
        '1109166=/*******************************************************' +
        '***********************/'
      '1109167='
      '1109168=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '1109169=  TYPE_ INTEGER = 0,'
      
        '1109170=  G_PRODUCT_PAR_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR */ BIGINT = NULL)'
      '1109171=RETURNS ('
      '1109172=  SORT_COL INTEGER,'
      
        '1109173=  G_PRODUCT /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT */ BIG' +
        'INT,'
      
        '1109174=  G_PRODUCT_PAR /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R */ BIGINT,'
      '1109175=  NAME VARCHAR(500))'
      '1109176=AS'
      '1109177=BEGIN'
      '1109178=  SUSPEND;'
      '1109179=END'
      '1109180=;'
      '1109181='
      '1109182='
      
        '1109183=/*******************************************************' +
        '***********************/'
      
        '1109184=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1109185=/*******************************************************' +
        '***********************/'
      '1109186=ALTER PROCEDURE G_GET_G_DISCOUNT_BY_PRODUCT('
      '1109187=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '1109188=RETURNS ('
      '1109189=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1109190=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1109191=  IS_HAVE_SKIDKA_ VARCHAR(10),'
      '1109192=  ERR_CODE INTEGER,'
      '1109193=  ERR_MSG VARCHAR(1024))'
      '1109194=AS'
      
        '1109195=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOC' +
        'HKA;'
      '1109196=BEGIN'
      '1109197=    SELECT ID'
      '1109198=      FROM CUR_PARAMS'
      '1109199=     WHERE CUR_PARAMS = 2'
      '11091100=      INTO :G_TOCHKA_;'
      '11091101='
      '11091102=    SELECT D.SKIDKA_PROC, D.SKIDKA_SUM, '#39#1045#1057#1058#1068#39
      '11091103=    FROM G_DISCOUNT D'
      '11091104=    WHERE D.G_PRODUCT = :G_PRODUCT_'
      
        '11091105=      AND ((D.DATE_BEGIN <= CURRENT_DATE  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058 +
        #1048#1042#1053#1067#1045
      '11091106=            AND D.DATE_END >= CURRENT_DATE'
      
        '11091107=            AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END' +
        ' IS NOT NULL'
      '11091108=            )'
      '11091109=            OR'
      
        '11091110=            (D.DATE_BEGIN IS NULL AND D.DATE_END IS NUL' +
        'L)'
      '11091111=          )'
      '11091112=      AND COALESCE(D.G_TOCHKA, :G_TOCHKA_) = :G_TOCHKA_'
      '11091113=    INTO :SKIDKA_PROC_, :SKIDKA_SUM_, :IS_HAVE_SKIDKA_;'
      '11091114='
      '11091115=    if (IS_HAVE_SKIDKA_ IS NULL) then'
      '11091116=      IS_HAVE_SKIDKA_ = '#39#1053#1045#1058#39';'
      '11091117=end'
      '11091118=;'
      '11091119='
      '11091120=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '11091121=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11091122=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '11091123=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11091124=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11091125=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '11091126=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11091127=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11091128=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11091129=  SELF_PRICE_ NUMERIC(15,2),'
      '11091130=  AMOUNT_ MY_NUMERIC_5,'
      '11091131=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11091132=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11091133=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11091134=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11091135=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11091136=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11091137=  CATEGORY_NAME_ VARCHAR(1000),'
      '11091138=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11091139=  IS_THIS_LAST_ INTEGER,'
      '11091140=  UPDATE_IF_EXIST_ INTEGER)'
      '11091141=RETURNS ('
      '11091142=  ERR_CODE INTEGER,'
      '11091143=  ERR_MSG VARCHAR(1024))'
      '11091144=AS'
      
        '11091145=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11091146=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11091147=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11091148=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT_PAR;'
      
        '11091149=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT_PAR;'
      '11091150=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11091151=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11091152=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11091153=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11091154=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11091155=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11091156=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11091157=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11091158=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11091159=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11091160=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11091161=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11091162=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11091163=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11091164=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11091165=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11091166=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11091167=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11091168=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11091169=BEGIN'
      '11091170=    ERR_MSG = '#39#39';'
      '11091171=    PNT_ = '#39'00'#39';'
      '11091172='
      
        '11091173=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11091174=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11091175=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11091176=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11091177=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11091178=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11091179=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11091180=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11091181=    END ELSE'
      '11091182=        CROSSCODE_ = NULL;'
      '11091183='
      '11091184=    PNT_ = '#39'01'#39';'
      '11091185=    SELECT ID'
      '11091186=      FROM CUR_PARAMS'
      '11091187=    WHERE CUR_PARAMS = 2'
      '11091188=      INTO :G_TOCHKA_;'
      '11091189='
      '11091190=    SELECT G.G_UNIT'
      '11091191=      FROM G_UNIT G'
      
        '11091192=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11091193=      INTO :G_UNIT_;'
      '11091194=    if (ROW_COUNT = 0) then'
      '11091195=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11091196='
      '11091197=    PNT_ = '#39'02'#39';'
      
        '11091198=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11091199=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11091200=        SELECT G.G_PRODUCT,'
      '11091201=               G.NAME'
      '11091202=          FROM G_PRODUCT G'
      
        '11091203=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11091204=           AND TRIM(G.ARTICUL) <> '#39#39
      '11091205=          INTO :G_PRODUCT_,'
      '11091206=               :G_PRODUCT_NAME_;'
      '11091207='
      
        '11091208=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11091209=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11091210=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11091211=              UPDATE G_PRODUCT G'
      '11091212=                 SET G.NAME = :NAME_,'
      '11091213=                     G.G_UNIT = :G_UNIT_,'
      '11091214=                     G.PRICE  = :PRICE_,'
      '11091215=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11091216=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11091217=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11091218=                     G.PLACE = :PLACE_,'
      
        '11091219=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11091220=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11091221=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11091222=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11091223=                     ,G.CROSSCODE      = :CROSSCODE_'
      '11091224=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11091225='
      
        '11091226=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11091227=            END ELSE'
      
        '11091228=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11091229=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||U' +
        'PPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME_' +
        '||'#39'.'#39';'
      '11091230=        END'
      '11091231=    END ELSE'
      
        '11091232=      EXECUTE PROCEDURE get_free_articul RETURNING_VALU' +
        'ES (:ARTICUL_);'
      '11091233='
      
        '11091234=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052',' +
        ' '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11091235=    PNT_ = '#39'02a'#39';'
      
        '11091236=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11091237=        SELECT G.G_PRODUCT,'
      '11091238=               G.NAME'
      '11091239=          FROM G_PRODUCT G'
      
        '11091240=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_NU' +
        'M_)'
      '11091241=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '11091242=          INTO :G_PRODUCT_,'
      '11091243=               :G_PRODUCT_NAME_;'
      '11091244='
      
        '11091245=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11091246=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11091247=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11091248=              UPDATE G_PRODUCT G'
      '11091249=                 SET G.NAME = :NAME_,'
      '11091250=                     G.G_UNIT = :G_UNIT_,'
      '11091251=                     G.PRICE  = :PRICE_,'
      '11091252=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11091253=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11091254=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11091255=                     G.PLACE = :PLACE_,'
      
        '11091256=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11091257=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11091258=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11091259=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11091260=                     ,G.CROSSCODE      = :CROSSCODE_'
      '11091261=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11091262='
      
        '11091263=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077 +
        #1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11091264=            END ELSE'
      
        '11091265=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11091266=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39 +
        '||G_PRODUCT_NAME_||'#39'.'#39';'
      '11091267=        END'
      '11091268=    end'
      '11091269='
      
        '11091270=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11091271=    PNT_ = '#39'02b'#39';'
      
        '11091272=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11091273=        SELECT G.G_PRODUCT,'
      '11091274=               G.NAME'
      '11091275=          FROM G_PRODUCT G'
      '11091276=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11091277=           AND TRIM(G.BARCODE) <> '#39#39
      '11091278=          INTO :G_PRODUCT_,'
      '11091279=               :G_PRODUCT_NAME_;'
      '11091280='
      '11091281=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11091282=          SELECT G.G_PRODUCT,'
      '11091283=                 G.NAME'
      '11091284=            FROM G_PRODUCT G, LT_BARCODE L'
      '11091285=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11091286=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11091287=             AND TRIM(L.BARCODE) <> '#39#39
      '11091288=            INTO :G_PRODUCT_,'
      '11091289=                 :G_PRODUCT_NAME_;'
      '11091290='
      
        '11091291=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11091292=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11091293=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11091294=              UPDATE G_PRODUCT G'
      '11091295=                 SET G.NAME = :NAME_,'
      '11091296=                     G.G_UNIT = :G_UNIT_,'
      '11091297=                     G.PRICE  = :PRICE_,'
      '11091298=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11091299=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11091300=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11091301=                     G.PLACE = :PLACE_,'
      
        '11091302=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11091303=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11091304=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '11091305=                     G.KOD_TNVD        = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '11091306=                     ,G.CROSSCODE      = :CROSSCODE_'
      '11091307=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11091308='
      
        '11091309=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'|' +
        '|UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11091310=            END ELSE'
      
        '11091311=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11091312=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NA' +
        'ME_||'#39'.'#39';'
      '11091313=        END'
      '11091314=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN'
      
        '11091315=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RETU' +
        'RNING_VALUES (:BARCODE_);'
      '11091316='
      
        '11091317=    --=================================================' +
        '========'
      '11091318=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '11091319=    --=================================================' +
        '========'
      '11091320=    PNT_ = '#39'02b'#39';'
      '11091321=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '11091322='
      
        '11091323=        -----------------------------------------------' +
        '-------------------'
      
        '11091324=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058 +
        #1040#1050#1054#1049' '#1053#1045#1058
      
        '11091325=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~' +
        #1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '11091326=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '11091327=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053 +
        #1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '11091328=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEGI' +
        'N'
      '11091329=            G_PRODUCT_PAR_ = NULL;'
      
        '11091330=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME_' +
        ');'
      '11091331=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '11091332=              STR_ = CATEGORY_NAME_;'
      '11091333=              CATEGORY_NAME_ = '#39#39';'
      '11091334=            END ELSE'
      
        '11091335=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '11091336='
      '11091337=            SELECT G_PRODUCT'
      '11091338=              FROM G_PRODUCT G'
      '11091339=             WHERE G.NAME = :STR_'
      '11091340=               AND G.IS_CATEGORY = 1'
      
        '11091341=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_P' +
        'REV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '11091342=                   OR'
      '11091343=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '11091344=              INTO G_PRODUCT_PAR_;'
      '11091345=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '11091346=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PRO' +
        'DUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '11091347=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PR' +
        'ODUCT_PAR_PREV_, :STR_, 1, 0)'
      '11091348=                RETURNING G_PRODUCT'
      '11091349=                INTO :G_PRODUCT_PAR_;'
      '11091350='
      '11091351=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '11091352=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_NA' +
        'ME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '11091353=        END'
      
        '11091354=        -----------------------------------------------' +
        '-------------------'
      '11091355='
      
        '11091356=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR' +
        ', ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME' +
        '_PRICE,'
      
        '11091357=                               IS_CATEGORY, PACK_AMOUNT' +
        ', MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '11091358=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_P' +
        'RODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME' +
        '_, :G_UNIT_, :PRICE_,'
      
        '11091359=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_C' +
        'OUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '11091360=        RETURNING G_PRODUCT'
      '11091361=        INTO :G_PRODUCT_;'
      '11091362='
      
        '11091363=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11091364=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, 0, :G_TOCHKA_);'
      '11091365=    end'
      '11091366='
      
        '11091367=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045#1051 +
        #1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11091368=    PNT_ = '#39'03'#39';'
      '11091369=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '11091370=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '11091371=                                       :AMOUNT_,'
      '11091372=                                       :SELF_PRICE_,'
      
        '11091373=                                       :AMOUNT_ * :SELF' +
        '_PRICE_,'
      '11091374=                                       0, --nds_,'
      '11091375=                                       0 --nds_summ_,'
      '11091376=                                       ,:SELF_PRICE_UE_'
      
        '11091377=                                       ,:AMOUNT_ * :SEL' +
        'F_PRICE_UE_'
      
        '11091378=                                       ) RETURNING_VALU' +
        'ES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '11091379=        IF (ERR_CODE <> 0) THEN BEGIN'
      '11091380=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '11091381=          EXIT;'
      '11091382=        END'
      '11091383=    END'
      '11091384='
      
        '11091385=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' ' +
        #1047#1040#1055#1048#1057#1068
      '11091386=    PNT_ = '#39'04'#39';'
      '11091387=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '11091388=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061#1054 +
        #1044
      '11091389=        FROM SKLAD_TMP T'
      '11091390=        INTO :CNT_;'
      '11091391='
      '11091392=      if (CNT_ > 0) then BEGIN'
      '11091393=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '11091394=          FROM SKLAD_TMP T'
      '11091395=          INTO :SUMM_, :SUMM_UE_;'
      '11091396='
      '11091397=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '11091398=                                DATE_RECEIPT,'
      '11091399=                                TIME_RECEIPT,'
      '11091400=                                G_CLIENT,'
      '11091401=                                G_PAYMENT_TYPE,'
      '11091402=                                OSNOVANIE,'
      '11091403=                                NOTE,'
      '11091404=                                SUMM,'
      '11091405=                                SUMM_FACT,'
      '11091406=                                SUMM_CURRENCY,'
      '11091407=                                IS_PAYED_ALL,'
      '11091408=                                IS_VOZVRAT,'
      '11091409=                                G_TOCHKA)'
      '11091410=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11091411=                CURRENT_DATE,'
      '11091412=                CURRENT_TIME,'
      '11091413=                :G_CLIENT_,'
      '11091414=                1,'
      '11091415=                NULL,  --:OSNOVANIE_,'
      '11091416=                NULL,  -- :NOTE_,'
      '11091417=                :SUMM_,'
      '11091418=                :SUMM_,'
      '11091419=                :SUMM_UE_,'
      
        '11091420=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040 +
        ' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11091421=                0,'
      '11091422=                :G_TOCHKA_)'
      '11091423=        RETURNING'
      '11091424=          SKLAD'
      '11091425=        INTO'
      '11091426=          :SKLAD_PARENT_;'
      '11091427='
      '11091428=        PNT_ = '#39'05'#39';'
      '11091429=        FOR SELECT SKLAD,'
      '11091430=                   G_PRODUCT,'
      '11091431=                   AMOUNT,'
      '11091432=                   PRICE,'
      '11091433=                   SUMM'
      '11091434=                   ,PRICE_CURRENCY'
      '11091435=                   ,SUMM_CURRENCY'
      '11091436=              FROM SKLAD_TMP'
      '11091437=             ORDER BY 1'
      '11091438=              INTO :SKLAD_TMP_,'
      '11091439=                   :RG_PRODUCT_,'
      '11091440=                   :RAMOUNT_,'
      '11091441=                   :RPRICE_,'
      '11091442=                   :RSUMM_'
      '11091443=                   ,:RPRICE_UE_'
      '11091444=                   ,:RSUMM_UE_'
      '11091445=        DO BEGIN'
      '11091446='
      '11091447=            UPDATE SKLAD SK'
      '11091448=               SET SK.IS_LAST = 0'
      '11091449=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11091450=               AND SK.IS_LAST = 1;'
      '11091451='
      '11091452=            INSERT INTO SKLAD'
      '11091453=            ('
      '11091454=             SKLAD,'
      '11091455=             SKLAD_PARENT,'
      '11091456=             DATE_RECEIPT,'
      '11091457=             G_CLIENT,'
      '11091458=             G_PRODUCT,'
      '11091459=             AMOUNT,'
      '11091460=             PRICE,'
      '11091461=             SUMM,'
      '11091462=             G_PAYMENT_TYPE,'
      '11091463=             OSNOVANIE,'
      '11091464=             NOTE,'
      '11091465=             NDS,'
      '11091466=             NDS_SUMM,'
      '11091467=             IS_LAST,'
      '11091468=             IS_VOZVRAT,'
      '11091469=             G_TOCHKA'
      '11091470=             ,PRICE_CURRENCY'
      '11091471=             ,SUMM_CURRENCY'
      '11091472=            ) VALUES ('
      '11091473=             :SKLAD_TMP_,'
      '11091474=             :SKLAD_PARENT_,'
      '11091475=             CURRENT_DATE,'
      '11091476=             :G_CLIENT_,'
      '11091477=             :RG_PRODUCT_,'
      '11091478=             :RAMOUNT_,'
      '11091479=             :RPRICE_,'
      '11091480=             :RSUMM_,'
      '11091481=             1,       --:G_PAYMENT_TYPE_,'
      '11091482=             NULL,    --:OSNOVANIE_,'
      '11091483=             NULL,    --:NOTE_,'
      '11091484=             0,       --:RNDS_,'
      '11091485=             0,       --:RNDS_SUMM_,'
      '11091486=             1,       --IS_LAST_'
      '11091487=             0,        --:IS_VOZVRAT_'
      '11091488=             :G_TOCHKA_'
      '11091489=             ,:RPRICE_UE_'
      '11091490=             ,:RSUMM_UE_'
      '11091491=            );'
      '11091492='
      
        '11091493=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11091494=            PNT_ = '#39'06'#39';'
      '11091495=            UPDATE LT_SKLAD_PRODUCT L'
      '11091496=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11091497=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11091498=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11091499='
      '11091500=            PNT_ = '#39'06a'#39';'
      '11091501=            IF (ROW_COUNT = 0) THEN'
      
        '11091502=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11091503=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11091504=        END'
      '11091505='
      '11091506=        PNT_ = '#39'07'#39';'
      
        '11091507=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_' +
        ' => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11091508=                                2,    --:G_PRIHOD_RASHO' +
        'D_,'
      '11091509=                                :SUMM_,'
      '11091510=                                CURRENT_DATE,'
      
        '11091511=                                NULL,   --NOTE_ => :NOT' +
        'E_,'
      '11091512=                                NULL,   --ZAKAZ_'
      '11091513=                                :SKLAD_PARENT_,'
      '11091514=                                1,'
      
        '11091515=                                :G_TOCHKA_) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11091516=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11091517=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11091518=          EXIT;'
      '11091519=        END'
      '11091520='
      '11091521=        DELETE FROM SKLAD_TMP;'
      '11091522=      END'
      '11091523=    END'
      '11091524='
      
        '11091525=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054#1069 +
        #1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '11091526=    if (ERR_MSG_ IS NOT NULL) then'
      '11091527=      ERR_MSG = ERR_MSG_;'
      '11091528='
      '11091529=WHEN ANY DO BEGIN'
      '11091530=    Err_code = gdscode;'
      
        '11091531=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' --' +
        '> PNT_ '#39'||PNT_;'
      '11091532=  END'
      '11091533=END'
      '11091534=;'
      '11091535='
      '11091536=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '11091537=  TYPE_ INTEGER = 0,'
      
        '11091538=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ' = NULL)'
      '11091539=RETURNS ('
      '11091540=  SORT_COL INTEGER,'
      '11091541=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11091542=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '11091543=  NAME VARCHAR(500))'
      '11091544=AS'
      '11091545=DECLARE VARIABLE LVL_ INTEGER;'
      '11091546=BEGIN'
      '11091547='
      '11091548=  IF (TYPE_ = 0) THEN'
      '11091549=      FOR'
      '11091550=        SELECT'
      
        '11091551=            DECODE(T.G_PRODUCT, -1, 0, T.g_product) SOR' +
        'T_COL,'
      '11091552=            T.G_PRODUCT,'
      '11091553=            T.G_PRODUCT_PAR,'
      '11091554=            T.NAME,'
      '11091555=            0'
      '11091556=        FROM G_PRODUCT T'
      '11091557=        WHERE T.IS_CATEGORY = 1'
      '11091558=        ORDER BY NAME'
      '11091559=        INTO'
      '11091560=            :SORT_COL,'
      '11091561=            :G_PRODUCT,'
      '11091562=            :G_PRODUCT_PAR,'
      '11091563=            :NAME,'
      '11091564=            :LVL_'
      '11091565=      DO'
      '11091566=        suspend;'
      '11091567='
      
        '11091568=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059#1063 +
        #1040#1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '11091569=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054#1044 +
        #1048#1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '11091570=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1056 +
        #1054#1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '11091571=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048#1046 +
        #1045' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '11091572=  ELSE'
      '11091573=    FOR WITH RECURSIVE TREE AS ('
      
        '11091574=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) ' +
        'SORTT,'
      '11091575=               T.G_PRODUCT,'
      '11091576=               T.G_PRODUCT_PAR,'
      '11091577=               T.NAME,'
      '11091578=               1 LVL'
      '11091579=          FROM G_PRODUCT T'
      
        '11091580=         WHERE ((T.G_PRODUCT_PAR IS NULL or T.g_product' +
        ' = -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '11091581=               OR'
      '11091582=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_)'
      '11091583=        UNION ALL'
      
        '11091584=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) ' +
        'SORTT,'
      '11091585=               T.G_PRODUCT,'
      '11091586=               T.G_PRODUCT_PAR,'
      '11091587=               T.NAME,'
      '11091588=               GG.LVL + 1 LVL'
      
        '11091589=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_P' +
        'RODUCT = T.G_PRODUCT_PAR'
      '11091590=         WHERE T.IS_CATEGORY = 1'
      '11091591=        )'
      '11091592=        SELECT * FROM TREE ORDER BY 1, 5, 3'
      '11091593=        INTO :SORT_COL,'
      '11091594=            :G_PRODUCT,'
      '11091595=            :G_PRODUCT_PAR,'
      '11091596=            :NAME,'
      '11091597=            :LVL_'
      '11091598=    DO'
      '11091599=        suspend;'
      '11091600='
      '11091601=    /*'
      
        '11091602=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT, ' +
        '-1, T.G_PRODUCT, 0) SORTT,'
      '11091603=                               T.G_PRODUCT,'
      '11091604=                               T.G_PRODUCT_PAR,'
      
        '11091605=                               DECODE(T.G_PRODUCT, -1, ' +
        #39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '11091606=                               T.NAME PATH,       --'#1076#1083#1103 +
        ' '#1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '11091607=                               1 LVL'
      '11091608=                          FROM G_PRODUCT T'
      
        '11091609=                         WHERE (T.G_PRODUCT_PAR IS NULL' +
        ' or T.g_product = -1)'
      '11091610=                        UNION ALL'
      
        '11091611=                        SELECT DECODE(T.G_PRODUCT, -1, ' +
        'T.G_PRODUCT, 0) SORTT,'
      '11091612=                               T.G_PRODUCT,'
      '11091613=                               T.G_PRODUCT_PAR,'
      '11091614=                               GG.LVL||T.NAME NAME,'
      
        '11091615=                               GG.PATH||'#39' - '#39'||T.NAME, ' +
        '    --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '11091616=                               GG.LVL + 1 LVL'
      
        '11091617=                          FROM G_PRODUCT T INNER JOIN T' +
        'REE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '11091618=                         WHERE T.IS_CATEGORY = 1'
      '11091619=                        )'
      '11091620=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '11091621=    */'
      '11091622=END'
      '11091623=;'
      '11091624='
      '11091625=ALTER PROCEDURE INS_ZAKAZ('
      '11091626=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11091627=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11091628=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11091629=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11091630=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11091631=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11091632=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11091633=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11091634=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11091635=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11091636=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11091637=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11091638=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11091639=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '11091640=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11091641=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11091642=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11091643=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11091644=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11091645=  IS_MEBEL_ INTEGER = 0,'
      
        '11091646=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NULL' +
        ','
      
        '11091647=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE ' +
        '= NULL,'
      '11091648=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '11091649=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '11091650=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '11091651=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NU' +
        'LL)'
      '11091652=RETURNS ('
      '11091653=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11091654=  ERR_CODE INTEGER,'
      '11091655=  ERR_MSG VARCHAR(1024))'
      '11091656=AS'
      '11091657=/*'
      '11091658=IS_SPISANIE_'
      '11091659=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11091660=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11091661=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11091662=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11091663='
      '11091664='
      
        '11091665=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '11091666=*/'
      '11091667=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '11091668=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11091669=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11091670=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      
        '11091671=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AM' +
        'OUNT;'
      
        '11091672=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRI' +
        'CE;'
      
        '11091673=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM' +
        ';'
      
        '11091674=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      
        '11091675=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_TENGE;'
      
        '11091676=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_SUMM;'
      '11091677=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11091678=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS_SUMM;'
      
        '11091679=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      
        '11091680=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_FACT;'
      
        '11091681=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '11091682=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKA' +
        'Z_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '11091683=DECLARE VARIABLE CNT_ INTEGER;'
      '11091684=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11091685=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '11091686=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '11091687=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '11091688=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      
        '11091689=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.G_PAYMENT_TYPE;'
      '11091690=DECLARE VARIABLE STR_ VARCHAR(500);'
      '11091691=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '11091692=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.S' +
        'ALES_COMM;'
      
        '11091693=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OF' +
        'FICIAL.DO_NOT_SALES_COMM;'
      
        '11091694=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICI' +
        'AL.FM;'
      
        '11091695=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUMN' +
        ' SYSTEM_SETUP.S_VALUE;'
      
        '11091696=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '11091697=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G_' +
        'PRODUCT.SALES_COMM = 0;'
      
        '11091698=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '11091699=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIEN' +
        'T.SKIDKA;'
      
        '11091700=DECLARE VARIABLE NEW_BONUS_VAL_  TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '11091701=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.SUMM_ALL;'
      '11091702=BEGIN'
      '11091703='
      
        '11091704=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057#1048 +
        #1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055#1054 +
        #1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '11091705=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045#1058 +
        ', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '11091706=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '11091707=  IF (CNT_ = 0) THEN BEGIN'
      '11091708=    ERR_CODE = -20500;'
      
        '11091709=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088#1086 +
        #1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090#1077 +
        ' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '11091710=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '11091711=    EXIT;'
      '11091712=  END'
      '11091713='
      '11091714=  IF (G_TOCHKA_ IS NULL) THEN'
      '11091715=    SELECT ID'
      '11091716=      FROM CUR_PARAMS'
      '11091717=     WHERE CUR_PARAMS = 2'
      '11091718=      INTO :G_TOCHKA_;'
      '11091719='
      '11091720=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '11091721=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '11091722=      PNT_ = '#39'01'#39';'
      
        '11091723=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    -' +
        '- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052#1052 +
        #1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040#1063 +
        #1048
      '11091724=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '11091725=      ELSE'
      '11091726=        SUMM_FACT_1_ = SUMM_FACT_;'
      '11091727='
      '11091728=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '11091729=      SELECT G.G_OFFICIAL,'
      '11091730=             G.DO_NOT_SALES_COMM,'
      '11091731=             G.FM||'#39' '#39'||G.NM'
      '11091732=        FROM G_OFFICIAL G'
      
        '11091733=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SEL' +
        'ECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '11091734=        INTO :G_OFFICIAL_,'
      '11091735=             :DO_NOT_SALES_COMM_,'
      '11091736=             :OFFICIAL_NAME_;'
      '11091737='
      '11091738=      INSERT INTO ZAKAZ'
      '11091739=      ('
      '11091740=       ZAKAZ,'
      '11091741=       G_TOCHKA,'
      '11091742=       Z_DATE,'
      '11091743=       Z_TIME,'
      '11091744=       G_CLIENT,'
      '11091745=       G_PAYMENT_TYPE,'
      '11091746=       OSNOVANIE,'
      '11091747=       IS_SPISANIE,'
      '11091748=       NOTE,'
      '11091749=       SUMM,'
      '11091750=       SUMM_FACT,'
      '11091751=       SUMM_BONUS,'
      '11091752=       IS_PAYED_ALL'
      '11091753=       ,G_OFFICIAL'
      '11091754=       ,BY_RECIPE'
      '11091755=       ,SUMM_BONUS_GOT'
      '11091756=       ,IS_RESERVE'
      '11091757=       ,SUMM_CASH'
      '11091758=       ,SUMM_NONCASH'
      '11091759=      ) VALUES ('
      '11091760=       GEN_ID(GEN_ZAKAZ, 1),'
      '11091761=       :G_TOCHKA_,'
      '11091762=       :Z_DATE_,'
      '11091763=       :Z_TIME_,'
      '11091764=       :G_CLIENT_,'
      '11091765=       :G_PAYMENT_TYPE_,'
      '11091766=       :OSNOVANIE_,'
      '11091767=       :IS_SPISANIE_,'
      '11091768=       :NOTE_,'
      '11091769=       :SUMM_,'
      '11091770=       :SUMM_FACT_1_,'
      '11091771=       COALESCE(:SUMM_BONUS_, 0),'
      
        '11091772=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_B' +
        'ONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052 +
        #1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11091773=       ,:G_OFFICIAL_'
      '11091774=       ,:BY_RECIPE_'
      '11091775=       ,:SUMM_BONUS_GOT_'
      '11091776=       ,:IS_RESERVE_'
      '11091777=       ,COALESCE(:SUMM_CASH_, 0)'
      '11091778=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '11091779=      )'
      '11091780=      RETURNING'
      '11091781=        ZAKAZ'
      '11091782=      INTO'
      '11091783=        :ZAKAZ_;'
      '11091784='
      '11091785=      PNT_ = '#39'02'#39';'
      
        '11091786=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUNT' +
        ', Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUNT' +
        '_SUMM,'
      
        '11091787=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SAL' +
        'ES_COMM'
      '11091788=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '11091789=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '11091790=          INTO :ZAKAZ_DETAILS_TMP_,'
      '11091791=              :G_PRODUCT,'
      '11091792=              :AMOUNT,'
      '11091793=              :PRICE,'
      '11091794=              :SUMM,'
      '11091795=              :DISCOUNT_PERC,'
      '11091796=              :DISCOUNT_TENGE,'
      '11091797=              :DISCOUNT_SUMM,'
      '11091798=              :NDS,'
      '11091799=              :NDS_SUMM,'
      '11091800=              :COST_PRICE,'
      '11091801=              :SALES_COMM_'
      '11091802=      DO BEGIN'
      
        '11091803=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056 +
        #1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040 +
        #1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '11091804=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '11091805=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/10' +
        '0;'
      
        '11091806=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_ ' +
        '+ SALES_COMM_SUMM_ITER_;'
      '11091807=        END'
      '11091808='
      '11091809=        INSERT INTO ZAKAZ_DETAILS'
      '11091810=        VALUES('
      '11091811=          :ZAKAZ_DETAILS_TMP_,'
      '11091812=          :ZAKAZ_,'
      '11091813=          :G_PRODUCT,'
      '11091814=          :AMOUNT,'
      '11091815=          :PRICE,'
      '11091816=          :SUMM,'
      '11091817=          :DISCOUNT_PERC,'
      '11091818=          :DISCOUNT_TENGE,'
      '11091819=          :DISCOUNT_SUMM,'
      '11091820=          :NDS,'
      '11091821=          :NDS_SUMM,'
      '11091822=          :COST_PRICE,'
      '11091823=          :SALES_COMM_SUMM_ITER_'
      '11091824=        );'
      '11091825='
      '11091826=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11091827=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '11091828=            UPDATE LT_SKLAD_PRODUCT L'
      '11091829=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11091830=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11091831=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11091832='
      '11091833=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '11091834=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '11091835=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '11091836=            PNT_ = '#39'04'#39';'
      
        '11091837=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '11091838=              Err_Code = -20500;'
      
        '11091839=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11091840=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11091841=              EXIT;'
      '11091842=            END ELSE if (ROW_COUNT = 0) then'
      
        '11091843=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '11091844=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '11091845=        END'
      '11091846='
      '11091847=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '11091848=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '11091849=            UPDATE LT_SKLAD_PRODUCT L'
      
        '11091850=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE ' +
        '+ :AMOUNT'
      '11091851=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '11091852=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11091853=      END'
      '11091854='
      '11091855=      ----------------------------------------'
      
        '11091856=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053 +
        #1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '11091857=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '11091858=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '11091859='
      
        '11091860=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '11091861=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '11091862=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '11091863=                PNT_ = '#39'05'#39';'
      
        '11091864=                EXECUTE PROCEDURE K_INS_KASSA(0,     --' +
        ' ACTION_ => :ACTION_'
      
        '11091865=                                              1,     --' +
        ' G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '11091866=                                              :SUMM_FAC' +
        'T_1_,'
      '11091867=                                              :Z_DATE_,'
      
        '11091868=                                              NULL,   -' +
        '-NOTE_ => :NOTE_,'
      
        '11091869=                                              ZAKAZ_,  ' +
        ' --ZAKAZ_'
      '11091870=                                              NULL,'
      
        '11091871=                                              :G_PAYMEN' +
        'T_TYPE_,'
      
        '11091872=                                              :G_TOCHKA' +
        '_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11091873=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11091874=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_' +
        '||'#39' '#39'||ERR_MSG;'
      '11091875=                  EXIT;'
      '11091876=                END'
      '11091877=            END'
      '11091878='
      '11091879=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '11091880=        END ELSE BEGIN'
      '11091881=            PNT_ = '#39'06'#39';'
      '11091882=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      
        '11091883=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_)' +
        ';'
      
        '11091884=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA' +
        '_) THEN'
      
        '11091885=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' POS_TILDA_ - 1);'
      '11091886=                ELSE'
      
        '11091887=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' CHAR_LENGTH(PAYMENTS_) - 1);'
      '11091888='
      
        '11091889=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR' +
        '_)'
      
        '11091890=                    RETURNING_VALUES :PAYMENT_ID_, :PAY' +
        'MENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '11091891='
      
        '11091892=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM ' +
        '(POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '11091893='
      '11091894=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11091895=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11091896=                                                  1,   ' +
        '  --:G_PRIHOD_RASHOD_,'
      
        '11091897=                                                  :PAYM' +
        'ENT_SUMM_,'
      
        '11091898=                                                  :PAYM' +
        'ENT_DATE_,'
      
        '11091899=                                                  NULL,' +
        '   --NOTE_ => :NOTE_,'
      
        '11091900=                                                  :ZAKA' +
        'Z_,'
      
        '11091901=                                                  NULL,' +
        '     --:SKLAD_,'
      
        '11091902=                                                  :PAYM' +
        'ENT_TYPE_,'
      
        '11091903=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11091904=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11091905=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '11091906=                      EXIT;'
      '11091907=                    END'
      '11091908=                END'
      '11091909=            END'
      '11091910=        END'
      '11091911=      END'
      '11091912='
      
        '11091913=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '11091914=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041#1054 +
        #1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '11091915=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052' ' +
        #1057#1051#1059#1063#1040#1045
      
        '11091916=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054' '#1051 +
        #1048#1062#1040'"'
      '11091917=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '11091918=          UPDATE G_DISCONT_CARD D'
      
        '11091919=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, ' +
        '0) + :SUMM_BONUS_GOT_,'
      '11091920=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '11091921=          WHERE D.G_CLIENT = :G_CLIENT_'
      '11091922=          RETURNING'
      '11091923=            D.SUMM_ALL'
      '11091924=          INTO'
      '11091925=            :CLIENT_SUMM_ALL_;'
      '11091926='
      '11091927=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '11091928=            FROM G_CLIENT_DISC_VAL_GRID G'
      '11091929=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '11091930=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '11091931=          ORDER BY G.SUMM_FROM'
      '11091932=          ROWS 1 TO 1'
      '11091933=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '11091934='
      '11091935=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '11091936=            UPDATE G_CLIENT G'
      '11091937=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '11091938=             WHERE G.G_CLIENT = :G_CLIENT_'
      '11091939=               AND G.SKIDKA <> :NEW_SKIDKA_VAL_;'
      '11091940='
      '11091941=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '11091942=            UPDATE G_DISCONT_CARD D'
      '11091943=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '11091944=             WHERE D.G_CLIENT = :G_CLIENT_'
      '11091945=               AND D.N_PERCENT <> :NEW_BONUS_VAL_;'
      '11091946=      END'
      '11091947='
      '11091948=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '11091949=      PNT_ = '#39'07'#39';'
      
        '11091950=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COMM' +
        '_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN BE' +
        'GIN'
      '11091951=        SELECT S.S_VALUE'
      '11091952=          FROM SYSTEM_SETUP S'
      '11091953=         WHERE S.SYSTEM_SETUP = 4'
      '11091954=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '11091955='
      '11091956=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '11091957=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '11091958=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '11091959='
      
        '11091960=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' '#1041 +
        #1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '11091961=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '11091962=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE(' +
        'EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM C' +
        'URRENT_DATE)));'
      '11091963='
      '11091964=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '11091965=        ELSE'
      
