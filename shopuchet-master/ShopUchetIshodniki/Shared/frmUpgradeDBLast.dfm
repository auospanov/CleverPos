      '11068965='
      
        '11068966=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11068967=    PNT_ = '#39'02b'#39';'
      
        '11068968=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11068969=        SELECT G.G_PRODUCT,'
      '11068970=               G.NAME'
      '11068971=          FROM G_PRODUCT G'
      '11068972=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11068973=           AND TRIM(G.BARCODE) <> '#39#39
      '11068974=          INTO :G_PRODUCT_,'
      '11068975=               :G_PRODUCT_NAME_;'
      '11068976='
      '11068977=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11068978=          SELECT G.G_PRODUCT,'
      '11068979=                 G.NAME'
      '11068980=            FROM G_PRODUCT G, LT_BARCODE L'
      '11068981=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11068982=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11068983=             AND TRIM(L.BARCODE) <> '#39#39
      '11068984=            INTO :G_PRODUCT_,'
      '11068985=                 :G_PRODUCT_NAME_;'
      '11068986='
      
        '11068987=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11068988=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11068989=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11068990=              UPDATE G_PRODUCT G'
      '11068991=                 SET G.NAME = :NAME_,'
      '11068992=                     G.G_UNIT = :G_UNIT_,'
      '11068993=                     G.PRICE  = :PRICE_,'
      '11068994=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11068995=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11068996=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11068997=                     G.PLACE = :PLACE_,'
      
        '11068998=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11068999=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '110681000=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110681001=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110681002=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110681003='
      
        '110681004=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110681005=            END ELSE'
      
        '110681006=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110681007=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110681008=        END'
      
        '110681009=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110681010=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110681011='
      '110681012=    PNT_ = '#39'02b'#39';'
      '110681013=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '110681014=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110681015=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD)'
      
        '110681016=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_P' +
        'AR_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, ' +
        ':PRICE_,'
      
        '110681017=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_)'
      '110681018=        returning G_PRODUCT'
      '110681019=        into :G_PRODUCT_;'
      '110681020='
      
        '110681021=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110681022=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110681023=    end'
      '110681024='
      
        '110681025=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110681026=    PNT_ = '#39'03'#39';'
      '110681027=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110681028=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110681029=                                       :AMOUNT_,'
      '110681030=                                       :SELF_PRICE_,'
      
        '110681031=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110681032=                                       0, --nds_,'
      '110681033=                                       0 --nds_summ_,'
      
        '110681034=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110681035=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110681036=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110681037=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110681038=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110681039=          EXIT;'
      '110681040=        END'
      '110681041=    END'
      '110681042='
      
        '110681043=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110681044=    PNT_ = '#39'04'#39';'
      '110681045=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110681046=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110681047=        FROM SKLAD_TMP T'
      '110681048=        INTO :CNT_;'
      '110681049='
      '110681050=      if (CNT_ > 0) then BEGIN'
      '110681051=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110681052=          FROM SKLAD_TMP T'
      '110681053=          INTO :SUMM_, :SUMM_UE_;'
      '110681054='
      '110681055=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110681056=                                DATE_RECEIPT,'
      '110681057=                                TIME_RECEIPT,'
      '110681058=                                G_CLIENT,'
      '110681059=                                G_PAYMENT_TYPE,'
      '110681060=                                OSNOVANIE,'
      '110681061=                                NOTE,'
      '110681062=                                SUMM,'
      '110681063=                                SUMM_FACT,'
      '110681064=                                SUMM_CURRENCY,'
      '110681065=                                IS_PAYED_ALL,'
      '110681066=                                IS_VOZVRAT,'
      '110681067=                                G_TOCHKA)'
      '110681068=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110681069=                CURRENT_DATE,'
      '110681070=                CURRENT_TIME,'
      '110681071=                :G_CLIENT_,'
      '110681072=                1,'
      '110681073=                NULL,  --:OSNOVANIE_,'
      '110681074=                NULL,  -- :NOTE_,'
      '110681075=                :SUMM_,'
      '110681076=                :SUMM_,'
      '110681077=                :SUMM_UE_,'
      
        '110681078=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110681079=                0,'
      '110681080=                :G_TOCHKA_)'
      '110681081=        RETURNING'
      '110681082=          SKLAD'
      '110681083=        INTO'
      '110681084=          :SKLAD_PARENT_;'
      '110681085='
      '110681086=        PNT_ = '#39'05'#39';'
      '110681087=        FOR SELECT SKLAD,'
      '110681088=                   G_PRODUCT,'
      '110681089=                   AMOUNT,'
      '110681090=                   PRICE,'
      '110681091=                   SUMM'
      '110681092=                   ,PRICE_CURRENCY'
      '110681093=                   ,SUMM_CURRENCY'
      '110681094=              FROM SKLAD_TMP'
      '110681095=             ORDER BY 1'
      '110681096=              INTO :SKLAD_TMP_,'
      '110681097=                   :RG_PRODUCT_,'
      '110681098=                   :RAMOUNT_,'
      '110681099=                   :RPRICE_,'
      '110681100=                   :RSUMM_'
      '110681101=                   ,:RPRICE_UE_'
      '110681102=                   ,:RSUMM_UE_'
      '110681103=        DO BEGIN'
      '110681104='
      '110681105=            UPDATE SKLAD SK'
      '110681106=               SET SK.IS_LAST = 0'
      '110681107=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110681108=               AND SK.IS_LAST = 1;'
      '110681109='
      '110681110=            INSERT INTO SKLAD'
      '110681111=            ('
      '110681112=             SKLAD,'
      '110681113=             SKLAD_PARENT,'
      '110681114=             DATE_RECEIPT,'
      '110681115=             G_CLIENT,'
      '110681116=             G_PRODUCT,'
      '110681117=             AMOUNT,'
      '110681118=             PRICE,'
      '110681119=             SUMM,'
      '110681120=             G_PAYMENT_TYPE,'
      '110681121=             OSNOVANIE,'
      '110681122=             NOTE,'
      '110681123=             NDS,'
      '110681124=             NDS_SUMM,'
      '110681125=             IS_LAST,'
      '110681126=             IS_VOZVRAT,'
      '110681127=             G_TOCHKA'
      '110681128=             ,PRICE_CURRENCY'
      '110681129=             ,SUMM_CURRENCY'
      '110681130=            ) VALUES ('
      '110681131=             :SKLAD_TMP_,'
      '110681132=             :SKLAD_PARENT_,'
      '110681133=             CURRENT_DATE,'
      '110681134=             :G_CLIENT_,'
      '110681135=             :RG_PRODUCT_,'
      '110681136=             :RAMOUNT_,'
      '110681137=             :RPRICE_,'
      '110681138=             :RSUMM_,'
      '110681139=             1,       --:G_PAYMENT_TYPE_,'
      '110681140=             NULL,    --:OSNOVANIE_,'
      '110681141=             NULL,    --:NOTE_,'
      '110681142=             0,       --:RNDS_,'
      '110681143=             0,       --:RNDS_SUMM_,'
      '110681144=             1,       --IS_LAST_'
      '110681145=             0,        --:IS_VOZVRAT_'
      '110681146=             :G_TOCHKA_'
      '110681147=             ,:RPRICE_UE_'
      '110681148=             ,:RSUMM_UE_'
      '110681149=            );'
      '110681150='
      
        '110681151=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110681152=            PNT_ = '#39'06'#39';'
      '110681153=            UPDATE LT_SKLAD_PRODUCT L'
      '110681154=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110681155=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110681156=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110681157='
      '110681158=            PNT_ = '#39'06a'#39';'
      '110681159=            IF (ROW_COUNT = 0) THEN'
      
        '110681160=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110681161=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110681162=        END'
      '110681163='
      '110681164=        PNT_ = '#39'07'#39';'
      
        '110681165=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110681166=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110681167=                                :SUMM_,'
      '110681168=                                CURRENT_DATE,'
      
        '110681169=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110681170=                                NULL,   --ZAKAZ_'
      '110681171=                                :SKLAD_PARENT_,'
      '110681172=                                1,'
      
        '110681173=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110681174=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110681175=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110681176=          EXIT;'
      '110681177=        END'
      '110681178='
      '110681179=        DELETE FROM SKLAD_TMP;'
      '110681180=      END'
      '110681181=    END'
      '110681182='
      
        '110681183=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110681184=    if (ERR_MSG_ IS NOT NULL) then'
      '110681185=      ERR_MSG = ERR_MSG_;'
      '110681186='
      '110681187=WHEN ANY DO BEGIN'
      '110681188=    Err_code = gdscode;'
      
        '110681189=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110681190=  END'
      '110681191=END'
      '110681192=;'
      '110681193='
      '110681194=ALTER PROCEDURE G_INS_G_OFFICIAL('
      '110681195=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110681196=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110681197=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110681198=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110681199=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110681200=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110681201=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110681202=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110681203=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110681204=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110681205=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110681206=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110681207=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110681208=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110681209=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110681210=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110681211=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110681212=  RIGHTS_ARR_ VARCHAR(500),'
      
        '110681213=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.DO_NOT_' +
        'SALES_COMM,'
      '110681214=  KOD_ TYPE OF COLUMN G_OFFICIAL.KOD)'
      '110681215=RETURNS ('
      '110681216=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110681217=  ERR_CODE INTEGER,'
      '110681218=  ERR_MSG VARCHAR(1024))'
      '110681219=AS'
      
        '110681220=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110681221=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110681222=begin'
      '110681223='
      
        '110681224=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110681225=      UPDATE G_OFFICIAL G'
      '110681226=         SET G.IS_ISPOLNITEL = 0;'
      '110681227='
      
        '110681228=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110681229=      UPDATE G_OFFICIAL G'
      '110681230=         SET G.IS_RUKOVODITEL = 0;'
      '110681231='
      
        '110681232=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110681233=      UPDATE G_OFFICIAL G'
      '110681234=         SET G.IS_GLAVBUH = 0;'
      '110681235='
      
        '110681236=    insert into G_OFFICIAL (G_OFFICIAL, FM, NM, FT, FI' +
        'O_DOC, RNN, IDN, DT, G_ID_KIND, ID_NUM, ID_DATE, ID_ISSUER,'
      
        '110681237=                            G_APPOINTMENT, IS_RUKOVODI' +
        'TEL, IS_GLAVBUH, IS_ISPOLNITEL, PASS, G_TOCHKA, DO_NOT_SALES_COM' +
        'M, KOD)'
      
        '110681238=    values (GEN_ID(GEN_G_OFFICIAL, 1), :FM_, :NM_, :FT' +
        '_, :FIO_DOC_, :RNN_, :IDN_, :DT_, :G_ID_KIND_, :ID_NUM_, :ID_DAT' +
        'E_, :ID_ISSUER_,'
      
        '110681239=            :G_APPOINTMENT_, :IS_RUKOVODITEL_, :IS_GLA' +
        'VBUH_, :IS_ISPOLNITEL_, :PASSWORD_, :G_TOCHKA_, :DO_NOT_SALES_CO' +
        'MM_, :KOD_)'
      '110681240=    returning G_OFFICIAL'
      '110681241=    into :G_OFFICIAL_;'
      '110681242='
      '110681243=    FOR SELECT T.RIGHTS_ITEM'
      '110681244=        FROM RIGHTS_ITEM T'
      '110681245=       WHERE T.IS_CATEGORY = 0'
      
        '110681246=         AND :RIGHTS_ARR_ CONTAINING '#39'-'#39'||T.RIGHTS_ITE' +
        'M||'#39'-'#39
      '110681247=        INTO :RIGHTS_ITEM_'
      '110681248=    DO BEGIN'
      
        '110681249=      INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT, ' +
        'RIGHTS_ITEM, G_OFFICIAL)'
      
        '110681250=      VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGHTS' +
        '_ITEM_, :G_OFFICIAL_);'
      '110681251=    END'
      '110681252='
      
        '110681253=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110681254=    SELECT COUNT(G.G_OFFICIAL)'
      '110681255=      FROM G_OFFICIAL G'
      '110681256=     WHERE EXISTS (SELECT 1'
      '110681257=                     FROM G_OFFICIAL_RIGHT R'
      '110681258=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110681259=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110681260=    INTO :CNT_;'
      '110681261='
      '110681262=    IF (:CNT_ = 0) THEN BEGIN'
      '110681263=      ERR_CODE = -20500;'
      
        '110681264=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1086#1073#1093#1086#1076 +
        #1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087#1088 +
        #1072#1074#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110681265=      EXIT;'
      '110681266=    END'
      '110681267=end'
      '110681268=;'
      '110681269='
      '110681270=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '110681271=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110681272=  ARTICUL_ VARCHAR(30),'
      '110681273=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110681274=  BARCODE_ VARCHAR(30),'
      '110681275=  NAME_ VARCHAR(500),'
      '110681276=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110681277=  PRICE_ NUMERIC(15,2),'
      '110681278=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110681279=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110681280=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110681281=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110681282=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110681283=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110681284=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110681285=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110681286=  IS_CATEGORY_ INTEGER,'
      '110681287=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110681288=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110681289=RETURNS ('
      '110681290=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110681291=  ERR_CODE INTEGER,'
      '110681292=  ERR_MSG VARCHAR(1024))'
      '110681293=AS'
      
        '110681294=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODU' +
        'CT'#39';'
      '110681295=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110681296=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110681297=begin'
      
        '110681298=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110681299=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '110681300=        SELECT COUNT(*)'
      '110681301=          FROM G_PRODUCT G'
      
        '110681302=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110681303=           AND TRIM(G.ARTICUL) <> '#39#39
      '110681304=           AND G.IS_ACTIVE = 1'
      '110681305=          INTO :CNT_;'
      '110681306='
      '110681307=        IF (CNT_ > 0) THEN BEGIN'
      '110681308=          ERR_CODE = -20500;'
      
        '110681309=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '110681310=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110681311=          EXIT;'
      '110681312=        END'
      '110681313=    end'
      '110681314='
      '110681315=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '110681316=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then' +
        ' begin'
      '110681317=        SELECT COUNT(*)'
      '110681318=          FROM G_PRODUCT G'
      
        '110681319=         WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:' +
        'NOMENCLATUR_NUM_))'
      '110681320=           AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110681321=           AND G.IS_ACTIVE = 1'
      '110681322=        INTO :CNT_;'
      '110681323=        IF (CNT_ > 0) THEN BEGIN'
      '110681324=          ERR_CODE = -20500;'
      
        '110681325=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '110681326=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110681327=          EXIT;'
      '110681328=        END'
      '110681329=    end'
      '110681330='
      '110681331=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110681332=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110681333=        SELECT COUNT(*)'
      '110681334=          FROM G_PRODUCT G'
      
        '110681335=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110681336=           AND TRIM(G.BARCODE) <> '#39#39
      '110681337=           AND G.IS_ACTIVE = 1'
      '110681338=          INTO :CNT_;'
      '110681339='
      '110681340=        IF (CNT_ = 0) then'
      '110681341=          SELECT COUNT(*)'
      '110681342=            FROM G_PRODUCT G, LT_BARCODE L'
      '110681343=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110681344=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110681345=             AND TRIM(L.BARCODE) <> '#39#39
      '110681346=             AND G.IS_ACTIVE = 1'
      '110681347=            INTO :CNT_;'
      '110681348='
      '110681349=        IF (CNT_ > 0) THEN BEGIN'
      '110681350=          ERR_CODE = -20500;'
      
        '110681351=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110681352=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110681353=          EXIT;'
      '110681354=        END'
      '110681355=    end'
      '110681356='
      
        '110681357=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PR' +
        'ICE,'
      
        '110681358=                           IS_CATEGORY, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COM' +
        'M, KOD_TNVD)'
      
        '110681359=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRI' +
        'CE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '110681360=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROS' +
        'SCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNVD' +
        '_)'
      '110681361=    RETURNING G_PRODUCT'
      '110681362=    INTO :G_PRODUCT_;'
      '110681363='
      '110681364=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '110681365=    if (:IS_CATEGORY_ = 0) then begin'
      
        '110681366=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110681367=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '110681368='
      '110681369=        INSERT INTO LT_BARCODE'
      
        '110681370=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110681371='
      
        '110681372=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090 +
        #1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '110681373=        INSERT into G_PRODUCT_IMAGE'
      
        '110681374=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYP' +
        'E from G_PRODUCT_IMAGE_TMP;'
      '110681375='
      
        '110681376=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089 +
        #1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '110681377=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091 +
        #1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '110681378=        IF (is_kit_ > 0) THEN begin'
      '110681379=            INSERT INTO G_PRODUCT_KIT'
      
        '110681380=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP;'
      '110681381='
      '110681382=            if (is_kit_ = 1) then begin'
      
        '110681383=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110681384=                  FROM G_PRODUCT_KIT K,'
      '110681385=                       LT_SKLAD_PRODUCT L'
      '110681386=                 WHERE K.g_product = :G_PRODUCT_'
      '110681387=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110681388=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110681389=                 GROUP BY K.G_PRODUCT'
      '110681390=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110681391='
      '110681392=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110681393=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_' +
        'SOSTAV_AMOUNT_, 0)'
      '110681394=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110681395=            end'
      '110681396=        END'
      '110681397=    END'
      '110681398=end'
      '110681399=;'
      '110681400='
      '110681401=ALTER PROCEDURE G_READ_G_OFFICIAL_LIST'
      '110681402=RETURNS ('
      '110681403=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110681404=  FM TYPE OF COLUMN G_OFFICIAL.FM,'
      '110681405=  NM TYPE OF COLUMN G_OFFICIAL.NM,'
      '110681406=  FT TYPE OF COLUMN G_OFFICIAL.FT,'
      '110681407=  FIO VARCHAR(200),'
      '110681408=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110681409=  RNN TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110681410=  IDN TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110681411=  DT TYPE OF COLUMN G_OFFICIAL.DT,'
      '110681412=  G_ID_KIND TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110681413=  ID_NUM TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110681414=  ID_DATE TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110681415=  ID_ISSUER TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110681416=  G_APPOINTMENT TYPE OF COLUMN G_OFFICIAL.G_APPOINTMEN' +
        'T,'
      
        '110681417=  IS_RUKOVODITEL TYPE OF COLUMN G_OFFICIAL.IS_RUKOVODI' +
        'TEL,'
      '110681418=  IS_GLAVBUH TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      '110681419=  APP_NAME TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '110681420=  PASS TYPE OF COLUMN G_OFFICIAL.PASS)'
      '110681421=AS'
      '110681422=begin'
      '110681423=    FOR'
      '110681424=    SELECT t.G_OFFICIAL,'
      '110681425=           T.FM,'
      '110681426=           T.NM,'
      '110681427=           T.FT,'
      
        '110681428=           COALESCE(T.FM, '#39#39')||COALESCE('#39' '#39'||T.NM, '#39#39')' +
        '||COALESCE('#39' '#39'||T.FT,  '#39#39'),'
      
        '110681429=           DECODE(CHAR_LENGTH(T.FIO_DOC), 0, T.FM||'#39' '#39 +
        '||T.NM||'#39' '#39'||T.FT, T.FIO_DOC),'
      '110681430=           T.RNN,'
      '110681431=           T.IDN,'
      '110681432=           T.DT,'
      '110681433=           T.G_ID_KIND,'
      '110681434=           T.ID_NUM,'
      '110681435=           T.ID_DATE,'
      '110681436=           T.ID_ISSUER,'
      '110681437=           T.G_APPOINTMENT,'
      '110681438=           T.IS_RUKOVODITEL,'
      '110681439=           T.IS_GLAVBUH,'
      '110681440=           G.NAME APP_NAME'
      '110681441=           ,T.PASS'
      
        '110681442=      FROM g_OFFICIAL t LEFT OUTER JOIN G_APPOINTMENT ' +
        'G ON T.G_APPOINTMENT = G.G_APPOINTMENT'
      '110681443=     WHERE T.G_APPOINTMENT = G.G_APPOINTMENT'
      '110681444=    ORDER BY T.G_OFFICIAL, T.FM, T.NM, T.FT'
      '110681445=    INTO :G_OFFICIAL,'
      '110681446=        :FM,'
      '110681447=        :NM,'
      '110681448=        :FT,'
      '110681449=        :FIO,'
      '110681450=        :FIO_DOC,'
      '110681451=        :RNN,'
      '110681452=        :IDN,'
      '110681453=        :DT,'
      '110681454=        :G_ID_KIND,'
      '110681455=        :ID_NUM,'
      '110681456=        :ID_DATE,'
      '110681457=        :ID_ISSUER,'
      '110681458=        :G_APPOINTMENT,'
      '110681459=        :IS_RUKOVODITEL,'
      '110681460=        :IS_GLAVBUH,'
      '110681461=        :APP_NAME'
      '110681462=        ,:PASS'
      '110681463=    DO'
      '110681464=      SUSPEND;'
      '110681465=end'
      '110681466=;'
      '110681467='
      '110681468=ALTER PROCEDURE G_UPD_G_OFFICIAL('
      '110681469=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110681470=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110681471=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110681472=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110681473=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110681474=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110681475=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110681476=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110681477=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110681478=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110681479=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110681480=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110681481=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110681482=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110681483=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110681484=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110681485=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110681486=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110681487=  RIGHTS_ARR_ VARCHAR(500),'
      
        '110681488=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.G_OFFIC' +
        'IAL,'
      '110681489=  KOD_ TYPE OF COLUMN G_OFFICIAL.KOD)'
      '110681490=RETURNS ('
      '110681491=  ERR_CODE INTEGER,'
      '110681492=  ERR_MSG VARCHAR(1024))'
      '110681493=AS'
      
        '110681494=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110681495=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110681496=BEGIN'
      
        '110681497=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110681498=      UPDATE G_OFFICIAL G'
      '110681499=         SET G.IS_ISPOLNITEL = 0;'
      '110681500='
      
        '110681501=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110681502=      UPDATE G_OFFICIAL G'
      '110681503=         SET G.IS_RUKOVODITEL = 0;'
      '110681504='
      
        '110681505=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110681506=      UPDATE G_OFFICIAL G'
      '110681507=         SET G.IS_GLAVBUH = 0;'
      '110681508='
      '110681509=    update G_OFFICIAL'
      '110681510=    set FM = :FM_,'
      '110681511=        NM = :NM_,'
      '110681512=        FT = :FT_,'
      '110681513=        FIO_DOC = :FIO_DOC_,'
      '110681514=        RNN = :RNN_,'
      '110681515=        IDN = :IDN_,'
      '110681516=        DT = :DT_,'
      '110681517=        G_ID_KIND = :G_ID_KIND_,'
      '110681518=        ID_NUM = :ID_NUM_,'
      '110681519=        ID_DATE = :ID_DATE_,'
      '110681520=        ID_ISSUER = :ID_ISSUER_,'
      '110681521=        G_APPOINTMENT = :G_APPOINTMENT_,'
      '110681522=        IS_RUKOVODITEL = :IS_RUKOVODITEL_,'
      '110681523=        IS_GLAVBUH = :IS_GLAVBUH_,'
      '110681524=        IS_ISPOLNITEL = :IS_ISPOLNITEL_,'
      '110681525=        PASS = :PASSWORD_,'
      '110681526=        G_TOCHKA = :G_TOCHKA_,'
      '110681527=        DO_NOT_SALES_COMM = :DO_NOT_SALES_COMM_,'
      '110681528=        KOD = :KOD_'
      '110681529=    where (G_OFFICIAL = :G_OFFICIAL_);'
      '110681530='
      
        '110681531=    DELETE FROM G_OFFICIAL_RIGHT WHERE G_OFFICIAL = :G' +
        '_OFFICIAL_;'
      '110681532=    FOR SELECT T.RIGHTS_ITEM'
      '110681533=        FROM RIGHTS_ITEM T'
      '110681534=       WHERE T.IS_CATEGORY = 0'
      
        '110681535=         AND :RIGHTS_ARR_ CONTAINING '#39'-'#39'||T.RIGHTS_ITE' +
        'M||'#39'-'#39
      '110681536=        INTO :RIGHTS_ITEM_'
      '110681537=    DO BEGIN'
      
        '110681538=        INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT' +
        ', RIGHTS_ITEM, G_OFFICIAL)'
      
        '110681539=        VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGH' +
        'TS_ITEM_, :G_OFFICIAL_);'
      '110681540=    END'
      '110681541='
      
        '110681542=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110681543=    SELECT COUNT(G.G_OFFICIAL)'
      '110681544=      FROM G_OFFICIAL G'
      '110681545=     WHERE EXISTS (SELECT 1'
      '110681546=                     FROM G_OFFICIAL_RIGHT R'
      '110681547=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110681548=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110681549=    INTO :CNT_;'
      '110681550='
      '110681551=    IF (:CNT_ = 0) THEN BEGIN'
      '110681552=      ERR_CODE = -20500;'
      
        '110681553=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1086#1073#1093#1086#1076 +
        #1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087#1088 +
        #1072#1074#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110681554=      EXIT;'
      '110681555=    END'
      '110681556=end'
      '110681557=;'
      '110681558='
      '110681559=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110681560=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110681561=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110681562=  ARTICUL_ VARCHAR(30),'
      '110681563=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110681564=  BARCODE_ VARCHAR(30),'
      '110681565=  NAME_ VARCHAR(500),'
      '110681566=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110681567=  PRICE_ NUMERIC(15,2),'
      '110681568=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110681569=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110681570=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110681571=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110681572=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110681573=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110681574=  IS_CATEGORY_ INTEGER,'
      '110681575=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110681576=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110681577=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110681578=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110681579=RETURNS ('
      '110681580=  ERR_CODE INTEGER,'
      '110681581=  ERR_MSG VARCHAR(1024))'
      '110681582=AS'
      
        '110681583=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODU' +
        'CT'#39';'
      '110681584=DECLARE VARIABLE N_CURR_ INTEGER;'
      '110681585=DECLARE VARIABLE N INTEGER;'
      '110681586=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110681587=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110681588=begin'
      
        '110681589=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110681590=    SELECT COUNT(*)'
      '110681591=      FROM G_PRODUCT G'
      '110681592=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '110681593=       AND TRIM(G.ARTICUL) <> '#39#39
      '110681594=       AND TRIM(:ARTICUL_) <> '#39#39
      '110681595=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110681596=       AND G.IS_ACTIVE = 1'
      '110681597=      INTO :CNT_;'
      '110681598='
      '110681599=    IF (CNT_ > 0) THEN BEGIN'
      '110681600=      ERR_CODE = -20500;'
      
        '110681601=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077 +
        ' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '110681602=      EXIT;'
      '110681603=    END'
      '110681604='
      '110681605=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110681606=    SELECT COUNT(*)'
      '110681607=      FROM G_PRODUCT G'
      
        '110681608=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOME' +
        'NCLATUR_NUM_))'
      '110681609=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110681610=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '110681611=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110681612=       AND G.IS_ACTIVE = 1'
      '110681613=    INTO :CNT_;'
      '110681614=    IF (CNT_ > 0) THEN BEGIN'
      '110681615=      ERR_CODE = -20500;'
      
        '110681616=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLA' +
        'TUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '110681617=      EXIT;'
      '110681618=    END'
      '110681619='
      '110681620=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110681621=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110681622=        SELECT COUNT(*)'
      '110681623=          FROM G_PRODUCT G'
      
        '110681624=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110681625=           AND TRIM(G.BARCODE) <> '#39#39
      '110681626=           AND TRIM(:BARCODE_) <> '#39#39
      '110681627=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '110681628=           AND G.IS_ACTIVE = 1'
      '110681629=          INTO :CNT_;'
      '110681630='
      '110681631=        IF (CNT_ = 0) then'
      '110681632=          SELECT COUNT(*)'
      '110681633=            FROM G_PRODUCT G, LT_BARCODE L'
      '110681634=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110681635=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110681636=             AND TRIM(L.BARCODE) <> '#39#39
      '110681637=             AND G.IS_ACTIVE = 1'
      '110681638=            INTO :CNT_;'
      '110681639='
      '110681640=        IF (CNT_ > 0) THEN BEGIN'
      '110681641=          ERR_CODE = -20500;'
      
        '110681642=          ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_' +
        '||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '110681643=          EXIT;'
      '110681644=        END'
      '110681645=    END'
      '110681646='
      '110681647=    update G_PRODUCT'
      '110681648=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110681649=        ARTICUL = :ARTICUL_,'
      '110681650=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110681651=        BARCODE = :BARCODE_,'
      '110681652=        NAME = :NAME_,'
      '110681653=        G_UNIT = :G_UNIT_,'
      '110681654=        PRICE = :PRICE_,'
      '110681655=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110681656=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110681657=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110681658=        NOTE         = :NOTE_,'
      '110681659=        CROSSCODE    = :CROSSCODE_,'
      '110681660=        IS_KIT       = :IS_KIT_,'
      '110681661=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110681662=        PLACE        = :PLACE_,'
      '110681663=        SALES_COMM   = :SALES_COMM_,'
      '110681664=        KOD_TNVD     = :KOD_TNVD_'
      '110681665=    where (G_PRODUCT = :G_PRODUCT_);'
      '110681666='
      '110681667=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110681668=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110681669='
      '110681670=        INSERT INTO LT_BARCODE'
      
        '110681671=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110681672='
      '110681673=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110681674=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110681675=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110681676='
      
        '110681677=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110681678=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110681679='
      '110681680=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110681681=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110681682=            INSERT INTO G_PRODUCT_KIT'
      
        '110681683=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110681684=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110681685=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110681686=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110681687='
      
        '110681688=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110681689=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110681690='
      '110681691=            UPDATE G_PRODUCT_KIT G'
      
        '110681692=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110681693=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110681694=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110681695=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110681696='
      
        '110681697=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110681698=            if (is_kit_ = 1) then begin'
      '110681699=                SELECT MIN(L.AMOUNT)'
      '110681700=                  FROM G_PRODUCT_KIT K,'
      '110681701=                       LT_SKLAD_PRODUCT L'
      '110681702=                 WHERE K.g_product = :G_PRODUCT_'
      '110681703=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110681704=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110681705=                 GROUP BY K.G_PRODUCT'
      '110681706=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110681707='
      '110681708=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110681709=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110681710=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110681711=            end'
      '110681712=        END'
      '110681713=    END'
      '110681714=end'
      '110681715=;'
      '110681716='
      '110681717=ALTER PROCEDURE LOG_DEINIT'
      '110681718=AS'
      '110681719=DECLARE VARIABLE TN VARCHAR(64);'
      '110681720=DECLARE VARIABLE SQL BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110681721=/**/'
      '110681722=BEGIN'
      '110681723='
      '110681724=  FOR SELECT RDB$TRIGGER_NAME'
      '110681725=        FROM RDB$TRIGGERS'
      '110681726=       WHERE RDB$SYSTEM_FLAG = 0'
      
        '110681727=         AND RDB$TRIGGER_NAME NOT IN ('#39'IBE$TODO_ITEM_I' +
        'D_BI'#39', '#39'LT_SKLAD_PRODUCT_BU0'#39', '#39'PRODUCT_AMOUNT_AI0'#39', '#39'PRODUCT_AM' +
        'OUNT_BI0'#39')'
      '110681728=        INTO :TN'
      '110681729=  DO BEGIN'
      '110681730=    SQL = '#39'DROP TRIGGER '#39'||TN||'#39';'#39';'
      '110681731=      execute statement :SQL;'
      '110681732=  END'
      '110681733=END'
      '110681734=;'
      '110681735='
      '110681736=ALTER PROCEDURE LOG_INIT'
      '110681737=AS'
      '110681738=DECLARE VARIABLE TN VARCHAR(64);'
      '110681739=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110681740=DECLARE VARIABLE FN VARCHAR(64);'
      '110681741=DECLARE VARIABLE TP INTEGER;'
      
        '110681742=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110681743=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110681744=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110681745=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110681746=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110681747=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110681748=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110681749=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      '110681750=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110681751=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110681752=DECLARE VARIABLE ANZ INTEGER;'
      '110681753=DECLARE VARIABLE L INTEGER;'
      '110681754=DECLARE VARIABLE P INTEGER;'
      '110681755=DECLARE VARIABLE S INTEGER;'
      '110681756=DECLARE VARIABLE FT CHAR(1);'
      '110681757=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110681758=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110681759=BEGIN'
      '110681760=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110681761='
      '110681762=  TN_ALT='#39#39';'
      '110681763=  TRGI='#39#39';'
      '110681764=  TRGU='#39#39';'
      '110681765=  TRGD='#39#39';'
      '110681766=  TRGIX='#39#39';'
      '110681767=  TRGUX='#39#39';'
      '110681768=  TRGDX='#39#39';'
      '110681769=  SQLF='#39#39';'
      '110681770=  SQLV='#39#39';'
      '110681771=  SQLU='#39#39';'
      '110681772=  FT='#39#39';'
      '110681773='
      '110681774=  FOR SELECT R.RDB$RELATION_NAME,'
      '110681775=            R.RDB$FIELD_NAME,'
      '110681776=            F.RDB$FIELD_TYPE,'
      '110681777=            F.RDB$FIELD_LENGTH,'
      '110681778=            F.RDB$FIELD_PRECISION,'
      '110681779=            F.RDB$FIELD_SCALE'
      '110681780=        FROM RDB$RELATION_FIELDS R,'
      '110681781=             RDB$FIELDS F'
      '110681782=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110681783=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110681784=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110681785=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110681786=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110681787=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110681788=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110681789=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110681790=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110681791=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39')'
      '110681792=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110681793=              OR'
      
        '110681794=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110681795=             )'
      
        '110681796=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110681797=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110681798=  DO BEGIN'
      '110681799=    TN=TRIM(TN);'
      '110681800=    FN=TRIM(FN);'
      '110681801='
      '110681802=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110681803=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110681804=      EXECUTE STATEMENT TRGI;'
      '110681805=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110681806=      EXECUTE STATEMENT TRGU;'
      '110681807=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110681808=      EXECUTE STATEMENT TRGD;'
      '110681809='
      '110681810=      SQLF='#39#39';'
      '110681811=      SQLV='#39#39';'
      '110681812=      SQLU='#39#39';'
      '110681813=    END'
      '110681814='
      '110681815=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110681816=      ID_COLUMN = FN;'
      '110681817='
      '110681818=    S=-S;'
      
        '110681819=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110681820=      ft='#39'N'#39';   --numerisch'
      '110681821=    else'
      '110681822=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110681823=        ft='#39'Z'#39';   --zeit'
      '110681824=      else'
      '110681825=        ft='#39'T'#39';'
      '110681826='
      '110681827='
      '110681828=    IF (SQLF='#39#39') THEN'
      '110681829=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110681830=    ELSE'
      '110681831=      SQLF=SQLF||'#39','#39'||FN;'
      '110681832='
      '110681833=    if (ft='#39'N'#39') then begin'
      '110681834=      IF (SQLV='#39#39') THEN'
      
        '110681835=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110681836=      ELSE'
      
        '110681837=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110681838='
      '110681839=      IF (SQLU='#39#39') THEN'
      
        '110681840=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110681841=      ELSE'
      
        '110681842=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110681843=    end'
      '110681844=    else'
      '110681845=      if (ft='#39'Z'#39') then begin'
      '110681846=        IF (SQLV='#39#39') THEN'
      
        '110681847=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110681848=        ELSE'
      
        '110681849=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110681850='
      '110681851=        IF (SQLU='#39#39') THEN'
      
        '110681852=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'U' +
        'PDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||' +
        'FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110681853=        ELSE'
      
        '110681854=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39 +
        '||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),' +
        #39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110681855=    end'
      '110681856=    else begin'
      '110681857=      IF (SQLV='#39#39') THEN'
      
        '110681858=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||TRIM' +
        '(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110681859=      ELSE'
      
        '110681860=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
