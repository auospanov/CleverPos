        #1051#1048#1062#1045' */'
      
        '110154182=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' ' +
        #1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '110154183=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110154184=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '110154185=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '110154186=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUMN' +
        ' G_PRODUCT.G_PRODUCT;'
      '110154187=BEGIN'
      '110154188=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '110154189='
      
        '110154190=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110154191=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110154192=    FROM ZAKAZ_DETAILS_TMP T'
      '110154193=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110154194=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110154195=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110154196='
      
        '110154197=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110154198=           ,G.IS_KIT'
      '110154199=           ,K.AMOUNT * :AMOUNT_'
      '110154200=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110154201=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      '110154202=           ,(CASE'
      
        '110154203=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE' +
        '_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * ' +
        'FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '110154204=             ELSE K.PRICE'
      '110154205=           END) COST_PRICE'
      
        '110154206=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_L' +
        'AST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '110154207=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE ' +
        'G_PRODUCT = :G_PRODUCT_) CNT'
      
        '110154208=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110154209=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110154210=       AND G.IS_KIT = 1'
      '110154211=    UNION'
      
        '110154212=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110154213=           ,G.IS_KIT'
      '110154214=           ,:AMOUNT_'
      '110154215=           ,:PRICE_'
      '110154216=           ,0'
      '110154217=           ,:COST_PRICE_'
      '110154218=           ,0'
      '110154219=      FROM G_PRODUCT G'
      '110154220=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110154221=       AND G.IS_KIT <> 1'
      '110154222=      INTO :G_PRODUCT_'
      '110154223=           ,:IS_KIT_'
      '110154224=           ,:AMOUNT_'
      '110154225=           ,:PRICE__'
      '110154226=           ,:SOSTAV_PRICE_'
      '110154227=           ,:COST_PRICE__'
      '110154228=           ,:SOSTAV_COUNT_'
      '110154229=  DO BEGIN'
      '110154230=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110154231='
      
        '110154232=      --==============================================' +
        '============='
      '110154233=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110154234=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110154235=        FROM LT_SKLAD_PRODUCT L'
      '110154236=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110154237=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110154238=       INTO :AMOUNT_CUR_;'
      '110154239='
      
        '110154240=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110154241=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110154242=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110154243=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051 +
        #1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068 +
        #1050#1054
      
        '110154244=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068 +
        ' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110154245=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110154246=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110154247=          SELECT SUM(AMOUNT)'
      '110154248=            FROM ZAKAZ_DETAILS T'
      '110154249=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110154250=             AND T.ZAKAZ = :ZAKAZ_'
      '110154251=            INTO :AMOUNT_OLD_;'
      '110154252=        ELSE'
      '110154253=          SELECT SUM(AMOUNT)'
      '110154254=            FROM SKLAD T'
      '110154255=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110154256=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110154257=            INTO :AMOUNT_OLD_;'
      '110154258=      END'
      '110154259='
      '110154260=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110154261=      SELECT SUM(AMOUNT)'
      '110154262=        FROM ZAKAZ_DETAILS_TMP T'
      '110154263=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110154264=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110154265='
      
        '110154266=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_, ' +
        '0) + :AMOUNT_;'
      '110154267=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '110154268='
      
        '110154269=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110154270='
      
        '110154271=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '110154272=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042 +
        #1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110154273=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) T' +
        'HEN BEGIN'
      '110154274=            PNT_ = '#39'01'#39';'
      
        '110154275=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FR' +
        'OM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      '110154276=                                         CURRENT_DATE,'
      '110154277=                                         :G_PRODUCT_,'
      
        '110154278=                                         ABS(AMOUNT_CU' +
        'R_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUN' +
        'T_,'
      
        '110154279=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086 +
        ' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110154280=                                         )'
      
        '110154281=                RETURNING_VALUES :SKLAD_, :COST_PRICE_' +
        '_, :ERR_CODE, :ERR_MSG;'
      '110154282=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110154283=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110154284=              EXIT;'
      '110154285=            END'
      '110154286=        END'
      
        '110154287=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_PR' +
        'ODUCT_ <> -2) THEN BEGIN'
      '110154288=            SELECT NAME'
      '110154289=            FROM G_PRODUCT'
      '110154290=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110154291=            INTO :PRODUCT_NAME_;'
      '110154292='
      '110154293=            ERR_CODE = -20500;'
      
        '110154294=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110154295=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110154296=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110154297=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110154298=            EXIT;'
      '110154299=        END'
      '110154300=      END'
      '110154301=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110154302=      --==============================================' +
        '============='
      '110154303='
      
        '110154304=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110154305=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110154306='
      '110154307=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '110154308=        --    PRICE__ = SOSTAV_PRICE_;'
      '110154309=        --END ELSE BEGIN'
      '110154310=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110154311=              PRICE__ = COST_PRICE__;'
      '110154312='
      
        '110154313=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110154314=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110154315='
      '110154316='
      
        '110154317=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110154318=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110154319=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110154320=            END'
      '110154321='
      
        '110154322=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110154323=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110154324=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110154325=        --END'
      '110154326=      END'
      '110154327='
      
        '110154328=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '110154329=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041#1048 +
        #1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '110154330=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_CODE' +
        '_) = 0) THEN'
      '110154331=          SELECT ZD.zakaz_details'
      '110154332=            FROM zakaz_details_tmp ZD'
      '110154333=           WHERE ZD.G_PRODUCT = :g_product_'
      '110154334=             AND ZD.PRICE = :PRICE__'
      '110154335=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110154336=            INTO :ZAKAZ_DTLS_TMP_;'
      '110154337='
      '110154338='
      '110154339=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110154340=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110154341=           SET P.amount = P.amount + :amount_'
      
        '110154342=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110154343=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110154344=               ,P.NDS = :NDS_'
      '110154345=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110154346=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110154347='
      '110154348=      ELSE BEGIN'
      
        '110154349=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN ' +
        'BEGIN'
      '110154350=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_;'
      '110154351=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '110154352=          END'
      '110154353='
      '110154354=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110154355=          ('
      '110154356=           ZAKAZ_DETAILS,'
      '110154357=           ZAKAZ,'
      '110154358=           G_PRODUCT,'
      '110154359=           AMOUNT,'
      '110154360=           PRICE,'
      '110154361=           SUMM,'
      '110154362=           DISCOUNT_PERC,'
      '110154363=           DISCOUNT_TENGE,'
      '110154364=           DISCOUNT_SUMM,'
      '110154365=           NDS,'
      '110154366=           NDS_SUMM,'
      '110154367=           COST_PRICE,'
      '110154368=           MARK_CODE,'
      '110154369=           ORIGINAL_KIT_ID,'
      '110154370=           ORIGINAL_KIT_PRICE'
      '110154371=          ) VALUES ('
      '110154372=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110154373=           :ZAKAZ_,'
      '110154374=           :G_PRODUCT_,'
      '110154375=           :AMOUNT_,'
      '110154376=           :PRICE__,'
      '110154377=           :SUMM_,'
      '110154378=           :DISCOUNT_PERC_,'
      '110154379=           :DISCOUNT_TENGE_,'
      '110154380=           :DISCOUNT_SUMM_,'
      '110154381=           :NDS_,'
      '110154382=           :NDS_SUMM_,'
      '110154383=           :COST_PRICE__,'
      '110154384=           :MARK_CODE_,'
      '110154385=           :ORIGINAL_KIT_ID_,'
      '110154386=           :ORIGINAL_KIT_PRICE_'
      '110154387=          )'
      '110154388=          RETURNING'
      '110154389=            ZAKAZ_DETAILS'
      '110154390=          INTO'
      '110154391=            :ZAKAZ_DETAILS_;'
      '110154392=      END'
      '110154393=  END'
      '110154394=end'
      '110154395=;'
      '110154396='
      '110154397=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '110154398=RETURNS ('
      
        '110154399=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '110154400=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '110154401=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT' +
        ','
      '110154402=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110154403=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110154404=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110154405=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_PERC,'
      
        '110154406=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_TENGE,'
      
        '110154407=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_SUMM,'
      '110154408=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '110154409=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '110154410=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110154411=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110154412=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110154413=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110154414=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PRI' +
        'CE,'
      '110154415=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110154416=  IS_MARKED INTEGER,'
      
        '110154417=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TMP' +
        '.SUMM,'
      
        '110154418=  ORIGINAL_KIT_ID TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ORI' +
        'GINAL_KIT_ID,'
      
        '110154419=  ORIGINAL_KIT_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.' +
        'ORIGINAL_KIT_PRICE)'
      '110154420=AS'
      '110154421=begin'
      '110154422='
      '110154423=  FOR'
      '110154424=    SELECT T.ZAKAZ_DETAILS,'
      '110154425=           T.ZAKAZ,'
      '110154426=           T.G_PRODUCT,'
      '110154427=           T.AMOUNT,'
      '110154428=           T.PRICE,'
      '110154429=           T.SUMM,'
      '110154430=           T.DISCOUNT_PERC,'
      '110154431=           T.DISCOUNT_TENGE,'
      '110154432=           T.DISCOUNT_SUMM,'
      '110154433=           T.NDS,'
      '110154434=           T.NDS_SUMM,'
      '110154435=           P.NAME PRODUCT_NAME'
      '110154436=           ,P.BARCODE'
      '110154437=           ,P.ARTICUL'
      '110154438=           ,P.PRICE'
      '110154439=           ,P.IS_KIT'
      
        '110154440=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_TM' +
        'P TM, G_PRODUCT GP'
      
        '110154441=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.DO' +
        '_NOT_CHARGE_BONUS = 0)'
      '110154442=           ,T.COST_PRICE'
      '110154443=           ,P.IS_MARKED'
      '110154444=           ,T.ORIGINAL_KIT_ID'
      '110154445=           ,T.ORIGINAL_KIT_PRICE'
      '110154446=      FROM ZAKAZ_DETAILS_TMP T,'
      '110154447=           G_PRODUCT P'
      '110154448=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110154449=    ORDER BY t.ZAKAZ_DETAILS'
      '110154450=    INTO :ZAKAZ_DETAILS,'
      '110154451=          :ZAKAZ,'
      '110154452=          :G_PRODUCT,'
      '110154453=          :AMOUNT,'
      '110154454=          :PRICE,'
      '110154455=          :SUMM,'
      '110154456=          :DISCOUNT_PERC,'
      '110154457=          :DISCOUNT_TENGE,'
      '110154458=          :DISCOUNT_SUMM,'
      '110154459=          :NDS,'
      '110154460=          :NDS_SUMM,'
      '110154461=          :PRODUCT_NAME'
      '110154462=          ,:BARCODE'
      '110154463=          ,:ARTICUL'
      '110154464=          ,:PRODUCT_PRICE'
      '110154465=          ,:IS_KIT'
      '110154466=          ,:SUM_TO_CHARGE_BONUS'
      '110154467=          ,:COST_PRICE'
      '110154468=          ,:IS_MARKED'
      '110154469=          ,:ORIGINAL_KIT_ID'
      '110154470=          ,:ORIGINAL_KIT_PRICE'
      '110154471=  DO'
      '110154472=    suspend;'
      '110154473=end'
      '110154474=;'
      '110154475='
      '110154476='
      
        '110154477=UPDATE SYSTEM_SETUP SET S_VALUE = 110154 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110154478=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110154479=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101550='
      '1101551=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1101552=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101553=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1101554=  ARTICUL_ VARCHAR(30),'
      '1101555=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101556=  BARCODE_ VARCHAR(30),'
      '1101557=  NAME_ VARCHAR(500),'
      '1101558=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101559=  PRICE_ NUMERIC(15,2),'
      '11015510=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11015511=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11015512=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11015513=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11015514=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11015515=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11015516=  IS_CATEGORY_ INTEGER,'
      '11015517=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11015518=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11015519=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11015520=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '11015521=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '11015522=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT_' +
        'CHARGE_BONUS,'
      '11015523=  IS_MARKED_ INTEGER)'
      '11015524=RETURNS ('
      '11015525=  ERR_CODE INTEGER,'
      '11015526=  ERR_MSG VARCHAR(1024))'
      '11015527=AS'
      
        '11015528=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODUC' +
        'T'#39';'
      
        '11015529=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT;'
      '11015530=begin'
      
        '11015531=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11015532=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '11015533=                  FROM G_PRODUCT G'
      
        '11015534=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:A' +
        'RTICUL_))'
      '11015535=                   AND TRIM(G.ARTICUL) <> '#39#39
      '11015536=                   AND TRIM(:ARTICUL_) <> '#39#39
      '11015537=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11015538=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11015539=      ERR_CODE = -20500;'
      
        '11015540=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:ER' +
        'R_MSG);'
      '11015541=      EXIT;'
      '11015542=    END'
      '11015543='
      '11015544=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11015545=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11015546=                  FROM G_PRODUCT G'
      
        '11015547=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER' +
        '(TRIM(:NOMENCLATUR_NUM_))'
      '11015548=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '11015549=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '11015550=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11015551=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11015552=      ERR_CODE = -20500;'
      
        '11015553=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089' ' +
        #1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURN' +
        'ING_VALUES (:ERR_MSG);'
      '11015554=      EXIT;'
      '11015555=    END'
      '11015556='
      '11015557=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '11015558=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '11015559=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '11015560=                  FROM G_PRODUCT G'
      
        '11015561=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(:B' +
        'ARCODE_))'
      '11015562=                   AND TRIM(G.BARCODE) <> '#39#39
      '11015563=                   AND TRIM(:BARCODE_) <> '#39#39
      '11015564=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '11015565=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11015566=          ERR_CODE = -20500;'
      
        '11015567=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '11015568=          EXIT;'
      '11015569=        END'
      '11015570='
      '11015571=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '11015572=                    FROM G_PRODUCT G, LT_BARCODE L'
      '11015573=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11015574=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '11015575=                     AND TRIM(L.BARCODE) <> '#39#39
      '11015576=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '11015577=          ERR_CODE = -20500;'
      
        '11015578=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '11015579=          EXIT;'
      '11015580=        END'
      '11015581=    END'
      '11015582='
      '11015583=    update G_PRODUCT'
      '11015584=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '11015585=        ARTICUL = :ARTICUL_,'
      '11015586=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '11015587=        BARCODE = :BARCODE_,'
      '11015588=        NAME = :NAME_,'
      '11015589=        G_UNIT = :G_UNIT_,'
      '11015590=        PRICE = :PRICE_,'
      '11015591=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '11015592=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '11015593=        MF_COUNTRY   = :MF_COUNTRY_,'
      '11015594=        NOTE         = :NOTE_,'
      '11015595=        CROSSCODE    = :CROSSCODE_,'
      '11015596=        IS_KIT       = :IS_KIT_,'
      '11015597=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '11015598=        PLACE        = :PLACE_,'
      '11015599=        SALES_COMM   = :SALES_COMM_,'
      '110155100=        KOD_TNVD     = :KOD_TNVD_,'
      '110155101=        FAST_TOVAR   = :FAST_TOVAR_,'
      '110155102=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '110155103=        IS_MARKED    = :IS_MARKED_'
      '110155104=    where (G_PRODUCT = :G_PRODUCT_);'
      '110155105='
      '110155106=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110155107=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110155108='
      '110155109=        INSERT INTO LT_BARCODE'
      
        '110155110=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110155111='
      '110155112=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110155113=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110155114=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110155115='
      
        '110155116=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110155117=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110155118='
      '110155119=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110155120=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110155121=            /*INSERT INTO G_PRODUCT_KIT'
      
        '110155122=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110155123=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110155124=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110155125=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110155126='
      
        '110155127=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110155128=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110155129='
      '110155130=            UPDATE G_PRODUCT_KIT G'
      
        '110155131=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110155132=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110155133=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110155134=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110155135='
      
        '110155136=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' '#1074 +
        #1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '110155137=            */'
      
        '110155138=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PROD' +
        'UCT = :G_PRODUCT_;'
      '110155139=            INSERT INTO G_PRODUCT_KIT'
      
        '110155140=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '110155141=            FROM G_PRODUCT_KIT_TMP T;'
      '110155142='
      
        '110155143=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110155144=            if (is_kit_ = 1) then begin'
      
        '110155145=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110155146=                  FROM G_PRODUCT_KIT K,'
      '110155147=                       LT_SKLAD_PRODUCT L'
      '110155148=                 WHERE K.g_product = :G_PRODUCT_'
      '110155149=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110155150=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110155151=                 GROUP BY K.G_PRODUCT'
      '110155152=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110155153='
      '110155154=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110155155=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110155156=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110155157=            end'
      '110155158=        END'
      '110155159=    END'
      '110155160=end'
      '110155161=;'
      '110155162='
      '110155163='
      
        '110155164=UPDATE SYSTEM_SETUP SET S_VALUE = 110155 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110155165=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110155166=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101560='
      '1101561=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '1101562=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT */ BIGINT,'
      '1101563=  IS_SUPPLIER_ INTEGER = NULL)'
      '1101564=RETURNS ('
      
        '1101565=  G_CLIENT /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGINT' +
        ','
      
        '1101566=  G_CLIENT_PARENT /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT */ BIGINT,'
      
        '1101567=  G_CONTRAGENT /* TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT */ BIGINT,'
      '1101568=  NAME VARCHAR(500),'
      '1101569=  RNN VARCHAR(12),'
      '11015610=  IDN VARCHAR(12),'
      '11015611=  KBE VARCHAR(5),'
      
        '11015612=  PHONE /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
        ','
      '11015613=  SKIDKA NUMERIC(15,2),'
      '11015614=  IS_SUPPLIER INTEGER,'
      '11015615=  BY_DEFAULT INTEGER,'
      '11015616=  IS_BEZNAL INTEGER,'
      '11015617=  IS_SUPPLIER_STR VARCHAR(50),'
      
        '11015618=  SUPPL_AGENT_NAME /* TYPE OF COLUMN G_CONTRAGENT.SHORT' +
        '_NAME */ VARCHAR(250),'
      
        '11015619=  G_DISCONT_CARD /* TYPE OF COLUMN G_DISCONT_CARD.G_DIS' +
        'CONT_CARD */ BIGINT,'
      
        '11015620=  BARCODE /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '11015621=  N_PERCENT /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      
        '11015622=  SUMM /* TYPE OF COLUMN G_DISCONT_CARD.SUMM */ NUMERIC' +
        '(15,2),'
      
        '11015623=  SUMM_ALL /* TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL */' +
        ' NUMERIC(15,2),'
      '11015624=  NOTE /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200),'
      
        '11015625=  SUMM_DOLG /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERI' +
        'C(15,2),'
      '11015626=  NAME_WITH_DOLG VARCHAR(500),'
      
        '11015627=  G_PROMOTION_STR /* TYPE OF COLUMN G_PROMOTION.NAME */' +
        ' VARCHAR(150),'
      
        '11015628=  MAX_BONUS_PAY_SUMM /* TYPE OF COLUMN G_CLIENT.MAX_BON' +
        'US_PAY_SUMM */ NUMERIC(15,2))'
      '11015629=AS'
      '11015630=BEGIN'
      '11015631=  SUSPEND;'
      '11015632=END'
      '11015633=;'
      '11015634='
      '11015635='
      
        '11015636=/******************************************************' +
        '************************/'
      
        '11015637=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11015638=/******************************************************' +
        '************************/'
      '11015639=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '11015640=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      '11015641=  IS_SUPPLIER_ INTEGER = NULL)'
      '11015642=RETURNS ('
      '11015643=  G_CLIENT TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11015644=  G_CLIENT_PARENT TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      
        '11015645=  G_CONTRAGENT TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGENT' +
        ','
      '11015646=  NAME VARCHAR(500),'
      '11015647=  RNN VARCHAR(12),'
      '11015648=  IDN VARCHAR(12),'
      '11015649=  KBE VARCHAR(5),'
      '11015650=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '11015651=  SKIDKA NUMERIC(15,2),'
      '11015652=  IS_SUPPLIER INTEGER,'
      '11015653=  BY_DEFAULT INTEGER,'
      '11015654=  IS_BEZNAL INTEGER,'
      '11015655=  IS_SUPPLIER_STR VARCHAR(50),'
      
        '11015656=  SUPPL_AGENT_NAME TYPE OF COLUMN G_CONTRAGENT.SHORT_NA' +
        'ME,'
      
        '11015657=  G_DISCONT_CARD TYPE OF COLUMN G_DISCONT_CARD.G_DISCON' +
        'T_CARD,'
      '11015658=  BARCODE TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11015659=  N_PERCENT TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11015660=  SUMM TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '11015661=  SUMM_ALL TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '11015662=  NOTE TYPE OF COLUMN G_CLIENT.NOTE,'
      '11015663=  SUMM_DOLG TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11015664=  NAME_WITH_DOLG VARCHAR(500),'
      '11015665=  G_PROMOTION_STR TYPE OF COLUMN G_PROMOTION.NAME,'
      
        '11015666=  MAX_BONUS_PAY_SUMM TYPE OF COLUMN G_CLIENT.MAX_BONUS_' +
        'PAY_SUMM)'
      '11015667=AS'
      '11015668=begin'
      '11015669=  FOR'
      '11015670=    SELECT T.g_client,'
      '11015671=           T.g_client_parent,'
      '11015672=           T.g_contragent,'
      '11015673=           T.name,'
      '11015674=           T.rnn,'
      '11015675=           T.idn,'
      '11015676=           T.KBE,'
      '11015677=           T.PHONE,'
      '11015678=           T.SKIDKA,'
      '11015679=           T.is_supplier,'
      '11015680=           T.BY_DEFAULT,'
      '11015681=           T.IS_BEZNAL,'
      '11015682=           CASE T.is_supplier'
      '11015683=             WHEN 0 THEN '#39#1050#1083#1080#1077#1085#1090#39
      '11015684=             WHEN 1 THEN '#39#1055#1086#1089#1090#1072#1074#1097#1080#1082#39
      '11015685=           END IS_SUPPLIER_STR,'
      '11015686=           GC.SHORT_NAME,'
      '11015687=           COALESCE(D.G_DISCONT_CARD, 0),'
      '11015688=           D.BARCODE,'
      '11015689=           D.N_PERCENT,'
      '11015690=           D.SUMM,'
      '11015691=           D.SUMM_ALL,'
      '11015692=           T.NOTE'
      '11015693=           ,COALESCE(Z.SUMM_DOLG, 0)'
      
        '11015694=           ,T.name || COALESCE('#39' ('#1044#1054#1051#1043' '#39' || Z.SUMM_DOLG' +
        ' || '#39')'#39', '#39#39') NAME_WITH_DOLG'
      '11015695=           ,P.NAME NAME_PROMO'
      '11015696=           ,T.MAX_BONUS_PAY_SUMM'
      
        '11015697=    FROM g_client t LEFT OUTER JOIN G_DISCONT_CARD D ON' +
        ' T.G_CLIENT = D.G_CLIENT'
      
        '11015698=                    LEFT OUTER JOIN (SELECT SUM(SUMM - ' +
        'SUMM_FACT - SUMM_BONUS) SUMM_DOLG ,G_CLIENT FROM ZAKAZ WHERE IS_' +
        'PAYED_ALL = 0 GROUP BY G_CLIENT) Z ON T.G_CLIENT = Z.G_CLIENT'
      
        '11015699=                    LEFT OUTER JOIN G_PROMOTION P ON T.' +
        'g_promotion = P.g_promotion'
      '110156100=         ,G_CONTRAGENT GC'
      
        '110156101=   WHERE T.G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT' +
        '_, T.G_CLIENT_PARENT)  -- '#1048#1053#1054#1043#1044#1040' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      '110156102=     AND T.IS_CATEGORY = 0'
      '110156103=     AND T.G_CONTRAGENT = GC.G_CONTRAGENT'
      
        '110156104=     AND T.is_supplier = COALESCE(:IS_SUPPLIER_, T.IS_' +
        'SUPPLIER)'
      
        '110156105=     AND COALESCE(:G_CLIENT_PARENT_, 0) <> -1000      ' +
        '         -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110156106=   UNION ALL'
      '110156107=    SELECT T.G_TOCHKA g_client,'
      '110156108=           0 g_client_parent,'
      '110156109=           0 g_contragent,'
      '110156110=           T.name,'
      '110156111=           '#39#39' rnn,'
      '110156112=           '#39#39' idn,'
      '110156113=           '#39#39' KBE,'
      '110156114=           '#39#39' PHONE,'
      '110156115=           0 SKIDKA,'
      '110156116=           0 is_supplier,'
      '110156117=           0 BY_DEFAULT,'
      '110156118=           0 IS_BEZNAL,'
      '110156119=           '#39#1057#1082#1083#1072#1076#39' IS_SUPPLIER_STR,'
      '110156120=           '#39#39' SHORT_NAME,'
      '110156121=           0,'
      '110156122=           '#39#39' BARCODE,'
      '110156123=           0 N_PERCENT,'
      '110156124=           0 SUMM,'
      '110156125=           0 SUMM_ALL,'
      '110156126=           '#39#39' NOTE'
      '110156127=           ,0 SUMM_DOLG'
      '110156128=           ,'#39#39' NAME_WITH_DOLG'
      '110156129=           ,'#39#39' NAME_PROMO'
      '110156130=           ,0 MAX_BONUS_PAY_SUMM'
      '110156131=    FROM G_TOCHKA T'
      
        '110156132=   WHERE T.G_TOCHKA <> (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      
        '110156133=     AND COALESCE(:G_CLIENT_PARENT_, 0) = -1000       ' +
        '        -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110156134=   ORDER BY 4'
      
        '110156135=    into :G_CLIENT, :G_CLIENT_PARENT, :G_CONTRAGENT, :' +
        'NAME, :RNN, :IDN, :KBE, :PHONE, :SKIDKA, :IS_SUPPLIER, :BY_DEFAU' +
        'LT,'
      
        '110156136=         :IS_BEZNAL, :IS_SUPPLIER_STR, :SUPPL_AGENT_NA' +
        'ME,'
      '110156137=         :G_DISCONT_CARD,'
      '110156138=         :BARCODE,'
      '110156139=         :N_PERCENT,'
      '110156140=         :SUMM,'
      '110156141=         :SUMM_ALL, :NOTE'
      '110156142=         ,:SUMM_DOLG'
      '110156143=         ,:NAME_WITH_DOLG'
      '110156144=         ,:G_PROMOTION_STR'
      '110156145=         ,:MAX_BONUS_PAY_SUMM'
      '110156146=  DO'
      '110156147=    suspend;'
      '110156148=end'
      '110156149=;'
      '110156150='
      '110156151='
      
        '110156152=UPDATE SYSTEM_SETUP SET S_VALUE = 110156 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110156153=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110156154=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101570=CREATE PROCEDURE SMS_HISTORY_INS('
      
        '1101571=  DATETIME_ /* TYPE OF COLUMN SMS_HISTORY.DATETIME */ TI' +
        'MESTAMP,'
      
        '1101572=  G_CLIENT_ /* TYPE OF COLUMN SMS_HISTORY.G_CLIENT */ BI' +
        'GINT,'
      
        '1101573=  PHONE_NUMBER_ /* TYPE OF COLUMN SMS_HISTORY.PHONE_NUMB' +
        'ER */ VARCHAR(50),'
      
        '1101574=  TEXT_ /* TYPE OF COLUMN SMS_HISTORY.TEXT */ VARCHAR(50' +
        '0),'
      
        '1101575=  G_SMS_STATUS_ /* TYPE OF COLUMN SMS_HISTORY.G_SMS_STAT' +
        'US */ INTEGER,'
      
        '1101576=  SMS_ID_ /* TYPE OF COLUMN SMS_HISTORY.SMS_ID */ INTEGE' +
        'R,'
      '1101577=  ERROR_ /* TYPE OF COLUMN SMS_HISTORY.ERROR */ INTEGER)'
      '1101578=RETURNS ('
      
        '1101579=  SMS_HISTORY_ /* TYPE OF COLUMN SMS_HISTORY.SMS_HISTORY' +
        ' */ BIGINT)'
      '11015710=AS'
      '11015711=BEGIN'
      '11015712=  SUSPEND;'
      '11015713=END'
      '11015714=;'
      '11015715='
      '11015716=CREATE PROCEDURE SMS_RECIPIENTS_READ('
      '11015717=  DATE_ DATE,'
      '11015718=  SMS_HB_ENABLED_ INTEGER,'
      
        '11015719=  SMS_HB_TEXT_ /* TYPE OF COLUMN SMS_HISTORY.TEXT */ VA' +
        'RCHAR(500),'
      '11015720=  SMS_TRANSLIT_ INTEGER)'
      '11015721=RETURNS ('
      '11015722=  NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHAR(250),'
      
        '11015723=  PHONE /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
        ','
      
        '11015724=  G_CLIENT /* TYPE OF COLUMN SMS_HISTORY.G_CLIENT */ BI' +
        'GINT,'
      
        '11015725=  TEXT /* TYPE OF COLUMN SMS_HISTORY.TEXT */ VARCHAR(50' +
        '0),'
      '11015726=  TIME_TO_SEND VARCHAR(20))'
      '11015727=AS'
      '11015728=BEGIN'
      '11015729=  SUSPEND;'
      '11015730=END'
      '11015731=;'
      '11015732='
      '11015733='
      
        '11015734=/******************************************************' +
        '************************/'
      
        '11015735=/****                   Creating generators (sequences)' +
        '                    ****/'
      
        '11015736=/******************************************************' +
        '************************/'
      '11015737='
      '11015738=CREATE GENERATOR GEN_SMS_HISTORY;'
      '11015739='
      '11015740='
      
        '11015741=/******************************************************' +
        '************************/'
      
