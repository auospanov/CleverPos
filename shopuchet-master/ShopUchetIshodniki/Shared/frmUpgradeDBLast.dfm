      '110402368=            END'
      '110402369=        END'
      '110402370=  END'
      '110402371=end'
      '110402372='#39';'
      '110402373='
      
        '110402374=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        '('
      '110402375=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110402376=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
