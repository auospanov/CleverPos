        '4, 5, 6, 7, 8, 9 '#1047#1040#1053#1071#1058#1067' '#1042' '#1055#1056#1045#1044#1067#1044#1059#1065#1048#1061' '#1057#1045#1051#1045#1050#1058#1040#1061
      '110248242=                 SP.DATE_RECEIPT DATE_SORT,'
