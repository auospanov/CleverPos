        'OD_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '1104810379='
      
        '1104810380=    STR_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DA' +
        'TE_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN' +
        '_), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '1104810381=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')|' +
        '|'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EX' +
        'TRACT(YEAR FROM DATE_END_);'
      '1104810382='
      '1104810383=  FOR'
      '1104810384=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '1104810385=           DECODE(T.IS_HEAD,'
      '1104810386=                  0, T.NAME,'
      '1104810387=                  1, T.NAME,'
      '1104810388=                  2, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39','
      '1104810389=                  3, '#39#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39#39'),'
      '1104810390=           G.ARTICUL,'
      '1104810391=           G.BARCODE,'
      '1104810392=           T.AMOUNT_IN,'
      '1104810393=           T.AMOUNT_PRIHOD,'
      '1104810394=           T.SUMM_PRIHOD,'
      '1104810395=           T.AMOUNT_UHOD,'
      '1104810396=           T.SUMM_UHOD,'
      '1104810397=           T.AMOUNT_SPISANO,'
      '1104810398=           T.SUMM_SPISANO,'
      '1104810399=           T.AMOUNT_VOZVRAT,'
      '1104810400=           T.SUMM_VOZVRAT,'
      '1104810401=           T.AMOUNT_PRIHOD_SKL,'
      '1104810402=           T.SUMM_PRIHOD_SKL,'
      '1104810403=           T.AMOUNT_UHOD_SKL,'
      '1104810404=           T.SUMM_UHOD_SKL,'
      '1104810405=           T.AMOUNT_OUT,'
      '1104810406=           T.IS_HEAD'
      
        '1104810407=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1104810408=     ORDER BY 1'
      '1104810409=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1104810410=       :NAME,'
      '1104810411=       :ARTICUL,'
      '1104810412=       :BARCODE,'
      '1104810413=       :AMOUNT_IN,'
      '1104810414=       :AMOUNT_PRIHOD,'
      '1104810415=       :SUMM_PRIHOD,'
      '1104810416=       :AMOUNT_UHOD,'
      '1104810417=       :SUMM_UHOD,'
      '1104810418=       :AMOUNT_SPISANO,'
      '1104810419=       :SUMM_SPISANO,'
      '1104810420=       :AMOUNT_VOZVRAT,'
      '1104810421=       :SUMM_VOZVRAT,'
      '1104810422=       :AMOUNT_PRIHOD_SKL,'
      '1104810423=       :SUMM_PRIHOD_SKL,'
      '1104810424=       :AMOUNT_UHOD_SKL,'
      '1104810425=       :SUMM_UHOD_SKL,'
      '1104810426=       :AMOUNT_OUT,'
      '1104810427=       :IS_HEAD'
      '1104810428=  DO SUSPEND;'
      '1104810429='
      '1104810430=WHEN ANY DO BEGIN'
      '1104810431=    Err_code = -20500;'
      
        '1104810432=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' ' +
        #1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1104810433=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||E' +
        'RR_MSG;'
      '1104810434=  END'
      '1104810435=end'
      '1104810436='#39';'
      '1104810437=END  --END_EXECUTE_BLOCK'
      '1104810438=EXECUTE BLOCK AS BEGIN'
      '1104810439='
      '1104810440=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRICE_LIST('
      '1104810441=  G_CATEGORY_ VARCHAR(2000),'
      '1104810442=  INCLUDE_NOL_ INTEGER,'
      '1104810443=  INCLUDE_FEW_ INTEGER,'
      '1104810444=  SORT_BY_NAME_ INTEGER,'
      '1104810445=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1104810446=  G_TOCHKA_ARR_ VARCHAR(1000) = '#39#39#39#39')'
      '1104810447=RETURNS ('
      '1104810448=  PERIOD_ VARCHAR(40),'
      '1104810449=  ROW_NUM VARCHAR(15),'
      '1104810450=  ARTICUL VARCHAR(1000),'
      '1104810451=  BARCODE VARCHAR(30),'
      
        '1104810452=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1104810453=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1104810454=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1104810455=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1104810456=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1104810457=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1104810458=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1104810459=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      '1104810460=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1104810461=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1104810462=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1104810463=  TOVAR_NAME VARCHAR(250),'
      '1104810464=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1104810465=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1104810466=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1104810467=  ERR_CODE INTEGER,'
      '1104810468=  ERR_MSG VARCHAR(1024))'
      '1104810469=AS'
      
        '1104810470=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRICE' +
        '_LIST'#39#39';'
      '1104810471=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1104810472=DECLARE VARIABLE I INTEGER = 1;'
      '1104810473=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1104810474=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1104810475=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1104810476=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1104810477=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1104810478=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1104810479=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1104810480=BEGIN'
      '1104810481='
      
        '1104810482=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1104810483=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1104810484='
      '1104810485=  SELECT S.S_VALUE'
      '1104810486=    FROM SYSTEM_SETUP S'
      '1104810487=   WHERE S.SYSTEM_SETUP = 1'
      '1104810488=    INTO :FORMULA_;'
      '1104810489='
      '1104810490=  FOR SELECT GP.PATH,'
      '1104810491=             GP.G_PRODUCT'
      '1104810492=        FROM P_REP_TREE GP'
      '1104810493=       WHERE EXISTS (SELECT 1'
      '1104810494=                       FROM G_PRODUCT'
      '1104810495=                      WHERE IS_CATEGORY = 0'
      
        '1104810496=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1104810497=                    )'
      
        '1104810498=         AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||GP.G_PR' +
        'ODUCT||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1104810499=              OR'
      '1104810500=              (:G_CATEGORY_ is NULL)'
      '1104810501=             )'
      '1104810502=       ORDER BY 1, 2'
      '1104810503=       INTO :PATH_NAME_,'
      '1104810504=            :G_PRODUCT_'
      '1104810505=  DO BEGIN'
      
        '1104810506=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1104810507=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1104810508=      SELECT COUNT(G.G_PRODUCT)'
      
        '1104810509=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1104810510=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39#39'-'#39#39'||LL.G_TOCHKA||'#39#39'-'#39#39' GROUP BY LL.G_PRO' +
        'DUCT) L ON G.G_PRODUCT = L.G_PRODUCT'
      '1104810511=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1104810512=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1104810513=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1104810514=              OR'
      
        '1104810515=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1104810516=              or'
      
        '1104810517=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1104810518=             )'
      '1104810519=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1104810520=         AND ((EXISTS (SELECT 1'
      '1104810521=                       FROM SKLAD S'
      '1104810522=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1104810523=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1104810524=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1104810525=              OR'
      '1104810526=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1104810527=        INTO :CNT_;'
      '1104810528='
      '1104810529=      IF (CNT_ > 0) THEN BEGIN'
      
        '1104810530=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1104810531=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1104810532='
      
        '1104810533=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1104810534=                                              ARTICUL' +
        ','
      
        '1104810535=                                              BARCODE' +
        ','
      
        '1104810536=                                              NOMENCL' +
        'ATUR_NUM,'
      '1104810537=                                              NAME,'
      
        '1104810538=                                              UNIT_NA' +
        'ME,'
      '1104810539=                                              PRICE,'
      
        '1104810540=                                              VOLUME_' +
        'PRICE,'
      
        '1104810541=                                              SKIDKA_' +
        'PRICE,'
      '1104810542=                                              AMOUNT,'
      
        '1104810543=                                              AMOUNT_' +
        'RESERVE,'
      '1104810544=                                              SUMM,'
      
        '1104810545=                                              PRICE_S' +
        'ELF,'
      
        '1104810546=                                              SORT_CO' +
        'L,'
      
        '1104810547=                                              IS_CATE' +
        'GORY,'
      '1104810548=                                              NOTE,'
      
        '1104810549=                                              CROSSCO' +
        'DE)'
      
        '1104810550=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1104810551=                 G.ARTICUL,'
      '1104810552=                 G.BARCODE,'
      '1104810553=                 G.NOMENCLATUR_NUM,'
      '1104810554=                 G.NAME,'
      '1104810555=                 U.SHORT_NAME,'
      '1104810556=                 G.PRICE,'
      '1104810557=                 G.VOLUME_PRICE,'
      '1104810558=                 G.PRICE - GD.SKIDKA_SUM,'
      '1104810559=                 COALESCE(S.AMOUNT, 0),'
      '1104810560=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      '1104810561=                 COALESCE(S.AMOUNT, 0) * G.PRICE,'
      '1104810562=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1104810563=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1104810564=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1104810565=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '1104810566=                  DECODE(:FORMULA_,'
      '1104810567=                         0,'
      
        '1104810568=                         (SELECT ROUND(SUM(T.AMOUNT *' +
        ' T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '1104810569=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1104810570=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1104810571=                                         SKLAD S'
      
        '1104810572=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39#39'-'#39#39'||SP.G_TOCHKA||'#39#39'-'#39#39
      
        '1104810573=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1104810574=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1104810575=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1104810576=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1104810577=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC ROWS 1 TO 5) T),'
      '1104810578=                         1,'
      '1104810579=                         (SELECT S.PRICE'
      '1104810580=                            FROM SKLAD S'
      
        '1104810581=                           WHERE S.SKLAD = (SELECT MA' +
        'X(SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAS' +
        'T = 1'
      
        '1104810582=                                              FROM SK' +
        'LAD SS'
      
        '1104810583=                                             WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SS.G_TOCHKA||'#39#39'-'#39#39
      
        '1104810584=                                               AND SS' +
        '.G_PRODUCT = G.G_PRODUCT'
      
        '1104810585=                                               AND SS' +
        '.IS_LAST = 1)'
      '1104810586=                         ))), 0) spr,'
      
        '1104810587=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1104810588=                 0'
      '1104810589=                 ,G.NOTE'
      
        '1104810590=                 ,REPLACE(G.CROSSCODE, '#39#39'~'#39#39', '#39#39','#39#39') ' +
        'CROSSCODE'
      
        '1104810591=            FROM G_PRODUCT G LEFT OUTER JOIN G_DISCOU' +
        'NT GD ON G.G_PRODUCT = GD.G_PRODUCT'
      
        '1104810592=                             LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1104810593=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1104810594=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||LL.G_TOCHKA||'#39#39'-'#39#39' GROUP BY LL.G' +
        '_PRODUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1104810595=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1104810596=             AND G.IS_CATEGORY = 0'
      '1104810597=             AND G.is_active = 1'
      '1104810598=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1104810599=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1104810600=                  OR'
      
        '1104810601=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1104810602=                  or'
      
        '1104810603=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1104810604=                 )'
      '1104810605=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1104810606=             AND ((EXISTS (SELECT 1'
      '1104810607=                           FROM SKLAD S'
      
        '1104810608=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1104810609=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1104810610=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1104810611=                  OR'
      '1104810612=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1104810613=           ORDER BY 14;'
      '1104810614=      END'
      '1104810615=  END'
      '1104810616='
      
        '1104810617=  PERIOD_ = '#39#39#1053#1072' '#1076#1072#1090#1091' '#39#39'||lpad(EXTRACT(DAY FROM CURRE' +
        'NT_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE' +
        '), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1104810618='
      
        '1104810619=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKIDKA_PRI' +
        'CE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF,' +
        ' IS_CATEGORY,'
      '1104810620=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '1104810621=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1104810622=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE' +
        ', :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :' +
        'SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '1104810623=  DO BEGIN'
      '1104810624=    I = I + 1;'
      '1104810625=    SUSPEND;'
      '1104810626=  END'
      '1104810627=WHEN ANY DO BEGIN'
      '1104810628=    Err_code = -20500;'
      
        '1104810629=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' ' +
        #1055#1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1104810630=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||E' +
        'RR_MSG;'
      '1104810631=  END'
      '1104810632=end'
      '1104810633='#39';'
      
        '1104810634=UPDATE SYSTEM_SETUP SET S_VALUE = 11048 WHERE SYSTEM_' +
        'SETUP = 3;'
      '1104810635=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110490=EXECUTE BLOCK AS BEGIN'
