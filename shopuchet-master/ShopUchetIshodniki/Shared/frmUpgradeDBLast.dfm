      '11015788=  IS_SUPPLIER INTEGER,'
      '11015789=  BY_DEFAULT INTEGER,'
      '11015790=  IS_BEZNAL INTEGER,'
      '11015791=  IS_SUPPLIER_STR VARCHAR(50),'
      
        '11015792=  SUPPL_AGENT_NAME /* TYPE OF COLUMN G_CONTRAGENT.SHORT' +
        '_NAME */ VARCHAR(250),'
      
        '11015793=  G_DISCONT_CARD /* TYPE OF COLUMN G_DISCONT_CARD.G_DIS' +
        'CONT_CARD */ BIGINT,'
      
        '11015794=  BARCODE /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '11015795=  N_PERCENT /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      
        '11015796=  SUMM /* TYPE OF COLUMN G_DISCONT_CARD.SUMM */ NUMERIC' +
        '(15,2),'
      
        '11015797=  SUMM_ALL /* TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL */' +
        ' NUMERIC(15,2),'
      '11015798=  NOTE /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200),'
      
        '11015799=  SUMM_DOLG /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMERI' +
        'C(15,2),'
      '110157100=  NAME_WITH_DOLG VARCHAR(500),'
      
        '110157101=  G_PROMOTION_STR /* TYPE OF COLUMN G_PROMOTION.NAME *' +
        '/ VARCHAR(150),'
      
        '110157102=  MAX_BONUS_PAY_SUMM /* TYPE OF COLUMN G_CLIENT.MAX_BO' +
        'NUS_PAY_SUMM */ NUMERIC(15,2))'
      '110157103=AS'
      '110157104=BEGIN'
      '110157105=  SUSPEND;'
      '110157106=END'
      '110157107=;'
      '110157108='
      '110157109=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '110157110=RETURNS ('
      
        '110157111=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZA' +
        'KAZ_DETAILS */ BIGINT,'
      
        '110157112=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ B' +
        'IGINT,'
      
        '110157113=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PROD' +
        'UCT */ BIGINT,'
      
        '110157114=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */' +
        ' NUMERIC(18,5),'
      
        '110157115=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ N' +
        'UMERIC(15,2),'
      
        '110157116=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUM' +
        'ERIC(15,2),'
      
        '110157117=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_PERC */ NUMERIC(15,2),'
      
        '110157118=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.D' +
        'ISCOUNT_TENGE */ NUMERIC(15,2),'
      
        '110157119=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_SUMM */ NUMERIC(15,2),'
      
        '110157120=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMER' +
        'IC(15,2),'
      
        '110157121=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUM' +
        'M */ NUMERIC(15,2),'
      
        '110157122=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VAR' +
        'CHAR(250),'
      
        '110157123=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(30),'
      
        '110157124=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110157125=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ N' +
        'UMERIC(15,2),'
      
        '110157126=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_' +
        'PRICE */ NUMERIC(15,2),'
      
        '110157127=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER' +
        ','
      '110157128=  IS_MARKED INTEGER,'
      
        '110157129=  SUM_TO_CHARGE_BONUS /* TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.SUMM */ NUMERIC(15,2),'
      
        '110157130=  ORIGINAL_KIT_ID /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.' +
        'ORIGINAL_KIT_ID */ BIGINT,'
      
        '110157131=  ORIGINAL_KIT_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.ORIGINAL_KIT_PRICE */ NUMERIC(15,2))'
      '110157132=AS'
      '110157133=BEGIN'
      '110157134=  SUSPEND;'
      '110157135=END'
      '110157136=;'
      '110157137='
      '110157138='
      
        '110157139=/*****************************************************' +
        '*************************/'
      
        '110157140=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110157141=/*****************************************************' +
        '*************************/'
      '110157142=ALTER PROCEDURE CURRENCYSTR('
      '110157143=  VAL NUMERIC(15,2),'
      '110157144=  CURRENCY INTEGER)'
      '110157145=RETURNS ('
      '110157146=  CURR_STR VARCHAR(1000))'
      '110157147=AS'
      '110157148=DECLARE VARIABLE RAZRYAD VARCHAR(50);'
      '110157149=DECLARE VARIABLE RAZRYAD_IDX VARCHAR(28);'
      '110157150=DECLARE VARIABLE HUNDREDS VARCHAR(64);'
      '110157151=DECLARE VARIABLE HUNDREDS_IDX VARCHAR(30);'
      '110157152=DECLARE VARIABLE TENS VARCHAR(69);'
      '110157153=DECLARE VARIABLE TENS_IDX VARCHAR(40);'
      '110157154=DECLARE VARIABLE ONES VARCHAR(138);'
      '110157155=DECLARE VARIABLE ONES_IDX VARCHAR(100);'
      '110157156=DECLARE VARIABLE SIGN_OF_VAL VARCHAR(6);'
      '110157157=DECLARE VARIABLE RAZ INTEGER;'
      '110157158=DECLARE VARIABLE CENTS VARCHAR(3);'
      '110157159=DECLARE VARIABLE VAL_STR1 VARCHAR(20);'
      '110157160=DECLARE VARIABLE VAL_STR VARCHAR(20);'
      '110157161=DECLARE VARIABLE NUM VARCHAR(20);'
      '110157162=DECLARE VARIABLE I INTEGER;'
      '110157163=DECLARE VARIABLE BUF VARCHAR(200);'
      '110157164=DECLARE VARIABLE BUF1 VARCHAR(200);'
      '110157165=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      '110157166=DECLARE VARIABLE CURR_STR_KOP_ VARCHAR(10);'
      '110157167=begin'
