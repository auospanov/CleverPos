      '11018363=  IF (ROW_COUNT = 0) then BEGIN'
      '11018364=  --**************************************************'
      
        '11018365=    -- '#1047#1053#1040#1063#1048#1058' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056#1045#1044 +
        #1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '11018366=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '11018367=    SELECT'
      '11018368=      G.G_FIRM_REKVIZIT,'
      '11018369=      G.NAME||DECODE(:CURRENCY_, 0, '#39#39','
      
        '11018370=                     '#39', '#1048#1053#1053#39'||COALESCE(G.IDN, '#39#39')||'#39', '#1050 +
        #1055#1055#39'||COALESCE(G.KPP, '#39#39')||'#39', '#39'||COALESCE(GF.ADDRESS,'#39#39')||'#39', '#1090#1077#1083'.' +
        #39'||COALESCE(GF.PHONE, '#39#39')||'
      
