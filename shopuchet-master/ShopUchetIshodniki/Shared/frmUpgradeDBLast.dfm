        '110206892=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059' ' +
        #1055#1056#1054#1044#1040#1046#1048'?'
      
        '110206893=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045' ' +
        #1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '110206894=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '110206895=      PNT_ = '#39'07'#39';'
      
        '110206896=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN' +
        ' BEGIN'
      '110206897=        SELECT S.S_VALUE'
      '110206898=          FROM SYSTEM_SETUP S'
      '110206899=         WHERE S.SYSTEM_SETUP = 4'
      '110206900=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '110206901='
      '110206902=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '110206903=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110206904=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110206905='
      
        '110206906=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' ' +
        #1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '110206907=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '110206908=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE' +
        '(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM ' +
        'CURRENT_DATE)));'
      '110206909='
      '110206910=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '110206911=        ELSE'
      
        '110206912=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DA' +
        'Y FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTR' +
        'ACT(DAY FROM current_date) + 32);'
      '110206913='
      '110206914=        KASSA_ZP_ID_ = NULL;'
      '110206915=        SELECT K.KASSA, K.SUMM'
      '110206916=        FROM KASSA K'
      '110206917=        WHERE K.G_PRIHOD_RASHOD = -1'
      '110206918=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110206919=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110206920=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110206921=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '110206922='
      
        '110206923=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || EX' +
        'TRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM ACT' +
        'ION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39';'
      '110206924='
      '110206925=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '110206926=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110206927=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110206928=                                          :SALES_COMM_' +
        'SUMM_ALL_,'
      
        '110206929=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110206930=                                          :OFFICIAL_NA' +
        'ME_,'
      
        '110206931=                                          NULL,     --' +
        ':ZAKAZ_,'
      
        '110206932=                                          NULL,     --' +
        ':SKLAD_,'
      '110206933=                                          1,'
      '110206934=                                          :G_TOCHKA_,'
      
        '110206935=                                          :UPLOAD_TO_E' +
        'XT_APP_,'
      '110206936=                                          :G_OFFICIAL_'
      
        '110206937=                                          ) RETURNING_' +
        'VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '110206938=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '110206939=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047#1055 +
        ' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SUM' +
        'M_ALL_ || '#39'".'#39';'
      '110206940='
      '110206941=        END ELSE BEGIN'
      
        '110206942=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_ITE' +
        'R_ + SALES_COMM_SUMM_ALL_;'
      '110206943=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '110206944=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047#1055 +
        ' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SAL' +
        'ES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '110206945=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072' ' +
        '"'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '110206946='
      
        '110206947=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_ID' +
        '_,'
      
        '110206948=                                          1,     -- AC' +
        'TION_'
      
        '110206949=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110206950=                                          :SALES_COMM_' +
        'SUMM_ALL_,   --SUMM_'
      
