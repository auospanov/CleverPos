        '110202542=                            '#39' FROM KASSA_BEZNAL_STATE ' +
        #39'||'
      
        '110202543=                            '#39' WHERE K_DATE < CD.K_DATE' +
        ') '#39'||'
      
        '110202544=                            '#39' ), 0), '#39'||DEBET_||'#39', '#39'||' +
        'CREDIT_||'#39', COALESCE((SELECT "OUTPUT" FROM KASSA_BEZNAL_STATE WH' +
        'ERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
