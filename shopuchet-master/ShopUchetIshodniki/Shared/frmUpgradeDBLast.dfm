      '1102251848=        -- '#1055#1054' '#1042#1057#1045#1052' '#1055#1056#1054#1044#1040#1046#1040#1052
      '1102251849=        SELECT 1 ROW,'
      
        '1102251850=               '#39#1055#1088#1086#1076#1072#1078#1072', '#1085#1072#1082#1083#1072#1076#1085#1072#1103' '#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39 +
        '||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MO' +
        'NTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE) st' +
        'r,'
