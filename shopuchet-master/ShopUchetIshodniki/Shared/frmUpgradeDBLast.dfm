        'UB_TYPE 1 SEGMENT SIZE 16384 = NULL)'
      '1101621002=RETURNS ('
      '1101621003=  ERR_CODE INTEGER,'
      '1101621004=  ERR_MSG VARCHAR(1024))'
      '1101621005=AS'
      '1101621006=BEGIN'
      '1101621007=  SUSPEND;'
      '1101621008=END'
      '1101621009=;'
      '1101621010='
      '1101621011=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1101621012=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1101621013=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '1101621014=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '1101621015=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGIN' +
        'T,'
      
        '1101621016=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_T' +
        'YPE */ BIGINT,'
      
        '1101621017=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VAR' +
        'CHAR(150),'
      '1101621018=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '1101621019=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2)' +
        ','
      
        '1101621020=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUM' +
        'ERIC(15,2),'
      
        '1101621021=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUM' +
        'ERIC(15,2),'
      
        '1101621022=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH ' +
        '*/ NUMERIC(15,2),'
      
        '1101621023=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ N' +
        'UMERIC(15,2),'
      
        '1101621024=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_' +
        'GOT */ NUMERIC(15,2),'
      
        '1101621025=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHO' +
        'D_RASHOD */ BIGINT,'
      
        '1101621026=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERI' +
        'C(15,2),'
      
        '1101621027=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */' +
        ' INTEGER,'
      
        '1101621028=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INT' +
        'EGER,'
      
        '1101621029=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ I' +
        'NTEGER,'
      '1101621030=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101621031=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1101621032=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1101621033=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT = NULL,'
      
        '1101621034=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB S' +
        'UB_TYPE 1 SEGMENT SIZE 16384 = NULL)'
      '1101621035=RETURNS ('
      '1101621036=  ERR_CODE INTEGER,'
      '1101621037=  ERR_MSG VARCHAR(1024))'
      '1101621038=AS'
      '1101621039=BEGIN'
      '1101621040=  SUSPEND;'
      '1101621041=END'
      '1101621042=;'
      '1101621043='
      '1101621044='
      
        '1101621045=/****************************************************' +
        '**************************/'
      
        '1101621046=/****                      Altering stored procedures' +
        '                      ****/'
      
        '1101621047=/****************************************************' +
        '**************************/'
      '1101621048=ALTER PROCEDURE DEL_PRODUCT('
      '1101621049=  SKLAD_ TYPE OF COLUMN OTHER.SKLAD_PARENT_ID,'
      
        '1101621050=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101621051=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101621052=RETURNS ('
      '1101621053=  ERR_CODE INTEGER,'
      '1101621054=  ERR_MSG VARCHAR(1024))'
      '1101621055=AS'
      '1101621056=/*'
      
        '1101621057='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1101621058='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1101621059=*/'
      
        '1101621060=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DEL_PRODUCT' +
        #39';'
      '1101621061=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101621062=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1101621063=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PROD' +
        'UCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' */'
      
        '1101621064=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101621065=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101621066=DECLARE VARIABLE ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.A' +
        'RRIVAL_TYPE;'
      
        '1101621067=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101621068=DECLARE VARIABLE DATE_ TYPE OF COLUMN OTHER.OP_DATE;'
      
        '1101621069=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1101621070=DECLARE VARIABLE ID_   TYPE OF COLUMN OTHER.OTHER;'
      '1101621071=BEGIN'
      '1101621072='
      '1101621073=  PNT_ = '#39'00'#39';'
      '1101621074=  SELECT O.G_TOCHKA'
      '1101621075=    FROM SKLAD_PARENT O'
      '1101621076=   WHERE O.SKLAD = :SKLAD_'
      '1101621077=    INTO :G_TOCHKA_;'
      '1101621078='
      '1101621079=  FOR SELECT D.AMOUNT'
      '1101621080=            ,D.G_PRODUCT'
      '1101621081=            ,O.ARRIVAL_TYPE'
      '1101621082=            ,O.OP_DATE'
      '1101621083=            ,O.OTHER'
      '1101621084=            ,SP.SUMM'
      '1101621085=        FROM OTHER O,'
      '1101621086=             OTHER_DETAILS D,'
      '1101621087=             SKLAD_PARENT SP'
      '1101621088=       WHERE O.sklad_parent_id = :SKLAD_'
      '1101621089=         AND O.OTHER = D.OTHER'
      '1101621090=         AND O.SKLAD_PARENT_ID = SP.SKLAD'
      '1101621091=        INTO :AMOUNT_NEED_'
      '1101621092=            ,:G_PRODUCT_KIT_'
      '1101621093=            ,:ARRIVAL_TYPE_'
      '1101621094=            ,:DATE_'
      '1101621095=            ,:ID_'
      '1101621096=            ,:SUMM_'
      '1101621097=  DO BEGIN'
      '1101621098=    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101621099=       SET L.AMOUNT = L.AMOUNT + DECODE(:ARRIVAL_TYPE' +
        '_, 0, -:AMOUNT_NEED_, :AMOUNT_NEED_)   -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040 +
        ', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1048' '#1053#1040#1054#1041#1054#1056#1054#1058
      '1101621100=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1101621101=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101621102=  END'
      '1101621103='
      '1101621104=  PNT_ = '#39'01'#39';'
      
        '1101621105=  DELETE FROM OTHER_DETAILS D WHERE EXISTS (SELECT 1 ' +
        'FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_ AND OTHER = D.OTHER);'
      '1101621106=  DELETE FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_;'
      '1101621107='
      '1101621108=  PNT_ = '#39'02'#39';'
      
        '1101621109=  EXECUTE PROCEDURE DEL_SKLAD(:SKLAD_, NULL) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621110=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621111=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101621112=      EXIT;'
      '1101621113=  END'
      '1101621114='
      '1101621115=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101621116=  EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, :ID_, ' +
        ':DATE_, 3, :SUMM_, :LOG_BODY_, 1);'
      '1101621117=END'
      '1101621118=;'
      '1101621119='
      '1101621120=ALTER PROCEDURE DEL_SKLAD('
      '1101621121=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101621122=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1101621123=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101621124=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101621125=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101621126=RETURNS ('
      '1101621127=  ERR_CODE INTEGER,'
      '1101621128=  ERR_MSG VARCHAR(1024))'
      '1101621129=AS'
      '1101621130=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD'#39';'
      '1101621131=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101621132=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101621133=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1101621134=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1101621135=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1101621136=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1101621137=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101621138=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.' +
        'AMOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057 +
        #1071') */'
      
        '1101621139=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA' +
        '.NAME;'
      
        '1101621140=DECLARE VARIABLE DATE_ TYPE OF COLUMN SKLAD_PARENT.DA' +
        'TE_RECEIPT;'
      
        '1101621141=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1101621142=BEGIN'
      '1101621143='
      '1101621144=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '1101621145=    SELECT S_VALUE'
      '1101621146=      FROM SYSTEM_SETUP'
      '1101621147=     WHERE SYSTEM_SETUP = 2'
      '1101621148=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1101621149='
      '1101621150=  SELECT SP.IS_VOZVRAT,'
      
        '1101621151=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TO' +
        'CHKA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '1101621152=         ,G.NAME'
      '1101621153=         ,SP.DATE_RECEIPT'
      '1101621154=         ,SP.SUMM'
      '1101621155=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '1101621156=   WHERE SP.SKLAD = :SKLAD_'
      '1101621157=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '1101621158=    INTO :IS_VOZVRAT_,'
      '1101621159=         :G_TOCHKA_'
      '1101621160=         ,:TOCHKA_NAME_'
      '1101621161=         ,:DATE_'
      '1101621162=         ,:SUMM_;'
      '1101621163='
      '1101621164=  PNT_ = '#39'02'#39';'
      '1101621165=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '1101621166=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '1101621167=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040 +
        #1045#1058' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      '1101621168=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '1101621169=      FOR SELECT S.G_PRODUCT,'
      '1101621170=                 SUM(S.AMOUNT)'
      '1101621171=            FROM SKLAD S'
      '1101621172=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '1101621173=           GROUP BY S.G_PRODUCT'
      '1101621174=            INTO :G_PRODUCT_,'
      '1101621175=                 :AMOUNT_PRIHOD_'
      '1101621176=      DO BEGIN'
      '1101621177=          SELECT L.AMOUNT,'
      '1101621178=                 G.NAME'
      '1101621179=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '1101621180=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101621181=             AND L.G_PRODUCT = G.G_PRODUCT'
      '1101621182=             AND L.G_TOCHKA = :G_TOCHKA_'
      '1101621183=            INTO :AMOUNT_LAST_,'
      '1101621184=                 :NAME_;'
      '1101621185='
      
        '1101621186=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) ' +
        'THEN BEGIN'
      '1101621187=              ERR_CODE = -20500;'
      
        '1101621188=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE,' +
        ' '#39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||NAME_||'#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||TOCHKA_NAME_||'#39'" '#1089#1090 +
        #1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      
        '1101621189=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101621190=              EXIT;'
      '1101621191=          END'
      '1101621192=      END'
      '1101621193=  END'
      '1101621194='
      
        '1101621195=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621196=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621197=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101621198=    EXIT;'
      '1101621199=  END'
      '1101621200='
      '1101621201=  -------------------------------------'
      
        '1101621202=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048 +
        ' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050 +
        #1051#1040#1044#1040
      
        '1101621203=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053 +
        #1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' ' +
        #1055#1054#1044#1056#1071#1044
      '1101621204=  PNT_ = '#39'05'#39';'
      '1101621205=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '1101621206=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '1101621207=      FOR SELECT S.KASSA'
      '1101621208=            FROM KASSA S'
      '1101621209=           WHERE S.SKLAD = :SKLAD_'
      '1101621210=            INTO :KASSA_'
      '1101621211=      DO BEGIN'
      
        '1101621212=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621213=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621214=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1101621215=             EXIT;'
      '1101621216=          END'
      '1101621217=      END'
      '1101621218='
      '1101621219=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '1101621220=      FOR SELECT S.KASSA_BEZNAL'
      '1101621221=            FROM KASSA_BEZNAL S'
      '1101621222=           WHERE S.SKLAD = :SKLAD_'
      '1101621223=            INTO :KASSA_'
      '1101621224=      DO BEGIN'
      
        '1101621225=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621226=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621227=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1101621228=             EXIT;'
      '1101621229=          END'
      '1101621230=      END'
      '1101621231=  END'
      '1101621232=  -------------------------------------'
      '1101621233='
      '1101621234=  PNT_ = '#39'06'#39';'
      '1101621235=  DELETE FROM sklad_PARENT'
      '1101621236=  WHERE sklad = :sklad_;'
      '1101621237='
      '1101621238=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101621239=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THE' +
        'N'
      
        '1101621240=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101621241=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_, ' +
        '3);'
      '1101621242='
      '1101621243=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101621244=  EXECUTE PROCEDURE LOG_OPER_INS(IS_VOZVRAT_, :USER_I' +
        'D_, :SKLAD_, :DATE_, 3, :SUMM_, :LOG_BODY_, 1);'
      '1101621245='
      '1101621246=when sqlcode -530 DO'
      '1101621247=  begin'
      '1101621248=    ERR_CODE = -20500;'
      
        '1101621249=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101621250=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101621251=  end'
      '1101621252=end'
      '1101621253=;'
      '1101621254='
      '1101621255=ALTER PROCEDURE DEL_ZAKAZ('
      '1101621256=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101621257=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0,'
      '1101621258=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101621259=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101621260=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101621261=RETURNS ('
      '1101621262=  ERR_CODE INTEGER,'
      '1101621263=  ERR_MSG VARCHAR(1024))'
      '1101621264=AS'
      '1101621265=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '1101621266=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101621267=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101621268=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M;'
      
        '1101621269=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '1101621270=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1101621271=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '1101621272=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101621273=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101621274=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101621275=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM;'
      
        '1101621276=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1101621277=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101621278=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101621279=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOC' +
        'HKA;'
      
        '1101621280=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1101621281=DECLARE VARIABLE STR_ VARCHAR(50);'
      '1101621282=DECLARE VARIABLE Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE;'
      '1101621283=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1101621284=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      '1101621285=BEGIN'
      
        '1101621286=  --*************************************************' +
        '***************'
      '1101621287=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1101621288=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101621289=      SELECT Z.SUMM,'
      '1101621290=             Z.SUMM_BONUS,'
      '1101621291=             Z.SUMM_BONUS_GOT,'
      '1101621292=             Z.G_CLIENT,'
      '1101621293=             Z.G_OFFICIAL,'
      '1101621294=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '1101621295=             G.FM'
      '1101621296=             ,Z.G_TOCHKA'
      '1101621297=             ,Z.Z_DATE'
      
        '1101621298=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101621299=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101621300=        INTO :SUMM_ZAKAZ_,'
      '1101621301=             :SUMM_PAY_BONUS_,'
      '1101621302=             :SUMM_BONUS_GOT_,'
      '1101621303=             :G_CLIENT_,'
      '1101621304=             :G_OFFICIAL_,'
      '1101621305=             :DO_NOT_SALES_COMM_,'
      '1101621306=             :OFFICIAL_NAME_'
      '1101621307=             ,:G_TOCHKA_'
      '1101621308=             ,:Z_DATE_;'
      '1101621309='
      
        '1101621310=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101621311=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ') THEN'
      '1101621312=        SELECT SUM(ZD.SALES_COMM)'
      '1101621313=          FROM ZAKAZ_DETAILS ZD'
      '1101621314=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101621315=          INTO :SALES_COMM_OLD_;'
      '1101621316='
      '1101621317=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1101621318=      PNT_ = '#39'01'#39';'
      
        '1101621319=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621320=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621321=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101621322=        EXIT;'
      '1101621323=      END'
      '1101621324='
      '1101621325=      -------------------------------------'
      '1101621326=      PNT_ = '#39'02'#39';'
      '1101621327=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '1101621328=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040 +
        #1051#1048#1063#1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045 +
        #1053#1048#1071' '#1055#1054#1044#1056#1071#1044
      '1101621329=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '1101621330=      FOR SELECT S.KASSA'
      '1101621331=            FROM KASSA S'
      '1101621332=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1101621333=            INTO :KASSA_'
      '1101621334=      DO BEGIN'
      
        '1101621335=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621336=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621337=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101621338=            EXIT;'
      '1101621339=          END'
      '1101621340=      END'
      '1101621341='
      '1101621342=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '1101621343=      PNT_ = '#39'03'#39';'
      '1101621344=      FOR SELECT S.KASSA_BEZNAL'
      '1101621345=            FROM KASSA_BEZNAL S'
      '1101621346=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1101621347=            INTO :KASSA_'
      '1101621348=      DO BEGIN'
      
        '1101621349=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621350=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621351=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101621352=            EXIT;'
      '1101621353=          END'
      '1101621354=      END'
      '1101621355=      -------------------------------------'
      '1101621356='
      
        '1101621357=      --=============================================' +
        '===================='
      '1101621358=      -- '#1041#1051#1054#1050' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040
      
        '1101621359=      --=============================================' +
        '===================='
      '1101621360=      PNT_ = '#39'03.1'#39';'
      
        '1101621361=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ' AND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '1101621362=            KASSA_ = NULL;'
      '1101621363='
      '1101621364=            SELECT S.S_VALUE'
      '1101621365=              FROM SYSTEM_SETUP S'
      '1101621366=             WHERE S.SYSTEM_SETUP = 4'
      '1101621367=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101621368='
      '1101621369=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101621370=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101621371=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101621372='
      
        '1101621373=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' ' +
        #1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101621374=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THE' +
        'N'
      
        '1101621375=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - D' +
        'ECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY ' +
        'FROM CURRENT_DATE)));'
      '1101621376='
      '1101621377=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101621378=            ELSE'
      
        '1101621379=               ACTION_DATE_ZP_ = Current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date -' +
        ' EXTRACT(DAY FROM current_date) + 32);'
      '1101621380='
      '1101621381=            SELECT K.KASSA, K.SUMM'
      '1101621382=            FROM KASSA K'
      '1101621383=            WHERE K.G_PRIHOD_RASHOD = -1'
      '1101621384=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101621385=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101621386=             AND K.G_TOCHKA = :G_TOCHKA_'
      '1101621387=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1101621388='
      
        '1101621389=            LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' ' +
        '|| EXTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FRO' +
        'M ACTION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) ||' +
        ' '#39'"'#39';'
      '1101621390='
      '1101621391=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '1101621392=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101621393=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1101621394=                                              -:SALES' +
        '_COMM_OLD_,'
      
        '1101621395=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1101621396=                                              :OFFICI' +
        'AL_NAME_,'
      
        '1101621397=                                              NULL,  ' +
        '   --:ZAKAZ_,'
      
        '1101621398=                                              NULL,  ' +
        '   --:SKLAD_,'
      '1101621399=                                              1,'
      
        '1101621400=                                              (SELECT' +
        ' ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101621401=                                              :G_OFFI' +
        'CIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101621402=                LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101621403=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COM' +
        'M_OLD_ || '#39'".'#39';'
      '1101621404='
      '1101621405=            END ELSE'
      
        '1101621406=                SALES_COMM_OLD_ = SALES_COMM_SUMM_ITE' +
        'R_ - SALES_COMM_OLD_;'
      '1101621407=                LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101621408=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' |' +
        '| SALES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101621409=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39' '#1085#1072' "'#39' || SALES_COMM_OLD_ || '#39'".'#39';'
      '1101621410='
      
        '1101621411=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_' +
        ','
      
        '1101621412=                                              1,     ' +
        '-- ACTION_'
      
        '1101621413=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1101621414=                                              :SALES_' +
        'COMM_OLD_,'
      
        '1101621415=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1101621416=                                              :OFFICI' +
        'AL_NAME_,   --NOTE_'
      '1101621417=                                              NULL,'
      '1101621418=                                              NULL,'
      '1101621419=                                              1,'
      
        '1101621420=                                              G_OFFIC' +
        'IAL_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101621421='
      '1101621422=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621423=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101621424=              EXIT;'
      '1101621425=            END'
      '1101621426=      END'
      '1101621427=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101621428=      --=============================================' +
        '===================='
      '1101621429='
      
        '1101621430=      -- '#1045#1057#1051#1048' '#1050#1040#1050#1040#1071'-'#1058#1054' '#1063#1040#1057#1058#1068' '#1041#1067#1051#1040' '#1054#1055#1051#1040#1063#1045#1053#1040' '#1041#1054#1053#1059#1057#1040#1052#1048' -' +
        ' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1048#1061', '#1058#1054' '#1045#1057#1058#1068' '#1047#1040#1050#1048#1044#1067#1042#1040#1070' '#1050#1051#1048#1045#1053#1058#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1053#1040' '#1053#1040#1050#1054#1055#1051#1045 +
        #1053#1048#1071
      '1101621431=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '1101621432=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' ' +
        #1055#1054#1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '1101621433=      UPDATE G_DISCONT_CARD G'
      
        '1101621434=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_' +
        ', 0) - :SUMM_BONUS_GOT_,'
      
        '1101621435=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0)' +
        ', 0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '1101621436=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '1101621437='
      '1101621438=      PNT_ = '#39'04'#39';'
      '1101621439=      UPDATE INVOICE I'
      '1101621440=         SET I.ZAKAZ = NULL'
      '1101621441=       WHERE I.ZAKAZ = :zakaz_;'
      '1101621442='
      '1101621443=      UPDATE INVOICE_PAY I'
      '1101621444=         SET I.ZAKAZ = NULL'
      '1101621445=       WHERE I.ZAKAZ = :zakaz_;'
      '1101621446='
      '1101621447=      UPDATE WAYBILL W'
      '1101621448=         SET W.ZAKAZ = NULL'
      '1101621449=       WHERE W.ZAKAZ = :zakaz_;'
      '1101621450=      --********************************************'
      '1101621451='
      '1101621452=      PNT_ = '#39'015'#39';'
      '1101621453=      DELETE FROM zakaz'
      '1101621454=      WHERE zakaz = :zakaz_;'
      '1101621455='
      '1101621456=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101621457=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101621458=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101621459=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 3);'
      '1101621460=  END'
      '1101621461=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '1101621462=  --*************************************************' +
        '***************************'
      '1101621463=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101621464=  ELSE BEGIN'
      '1101621465=    SELECT SP.DATE_RECEIPT,'
      '1101621466=           SP.SUMM'
      '1101621467=      FROM SKLAD_PARENT SP'
      '1101621468=     WHERE SP.SKLAD = :ZAKAZ_'
      '1101621469=      INTO :Z_DATE_,'
      '1101621470=           :SUMM_ZAKAZ_;'
      '1101621471='
      '1101621472=    PNT_ = '#39'20'#39';'
      
        '1101621473=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL) RETURN' +
        'ING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101621474=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621475=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101621476=      EXIT;'
      '1101621477=    END'
      '1101621478=  END'
      '1101621479='
      '1101621480=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101621481=  EXECUTE PROCEDURE LOG_OPER_INS(IS_SPISANIE_, :USER_' +
        'ID_, :ZAKAZ_, :Z_DATE_, 3, :SUMM_ZAKAZ_, :LOG_BODY_, 0);'
      '1101621482='
      '1101621483=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1101621484=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM_OLD_,' +
        ' :LOG_BODY_KASSA_, 1);'
      '1101621485='
      '1101621486=when sqlcode -530 DO'
      '1101621487=  begin'
      '1101621488=    ERR_CODE = -20500;'
      
        '1101621489=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101621490=    ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '1101621491=  end'
      '1101621492=end'
      '1101621493=;'
      '1101621494='
      '1101621495=ALTER PROCEDURE DO_PRODUCT('
      '1101621496=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101621497=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1101621498=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101621499=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101621500=  NOTE_ TYPE OF COLUMN OTHER.NOTE,'
      
        '1101621501=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101621502=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101621503=RETURNS ('
      '1101621504=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1101621505=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101621506=  ERR_CODE INTEGER,'
      '1101621507=  ERR_MSG VARCHAR(1024))'
      '1101621508=AS'
      '1101621509=/*'
      
        '1101621510='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1101621511='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1101621512=*/'
      
        '1101621513=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1101621514=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101621515=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1101621516=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1101621517=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1101621518=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1101621519=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1101621520=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101621521=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1101621522=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '1101621523=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101621524=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101621525=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1101621526=DECLARE VARIABLE POS_ INTEGER;'
      '1101621527=DECLARE VARIABLE STR_ VARCHAR(300);'
      '1101621528=BEGIN'
      '1101621529=  PNT_ = '#39'00'#39';'
      '1101621530=  COST_PRICE_ = 0;'
      '1101621531='
      '1101621532=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101621533=    SELECT ID'
      '1101621534=      FROM CUR_PARAMS'
      '1101621535=     WHERE CUR_PARAMS = 2'
      '1101621536=      INTO :G_TOCHKA_;'
      '1101621537='
      '1101621538=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1101621539=  SELECT P.S_VALUE'
      '1101621540=    FROM SYSTEM_SETUP P'
      '1101621541=   WHERE P.SYSTEM_SETUP = 2'
      '1101621542=    INTO :CAN_SELL_;'
      '1101621543='
      '1101621544=  IF (LOG_BODY_ IS NOT NULL) THEN'
      '1101621545=    LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM 3);'
      '1101621546='
      '1101621547=  FOR SELECT :G_PRODUCT_IN_,'
      '1101621548=             :AMOUNT_IN_'
      '1101621549=        FROM RDB$DATABASE'
      '1101621550=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '1101621551=      UNION ALL'
      '1101621552=      SELECT G_PRODUCT,'
      '1101621553=             AMOUNT'
      '1101621554=        FROM ZAKAZ_DETAILS_TMP'
      '1101621555=       WHERE :G_PRODUCT_IN_ IS NULL'
      '1101621556=        INTO :G_PRODUCT_,'
      '1101621557=             :AMOUNT_'
      '1101621558=  DO BEGIN'
      '1101621559=      SELECT MAX(G.NAME)'
      '1101621560=        FROM G_PRODUCT G,'
      '1101621561=             G_PRODUCT_KIT K'
      '1101621562=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1101621563=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1101621564=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_' +
        'PRODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TO' +
        'CHKA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1101621565=        INTO :NAME_;'
      '1101621566='
      
        '1101621567=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN B' +
        'EGIN'
      '1101621568=        ERR_CODE = -20500;'
      
        '1101621569=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087 +
        #1088#1086#1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101621570=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101621571=        EXIT;'
      '1101621572=      END'
      '1101621573='
      '1101621574=      PNT_ = '#39'01'#39';'
      
        '1101621575=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TIME, OP_' +
        'TYPE, ARRIVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '1101621576=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_,' +
        ' CURRENT_TIME, 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '1101621577=      RETURNING OTHER'
      '1101621578=      INTO :OTHER_;'
      '1101621579='
      '1101621580=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1101621581=      FOR SELECT K.G_PRODUCT_ITEM'
      '1101621582=                ,K.AMOUNT*:AMOUNT_'
      '1101621583=                ,K.amount'
      '1101621584=                ,G.G_PRODUCT'
      '1101621585=            FROM G_PRODUCT_KIT K'
      '1101621586=                ,G_PRODUCT G'
      '1101621587=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101621588=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1101621589=            INTO :ITEM_'
      '1101621590=                ,:AMOUNT_NEED_'
      '1101621591=                ,:AMOUNT_NEED_ONE_'
      '1101621592=                ,:G_PRODUCT_KIT_'
      '1101621593=      DO BEGIN'
      
        '1101621594=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_KIT_, NULL, 1)'
      '1101621595=          RETURNING_VALUES :SELF_PRICE_;'
      '1101621596='
      '1101621597=        UPDATE LT_SKLAD_PRODUCT L'
      '1101621598=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '1101621599=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1101621600=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101621601='
      '1101621602=        IF (ROW_COUNT = 0) THEN'
      
        '1101621603=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :' +
        'G_TOCHKA_);'
      '1101621604='
      
        '1101621605=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTH' +
        'ER, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1101621606=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_' +
        ', :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1101621607='
      
        '1101621608=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*' +
        'SELF_PRICE_;'
      '1101621609=      END'
      '1101621610='
      
        '1101621611=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1101621612=      PNT_ = '#39'02'#39';'
      
        '1101621613=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101621614=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1101621615='
      '1101621616=      SUMM_ = AMOUNT_*COST_PRICE_;'
      '1101621617='
      '1101621618=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101621619=                              :DATE_,'
      '1101621620=                              CURRENT_TIME,'
      '1101621621=                              NULL, --:G_CLIENT__,'
      
        '1101621622=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1101621623=                              NULL, --:OSNOVANIE__,'
      '1101621624=                              :NOTE_,'
      '1101621625=                              4, --:IS_VOZVRAT_,'
      '1101621626=                              :SUMM_,'
      '1101621627=                              :SUMM_,'
      '1101621628=                              0, --:G_PRIHOD_,'
      '1101621629=                              0 --:SUMM_PRIHOD_)'
      '1101621630=                              ,NULL     --PAYMENTS_'
      
        '1101621631=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101621632=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101621633=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101621634=          EXIT;'
      '1101621635=      END'
      '1101621636='
      '1101621637=      UPDATE OTHER O'
      '1101621638=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1101621639=      WHERE O.OTHER = :OTHER_;'
      '1101621640='
      '1101621641=      COST_PRICE_ = 0;'
      '1101621642='
      '1101621643=      -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101621644=      -- '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1042' '#1058#1040#1050#1054#1052' '#1042#1048#1044#1045' "~*'#1041#1051#1040'-'#1041#1051 +
        #1040' '#1058#1040#1050#1054#1049'-'#1058#1054' '#1058#1054#1042#1040#1056'~*'#1041#1051#1040'-'#1041#1051#1040' '#1042#1058#1054#1056#1054#1049' '#1058#1054#1042#1040#1056'~*"'
      
        '1101621645=      -- '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1042#1067#1056#1045#1047#1040#1058#1068'. '#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1058#1040#1050' '#1044#1045#1051#1040#1058#1068 +
        ' '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1040' '#1058#1059#1058' '#1057#1054#1047#1044#1040#1045#1058#1057#1071
      '1101621646=      -- '#1056#1040#1047#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048'-'#1047#1040#1055#1048#1057#1071#1052#1048
      '1101621647=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1101621648=        POS_ = POSITION('#39'~*'#39' IN LOG_BODY_);'
      
        '1101621649=        IF (CHAR_LENGTH(LOG_BODY_) <> (POS_ + 1)) THE' +
        'N'
      
        '1101621650=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR POS_ ' +
        '- 1);'
      '1101621651=        ELSE'
      
        '1101621652=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR CHAR_' +
        'LENGTH(LOG_BODY_) - 3);'
      '1101621653='
      '1101621654=        --ERR_CODE = -20500;'
      '1101621655=        --ERR_MSG = STR_; EXIT;'
      '1101621656='
      
        '1101621657=        EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, ' +
        ':OTHER_, :DATE_, 1, :SUMM_, :STR_, 1);'
      '1101621658='
      
        '1101621659=        LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM (POSIT' +
        'ION('#39'~*'#39' IN LOG_BODY_)) + 2);'
      '1101621660=      END'
      '1101621661=  END'
      '1101621662=END'
      '1101621663=;'
      '1101621664='
      '1101621665=ALTER PROCEDURE G_DEL_G_CLIENT('
      '1101621666=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1101621667=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101621668=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101621669=RETURNS ('
      '1101621670=  ERR_CODE INTEGER,'
      '1101621671=  ERR_MSG VARCHAR(1024))'
      '1101621672=AS'
      '1101621673=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1101621674=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101621675=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_CLIENT.NAME;'
      '1101621676=begin'
      '1101621677=  PROCNAME = '#39'G_DEL_G_CLIENT'#39';'
      '1101621678='
      '1101621679=  if (G_CLIENT_ in (9, 10)) then begin'
      '1101621680=    ERR_CODE = -20500;'
      
        '1101621681=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1072#1103' '#1079 +
        #1072#1087#1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1101621682=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '1101621683=    EXIT;'
      '1101621684=  end'
      '1101621685='
      '1101621686=  SELECT NAME'
      '1101621687=    FROM G_CLIENT G'
      '1101621688=   WHERE G.G_CLIENT = :G_CLIENT_'
      '1101621689=     INTO :NAME_;'
      '1101621690='
      '1101621691=  delete from G_discont_card g'
      '1101621692=    where g.G_CLIENT = :G_CLIENT_;'
      '1101621693='
      '1101621694=  update sms_history h'
      '1101621695=     set h.G_CLIENT = null'
      '1101621696=   where h.G_CLIENT = :G_CLIENT_;'
      '1101621697='
      '1101621698=  delete from G_client g'
      '1101621699=    where g.G_CLIENT = :G_CLIENT_;'
      '1101621700='
      '1101621701=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101621702=  EXECUTE PROCEDURE LOG_OPER_INS(12, :USER_ID_, :G_CL' +
        'IENT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '1101621703='
