        ' FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32);'
      '11091967='
      '11091968=        KASSA_ = NULL;'
      '11091969=        SELECT K.KASSA, K.SUMM'
      '11091970=        FROM KASSA K'
      '11091971=        WHERE K.G_PRIHOD_RASHOD = -1'
