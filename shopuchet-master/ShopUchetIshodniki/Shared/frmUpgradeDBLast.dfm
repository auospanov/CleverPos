      '1106348='
      '1106349=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1106350=RETURNS ('
      
        '1106351=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS */ BIGINT,'
      
        '1106352=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ BIG' +
