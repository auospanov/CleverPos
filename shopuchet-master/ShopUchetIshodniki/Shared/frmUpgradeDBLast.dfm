        '1102461923=                                          :SALES_COMM' +
        '_SUMM_ALL_,   --SUMM_'
      
        '1102461924=                                          :ACTION_DAT' +
        'E_ZP_,  -- ACTION_DATE_'
      
        '1102461925=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      
        '1102461926=                                          NULL,      ' +
        '        -- ZAKAZ_'
      
        '1102461927=                                          NULL,      ' +
        '        -- SKLAD_'
      
        '1102461928=                                          1,         ' +
        '        --:PAYMENT_TYPE_,'
      
        '1102461929=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102461930=                                          :G_OFFICIAL' +
        '_'
      
        '1102461931=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102461932='
      '1102461933=        END'
      '1102461934=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102461935=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102461936=          EXIT;'
      '1102461937=        END'
      '1102461938=      END */'
      '1102461939='
      
        '1102461940=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOA' +
        'D_TO_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040 +
        #1058#1053#1054' '#1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102461941=      IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_SPISANIE_ = ' +
        '0) THEN'
      
        '1102461942=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER, IS_LOADED_MOB)'
      
        '1102461943=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1, (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END));  ' +
