      '1102291165=  NAME VARCHAR(1000),'
      '1102291166=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102291167=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102291168=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102291169=  AMOUNT_IN MY_NUMERIC_5,'
      
        '1102291170=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '1102291171=  SUMM_PRIHOD NUMERIC(15,2),'
      '1102291172=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1102291173=  SUMM_UHOD NUMERIC(15,2),'
      
        '1102291174=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1102291175=  SUMM_SPISANO NUMERIC(15,2),'
      
        '1102291176=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1102291177=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '1102291178=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.A' +
        'MOUNT,'
      '1102291179=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '1102291180=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1102291181=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '1102291182=  AMOUNT_OUT MY_NUMERIC_5,'
      '1102291183=  LAST_SUPPLIER TYPE OF COLUMN G_CLIENT.NAME,'
      '1102291184=  IS_HEAD INTEGER,'
      '1102291185=  ERR_CODE INTEGER,'
      '1102291186=  ERR_MSG VARCHAR(1024))'
      '1102291187=AS'
      
        '1102291188=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1102291189=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102291190=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '1102291191=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1102291192=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT = 0;'
      '1102291193=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1102291194=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1102291195=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1102291196=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1102291197=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1102291198=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102291199=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1102291200=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102291201=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1102291202=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1102291203=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1102291204=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102291205=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1102291206=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102291207=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1102291208=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102291209=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1102291210=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102291211=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1102291212=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102291213=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1102291214=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102291215=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0' +
        ';'
      
        '1102291216=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102291217=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1102291218=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102291219=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1102291220=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102291221=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '1102291222=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102291223=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '1102291224=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102291225=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1102291226=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102291227=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      '1102291228=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '1102291229=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39';'
      
        '1102291230=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '1102291231=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '1102291232=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      
        '1102291233=DECLARE VARIABLE REC_LAST_SUPPLIER_ TYPE OF COLUMN G_' +
        'CLIENT.NAME;'
      '1102291234=BEGIN'
      '1102291235='
      '1102291236=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '1102291237=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1102291238='
      '1102291239=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '1102291240=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '1102291241=               (select (select COALESCE(sum(amount), ' +
        '0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1102291242=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1102291243=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1102291244=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102291245=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1102291246=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1102291247=                        and zrp.ZAKAZ_DATE >= :DATE_B' +
        'EGIN_)'
      '1102291248=                       +'
      
        '1102291249=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1102291250=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1102291251=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      '1102291252=                        and z.IS_RESERVE = 0'
      
        '1102291253=                        and z.IS_SPISANIE <> 2   -- '#1085 +
        #1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' ' +
        #1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102291254=                        and not (z.IS_SPISANIE = 0 an' +
        'd z.NOT_MINUS_OSTATOK = 1))'
      '1102291255=                       +'
      
        '1102291256=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1102291257=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1102291258=                       +'
      
        '1102291259=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1102291260=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1102291261=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1102291262=                       -'
      
        '1102291263=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102291264=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102291265=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_ and not (sp.IS_VOZVRAT = 0 and sp.IS' +
        '_EXPECTED = 1))'
      '1102291266=                       -'
      
        '1102291267=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102291268=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1102291269=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||Sp.g_tochka||'#39'-'#39' and sp.date_receipt >= :DATE_BEGIN_ and s' +
        'p.IS_EXPECTED = 0)'
      '1102291270=                  from rdb$database) AMOUNT_OUT,'
      '1102291271=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1102291272=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1102291273=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102291274=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102291275=                   AND SP.IS_VOZVRAT = 0'
      '1102291276=                   AND SP.IS_EXPECTED = 0'
      
        '1102291277=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') AMOUNT_PRIHOD,'
      '1102291278=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1102291279=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102291280=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102291281=                   AND SP.IS_VOZVRAT = 0'
      '1102291282=                   AND SP.IS_EXPECTED = 0'
      
        '1102291283=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') SUMM_PRIHOD,'
      '1102291284=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '1102291285=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1102291286=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102291287=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102291288=                   AND Z.IS_SPISANIE = 0'
      '1102291289=                   AND Z.IS_RESERVE = 0'
      '1102291290=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1102291291=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_UHOD,'
      '1102291292=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1102291293=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102291294=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102291295=                   AND Z.IS_SPISANIE = 0'
      '1102291296=                   AND Z.IS_RESERVE = 0'
      '1102291297=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1102291298=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_UHOD,'
      '1102291299=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102291300=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1102291301=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102291302=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102291303=                   AND Z.IS_SPISANIE = 1'
      
        '1102291304=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_SPISANO,'
      '1102291305=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1102291306=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102291307=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102291308=                   AND Z.IS_SPISANIE = 1'
      
        '1102291309=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_SPISANO,'
      '1102291310=               -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1102291311=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1102291312=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1102291313=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1102291314=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1102291315=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') AMOUNT_VOZVRAT,'
      '1102291316=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1102291317=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1102291318=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1102291319=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1102291320=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') SUMM_VOZVRAT,'
      
        '1102291321=               -- '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059 +
        #1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1067#1056#1040#1042#1053#1048#1042#1040#1053#1048#1045' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1042' '#1056#1045#1047#1059#1051 +
        #1068#1058#1040#1058#1045' '#1056#1045#1042#1048#1047#1048#1048
      '1102291322=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      '1102291323=                  FROM SKLAD S, SKLAD_PARENT SP'
      '1102291324=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      '1102291325=                   AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102291326=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102291327=                   AND SP.IS_VOZVRAT IN (3, 4, 5)'
      
        '1102291328=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39
      
        '1102291329=                   AND NOT (SP.IS_VOZVRAT = 3 AND SP.' +
        'IS_EXPECTED = 1)) AMOUNT_PRIHOD_SKL,'
      '1102291330=               (SELECT COALESCE(SUM(S.SUMM),0)'
      '1102291331=                  FROM SKLAD S, SKLAD_PARENT SP'
      '1102291332=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      '1102291333=                   AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102291334=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102291335=                   AND SP.IS_VOZVRAT IN (3, 4, 5)'
      
        '1102291336=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39
      
        '1102291337=                   AND NOT (SP.IS_VOZVRAT = 3 AND SP.' +
        'IS_EXPECTED = 1)) SUMM_PRIHOD_SKL,'
      
        '1102291338=               -- '#1059#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1059#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1044#1056'. '#1057#1050 +
        #1051#1040#1044' '#1048' '#1059#1061#1054#1044' '#1050#1054#1052#1055#1051#1045#1050#1058#1059#1070#1065#1048#1061' '#1055#1056#1048' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1045', '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1059
      '1102291339=               (SELECT COALESCE(SUM(AMOUNT), 0)'
      
        '1102291340=                  FROM (SELECT COALESCE(S.AMOUNT, 0) ' +
        'AMOUNT'
      '1102291341=                          FROM SKLAD S'
      
        '1102291342=                         WHERE S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '1102291343=                           AND S.DATE_RECEIPT BETWEEN' +
        ' :DATE_BEGIN_ AND :DATE_END_'
      '1102291344=                           AND S.IS_VOZVRAT = 3'
      
        '1102291345=                           AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_CLIENT||'#39'-'#39
      '1102291346=                        UNION ALL'
      
        '1102291347=                        SELECT COALESCE(D.AMOUNT, 0) ' +
        'AMOUNT'
      
        '1102291348=                          FROM OTHER O, OTHER_DETAILS' +
        ' D'
      '1102291349=                         WHERE O.OTHER = D.OTHER'
      
        '1102291350=                           AND O.OP_DATE BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      
        '1102291351=                           AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||O.G_TOCHKA||'#39'-'#39
      
        '1102291352=                           AND D.G_PRODUCT = G.G_PROD' +
        'UCT'
      '1102291353=                        UNION ALL'
      
        '1102291354=                        SELECT COALESCE(D.AMOUNT, 0) ' +
        'AMOUNT'
      
        '1102291355=                          FROM ZAKAZ Z, ZAKAZ_DETAILS' +
        ' D'
      '1102291356=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '1102291357=                           AND Z.Z_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '1102291358=                           AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1102291359=                           AND D.G_PRODUCT = G.G_PROD' +
        'UCT'
      '1102291360=                           AND Z.IS_SPISANIE = 4'
