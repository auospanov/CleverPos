      '1106016940='
      '1106016941=ALTER PROCEDURE G_INS_G_DISCOUNT('
      
        '1106016942=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1106016943=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '1106016944=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '1106016945=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '1106016946=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '1106016947=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '1106016948=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '1106016949=  G_TOCHKA_ VARCHAR(500))'
      '1106016950=RETURNS ('
      '1106016951=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '1106016952=  ERR_CODE INTEGER,'
      '1106016953=  ERR_MSG VARCHAR(1024))'
      '1106016954=AS'
      '1106016955=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1106016956=DECLARE VARIABLE G_PRODUCT_REC_ TYPE OF COLUMN G_DISC' +
        'OUNT.G_PRODUCT;'
      
        '1106016957=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_DISCOUNT' +
        '.G_PRODUCT;'
      
        '1106016958=DECLARE VARIABLE SKIDKA_PROC_R_ TYPE OF COLUMN G_DISC' +
        'OUNT.SKIDKA_PROC; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      
        '1106016959=DECLARE VARIABLE SKIDKA_SUM_R_ TYPE OF COLUMN G_DISCO' +
        'UNT.SKIDKA_SUM; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      
        '1106016960=DECLARE VARIABLE G_TOCHKA_ID_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      '1106016961=BEGIN'
      '1106016962='
      '1106016963=    FOR SELECT NULL G_TOCHKA'
      '1106016964=          FROM RDB$DATABASE'
      '1106016965=         WHERE :G_TOCHKA_ IS NULL'
      '1106016966=        UNION ALL'
      '1106016967=        SELECT G.G_TOCHKA'
      '1106016968=          FROM G_TOCHKA G'
      
        '1106016969=         WHERE :G_TOCHKA_ CONTAINING '#39'~'#39'||G.G_TOCHKA|' +
        '|'#39'~'#39
      '1106016970=        ORDER BY 1'
      '1106016971=          INTO :G_TOCHKA_ID_'
      '1106016972=    DO BEGIN'
      '1106016973=            FOR SELECT G.G_PRODUCT,'
      '1106016974=                       G.PRICE'
      '1106016975=                  FROM G_PRODUCT G'
      
        '1106016976=                 WHERE G.G_PRODUCT_PAR = DECODE(:G_PR' +
        'ODUCT_PAR_, -1, G.G_PRODUCT_PAR, :G_PRODUCT_PAR_)'
      
        '1106016977=                   AND G.G_PRODUCT = COALESCE(:G_PROD' +
        'UCT_, G.G_PRODUCT)'
      '1106016978=                   AND G.IS_ACTIVE = 1'
      '1106016979=                   AND G.IS_CATEGORY = 0'
      '1106016980=                   AND G.PRICE > 0'
      '1106016981=                  INTO :G_PRODUCT_REC_,'
      '1106016982=                       :PRICE_REC_'
      '1106016983=            DO BEGIN'
      
        '1106016984=                -- '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1045#1050#1059#1065#1040#1071' '#1057#1050#1048#1044#1050#1040' '#1048' '#1048#1044#1045#1058' '#1043#1056 +
        #1059#1055#1055#1054#1042#1054#1045' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1045' '#1057#1050#1048#1044#1050#1048', '#1058#1054' '#1040#1042#1058#1054#1052#1040#1058#1054#1052' '#1059#1041#1048#1056#1040#1070' '#1057#1050#1048#1044#1050#1059', '#1048' '#1047#1040#1052#1045#1053#1071#1070 +
        ' '#1053#1054#1042#1054#1049
      
        '1106016985=                -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1054#1044#1048#1053#1054#1063#1053#1054#1045' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1045', '#1058'.' +
        #1045'. '#1055#1054' '#1050#1054#1053#1050#1056#1045#1058#1053#1054#1052#1059' '#1058#1054#1042#1040#1056#1059', '#1058#1054' '#1054#1064#1048#1041#1050#1040
      '1106016986=                if (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1106016987=                  DELETE FROM G_DISCOUNT'
      
        '1106016988=                   WHERE COALESCE(DATE_BEGIN, CURRENT' +
        '_DATE) <= CURRENT_DATE AND COALESCE(DATE_END, CURRENT_DATE) >= C' +
        'URRENT_DATE'
      '1106016989=                     AND G_PRODUCT = :G_PRODUCT_REC_'
      '1106016990=                     AND G_TOCHKA = :G_TOCHKA_ID_;'
      '1106016991=                ELSE BEGIN'
      '1106016992=                    SELECT COUNT(*)'
      '1106016993=                      FROM G_DISCOUNT'
      
        '1106016994=                     WHERE G_PRODUCT = :G_PRODUCT_REC' +
        '_'
      
        '1106016995=                       AND COALESCE(DATE_BEGIN, CURRE' +
        'NT_DATE) <= CURRENT_DATE'
      
        '1106016996=                       AND COALESCE(DATE_END, CURRENT' +
        '_DATE) >= CURRENT_DATE'
      
        '1106016997=                       AND ((G_TOCHKA = COALESCE(:G_T' +
        'OCHKA_ID_, 0))'
      '1106016998=                            OR'
      
        '1106016999=                            (G_TOCHKA IS NOT NULL AND' +
        ' :G_TOCHKA_ID_ IS NULL)'
      '1106017000=                            OR'
      '1106017001=                            (G_TOCHKA IS NULL)'
      '1106017002=                           )'
      '1106017003=                      INTO CNT_;'
      '1106017004='
      '1106017005=                    IF (CNT_ <> 0) THEN BEGIN'
      '1106017006=                      ERR_CODE = -20500;'
      
        '1106017007=                      EXECUTE PROCEDURE GET_ERR_MSG(E' +
        'RR_CODE, '#39#1053#1072' '#1076#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39') RETURNI' +
        'NG_VALUES (:ERR_MSG);'
      '1106017008=                      EXIT;'
      '1106017009=                    END'
      '1106017010=                END'
      '1106017011='
      
        '1106017012=                -- '#1055#1056#1048' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1071' '#1044#1048#1057#1050#1054#1053#1058#1054#1042 +
        ' '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071' '#1063#1058#1054' '#1054#1044#1053#1054' '#1048#1047' '#1055#1054#1051#1045#1049' - '#1055#1059#1057#1058#1054#1045
      '1106017013=                SKIDKA_PROC_R_ = SKIDKA_PROC_;'
      '1106017014=                SKIDKA_SUM_R_  = SKIDKA_SUM_;'
      '1106017015=                IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '1106017016=                  IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '1106017017=                    SKIDKA_PROC_R_ = ROUND(SKIDKA_SUM' +
        '_ * 100 / PRICE_REC_ , 2);'
      '1106017018=                  IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '1106017019=                    SKIDKA_SUM_R_ = ROUND(PRICE_REC_ ' +
        '* SKIDKA_PROC_ / 100 , 2);'
      '1106017020=                END'
      '1106017021='
      
        '1106017022=                INSERT INTO G_DISCOUNT (G_DISCOUNT, G' +
        '_PRODUCT, DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA' +
        '_SUM, G_TOCHKA)'
      
        '1106017023=                VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G' +
        '_PRODUCT_REC_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :S' +
        'KIDKA_PROC_R_, :SKIDKA_SUM_R_'
      '1106017024=                        ,:G_TOCHKA_ID_)'
      '1106017025=                RETURNING G_DISCOUNT'
      '1106017026=                INTO :G_DISCOUNT_;'
      '1106017027=            END'
      '1106017028=    END'
      '1106017029=end'
      '1106017030=;'
      '1106017031='
      '1106017032=ALTER PROCEDURE G_INS_G_FIRM_ACCOUNT('
      '1106017033=  ACCOUNT_ TYPE OF COLUMN G_FIRM_ACCOUNT.ACCOUNT,'
      
        '1106017034=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_FI' +
        'RM_REKVIZIT,'
      '1106017035=  G_BANK_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_BANK,'
      
        '1106017036=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_ACCOUNT.IS_DEFAUL' +
        'T)'
      '1106017037=RETURNS ('
      '1106017038=  G_ACCOUNT_ TYPE OF COLUMN G_FIRM_ACCOUNT.G_ACCOUNT)'
      '1106017039=AS'
      '1106017040=DECLARE VARIABLE CNT_ INTEGER;'
      '1106017041=begin'
      '1106017042='
      
        '1106017043=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 0, '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070', '#1045#1057#1051#1048' '#1055#1054' '#1042#1057#1045#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' '#1053#1048#1043#1044#1045' '#1053#1045' '#1057#1058#1054#1048#1058' IS_DEFAULT = 1, '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1069#1058#1054' '#1047#1040#1055#1048#1057#1048
      '1106017044=  IF (:IS_DEFAULT_ = 0) THEN'
      '1106017045=    SELECT COUNT(*)'
      '1106017046=      FROM g_firm_account G'
      '1106017047=     WHERE G.IS_DEFAULT = 1'
      '1106017048=       AND G.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_'
      '1106017049=     INTO :CNT_;'
      '1106017050='
      
        '1106017051=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106017052=  ELSE IF (:IS_DEFAULT_ = 1) THEN'
      '1106017053=    UPDATE g_firm_account G'
      '1106017054=       SET G.IS_DEFAULT = 0'
      '1106017055=     WHERE G.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_;'
      '1106017056='
      
        '1106017057=  insert into G_FIRM_ACCOUNT (G_ACCOUNT, ACCOUNT, G_F' +
        'IRM_REKVIZIT, G_BANK, IS_DEFAULT)'
      
        '1106017058=  values (GEN_ID(GEN_G_ACCOUNT, 1), :ACCOUNT_, :G_FIR' +
        'M_REKVIZIT_, :G_BANK_, DECODE(:CNT_, 0, 1, :IS_DEFAULT_))'
      '1106017059=  returning G_ACCOUNT'
      '1106017060=  into :G_ACCOUNT_;'
      '1106017061=end'
      '1106017062=;'
      '1106017063='
      '1106017064=ALTER PROCEDURE G_INS_G_FIRM_ADDRESS('
      
        '1106017065=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_FIRM_ADDRESS.G_ADD' +
        'RESS_TYPE,'
      
        '1106017066=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_ADDRESS.G_FI' +
        'RM_REKVIZIT,'
      '1106017067=  ADDRESS_ TYPE OF COLUMN G_FIRM_ADDRESS.ADDRESS,'
      '1106017068=  PHONE_ TYPE OF COLUMN G_FIRM_ADDRESS.PHONE,'
      '1106017069=  FAX_ TYPE OF COLUMN G_FIRM_ADDRESS.FAX,'
      
        '1106017070=  IS_DEFAULT_ TYPE OF COLUMN G_FIRM_ADDRESS.IS_DEFAUL' +
        'T)'
      '1106017071=RETURNS ('
      '1106017072=  G_ADDRESS_ TYPE OF COLUMN G_FIRM_ADDRESS.G_ADDRESS)'
      '1106017073=AS'
      '1106017074=DECLARE VARIABLE CNT_ INTEGER;'
      '1106017075=begin'
      '1106017076='
      
        '1106017077=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 0, '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070', '#1045#1057#1051#1048' '#1055#1054' '#1042#1057#1045#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' '#1053#1048#1043#1044#1045' '#1053#1045' '#1057#1058#1054#1048#1058' IS_DEFAULT = 1, '#1058#1054' '#1057#1058#1040#1042#1051#1070' '#1069#1058#1054' '#1047#1040#1055#1048#1057#1048
      '1106017078=  IF (:IS_DEFAULT_ = 0) THEN'
      '1106017079=    SELECT COUNT(*)'
      '1106017080=      FROM g_firm_address G'
      '1106017081=     WHERE G.IS_DEFAULT = 1'
      '1106017082=       AND G.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_'
      '1106017083=    INTO CNT_;'
      '1106017084='
      
        '1106017085=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1045#1043#1054' '#1059' '#1044#1056#1059#1043#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049', '#1058'.'#1050'. '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1053#1040' '#1047#1040#1055#1048#1057#1068' "'#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070'"'
      '1106017086=  ELSE IF (:IS_DEFAULT_ = 1) THEN'
      '1106017087=    UPDATE g_firm_address G'
      '1106017088=       SET G.IS_DEFAULT = 0'
      '1106017089=     WHERE G.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_;'
      '1106017090='
      
        '1106017091=  insert into G_FIRM_ADDRESS (G_ADDRESS, G_ADDRESS_TY' +
        'PE, G_FIRM_REKVIZIT, ADDRESS, PHONE, FAX, IS_DEFAULT)'
      
        '1106017092=  values (GEN_ID(GEN_G_FIRM_ADDRESS, 1), :G_ADDRESS_T' +
        'YPE_, :G_FIRM_REKVIZIT_, :ADDRESS_, :PHONE_, :FAX_, DECODE(:CNT_' +
        ', 0, 1, :IS_DEFAULT_))'
      '1106017093=  returning G_ADDRESS'
      '1106017094=  into :G_ADDRESS_;'
      '1106017095=end'
      '1106017096=;'
      '1106017097='
      '1106017098=ALTER PROCEDURE G_INS_G_FIRM_REKVIZIT('
      '1106017099=  NAME_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      
        '1106017100=  SHORT_NAME_ TYPE OF COLUMN G_FIRM_REKVIZIT.SHORT_NA' +
        'ME,'
      '1106017101=  RNN_ TYPE OF COLUMN G_FIRM_REKVIZIT.RNN,'
      '1106017102=  IDN_ TYPE OF COLUMN G_FIRM_REKVIZIT.IDN,'
      '1106017103=  KBE_ TYPE OF COLUMN G_FIRM_REKVIZIT.KBE,'
      '1106017104=  OKPO_ TYPE OF COLUMN G_FIRM_REKVIZIT.OKPO,'
      '1106017105=  KPP_ TYPE OF COLUMN G_FIRM_REKVIZIT.KPP,'
      '1106017106=  OGRN_ TYPE OF COLUMN G_FIRM_REKVIZIT.OGRN,'
      '1106017107=  IS_NDS_ TYPE OF COLUMN G_FIRM_REKVIZIT.IS_NDS,'
      
        '1106017108=  NDS_SERIAL_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_SERI' +
        'AL,'
      '1106017109=  NDS_NUM_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_NUM,'
      '1106017110=  NDS_DATE_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_DATE,'
      
        '1106017111=  NDS_ORGAN_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_ORGAN' +
        ','
      
        '1106017112=  NDS_VALUE_ TYPE OF COLUMN G_FIRM_REKVIZIT.NDS_VALUE' +
        ','
      
        '1106017113=  NOL_VMESTO_BEZ_ TYPE OF COLUMN G_FIRM_REKVIZIT.NOL_' +
        'VMESTO_BEZ,'
      '1106017114=  HEAD_ TYPE OF COLUMN G_FIRM_REKVIZIT.HEAD,'
      
        '1106017115=  MAIN_CHIEF_ TYPE OF COLUMN G_FIRM_REKVIZIT.MAIN_CHI' +
        'EF,'
      '1106017116=  EMAIL_ TYPE OF COLUMN G_FIRM_REKVIZIT.EMAIL,'
      '1106017117=  WEBSITE_ TYPE OF COLUMN G_FIRM_REKVIZIT.WEBSITE,'
      
        '1106017118=  IP_OR_JUR_ TYPE OF COLUMN G_FIRM_REKVIZIT.IP_OR_JUR' +
        ')'
      '1106017119=RETURNS ('
      
        '1106017120=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_F' +
        'IRM_REKVIZIT)'
      '1106017121=AS'
      '1106017122=begin'
      
        '1106017123=    insert into G_FIRM_REKVIZIT (G_FIRM_REKVIZIT, NAM' +
        'E, SHORT_NAME, RNN, IDN, KPP, OGRN, KBE, OKPO, IS_NDS, NDS_SERIA' +
        'L, NDS_NUM,'
      
        '1106017124=                                 NDS_DATE, NDS_ORGAN,' +
        ' NDS_VALUE, NOL_VMESTO_BEZ, HEAD, MAIN_CHIEF, EMAIL, WEBSITE, IP' +
        '_OR_JUR)'
      
        '1106017125=    values (GEN_ID(GEN_G_FIRM_REKVIZIT, 1), :NAME_, :' +
        'SHORT_NAME_, :RNN_, :IDN_, :KPP_, :OGRN_, :KBE_, :OKPO_, :IS_NDS' +
        '_, :NDS_SERIAL_, :NDS_NUM_, :NDS_DATE_,'
      
        '1106017126=            :NDS_ORGAN_, :NDS_VALUE_, :NOL_VMESTO_BEZ' +
        '_, :HEAD_, :MAIN_CHIEF_, :EMAIL_, :WEBSITE_, :IP_OR_JUR_)'
      '1106017127=    returning G_FIRM_REKVIZIT'
      '1106017128=    into :G_FIRM_REKVIZIT_;'
      '1106017129=end'
      '1106017130=;'
      '1106017131='
      '1106017132=ALTER PROCEDURE G_INS_G_OFFICIAL('
      '1106017133=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '1106017134=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '1106017135=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '1106017136=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106017137=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '1106017138=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '1106017139=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '1106017140=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '1106017141=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '1106017142=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '1106017143=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '1106017144=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTM' +
        'ENT,'
      
        '1106017145=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVO' +
        'DITEL,'
      '1106017146=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '1106017147=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNI' +
        'TEL,'
      '1106017148=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '1106017149=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106017150=  RIGHTS_ARR_ VARCHAR(500),'
      
        '1106017151=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.DO_NOT' +
        '_SALES_COMM)'
      '1106017152=RETURNS ('
      '1106017153=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106017154=  ERR_CODE INTEGER,'
      '1106017155=  ERR_MSG VARCHAR(1024))'
      '1106017156=AS'
      
        '1106017157=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_I' +
        'TEM.RIGHTS_ITEM;'
      
        '1106017158=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGH' +
        'TS_ITEM;'
      '1106017159=begin'
      '1106017160='
      
        '1106017161=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '1106017162=      UPDATE G_OFFICIAL G'
      '1106017163=         SET G.IS_ISPOLNITEL = 0;'
      '1106017164='
      
        '1106017165=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057 +
        #1071' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '1106017166=      UPDATE G_OFFICIAL G'
      '1106017167=         SET G.IS_RUKOVODITEL = 0;'
      '1106017168='
      
        '1106017169=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1,' +
        ' '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '1106017170=      UPDATE G_OFFICIAL G'
      '1106017171=         SET G.IS_GLAVBUH = 0;'
      '1106017172='
      
        '1106017173=    insert into G_OFFICIAL (G_OFFICIAL, FM, NM, FT, F' +
        'IO_DOC, RNN, IDN, DT, G_ID_KIND, ID_NUM, ID_DATE, ID_ISSUER,'
      
        '1106017174=                            G_APPOINTMENT, IS_RUKOVOD' +
        'ITEL, IS_GLAVBUH, IS_ISPOLNITEL, PASS, G_TOCHKA, DO_NOT_SALES_CO' +
        'MM)'
      
        '1106017175=    values (GEN_ID(GEN_G_OFFICIAL, 1), :FM_, :NM_, :F' +
        'T_, :FIO_DOC_, :RNN_, :IDN_, :DT_, :G_ID_KIND_, :ID_NUM_, :ID_DA' +
        'TE_, :ID_ISSUER_,'
      
        '1106017176=            :G_APPOINTMENT_, :IS_RUKOVODITEL_, :IS_GL' +
        'AVBUH_, :IS_ISPOLNITEL_, :PASSWORD_, :G_TOCHKA_, :DO_NOT_SALES_C' +
        'OMM_)'
      '1106017177=    returning G_OFFICIAL'
      '1106017178=    into :G_OFFICIAL_;'
      '1106017179='
      '1106017180=    FOR SELECT T.RIGHTS_ITEM'
      '1106017181=        FROM RIGHTS_ITEM T'
      '1106017182=       WHERE T.IS_CATEGORY = 0'
      
        '1106017183=         AND :RIGHTS_ARR_ CONTAINING '#39'-'#39'||T.RIGHTS_IT' +
        'EM||'#39'-'#39
      '1106017184=        INTO :RIGHTS_ITEM_'
      '1106017185=    DO BEGIN'
      
        '1106017186=      INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT,' +
        ' RIGHTS_ITEM, G_OFFICIAL)'
      
        '1106017187=      VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGHT' +
        'S_ITEM_, :G_OFFICIAL_);'
      '1106017188=    END'
      '1106017189='
      
        '1106017190=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052 +
        #1048', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '1106017191=    SELECT COUNT(G.G_OFFICIAL)'
      '1106017192=      FROM G_OFFICIAL G'
      '1106017193=     WHERE EXISTS (SELECT 1'
      '1106017194=                     FROM G_OFFICIAL_RIGHT R'
      '1106017195=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '1106017196=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) ' +
        '= (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '1106017197=    INTO :CNT_;'
      '1106017198='
      '1106017199=    IF (:CNT_ = 0) THEN BEGIN'
      '1106017200=      ERR_CODE = -20500;'
      
        '1106017201=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1086#1073#1093#1086 +
        #1076#1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087 +
        #1088#1072#1074#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1106017202=      EXIT;'
      '1106017203=    END'
      '1106017204=end'
      '1106017205=;'
      '1106017206='
      '1106017207=ALTER PROCEDURE G_INS_G_PRIHOD_RASHOD('
      '1106017208=  ACTION_ TYPE OF COLUMN G_PRIHOD_RASHOD.DO_ACTION,'
      '1106017209=  NAME_ TYPE OF COLUMN G_PRIHOD_RASHOD.NAME)'
      '1106017210=RETURNS ('
      
        '1106017211=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_P' +
        'RIHOD_RASHOD)'
      '1106017212=AS'
      '1106017213=begin'
      
        '1106017214=    insert into G_PRIHOD_RASHOD (G_PRIHOD_RASHOD, DO_' +
        'ACTION, NAME)'
      
        '1106017215=    values (GEN_ID(GEN_G_PRIHOD_RASHOD, 1), :ACTION_,' +
        ' :NAME_)'
      '1106017216=    returning G_PRIHOD_RASHOD'
      '1106017217=    into :G_PRIHOD_RASHOD_;'
      '1106017218=end'
      '1106017219=;'
      '1106017220='
      '1106017221=ALTER PROCEDURE G_INS_G_UNIT('
      '1106017222=  NAME_ TYPE OF COLUMN G_UNIT.NAME,'
      '1106017223=  SHORT_NAME_ TYPE OF COLUMN G_UNIT.NAME)'
      '1106017224=RETURNS ('
      '1106017225=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1106017226=  ERR_CODE INTEGER,'
      '1106017227=  ERR_MSG VARCHAR(1024))'
      '1106017228=AS'
      '1106017229=begin'
      '1106017230=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      
        '1106017231=    VALUES (GEN_ID(GEN_G_UNIT, 1), :NAME_, :SHORT_NAM' +
        'E_)'
      '1106017232=    RETURNING G_UNIT'
      '1106017233=    INTO :G_UNIT_;'
      '1106017234=end'
      '1106017235=;'
      '1106017236='
      '1106017237=ALTER PROCEDURE G_PROMOTION_DEL('
      
        '1106017238=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ')'
      '1106017239=AS'
      '1106017240=BEGIN'
      '1106017241=  UPDATE G_PROMOTION G'
      '1106017242=     SET G.IS_ACTIVE = 0'
      '1106017243=  WHERE (G_PROMOTION = :G_PROMOTION_);'
