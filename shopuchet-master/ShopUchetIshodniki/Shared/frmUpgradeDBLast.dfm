      '110261103=     INTO :date_str,'
      '110261104=           :Z_DATE,'
      '110261105=           :ARTICUL,'
      '110261106=           :BARCODE,'
      '110261107=           :NAME,'
      '110261108=           :AMOUNT,'
      '110261109=           :SUMM'
      '110261110=  DO BEGIN'
