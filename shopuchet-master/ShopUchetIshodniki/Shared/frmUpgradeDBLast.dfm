      '1102122043=               '#39#1048#1058#1054#1043#1054' '#1042#1054#1047#1042#1056#1040#1058#39' STR,'
      
        '1102122044=               '#39'*'#39'||(:VOZVRAT_CASH_AMOUNT_ + :VOZVRAT' +
        '_NONCASH_AMOUNT_) AMOUNT,'
      
        '1102122045=               '#39'='#39'||(:VOZVRAT_CASH_SUMM_ + :VOZVRAT_N' +
        'ONCASH_SUMM_) SUMM'
      '1102122046=          FROM RDB$DATABASE'
