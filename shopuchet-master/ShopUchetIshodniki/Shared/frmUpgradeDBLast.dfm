      '1102283299='
      '1102283300=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102283301=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
