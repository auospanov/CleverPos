      '1102014488='
      
        '1102014489=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1102014490=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '1102014491=        '#39'AS '#39'||CRLF||'
      '1102014492=        '#39'BEGIN '#39'||CRLF||'
      
        '1102014493=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1102014494=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF|' +
