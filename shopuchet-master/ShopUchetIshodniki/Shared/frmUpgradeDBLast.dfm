        '110751408=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110751409=          EXIT;'
      '110751410=        END'
      '110751411=      END'
      '110751412='
      '110751413=      INSERT INTO KASSA_BEZNAL_STATE'
      
        '110751414=        (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CRE' +
        'DIT, OUTPUT)'
      '110751415=      VALUES'
      
        '110751416=        (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, CO' +
        'ALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0),' +
        ' COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDIT_' +
        ',0));'
      '110751417='
      
        '110751418=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068 +
        ' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751419=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
