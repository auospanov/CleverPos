      '110261007=               );'
      
        '110261008=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L)'
      '110261009=        VALUES(10, 2);'
      '110261010=  END'
      '110261011='
      '110261012=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1050#1051#1048#1045#1053#1058#1054#1052
      '110261013=  FIRST_ITER = 0;'
      
        '110261014=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2,' +
        ' '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39#39'0'#39 +
        #39')||'#39#39'.'#39#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receip' +
        't AS VARCHAR(10)) DATE_STR'
      '110261015=           ,S.date_receipt'
      '110261016=           ,GP.ARTICUL'
      '110261017=           ,GP.BARCODE'
      '110261018=           ,GP.NAME'
      '110261019=           ,SUM(SD.AMOUNT)  AMOUNT'
      '110261020=           ,SUM(SD.summ)    SUMM'
      '110261021=      FROM SKLAD_PARENT S'
      '110261022=           ,SKLAD SD'
      '110261023=           ,G_PRODUCT GP'
      '110261024=     WHERE S.is_vozvrat = 1'
      '110261025=       AND S.sklad = SD.sklad_parent'
      '110261026=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '110261027=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110261028=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110261029=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '110261030=     GROUP BY S.date_receipt, GP.articul, GP.barcode, ' +
        'GP.NAME'
      '110261031=     INTO :date_str,'
      '110261032=           :Z_DATE,'
      '110261033=           :ARTICUL,'
      '110261034=           :BARCODE,'
      '110261035=           :NAME,'
      '110261036=           :AMOUNT,'
      '110261037=           :SUMM'
      '110261038=  DO BEGIN'
      '110261039=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110261040=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110261041=      VALUES (11, 1, '#39#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1082#1083#1080#1077#1085#1090#1086#1084#39#39');'
      '110261042=      FIRST_ITER = 1;'
