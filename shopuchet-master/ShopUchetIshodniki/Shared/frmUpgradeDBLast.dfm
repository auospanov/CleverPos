      '1101522150=              :DISCOUNT_SUMM,'
      '1101522151=              :NDS,'
      '1101522152=              :NDS_SUMM'
      '1101522153=      DO BEGIN'
      '1101522154=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101522155=          UPDATE LT_SKLAD_PRODUCT L'
      '1101522156=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101522157=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101522158=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101522159='
      
        '1101522160=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101522161=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1101522162=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101522163=            Err_Code = -20500;'
      
        '1101522164=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101522165=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101522166=            EXIT;'
      '1101522167=          END ELSE if (ROW_COUNT = 0) then'
      
        '1101522168=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101522169=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1101522170='
      
        '1101522171=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1101522172=                                     G_PRODUCT,'
      '1101522173=                                     PRICE,'
      
        '1101522174=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1101522175=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1101522176=                                     NDS_SUMM)'
      
        '1101522177=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1101522178=                  :G_PRODUCT,'
      
        '1101522179=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1101522180=                  :AMOUNT, :SUMM,'
      '1101522181=                  0, --AMOUNT_PAYED,'
      '1101522182=                  0, --SUMM_PAYED,'
      '1101522183=                  0, --IS_PAYED_ALL,'
      '1101522184=                  :DISCOUNT_PERC,'
      '1101522185=                  :DISCOUNT_TENGE,'
      '1101522186=                  :DISCOUNT_SUMM,'
      '1101522187=                  :NDS,'
      '1101522188=                  :NDS_SUMM)'
      '1101522189=          RETURNING ZAKAZ_NA_REAL'
      '1101522190=          INTO :ZAKAZ_;'
      '1101522191=      END'
      '1101522192=  END'
      '1101522193=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101522194=  ----------------------------------------'
      '1101522195=  ----------------------------------------'
      '1101522196=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1101522197=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1101522198=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101522199=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1101522200=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1101522201=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1101522202=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1101522203=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1101522204=      RETURNING SKLAD'
      '1101522205=      INTO :SKLAD_;'
      '1101522206='
      '1101522207=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101522208=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101522209=          INTO :G_PRODUCT,'
      '1101522210=              :AMOUNT,'
      '1101522211=              :PRICE,'
      '1101522212=              :SUMM'
      '1101522213=      DO BEGIN'
      '1101522214=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101522215=        UPDATE LT_SKLAD_PRODUCT L'
      '1101522216=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101522217=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101522218=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101522219='
      '1101522220=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101522221=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1101522222=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1101522223=        SELECT MAX(SK.DATE_RECEIPT)'
      '1101522224=            FROM SKLAD SK'
      '1101522225=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101522226=             AND SK.IS_LAST = 1'
      '1101522227=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1101522228=            INTO :DATE_LAST_;'
      '1101522229='
      
        '1101522230=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101522231=            UPDATE SKLAD SK'
      '1101522232=               SET SK.IS_LAST = 0'
      '1101522233=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101522234=               AND SK.IS_LAST = 1'
      '1101522235=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101522236='
      '1101522237=            IS_THIS_LAST_ = 1;'
      '1101522238=        END */'
      '1101522239='
      '1101522240='
      '1101522241=        INSERT INTO SKLAD'
      '1101522242=        ('
      '1101522243=         SKLAD,'
      '1101522244=         SKLAD_PARENT,'
      '1101522245=         DATE_RECEIPT,'
      '1101522246=         G_CLIENT,'
      '1101522247=         G_PRODUCT,'
      '1101522248=         AMOUNT,'
      '1101522249=         PRICE,'
      '1101522250=         SUMM,'
      '1101522251=         G_PAYMENT_TYPE,'
      '1101522252=         OSNOVANIE,'
      '1101522253=         NOTE,'
      '1101522254=         NDS,'
      '1101522255=         NDS_SUMM,'
      '1101522256=         IS_LAST,'
      '1101522257=         IS_VOZVRAT,'
      '1101522258=         G_TOCHKA'
      '1101522259=        ) VALUES ('
      '1101522260=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101522261=         :SKLAD_,'
      '1101522262=         :Z_DATE_,'
      '1101522263=         :G_TOCHKA_,'
      '1101522264=         :G_PRODUCT,'
      '1101522265=         :AMOUNT,'
      '1101522266=         :PRICE,'
      '1101522267=         :SUMM,'
      '1101522268=         :G_PAYMENT_TYPE_,'
      '1101522269=         :OSNOVANIE_,'
      '1101522270=         :NOTE_,'
      '1101522271=         0,  --:RNDS_,'
      '1101522272=         0,  --:RNDS_SUMM_,'
      
        '1101522273=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1101522274=         3,  --:IS_VOZVRAT_,'
      '1101522275=         :G_CLIENT_'
      '1101522276=        );'
      '1101522277='
      
        '1101522278=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101522279=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1101522280=        PNT_ = '#39'02'#39';'
      '1101522281=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101522282=            UPDATE LT_SKLAD_PRODUCT L'
      '1101522283=               SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '1101522284=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101522285=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1101522286='
      '1101522287=            IF (ROW_COUNT = 0) THEN'
      
        '1101522288=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLA' +
        'D_PRODUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '1101522289=        END'
      '1101522290=      END'
      '1101522291=  END'
      '1101522292='
      '1101522293=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101522294='
      
        '1101522295=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1101522296=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101522297=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1101522298=                                  G_PRIHOD_,'
      '1101522299=                                  :SUMM_PRIHOD_,'
      '1101522300=                                  :Z_DATE_,'
      
        '1101522301=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101522302=                                  :ZAKAZ_,'
      '1101522303=                                  NULL,'
      '1101522304=                                  :G_PAYMENT_TYPE_,'
      
        '1101522305=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101522306=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101522307=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101522308=      EXIT;'
      '1101522309=    END'
      '1101522310=  END'
      '1101522311='
      
        '1101522312=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1101522313=  IF (IS_MEBEL_ = 1) THEN'
      
        '1101522314=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1101522315=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1101522316=end'
      '1101522317=;'
      '1101522318='
      '1101522319=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '1101522320=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT,'
      '1101522321=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101522322=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101522323=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1101522324=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1101522325=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1101522326=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1101522327=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101522328=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101522329=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ','
      '1101522330=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1101522331=  IS_SPISANIE_ INTEGER,'
      '1101522332=  NEW_LINE_SALE_ INTEGER = 0,'
      '1101522333=  MODE_ INTEGER = 0,'
      '1101522334=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '1101522335=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '1101522336=  MARK_CODE_ VARCHAR(100) = '#39#39')'
      '1101522337=RETURNS ('
      
        '1101522338=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1101522339=  ERR_CODE INTEGER,'
      '1101522340=  ERR_MSG VARCHAR(1024))'
      '1101522341=AS'
      '1101522342=/*'
      
        '1101522343=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063 +
        #1048#1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '1101522344=*/'
      
        '1101522345=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39';'
      '1101522346=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '1101522347=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0;'
      
        '1101522348=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0;'
      
        '1101522349=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1101522350=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1101522351=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '1101522352=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      
        '1101522353=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.PRICE;'
      
        '1101522354=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.COST_PRICE;'
      
        '1101522355=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '1101522356=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101522357=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040 +
        #1041#1051#1048#1062#1045' */'
      
        '1101522358=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058 +
        ' '#1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '1101522359=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      '1101522360=BEGIN'
      '1101522361='
      
        '1101522362=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071 +
        #1070#1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '1101522363=  SELECT T.ZAKAZ, T.Z_TYPE'
      '1101522364=    FROM ZAKAZ_DETAILS_TMP T'
      '1101522365=   WHERE T.ZAKAZ IS NOT NULL'
      
        '1101522366=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' ' +
        #1089#1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082 +
        #1072' MULTIPLE ROWS IN SINGLETON SELECT'
      '1101522367=    INTO :ZAKAZ_, :Z_TYPE_;'
      '1101522368='
      
        '1101522369=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045 +
        #1051#1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101522370=           ,G.IS_KIT'
      '1101522371=           ,K.AMOUNT * :AMOUNT_'
      '1101522372=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '1101522373=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PR' +
        'ICE)'
      '1101522374=           ,(CASE'
      
        '1101522375=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANI' +
        'E_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT *' +
        ' FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '1101522376=             ELSE K.PRICE'
      '1101522377=           END) COST_PRICE'
      
        '1101522378=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_' +
        'LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '1101522379=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE' +
        ' G_PRODUCT = :G_PRODUCT_) CNT'
      
        '1101522380=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT ' +
        'K ON G.G_PRODUCT = K.G_PRODUCT'
      '1101522381=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101522382=       AND G.IS_KIT = 1'
      '1101522383=    UNION'
      
        '1101522384=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056 +
        #1054#1044#1040#1046
      '1101522385=           ,G.IS_KIT'
      '1101522386=           ,:AMOUNT_'
      '1101522387=           ,:PRICE_'
      '1101522388=           ,0'
      '1101522389=           ,:COST_PRICE_'
      '1101522390=           ,0'
      '1101522391=      FROM G_PRODUCT G'
      '1101522392=     WHERE G_PRODUCT = :G_PRODUCT_'
      '1101522393=       AND G.IS_KIT <> 1'
      '1101522394=      INTO :G_PRODUCT_'
      '1101522395=           ,:IS_KIT_'
      '1101522396=           ,:AMOUNT_'
      '1101522397=           ,:PRICE__'
      '1101522398=           ,:SOSTAV_PRICE_'
      '1101522399=           ,:COST_PRICE__'
      '1101522400=           ,:SOSTAV_COUNT_'
      '1101522401=  DO BEGIN'
      '1101522402=      ZAKAZ_DTLS_TMP_ = NULL;'
      '1101522403='
      
        '1101522404=      --=============================================' +
        '=============='
      '1101522405=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101522406=      SELECT AMOUNT - AMOUNT_RESERVE'
      '1101522407=        FROM LT_SKLAD_PRODUCT L'
      '1101522408=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '1101522409=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101522410=       INTO :AMOUNT_CUR_;'
      '1101522411='
      
        '1101522412=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1101522413=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1101522414=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1101522415=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1101522416=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101522417=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '1101522418=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1101522419=          SELECT SUM(AMOUNT)'
      '1101522420=            FROM ZAKAZ_DETAILS T'
      '1101522421=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101522422=             AND T.ZAKAZ = :ZAKAZ_'
      '1101522423=            INTO :AMOUNT_OLD_;'
      '1101522424=        ELSE'
      '1101522425=          SELECT SUM(AMOUNT)'
      '1101522426=            FROM SKLAD T'
      '1101522427=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101522428=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1101522429=            INTO :AMOUNT_OLD_;'
      '1101522430=      END'
      '1101522431='
      '1101522432=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1101522433=      SELECT SUM(AMOUNT)'
      '1101522434=        FROM ZAKAZ_DETAILS_TMP T'
      '1101522435=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101522436=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1101522437='
      
        '1101522438=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_,' +
        ' 0) + :AMOUNT_;'
      '1101522439=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '1101522440='
      
        '1101522441=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042 +
        ' '#1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1101522442='
      
        '1101522443=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1101522444=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047 +
        #1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1101522445=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) ' +
        'THEN BEGIN'
      '1101522446=            PNT_ = '#39'01'#39';'
      
        '1101522447=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID F' +
        'ROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101522448=                                         CURRENT_DATE' +
        ','
      '1101522449=                                         :G_PRODUCT_,'
      
        '1101522450=                                         ABS(AMOUNT_C' +
        'UR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOU' +
        'NT_,'
      
        '1101522451=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074 +
        #1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1101522452=                                         )'
      
        '1101522453=                RETURNING_VALUES :SKLAD_, :COST_PRICE' +
        '__, :ERR_CODE, :ERR_MSG;'
      '1101522454=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101522455=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101522456=              EXIT;'
      '1101522457=            END'
      '1101522458=        END'
      
        '1101522459=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_P' +
        'RODUCT_ <> -2) THEN BEGIN'
      '1101522460=            SELECT NAME'
      '1101522461=            FROM G_PRODUCT'
      '1101522462=            WHERE G_PRODUCT = :G_PRODUCT_'
      '1101522463=            INTO :PRODUCT_NAME_;'
      '1101522464='
      '1101522465=            ERR_CODE = -20500;'
      
        '1101522466=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_' +
        'NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1101522467=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1101522468=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1101522469=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1101522470=            EXIT;'
      '1101522471=        END'
      '1101522472=      END'
      '1101522473=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101522474=      --=============================================' +
        '=============='
      '1101522475='
      
        '1101522476=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077 +
        #1090#1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087 +
        #1083#1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '1101522477=      IF (IS_KIT_ = 1) THEN BEGIN'
      '1101522478='
      '1101522479=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '1101522480=        --    PRICE__ = SOSTAV_PRICE_;'
      '1101522481=        --END ELSE BEGIN'
      '1101522482=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '1101522483=              PRICE__ = COST_PRICE__;'
      '1101522484='
      
        '1101522485=            END ELSE IF (Discount_perc_ <> 0) THEN BE' +
        'GIN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '1101522486=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PE' +
        'RC_/100;'
      '1101522487='
      '1101522488='
      
        '1101522489=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THE' +
        'N BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '1101522490=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / S' +
        'OSTAV_PRICE_;'
      
        '1101522491=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE' +
        '_;'
      '1101522492=            END'
      '1101522493='
      
        '1101522494=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUN' +
        'T_;'
      
        '1101522495=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMO' +
        'UNT_;'
      '1101522496=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '1101522497=        --END'
      '1101522498=      END'
      '1101522499='
      
        '1101522500=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' ' +
        #1045#1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '1101522501=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041 +
        #1048#1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '1101522502=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_COD' +
        'E_) = 0) THEN'
      '1101522503=          SELECT ZD.zakaz_details'
      '1101522504=            FROM zakaz_details_tmp ZD'
      '1101522505=           WHERE ZD.G_PRODUCT = :g_product_'
      '1101522506=             AND ZD.PRICE = :PRICE__'
      '1101522507=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '1101522508=            INTO :ZAKAZ_DTLS_TMP_;'
      '1101522509='
      '1101522510='
      '1101522511=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '1101522512=        UPDATE ZAKAZ_DETAILS_TMP P'
      '1101522513=           SET P.amount = P.amount + :amount_'
      
        '1101522514=               ,P.summ = (P.price - P.discount_TENGE)' +
        ' * (P.amount + :AMOUNT_)'
      
        '1101522515=               ,P.discount_summ = P.discount_TENGE * ' +
        '(P.amount + :AMOUNT_)'
      '1101522516=               ,P.NDS = :NDS_'
      '1101522517=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '1101522518=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '1101522519='
      '1101522520=      ELSE BEGIN'
      '1101522521=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '1101522522=          ('
      '1101522523=           ZAKAZ_DETAILS,'
      '1101522524=           ZAKAZ,'
      '1101522525=           G_PRODUCT,'
      '1101522526=           AMOUNT,'
      '1101522527=           PRICE,'
      '1101522528=           SUMM,'
      '1101522529=           DISCOUNT_PERC,'
      '1101522530=           DISCOUNT_TENGE,'
      '1101522531=           DISCOUNT_SUMM,'
      '1101522532=           NDS,'
      '1101522533=           NDS_SUMM,'
      '1101522534=           COST_PRICE,'
      '1101522535=           MARK_CODE'
      '1101522536=          ) VALUES ('
      '1101522537=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101522538=           :ZAKAZ_,'
      '1101522539=           :G_PRODUCT_,'
      '1101522540=           :AMOUNT_,'
      '1101522541=           :PRICE__,'
      '1101522542=           :SUMM_,'
      '1101522543=           :DISCOUNT_PERC_,'
      '1101522544=           :DISCOUNT_TENGE_,'
      '1101522545=           :DISCOUNT_SUMM_,'
      '1101522546=           :NDS_,'
      '1101522547=           :NDS_SUMM_,'
      '1101522548=           :COST_PRICE__,'
      '1101522549=           :MARK_CODE_'
      '1101522550=          )'
      '1101522551=          RETURNING'
      '1101522552=            ZAKAZ_DETAILS'
      '1101522553=          INTO'
      '1101522554=            :ZAKAZ_DETAILS_;'
      '1101522555=      END'
      '1101522556=  END'
      '1101522557=end'
      '1101522558=;'
      '1101522559='
      '1101522560=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1101522561=RETURNS ('
      
        '1101522562=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '1101522563=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '1101522564=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '1101522565=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101522566=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101522567=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1101522568=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '1101522569=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '1101522570=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '1101522571=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1101522572=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1101522573=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101522574=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101522575=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101522576=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101522577=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PR' +
        'ICE,'
      '1101522578=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101522579=  IS_MARKED INTEGER,'
      
        '1101522580=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TM' +
        'P.SUMM)'
      '1101522581=AS'
      '1101522582=begin'
      '1101522583='
      '1101522584=  FOR'
      '1101522585=    SELECT T.ZAKAZ_DETAILS,'
      '1101522586=           T.ZAKAZ,'
      '1101522587=           T.G_PRODUCT,'
      '1101522588=           T.AMOUNT,'
      '1101522589=           T.PRICE,'
      '1101522590=           T.SUMM,'
      '1101522591=           T.DISCOUNT_PERC,'
      '1101522592=           T.DISCOUNT_TENGE,'
      '1101522593=           T.DISCOUNT_SUMM,'
      '1101522594=           T.NDS,'
      '1101522595=           T.NDS_SUMM,'
      '1101522596=           P.NAME PRODUCT_NAME'
      '1101522597=           ,P.BARCODE'
      '1101522598=           ,P.ARTICUL'
      '1101522599=           ,P.PRICE'
      '1101522600=           ,P.IS_KIT'
      
        '1101522601=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_T' +
        'MP TM, G_PRODUCT GP'
      
        '1101522602=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.D' +
        'O_NOT_CHARGE_BONUS = 0)'
      '1101522603=           ,T.COST_PRICE'
      '1101522604=           ,P.IS_MARKED'
      '1101522605=      FROM ZAKAZ_DETAILS_TMP T,'
      '1101522606=           G_PRODUCT P'
      '1101522607=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101522608=    ORDER BY t.ZAKAZ_DETAILS'
      '1101522609=    INTO :ZAKAZ_DETAILS,'
      '1101522610=          :ZAKAZ,'
      '1101522611=          :G_PRODUCT,'
      '1101522612=          :AMOUNT,'
      '1101522613=          :PRICE,'
      '1101522614=          :SUMM,'
      '1101522615=          :DISCOUNT_PERC,'
      '1101522616=          :DISCOUNT_TENGE,'
      '1101522617=          :DISCOUNT_SUMM,'
      '1101522618=          :NDS,'
      '1101522619=          :NDS_SUMM,'
      '1101522620=          :PRODUCT_NAME'
      '1101522621=          ,:BARCODE'
      '1101522622=          ,:ARTICUL'
      '1101522623=          ,:PRODUCT_PRICE'
      '1101522624=          ,:IS_KIT'
      '1101522625=          ,:SUM_TO_CHARGE_BONUS'
      '1101522626=          ,:COST_PRICE'
      '1101522627=          ,:IS_MARKED'
      '1101522628=  DO'
      '1101522629=    suspend;'
      '1101522630=end'
      '1101522631=;'
      '1101522632='
      '1101522633='
      
        '1101522634=/****************************************************' +
        '**************************/'
      
        '1101522635=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101522636=/****************************************************' +
        '**************************/'
      '1101522637=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101522638=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101522639=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM,'
      '1101522640=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101522641=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101522642=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101522643=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101522644=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101522645=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101522646=  SELF_PRICE_ NUMERIC(15,2),'
      '1101522647=  AMOUNT_ MY_NUMERIC_5,'
      '1101522648=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101522649=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101522650=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101522651=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101522652=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1101522653=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101522654=  CATEGORY_NAME_ VARCHAR(1000),'
      '1101522655=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101522656=  IS_THIS_LAST_ INTEGER,'
      '1101522657=  UPDATE_IF_EXIST_ INTEGER)'
      '1101522658=RETURNS ('
      '1101522659=  ERR_CODE INTEGER,'
      '1101522660=  ERR_MSG VARCHAR(1024))'
      '1101522661=AS'
      
        '1101522662=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_P' +
        'RODUCT'#39';'
      '1101522663=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101522664=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101522665=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT_PAR;'
      
        '1101522666=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1101522667=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT' +
        ';'
      
        '1101522668=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT = 0;'
      
        '1101522669=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1101522670=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD;'
      
        '1101522671=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1101522672=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM_CURRENCY;'
      '1101522673=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1101522674=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101522675=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      
        '1101522676=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1101522677=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1101522678=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1101522679=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1101522680=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1101522681=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1101522682=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1101522683=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101522684=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1101522685=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1101522686=BEGIN'
      '1101522687=    ERR_MSG = '#39#39';'
      '1101522688=    PNT_ = '#39'00'#39';'
      '1101522689='
      
        '1101522690=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044 +
        #1045#1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '1101522691=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS889' +
        '88~98888~"'
      
        '1101522692=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' ' +
        #1053#1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '1101522693=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '1101522694=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39 +
        '~'#39');'
      '1101522695=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '1101522696=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '1101522697=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '1101522698=    END ELSE'
      '1101522699=        CROSSCODE_ = NULL;'
      '1101522700='
      '1101522701=    PNT_ = '#39'01'#39';'
      '1101522702=    SELECT ID'
      '1101522703=      FROM CUR_PARAMS'
      '1101522704=    WHERE CUR_PARAMS = 2'
      '1101522705=      INTO :G_TOCHKA_;'
      '1101522706='
      '1101522707=    SELECT G.G_UNIT'
      '1101522708=      FROM G_UNIT G'
      
        '1101522709=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAM' +
        'E_G_UNIT_))'
      '1101522710=      INTO :G_UNIT_;'
      '1101522711=    if (ROW_COUNT = 0) then'
      '1101522712=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1101522713='
      '1101522714=    PNT_ = '#39'02'#39';'
      
        '1101522715=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101522716=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1101522717=        SELECT G.G_PRODUCT,'
      '1101522718=               G.NAME'
      '1101522719=          FROM G_PRODUCT G'
      
        '1101522720=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1101522721=           AND TRIM(G.ARTICUL) <> '#39#39
      '1101522722=           AND G.IS_ACTIVE = 1'
      '1101522723=          INTO :G_PRODUCT_,'
      '1101522724=               :G_PRODUCT_NAME_;'
      '1101522725='
      
        '1101522726=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101522727=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101522728=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101522729=              UPDATE G_PRODUCT G'
      '1101522730=                 SET G.NAME = :NAME_,'
      '1101522731=                     G.G_UNIT = :G_UNIT_,'
      '1101522732=                     G.PRICE  = :PRICE_,'
      '1101522733=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101522734=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101522735=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101522736=                     G.PLACE = :PLACE_,'
      
        '1101522737=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101522738=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101522739=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101522740=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101522741=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101522742=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101522743='
      
        '1101522744=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101522745=            END ELSE'
      
        '1101522746=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101522747=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAM' +
        'E_||'#39'.'#39';'
      '1101522748=        END'
      '1101522749=    END ELSE'
      
        '1101522750=      EXECUTE PROCEDURE get_free_articul RETURNING_VA' +
        'LUES (:ARTICUL_);'
      '1101522751='
      
        '1101522752=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '1101522753=    PNT_ = '#39'02a'#39';'
      
        '1101522754=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '1101522755=        SELECT G.G_PRODUCT,'
      '1101522756=               G.NAME'
      '1101522757=          FROM G_PRODUCT G'
      
        '1101522758=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_' +
        'NUM_)'
      '1101522759=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '1101522760=           AND G.IS_ACTIVE = 1'
      '1101522761=          INTO :G_PRODUCT_,'
      '1101522762=               :G_PRODUCT_NAME_;'
      '1101522763='
      
        '1101522764=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101522765=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101522766=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101522767=              UPDATE G_PRODUCT G'
      '1101522768=                 SET G.NAME = :NAME_,'
      '1101522769=                     G.G_UNIT = :G_UNIT_,'
      '1101522770=                     G.PRICE  = :PRICE_,'
      '1101522771=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101522772=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101522773=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101522774=                     G.PLACE = :PLACE_,'
      
        '1101522775=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101522776=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101522777=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101522778=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101522779=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101522780=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101522781='
      
        '1101522782=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1101522783=            END ELSE'
      
        '1101522784=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101522785=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1101522786=        END'
      '1101522787=    end'
      '1101522788='
      
        '1101522789=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1101522790=    PNT_ = '#39'02b'#39';'
      
        '1101522791=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1101522792=        SELECT G.G_PRODUCT,'
      '1101522793=               G.NAME'
      '1101522794=          FROM G_PRODUCT G'
      '1101522795=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1101522796=           AND TRIM(G.BARCODE) <> '#39#39
      '1101522797=           AND G.IS_ACTIVE = 1'
      '1101522798=          INTO :G_PRODUCT_,'
      '1101522799=               :G_PRODUCT_NAME_;'
      '1101522800='
      '1101522801=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1101522802=          SELECT G.G_PRODUCT,'
      '1101522803=                 G.NAME'
      '1101522804=            FROM G_PRODUCT G, LT_BARCODE L'
      '1101522805=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101522806=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1101522807=             AND TRIM(L.BARCODE) <> '#39#39
      '1101522808=            INTO :G_PRODUCT_,'
      '1101522809=                 :G_PRODUCT_NAME_;'
      '1101522810='
      
        '1101522811=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101522812=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101522813=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101522814=              UPDATE G_PRODUCT G'
      '1101522815=                 SET G.NAME = :NAME_,'
      '1101522816=                     G.G_UNIT = :G_UNIT_,'
      '1101522817=                     G.PRICE  = :PRICE_,'
      '1101522818=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101522819=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101522820=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101522821=                     G.PLACE = :PLACE_,'
      
        '1101522822=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101522823=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101522824=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101522825=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101522826=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101522827=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101522828='
      
        '1101522829=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101522830=            END ELSE'
      
        '1101522831=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101522832=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1101522833=        END'
      
        '1101522834=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1101522835=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1101522836='
      
        '1101522837=    --===============================================' +
        '=========='
      '1101522838=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '1101522839=    --===============================================' +
        '=========='
      '1101522840=    PNT_ = '#39'02b'#39';'
      '1101522841=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '1101522842='
      
        '1101522843=        ---------------------------------------------' +
        '---------------------'
      
        '1101522844=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048 +
        ' '#1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '1101522845=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082 +
        #1080'~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '1101522846=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '1101522847=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054',' +
        ' '#1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '1101522848=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BE' +
        'GIN'
      '1101522849=            G_PRODUCT_PAR_ = NULL;'
      
        '1101522850=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAM' +
        'E_);'
      '1101522851=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '1101522852=              STR_ = CATEGORY_NAME_;'
      '1101522853=              CATEGORY_NAME_ = '#39#39';'
      '1101522854=            END ELSE'
      
        '1101522855=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1101522856='
      '1101522857=            SELECT G_PRODUCT'
      '1101522858=              FROM G_PRODUCT G'
      '1101522859=             WHERE G.NAME = :STR_'
      '1101522860=               AND G.IS_CATEGORY = 1'
      
        '1101522861=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1101522862=                   OR'
      '1101522863=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '1101522864=              INTO G_PRODUCT_PAR_;'
      '1101522865=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1101522866=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1101522867=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1101522868=                RETURNING G_PRODUCT'
      '1101522869=                INTO :G_PRODUCT_PAR_;'
      '1101522870='
      '1101522871=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1101522872=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1101522873=        END'
      
        '1101522874=        ---------------------------------------------' +
        '---------------------'
      '1101522875='
      
        '1101522876=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1101522877=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '1101522878=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1101522879=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '1101522880=        RETURNING G_PRODUCT'
      '1101522881=        INTO :G_PRODUCT_;'
      '1101522882='
      
        '1101522883=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101522884=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_);'
      '1101522885=    end'
      '1101522886='
      
        '1101522887=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101522888=    PNT_ = '#39'03'#39';'
      '1101522889=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1101522890=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1101522891=                                       :AMOUNT_,'
      '1101522892=                                       :SELF_PRICE_,'
      
        '1101522893=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1101522894=                                       0, --nds_,'
      '1101522895=                                       0 --nds_summ_,'
      
        '1101522896=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1101522897=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1101522898=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1101522899=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1101522900=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1101522901=          EXIT;'
      '1101522902=        END'
      '1101522903=    END'
      '1101522904='
      
        '1101522905=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1101522906=    PNT_ = '#39'04'#39';'
      '1101522907=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1101522908=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1101522909=        FROM SKLAD_TMP T'
      '1101522910=        INTO :CNT_;'
      '1101522911='
      '1101522912=      if (CNT_ > 0) then BEGIN'
      '1101522913=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1101522914=          FROM SKLAD_TMP T'
      '1101522915=          INTO :SUMM_, :SUMM_UE_;'
      '1101522916='
      '1101522917=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101522918=                                DATE_RECEIPT,'
      '1101522919=                                TIME_RECEIPT,'
      '1101522920=                                G_CLIENT,'
      '1101522921=                                G_PAYMENT_TYPE,'
      '1101522922=                                OSNOVANIE,'
      '1101522923=                                NOTE,'
      '1101522924=                                SUMM,'
      '1101522925=                                SUMM_FACT,'
      '1101522926=                                SUMM_CURRENCY,'
      '1101522927=                                IS_PAYED_ALL,'
      '1101522928=                                IS_VOZVRAT,'
      '1101522929=                                G_TOCHKA)'
      '1101522930=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101522931=                CURRENT_DATE,'
      '1101522932=                CURRENT_TIME,'
      '1101522933=                :G_CLIENT_,'
      '1101522934=                1,'
      '1101522935=                NULL,  --:OSNOVANIE_,'
      '1101522936=                NULL,  -- :NOTE_,'
      '1101522937=                :SUMM_,'
      '1101522938=                :SUMM_,'
      '1101522939=                :SUMM_UE_,'
      
        '1101522940=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1101522941=                0,'
      '1101522942=                :G_TOCHKA_)'
      '1101522943=        RETURNING'
      '1101522944=          SKLAD'
      '1101522945=        INTO'
      '1101522946=          :SKLAD_PARENT_;'
      '1101522947='
      '1101522948=        PNT_ = '#39'05'#39';'
      '1101522949=        FOR SELECT SKLAD,'
      '1101522950=                   G_PRODUCT,'
      '1101522951=                   AMOUNT,'
      '1101522952=                   PRICE,'
      '1101522953=                   SUMM'
      '1101522954=                   ,PRICE_CURRENCY'
      '1101522955=                   ,SUMM_CURRENCY'
      '1101522956=              FROM SKLAD_TMP'
      '1101522957=             ORDER BY 1'
      '1101522958=              INTO :SKLAD_TMP_,'
      '1101522959=                   :RG_PRODUCT_,'
      '1101522960=                   :RAMOUNT_,'
      '1101522961=                   :RPRICE_,'
      '1101522962=                   :RSUMM_'
      '1101522963=                   ,:RPRICE_UE_'
      '1101522964=                   ,:RSUMM_UE_'
      '1101522965=        DO BEGIN'
      '1101522966='
      '1101522967=            UPDATE SKLAD SK'
      '1101522968=               SET SK.IS_LAST = 0'
      '1101522969=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101522970=               AND SK.IS_LAST = 1;'
      '1101522971='
      '1101522972=            INSERT INTO SKLAD'
      '1101522973=            ('
      '1101522974=             SKLAD,'
      '1101522975=             SKLAD_PARENT,'
      '1101522976=             DATE_RECEIPT,'
      '1101522977=             G_CLIENT,'
      '1101522978=             G_PRODUCT,'
      '1101522979=             AMOUNT,'
      '1101522980=             PRICE,'
      '1101522981=             SUMM,'
      '1101522982=             G_PAYMENT_TYPE,'
      '1101522983=             OSNOVANIE,'
      '1101522984=             NOTE,'
      '1101522985=             NDS,'
      '1101522986=             NDS_SUMM,'
      '1101522987=             IS_LAST,'
      '1101522988=             IS_VOZVRAT,'
      '1101522989=             G_TOCHKA'
      '1101522990=             ,PRICE_CURRENCY'
      '1101522991=             ,SUMM_CURRENCY'
      '1101522992=            ) VALUES ('
      '1101522993=             :SKLAD_TMP_,'
      '1101522994=             :SKLAD_PARENT_,'
      '1101522995=             CURRENT_DATE,'
      '1101522996=             :G_CLIENT_,'
      '1101522997=             :RG_PRODUCT_,'
      '1101522998=             :RAMOUNT_,'
      '1101522999=             :RPRICE_,'
      '1101523000=             :RSUMM_,'
      '1101523001=             1,       --:G_PAYMENT_TYPE_,'
      '1101523002=             NULL,    --:OSNOVANIE_,'
      '1101523003=             NULL,    --:NOTE_,'
      '1101523004=             0,       --:RNDS_,'
      '1101523005=             0,       --:RNDS_SUMM_,'
      '1101523006=             1,       --IS_LAST_'
      '1101523007=             0,        --:IS_VOZVRAT_'
      '1101523008=             :G_TOCHKA_'
      '1101523009=             ,:RPRICE_UE_'
      '1101523010=             ,:RSUMM_UE_'
      '1101523011=            );'
      '1101523012='
      
        '1101523013=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101523014=            PNT_ = '#39'06'#39';'
      '1101523015=            UPDATE LT_SKLAD_PRODUCT L'
      '1101523016=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1101523017=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101523018=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101523019='
      '1101523020=            PNT_ = '#39'06a'#39';'
      '1101523021=            IF (ROW_COUNT = 0) THEN'
      
        '1101523022=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101523023=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '1101523024=        END'
      '1101523025='
      '1101523026=        PNT_ = '#39'07'#39';'
      
        '1101523027=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101523028=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1101523029=                                :SUMM_,'
      '1101523030=                                CURRENT_DATE,'
      
        '1101523031=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1101523032=                                NULL,   --ZAKAZ_'
      '1101523033=                                :SKLAD_PARENT_,'
      '1101523034=                                1,'
      
        '1101523035=                                :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101523036=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101523037=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101523038=          EXIT;'
      '1101523039=        END'
      '1101523040='
      '1101523041=        DELETE FROM SKLAD_TMP;'
      '1101523042=      END'
      '1101523043=    END'
      '1101523044='
      
        '1101523045=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1101523046=    if (ERR_MSG_ IS NOT NULL) then'
      '1101523047=      ERR_MSG = ERR_MSG_;'
      '1101523048='
      '1101523049=WHEN ANY DO BEGIN'
      '1101523050=    Err_code = gdscode;'
      
        '1101523051=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1101523052=  END'
      '1101523053=END'
      '1101523054=;'
      '1101523055='
      '1101523056=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1101523057=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101523058=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101523059=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101523060=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101523061=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101523062=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101523063=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101523064=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101523065=RETURNS ('
      '1101523066=  ERR_CODE INTEGER,'
      '1101523067=  ERR_MSG VARCHAR(1024))'
      '1101523068=AS'
      '1101523069=/*'
      
        '1101523070='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1101523071='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1101523072='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1101523073=*/'
      
        '1101523074=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1101523075=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101523076=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1101523077=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1101523078=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1101523079=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1101523080=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1101523081=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1101523082=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1101523083=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101523084=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1101523085=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1101523086=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1101523087=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101523088=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101523089=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101523090=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101523091=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101523092=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1101523093=BEGIN'
      '1101523094='
      '1101523095=  PNT_ = '#39'00'#39';'
      '1101523096=  CLRF = ascii_char( 10 );'
      '1101523097='
      '1101523098=  SELECT S.S_VALUE'
      '1101523099=    FROM SYSTEM_SETUP S'
      '1101523100=   WHERE S.SYSTEM_SETUP = 2'
      '1101523101=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1101523102='
      '1101523103=  PNT_ = '#39'01'#39';'
      '1101523104=  SELECT G.nds_value'
      '1101523105=    FROM G_FIRM_REKVIZIT G'
      '1101523106=   WHERE G.is_default = 1'
      '1101523107=    INTO :NDS_;'
      '1101523108='
      '1101523109=  PNT_ = '#39'02'#39';'
      
        '1101523110=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1101523111=        FROM IMPORT_TBL_TMP'
      
        '1101523112=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1101523113=  DO BEGIN'
      '1101523114=    SELECT G_PRODUCT,'
      '1101523115=           PRICE'
      '1101523116=      FROM ('
      '1101523117=            SELECT P.G_PRODUCT, P.price'
      '1101523118=              FROM G_PRODUCT P'
      
        '1101523119=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1101523120=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1101523121=            UNION'
      '1101523122=            SELECT LT.G_PRODUCT, P.PRICE'
      '1101523123=              FROM LT_BARCODE LT, g_product P'
      
        '1101523124=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1101523125=               AND LT.g_product = P.g_product'
      '1101523126=           )'
      '1101523127=      INTO :G_PRODUCT_,'
      '1101523128=           :PRICE_OUR_;'
      '1101523129='
      '1101523130=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1101523131=      ERR_CODE = -20500;'
      
        '1101523132=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1101523133=      Exit;'
      '1101523134=    END'
      '1101523135='
      '1101523136=    PNT_ = '#39'03'#39';'
      
        '1101523137=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1101523138=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1101523139=      RETURNING_VALUES :COST_PRICE_;'
      '1101523140='
      '1101523141=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1101523142=    IF (price_ IS NULL) THEN'
      '1101523143=      PRICE_ = PRICE_OUR_;'
      '1101523144='
      '1101523145=    PNT_ = '#39'04'#39';'
      
        '1101523146=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1101523147=                                              :AMOUNT' +
        '_,'
      
        '1101523148=                                              :PRICE_' +
        ','
      
        '1101523149=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1101523150=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1101523151=                                              :DISCOU' +
        'NT_,'
      
        '1101523152=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1101523153=                                              :NDS_,'
      
        '1101523154=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1101523155=                                              :COST_P' +
        'RICE_,'
      
        '1101523156=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1101523157=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1101523158=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1101523159=                                              0     -' +
        '-MODE_'
      
        '1101523160=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1101523161=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101523162=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101523163=      EXIT;'
      '1101523164=    END'
      '1101523165='
      '1101523166=    G_PRODUCT_ = NULL;'
      '1101523167=  END'
      '1101523168='
      '1101523169=  PNT_ = '#39'05'#39';'
      '1101523170=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1101523171=    SELECT SUM(T.summ)'
      '1101523172=      FROM ZAKAZ_DETAILS_TMP T'
      '1101523173=      INTO :SUMM_;'
      '1101523174=    SUMM_FACT_ = SUMM_;'
      '1101523175=  END'
      '1101523176='
      '1101523177=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1101523178=  if (G_PAYMENT_TYPE_ = 1) then'
      '1101523179=    SUMM_CASH_ = summ_fact_;'
      '1101523180=  ELSE'
      '1101523181=    SUMM_NONCASH_ = summ_fact_;'
      '1101523182='
      '1101523183=  PNT_ = '#39'06'#39';'
      '1101523184=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1101523185=    G_CLIENT_ = 10;'
      '1101523186='
      '1101523187=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101523188=                              :Z_DATE_,'
      '1101523189=                              :Z_TIME_,'
      '1101523190=                              :G_CLIENT_,'
      '1101523191=                              :G_PAYMENT_TYPE_,'
      '1101523192=                              '#39#39', --:OSNOVANIE_,'
      '1101523193=                              0,  -- IS_SPISANIE'
      
        '1101523194=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1101523195=                              :SUMM_,'
      '1101523196=                              :SUMM_FACT_,'
      '1101523197=                              :SUMM_CASH_,'
      '1101523198=                              :SUMM_NONCASH_,'
      
        '1101523199=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1101523200=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1101523201=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1101523202=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1101523203=                              0,    -- :BY_RECIPE__,'
      '1101523204=                              0,    -- IS_RESERVE__'
      '1101523205=                              NULL -- :PAYMENTS__'
      '1101523206=                              )'
      
        '1101523207=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101523208=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101523209=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101523210=    EXIT;'
      '1101523211=  END'
      '1101523212='
      '1101523213=  DELETE FROM import_tbl_tmp;'
      '1101523214='
      '1101523215=WHEN ANY DO BEGIN'
      '1101523216=    ERR_CODE = gdscode;'
      
        '1101523217=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1101523218=  END'
      '1101523219=end'
      '1101523220=;'
      '1101523221='
      '1101523222='
      
        '1101523223=UPDATE SYSTEM_SETUP SET S_VALUE = 110152 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101523224=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101523225=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101530='
      '1101531=ALTER PROCEDURE CURRENCYSTR('
      '1101532=  VAL NUMERIC(15,2),'
      '1101533=  CURRENCY INTEGER)'
      '1101534=RETURNS ('
      '1101535=  CURR_STR VARCHAR(1000))'
      '1101536=AS'
      '1101537=DECLARE VARIABLE RAZRYAD VARCHAR(50);'
      '1101538=DECLARE VARIABLE RAZRYAD_IDX VARCHAR(28);'
      '1101539=DECLARE VARIABLE HUNDREDS VARCHAR(64);'
      '11015310=DECLARE VARIABLE HUNDREDS_IDX VARCHAR(30);'
      '11015311=DECLARE VARIABLE TENS VARCHAR(69);'
      '11015312=DECLARE VARIABLE TENS_IDX VARCHAR(40);'
      '11015313=DECLARE VARIABLE ONES VARCHAR(138);'
      '11015314=DECLARE VARIABLE ONES_IDX VARCHAR(100);'
      '11015315=DECLARE VARIABLE SIGN_OF_VAL VARCHAR(6);'
      '11015316=DECLARE VARIABLE RAZ INTEGER;'
      '11015317=DECLARE VARIABLE CENTS VARCHAR(3);'
      '11015318=DECLARE VARIABLE VAL_STR1 VARCHAR(20);'
      '11015319=DECLARE VARIABLE VAL_STR VARCHAR(20);'
      '11015320=DECLARE VARIABLE NUM VARCHAR(20);'
      '11015321=DECLARE VARIABLE I INTEGER;'
      '11015322=DECLARE VARIABLE BUF VARCHAR(200);'
      '11015323=DECLARE VARIABLE BUF1 VARCHAR(200);'
      '11015324=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      '11015325=DECLARE VARIABLE CURR_STR_KOP_ VARCHAR(10);'
      '11015326=begin'
      '11015327=  /* '#1050#1086#1085#1089#1090#1072#1085#1090#1099' */'
      
        '11015328=  razryad_idx = /* 2.2 */ '#39'0100010506071308210829114011' +
        #39';'
      
        '11015329=  razryad = '#39#1090#1099#1089#1103#1095#1084#1080#1083#1083#1080#1086#1085#1084#1080#1083#1083#1080#1072#1088#1076#1090#1088#1080#1083#1083#1080#1086#1085#1082#1074#1072#1076#1088#1080#1083#1083#1080#1086#1085#1082#1074#1080 +
        #1085#1090#1080#1083#1083#1080#1086#1085#39';'
      
        '11015330=  hundreds_idx = /* 2.1 */ '#39'010013046106169257328407479' +
        '569'#39';'
      
