      '110231968=      VALUES (24, 1, '#39#1056#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1080#1079' '#1082#1072#1089#1089#1099#39');'
      '110231969=      FIRST_ITER = 1;'
