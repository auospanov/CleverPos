        '110202509=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048 +
        #1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
