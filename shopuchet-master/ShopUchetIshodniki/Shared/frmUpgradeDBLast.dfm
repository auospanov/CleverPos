      '110182842='
      
        '110182843=/*****************************************************' +
        '*************************/'
      
        '110182844=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110182845=/*****************************************************' +
        '*************************/'
      '110182846=ALTER PROCEDURE DEL_PRODUCT('
      '110182847=  SKLAD_ TYPE OF COLUMN OTHER.SKLAD_PARENT_ID,'
      
        '110182848=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110182849=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110182850=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110182851=RETURNS ('
      '110182852=  ERR_CODE INTEGER,'
      '110182853=  ERR_MSG VARCHAR(1024))'
      '110182854=AS'
      '110182855=/*'
      
        '110182856='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055 +
        #1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '110182857='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '110182858=*/'
      
        '110182859=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DEL_PRODUCT'#39 +
        ';'
      '110182860=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110182861=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '110182862=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' */'
      
        '110182863=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110182864=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110182865=DECLARE VARIABLE ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.AR' +
        'RIVAL_TYPE;'
      
        '110182866=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110182867=DECLARE VARIABLE DATE_ TYPE OF COLUMN OTHER.OP_DATE;'
      
        '110182868=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      '110182869=DECLARE VARIABLE ID_ TYPE OF COLUMN OTHER.OTHER;'
      '110182870=BEGIN'
      '110182871='
      '110182872=  PNT_ = '#39'00'#39';'
      '110182873=  SELECT O.G_TOCHKA'
      '110182874=    FROM SKLAD_PARENT O'
      '110182875=   WHERE O.SKLAD = :SKLAD_'
      '110182876=    INTO :G_TOCHKA_;'
      '110182877='
      '110182878=  FOR SELECT D.AMOUNT'
      '110182879=            ,D.G_PRODUCT'
      '110182880=            ,O.ARRIVAL_TYPE'
      '110182881=            ,O.OP_DATE'
      '110182882=            ,O.OTHER'
      '110182883=            ,SP.SUMM'
      '110182884=        FROM OTHER O,'
      '110182885=             OTHER_DETAILS D,'
      '110182886=             SKLAD_PARENT SP'
      '110182887=       WHERE O.sklad_parent_id = :SKLAD_'
      '110182888=         AND O.OTHER = D.OTHER'
      '110182889=         AND O.SKLAD_PARENT_ID = SP.SKLAD'
      '110182890=        INTO :AMOUNT_NEED_'
      '110182891=            ,:G_PRODUCT_KIT_'
      '110182892=            ,:ARRIVAL_TYPE_'
      '110182893=            ,:DATE_'
      '110182894=            ,:ID_'
      '110182895=            ,:SUMM_'
      '110182896=  DO BEGIN'
      '110182897=    UPDATE LT_SKLAD_PRODUCT L'
      
        '110182898=       SET L.AMOUNT = L.AMOUNT + DECODE(:ARRIVAL_TYPE_' +
        ', 0, -:AMOUNT_NEED_, :AMOUNT_NEED_)   -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040',' +
        ' '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1048' '#1053#1040#1054#1041#1054#1056#1054#1058
      '110182899=           ,L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110182900=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110182901=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110182902=  END'
      '110182903='
      '110182904=  PNT_ = '#39'01'#39';'
      
        '110182905=  DELETE FROM OTHER_DETAILS D WHERE EXISTS (SELECT 1 F' +
        'ROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_ AND OTHER = D.OTHER);'
      '110182906=  DELETE FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_;'
      '110182907='
      '110182908=  PNT_ = '#39'02'#39';'
      
        '110182909=  EXECUTE PROCEDURE DEL_SKLAD(:SKLAD_, NULL, :UPLOAD_T' +
        'O_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110182910=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110182911=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110182912=      EXIT;'
      '110182913=  END'
      '110182914='
      '110182915=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110182916=  EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, :ID_, :' +
        'DATE_, 3, :SUMM_, :LOG_BODY_, 1);'
      '110182917=END'
      '110182918=;'
      '110182919='
      '110182920=ALTER PROCEDURE DEL_SKLAD('
      '110182921=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110182922=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110182923=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110182924=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110182925=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110182926=RETURNS ('
      '110182927=  ERR_CODE INTEGER,'
      '110182928=  ERR_MSG VARCHAR(1024))'
      '110182929=AS'
      '110182930=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD'#39';'
      '110182931=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110182932=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110182933=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '110182934=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110182935=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110182936=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110182937=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110182938=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.A' +
        'MOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071 +
        ') */'
      
        '110182939=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA.' +
        'NAME;'
      
        '110182940=DECLARE VARIABLE DATE_ TYPE OF COLUMN SKLAD_PARENT.DAT' +
        'E_RECEIPT;'
      
        '110182941=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      '110182942=BEGIN'
      '110182943='
      '110182944=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '110182945=    SELECT S_VALUE'
      '110182946=      FROM SYSTEM_SETUP'
      '110182947=     WHERE SYSTEM_SETUP = 2'
      '110182948=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110182949='
      '110182950=  SELECT SP.IS_VOZVRAT,'
      
        '110182951=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TOC' +
        'HKA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '110182952=         ,G.NAME'
      '110182953=         ,SP.DATE_RECEIPT'
      '110182954=         ,SP.SUMM'
      '110182955=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '110182956=   WHERE SP.SKLAD = :SKLAD_'
      '110182957=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '110182958=    INTO :IS_VOZVRAT_,'
      '110182959=         :G_TOCHKA_'
      '110182960=         ,:TOCHKA_NAME_'
      '110182961=         ,:DATE_'
      '110182962=         ,:SUMM_;'
      '110182963='
      '110182964=  PNT_ = '#39'02'#39';'
      '110182965=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '110182966=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '110182967=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040#1045 +
        #1058' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      '110182968=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '110182969=      FOR SELECT S.G_PRODUCT,'
      '110182970=                 SUM(S.AMOUNT)'
      '110182971=            FROM SKLAD S'
      '110182972=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '110182973=           GROUP BY S.G_PRODUCT'
      '110182974=            INTO :G_PRODUCT_,'
      '110182975=                 :AMOUNT_PRIHOD_'
      '110182976=      DO BEGIN'
      '110182977=          SELECT L.AMOUNT,'
      '110182978=                 G.NAME'
      '110182979=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '110182980=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110182981=             AND L.G_PRODUCT = G.G_PRODUCT'
      '110182982=             AND L.G_TOCHKA = :G_TOCHKA_'
      '110182983=            INTO :AMOUNT_LAST_,'
      '110182984=                 :NAME_;'
      '110182985='
      
        '110182986=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) T' +
        'HEN BEGIN'
      '110182987=              ERR_CODE = -20500;'
      
        '110182988=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||NAME_||'#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||TOCHKA_NAME_||'#39'" '#1089#1090#1072 +
        #1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURN' +
        'ING_VALUES (:ERR_MSG);'
      
        '110182989=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110182990=              EXIT;'
      '110182991=          END'
      '110182992=      END'
      '110182993=  END'
      '110182994='
      
        '110182995=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL, :U' +
        'PLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110182996=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110182997=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110182998=    EXIT;'
      '110182999=  END'
      '1101821000='
      '1101821001=  -------------------------------------'
      
        '1101821002=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048 +
        ' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050 +
        #1051#1040#1044#1040
      
        '1101821003=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053 +
        #1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' ' +
        #1055#1054#1044#1056#1071#1044
      '1101821004=  PNT_ = '#39'05'#39';'
      '1101821005=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '1101821006=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '1101821007=      FOR SELECT S.KASSA'
      '1101821008=            FROM KASSA S'
      '1101821009=           WHERE S.SKLAD = :SKLAD_'
      '1101821010=            INTO :KASSA_'
      '1101821011=      DO BEGIN'
      
        '1101821012=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101821013=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821014=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1101821015=             EXIT;'
      '1101821016=          END'
      '1101821017=      END'
      '1101821018='
      '1101821019=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '1101821020=      FOR SELECT S.KASSA_BEZNAL'
      '1101821021=            FROM KASSA_BEZNAL S'
      '1101821022=           WHERE S.SKLAD = :SKLAD_'
      '1101821023=            INTO :KASSA_'
      '1101821024=      DO BEGIN'
      
        '1101821025=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101821026=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821027=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1101821028=             EXIT;'
      '1101821029=          END'
      '1101821030=      END'
      '1101821031=  END'
      '1101821032=  -------------------------------------'
      '1101821033='
      '1101821034=  PNT_ = '#39'06'#39';'
      '1101821035=  DELETE FROM sklad_PARENT'
      '1101821036=  WHERE sklad = :sklad_;'
      '1101821037='
      '1101821038=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101821039=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ IN (0,1,' +
        '2)) THEN BEGIN'
      '1101821040=    UPDATE SYNC_EXT_APP AP'
      '1101821041=       SET AP.OPER = 3'
      '1101821042=     WHERE AP.OBJECT_TYPE = 2'
      '1101821043=       AND AP.ID = :SKLAD_'
      '1101821044=       AND AP.IS_LOADING = 0;'
      '1101821045='
      '1101821046=    IF (ROW_COUNT = 0) THEN'
      
        '1101821047=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101821048=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLA' +
        'D_, 3);'
      '1101821049=  END'
      '1101821050='
      '1101821051=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101821052=  EXECUTE PROCEDURE LOG_OPER_INS(IS_VOZVRAT_, :USER_I' +
        'D_, :SKLAD_, :DATE_, 3, :SUMM_, :LOG_BODY_, 1);'
      '1101821053='
      '1101821054=when sqlcode -530 DO'
      '1101821055=  begin'
      '1101821056=    ERR_CODE = -20500;'
      
        '1101821057=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101821058=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821059=  end'
      '1101821060=end'
      '1101821061=;'
      '1101821062='
      '1101821063=ALTER PROCEDURE DEL_SKLAD_DETAIL('
      '1101821064=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101821065=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101821066=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101821067=RETURNS ('
      '1101821068=  ERR_CODE INTEGER,'
      '1101821069=  ERR_MSG VARCHAR(1024))'
      '1101821070=AS'
      
        '1101821071=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD_DE' +
        'TAIL'#39';'
      '1101821072=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '1101821073=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      '1101821074=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '1101821075=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '1101821076=DECLARE VARIABLE IS_LAST_ TYPE OF COLUMN SKLAD.IS_LAS' +
        'T;'
      
        '1101821077=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1101821078=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1101821079=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101821080=DECLARE VARIABLE G_PRODUCT_SOSTAV_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1101821081=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      
        '1101821082=DECLARE VARIABLE IS_EXPECTED_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.IS_EXPECTED;'
      
        '1101821083=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.' +
        'AMOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057 +
        #1071') */'
      
        '1101821084=DECLARE VARIABLE G_TOCHKA_PROVIDER_ TYPE OF COLUMN G_' +
        'TOCHKA.G_TOCHKA;'
      '1101821085=BEGIN'
      '1101821086=  PNT_ = '#39'01'#39';'
      '1101821087=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1053#1048#1052#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101821088=  FOR SELECT S.G_PRODUCT,'
      '1101821089=             S.AMOUNT,'
      '1101821090=             S.IS_LAST'
      '1101821091=             ,SP.IS_VOZVRAT'
      '1101821092=             ,SP.G_TOCHKA'
      '1101821093=             ,SP.IS_EXPECTED'
      '1101821094=             ,SP.G_CLIENT'
      '1101821095=        FROM SKLAD S, SKLAD_PARENT SP'
      '1101821096=       WHERE SP.SKLAD = S.SKLAD_PARENT'
      '1101821097=         AND S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101821098=         AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '1101821099=       INTO :G_PRODUCT_,'
      '1101821100=            :AMOUNT_,'
      '1101821101=            :IS_LAST_'
      '1101821102=            ,:IS_VOZVRAT_'
      '1101821103=            ,:G_TOCHKA_'
      '1101821104=            ,:IS_EXPECTED_'
      '1101821105=            ,:G_TOCHKA_PROVIDER_'
      '1101821106=  DO BEGIN'
      '1101821107=    IF (IS_EXPECTED_ = 0) THEN'
      '1101821108=        UPDATE LT_SKLAD_PRODUCT LT'
      '1101821109=           SET LT.AMOUNT = LT.AMOUNT - :AMOUNT_,'
      
        '1101821110=               LT.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP' +
        '_'
      '1101821111=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1101821112=           AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1101821113='
      
        '1101821114=    IF (IS_LAST_ = 1) then    -- '#1045#1057#1051#1048' '#1057#1058#1054#1048#1058' IS_LAST, ' +
        #1058#1054' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1045#1043#1054' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048', '#1063#1058#1054#1041#1067' '#1053#1045' '#1058#1045#1056#1071#1058#1068' '#1055#1054#1057#1051#1045#1044#1053 +
        #1070#1070' '#1055#1054#1057#1058#1040#1042#1050#1059
      '1101821115=        UPDATE SKLAD SK'
      '1101821116=             SET SK.IS_LAST = 1'
      '1101821117=           WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101821118=             AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1101821119=                               FROM SKLAD SS'
      
        '1101821120=                              WHERE SS.G_TOCHKA = :G_' +
        'TOCHKA_'
      
        '1101821121=                                AND SS.G_PRODUCT = SK' +
        '.G_PRODUCT'
      
        '1101821122=                                AND SS.SKLAD_PARENT <' +
        '> :SKLAD_PARENT_'
      
        '1101821123=                                AND SS.DATE_RECEIPT =' +
        ' (SELECT MAX(SSS.DATE_RECEIPT)'
      
        '1101821124=                                                     ' +
        '    FROM SKLAD SSS'
      
        '1101821125=                                                     ' +
        '   WHERE SSS.G_PRODUCT = SS.G_PRODUCT'
      
        '1101821126=                                                     ' +
        '     AND SSS.IS_VOZVRAT in (0, 4)'
      
        '1101821127=                                                     ' +
        '     AND SSS.SKLAD_PARENT <> :SKLAD_PARENT_'
      
        '1101821128=                                                     ' +
        '     AND SSS.G_TOCHKA = :G_TOCHKA_));'
      '1101821129='
      '1101821130=  END'
      '1101821131='
      '1101821132=  PNT_ = '#39'02'#39';'
      
        '1101821133=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051'. '#1042' ' +
        #1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1050#1054#1051'-'#1042#1054' '#1053#1040#1044#1054' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1058#1068' '#1050#1054#1051'-'#1042#1054' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1048' '#1059#1044#1040 +
        #1051#1071#1058#1068' '#1044#1040#1053#1053#1067#1045
      '1101821134=  -- '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067' LT_ZAKAZ_REAL'
      '1101821135=  IF (IS_VOZVRAT_ = 2) THEN BEGIN'
      '1101821136=    FOR SELECT ZD.AMOUNT,'
      '1101821137=             ZD.PRICE,'
      '1101821138=             LZ.ZAKAZ_NA_REAL'
      '1101821139=        FROM SKLAD ZD,'
      '1101821140=             LT_ZAKAZ_REAL LZ'
      '1101821141=       WHERE ZD.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101821142=         AND ZD.SKLAD = COALESCE(:SKLAD_, ZD.SKLAD)'
      '1101821143=         AND ZD.SKLAD = LZ.SKLAD'
      '1101821144=       INTO :AMOUNT_,'
      '1101821145=            :PRICE_,'
      '1101821146=            :ZAKAZ_NA_REAL_'
      '1101821147=    DO BEGIN'
      '1101821148=      UPDATE ZAKAZ_NA_REAL ZRR'
      
        '1101821149=         SET ZRR.AMOUNT_RETURNED = ZRR.AMOUNT_RETURNE' +
        'D - :AMOUNT_,'
      
        '1101821150=             ZRR.SUMM_RETURNED = ZRR.SUMM_RETURNED - ' +
        ':AMOUNT_ * :PRICE_,'
      '1101821151=             ZRR.IS_PAYED_ALL = 0'
      '1101821152=       WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101821153=    END'
      '1101821154='
      '1101821155=    IF (SKLAD_ IS NOT NULL) THEN'
      
        '1101821156=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD = :SK' +
        'LAD_;'
      '1101821157=    ELSE'
      
        '1101821158=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD IN (S' +
        'ELECT SKLAD FROM SKLAD WHERE SKLAD_PARENT = :SKLAD_PARENT_);'
      '1101821159=  END'
      
        '1101821160=  -- '#1055#1056#1048#1041#1040#1042#1051#1070' '#1048#1061' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050', '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1058 +
        #1056#1040#1053#1057#1060#1045#1056' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101821161=  ELSE IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '1101821162=    FOR SELECT S.G_PRODUCT,'
      '1101821163=               S.AMOUNT'
      '1101821164=          FROM SKLAD S'
      '1101821165=         WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101821166=           AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '1101821167=          INTO :G_PRODUCT_,'
      '1101821168=               :AMOUNT_PRIHOD_'
      '1101821169=    DO BEGIN'
      '1101821170=      UPDATE LT_SKLAD_PRODUCT L'
      '1101821171=         SET L.AMOUNT = L.AMOUNT + :AMOUNT_PRIHOD_,'
      '1101821172=             L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101821173=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101821174=         AND L.G_TOCHKA = :G_TOCHKA_PROVIDER_;'
      '1101821175=    END'
      '1101821176=  END'
      '1101821177='
      '1101821178=  PNT_ = '#39'03'#39';'
      
        '1101821179=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' ' +
        #1057#1054#1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040 +
        #1056#1040', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '1101821180=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', ' +
        #1050' '#1055#1056#1048#1052#1045#1056#1059' '#1058#1045#1057#1058#1054' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1052#1059#1050#1048' (5 '#1064#1058') '#1048' '#1057#1040#1061#1040#1056#1040' (4 '#1064#1058'), '#1057#1054#1054#1058#1042#1045#1058#1057 +
        #1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1045#1057#1058#1040' = 4'
      '1101821181=  /*FOR SELECT K.G_PRODUCT'
      '1101821182=        FROM SKLAD ZD,'
      '1101821183=             G_PRODUCT_KIT K'
      '1101821184=       WHERE ZD.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1101821185=         AND ZD.sklad_parent = :SKLAD_PARENT_'
      '1101821186=       GROUP BY K.G_PRODUCT'
      '1101821187=       INTO :G_PRODUCT_SOSTAV_'
      '1101821188=  DO BEGIN'
      '1101821189=    SELECT MIN(L.AMOUNT)'
      '1101821190=      FROM G_PRODUCT_KIT K,'
      '1101821191=           LT_SKLAD_PRODUCT L'
      '1101821192=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '1101821193=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '1101821194=       AND L.G_TOCHKA = :G_TOCHKA_'
      '1101821195=     GROUP BY K.G_PRODUCT'
      '1101821196=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101821197='
      '1101821198=    UPDATE LT_SKLAD_PRODUCT L'
      '1101821199=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '1101821200=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_;'
      '1101821201=  END*/'
      '1101821202='
      '1101821203=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1101821204=  PNT_ = '#39'04'#39';'
      '1101821205=  DELETE from SKLAD S'
      '1101821206=  WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1101821207=    AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD);'
      '1101821208='
      '1101821209=when sqlcode -530 DO'
      '1101821210=  begin'
      '1101821211=    ERR_CODE = -20500;'
      
        '1101821212=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101821213=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821214=  end'
      '1101821215=end'
      '1101821216=;'
      '1101821217='
      '1101821218=ALTER PROCEDURE DEL_ZAKAZ('
      '1101821219=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101821220=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0,'
      '1101821221=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101821222=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101821223=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101821224=RETURNS ('
      '1101821225=  ERR_CODE INTEGER,'
      '1101821226=  ERR_MSG VARCHAR(1024))'
      '1101821227=AS'
      '1101821228=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '1101821229=DECLARE VARIABLE PNT_ VARCHAR(5) = '#39'00'#39';'
      '1101821230=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101821231=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M;'
      
        '1101821232=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '1101821233=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1101821234=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '1101821235=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101821236=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101821237=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101821238=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM;'
      
        '1101821239=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1101821240=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101821241=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101821242=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOC' +
        'HKA;'
      
        '1101821243=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1101821244=DECLARE VARIABLE STR_ VARCHAR(50);'
      '1101821245=DECLARE VARIABLE Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE;'
      '1101821246=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1101821247=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      '1101821248=BEGIN'
      '1101821249='
      
        '1101821250=  --*************************************************' +
        '***************'
      '1101821251=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1101821252=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101821253=      SELECT Z.SUMM,'
      '1101821254=             Z.SUMM_BONUS,'
      '1101821255=             Z.SUMM_BONUS_GOT,'
      '1101821256=             Z.G_CLIENT,'
      '1101821257=             Z.G_OFFICIAL,'
      '1101821258=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '1101821259=             G.FM'
      '1101821260=             ,Z.G_TOCHKA'
      '1101821261=             ,Z.Z_DATE'
      
        '1101821262=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101821263=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101821264=        INTO :SUMM_ZAKAZ_,'
      '1101821265=             :SUMM_PAY_BONUS_,'
      '1101821266=             :SUMM_BONUS_GOT_,'
      '1101821267=             :G_CLIENT_,'
      '1101821268=             :G_OFFICIAL_,'
      '1101821269=             :DO_NOT_SALES_COMM_,'
      '1101821270=             :OFFICIAL_NAME_'
      '1101821271=             ,:G_TOCHKA_'
      '1101821272=             ,:Z_DATE_;'
      '1101821273='
      
        '1101821274=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101821275=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ') THEN'
      '1101821276=        SELECT SUM(ZD.SALES_COMM)'
      '1101821277=          FROM ZAKAZ_DETAILS ZD'
      '1101821278=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101821279=          INTO :SALES_COMM_OLD_;'
      '1101821280='
      '1101821281=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1101821282=      PNT_ = '#39'01'#39';'
      
        '1101821283=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101821284=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821285=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101821286=        EXIT;'
      '1101821287=      END'
      '1101821288='
      '1101821289=      -------------------------------------'
      '1101821290=      PNT_ = '#39'02'#39';'
      '1101821291=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '1101821292=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040 +
        #1051#1048#1063#1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045 +
        #1053#1048#1071' '#1055#1054#1044#1056#1071#1044
      '1101821293=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '1101821294=      FOR SELECT S.KASSA'
      '1101821295=            FROM KASSA S'
      '1101821296=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1101821297=            INTO :KASSA_'
      '1101821298=      DO BEGIN'
      
        '1101821299=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101821300=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821301=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101821302=            EXIT;'
      '1101821303=          END'
      '1101821304=      END'
      '1101821305='
      '1101821306=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '1101821307=      PNT_ = '#39'03'#39';'
      '1101821308=      FOR SELECT S.KASSA_BEZNAL'
      '1101821309=            FROM KASSA_BEZNAL S'
      '1101821310=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1101821311=            INTO :KASSA_'
      '1101821312=      DO BEGIN'
      
        '1101821313=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101821314=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821315=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101821316=            EXIT;'
      '1101821317=          END'
      '1101821318=      END'
      '1101821319=      -------------------------------------'
      '1101821320='
      
        '1101821321=      --=============================================' +
        '===================='
      '1101821322=      -- '#1041#1051#1054#1050' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040
      
        '1101821323=      --=============================================' +
        '===================='
      '1101821324=      PNT_ = '#39'03.1'#39';'
      
        '1101821325=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ' AND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '1101821326=            KASSA_ = NULL;'
      '1101821327='
      '1101821328=            SELECT S.S_VALUE'
      '1101821329=              FROM SYSTEM_SETUP S'
      '1101821330=             WHERE S.SYSTEM_SETUP = 4'
      '1101821331=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101821332='
      '1101821333=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101821334=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101821335=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101821336='
      
        '1101821337=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' ' +
        #1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101821338=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THE' +
        'N'
      
        '1101821339=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - D' +
        'ECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY ' +
        'FROM CURRENT_DATE)));'
      '1101821340='
      '1101821341=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101821342=            ELSE'
      
        '1101821343=               ACTION_DATE_ZP_ = Current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date -' +
        ' EXTRACT(DAY FROM current_date) + 32);'
      '1101821344='
      '1101821345=            SELECT K.KASSA, K.SUMM'
      '1101821346=            FROM KASSA K'
      '1101821347=            WHERE K.G_PRIHOD_RASHOD = -1'
      '1101821348=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101821349=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101821350=             AND K.G_TOCHKA = :G_TOCHKA_'
      '1101821351=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1101821352='
      
        '1101821353=            LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' ' +
        '|| EXTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FRO' +
        'M ACTION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) ||' +
        ' '#39'"'#39';'
      '1101821354='
      '1101821355=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '1101821356=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101821357=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1101821358=                                              -:SALES' +
        '_COMM_OLD_,'
      
        '1101821359=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1101821360=                                              :OFFICI' +
        'AL_NAME_,'
      
        '1101821361=                                              NULL,  ' +
        '   --:ZAKAZ_,'
      
        '1101821362=                                              NULL,  ' +
        '   --:SKLAD_,'
      '1101821363=                                              1,'
      
        '1101821364=                                              (SELECT' +
        ' ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101821365=                                              :G_OFFI' +
        'CIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101821366=                LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101821367=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COM' +
        'M_OLD_ || '#39'".'#39';'
      '1101821368='
      '1101821369=            END ELSE'
      
        '1101821370=                SALES_COMM_OLD_ = SALES_COMM_SUMM_ITE' +
        'R_ - SALES_COMM_OLD_;'
      '1101821371=                LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101821372=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' |' +
        '| SALES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101821373=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39' '#1085#1072' "'#39' || SALES_COMM_OLD_ || '#39'".'#39';'
      '1101821374='
      
        '1101821375=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_' +
        ','
      
        '1101821376=                                              1,     ' +
        '-- ACTION_'
      
        '1101821377=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1101821378=                                              :SALES_' +
        'COMM_OLD_,'
      
        '1101821379=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1101821380=                                              :OFFICI' +
        'AL_NAME_,   --NOTE_'
      '1101821381=                                              NULL,'
      '1101821382=                                              NULL,'
      '1101821383=                                              1,'
      
        '1101821384=                                              G_OFFIC' +
        'IAL_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101821385='
      '1101821386=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821387=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101821388=              EXIT;'
      '1101821389=            END'
      '1101821390=      END'
      '1101821391=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101821392=      --=============================================' +
        '===================='
      '1101821393='
      
        '1101821394=      -- '#1045#1057#1051#1048' '#1050#1040#1050#1040#1071'-'#1058#1054' '#1063#1040#1057#1058#1068' '#1041#1067#1051#1040' '#1054#1055#1051#1040#1063#1045#1053#1040' '#1041#1054#1053#1059#1057#1040#1052#1048' -' +
        ' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1048#1061', '#1058#1054' '#1045#1057#1058#1068' '#1047#1040#1050#1048#1044#1067#1042#1040#1070' '#1050#1051#1048#1045#1053#1058#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1053#1040' '#1053#1040#1050#1054#1055#1051#1045 +
        #1053#1048#1071
      '1101821395=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '1101821396=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' ' +
        #1055#1054#1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '1101821397=      UPDATE G_DISCONT_CARD G'
      
        '1101821398=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_' +
        ', 0) - :SUMM_BONUS_GOT_,'
      
        '1101821399=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0)' +
        ', 0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '1101821400=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '1101821401='
      '1101821402=      PNT_ = '#39'04'#39';'
      '1101821403=      UPDATE INVOICE I'
      '1101821404=         SET I.ZAKAZ = NULL'
      '1101821405=       WHERE I.ZAKAZ = :zakaz_;'
      '1101821406='
      '1101821407=      UPDATE INVOICE_PAY I'
      '1101821408=         SET I.ZAKAZ = NULL'
      '1101821409=       WHERE I.ZAKAZ = :zakaz_;'
      '1101821410='
      '1101821411=      UPDATE WAYBILL W'
      '1101821412=         SET W.ZAKAZ = NULL'
      '1101821413=       WHERE W.ZAKAZ = :zakaz_;'
      '1101821414=      --********************************************'
      '1101821415='
      '1101821416=      PNT_ = '#39'015'#39';'
      '1101821417=      DELETE FROM zakaz'
      '1101821418=      WHERE zakaz = :zakaz_;'
      '1101821419='
      '1101821420=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101821421=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN BEGIN'
      '1101821422=        UPDATE SYNC_EXT_APP AP'
      '1101821423=           SET AP.OPER = 3'
      '1101821424=         WHERE AP.OBJECT_TYPE = 1'
      '1101821425=           AND AP.ID = :ZAKAZ_;'
      '1101821426='
      '1101821427=        IF (ROW_COUNT = 0) THEN'
      
        '1101821428=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, O' +
        'BJECT_TYPE, ID, OPER)'
      
        '1101821429=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :' +
        'ZAKAZ_, 3);'
      '1101821430=      END'
      '1101821431=  END'
      '1101821432=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '1101821433=  --*************************************************' +
        '***************************'
      '1101821434=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101821435=  ELSE BEGIN'
      '1101821436=    SELECT SP.DATE_RECEIPT,'
      '1101821437=           SP.SUMM'
      '1101821438=      FROM SKLAD_PARENT SP'
      '1101821439=     WHERE SP.SKLAD = :ZAKAZ_'
      '1101821440=      INTO :Z_DATE_,'
      '1101821441=           :SUMM_ZAKAZ_;'
      '1101821442='
      '1101821443=    PNT_ = '#39'20'#39';'
      
        '1101821444=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL, :UPLOA' +
        'D_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101821445=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821446=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101821447=      EXIT;'
      '1101821448=    END'
      '1101821449=  END'
      '1101821450='
      '1101821451=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101821452=  EXECUTE PROCEDURE LOG_OPER_INS(IS_SPISANIE_, :USER_' +
        'ID_, :ZAKAZ_, :Z_DATE_, 3, :SUMM_ZAKAZ_, :LOG_BODY_, 0);'
      '1101821453='
      '1101821454=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1101821455=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM_OLD_,' +
        ' :LOG_BODY_KASSA_, 1);'
      '1101821456='
      '1101821457=when any DO'
      '1101821458=  begin'
      '1101821459=    IF (sqlcode = -530) THEN BEGIN'
      '1101821460=        ERR_CODE = -20500;'
      
        '1101821461=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072 +
        #1085#1085#1086#1081' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNIN' +
        'G_VALUES (:ERR_MSG);'
      
        '1101821462=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG' +
        ';'
      '1101821463=    END'
      '1101821464=    ELSE BEGIN'
      '1101821465=        ERR_CODE = -9999;'
      
        '1101821466=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073 +
        #1082#1072' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1087#1088#1086#1076#1072#1078#1080'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101821467=        ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG' +
        ';'
      '1101821468=    END'
      '1101821469=  end'
      '1101821470=end'
      '1101821471=;'
      '1101821472='
      '1101821473=ALTER PROCEDURE DEL_ZAKAZ_DETAIL('
      '1101821474=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101821475=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101821476=RETURNS ('
      '1101821477=  ERR_CODE INTEGER,'
      '1101821478=  ERR_MSG VARCHAR(1024))'
      '1101821479=AS'
      
        '1101821480=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ_DE' +
        'TAIL'#39';'
      '1101821481=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '1101821482=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101821483=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101821484=DECLARE VARIABLE IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS' +
        '_SPISANIE;'
      
        '1101821485=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_' +
        'RESERVE;'
      
        '1101821486=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1101821487=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1101821488=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1101821489=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101821490=DECLARE VARIABLE NOT_MINUS_OSTATOK_ TYPE OF COLUMN ZA' +
        'KAZ.NOT_MINUS_OSTATOK;'
      '1101821491=BEGIN'
      '1101821492=  PNT_ = '#39'00'#39';'
      
        '1101821493=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1040' '#1042#1044#1056#1059#1043' '#1059#1044#1040#1051#1071#1070' '#1054#1055#1051#1040#1058#1059' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040 +
        #1051#1048#1047#1040#1062#1048#1070
      '1101821494=  SELECT Z.IS_SPISANIE,'
      '1101821495=         Z.G_TOCHKA'
      '1101821496=         ,Z.IS_RESERVE'
      '1101821497=         ,Z.NOT_MINUS_OSTATOK'
      '1101821498=    FROM ZAKAZ Z'
      '1101821499=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101821500=    INTO :IS_SPISANIE_,'
      '1101821501=         :G_TOCHKA_'
      '1101821502=         ,:IS_RESERVE_'
      '1101821503=         ,:NOT_MINUS_OSTATOK_;'
      '1101821504='
      '1101821505=  PNT_ = '#39'01'#39';'
      
        '1101821506=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1048#1051#1048' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040'. '#1058#1054' ' +
        #1057#1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101821507=  if (IS_SPISANIE_ <> 2) then BEGIN'
      '1101821508=      FOR SELECT G_PRODUCT,'
      '1101821509=                 AMOUNT'
      '1101821510=            FROM ZAKAZ_DETAILS Z'
      '1101821511=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101821512=           INTO :G_PRODUCT_,'
      '1101821513=                :AMOUNT_'
      '1101821514=      DO BEGIN'
      '1101821515=        BEGIN'
      '1101821516=            PNT_ = '#39'02'#39';'
      '1101821517=            -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1101821518=            IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1101821519=                -- '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1050' '#1054#1057#1053#1054#1042 +
        #1053#1054#1052#1059' '#1054#1057#1058#1040#1058#1050#1059
      
        '1101821520=                IF (IS_RESERVE_ = 0 AND NOT_MINUS_OST' +
        'ATOK_ = 0) THEN'
      '1101821521=                    UPDATE LT_SKLAD_PRODUCT LT'
      
        '1101821522=                       SET LT.AMOUNT = LT.AMOUNT + :A' +
        'MOUNT_,'
      
        '1101821523=                           LT.NEED_TO_EXPORT = :UPLOA' +
        'D_TO_EXT_APP_'
      '1101821524=                     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1101821525=                       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1101821526='
      
        '1101821527=                -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1056#1045#1047#1045#1056#1042', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1054#1058' '#1047#1040#1056 +
        #1045#1047#1045#1056#1042#1048#1056#1054#1042#1040#1053#1053#1054#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040
      '1101821528=                ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101821529=                    UPDATE LT_SKLAD_PRODUCT LT'
      
        '1101821530=                       SET LT.AMOUNT_RESERVE = LT.AMO' +
        'UNT_RESERVE - :AMOUNT_'
      '1101821531=                     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1101821532=                       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1101821533=            END'
      '1101821534=        WHEN EXCEPTION NOL_EXCEPTION DO'
      '1101821535=          begin'
      '1101821536=            ERR_CODE = -20500;'
      
        '1101821537=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1042' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1086#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079 +
        #1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101821538=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101821539=            EXIT;'
      '1101821540=          end'
      '1101821541=        END'
      '1101821542=      END'
      '1101821543='
      
        '1101821544=  --*************************************************' +
        '**********'
      
        '1101821545=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051', '#1058#1054' '#1053#1040#1044#1054' ' +
        #1042#1054#1057#1057#1058#1040#1053#1054#1042#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1045' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      
        '1101821546=  -- '#1048#1065#1059' '#1055#1054' '#1044#1040#1053#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1048' '#1055#1056#1048 +
        #1041#1040#1042#1051#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050' '#1053#1045#1052#1059', '#1045#1057#1051#1048' '#1042#1045#1057#1068' '#1058#1054#1042#1040#1056' '#1054#1055#1051#1040#1063#1045#1053', '#1058#1054' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042 +
        #1059#1070' '#1047#1040#1055#1048#1057#1068
      '1101821547=  END ELSE BEGIN'
      '1101821548=      PNT_ = '#39'03'#39';'
      '1101821549=      FOR SELECT ZD.AMOUNT,'
      '1101821550=                 ZD.PRICE,'
      '1101821551=                 ZD.DISCOUNT_TENGE,'
      '1101821552=                 LZ.ZAKAZ_NA_REAL'
      '1101821553=            FROM ZAKAZ Z,'
      '1101821554=                 ZAKAZ_DETAILS ZD,'
      '1101821555=                 LT_ZAKAZ_REAL LZ'
      '1101821556=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101821557=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101821558=             AND ZD.ZAKAZ_DETAILS = LZ.ZAKAZ_DETAILS'
      '1101821559=           INTO :AMOUNT_,'
      '1101821560=                :PRICE_,'
      '1101821561=                :DISCOUNT_TENGE_,'
      '1101821562=                :ZAKAZ_NA_REAL_'
      '1101821563=      DO BEGIN'
      '1101821564=          UPDATE ZAKAZ_NA_REAL ZRR'
      
        '1101821565=             SET ZRR.AMOUNT_PAYED = ZRR.AMOUNT_PAYED ' +
        '- :AMOUNT_,'
      
        '1101821566=                 ZRR.SUMM_PAYED = ZRR.SUMM_PAYED - :A' +
        'MOUNT_ * (:PRICE_ - :DISCOUNT_TENGE_),'
      '1101821567=                 ZRR.IS_PAYED_ALL = 0'
      '1101821568=           WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101821569=      END'
      '1101821570='
      '1101821571=      PNT_ = '#39'04'#39';'
      '1101821572=      -- '#1059#1044#1040#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067
      
        '1101821573=      DELETE FROM LT_ZAKAZ_REAL R WHERE R.ZAKAZ_DETAI' +
        'LS IN (SELECT ZAKAZ_DETAILS FROM ZAKAZ_DETAILS ZD WHERE ZD.ZAKAZ' +
        ' = :ZAKAZ_);'
      '1101821574=  END'
      '1101821575='
      '1101821576=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1101821577=  PNT_ = '#39'05'#39';'
      '1101821578=  DELETE from zakaz_DETAILS z'
      '1101821579=  WHERE z.zakaz = :zakaz_;'
      '1101821580='
      '1101821581=WHEN ANY DO'
      '1101821582=  begin'
      '1101821583=    IF (sqlcode = -530) THEN begin'
      '1101821584=      ERR_CODE = -20500;'
      
        '1101821585=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085 +
        #1086#1081' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_' +
        'VALUES (:ERR_MSG);'
      
        '1101821586=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101821587=    end ELSE BEGIN'
      '1101821588=      ERR_CODE = sqlcode;'
      
        '1101821589=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073#1082#1072 +
        ' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1076#1077#1090#1072#1083#1077#1081'! '#1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39' || GDSCODE) RETURNING_VALUES' +
        ' (:ERR_MSG);'
      
        '1101821590=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101821591=    END'
      '1101821592=  end'
      '1101821593=end'
      '1101821594=;'
      '1101821595='
      '1101821596=ALTER PROCEDURE DEL_ZAKAZ_NA_REAL('
      
        '1101821597=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_N' +
        'A_REAL,'
      '1101821598=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101821599=RETURNS ('
      '1101821600=  ERR_CODE INTEGER,'
      '1101821601=  ERR_MSG VARCHAR(1024))'
      '1101821602=AS'
      
        '1101821603=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ_NA' +
        '_REAL'#39';'
      '1101821604=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '1101821605=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101821606=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101821607=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZA' +
        'KAZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '1101821608=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1101821609=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101821610=begin'
      
        '1101821611=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040 +
        #1044#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1054#1053' '#1059#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1063#1045#1053
      '1101821612=  FOR SELECT G_PRODUCT,'
      '1101821613=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED,'
      '1101821614=             Z.ZAKAZ_REAL_PARENT,'
      '1101821615=             ZP.G_TOCHKA'
      '1101821616=        FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      '1101821617=       WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '1101821618=         AND Z.IS_PAYED_ALL = 0'
      
        '1101821619=         AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PARE' +
        'NT'
      '1101821620=       INTO :G_PRODUCT_,'
      '1101821621=            :AMOUNT_,'
      '1101821622=            :ZAKAZ_REAL_PARENT_,'
      '1101821623=            :G_TOCHKA_'
      '1101821624=  DO BEGIN'
      '1101821625=    UPDATE LT_SKLAD_PRODUCT LT'
      '1101821626=       SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_,'
      '1101821627=           LT.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101821628=     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '1101821629=       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '1101821630=  END'
      '1101821631='
      '1101821632=  -- '#1059#1044#1040#1051#1071#1070' '#1058#1054#1042#1040#1056' '#1048#1047' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1101821633=  PNT_ = '#39'03'#39';'
      '1101821634=  DELETE from ZAKAZ_NA_REAL z'
      '1101821635=  WHERE z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101821636='
      
        '1101821637=  -- '#1059#1044#1040#1051#1071#1070' '#1042#1057#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070', '#1045#1057#1051#1048' '#1041#1054#1051#1045#1045' '#1044#1054#1063#1045#1056#1053#1048#1061' '#1047#1040#1055#1048#1057#1045 +
        #1049' '#1059' '#1053#1045#1045' '#1053#1045#1058
      '1101821638=  SELECT COUNT(*)'
      '1101821639=    FROM ZAKAZ_NA_REAL Z'
      '1101821640=   WHERE Z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_'
      '1101821641=    INTO :CNT_;'
      '1101821642='
      '1101821643=  if (CNT_ = 0) then'
      '1101821644=      DELETE from ZAKAZ_REAL_PARENT z'
      
        '1101821645=      WHERE z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_' +
        ';'
      '1101821646='
      '1101821647=when sqlcode -530 DO'
      '1101821648=  begin'
      '1101821649=    ERR_CODE = -20500;'
      
        '1101821650=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101821651=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821652=  end'
      '1101821653=end'
      '1101821654=;'
      '1101821655='
      '1101821656=ALTER PROCEDURE DO_PRODUCT('
      '1101821657=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101821658=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1101821659=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101821660=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101821661=  NOTE_ TYPE OF COLUMN OTHER.NOTE,'
      
        '1101821662=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101821663=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1101821664=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101821665=RETURNS ('
      '1101821666=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1101821667=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101821668=  ERR_CODE INTEGER,'
      '1101821669=  ERR_MSG VARCHAR(1024))'
      '1101821670=AS'
      '1101821671=/*'
      
        '1101821672='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1101821673='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1101821674=*/'
      
        '1101821675=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1101821676=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101821677=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1101821678=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1101821679=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1101821680=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1101821681=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1101821682=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101821683=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1101821684=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '1101821685=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101821686=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1101821687=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      '1101821688=DECLARE VARIABLE POS_ INTEGER;'
      '1101821689=DECLARE VARIABLE STR_ VARCHAR(300);'
      '1101821690=BEGIN'
      '1101821691=  PNT_ = '#39'00'#39';'
      '1101821692=  COST_PRICE_ = 0;'
      '1101821693='
      '1101821694=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101821695=    SELECT ID'
      '1101821696=      FROM CUR_PARAMS'
      '1101821697=     WHERE CUR_PARAMS = 2'
      '1101821698=      INTO :G_TOCHKA_;'
      '1101821699='
      '1101821700=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1101821701=  SELECT P.S_VALUE'
      '1101821702=    FROM SYSTEM_SETUP P'
      '1101821703=   WHERE P.SYSTEM_SETUP = 2'
      '1101821704=    INTO :CAN_SELL_;'
      '1101821705='
      '1101821706=  IF (LOG_BODY_ IS NOT NULL) THEN'
      '1101821707=    LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM 3);'
      '1101821708='
      '1101821709=  FOR SELECT :G_PRODUCT_IN_,'
      '1101821710=             :AMOUNT_IN_'
      '1101821711=        FROM RDB$DATABASE'
      '1101821712=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '1101821713=      UNION ALL'
      '1101821714=      SELECT G_PRODUCT,'
      '1101821715=             AMOUNT'
      '1101821716=        FROM ZAKAZ_DETAILS_TMP'
      '1101821717=       WHERE :G_PRODUCT_IN_ IS NULL'
      '1101821718=        INTO :G_PRODUCT_,'
      '1101821719=             :AMOUNT_'
      '1101821720=  DO BEGIN'
      '1101821721=      SELECT MAX(G.NAME)'
      '1101821722=        FROM G_PRODUCT G,'
      '1101821723=             G_PRODUCT_KIT K'
      '1101821724=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1101821725=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1101821726=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_' +
        'PRODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TO' +
        'CHKA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1101821727=        INTO :NAME_;'
      '1101821728='
      
        '1101821729=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN B' +
        'EGIN'
      '1101821730=        ERR_CODE = -20500;'
      
        '1101821731=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087 +
        #1088#1086#1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101821732=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101821733=        EXIT;'
      '1101821734=      END'
      '1101821735='
      '1101821736=      PNT_ = '#39'01'#39';'
      
        '1101821737=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TIME, OP_' +
        'TYPE, ARRIVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '1101821738=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_,' +
        ' CURRENT_TIME, 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '1101821739=      RETURNING OTHER'
      '1101821740=      INTO :OTHER_;'
      '1101821741='
      '1101821742=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1101821743=      COST_PRICE_ = 0;'
      '1101821744=      FOR SELECT K.G_PRODUCT_ITEM'
      '1101821745=                ,K.AMOUNT*:AMOUNT_'
      '1101821746=                ,K.amount'
      '1101821747=                ,G.G_PRODUCT'
      '1101821748=            FROM G_PRODUCT_KIT K'
      '1101821749=                ,G_PRODUCT G'
      '1101821750=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101821751=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1101821752=            INTO :ITEM_'
      '1101821753=                ,:AMOUNT_NEED_'
      '1101821754=                ,:AMOUNT_NEED_ONE_'
      '1101821755=                ,:G_PRODUCT_KIT_'
      '1101821756=      DO BEGIN'
      
        '1101821757=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_KIT_, NULL, 1)'
      '1101821758=          RETURNING_VALUES :SELF_PRICE_;'
      '1101821759='
      '1101821760=        UPDATE LT_SKLAD_PRODUCT L'
      '1101821761=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_,'
      '1101821762=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101821763=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1101821764=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101821765='
      '1101821766=        IF (ROW_COUNT = 0) THEN'
      
        '1101821767=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :' +
        'G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1101821768='
      
        '1101821769=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTH' +
        'ER, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1101821770=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_' +
        ', :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1101821771='
      
        '1101821772=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*' +
        'SELF_PRICE_;'
      '1101821773=      END'
      '1101821774='
      
        '1101821775=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1101821776=      PNT_ = '#39'02'#39';'
      
        '1101821777=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101821778=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1101821779='
      '1101821780=      SUMM_ = AMOUNT_*COST_PRICE_;'
      '1101821781='
      '1101821782=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101821783=                              :DATE_,'
      '1101821784=                              CURRENT_TIME,'
      '1101821785=                              NULL, --:G_CLIENT__,'
      
        '1101821786=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1101821787=                              NULL, --:OSNOVANIE__,'
      '1101821788=                              :NOTE_,'
      '1101821789=                              4, --:IS_VOZVRAT_,'
      '1101821790=                              :SUMM_,'
      '1101821791=                              :SUMM_,'
      '1101821792=                              0, --:G_PRIHOD_,'
      '1101821793=                              0 --:SUMM_PRIHOD_)'
      '1101821794=                              ,NULL     --PAYMENTS_'
      
        '1101821795=                              ,0        --SUMM_CURREN' +
        'CY_'
      
        '1101821796=                              ,0        --IS_EXPECTED' +
        '_'
      '1101821797=                              ,:UPLOAD_TO_EXT_APP_'
      
        '1101821798=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101821799=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101821800=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101821801=          EXIT;'
      '1101821802=      END'
      '1101821803='
      '1101821804=      UPDATE OTHER O'
      '1101821805=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1101821806=      WHERE O.OTHER = :OTHER_;'
      '1101821807='
      '1101821808=      -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101821809=      -- '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1042' '#1058#1040#1050#1054#1052' '#1042#1048#1044#1045' "~*'#1041#1051#1040'-'#1041#1051 +
        #1040' '#1058#1040#1050#1054#1049'-'#1058#1054' '#1058#1054#1042#1040#1056'~*'#1041#1051#1040'-'#1041#1051#1040' '#1042#1058#1054#1056#1054#1049' '#1058#1054#1042#1040#1056'~*"'
      
        '1101821810=      -- '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1042#1067#1056#1045#1047#1040#1058#1068'. '#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1058#1040#1050' '#1044#1045#1051#1040#1058#1068 +
        ' '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1040' '#1058#1059#1058' '#1057#1054#1047#1044#1040#1045#1058#1057#1071
      '1101821811=      -- '#1056#1040#1047#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048'-'#1047#1040#1055#1048#1057#1071#1052#1048
      '1101821812=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '1101821813=        POS_ = POSITION('#39'~*'#39' IN LOG_BODY_);'
      
        '1101821814=        IF (CHAR_LENGTH(LOG_BODY_) <> (POS_ + 1)) THE' +
        'N'
      
        '1101821815=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR POS_ ' +
        '- 1);'
      '1101821816=        ELSE'
      
        '1101821817=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR CHAR_' +
        'LENGTH(LOG_BODY_) - 3);'
      '1101821818='
      '1101821819=        --ERR_CODE = -20500;'
      '1101821820=        --ERR_MSG = STR_; EXIT;'
      '1101821821='
      
        '1101821822=        EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, ' +
        ':OTHER_, :DATE_, 1, :SUMM_, :STR_, 1);'
      '1101821823='
      
        '1101821824=        LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM (POSIT' +
        'ION('#39'~*'#39' IN LOG_BODY_)) + 2);'
      '1101821825=      END'
      '1101821826=  END'
      '1101821827=END'
      '1101821828=;'
      '1101821829='
      '1101821830=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '1101821831=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101821832=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101821833=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101821834=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101821835=RETURNS ('
      '1101821836=  ERR_CODE INTEGER,'
      '1101821837=  ERR_MSG VARCHAR(1024))'
      '1101821838=AS'
      '1101821839=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1101821840=DECLARE VARIABLE CNT_ INTEGER;'
      '1101821841=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '1101821842=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      '1101821843=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '1101821844=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1101821845=BEGIN'
      '1101821846=  PROCNAME = '#39'G_DEL_G_PRODUCT'#39';'
      '1101821847='
      '1101821848=  IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101821849=                FROM G_PRODUCT'
      
        '1101821850=               WHERE G_PRODUCT_PAR = :G_PRODUCT_)) th' +
        'en BEGIN'
      '1101821851=    ERR_CODE = -20500;'
      
        '1101821852=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091 +
        #1076#1072#1083#1080#1090#1100' '#1076#1072#1085#1085#1091#1102' '#1075#1088#1091#1087#1087#1091', '#1090'.'#1082'. '#1074' '#1085#1077#1081' '#1089#1086#1089#1090#1086#1103#1090' '#1090#1086#1074#1072#1088#1099'/'#1075#1088#1091#1087#1087#1099'. '#1059#1076#1072#1083#1080#1090#1077' ' +
        #1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101821853=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821854=    EXIT;'
      '1101821855=  END'
      '1101821856='
      '1101821857='
      
        '1101821858=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', ' +
        #39')'
      '1101821859=                    FROM g_product_kit K, g_product g'
      
        '1101821860=                   WHERE K.g_product_item = :G_PRODUC' +
        'T_'
      
        '1101821861=                     and k.g_product = g.g_product) F' +
        'ROM 1 FOR 999)'
      '1101821862=  FROM RDB$DATABASE'
      '1101821863=   INTO :PROD_NAME_;'
      '1101821864=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '1101821865=    ERR_CODE = -20500;'
      
        '1101821866=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083#1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'. '#1059#1076#1072#1083#1080 +
        #1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '1101821867=                                  '#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080 +
        #1090#1077' '#1077#1075#1086' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1072' '#1090#1086#1074#1072#1088#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101821868=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821869=    EXIT;'
      '1101821870=  END'
      '1101821871='
      
        '1101821872=  SELECT ZA.zakaz||'#39' '#1086#1090' '#39'||lpad(extract(day from ZA.Z' +
        '_DATE),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from ZA.Z_DATE),2,'#39'0'#39 +
        ') || '#39'.'#39' || extract(year from ZA.Z_DATE)'
      '1101821873=    FROM ZAKAZ ZA'
      '1101821874=   WHERE ZA.zakaz = (SELECT MIN(Z.ZAKAZ)'
      '1101821875=                        FROM ZAKAZ_DETAILS Z'
      
        '1101821876=                       WHERE Z.G_PRODUCT = :G_PRODUCT' +
        '_)'
      '1101821877=  INTO :NAKL_PROD_;'
      '1101821878=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '1101821879=    ERR_CODE = -20500;'
      
        '1101821880=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1091#1093#1086#1076#1072' ('#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '1101821881='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086 +
        '.'#39'||'#39
      
        '1101821882='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072 +
        #1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      '1101821883=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821884=    EXIT;'
      '1101821885=  END'
      '1101821886='
      
        '1101821887=  SELECT SP.sklad||'#39' '#1086#1090' '#39'||lpad(extract(day from SP.d' +
        'ate_receipt),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from SP.date_re' +
        'ceipt),2,'#39'0'#39') || '#39'.'#39' || extract(year from SP.date_receipt)'
      '1101821888=    FROM sklad_parent SP'
      '1101821889=   WHERE SP.sklad = ( SELECT MIN(S.sklad_parent)'
      '1101821890=                        FROM sklad s'
      
        '1101821891=                       WHERE s.G_PRODUCT = :G_PRODUCT' +
        '_)'
      '1101821892=    INTO :NAKL_PROD_;'
      '1101821893=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '1101821894=    ERR_CODE = -20500;'
      
        '1101821895=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1087#1088#1080#1093#1086#1076#1072' ('#1086#1087#1088#1080#1093#1086#1076#1086#1074#1072#1085#1080#1077'/'#1074#1086#1079#1074#1088#1072#1090'/'#1087#1077#1088#1077 +
        #1084#1077#1097#1077#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '1101821896='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086 +
        '. '#39'||'#39
      
        '1101821897='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072 +
        #1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      '1101821898=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821899=    EXIT;'
      '1101821900=  END'
      '1101821901='
      
        '1101821902=  SELECT lpad(extract(day from MIN(za.op_date)),2,'#39'0'#39 +
        ') || '#39'.'#39' || lpad(extract(month from MIN(za.op_date)),2,'#39'0'#39') || '#39 +
        '.'#39' || extract(year from MIN(za.op_date))'
      '1101821903=    FROM OTHER ZA, OTHER_DETAILS Z'
      '1101821904=   WHERE ZA.OTHER = Z.other'
      '1101821905=     AND Z.G_PRODUCT = :G_PRODUCT_'
      '1101821906=  INTO :NAKL_PROD_;'
      '1101821907=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '1101821908=    ERR_CODE = -20500;'
      
        '1101821909=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090 +
        #1086#1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072' '#1086#1090' '#39'||NAKL_PROD_||'#39' '#1095#1080#1089#1083#1072 +
        '. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '1101821910=                                  '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072 +
        #1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083 +
        #1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101821911=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821912=    EXIT;'
      '1101821913=  END'
      '1101821914='
      '1101821915=  SELECT G.NAME'
      '1101821916=    FROM G_PRODUCT G'
      '1101821917=   WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1101821918=    INTO :NAME_;'
      '1101821919='
      '1101821920=  delete from LT_SKLAD_PRODUCT g'
      '1101821921=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101821922='
      '1101821923=  delete from lt_barcode g'
      '1101821924=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101821925='
      '1101821926=  delete from revision g'
      '1101821927=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101821928='
      '1101821929=  delete from g_product_image g'
      '1101821930=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101821931='
      '1101821932=  delete from g_product_KIT g'
      '1101821933=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101821934='
      '1101821935=  delete from G_PRODUCT g'
      '1101821936=    where g.G_PRODUCT = :G_PRODUCT_;'
      '1101821937='
      '1101821938=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101821939=  EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_PR' +
        'ODUCT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '1101821940='
      
        '1101821941=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054 +
        #1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1101821942=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '1101821943=    UPDATE SYNC_EXT_APP AP'
      '1101821944=       SET AP.OPER = 3'
      '1101821945=     WHERE AP.OBJECT_TYPE = 4'
      '1101821946=       AND AP.ID = :G_PRODUCT_'
      '1101821947=       AND AP.IS_LOADING = 0;'
      '1101821948='
      '1101821949=    IF (ROW_COUNT = 0) THEN'
      
        '1101821950=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101821951=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PR' +
        'ODUCT_, 3);'
      '1101821952=  END'
      '1101821953='
      '1101821954=when sqlcode -530 DO'
      '1101821955=  begin'
      '1101821956=    SELECT G.IS_CATEGORY'
      '1101821957=      FROM G_PRODUCT G'
      '1101821958=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1101821959=      INTO :IS_CATEGORY_;'
      '1101821960='
      '1101821961=    ERR_CODE = -20500;'
      '1101821962=    if (IS_CATEGORY_ = 0) then'
      
        '1101821963=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072 +
        #1085#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '1101821964=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089 +
        #1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072 +
        #1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101821965=    ELSE'
      
        '1101821966=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072 +
        #1085#1085#1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101821967=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1101821968=  end'
      '1101821969=end'
      '1101821970=;'
      '1101821971='
      '1101821972=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101821973=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101821974=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM,'
      '1101821975=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101821976=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101821977=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101821978=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101821979=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101821980=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101821981=  SELF_PRICE_ NUMERIC(15,2),'
      '1101821982=  AMOUNT_ MY_NUMERIC_5,'
      '1101821983=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101821984=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101821985=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101821986=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101821987=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1101821988=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101821989=  CATEGORY_NAME_ VARCHAR(1000),'
      '1101821990=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101821991=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1101821992=  IS_THIS_LAST_ INTEGER,'
      '1101821993=  UPDATE_IF_EXIST_ INTEGER,'
      '1101821994=  DO_SEARCH_CATEGORY_ INTEGER,'
      '1101821995=  BARCODE_IS_MAIN_ INTEGER,'
      '1101821996=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101821997=RETURNS ('
      '1101821998=  ERR_CODE INTEGER,'
      '1101821999=  ERR_MSG VARCHAR(1024))'
      '1101822000=AS'
      
        '1101822001=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_P' +
        'RODUCT'#39';'
      '1101822002=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101822003=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101822004=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT_PAR = NULL;'
      
        '1101822005=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1101822006=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT' +
        ';'
      
        '1101822007=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT = 0;'
      
        '1101822008=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1101822009=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD;'
      
        '1101822010=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1101822011=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM_CURRENCY;'
      '1101822012=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1101822013=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101822014=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      
        '1101822015=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1101822016=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1101822017=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1101822018=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1101822019=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1101822020=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1101822021=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1101822022=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101822023=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1101822024=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1101822025=BEGIN'
      '1101822026=    ERR_MSG = '#39#39';'
      '1101822027=    PNT_ = '#39'00'#39';'
      '1101822028='
      
        '1101822029=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044 +
        #1045#1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '1101822030=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS889' +
        '88~98888~"'
      
        '1101822031=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' ' +
        #1053#1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '1101822032=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '1101822033=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39 +
        '~'#39');'
      '1101822034=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '1101822035=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '1101822036=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '1101822037=    END ELSE'
      '1101822038=        CROSSCODE_ = NULL;'
      '1101822039='
      
        '1101822040=    -------------------------------------------------' +
        '-----------------'
      
        '1101822041=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058#1040#1050 +
        #1054#1049' '#1053#1045#1058
      
        '1101822042=    -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~'#1052#1103 +
        #1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '1101822043=    -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '1101822044=    -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053#1054' ' +
        #1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      '1101822045=    IF (DO_SEARCH_CATEGORY_ = 1) THEN BEGIN'
      
        '1101822046=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BE' +
        'GIN'
      '1101822047=            G_PRODUCT_PAR_ = NULL;'
      
        '1101822048=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAM' +
        'E_);'
      '1101822049=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '1101822050=              STR_ = CATEGORY_NAME_;'
      '1101822051=              CATEGORY_NAME_ = '#39#39';'
      '1101822052=            END ELSE'
      
        '1101822053=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1101822054='
      '1101822055=            SELECT G_PRODUCT'
      '1101822056=              FROM G_PRODUCT G'
      '1101822057=             WHERE G.NAME = :STR_'
      '1101822058=               AND G.IS_CATEGORY = 1'
      
        '1101822059=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1101822060=                   OR'
      
        '1101822061=                   (G.G_PRODUCT_PAR IS NULL AND :G_PR' +
        'ODUCT_PAR_PREV_ IS NULL))'
      '1101822062=              INTO G_PRODUCT_PAR_;'
      '1101822063=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1101822064=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1101822065=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1101822066=                RETURNING G_PRODUCT'
      '1101822067=                INTO :G_PRODUCT_PAR_;'
      '1101822068='
      '1101822069=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1101822070=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1101822071=        END'
      '1101822072=    END'
      
        '1101822073=    -------------------------------------------------' +
        '-----------------'
      '1101822074='
      '1101822075=    PNT_ = '#39'01'#39';'
      '1101822076=    SELECT ID'
      '1101822077=      FROM CUR_PARAMS'
      '1101822078=    WHERE CUR_PARAMS = 2'
      '1101822079=      INTO :G_TOCHKA_;'
      '1101822080='
      '1101822081=    SELECT G.G_UNIT'
      '1101822082=      FROM G_UNIT G'
      
        '1101822083=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAM' +
        'E_G_UNIT_))'
      '1101822084=      INTO :G_UNIT_;'
      '1101822085=    if (ROW_COUNT = 0) then'
      '1101822086=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1101822087='
      '1101822088=    PNT_ = '#39'02'#39';'
      
        '1101822089=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101822090=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1101822091=        SELECT G.G_PRODUCT,'
      '1101822092=               G.NAME'
      '1101822093=          FROM G_PRODUCT G'
      
        '1101822094=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1101822095=           AND TRIM(G.ARTICUL) <> '#39#39
      '1101822096=           AND G.IS_ACTIVE = 1'
      '1101822097=          INTO :G_PRODUCT_,'
      '1101822098=               :G_PRODUCT_NAME_;'
      '1101822099='
      '1101822100=        PNT_ = '#39'02.1'#39';'
      
        '1101822101=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101822102=        IF (COALESCE(G_PRODUCT_, 0) <> 0) THEN BEGIN'
      '1101822103=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101822104=              IF (BARCODE_IS_MAIN_ = 0) THEN BEGIN'
      '1101822105=                  UPDATE G_PRODUCT G'
      '1101822106=                     SET G.NAME = :NAME_,'
      '1101822107=                         G.G_UNIT = :G_UNIT_,'
      
        '1101822108=                         G.PRICE  = DECODE(:PRICE_, -' +
        '999, G.PRICE, :PRICE_),'
      
        '1101822109=                         G.VOLUME_PRICE = DECODE(:VOL' +
        'UME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '1101822110=                         G.PACK_AMOUNT = DECODE(:PACK' +
        '_AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '1101822111=                         G.barcode         = DECODE(C' +
        'HAR_LENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '1101822112=                         G.MF_COUNTRY  = DECODE(CHAR_' +
        'LENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '1101822113=                         G.PLACE = DECODE(CHAR_LENGTH' +
        '(:PLACE_), 0, G.PLACE, :PLACE_),'
      
        '1101822114=                         G.nomenclatur_num = DECODE(C' +
        'HAR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATU' +
        'R_NUM_),'
      
        '1101822115=                         G.KOD_TNVD        = DECODE(C' +
        'HAR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '1101822116=                         G.CROSSCODE      = COALESCE(' +
        ':CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0,' +
        ' G.CROSSCODE, :CROSSCODE_),'
      
        '1101822117=                         G.BRAND          = DECODE(CH' +
        'AR_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '1101822118=                         G.G_PRODUCT_PAR  = COALESCE(' +
        ':G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '1101822119=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101822120='
      
        '1101822121=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083 +
        #1086#1084' '#39'||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101822122='
      
        '1101822123=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051 +
        #1048
      '1101822124=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822125=                      INSERT INTO SYNC_EXT_APP (SYNC_' +
        'EXT_APP, OBJECT_TYPE, ID, OPER)'
      
        '1101822126=                      SELECT GEN_ID(GEN_SYNC_EXT_APP,' +
        ' 1), 4, :G_PRODUCT_, 2'
      '1101822127=                        FROM RDB$DATABASE'
      
        '1101822128=                       WHERE NOT EXISTS (SELECT 1 FRO' +
        'M SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUC' +
        'T_ AND AP.IS_LOADING = 0);'
      '1101822129=              END'
      '1101822130=              ELSE'
      '1101822131=                G_PRODUCT_ = 0;'
      '1101822132=            END ELSE'
      
        '1101822133=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101822134=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAM' +
        'E_||'#39'.'#39';'
      '1101822135=        END'
      '1101822136=    END ELSE'
      
        '1101822137=      EXECUTE PROCEDURE get_free_articul RETURNING_VA' +
        'LUES (:ARTICUL_);'
      '1101822138='
      
        '1101822139=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1101822140=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '1101822141=    PNT_ = '#39'02a'#39';'
      
        '1101822142=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '1101822143=        SELECT G.G_PRODUCT,'
      '1101822144=               G.NAME'
      '1101822145=          FROM G_PRODUCT G'
      
        '1101822146=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_' +
        'NUM_)'
      '1101822147=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '1101822148=           AND G.IS_ACTIVE = 1'
      '1101822149=          INTO :G_PRODUCT_,'
      '1101822150=               :G_PRODUCT_NAME_;'
      '1101822151='
      
        '1101822152=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101822153=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101822154=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101822155=              UPDATE G_PRODUCT G'
      '1101822156=                 SET G.NAME = :NAME_,'
      '1101822157=                     G.G_UNIT = :G_UNIT_,'
      '1101822158=                     G.PRICE  = :PRICE_,'
      '1101822159=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101822160=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101822161=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101822162=                     G.PLACE = :PLACE_,'
      
        '1101822163=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101822164=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101822165=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101822166=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101822167=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101822168=                     ,G.BRAND          = :BRAND_'
      '1101822169=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101822170='
      
        '1101822171=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1101822172=            END ELSE'
      
        '1101822173=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101822174=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1101822175=        END'
      '1101822176=    end'
      '1101822177=    */'
      '1101822178='
      
        '1101822179=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1101822180=    PNT_ = '#39'02.2'#39';'
      
        '1101822181=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1101822182=        SELECT G.G_PRODUCT,'
      '1101822183=               G.NAME'
      '1101822184=          FROM G_PRODUCT G'
      '1101822185=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1101822186=           AND TRIM(G.BARCODE) <> '#39#39
      '1101822187=           AND G.IS_ACTIVE = 1'
      '1101822188=          INTO :G_PRODUCT_,'
      '1101822189=               :G_PRODUCT_NAME_;'
      '1101822190='
      '1101822191=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1101822192=          SELECT G.G_PRODUCT,'
      '1101822193=                 G.NAME'
      '1101822194=            FROM G_PRODUCT G, LT_BARCODE L'
      '1101822195=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101822196=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1101822197=             AND TRIM(L.BARCODE) <> '#39#39
      '1101822198=            INTO :G_PRODUCT_,'
      '1101822199=                 :G_PRODUCT_NAME_;'
      '1101822200='
      
        '1101822201=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101822202=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101822203=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101822204=              IF (BARCODE_IS_MAIN_ = 1) THEN BEGIN'
      '1101822205=                  UPDATE G_PRODUCT G'
      '1101822206=                     SET G.NAME = :NAME_,'
      '1101822207=                         G.G_UNIT = :G_UNIT_,'
      
        '1101822208=                         G.PRICE  = DECODE(:PRICE_, -' +
        '999, G.PRICE, :PRICE_),'
      
        '1101822209=                         G.VOLUME_PRICE = DECODE(:VOL' +
        'UME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '1101822210=                         G.PACK_AMOUNT = DECODE(:PACK' +
        '_AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '1101822211=                         G.articul         = DECODE(C' +
        'HAR_LENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '1101822212=                         G.MF_COUNTRY  = DECODE(CHAR_' +
        'LENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '1101822213=                         G.PLACE = DECODE(CHAR_LENGTH' +
        '(:PLACE_), 0, G.PLACE, :PLACE_),'
      
        '1101822214=                         G.nomenclatur_num = DECODE(C' +
        'HAR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATU' +
        'R_NUM_),'
      
        '1101822215=                         G.KOD_TNVD        = DECODE(C' +
        'HAR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '1101822216=                         G.CROSSCODE      = COALESCE(' +
        ':CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0,' +
        ' G.CROSSCODE, :CROSSCODE_),'
      
        '1101822217=                         G.BRAND          = DECODE(CH' +
        'AR_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '1101822218=                         G.G_PRODUCT_PAR  = COALESCE(' +
        ':G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '1101822219=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101822220='
      
        '1101822221=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086 +
        #1076#1086#1084' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101822222='
      
        '1101822223=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051 +
        #1048
      '1101822224=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822225=                      INSERT INTO SYNC_EXT_APP (SYNC_' +
        'EXT_APP, OBJECT_TYPE, ID, OPER)'
      
        '1101822226=                      SELECT GEN_ID(GEN_SYNC_EXT_APP,' +
        ' 1), 4, :G_PRODUCT_, 2'
      '1101822227=                        FROM RDB$DATABASE'
      
        '1101822228=                       WHERE NOT EXISTS (SELECT 1 FRO' +
        'M SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUC' +
        'T_ AND AP.IS_LOADING = 0);'
      '1101822229=              END'
      '1101822230=              ELSE'
      '1101822231=                G_PRODUCT_ = 0;'
      '1101822232=            END ELSE'
      
        '1101822233=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101822234=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1101822235=        END'
      
        '1101822236=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1101822237=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1101822238='
      
        '1101822239=    --===============================================' +
        '=========='
      '1101822240=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '1101822241=    --===============================================' +
        '=========='
      '1101822242=    PNT_ = '#39'02b'#39';'
      '1101822243=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '1101822244='
      '1101822245=        IF (PRICE_ = -999) THEN'
      '1101822246=          PRICE_ = 0;'
      '1101822247=        IF (VOLUME_PRICE_ = -999) THEN'
      '1101822248=          VOLUME_PRICE_ = 0;'
      '1101822249=        IF (PACK_AMOUNT_ = -999) THEN'
      '1101822250=          PACK_AMOUNT_ = 0;'
      '1101822251='
      
        '1101822252=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1101822253=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '1101822254=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1101822255=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '1101822256=        RETURNING G_PRODUCT'
      '1101822257=        INTO :G_PRODUCT_;'
      '1101822258='
      
        '1101822259=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101822260=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1101822261='
      '1101822262=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1101822263=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822264=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, O' +
        'BJECT_TYPE, ID, OPER)'
      
        '1101822265=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :' +
        'G_PRODUCT_, 1);'
      '1101822266=    end'
      '1101822267='
      
        '1101822268=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101822269=    PNT_ = '#39'03'#39';'
      '1101822270=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1101822271=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1101822272=                                       :AMOUNT_,'
      '1101822273=                                       :SELF_PRICE_,'
      
        '1101822274=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1101822275=                                       0, --nds_,'
      '1101822276=                                       0 --nds_summ_,'
      
        '1101822277=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1101822278=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1101822279=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1101822280=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1101822281=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1101822282=          EXIT;'
      '1101822283=        END'
      '1101822284=    END'
      '1101822285='
      
        '1101822286=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1101822287=    PNT_ = '#39'04'#39';'
      '1101822288=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1101822289=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1101822290=        FROM SKLAD_TMP T'
      '1101822291=        INTO :CNT_;'
      '1101822292='
      '1101822293=      if (CNT_ > 0) then BEGIN'
      '1101822294=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1101822295=          FROM SKLAD_TMP T'
      '1101822296=          INTO :SUMM_, :SUMM_UE_;'
      '1101822297='
      '1101822298=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101822299=                                DATE_RECEIPT,'
      '1101822300=                                TIME_RECEIPT,'
      '1101822301=                                G_CLIENT,'
      '1101822302=                                G_PAYMENT_TYPE,'
      '1101822303=                                OSNOVANIE,'
      '1101822304=                                NOTE,'
      '1101822305=                                SUMM,'
      '1101822306=                                SUMM_FACT,'
      '1101822307=                                SUMM_CURRENCY,'
      '1101822308=                                IS_PAYED_ALL,'
      '1101822309=                                IS_VOZVRAT,'
      '1101822310=                                G_TOCHKA)'
      '1101822311=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101822312=                CURRENT_DATE,'
      '1101822313=                CURRENT_TIME,'
      '1101822314=                :G_CLIENT_,'
      '1101822315=                1,'
      '1101822316=                NULL,  --:OSNOVANIE_,'
      '1101822317=                NULL,  -- :NOTE_,'
      '1101822318=                :SUMM_,'
      '1101822319=                :SUMM_,'
      '1101822320=                :SUMM_UE_,'
      
        '1101822321=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1101822322=                0,'
      '1101822323=                :G_TOCHKA_)'
      '1101822324=        RETURNING'
      '1101822325=          SKLAD'
      '1101822326=        INTO'
      '1101822327=          :SKLAD_PARENT_;'
      '1101822328='
      '1101822329=        PNT_ = '#39'05'#39';'
      '1101822330=        FOR SELECT SKLAD,'
      '1101822331=                   G_PRODUCT,'
      '1101822332=                   AMOUNT,'
      '1101822333=                   PRICE,'
      '1101822334=                   SUMM'
      '1101822335=                   ,PRICE_CURRENCY'
      '1101822336=                   ,SUMM_CURRENCY'
      '1101822337=              FROM SKLAD_TMP'
      '1101822338=             ORDER BY 1'
      '1101822339=              INTO :SKLAD_TMP_,'
      '1101822340=                   :RG_PRODUCT_,'
      '1101822341=                   :RAMOUNT_,'
      '1101822342=                   :RPRICE_,'
      '1101822343=                   :RSUMM_'
      '1101822344=                   ,:RPRICE_UE_'
      '1101822345=                   ,:RSUMM_UE_'
      '1101822346=        DO BEGIN'
      '1101822347='
      '1101822348=            UPDATE SKLAD SK'
      '1101822349=               SET SK.IS_LAST = 0'
      '1101822350=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101822351=               AND SK.IS_LAST = 1;'
      '1101822352='
      '1101822353=            INSERT INTO SKLAD'
      '1101822354=            ('
      '1101822355=             SKLAD,'
      '1101822356=             SKLAD_PARENT,'
      '1101822357=             DATE_RECEIPT,'
      '1101822358=             G_CLIENT,'
      '1101822359=             G_PRODUCT,'
      '1101822360=             AMOUNT,'
      '1101822361=             PRICE,'
      '1101822362=             SUMM,'
      '1101822363=             G_PAYMENT_TYPE,'
      '1101822364=             OSNOVANIE,'
      '1101822365=             NOTE,'
      '1101822366=             NDS,'
      '1101822367=             NDS_SUMM,'
      '1101822368=             IS_LAST,'
      '1101822369=             IS_VOZVRAT,'
      '1101822370=             G_TOCHKA'
      '1101822371=             ,PRICE_CURRENCY'
      '1101822372=             ,SUMM_CURRENCY'
      '1101822373=            ) VALUES ('
      '1101822374=             :SKLAD_TMP_,'
      '1101822375=             :SKLAD_PARENT_,'
      '1101822376=             CURRENT_DATE,'
      '1101822377=             :G_CLIENT_,'
      '1101822378=             :RG_PRODUCT_,'
      '1101822379=             :RAMOUNT_,'
      '1101822380=             :RPRICE_,'
      '1101822381=             :RSUMM_,'
      '1101822382=             1,       --:G_PAYMENT_TYPE_,'
      '1101822383=             NULL,    --:OSNOVANIE_,'
      '1101822384=             NULL,    --:NOTE_,'
      '1101822385=             0,       --:RNDS_,'
      '1101822386=             0,       --:RNDS_SUMM_,'
      '1101822387=             1,       --IS_LAST_'
      '1101822388=             0,        --:IS_VOZVRAT_'
      '1101822389=             :G_TOCHKA_'
      '1101822390=             ,:RPRICE_UE_'
      '1101822391=             ,:RSUMM_UE_'
      '1101822392=            );'
      '1101822393='
      
        '1101822394=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101822395=            PNT_ = '#39'06'#39';'
      '1101822396=            UPDATE LT_SKLAD_PRODUCT L'
      '1101822397=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      
        '1101822398=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101822399=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101822400=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101822401='
      '1101822402=            PNT_ = '#39'06a'#39';'
      '1101822403=            IF (ROW_COUNT = 0) THEN'
      
        '1101822404=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EX' +
        'PORT)'
      
        '1101822405=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1101822406=        END'
      '1101822407='
      '1101822408=        PNT_ = '#39'07'#39';'
      
        '1101822409=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101822410=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1101822411=                                :SUMM_,'
      '1101822412=                                CURRENT_DATE,'
      
        '1101822413=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1101822414=                                NULL,   --ZAKAZ_'
      '1101822415=                                :SKLAD_PARENT_,'
      '1101822416=                                1,'
      
        '1101822417=                                :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101822418=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101822419=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101822420=          EXIT;'
      '1101822421=        END'
      '1101822422='
      '1101822423=        DELETE FROM SKLAD_TMP;'
      '1101822424='
      '1101822425=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1101822426=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822427=          INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJ' +
        'ECT_TYPE, ID, OPER)'
      
        '1101822428=          VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SK' +
        'LAD_, 1);'
      '1101822429=      END'
      '1101822430=    END'
      '1101822431='
      
        '1101822432=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1101822433=    if (ERR_MSG_ IS NOT NULL) then'
      '1101822434=      ERR_MSG = ERR_MSG_;'
      '1101822435='
      '1101822436=WHEN ANY DO BEGIN'
      '1101822437=    IF (GDSCODE = 335544652) THEN BEGIN'
      '1101822438=        Err_code = GDSCODE;'
      
        '1101822439=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1042#1099' '#1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1080 +
        #1084#1087#1086#1088#1090#1080#1088#1086#1074#1072#1090#1100' '#1090#1086#1074#1072#1088#1099' '#1089' '#1086#1076#1080#1085#1072#1082#1086#1074#1099#1084' '#1079#1085#1072#1095#1077#1085#1080#1077#1084'!'#39';'
      '1101822440=        IF (PNT_ = '#39'02'#39') THEN'
      
        '1101822441=            ERR_MSG = ERR_MSG || '#39' '#1040#1088#1090#1080#1082#1091#1083' '#39' || ARTIC' +
        'UL_ || '#39'.'#39';'
      '1101822442=        ELSE'
      
        '1101822443=            ERR_MSG = ERR_MSG || '#39' '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1101822444=    END ELSE BEGIN'
      '1101822445=        Err_code = gdscode;'
      
        '1101822446=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode' +
        '||'#39' --> PNT_ '#39'||PNT_;'
      '1101822447=    END'
      '1101822448=  END'
      '1101822449=END'
      '1101822450=;'
      '1101822451='
      '1101822452=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '1101822453=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101822454=  ARTICUL_ VARCHAR(30),'
      '1101822455=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101822456=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101822457=  NAME_ VARCHAR(500),'
      '1101822458=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101822459=  PRICE_ NUMERIC(15,2),'
      '1101822460=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101822461=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101822462=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101822463=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101822464=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101822465=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101822466=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101822467=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101822468=  IS_CATEGORY_ INTEGER,'
      '1101822469=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101822470=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101822471=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101822472=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101822473=  IS_MARKED_ INTEGER,'
      '1101822474=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      
        '1101822475=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101822476=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1101822477=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101822478=RETURNS ('
      '1101822479=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101822480=  ERR_CODE INTEGER,'
      '1101822481=  ERR_MSG VARCHAR(1024))'
      '1101822482=AS'
      
        '1101822483=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PROD' +
        'UCT'#39';'
      
        '1101822484=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101822485=begin'
      
        '1101822486=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101822487=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '1101822488=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101822489=                      FROM G_PRODUCT G'
      
        '1101822490=                     WHERE UPPER(G.ARTICUL) = UPPER(T' +
        'RIM(:ARTICUL_))'
      '1101822491=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '1101822492=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101822493=          ERR_CODE = -20500;'
      
        '1101822494=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '1101822495=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101822496=          EXIT;'
      '1101822497=        END'
      '1101822498=    end'
      '1101822499='
      
        '1101822500=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1101822501=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      
        '1101822502=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) the' +
        'n begin'
      '1101822503=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101822504=                     FROM G_PRODUCT G'
      
        '1101822505=                    WHERE UPPER(G.NOMENCLATUR_NUM) = ' +
        'UPPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '1101822506=                      AND TRIM(G.NOMENCLATUR_NUM) <> ' +
        #39#39
      
        '1101822507=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101822508=          ERR_CODE = -20500;'
      
        '1101822509=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      '1101822510=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101822511=          EXIT;'
      '1101822512=        END'
      '1101822513=    end*/'
      '1101822514='
      '1101822515=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101822516=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101822517=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '1101822518=                      FROM G_PRODUCT G'
      
        '1101822519=                     WHERE UPPER(G.BARCODE) = UPPER(T' +
        'RIM(:BARCODE_))'
      '1101822520=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '1101822521=                       AND G.IS_ACTIVE = 1)) THEN BEG' +
        'IN'
      '1101822522=          ERR_CODE = -20500;'
      
        '1101822523=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101822524=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101822525=          EXIT;'
      '1101822526=        END'
      '1101822527='
      '1101822528=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101822529=                     FROM G_PRODUCT G, LT_BARCODE L'
      '1101822530=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101822531=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '1101822532=                      AND TRIM(L.BARCODE) <> '#39#39
      
        '1101822533=                      AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '1101822534=          ERR_CODE = -20500;'
      
        '1101822535=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101822536=          ERR_MSG = PROCNAME||ERR_MSG;'
      '1101822537=          EXIT;'
      '1101822538=        END'
      '1101822539=    end'
      '1101822540='
      
        '1101822541=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_P' +
        'RICE,'
      
        '1101822542=                           IS_CATEGORY, PACK_AMOUNT, ' +
        'MF_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_CO' +
        'MM, KOD_TNVD,'
      
        '1101822543=                           FAST_TOVAR, DO_NOT_CHARGE_' +
        'BONUS, IS_MARKED, BRAND)'
      
        '1101822544=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PR' +
        'ICE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '1101822545=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CRO' +
        'SSCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNV' +
        'D_,'
      
        '1101822546=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_, :IS_' +
        'MARKED_, :BRAND_)'
      '1101822547=    RETURNING G_PRODUCT'
      '1101822548=    INTO :G_PRODUCT_;'
      '1101822549='
      '1101822550=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '1101822551=    if (:IS_CATEGORY_ = 0) then begin'
      
        '1101822552=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101822553=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '1101822554='
      '1101822555=        INSERT INTO LT_BARCODE'
      
        '1101822556=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101822557='
      
        '1101822558=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089 +
        #1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '1101822559=        INSERT into G_PRODUCT_IMAGE'
      
        '1101822560=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TY' +
        'PE from G_PRODUCT_IMAGE_TMP;'
      '1101822561='
      
        '1101822562=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074 +
        #1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '1101822563=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076 +
        #1091#1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '1101822564=        IF (is_kit_ > 0) THEN begin'
      '1101822565=            INSERT INTO G_PRODUCT_KIT'
      
        '1101822566=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP;'
      '1101822567='
      '1101822568=            if (is_kit_ = 1) then begin'
      
        '1101822569=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101822570=                  FROM G_PRODUCT_KIT K,'
      '1101822571=                       LT_SKLAD_PRODUCT L'
      '1101822572=                 WHERE K.g_product = :G_PRODUCT_'
      '1101822573=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101822574=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101822575=                 GROUP BY K.G_PRODUCT'
      '1101822576=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101822577='
      '1101822578=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101822579=                   SET L.AMOUNT = COALESCE(:G_PRODUCT' +
        '_SOSTAV_AMOUNT_, 0)'
      '1101822580=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101822581=            end'
      '1101822582=        END'
      '1101822583=    END'
      '1101822584='
      '1101822585=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101822586=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 1, 0, :LOG_BODY_, 0, :NAME_);'
      '1101822587='
      '1101822588=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1101822589=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822590=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101822591=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PR' +
        'ODUCT_, 1);'
      '1101822592=end'
      '1101822593=;'
      '1101822594='
      '1101822595=ALTER PROCEDURE G_INS_G_PRODUCT_CAT('
      
        '1101822596=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101822597=  NAME_ VARCHAR(500),'
      '1101822598=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      
        '1101822599=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SH' +
        'OW_RMK,'
      '1101822600=  IS_CATEGORY_ INTEGER,'
      '1101822601=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101822602=RETURNS ('
      '1101822603=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101822604=  ERR_CODE INTEGER,'
      '1101822605=  ERR_MSG VARCHAR(1024))'
      '1101822606=AS'
      '1101822607=begin'
      
        '1101822608=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, ' +
        'NAME, IS_CATEGORY, IS_KIT, DO_NOT_SHOW_RMK)'
      
        '1101822609=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_' +
        ', :NAME_, :IS_CATEGORY_, :IS_KIT_, :DO_NOT_SHOW_RMK_)'
      '1101822610=    RETURNING G_PRODUCT'
      '1101822611=    INTO :G_PRODUCT_;'
      '1101822612='
      '1101822613=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1101822614=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822615=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101822616=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PR' +
        'ODUCT_, 1);'
      '1101822617=end'
      '1101822618=;'
      '1101822619='
      '1101822620=ALTER PROCEDURE G_PRODUCT_SET_NEW_PRICES('
      '1101822621=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101822622=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101822623=  CHANGE_PRICE_ INTEGER,'
      '1101822624=  MODE_ INTEGER,'
      '1101822625=  WHAT_PRICE_ INTEGER,'
      '1101822626=  NEW_VAL_ NUMERIC(15,2),'
      '1101822627=  COURSE_OLD_ NUMERIC(15,2),'
      '1101822628=  COURSE_NEW_ NUMERIC(15,2),'
      '1101822629=  ROUND_MODE_ INTEGER,'
      '1101822630=  CHANGE_CATEGORY_ INTEGER,'
      '1101822631=  NEW_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101822632=  CHANGE_MIN_AMOUNT_ INTEGER,'
      
        '1101822633=  NEW_MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT' +
        ','
      '1101822634=  CHANGE_SALES_COMM_ INTEGER,'
      
        '1101822635=  NEW_SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM' +
        ','
      '1101822636=  CHANGE_KIT_TYPE_ INTEGER)'
      '1101822637=RETURNS ('
      '1101822638=  ERR_CODE INTEGER,'
      '1101822639=  ERR_MSG VARCHAR(1000))'
      '1101822640=AS'
      
        '1101822641=/*ROUND_MODE_ 0 - '#1076#1077#1089#1103#1090#1099#1077', 1 - '#1094#1077#1083#1099#1077', 2 '#1076#1077#1089#1103#1090#1082#1080', 3 '#1089#1086 +
        #1090#1085#1080', 4 '#1090#1099#1089#1103#1095#1080
      '1101822642='
      '1101822643=CHANGE_KIT_TYPE_ - '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040
      '1101822644=*/'
      
        '1101822645=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT;'
      
        '1101822646=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRIC' +
        'E;'
      
        '1101822647=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.' +
        'VOLUME_PRICE;'
      '1101822648=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '1101822649=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '1101822650=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101822651=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '1101822652=BEGIN'
      '1101822653='
      '1101822654=  SQL_STR_ = '#39'UPDATE G_PRODUCT P'#39'||'
      '1101822655=               '#39' SET '#39';'
      '1101822656='
      '1101822657=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1101822658='
      '1101822659=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '1101822660=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '1101822661=      IF (ROUND_MODE_ = 0) THEN'
      '1101822662=          ROUND_ = 1;'
      '1101822663=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '1101822664=          ROUND_ = 0;'
      '1101822665=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '1101822666=          ROUND_ = -1;'
      '1101822667=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '1101822668=          ROUND_ = -2;'
      '1101822669=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '1101822670=          ROUND_ = -3;'
      '1101822671='
      '1101822672=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' %'
      '1101822673=      IF (MODE_ = 0) THEN'
      
        '1101822674=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '1101822675=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '1101822676='
      '1101822677=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '1101822678=      ELSE IF (MODE_ = 1) THEN'
      
        '1101822679=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '1101822680=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '1101822681='
      '1101822682=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' %'
      '1101822683=      ELSE IF (MODE_ = 2) THEN'
      
        '1101822684=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E * (1 - '#39'||:NEW_VAL_||'#39'/100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '1101822685=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE * (1 - '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '1101822686='
      '1101822687=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '1101822688=      ELSE IF (MODE_ = 3) THEN'
      
        '1101822689=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '1101822690=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '1101822691='
      '1101822692=      --'#1048#1047#1052#1045#1053#1048#1058#1068' '#1055#1054' '#1042#1040#1051#1070#1058#1045
      '1101822693=      ELSE IF (MODE_ = 4) THEN'
      
        '1101822694=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRIC' +
        'E/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '1101822695=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_' +
        'PRICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '1101822696='
      '1101822697=      ELSE BEGIN'
      '1101822698=        SELECT ID'
      '1101822699=          FROM CUR_PARAMS'
      '1101822700=         WHERE CUR_PARAMS = 2'
      '1101822701=          INTO :G_TOCHKA_;'
      '1101822702='
      '1101822703=        IF (WHAT_PRICE_ = 0) THEN'
      
        '1101822704=          SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND((SEL' +
        'ECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_||'#39', 0)' +
        ') * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '1101822705=        ELSE'
      
        '1101822706=          SQL_STR_ = SQL_STR_ ||'#39'P.VOLUME_PRICE = ROU' +
        'ND((SELECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_' +
        '||'#39', 0)) * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '1101822707=      END'
      '1101822708=  END'
      '1101822709='
      '1101822710=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '1101822711=  IF (CHANGE_CATEGORY_ = 1) THEN BEGIN'
      '1101822712=    IF (CHANGE_PRICE_ = 1) THEN'
      '1101822713=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1101822714='
      
        '1101822715=    SQL_STR_ = SQL_STR_ ||'#39'P.G_PRODUCT_PAR = '#39'||:NEW_' +
        'CATEGORY_;'
      '1101822716=  END'
      '1101822717='
      '1101822718=  -- '#1052#1045#1053#1071#1070' '#1052#1048#1053' '#1054#1057#1058#1040#1058#1054#1050
      '1101822719=  IF (CHANGE_MIN_AMOUNT_ = 1) THEN BEGIN'
      '1101822720=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_) > 0) THEN'
      '1101822721=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1101822722='
      
        '1101822723=    SQL_STR_ = SQL_STR_ ||'#39'P.MIN_AMOUNT = '#39'||:NEW_MIN' +
        '_AMOUNT_;'
      '1101822724=  END'
      '1101822725='
      '1101822726=  -- '#1052#1045#1053#1071#1070' '#1050#1054#1052#1048#1057#1057#1048#1070' '#1055#1056#1054#1044#1040#1042#1062#1040
      '1101822727=  IF (CHANGE_SALES_COMM_ = 1) THEN BEGIN'
      
        '1101822728=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MI' +
        'N_AMOUNT_) > 0) THEN'
      '1101822729=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1101822730='
      
        '1101822731=    SQL_STR_ = SQL_STR_ ||'#39'P.SALES_COMM = '#39'||:NEW_SAL' +
        'ES_COMM_;'
      '1101822732=  END'
      '1101822733='
      
        '1101822734=  -- '#1052#1045#1053#1071#1070' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040' - '#1057' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1053#1040' '#1055#1056#1054#1044#1059#1050#1058' '#1048#1051#1048' ' +
        #1053#1040#1054#1041#1054#1056#1054#1058
      '1101822735=  IF (CHANGE_KIT_TYPE_ > 1) THEN BEGIN'
      
        '1101822736=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MI' +
        'N_AMOUNT_ + CHANGE_SALES_COMM_) > 0) THEN'
      '1101822737=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '1101822738='
      
        '1101822739=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KIT = '#39'||:CHANGE_KIT_' +
        'TYPE_;'
      '1101822740='
      
        '1101822741=    -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1058#1048#1055' '#1058#1054#1042#1040#1056#1040' '#1057' "'#1057#1054#1057#1058#1040#1042#1053#1054#1049'" '#1053#1040' "'#1055#1056#1054 +
        #1044#1059#1050#1058'", '#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1053#1059#1051#1048#1058#1068' '#1042#1057#1045' '#1054#1057#1058#1040#1058#1050#1048' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042
      '1101822742=    IF (CHANGE_KIT_TYPE_ = 2) THEN'
      '1101822743=      UPDATE LT_SKLAD_PRODUCT P'
      '1101822744=         SET P.AMOUNT = 0,'
      '1101822745=             P.NEED_TO_EXPORT = 1'
      '1101822746=       WHERE EXISTS (SELECT 1'
      '1101822747=                       FROM G_PRODUCT GP'
      
        '1101822748=                      WHERE GP.G_PRODUCT = P.G_PRODUC' +
        'T'
      '1101822749=                        AND GP.IS_KIT = 1'
      
        '1101822750=                        AND ((:G_PRODUCT_ CONTAINING ' +
        #39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101822751=                             OR'
      
        '1101822752=                             (GP.G_PRODUCT = GP.G_PRO' +
        'DUCT AND :G_PRODUCT_ IS NULL)'
      '1101822753=                            )'
      '1101822754=                        AND ('
      
        '1101822755=                             ((GP.G_PRODUCT_PAR IN (S' +
        'ELECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE :G_CATEGORY_ CONTAIN' +
        'ING '#39'~'#39'||PT.G_PRODUCT||'#39'~'#39')) AND :g_category_ IS NOT NULL)'
      '1101822756=                              OR'
      
        '1101822757=                             (GP.G_PRODUCT_PAR = GP.G' +
        '_PRODUCT_PAR AND :g_category_ IS NULL)'
      '1101822758=                            )'
      '1101822759=                    );'
      '1101822760=  END'
      '1101822761='
      '1101822762=  SQL_STR_ = SQL_STR_ ||'#39' WHERE P.IS_ACTIVE = 1'#39';'
      '1101822763='
      '1101822764=  IF (CHANGE_KIT_TYPE_ = 0) THEN'
      '1101822765=    SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_KIT <> 1'#39';'
      '1101822766='
      '1101822767=  SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_CATEGORY = 0'#39';'
      '1101822768='
      '1101822769=  IF (g_category_ IS NOT NULL) THEN'
      
        '1101822770=    SQL_STR_ = SQL_STR_ ||'#39' AND P.G_PRODUCT_PAR IN (S' +
        'ELECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE '#39#39#39'||G_CATEGORY_||'#39#39 +
        #39' CONTAINING '#39#39'~'#39#39'||PT.G_PRODUCT||'#39#39'~'#39#39')'#39';'
      '1101822771='
      '1101822772='
      '1101822773=  IF (G_PRODUCT_ IS NOT NULL) THEN'
      
        '1101822774=    SQL_STR_ = SQL_STR_ ||'#39' AND '#39#39#39'||G_PRODUCT_||'#39#39#39' ' +
        'CONTAINING '#39#39'~'#39#39'||P.G_PRODUCT||'#39#39'~'#39#39#39';'
      '1101822775='
      '1101822776=  --ERR_CODE = -20500;'
      '1101822777=  --ERR_MSG = SQL_STR_; EXIT;'
      '1101822778='
      '1101822779=  EXECUTE STATEMENT :SQL_STR_;'
      '1101822780=END'
      '1101822781=;'
      '1101822782='
      '1101822783=ALTER PROCEDURE G_TOCHKA_DEL('
      '1101822784=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101822785=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101822786=RETURNS ('
      '1101822787=  ERR_CODE INTEGER,'
      '1101822788=  ERR_MSG VARCHAR(1024))'
      '1101822789=AS'
      '1101822790=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '1101822791=BEGIN'
      '1101822792=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '1101822793=    ERR_CODE = -20500;'
      
        '1101822794=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091 +
        #1076#1072#1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101822795=    EXIT;'
      '1101822796=  END'
      '1101822797='
      '1101822798=  DELETE FROM KASSA_STATE S'
      '1101822799=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1101822800='
      
        '1101822801=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '1101822802=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0) THEN'
      
        '1101822803=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1101822804=      VALUES (GEN_ID(GEN_LOGS, 1), '#39'DELETE FROM KASSA' +
        '_STATE S WHERE S.G_TOCHKA = '#39'||:G_TOCHKA_||'#39';'#39', '#39'SYSDBA'#39', 0, CUR' +
        'RENT_TIMESTAMP, :ERR_CODE);'
      '1101822805='
      '1101822806=  DELETE FROM KASSA S'
      '1101822807=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1101822808='
      '1101822809=  FOR SELECT KASSA_BEZNAL'
      '1101822810=        FROM KASSA_BEZNAL'
      '1101822811=       WHERE G_TOCHKA = :G_TOCHKA_'
      '1101822812=        INTO :KASSA_'
      '1101822813=  DO BEGIN'
      
        '1101822814=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNI' +
        'NG_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101822815=    IF (:ERR_CODE <> 0) THEN'
      '1101822816=      EXIT;'
      '1101822817=  END'
      '1101822818='
      '1101822819=  UPDATE G_OFFICIAL O'
      '1101822820=     SET O.G_TOCHKA = NULL'
      '1101822821=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '1101822822='
      '1101822823=  DELETE FROM INVOICE I'
      '1101822824=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1101822825=                      FROM ZAKAZ'
      '1101822826=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101822827='
      '1101822828=  DELETE FROM INVOICE_PAY I'
      '1101822829=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1101822830=                      FROM ZAKAZ'
      '1101822831=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101822832='
      '1101822833=  DELETE FROM WAYBILL I'
      '1101822834=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1101822835=                      FROM ZAKAZ'
      '1101822836=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101822837='
      '1101822838=  DELETE FROM LT_ZAKAZ_REAL R'
      '1101822839=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '1101822840=                              FROM ZAKAZ Z, ZAKAZ_DET' +
        'AILS ZD'
      
        '1101822841=                             WHERE Z.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '1101822842=                               AND Z.ZAKAZ = ZD.ZAKAZ' +
        ');'
      '1101822843='
      '1101822844=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '1101822845=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1101822846=                                  FROM ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1101822847=                                 WHERE G_TOCHKA = :G_' +
        'TOCHKA_);'
      '1101822848='
      '1101822849=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '1101822850=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101822851='
      '1101822852=  DELETE FROM ZAKAZ_DETAILS D'
      '1101822853=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1101822854=                      FROM ZAKAZ'
      '1101822855=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101822856='
      '1101822857=  DELETE FROM ZAKAZ D'
      '1101822858=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101822859='
      '1101822860=  DELETE FROM SKLAD D'
      '1101822861=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101822862='
      '1101822863=  DELETE FROM SKLAD_PARENT D'
      '1101822864=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101822865='
      '1101822866=  DELETE FROM ZAKAZ_DETAILS D'
      '1101822867=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1101822868=                      FROM ZAKAZ'
      '1101822869=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101822870='
      '1101822871=  DELETE FROM LT_SKLAD_PRODUCT'
      '1101822872=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '1101822873='
      '1101822874=  DELETE FROM G_TOCHKA'
      '1101822875=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '1101822876='
      
        '1101822877=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054 +
        #1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1101822878=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '1101822879=    UPDATE SYNC_EXT_APP AP'
      '1101822880=       SET AP.OPER = 3'
      '1101822881=     WHERE AP.OBJECT_TYPE = 3'
      '1101822882=       AND AP.ID = :G_TOCHKA_'
      '1101822883=       AND AP.IS_LOADING = 0;'
      '1101822884='
      '1101822885=    IF (ROW_COUNT = 0) THEN'
      
        '1101822886=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101822887=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 3, :G_TO' +
        'CHKA_, 3);'
      '1101822888=  END'
      '1101822889=END'
      '1101822890=;'
      '1101822891='
      '1101822892=ALTER PROCEDURE G_TOCHKA_INS('
      '1101822893=  NAME_ TYPE OF COLUMN G_TOCHKA.NAME,'
      '1101822894=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101822895=RETURNS ('
      '1101822896=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101822897=AS'
      '1101822898=BEGIN'
      '1101822899=  INSERT INTO G_TOCHKA ('
      '1101822900=    G_TOCHKA,'
      '1101822901=    NAME)'
      '1101822902=  VALUES ('
      '1101822903=    GEN_ID(GEN_G_TOCHKA, 1),'
      '1101822904=    :NAME_)'
      '1101822905=  RETURNING'
      '1101822906=    G_TOCHKA'
      '1101822907=  INTO'
      '1101822908=    :G_TOCHKA_;'
      '1101822909='
      '1101822910=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1101822911=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822912=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101822913=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 3, :G_TOCHKA' +
        '_, 1);'
      '1101822914=END'
      '1101822915=;'
      '1101822916='
      '1101822917=ALTER PROCEDURE G_TOCHKA_UPD('
      '1101822918=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101822919=  NAME_ TYPE OF COLUMN G_TOCHKA.NAME,'
      '1101822920=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101822921=AS'
      '1101822922=BEGIN'
      '1101822923=  UPDATE G_TOCHKA'
      '1101822924=  SET NAME = :NAME_'
      '1101822925=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '1101822926='
      
        '1101822927=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054 +
        #1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1101822928=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101822929=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101822930=    SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 3, :G_TOCHKA_' +
        ', 2'
      '1101822931=      FROM RDB$DATABASE'
      
        '1101822932=     WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP ' +
        'WHERE AP.OBJECT_TYPE = 3 AND AP.ID = :G_TOCHKA_ AND AP.IS_LOADIN' +
        'G = 0);'
      '1101822933=END'
      '1101822934=;'
      '1101822935='
      '1101822936=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '1101822937=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101822938=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101822939=  ARTICUL_ VARCHAR(30),'
      '1101822940=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '1101822941=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101822942=  NAME_ VARCHAR(500),'
      '1101822943=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1101822944=  PRICE_ NUMERIC(15,2),'
      '1101822945=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1101822946=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101822947=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101822948=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101822949=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101822950=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101822951=  IS_CATEGORY_ INTEGER,'
      '1101822952=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1101822953=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101822954=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '1101822955=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101822956=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '1101822957=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NO' +
        'T_CHARGE_BONUS,'
      '1101822958=  IS_MARKED_ INTEGER,'
      '1101822959=  BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND,'
      
        '1101822960=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101822961=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1101822962=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101822963=RETURNS ('
      '1101822964=  ERR_CODE INTEGER,'
      '1101822965=  ERR_MSG VARCHAR(1024))'
      '1101822966=AS'
      
        '1101822967=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PROD' +
        'UCT'#39';'
      
        '1101822968=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COL' +
        'UMN LT_SKLAD_PRODUCT.AMOUNT;'
      '1101822969=begin'
      
        '1101822970=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101822971=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '1101822972=                  FROM G_PRODUCT G'
      
        '1101822973=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(' +
        ':ARTICUL_))'
      '1101822974=                   AND TRIM(G.ARTICUL) <> '#39#39
      '1101822975=                   AND TRIM(:ARTICUL_) <> '#39#39
      '1101822976=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101822977=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101822978=      ERR_CODE = -20500;'
      
        '1101822979=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '1101822980=      EXIT;'
      '1101822981=    END'
      '1101822982='
      
        '1101822983=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100 +
        #1085#1099#1084
      
        '1101822984=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052
      '1101822985=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101822986=                  FROM G_PRODUCT G'
      
        '1101822987=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPP' +
        'ER(TRIM(:NOMENCLATUR_NUM_))'
      '1101822988=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1101822989=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1101822990=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101822991=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101822992=      ERR_CODE = -20500;'
      
        '1101822993=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' ' +
        #1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETU' +
        'RNING_VALUES (:ERR_MSG);'
      '1101822994=      EXIT;'
      '1101822995=    END'
      '1101822996=    */'
      '1101822997='
      '1101822998=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1101822999=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1101823000=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '1101823001=                  FROM G_PRODUCT G'
      
        '1101823002=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(' +
        ':BARCODE_))'
      '1101823003=                   AND TRIM(G.BARCODE) <> '#39#39
      '1101823004=                   AND TRIM(:BARCODE_) <> '#39#39
      '1101823005=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '1101823006=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101823007=          ERR_CODE = -20500;'
      
        '1101823008=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101823009=          EXIT;'
      '1101823010=        END'
      '1101823011='
      '1101823012=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '1101823013=                    FROM G_PRODUCT G, LT_BARCODE L'
      '1101823014=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101823015=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '1101823016=                     AND TRIM(L.BARCODE) <> '#39#39
      '1101823017=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '1101823018=          ERR_CODE = -20500;'
      
        '1101823019=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058 +
        #1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '1101823020=          EXIT;'
      '1101823021=        END'
      '1101823022=    END'
      '1101823023='
      '1101823024=    update G_PRODUCT'
      '1101823025=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1101823026=        ARTICUL = :ARTICUL_,'
      '1101823027=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1101823028=        BARCODE = :BARCODE_,'
      '1101823029=        NAME = :NAME_,'
      '1101823030=        G_UNIT = :G_UNIT_,'
      '1101823031=        PRICE = :PRICE_,'
      '1101823032=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101823033=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1101823034=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1101823035=        NOTE         = :NOTE_,'
      '1101823036=        CROSSCODE    = :CROSSCODE_,'
      '1101823037=        IS_KIT       = :IS_KIT_,'
      '1101823038=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1101823039=        PLACE        = :PLACE_,'
      '1101823040=        SALES_COMM   = :SALES_COMM_,'
      '1101823041=        KOD_TNVD     = :KOD_TNVD_,'
      '1101823042=        FAST_TOVAR   = :FAST_TOVAR_,'
      '1101823043=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '1101823044=        IS_MARKED    = :IS_MARKED_,'
      '1101823045=        BRAND        = :BRAND_'
      '1101823046=    where (G_PRODUCT = :G_PRODUCT_);'
      '1101823047='
      '1101823048=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '1101823049=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '1101823050='
      '1101823051=        INSERT INTO LT_BARCODE'
      
        '1101823052=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM ' +
        'LT_BARCODE_TMP;'
      '1101823053='
      '1101823054=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '1101823055=        INSERT INTO G_PRODUCT_IMAGE'
      
        '1101823056=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT' +
        ' EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T' +
        '.G_PRODUCT_IMAGE);'
      '1101823057='
      
        '1101823058=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G' +
        '_PRODUCT_IMAGE)'
      '1101823059=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101823060='
      '1101823061=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '1101823062=        IF (IS_KIT_ > 0) THEN BEGIN'
      '1101823063=            /*INSERT INTO G_PRODUCT_KIT'
      
        '1101823064=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_K' +
        'IT_TMP T'
      
        '1101823065=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT' +
        '_KIT'
      
        '1101823066=                               WHERE G_PRODUCT_ITEM =' +
        ' T.G_PRODUCT_ITEM'
      
        '1101823067=                                 AND G_PRODUCT = T.g_' +
        'product);'
      '1101823068='
      
        '1101823069=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXI' +
        'STS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_' +
        'PRODUCT_ITEM)'
      '1101823070=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '1101823071='
      '1101823072=            UPDATE G_PRODUCT_KIT G'
      
        '1101823073=               SET G.AMOUNT = (SELECT AMOUNT FROM G_P' +
        'RODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '1101823074=                   G.PRICE  = (SELECT PRICE FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '1101823075=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KI' +
        'T_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.A' +
        'MOUNT or PRICE <> G.PRICE))'
      '1101823076=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '1101823077='
      
        '1101823078=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' ' +
        #1074#1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '1101823079=            */'
      
        '1101823080=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PRO' +
        'DUCT = :G_PRODUCT_;'
      '1101823081=            INSERT INTO G_PRODUCT_KIT'
      
        '1101823082=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PROD' +
        'UCT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '1101823083=            FROM G_PRODUCT_KIT_TMP T;'
      '1101823084='
      
        '1101823085=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086 +
        #1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '1101823086=            if (is_kit_ = 1) then begin'
      
        '1101823087=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESER' +
        'VE)/K.amount)'
      '1101823088=                  FROM G_PRODUCT_KIT K,'
      '1101823089=                       LT_SKLAD_PRODUCT L'
      '1101823090=                 WHERE K.g_product = :G_PRODUCT_'
      '1101823091=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '1101823092=                   AND L.G_TOCHKA = (SELECT ID FROM C' +
        'UR_PARAMS WHERE CUR_PARAMS = 2)'
      '1101823093=                 GROUP BY K.G_PRODUCT'
      '1101823094=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '1101823095='
      '1101823096=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101823097=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_A' +
        'MOUNT_'
      '1101823098=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '1101823099=            end'
      '1101823100=        END'
      '1101823101=    END'
      '1101823102='
      '1101823103=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101823104=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_' +
        'PRODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '1101823105='
      
        '1101823106=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1101823107=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101823108=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101823109=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 2'
      '1101823110=          FROM RDB$DATABASE'
      
        '1101823111=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP' +
        ' AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_L' +
        'OADING = 0);'
      '1101823112=end'
      '1101823113=;'
      '1101823114='
      '1101823115=ALTER PROCEDURE G_UPD_G_PRODUCT_CAT('
      '1101823116=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '1101823117=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1101823118=  NAME_ VARCHAR(500),'
      '1101823119=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      
        '1101823120=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SH' +
        'OW_RMK,'
      '1101823121=  IS_CATEGORY_ INTEGER,'
      '1101823122=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101823123=RETURNS ('
      '1101823124=  ERR_CODE INTEGER,'
      '1101823125=  ERR_MSG VARCHAR(1024))'
      '1101823126=AS'
      '1101823127=begin'
      '1101823128=    UPDATE G_PRODUCT G'
      '1101823129=       SET G.g_product_par = :G_PRODUCT_PAR_'
      '1101823130=           ,G.name = :name_'
      '1101823131=           ,G.DO_NOT_SHOW_RMK = :DO_NOT_SHOW_RMK_'
      '1101823132=     WHERE G.g_product = :G_PRODUCT_;'
      '1101823133='
      
        '1101823134=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '1101823135=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1101823136=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101823137=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 2'
      '1101823138=          FROM RDB$DATABASE'
      
        '1101823139=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP' +
        ' AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_L' +
        'OADING = 0);'
      '1101823140=end'
      '1101823141=;'
      '1101823142='
      '1101823143=ALTER PROCEDURE INS_SKLAD('
      '1101823144=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1101823145=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1101823146=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1101823147=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1101823148=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1101823149=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1101823150=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1101823151=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1101823152=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101823153=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1101823154=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101823155=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101823156=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1101823157=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1101823158=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1101823159=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1101823160=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101823161=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101823162=RETURNS ('
      '1101823163=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101823164=  ERR_CODE INTEGER,'
      '1101823165=  ERR_MSG VARCHAR(1024))'
      '1101823166=AS'
      '1101823167=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '1101823168=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054 +
        #1042#1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '1101823169=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '1101823170=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '1101823171=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059 +
        #1055#1050#1048
      
        '1101823172=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '1101823173=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053 +
        #1050#1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054 +
        #1047#1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '1101823174=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041 +
        #1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUM' +
        'M '#1041#1059#1044#1059
      '1101823175=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1101823176=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048 +
        #1047#1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053 +
        #1048' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '1101823177=--'
      
        '1101823178=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1101823179=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1101823180=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '1101823181=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101823182=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1101823183=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1101823184=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1101823185=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1101823186=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '1101823187=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_' +
        'SUMM = 0;'
      
        '1101823188=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      '1101823189=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101823190=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PR' +
        'IHOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '1101823191=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101823192=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101823193=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1101823194=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101823195=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101823196=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1101823197=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101823198=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101823199=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1101823200=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1101823201=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101823202=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1101823203=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1101823204=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK' +
        '_CODE;'
      '1101823205=BEGIN'
      '1101823206='
      '1101823207=  PNT_ = '#39'00'#39';'
      '1101823208=  IS_THIS_LAST_ = 0;'
      '1101823209='
      '1101823210=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101823211=    SELECT ID'
      '1101823212=      FROM CUR_PARAMS'
      '1101823213=     WHERE CUR_PARAMS = 2'
      '1101823214=      INTO :G_TOCHKA_;'
      '1101823215='
      '1101823216=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1101823217=  SELECT ID'
      '1101823218=    FROM CUR_PARAMS'
      '1101823219=   WHERE CUR_PARAMS = 1'
      '1101823220=    INTO :G_OFFICIAL_;'
      '1101823221='
      '1101823222=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101823223=                            DATE_RECEIPT,'
      '1101823224=                            TIME_RECEIPT,'
      '1101823225=                            G_CLIENT,'
      '1101823226=                            G_PAYMENT_TYPE,'
      '1101823227=                            OSNOVANIE,'
      '1101823228=                            NOTE,'
      '1101823229=                            SUMM,'
      '1101823230=                            SUMM_FACT,'
      '1101823231=                            SUMM_CURRENCY,'
      '1101823232=                            IS_PAYED_ALL,'
      '1101823233=                            IS_VOZVRAT,'
      '1101823234=                            G_TOCHKA'
      '1101823235=                            ,G_OFFICIAL'
      '1101823236=                            ,IS_EXPECTED)'
      '1101823237=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101823238=          :DATE_RECEIPT_,'
      '1101823239=          :TIME_RECEIPT_,'
      '1101823240=          :G_CLIENT_,'
      '1101823241=          :G_PAYMENT_TYPE_,'
      '1101823242=          :OSNOVANIE_,'
      '1101823243=          :NOTE_,'
      '1101823244=          :SUMM_,'
      '1101823245=          :SUMM_FACT_,'
      '1101823246=          :SUMM_CURRENCY_,'
      
        '1101823247=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_P' +
        'AYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' ' +
        '"'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101823248=          :IS_VOZVRAT_,'
      '1101823249=          :G_TOCHKA_'
      '1101823250=          ,:G_OFFICIAL_'
      '1101823251=          ,:IS_EXPECTED_)'
      '1101823252=  RETURNING'
      '1101823253=    SKLAD'
      '1101823254=  INTO'
      '1101823255=    :SKLAD_;'
      '1101823256='
      '1101823257=  PNT_ = '#39'01'#39';'
      '1101823258=  FOR SELECT SKLAD,'
      '1101823259=             T.G_PRODUCT,'
      '1101823260=             AMOUNT,'
      '1101823261=             T.PRICE,'
      '1101823262=             SUMM,'
      '1101823263=             NDS,'
      '1101823264=             NDS_SUMM'
      '1101823265=             ,PRICE_CURRENCY'
      '1101823266=             ,SUMM_CURRENCY'
      '1101823267=             ,PRICE_ROZN'
      '1101823268=             ,GG.PRICE'
      '1101823269=             ,T.MARK_CODE'
      '1101823270=        FROM SKLAD_TMP T,'
      '1101823271=             G_PRODUCT GG'
      '1101823272=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '1101823273=      ORDER BY 1'
      '1101823274=      INTO :SKLAD_TMP_,'
      '1101823275=           :RG_PRODUCT_,'
      '1101823276=           :RAMOUNT_,'
      '1101823277=           :RPRICE_,'
      '1101823278=           :RSUMM_,'
      '1101823279=           :RNDS_,'
      '1101823280=           :RNDS_SUMM_'
      '1101823281=           ,:PRICE_CURRENCY_'
      '1101823282=           ,:SUMM_CURRENCY_TMP_'
      '1101823283=           ,:SALE_PRICE_'
      '1101823284=           ,:SALE_PRICE_CUR_'
      '1101823285=           ,:MARK_CODE_'
      '1101823286=  DO BEGIN'
      '1101823287=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '1101823288=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST,' +
        ' '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101823289=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051 +
        #1068#1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '1101823290=      IS_THIS_LAST_ = 0;'
      '1101823291=      SELECT MAX(SK.DATE_RECEIPT)'
      '1101823292=        FROM SKLAD SK'
      '1101823293=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101823294=         AND SK.IS_LAST = 1'
      '1101823295=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '1101823296=        INTO :DATE_LAST_;'
      '1101823297='
      
        '1101823298=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or ' +
        '(DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101823299=        UPDATE SKLAD SK'
      '1101823300=           SET SK.IS_LAST = 0'
      '1101823301=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101823302=           AND SK.IS_LAST = 1'
      '1101823303=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1101823304='
      '1101823305=        IS_THIS_LAST_ = 1;'
      '1101823306=      END'
      '1101823307=    END'
      '1101823308='
      '1101823309=    INSERT INTO SKLAD'
      '1101823310=    ('
      '1101823311=     SKLAD,'
      '1101823312=     SKLAD_PARENT,'
      '1101823313=     DATE_RECEIPT,'
      '1101823314=     G_CLIENT,'
      '1101823315=     G_PRODUCT,'
      '1101823316=     AMOUNT,'
      '1101823317=     PRICE,'
      '1101823318=     SUMM,'
      '1101823319=     G_PAYMENT_TYPE,'
      '1101823320=     OSNOVANIE,'
      '1101823321=     NOTE,'
      '1101823322=     NDS,'
      '1101823323=     NDS_SUMM,'
      '1101823324=     IS_LAST,'
      '1101823325=     IS_VOZVRAT,'
      '1101823326=     G_TOCHKA'
      '1101823327=     ,PRICE_CURRENCY'
      '1101823328=     ,SUMM_CURRENCY'
      '1101823329=     ,MARK_CODE'
      '1101823330=    ) VALUES ('
      '1101823331=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1101823332=     :SKLAD_,'
      '1101823333=     :DATE_RECEIPT_,'
      '1101823334=     :G_CLIENT_,'
      '1101823335=     :RG_PRODUCT_,'
      '1101823336=     :RAMOUNT_,'
      '1101823337=     :RPRICE_,'
      '1101823338=     :RSUMM_,'
      '1101823339=     :G_PAYMENT_TYPE_,'
      '1101823340=     :OSNOVANIE_,'
      '1101823341=     :NOTE_,'
      '1101823342=     :RNDS_,'
      '1101823343=     :RNDS_SUMM_,'
      
        '1101823344=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056 +
        #1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059 +
        #1044#1045#1058' 0'
      '1101823345=     :IS_VOZVRAT_,'
      '1101823346=     :G_TOCHKA_'
      '1101823347=     ,:PRICE_CURRENCY_'
      '1101823348=     ,:SUMM_CURRENCY_TMP_'
      '1101823349=     ,:MARK_CODE_'
      '1101823350=    );'
      '1101823351='
      
        '1101823352=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068 +
        #1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '1101823353=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101823354=        PNT_ = '#39'02'#39';'
      '1101823355=        UPDATE LT_SKLAD_PRODUCT L'
      '1101823356=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '1101823357=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101823358=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101823359=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101823360='
      '1101823361=        IF (ROW_COUNT = 0) THEN'
      
        '1101823362=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT' +
        ')'
      
        '1101823363=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :R' +
        'G_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1101823364=    END'
      '1101823365='
      
        '1101823366=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061 +
        #1054#1044#1045
      '1101823367=      UPDATE G_PRODUCT G'
      '1101823368=         SET G.PRICE = :SALE_PRICE_'
      '1101823369=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '1101823370=  END'
      '1101823371=  ----------------------------------------'
      '1101823372='
      
        '1101823373=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057 +
        #1058#1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070',' +
        ' '#1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '1101823374=  PNT_ = '#39'05'#39';'
      
        '1101823375=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN B' +
        'EGIN'
      '1101823376=      IF (:IS_VOZVRAT_ = 1) THEN'
      '1101823377=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101823378=      ELSE'
      '1101823379=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1101823380='
      
        '1101823381=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', ' +
        #1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048 +
        #1053' '#1055#1051#1040#1058#1045#1046
      '1101823382=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '1101823383=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACT' +
        'ION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101823384=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1101823385=                                        :SUMM_FACT_,'
      
        '1101823386=                                        :DATE_RECEIPT' +
        '_,'
      
        '1101823387=                                        NULL,   --NOT' +
        'E_ => :NOTE_,'
      
        '1101823388=                                        NULL,   --ZAK' +
        'AZ_'
      '1101823389=                                        :SKLAD_,'
      
        '1101823390=                                        :G_PAYMENT_TY' +
        'PE_,'
      
        '1101823391=                                        :G_TOCHKA_) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101823392=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101823393=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101823394=            EXIT;'
      '1101823395=          END'
      '1101823396=      END ELSE BEGIN'
      '1101823397=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1101823398=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1101823399=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101823400=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101823401=            ELSE'
      
        '1101823402=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101823403='
      '1101823404=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101823405=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101823406='
      
        '1101823407=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101823408='
      '1101823409=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101823410=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101823411=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1101823412=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1101823413=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1101823414=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101823415=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1101823416=                                              :SKLAD_' +
        ','
      
        '1101823417=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1101823418=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101823419=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101823420=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101823421=                  EXIT;'
      '1101823422=                END'
      '1101823423=            END'
      '1101823424=          END'
      '1101823425=      END'
      '1101823426=  END'
      '1101823427='
      '1101823428=  DELETE FROM SKLAD_TMP;'
      '1101823429='
      
        '1101823430=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1101823431=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101823432=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1101823433=                                  G_PRIHOD_,'
      '1101823434=                                  :SUMM_PRIHOD_,'
      '1101823435=                                  :DATE_RECEIPT_,'
      
        '1101823436=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101823437=                                  NULL,   --:ZAKAZ_,'
      '1101823438=                                  :SKLAD_,'
      '1101823439=                                  :G_PAYMENT_TYPE_,'
      
        '1101823440=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101823441=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101823442=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101823443=      EXIT;'
      '1101823444=    END'
      '1101823445=  END'
      '1101823446='
      '1101823447=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101823448=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ IN (0, 1' +
        ', 2)) THEN'
      
        '1101823449=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101823450=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_, ' +
        '1);'
      '1101823451='
      '1101823452=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101823453=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '1101823454=END'
      '1101823455=;'
      '1101823456='
      '1101823457=ALTER PROCEDURE INS_ZAKAZ('
      '1101823458=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101823459=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101823460=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101823461=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101823462=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101823463=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101823464=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101823465=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101823466=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101823467=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101823468=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101823469=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101823470=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101823471=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
