      '1102111060=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1102111061=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1102111062=                PNT_ = '#39'05'#39';'
      
        '1102111063=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1102111064=                                              1,     ' +
