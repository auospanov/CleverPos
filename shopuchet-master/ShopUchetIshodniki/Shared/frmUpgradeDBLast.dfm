        '1105832=  OSNOVANIE /* TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE' +
        ' */ VARCHAR(150),'
      
        '1105833=  NOTE /* TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE */ VARCHA' +
        'R(200),'
      
        '1105834=  G_OFFICIAL /* TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICI' +
        'AL */ INTEGER,'
      
        '1105835=  G_PRODUCT /* TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT' +
        ' */ INTEGER,'
      
        '1105836=  AMOUNT /* TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT */ NU' +
        'MERIC(15,2),'
      
        '1105837=  PRICE /* TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE */ NUME' +
        'RIC(15,2),'
      
        '1105838=  SUMM /* TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM */ NUMERI' +
        'C(15,2),'
      
        '1105839=  DISCOUNT_PERC /* TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCO' +
        'UNT_PERC */ NUMERIC(15,2),'
      
        '1105840=  DISCOUNT_TENGE /* TYPE OF COLUMN UPLOAD_TABLE_TMP.DISC' +
        'OUNT_TENGE */ NUMERIC(15,2),'
      
        '1105841=  DISCOUNT_SUMM /* TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCO' +
        'UNT_SUMM */ NUMERIC(15,2),'
      
        '1105842=  NDS /* TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS */ NUMERIC(' +
        '15,2),'
      
        '1105843=  NDS_SUMM /* TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM *' +
        '/ NUMERIC(15,2),'
      
        '1105844=  COST_PRICE /* TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRI' +
        'CE */ NUMERIC(15,2),'
      
        '1105845=  BY_RECIPE /* TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE' +
        ' */ INTEGER,'
      
        '1105846=  IS_RESERVE /* TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESER' +
        'VE */ INTEGER,'
      '1105847=  PAYMENTS BLOB SUB_TYPE 1,'
      
        '1105848=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMERIC' +
        '(15,2),'
      
        '1105849=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */ N' +
        'UMERIC(15,2),'
      '1105850=  IS_LOAD_ INTEGER)'
      '1105851=RETURNS ('
