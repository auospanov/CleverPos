      '110239825='
      '110239826=ALTER PROCEDURE G_TOCHKA_DEL('
      '110239827=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110239828=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110239829=RETURNS ('
      '110239830=  ERR_CODE INTEGER,'
      '110239831=  ERR_MSG VARCHAR(1024))'
      '110239832=AS'
      '110239833=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '110239834=BEGIN'
      '110239835=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '110239836=    ERR_CODE = -20500;'
      
        '110239837=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076 +
        #1072#1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110239838=    EXIT;'
      '110239839=  END'
      '110239840='
      '110239841=  DELETE FROM KASSA_STATE S'
      '110239842=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '110239843='
      
        '110239844=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040#1041 +
        #1051#1048#1062#1059' LOGS'
      
        '110239845=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_S' +
        'ETUP = 5) > 0) THEN'
      
        '110239846=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110239847=      VALUES (GEN_ID(GEN_LOGS, 1), '#39'DELETE FROM KASSA_' +
        'STATE S WHERE S.G_TOCHKA = '#39'||:G_TOCHKA_||'#39';'#39', '#39'SYSDBA'#39', 0, CURR' +
        'ENT_TIMESTAMP, :ERR_CODE);'
      '110239848='
      '110239849=  DELETE FROM KASSA S'
      '110239850=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '110239851='
      '110239852=  FOR SELECT KASSA_BEZNAL'
      '110239853=        FROM KASSA_BEZNAL'
      '110239854=       WHERE G_TOCHKA = :G_TOCHKA_'
      '110239855=        INTO :KASSA_'
      '110239856=  DO BEGIN'
      
        '110239857=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '110239858=    IF (:ERR_CODE <> 0) THEN'
      '110239859=      EXIT;'
      '110239860=  END'
      '110239861='
      '110239862=  UPDATE G_OFFICIAL O'
      '110239863=     SET O.G_TOCHKA = NULL'
      '110239864=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '110239865='
      '110239866=  DELETE FROM INVOICE I'
      '110239867=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '110239868=                      FROM ZAKAZ'
      '110239869=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239870='
      '110239871=  DELETE FROM INVOICE_PAY I'
      '110239872=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '110239873=                      FROM ZAKAZ'
      '110239874=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239875='
      '110239876=  DELETE FROM WAYBILL I'
      '110239877=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '110239878=                      FROM ZAKAZ'
      '110239879=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239880='
      '110239881=  DELETE FROM LT_ZAKAZ_REAL R'
      '110239882=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '110239883=                              FROM ZAKAZ Z, ZAKAZ_DETA' +
        'ILS ZD'
      
        '110239884=                             WHERE Z.G_TOCHKA = :G_TOC' +
        'HKA_'
      
        '110239885=                               AND Z.ZAKAZ = ZD.ZAKAZ)' +
        ';'
      '110239886='
      '110239887=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '110239888=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PARE' +
        'NT'
      
        '110239889=                                  FROM ZAKAZ_REAL_PARE' +
        'NT'
      
        '110239890=                                 WHERE G_TOCHKA = :G_T' +
        'OCHKA_);'
      '110239891='
      '110239892=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '110239893=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239894='
      '110239895=  DELETE FROM ZAKAZ_DETAILS D'
      '110239896=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '110239897=                      FROM ZAKAZ'
      '110239898=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239899='
      '110239900=  DELETE FROM ZAKAZ D'
      '110239901=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239902='
      '110239903=  DELETE FROM SKLAD D'
      '110239904=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239905='
      '110239906=  DELETE FROM SKLAD_PARENT D'
      '110239907=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239908='
      '110239909=  DELETE FROM ZAKAZ_DETAILS D'
      '110239910=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '110239911=                      FROM ZAKAZ'
      '110239912=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239913='
      '110239914=  DELETE FROM LT_SKLAD_PRODUCT'
      '110239915=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '110239916='
      '110239917=  DELETE FROM G_TOCHKA'
      '110239918=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '110239919='
      
        '110239920=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051 +
        #1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110239921=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110239922=    UPDATE SYNC_EXT_APP AP'
      '110239923=       SET AP.OPER = 3'
      '110239924=     WHERE AP.OBJECT_TYPE = 3'
      '110239925=       AND AP.ID = :G_TOCHKA_'
      '110239926=       AND AP.IS_LOADING = 0;'
      '110239927='
      '110239928=    IF (ROW_COUNT = 0) THEN'
      
        '110239929=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110239930=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 3, :G_TOC' +
        'HKA_, 3);'
      '110239931=  END'
      '110239932=END'
      '110239933=;'
      '110239934='
      '110239935=ALTER PROCEDURE SYNC_DOWNLOAD('
      '110239936=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110239937=RETURNS ('
      '110239938=  ERR_CODE INTEGER,'
      '110239939=  ERR_MSG VARCHAR(1024),'
      '110239940=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '110239941=AS'
      '110239942=/*'
      '110239943='#1060#1048#1053#1040#1051' 07.02.2019'
      '110239944=*/'
      
        '110239945=DECLARE VARIABLE SQL_ TYPE OF COLUMN LOGS.SQLSTMT; /* ' +
        'VARCHAR(30000); */'
      
        '110239946=DECLARE VARIABLE SQL_UPD_ TYPE OF COLUMN LOGS.SQLSTMT;' +
        ' /* VARCHAR(30000); */'
      '110239947=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '110239948=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '110239949=DECLARE VARIABLE POS_ INTEGER = 0;'
      '110239950=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '110239951=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110239952=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '110239953=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGME' +
        'NT SIZE 80 = '#39#39';'
      
        '110239954=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110239955=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110239956=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      
        '110239957=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT;'
      
        '110239958=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT_RESERVE;'
      
        '110239959=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110239960=DECLARE VARIABLE ACTION_DATE_MIN_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE = CURRENT_DATE;'
      
        '110239961=DECLARE VARIABLE ACTION_DATE_MIN_OLD_ TYPE OF COLUMN K' +
        'ASSA.ACTION_DATE = CURRENT_DATE;'
      
        '110239962=DECLARE VARIABLE CREDIT_ TYPE OF COLUMN KASSA_STATE.CR' +
        'EDIT;'
      
        '110239963=DECLARE VARIABLE DEBET_ TYPE OF COLUMN KASSA_STATE.DEB' +
        'ET;'
      '110239964=DECLARE VARIABLE RECALC_STR_ VARCHAR(1024) = '#39#39';'
      '110239965=DECLARE VARIABLE STR_ VARCHAR(1024);'
      '110239966=DECLARE VARIABLE TABLE_ TYPE OF COLUMN LOGS.TTABLE;'
      '110239967=DECLARE VARIABLE TABLE_INT_ INTEGER;'
      '110239968=DECLARE VARIABLE OPER_ INTEGER;'
      '110239969=DECLARE VARIABLE PNT_ VARCHAR(10);'
      '110239970=BEGIN'
      '110239971=  ERR_CODE = 0;'
      '110239972=  ERR_MSG = '#39#39';'
      '110239973=  ERR_BODY = '#39#39';'
      '110239974='
      '110239975=  FOR SELECT L.ID,'
      '110239976=             L.SQLSTMT,'
      '110239977=             L.TTABLE'
      '110239978=        FROM LOGS L'
      '110239979=       WHERE L.USR = '#39'REPLICAT'#39
      '110239980=         AND L.DAT IS NULL'
      '110239981=         AND L.IS_TRANSFERED = 0'
      
        '110239982=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        ') = 0'
      '110239983=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) = 0'
      
        '110239984=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) = ' +
        '0'
      
        '110239985=         AND POSITION('#39'EXECUTE PROCEDURE K_RECALC_KASS' +
        'A'#39' IN L.SQLSTMT) = 0'
      '110239986=        ORDER BY L.ID_ORIGINAL'
      '110239987=        INTO :LOGS_ID_,'
      '110239988=             :SQL_,'
      '110239989=             :TABLE_'
      '110239990=  DO BEGIN'
      '110239991=    BEGIN'
      '110239992=        SQLCODE_ = 0;'
      '110239993='
      '110239994=        EXECUTE STATEMENT SQL_;'
      '110239995='
      
        '110239996=        /*IF (UPLOAD_TO_EXT_APP_ = 1 AND TABLE_ IN ('#39'G' +
        '_PRODUCT'#39', '#39'ZAKAZ'#39', '#39'SKLAD_PARENT'#39', '#39'G_TOCHKA'#39')) THEN BEGIN'
      '110239997=           IF (TABLE_ = '#39'ZAKAZ'#39') THEN'
      '110239998=             TABLE_INT_ = 1;'
      '110239999=           ELSE IF (TABLE_ = '#39'SKLAD_PARENT'#39') THEN'
      '1102391000=             TABLE_INT_ = 2;'
      '1102391001=           ELSE IF (TABLE_ = '#39'G_TOCHKA'#39') THEN'
      '1102391002=             TABLE_INT_ = 3;'
      '1102391003=           ELSE IF (TABLE_ = '#39'G_PRODUCT'#39') THEN'
      '1102391004=             TABLE_INT_ = 4;'
      '1102391005='
      '1102391006=           IF (POSITION('#39'INSERT'#39' IN SQL_) > 0) THEN'
      '1102391007=             OPER_ = 1;'
      
        '1102391008=           ELSE IF (POSITION('#39'UPDATE'#39' IN SQL_) > 0) T' +
        'HEN'
      '1102391009=             OPER_ = 2;'
      
        '1102391010=           ELSE IF (POSITION('#39'DELETE'#39' IN SQL_) > 0) T' +
        'HEN'
      '1102391011=             OPER_ = 3;'
      '1102391012='
      
        '1102391013=           INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '1102391014=             VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), :TA' +
        'BLE_INT_, 111, :OPER_);'
      '1102391015=        END*/'
      '1102391016='
      '1102391017=    WHEN ANY DO'
      '1102391018=        BEGIN'
      '1102391019=            SQLCODE_ = GDSCODE;'
      '1102391020=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102391021=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102391022=            ERR_BODY = ERR_BODY ||'#39
      '1102391023='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102391024=        END'
      '1102391025=    END'
      '1102391026='
      
        '1102391027=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102391028=    UPDATE LOGS L'
      
        '1102391029=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102391030=           L.ERR_CODE = :SQLCODE_'
      '1102391031=     WHERE L.ID = :LOGS_ID_;'
      '1102391032=  END'
      '1102391033='
      '1102391034=  POS_ = 0;'
      '1102391035=  FOR SELECT L.ID,'
      '1102391036=             L.SQLSTMT,'
      '1102391037=             L.DAT,'
      '1102391038=             L.RR'
      '1102391039=        FROM LOGS L'
      '1102391040=       WHERE L.USR = '#39'REPLICAT'#39
      '1102391041=         AND L.DAT IS NOT NULL'
      '1102391042=         AND L.IS_TRANSFERED = 0'
      '1102391043=        ORDER BY L.ID_ORIGINAL'
      '1102391044=        INTO :LOGS_ID_,'
      '1102391045=             :SQL_,'
      '1102391046=             :DAT_,'
      '1102391047=             :IDX_'
      '1102391048=  DO BEGIN'
      '1102391049=    POS_ = POSITION('#39'.'#39', SQL_);'
      '1102391050=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '1102391051=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR P' +
        'OS_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_' +
        ' - 1)||'#39' = :DAT_'#39'||'
      
        '1102391052=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ +' +
        ' 1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '1102391053='
      '1102391054=    BEGIN'
      '1102391055=        SQLCODE_ = 0;'
      '1102391056=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '1102391057=    WHEN ANY DO'
      '1102391058=        BEGIN'
      '1102391059=            SQLCODE_ = GDSCODE;'
      '1102391060=            ERR_BODY = ERR_BODY ||'#39
      '1102391061='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102391062=        END'
      '1102391063=    END'
      '1102391064='
      
        '1102391065=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102391066='
      '1102391067=    UPDATE LOGS L'
      
        '1102391068=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102391069=           L.ERR_CODE = :SQLCODE_'
      '1102391070=     WHERE L.ID = :LOGS_ID_;'
      '1102391071=  END'
      '1102391072='
      
        '1102391073=  --=================================================' +
        '===================='
      '1102391074=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      
        '1102391075=  -- '#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054' '#1054#1058#1044#1045 +
        #1051#1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048#1042' '#1057#1054#1041#1048#1056#1040#1058#1068 +
        '?'
      
        '1102391076=  --=================================================' +
        '===================='
      '1102391077=  FOR SELECT MAX(L.ID) ID,'
      '1102391078=             L.SQLSTMT'
      '1102391079=        FROM LOGS L'
      '1102391080=       WHERE L.USR = '#39'REPLICAT'#39
      '1102391081=         AND L.DAT IS NULL'
      '1102391082=         AND L.IS_TRANSFERED = 0'
      
        '1102391083=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTM' +
        'T) > 0'
      '1102391084=       GROUP BY L.SQLSTMT'
      '1102391085=        INTO :LOGS_ID_,'
      '1102391086=             :SQL_'
      '1102391087=  DO BEGIN'
      '1102391088=    SQLCODE_ = 0;'
      '1102391089=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '1102391090=    POS1_ = POSITION('#39'-'#39' IN SQL_);'
      '1102391091='
      
        '1102391092=    G_PRODUCT_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FO' +
        'R POS1_ - POS_ - 1) AS BIGINT);'
      
        '1102391093=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 FO' +
        'R CHAR_LENGTH(SQL_)) AS BIGINT);'
      '1102391094='
      '1102391095=    BEGIN'
      '1102391096=        select ('
      '1102391097=               -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102391098=               (select COALESCE(sum(s.amount), 0) fro' +
        'm sklad s, sklad_parent sp'
      '1102391099=                where sp.SKLAD = s.SKLAD_PARENT'
      '1102391100=                  and sp.G_TOCHKA = :G_TOCHKA_'
      '1102391101=                  and s.g_product = :G_PRODUCT_'
      
        '1102391102=                  and sp.IS_EXPECTED = 0)   -- '#1085#1077' '#1073#1077#1088 +
        #1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102391103='
      '1102391104=               -'
      '1102391105=               -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102391106=               (select COALESCE(sum(zr.AMOUNT_ALL), 0' +
        ') from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102391107=                where zr.g_product = :G_PRODUCT_ and ' +
        'Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102391108=                and zr.ZAKAZ_REAL_PARENT = zrp.ZAKAZ_' +
        'REAL_PARENT)'
      '1102391109='
      '1102391110=               -'
      '1102391111=               -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102391112=               (select COALESCE(sum(zd.amount), 0) fr' +
        'om zakaz_details zd, zakaz z'
      
        '1102391113=                where zd.g_product = :G_PRODUCT_ and ' +
        'Z.G_TOCHKA = :G_TOCHKA_'
      '1102391114=                and zd.zakaz = z.zakaz'
      
        '1102391115=                and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099#1095#1080#1090 +
        #1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076#1077#1090' ' +
        #1085#1080#1078#1077
      
        '1102391116=                and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074 +
        #1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072 +
        #1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102391117=                and not (z.IS_SPISANIE = 0 and z.NOT_' +
        'MINUS_OSTATOK = 1)'
      '1102391118=               )'
      '1102391119='
      '1102391120=               -'
      '1102391121=               -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102391122=               (select COALESCE(sum(s.amount), 0) fro' +
        'm sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = 3'
      '1102391123=                and S.g_client = :G_TOCHKA_)'
      '1102391124='
      '1102391125=               -'
      '1102391126=               -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102391127=               (select COALESCE(sum(od.amount), 0) fr' +
        'om other_details od, other o'
      
        '1102391128=                where od.g_product = :G_PRODUCT_ and ' +
        'o.G_TOCHKA = :G_TOCHKA_'
      '1102391129=                and od.other = o.other)'
      '1102391130=               ) amount,'
      '1102391131='
      
        '1102391132=               (SELECT COALESCE(sum(ZD.amount), 0) FR' +
        'OM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102391133=                 WHERE Z.G_TOCHKA = :G_TOCHKA_ AND Z.' +
        'IS_RESERVE = 1'
      
        '1102391134=                   AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G_PR' +
        'ODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102391135=        from rdb$database'
      '1102391136=        INTO :AMOUNT_,'
      '1102391137=             :AMOUNT_RESERVE_;'
      '1102391138='
      '1102391139=        MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102391140=        USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G_TO' +
        'CHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102391141=        ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_TOCH' +
        'KA = CD.G_TOCHKA)'
      '1102391142=        WHEN MATCHED THEN'
      
