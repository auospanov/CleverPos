      '11023337=  SUMM_SKIDKA_ VARCHAR(50),'
      '11023338=  SUMM_SERVICE_ VARCHAR(50),'
      '11023339=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11023340=  BONUS_STR_ VARCHAR(100),'
      '11023341=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '11023342=  ERR_CODE NUMERIC(15,2),'
      '11023343=  ERR_MSG VARCHAR(1024),'
      '11023344=  NAME_MARKER VARCHAR(1000))'
      '11023345=AS'
      '11023346=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '11023347=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '11023348=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11023349=DECLARE VARIABLE I INTEGER = 1;'
      
        '11023350=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11023351=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11023352=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.AMOUNT;'
      
        '11023353=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11023354=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      
        '11023355=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.SUMM;'
      '11023356=BEGIN'
      '11023357=  SLOGAN_ = PRINT_SLOGAN_;'
      '11023358=  /*||ASCII_CHAR(10)||MARK_CODE*/'
      '11023359=  IF (BONUS_ > 0) THEN BEGIN'
      
        '11023360=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(BO' +
        'NUS_, 2) AS VARCHAR(100));'
      '11023361=  END'
      '11023362='
      '11023363=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      '11023364=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS_;'
      '11023365=  END'
      '11023366='
      '11023367=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '11023368=  SELECT z.ZAKAZ'
      '11023369=         ,'#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#39'||P.NAME'
      
        '11023370=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR ' +
        'FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')|' +
        '|'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '11023371=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '11023372=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COALE' +
        'SCE(O.NM, '#39#39')'
      '11023373=         ,Z.summ_noncash'
      '11023374=         ,Z.summ_cash'
      '11023375=         ,Z.NOTE'
      
        '11023376=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_OF' +
        'FICIAL = O.G_OFFICIAL,'
      '11023377=         G_CLIENT G,'
      '11023378=         G_PAYMENT_TYPE P'
      '11023379=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11023380=     AND Z.G_CLIENT = G.G_CLIENT'
      '11023381=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11023382=    INTO :NUM_'
      '11023383=        ,:PAYMENT_TYPE_'
      '11023384=        ,:DATE_'
      '11023385=        ,:G_CLIENT_NAME_'
      '11023386=        ,:G_OFFICIAL_FM_'
      '11023387=        ,:SUMM_NONCASH_'
      '11023388=        ,:SUMM_CASH_'
      '11023389=        ,:NOTE_'
      '11023390=        ;'
      '11023391='
      '11023392=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '11023393=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '11023394='
      '11023395=  SELECT R.G_FIRM_REKVIZIT,'
      '11023396=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '11023397=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088#1075 +
        '.: '#39'||COALESCE(R.IDN, '#39#39')'
      '11023398=    FROM G_FIRM_REKVIZIT R'
      '11023399=   WHERE R.is_default = 1'
      '110233100=    INTO :G_FIRM_REKVIZIT_,'
      '110233101=         :FIRM_NAME_,'
      '110233102=         :FIRM_IDN_;'
      '110233103='
      '110233104=  SELECT ZD.SUMM'
      '110233105=    FROM ZAKAZ_DETAILS ZD'
      '110233106=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110233107=    AND ZD.G_PRODUCT = -2'
      '110233108=    INTO :SERVICE_SUMM_;'
      '110233109=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '110233110='
      '110233111=  SELECT SUM(ZD.AMOUNT),'
      
        '110233112=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCH' +
        'AR(50)),'
      
        '110233113=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2' +
        ') AS VARCHAR(50)),'
      
        '110233114=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHAR' +
        '(50)),'
      '110233115=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '110233116=  FROM ZAKAZ_DETAILS ZD'
      '110233117=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110233118=    AND ZD.G_PRODUCT <> -2'
      '110233119=  INTO :AMOUNT_VSEGO_NUM_,'
      '110233120=       :SUMM_SKIDKA_,'
      '110233121=       :SUMM_VSEGO_,'
      '110233122=       :SUMM_VSEGO_N_,'
      '110233123=       :SUMM_SERVICE_;'
      '110233124='
      '110233125=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110233126=    FROM G_FIRM_ADDRESS R'
      '110233127=   WHERE R.IS_DEFAULT = 1'
      '110233128=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110233129=    INTO :FIRM_ADDRESS_;'
      '110233130='
      
        '110233131=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110233132=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110233133=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110233134=    IF (CURRENCY_ = 0) THEN'
      '110233135=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110233136=    ELSE'
      '110233137=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110233138=  END'
      '110233139='
      '110233140=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110233141='
      
        '110233142=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110233143=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110233144='
      '110233145=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110233146=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110233147=  INTO :SUMM_STR_;'
      '110233148='
      '110233149=  FOR'
      '110233150=    SELECT :I,'
      '110233151=           G.NAME,'
      
        '110233152=           (CASE WHEN (ZD.MARK_CODE is NULL) or (ZD.MA' +
        'RK_CODE = '#39#39') then G.NAME else G.NAME||ASCII_CHAR(10)||'#39' '#1052': '#39'||Z' +
        'D.MARK_CODE END),'
      
        '110233153=           (CASE WHEN (G.ARTICUL is null) or (G.ARTICU' +
        'L = '#39#39') then G.NAME ELSE G.NAME||'#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39' END),'
      '110233154=           ZD.AMOUNT,'
      '110233155=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '110233156=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) A' +
        'S VARCHAR(100))'
      '110233157=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110233158=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE' +
        ', 0) AS VARCHAR(100))'
      '110233159=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110233160=      FROM ZAKAZ Z,'
      '110233161=           ZAKAZ_DETAILS ZD,'
      '110233162=           G_PRODUCT G,'
      '110233163=           G_UNIT U'
      '110233164=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110233165=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110233166=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110233167=       AND G.G_UNIT = U.G_UNIT'
      '110233168=       AND G.G_PRODUCT <> -2'
      '110233169=     ORDER BY ZD.zakaz_details'
      '110233170=    INTO :ROW_NUM,'
      '110233171=        :NAME,'
      '110233172=        :NAME_MARKER,'
      '110233173=        :NAME_ART,'
      '110233174=        :AMOUNT_NUM_,'
      '110233175=        :PRICE,'
      '110233176=        :SUMM'
      '110233177=        ,:SHORT_NAME'
      '110233178=        ,:PRICE_N'
      '110233179=        ,:SUMM_N'
      '110233180='
      '110233181=  DO BEGIN'
      '110233182=    I = I + 1;'
      '110233183='
      
        '110233184=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110233185=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110233186=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110233187=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110233188=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110233189=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110233190=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110233191=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110233192=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110233193=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110233194=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110233195=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110233196=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110233197=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110233198=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110233199=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110233200=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110233201=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110233202=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110233203=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '110233204=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM ' +
        '1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '110233205=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '110233206=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR ' +
        'POSITION('#39'.00'#39' IN BONUS_STR_)-1);'
      '110233207='
      '110233208=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110233209=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110233210=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110233211=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110233212=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110233213=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110233214=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110233215=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110233216=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110233217=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110233218=    END ELSE BEGIN'
      '110233219=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110233220=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110233221=    END'
      '110233222='
      
        '110233223=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110233224=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110233225='
      
        '110233226=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110233227=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110233228='
      '110233229=    SUSPEND;'
      '110233230=  END'
      '110233231=WHEN ANY DO BEGIN'
      '110233232=    Err_code = -20500;'
      
        '110233233=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110233234=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110233235=  END'
      '110233236=end'
      '110233237=;'
      '110233238='
      '110233239=ALTER PROCEDURE P_REP_PROFIT_CATEGORY('
      '110233240=  DATE_BEGIN_ DATE,'
      '110233241=  DATE_END_ DATE,'
      '110233242=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110233243=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110233244=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110233245=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0,'
      
        '110233246=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      
        '110233247=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PR' +
        'IHOD_RASHOD = NULL)'
      '110233248=RETURNS ('
      '110233249=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110233250=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110233251=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
      '110233252=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110233253=  SUMM_ALL_ NUMERIC(15,2),'
      '110233254=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110233255=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110233256=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110233257=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110233258=  PROFIT_ALL_ NUMERIC(15,2),'
      '110233259=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110233260=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      
        '110233261=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110233262=  SUMM NUMERIC(15,2),'
      '110233263=  NDS_SUMM NUMERIC(15,2),'
      '110233264=  SUM_SELF NUMERIC(15,2),'
      '110233265=  PROFIT NUMERIC(15,2),'
      '110233266=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110233267=  ERR_CODE INTEGER,'
      '110233268=  ERR_MSG VARCHAR(1024))'
      '110233269=AS'
      '110233270=/*'
      '110233271='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '110233272='#1042#1053#1045#1064#1053#1048#1049' '#1062#1048#1050#1051' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052', '#1055#1056#1048#1063#1045#1052' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1070#1058#1057#1071' '#1058#1054#1051#1068#1050 +
        #1054' '#1058#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1058#1054#1042#1040#1056#1067' '#1050#1054#1058#1054#1056#1067#1061' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1045' '#1042' '#1069#1058#1054#1058' '#1055#1045#1056#1048 +
        #1054#1044
      
        '110233273='#1042#1053#1059#1058#1056#1045#1053#1053#1048#1049' '#1062#1048#1050#1051' - '#1048#1044#1059' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1050#1054#1058#1054#1056#1067#1045' '#1054#1055 +
        #1071#1058#1068' '#1046#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061' '#1047#1040' '#1055#1045#1056#1048#1054#1044
      
        '110233274='#1047#1040#1058#1045#1052' '#1055#1054' '#1050#1040#1046#1044#1054#1052#1059' '#1058#1054#1042#1040#1056#1059' '#1053#1040#1061#1054#1046#1059' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1047#1040#1050#1059#1055#1040' - '#1069 +
        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110233275='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110233276='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110233277='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110233278=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110233279=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110233280=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110233281='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110233282='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110233283='
      '110233284='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = NULL, '#1058#1054' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '110233285='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = -100, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040 +
        #1057#1057#1059' '#1042#1054#1054#1041#1065#1045
      
        '110233286='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = ID, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1050#1054#1053#1050#1056#1045#1058#1053#1059#1070' '#1057#1058 +
        #1040#1058#1068#1070' '#1055#1056#1048#1061#1054#1044#1040' '#1042' '#1050#1040#1057#1057#1059
      '110233287=*/'
      
        '110233288=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39 +
        ';'
      '110233289=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110233290=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110233291=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110233292=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110233293=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110233294=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110233295=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110233296=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110233297=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110233298=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110233299=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110233300=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '110233301=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '110233302=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110233303=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110233304=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110233305=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110233306=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110233307=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      '110233308=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '110233309=DECLARE VARIABLE SUMM_CASH_RETURN_ NUMERIC(15,2);'
      '110233310=DECLARE VARIABLE SUMM_NONCASH_RETURN_ NUMERIC(15,2);'
      '110233311=BEGIN'
      
        '110233312=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110233313=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110233314='
      '110233315=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110233316=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110233317=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110233318='
      '110233319=  FOR SELECT SUM(ZD.SUMM)'
      '110233320=           ,TR.PATH'
      '110233321=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '110233322=           ,SUM(ZD.nds_summ)'
      '110233323=      FROM ZAKAZ Z,'
      '110233324=           ZAKAZ_DETAILS ZD,'
      '110233325=           G_PRODUCT GP,'
      '110233326=           P_REP_TREE TR'
      
        '110233327=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110233328=       AND Z.IS_SPISANIE = 0'
      '110233329=       AND Z.IS_RESERVE = 0'
      '110233330=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110233331=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110233332=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110233333=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110233334=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110233335=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110233336=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '110233337=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110233338=       AND ((EXISTS (SELECT 1'
      '110233339=                       FROM SKLAD S'
      '110233340=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110233341=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110233342=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110233343=              OR'
      '110233344=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110233345=     GROUP BY TR.PATH'
      '110233346=     ORDER BY TR.PATH'
      
        '110233347=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, N' +
        'DS_SUMM_'
      '110233348=  DO BEGIN'
      '110233349=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '110233350='
      '110233351=    insert into p_rep_profit_table'
      
        '110233352=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110233353=    values'
      '110233354=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110233355=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :SU' +
        'M_COST_, :PROFIT_, 0);'
      '110233356='
      '110233357=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110233358=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110233359=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110233360=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110233361=  END'
      '110233362='
      '110233363=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110233364=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110233365=      insert into p_rep_profit_table'
      
        '110233366=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110233367=      values'
      
        '110233368=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110233369='
      
        '110233370=  --**************************************************' +
        '***************************************'
      '110233371=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110233372=  ----------------------------------------------------' +
        '---'
      '110233373=  IS_FIRST_ = 1;'
      '110233374=  SUM_COST_ = 0;'
      '110233375=  PROFIT_   = 0;'
      '110233376='
      '110233377=  FOR SELECT G.NAME,'
      '110233378=             SUM(K.SUMM)'
      
        '110233379=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRIH' +
        'OD_RASHOD, G_TOCHKA FROM KASSA'
      '110233380=              UNION ALL'
      
        '110233381=              SELECT ACTION_DATE, SUMM NAL, ACTION, G_' +
        'PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '110233382=             G_PRIHOD_RASHOD G'
      
        '110233383=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA' +
        '||'#39'-'#39
      '110233384=        AND K.ACTION = 1'
      
        '110233385=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110233386=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110233387=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110233388=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '110233389=        INTO :REC_TOVAR_NAME_'
      '110233390=             ,:SUMM_'
      '110233391=  DO BEGIN'
      '110233392=    IF (IS_FIRST_ = 1) then BEGIN'
      '110233393=      INSERT INTO P_REP_PROFIT_TABLE'
      '110233394=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110233395=      VALUES'
      
        '110233396=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39',' +
        ' 1);'
      '110233397='
      '110233398=      IS_FIRST_ = 0;'
      '110233399=    END'
      '110233400='
      '110233401=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110233402=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM,' +
        ' SUM_SELF, PROFIT, IS_HEAD)'
      '110233403=    VALUES'
      
        '110233404=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '110233405='
      '110233406=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110233407=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110233408=  END'
      '110233409='
      '110233410=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110233411=  IF (SUM_COST_ > 0) then BEGIN'
      '110233412=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110233413=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110233414=    insert into p_rep_profit_table'
      
        '110233415=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110233416=    values'
      
        '110233417=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110233418=  END'
      '110233419=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '110233420=  --**************************************************' +
        '***************************************'
      '110233421='
      
        '110233422=  --**************************************************' +
        '***************************************'
      '110233423=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '110233424=  ----------------------------------------------------' +
        '---'
      '110233425=  IS_FIRST_ = 1;'
      '110233426=  PROFIT_   = 0;'
      '110233427=  PRIHOD_ALL_  = 0;'
      '110233428=  PRIHOD_ALL_NAL_  = 0;'
      '110233429=  PRIHOD_ALL_BEZNAL_  = 0;'
      '110233430='
      '110233431=  FOR SELECT G.NAME,'
      '110233432=             SUM(K.NAL),'
      '110233433=             SUM(K.BEZNAL)'
      
        '110233434=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL, ' +
        'ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110233435=              UNION ALL'
      
        '110233436=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL, ' +
        'ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '110233437=             G_PRIHOD_RASHOD G'
      
        '110233438=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA' +
        '||'#39'-'#39
      '110233439=        AND K.ACTION = 0'
      
        '110233440=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110233441=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110233442=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053 +
        #1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110233443=        AND ((:G_PRIHOD_RASHOD_ IS NULL)'
      '110233444=             OR'
      
        '110233445=             (G.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_ AN' +
        'D :G_PRIHOD_RASHOD_ = -100)'
      '110233446=             OR'
      
        '110233447=             (G.G_PRIHOD_RASHOD <> :G_PRIHOD_RASHOD_ A' +
        'ND :G_PRIHOD_RASHOD_ <> -100)'
      '110233448=            )'
      '110233449=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '110233450=        INTO :REC_TOVAR_NAME_'
      '110233451=             ,:SUMM_NAL_'
      '110233452=             ,:SUMM_BEZNAL_'
      '110233453=  DO BEGIN'
      '110233454=    IF (IS_FIRST_ = 1) then BEGIN'
      '110233455=      INSERT INTO P_REP_PROFIT_TABLE'
      '110233456=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110233457=      VALUES'
      
        '110233458=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39',' +
        ' 1);'
      '110233459='
      '110233460=      IS_FIRST_ = 0;'
      '110233461=    END'
      '110233462='
      '110233463=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110233464=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_S' +
        'UMM, SUMM, PROFIT, IS_HEAD)'
      '110233465=    VALUES'
      
        '110233466=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZNA' +
        'L_, 0);'
      '110233467='
      '110233468=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110233469=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BEZ' +
        'NAL_;'
      
        '110233470=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZNA' +
        'L_;'
      
        '110233471=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL_' +
        ';'
      '110233472=  END'
      '110233473='
