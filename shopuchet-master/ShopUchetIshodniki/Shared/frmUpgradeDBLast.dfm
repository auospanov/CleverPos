        '*************************/'
      '110239792='
      '110239793=ALTER TABLE LOGS'
      '110239794=  ADD SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE 16384;'
      '110239795='
      
        '110239796=/*****************************************************' +
        '*************************/'
      
        '110239797=/****                      Updating column positions  ' +
        '                     ****/'
      
