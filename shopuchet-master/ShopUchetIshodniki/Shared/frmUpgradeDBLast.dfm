      '110201985=ALTER PROCEDURE K_UPD_KASSA_STATE('
      
        '110201986=  ACTION_DATE_ /* TYPE OF COLUMN KASSA.ACTION_DATE */ ' +
        'DATE,'
      
        '110201987=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIG' +
        'INT,'
      '110201988=  DEBET_ /* MY_NUMERIC */ NUMERIC(15,2),'
      '110201989=  CREDIT_ /* MY_NUMERIC */ NUMERIC(15,2),'
      '110201990=  NAL_BEZNAL_ INTEGER,'
