      '11015774='
      '11015775=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '11015776=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_' +
        'PARENT */ BIGINT,'
      '11015777=  IS_SUPPLIER_ INTEGER = NULL)'
      '11015778=RETURNS ('
      
        '11015779=  G_CLIENT /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      
        '11015780=  G_CLIENT_PARENT /* TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT */ BIGINT,'
      
        '11015781=  G_CONTRAGENT /* TYPE OF COLUMN G_CONTRAGENT.G_CONTRAG' +
        'ENT */ BIGINT,'
      '11015782=  NAME VARCHAR(500),'
      '11015783=  RNN VARCHAR(12),'
      '11015784=  IDN VARCHAR(12),'
      '11015785=  KBE VARCHAR(5),'
      
        '11015786=  PHONE /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
        ','
