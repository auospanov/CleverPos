      '110682182=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '110682183=                             '#39'0,00'#39'),'
      
        '110682184=                   REPLACE(CAST(:NDS_VALUE_ AS VARCHAR' +
        '(10)), '#39'.'#39', '#39','#39')),'
      
        '110682185=           REPLACE(CAST(DECODE(ZD.SUMM, 0, NULL, ZD.SU' +
        'MM - CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,' +
        '2))) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '110682186=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39'.'#39', ' +
        #39','#39')'
      '110682187=      FROM ZAKAZ Z,'
      '110682188=           ZAKAZ_DETAILS ZD,'
      '110682189=           G_PRODUCT G,'
      '110682190=           G_UNIT U'
      '110682191=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110682192=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110682193=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110682194=       AND G.G_UNIT = U.G_UNIT'
      '110682195=    INTO :ROW_NUM,'
