      '1102311037=;'
      '1102311038='
      '1102311039=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1102311040=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102311041=  INCLUDE_NOL_ INTEGER,'
      '1102311042=  INCLUDE_FEW_ INTEGER,'
      '1102311043=  SORT_BY_NAME_ INTEGER,'
      '1102311044=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102311045=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39','
      '1102311046=  IS_EXPORT_ INTEGER = 0)'
      '1102311047=RETURNS ('
      '1102311048=  PERIOD_ VARCHAR(40),'
      '1102311049=  ROW_NUM VARCHAR(15),'
      '1102311050=  ARTICUL VARCHAR(1000),'
      '1102311051=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102311052=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102311053=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102311054=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102311055=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102311056=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102311057=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1102311058=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      
        '1102311059=  AMOUNT_VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        ','
      '1102311060=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1102311061=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1102311062=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1102311063=  TOVAR_NAME VARCHAR(250),'
      '1102311064=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102311065=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102311066=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102311067=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102311068=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      
        '1102311069=  CATEGORY_NAME TYPE OF COLUMN P_REP_PRICE_LIST_TABLE' +
        '.CATEGORY_NAME,'
      '1102311070=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1102311071=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1102311072=  KOD_TNVD TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1102311073=  ERR_CODE INTEGER,'
      '1102311074=  ERR_MSG VARCHAR(1024))'
      '1102311075=AS'
      
        '1102311076=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATO' +
        'K_TOVAROV'#39';'
      '1102311077=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102311078=DECLARE VARIABLE I INTEGER = 1;'
      '1102311079=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102311080=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102311081=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1102311082=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1102311083=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102311084=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1102311085=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1102311086=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1102311087=BEGIN'
      '1102311088='
      
        '1102311089=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1102311090=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102311091='
      '1102311092=  SELECT S.S_VALUE,'
      '1102311093=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1102311094=    FROM SYSTEM_SETUP S'
      '1102311095=   WHERE S.SYSTEM_SETUP = 1'
      '1102311096=    INTO :FORMULA_,'
      '1102311097=         :PRIHOD_CNT_;'
      '1102311098='
      '1102311099=  IF (IS_EXPORT_ = 1) THEN'
      
        '1102311100=    SELECT '#39'-'#39'||LIST(G_TOCHKA, '#39'-'#39')||'#39'-'#39' FROM G_TOCHK' +
        'A INTO :G_TOCHKA_ARR_;'
      '1102311101='
      '1102311102=  FOR SELECT GP.PATH,'
      '1102311103=             GP.G_PRODUCT'
      '1102311104=        FROM P_REP_TREE GP'
      '1102311105=       WHERE EXISTS (SELECT 1'
      '1102311106=                       FROM G_PRODUCT'
      '1102311107=                      WHERE IS_CATEGORY = 0'
      
        '1102311108=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1102311109=                    )'
      
        '1102311110=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102311111=              OR'
      '1102311112=              (:G_CATEGORY_ is NULL)'
      '1102311113=             )'
      '1102311114=       ORDER BY 1, 2'
      '1102311115=       INTO :PATH_NAME_,'
      '1102311116=            :G_PRODUCT_'
      '1102311117=  DO BEGIN'
      
        '1102311118=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1102311119=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1102311120=      SELECT COUNT(G.G_PRODUCT)'
      
        '1102311121=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102311122=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1102311123=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102311124=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102311125=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102311126=              OR'
      
        '1102311127=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1102311128=              or'
      
        '1102311129=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1102311130=             )'
      '1102311131=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102311132=         AND ((EXISTS (SELECT 1'
      '1102311133=                       FROM SKLAD S'
      '1102311134=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1102311135=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1102311136=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102311137=              OR'
      '1102311138=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1102311139=        INTO :CNT_;'
      '1102311140='
      '1102311141=      IF (CNT_ > 0) THEN BEGIN'
      '1102311142=          IF (IS_EXPORT_ = 0) THEN'
      
        '1102311143=            INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP' +
        '_PRICE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1102311144=            VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE' +
        ', 1), :PATH_NAME_, 1);'
      '1102311145='
      
        '1102311146=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1102311147=                                              ARTICUL' +
        ','
      
        '1102311148=                                              BARCODE' +
        ','
      
        '1102311149=                                              NOMENCL' +
        'ATUR_NUM,'
      '1102311150=                                              NAME,'
      
        '1102311151=                                              UNIT_NA' +
        'ME,'
      '1102311152=                                              PRICE,'
      
        '1102311153=                                              VOLUME_' +
        'PRICE,'
      '1102311154=                                              AMOUNT,'
      
        '1102311155=                                              AMOUNT_' +
        'RESERVE,'
      '1102311156=                                              SUMM,'
      
        '1102311157=                                              PRICE_S' +
        'ELF,'
      
        '1102311158=                                              SORT_CO' +
        'L,'
      
        '1102311159=                                              IS_CATE' +
        'GORY,'
      '1102311160=                                              NOTE,'
      
        '1102311161=                                              CROSSCO' +
        'DE_BLOB_TXT,'
      '1102311162=                                              PLACE,'
      '1102311163=                                              BRAND,'
      
        '1102311164=                                              CATEGOR' +
        'Y_NAME,'
      
        '1102311165=                                              PACK_AM' +
        'OUNT,'
      
        '1102311166=                                              MF_COUN' +
        'TRY,'
      
        '1102311167=                                              KOD_TNV' +
        'D,'
      
        '1102311168=                                              AMOUNT_' +
        'VES_GRAMM)'
      
        '1102311169=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1102311170=                 G.ARTICUL,'
      '1102311171=                 G.BARCODE,'
      '1102311172=                 G.NOMENCLATUR_NUM,'
      '1102311173=                 G.NAME,'
      '1102311174=                 U.SHORT_NAME,'
      '1102311175=                 G.PRICE,'
      '1102311176=                 G.VOLUME_PRICE,'
      '1102311177=                 COALESCE(S.AMOUNT, 0),'
      '1102311178=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1102311179=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1102311180=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1102311181=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1102311182=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1102311183=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '1102311184=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 2' +
        '00 '#1047#1040#1050#1059#1055#1054#1050
      '1102311185=                  DECODE(:FORMULA_,'
      '1102311186=                         1,'
      '1102311187=                         (SELECT S.price'
      '1102311188=                            FROM SKLAD S'
      
        '1102311189=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102311190=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1102311191=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1102311192=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1102311193=                                                     ' +
        'FROM SKLAD DD'
      
        '1102311194=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1102311195=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1102311196=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1102311197=                                                    )'
      '1102311198=                            ORDER BY 1 DESC'
      '1102311199=                            ROWS 1 TO 1'
      '1102311200=                         ),'
      
        '1102311201=                         (SELECT ROUND(SUM(CAST((T.AM' +
        'OUNT * T.PRICE) AS NUMERIC(18,2)))/SUM(T.AMOUNT), 2)'
      
        '1102311202=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1102311203=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1102311204=                                         SKLAD S'
      
        '1102311205=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1102311206=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1102311207=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1102311208=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1102311209=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1102311210=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '1102311211=                         )), 0) spr,'
      
        '1102311212=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1102311213=                 0'
      '1102311214=                 ,G.NOTE'
      
        '1102311215=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      '1102311216=                 ,G.PLACE'
      '1102311217=                 ,G.BRAND'
      '1102311218=                 ,REPLACE(:PATH_NAME_, '#39' - '#39', '#39'~'#39')'
      '1102311219=                 ,G.PACK_AMOUNT'
      '1102311220=                 ,G.MF_COUNTRY'
      '1102311221=                 ,G.KOD_TNVD'
      '1102311222=                 ,COALESCE(S.AMOUNT, 0) * G.VES_GRAMM'
      
        '1102311223=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1102311224=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102311225=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1102311226=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102311227=             AND G.IS_CATEGORY = 0'
      '1102311228=             AND G.is_active = 1'
      '1102311229=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102311230=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102311231=                  OR'
      
        '1102311232=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1102311233=                  or'
      
        '1102311234=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1102311235=                 )'
      '1102311236=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102311237=             AND ((EXISTS (SELECT 1'
      '1102311238=                           FROM SKLAD S'
      
        '1102311239=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1102311240=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1102311241=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102311242=                  OR'
      '1102311243=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1102311244=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '1102311245=      END'
      '1102311246=  END'
      '1102311247='
      
        '1102311248=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1102311249='
      
        '1102311250=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE_BLOB_TXT, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, V' +
        'OLUME_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PR' +
        'ICE_SELF, IS_CATEGORY,'
      
        '1102311251=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL), C' +
        'ATEGORY_NAME, PACK_AMOUNT, MF_COUNTRY, KOD_TNVD, AMOUNT_VES_GRAM' +
        'M'
      '1102311252=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1102311253=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRIC' +
        'E, :VOLUME_PRICE,'
      
        '1102311254=        :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF,' +
        ' :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME, :CATEGORY_NAME, :PACK_AM' +
        'OUNT, :MF_COUNTRY, :KOD_TNVD, :AMOUNT_VES_GRAMM'
      '1102311255=  DO BEGIN'
      '1102311256=    I = I + 1;'
      '1102311257=    SUSPEND;'
      '1102311258=  END'
      '1102311259=WHEN ANY DO BEGIN'
      '1102311260=    Err_code = -20500;'
      
        '1102311261=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102311262=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102311263=  END'
      '1102311264=end'
      '1102311265=;'
      '1102311266='
      '1102311267=ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      '1102311268=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102311269=  CURRENCY_ INTEGER)'
      '1102311270=RETURNS ('
      '1102311271=  NUMBER_STR_ VARCHAR(200),'
      '1102311272=  ROW_NUM INTEGER,'
      '1102311273=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102311274=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102311275=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102311276=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102311277=  PRICE_ROZN TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102311278=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102311279=  AMOUNT MY_NUMERIC_5,'
      '1102311280=  PRICE_N VARCHAR(50),'
      '1102311281=  SUMM_N VARCHAR(50),'
      '1102311282=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1102311283=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '1102311284=  SUMM_VSEGO_ VARCHAR(50),'
      '1102311285=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102311286=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1102311287=  SUMM_STR_ VARCHAR(500),'
      '1102311288=  ERR_CODE NUMERIC(15,2),'
      '1102311289=  ERR_MSG VARCHAR(1024))'
      '1102311290=AS'
      '1102311291=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '1102311292=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD' +
        '_WAYBILL'#39';'
      '1102311293=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102311294=DECLARE VARIABLE I INTEGER = 1;'
      
        '1102311295=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1102311296=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1102311297=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1102311298=DECLARE VARIABLE HAVE_RIGHT_TO_SEE_COST_PRICE_ INTEGE' +
        'R = 0;'
      '1102311299=BEGIN'
      '1102311300='
      
        '1102311301=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#39' || DECODE(P.IS_VOZVRAT, 1, '#39#1074#1086#1079 +
        #1074#1088#1072#1090#1072#39', 0, '#39#1087#1088#1080#1093#1086#1076#1072#39', 3, '#39#1087#1077#1088#1077#1084#1077#1097#1077#1085#1080#1103#39', '#39#39') ||'#39' '#8470#39'||P.sklad||'#39' '#1086 +
        #1090' '#39'||lpad(EXTRACT(DAY FROM P.date_receipt), 2, '#39'0'#39')||'#39'.'#39'||lpad(E' +
        'XTRACT(MONTH FROM P.date_receipt), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM' +
        ' P.date_receipt),'
      '1102311302=         G.name,'
      '1102311303=         P.IS_VOZVRAT'
      
        '1102311304=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON' +
        ' P.g_client = G.G_CLIENT'
      '1102311305=   WHERE P.sklad = :sklad_parent_'
      '1102311306=    INTO :NUMBER_STR_,'
      '1102311307=         :POSTAVSHIK_NAME_,'
      '1102311308=         :IS_VOZVRAT_;'
      '1102311309='
      '1102311310=  SELECT ID, NAME'
      '1102311311=    FROM CUR_PARAMS'
      '1102311312=   WHERE CUR_PARAMS = 1'
      '1102311313=    INTO :G_OFFICIAL_, :G_OFFICIAL_FM_;'
      '1102311314='
      
        '1102311315=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058 +
        #1068' '#1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      
        '1102311316=  -- '#1048' '#1055#1056#1054#1042#1045#1056#1048#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1059' '#1053#1045#1043#1054' '#1055#1056#1040#1042#1054' '#1053#1040' '#1055#1056#1054#1057#1052#1054#1058#1056' '#1047#1040#1050 +
        #1059#1055#1054#1063#1053#1067#1061' '#1062#1045#1053
      '1102311317=  IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '1102311318=    SELECT G.NAME'
      '1102311319=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '1102311320=     WHERE P.SKLAD = :sklad_parent_'
      '1102311321=       AND P.G_TOCHKA = G.G_TOCHKA'
      '1102311322=      INTO :POSTAVSHIK_NAME_;'
      '1102311323='
      '1102311324=    SELECT COUNT(*)'
      '1102311325=      FROM G_OFFICIAL_RIGHT GR'
      '1102311326=     WHERE GR.G_OFFICIAL = :G_OFFICIAL_'
      '1102311327=       AND GR.RIGHTS_ITEM = 105'
      '1102311328=      INTO :HAVE_RIGHT_TO_SEE_COST_PRICE_;'
      '1102311329=  END'
      '1102311330='
      
        '1102311331=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1102311332=         ,REPLACE(CAST(SUM(DECODE(:IS_VOZVRAT_, 3, DE' +
        'CODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.SUMM), S.SUMM)) AS ' +
        'VARCHAR(50)), '#39'.'#39', '#39','#39')'
      
        '1102311333=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(DECOD' +
        'E(:IS_VOZVRAT_, 3, DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, ' +
        'S.PRICE), S.PRICE)), :CURRENCY_))'
      '1102311334=    FROM SKLAD S'
      '1102311335=   WHERE S.sklad_parent = :sklad_parent_'
      '1102311336=   GROUP BY S.sklad_parent'
      '1102311337=    INTO :AMOUNT_VSEGO_,'
      '1102311338=         :SUMM_VSEGO_,'
      '1102311339=         :summ_str_;'
      '1102311340='
      '1102311341=  FOR SELECT :I,'
      '1102311342=             G.name,'
      '1102311343=             G.ARTICUL,'
      '1102311344=             G.BARCODE,'
      '1102311345=             G.NOMENCLATUR_NUM,'
      '1102311346=             G.PRICE,'
      '1102311347=             U.short_name,'
      
        '1102311348=             S.amount,    --REPLACE(CAST(S.amount AS ' +
        'VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1102311349=             REPLACE(CAST(DECODE(:IS_VOZVRAT_, 3, DEC' +
        'ODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.PRICE), S.PRICE) AS ' +
        'VARCHAR(50)), '#39'.'#39', '#39','#39'),'
      
        '1102311350=             REPLACE(CAST(DECODE(:IS_VOZVRAT_, 3, DEC' +
        'ODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.SUMM), S.SUMM) AS VA' +
        'RCHAR(50)), '#39'.'#39', '#39','#39'),'
      '1102311351=             G.PRICE'
      '1102311352=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '1102311353=       WHERE S.sklad_parent = :sklad_parent_'
      '1102311354=         AND S.g_product = G.g_product'
      '1102311355=         AND G.g_unit = U.g_unit'
      '1102311356=        INTO :ROW_NUM,'
      '1102311357=            :NAME,'
      '1102311358=            :ARTICUL,'
      '1102311359=            :BARCODE,'
      '1102311360=            :NOMENCLATUR_NUM,'
      '1102311361=            :PRICE_ROZN,'
      '1102311362=            :SHORT_NAME,'
      '1102311363=            :AMOUNT,'
      '1102311364=            :PRICE_N,'
      '1102311365=            :SUMM_N,'
      '1102311366=            :PRICE'
      '1102311367=  DO BEGIN'
      '1102311368=    I = I + 1;'
      '1102311369=    SUSPEND;'
      '1102311370=  END'
      '1102311371=WHEN ANY DO BEGIN'
      '1102311372=    Err_code = -20500;'
      
        '1102311373=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102311374=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102311375=  END'
      '1102311376=end'
      '1102311377=;'
      '1102311378='
      '1102311379=ALTER PROCEDURE P_REP_PRODAZHA_WAYBILL('
      '1102311380=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102311381=  CURRENCY_ INTEGER)'
      '1102311382=RETURNS ('
      '1102311383=  NUMBER_STR_ VARCHAR(200),'
      '1102311384=  ROW_NUM INTEGER,'
      '1102311385=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102311386=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102311387=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102311388=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102311389=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102311390=  PRICE_ROZN TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102311391=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102311392=  AMOUNT MY_NUMERIC_5,'
      '1102311393=  PRICE_N VARCHAR(50),'
      '1102311394=  SUMM_N VARCHAR(50),'
      '1102311395=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1102311396=  SUMM_VSEGO_ VARCHAR(50),'
      '1102311397=  NDS_SUMM_ VARCHAR(50),'
      '1102311398=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102311399=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1102311400=  SUMM_STR_ VARCHAR(500),'
      '1102311401=  NDS_SUMM_STR_ VARCHAR(500),'
      '1102311402=  ERR_CODE NUMERIC(15,2),'
      '1102311403=  ERR_MSG VARCHAR(1024))'
      '1102311404=AS'
      '1102311405=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '1102311406=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRODAZ' +
        'HA_WAYBILL'#39';'
      '1102311407=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102311408=DECLARE VARIABLE I INTEGER = 1;'
      
        '1102311409=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1102311410=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S_SUMM;'
      '1102311411=BEGIN'
      '1102311412='
      '1102311413=  SELECT decode(P.is_spisanie,'
      '1102311414=                1, '#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39','
      
        '1102311415=                4, '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#1074#1086#1079#1074#1088#1072#1090#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#8470#39'|' +
        '|P.ZAKAZ,'
      
        '1102311416=                '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.ZAKAZ)||'#39' '#1086#1090' '#39'||lpad' +
        '(EXTRACT(DAY FROM P.z_date), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FR' +
        'OM P.z_date), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.z_date),'
      '1102311417=         G.name'
      '1102311418=    FROM ZAKAZ P,'
      '1102311419=         G_CLIENT G'
      '1102311420=   WHERE P.ZAKAZ = :ZAKAZ_'
      '1102311421=     AND P.g_client = G.G_CLIENT'
      '1102311422=    INTO :NUMBER_STR_,'
      '1102311423=         :CLIENT_NAME_;'
      '1102311424='
      
        '1102311425=  SELECT SUM(S.amount)--REPLACE(CAST(SUM(S.amount) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1102311426=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39 +
        '.'#39', '#39','#39')'
      
        '1102311427=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.sum' +
        'm), :CURRENCY_))'
      
        '1102311428=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(50)' +
        '), '#39'.'#39', '#39','#39')'
      '1102311429=         ,SUM(S.nds_summ)'
      '1102311430=    FROM ZAKAZ_DETAILS S'
      '1102311431=   WHERE S.ZAKAZ = :ZAKAZ_'
      '1102311432=   GROUP BY S.ZAKAZ'
      '1102311433=    INTO :AMOUNT_VSEGO_,'
      '1102311434=         :SUMM_VSEGO_,'
      '1102311435=         :summ_str_,'
      '1102311436=         :NDS_SUMM_,'
      '1102311437=         :NDS_;'
      '1102311438='
      '1102311439=  if (NDS_ > 0) then'
      
        '1102311440=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENC' +
        'YSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '1102311441='
      '1102311442=  SELECT NAME'
      '1102311443=    FROM CUR_PARAMS'
      '1102311444=   WHERE CUR_PARAMS = 1'
      '1102311445=    INTO :G_OFFICIAL_FM_;'
      '1102311446='
      '1102311447=  FOR SELECT :I,'
      '1102311448=             C.NAME,'
      '1102311449=             G.name,'
      '1102311450=             G.ARTICUL,'
      '1102311451=             G.BARCODE,'
      '1102311452=             G.NOMENCLATUR_NUM,'
      '1102311453=             G.PRICE,'
      '1102311454=             U.short_name,'
      
        '1102311455=             S.amount,--REPLACE(CAST(S.amount AS VARC' +
        'HAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1102311456=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.' +
        #39', '#39','#39'),'
      
        '1102311457=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39')'
      
        '1102311458=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, ' +
        'G_PRODUCT C'
      '1102311459=       WHERE S.ZAKAZ = :ZAKAZ_'
      '1102311460=         AND S.g_product = G.g_product'
      '1102311461=         AND G.g_unit = U.g_unit'
      '1102311462=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '1102311463=        INTO :ROW_NUM,'
      '1102311464=            :CATEGORY_NAME,'
      '1102311465=            :NAME,'
      '1102311466=            :ARTICUL,'
      '1102311467=            :BARCODE,'
      '1102311468=            :NOMENCLATUR_NUM,'
      '1102311469=            :PRICE_ROZN,'
      '1102311470=            :SHORT_NAME,'
      '1102311471=            :AMOUNT,'
      '1102311472=            :PRICE_N,'
      '1102311473=            :SUMM_N'
      '1102311474=  DO BEGIN'
      '1102311475=    I = I + 1;'
      '1102311476=    SUSPEND;'
      '1102311477=  END'
      '1102311478=WHEN ANY DO BEGIN'
      '1102311479=    Err_code = -20500;'
      
        '1102311480=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102311481=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102311482=  END'
      '1102311483=end'
      '1102311484=;'
      '1102311485='
      '1102311486=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '1102311487=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1102311488=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1102311489=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102311490=  DATE_BEGIN_ DATE,'
      '1102311491=  DATE_END_ DATE,'
      '1102311492=  TIME_BEGIN_ TIME,'
      '1102311493=  TIME_END_ TIME,'
      '1102311494=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102311495=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102311496=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1102311497=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '1102311498=RETURNS ('
      '1102311499=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1102311500=  AMOUNT_VES TYPE OF COLUMN G_PRODUCT.VES_GRAMM,'
      '1102311501=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1102311502=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1102311503=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1102311504=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1102311505=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1102311506=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1102311507=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102311508=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102311509=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102311510=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102311511=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102311512=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102311513=  Z_DATE BLOB SUB_TYPE 1,'
      '1102311514=  ROW INTEGER,'
      '1102311515=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102311516=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102311517=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102311518=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102311519=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1102311520=  ERR_CODE INTEGER,'
      '1102311521=  ERR_MSG VARCHAR(1024))'
      '1102311522=AS'
      
        '1102311523=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST'#39';'
      '1102311524=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102311525=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1102311526=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '1102311527=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1102311528=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BA' +
        'RCODE;'
      
        '1102311529=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PR' +
        'ODUCT.BARCODE;'
      
        '1102311530=DECLARE VARIABLE BRAND_ TYPE OF COLUMN G_PRODUCT.BRAN' +
        'D;'
      
        '1102311531=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1102311532=DECLARE VARIABLE AMOUNT_VES_ TYPE OF COLUMN G_PRODUCT' +
        '.VES_GRAMM;'
      
        '1102311533=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102311534=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.NAME;'
      
        '1102311535=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '1102311536=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1102311537=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM = 0;'
      
        '1102311538=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1102311539=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1102311540=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1102311541=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_SUMM = 0;'
      
        '1102311542=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1102311543=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1102311544=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1102311545=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1102311546=DECLARE VARIABLE I INTEGER = 1;'
      '1102311547=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      
        '1102311548=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAM' +
        'E;'
      
        '1102311549=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102311550=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102311551=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FIO_DOC;'
      '1102311552=BEGIN'
      '1102311553=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1102311554=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1102311555='
      
        '1102311556=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') |' +
        '| '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extr' +
        'act(year from Z.Z_DATE),'
      '1102311557=             Z.Z_TIME,'
      '1102311558=             GP.ARTICUL,'
      '1102311559=             GP.BARCODE,'
      '1102311560=             GP.NOMENCLATUR_NUM,'
      '1102311561=             GP.BRAND,'
      '1102311562=             GP.NAME,'
      '1102311563=             ZD.AMOUNT,'
      '1102311564=             ZD.AMOUNT * COALESCE(GP.VES_GRAMM, 0),'
      '1102311565=             ZD.PRICE,'
      '1102311566=             ZD.DISCOUNT_TENGE,'
      '1102311567=             ZD.SUMM,'
      '1102311568=             ZD.DISCOUNT_SUMM,'
      '1102311569=             GC.NAME,'
      
        '1102311570=             (CASE WHEN (Z.SUMM_CASH > 0 AND Z.SUMM_N' +
        'ONCASH > 0) THEN '#39#1057#1084#1077#1096#1072#1085#1085#1099#1081#39
      
        '1102311571=                   WHEN Z.SUMM_CASH > 0 THEN '#39#1053#1072#1083#1080#1095#1085#1099 +
        #1081#39
      '1102311572=                   ELSE '#39#1041#1077#1079#1085#1072#1083#1080#1095#1085#1099#1081#39' END),'
      '1102311573=             TR.PATH,'
      '1102311574=             Z.NOTE,'
      '1102311575=             U.SHORT_NAME,'
      '1102311576=             Z.SUMM_CASH,'
      '1102311577=             Z.SUMM_NONCASH,'
      
        '1102311578=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, ' +
        #39#39')'
      
        '1102311579=      FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.' +
        'G_OFFICIAL = O.G_OFFICIAL,'
      '1102311580=           ZAKAZ_DETAILS ZD,'
      '1102311581=           G_CLIENT GC,'
      '1102311582=           G_PAYMENT_TYPE P,'
      '1102311583=           G_PRODUCT GP,'
      '1102311584=           G_UNIT U,'
      '1102311585=           P_REP_TREE TR'
      
        '1102311586=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1102311587=       AND Z.IS_SPISANIE IN (0,2)'
      '1102311588=       AND Z.IS_RESERVE = 0'
      '1102311589=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102311590=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1102311591=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1102311592=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1102311593=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1102311594=       AND GP.G_UNIT = U.G_UNIT'
      '1102311595=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102311596=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1102311597=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1102311598=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1102311599=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1102311600=            OR'
      
        '1102311601=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1102311602=           )/*'
      
        '1102311603=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_' +
        'END_ AND :TIME_BEGIN_ IS NOT NULL)'
      '1102311604=            OR'
      '1102311605=            :TIME_BEGIN_ IS NULL)*/'
      
        '1102311606=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102311607=             OR'
      '1102311608=             (:G_CATEGORY_ IS NULL)'
      '1102311609=           )'
      
        '1102311610=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102311611=             OR'
      '1102311612=            (:G_PRODUCT_ IS NULL)'
      '1102311613=           )'
      '1102311614=       AND ((EXISTS (SELECT 1'
      '1102311615=                       FROM SKLAD S'
      '1102311616=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      
        '1102311617=                        AND S.G_PRODUCT = GP.G_PRODUC' +
        'T'
      
        '1102311618=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102311619=              OR'
      '1102311620=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102311621='
      '1102311622=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '1102311623=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :' +
        'NOMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :AMOUNT_VES_,' +
        ' :PRICE_,'
      
        '1102311624=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, ' +
        ':CLIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_,'
      
        '1102311625=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME' +
        '_'
      '1102311626=  DO BEGIN'
      '1102311627=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1102311628=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102311629=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102311630=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, ' +
        '"DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '1102311631=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL' +
        '_, :DISCOUNT_SUMM_ROLL_, 1);'
      '1102311632='
      '1102311633=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1102311634=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1102311635=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ +' +
        ' DISCOUNT_SUMM_ROLL_;'
      '1102311636=            SUMM_ROLL_ = 0;'
      '1102311637=            DISCOUNT_SUMM_ROLL_ = 0;'
      '1102311638=            I = I + 1;'
      '1102311639=        END'
      '1102311640='
      '1102311641=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102311642=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DAT' +
        'E", ROW)'
      '1102311643=        VALUES (:I, :PATH_, 1);'
      '1102311644=        I = I + 1;'
      '1102311645=    END'
      '1102311646='
      
        '1102311647=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", ' +
        '"TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, BRAND, NAME, AMOUNT, ' +
        'AMOUNT_VES, PRICE, DISCOUNT, SUMM,'
      
        '1102311648=                                         DISCOUNT_SUM' +
        'M, CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME,'
      
        '1102311649=                                         SUMM_CASH, S' +
        'UMM_NONCASH, OFFICIAL_NAME)'
      
        '1102311650=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCO' +
        'DE_, :NOMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :AMOUNT' +
        '_VES_, :PRICE_, :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '1102311651=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0,' +
        ' :UNIT_NAME_,'
      
        '1102311652=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NA' +
        'ME_);'
      '1102311653='
      '1102311654=    I = I + 1;'
      '1102311655=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '1102311656=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCO' +
        'UNT_SUMM_;'
      '1102311657=    LAST_PATH_ = PATH_;'
      '1102311658=  END'
      '1102311659='
      '1102311660=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1102311661=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1102311662=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOU' +
        'NT_SUMM_ROLL_, 1);'
      '1102311663='
      '1102311664=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1102311665=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1102311666=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_' +
        'SUMM_ROLL_;'
      '1102311667='
      
        '1102311668=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1102311669=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1102311670='
      
        '1102311671=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENC' +
        'LATUR_NUM, BRAND, NAME, AMOUNT, AMOUNT_VES, PRICE, DISCOUNT, SUM' +
        'M, DISCOUNT_SUMM, CLIENT_NAME,'
      
        '1102311672=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME, SUMM' +
        '_CASH, SUMM_NONCASH, OFFICIAL_NAME'
      '1102311673=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1102311674=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOM' +
        'ENCLATUR_NUM, :BRAND, :TOVAR_NAME,'
      
        '1102311675=           :AMOUNT, :AMOUNT_VES, :PRICE, :DISCOUNT_TE' +
        'NGE, :SUMM, :DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      
        '1102311676=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCA' +
        'SH, :OFFICIAL_NAME'
      '1102311677=  do suspend;'
      '1102311678='
      '1102311679=WHEN ANY DO BEGIN'
      '1102311680=    Err_code = -20500;'
      
        '1102311681=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1102311682=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102311683=  END'
      '1102311684=end'
      '1102311685=;'
      '1102311686='
      '1102311687='
      
        '1102311688=/****************************************************' +
        '**************************/'
      
        '1102311689=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102311690=/****************************************************' +
        '**************************/'
      '1102311691=ALTER PROCEDURE P_REP_PRICE_LIST('
      '1102311692=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102311693=  INCLUDE_NOL_ INTEGER,'
      '1102311694=  INCLUDE_FEW_ INTEGER,'
      '1102311695=  SORT_BY_NAME_ INTEGER,'
      '1102311696=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102311697=  SCALE_PREFIX_ VARCHAR(2) = '#39#39','
      '1102311698=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1102311699=RETURNS ('
      '1102311700=  PERIOD_ VARCHAR(40),'
      '1102311701=  ROW_NUM VARCHAR(15),'
      '1102311702=  ARTICUL VARCHAR(1000),'
      '1102311703=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102311704=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102311705=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102311706=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102311707=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102311708=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102311709=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102311710=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1102311711=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      
        '1102311712=  AMOUNT_VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        ','
      '1102311713=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1102311714=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1102311715=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1102311716=  TOVAR_NAME VARCHAR(250),'
      '1102311717=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102311718=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102311719=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1102311720=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102311721=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102311722=  ERR_CODE INTEGER,'
      '1102311723=  ERR_MSG VARCHAR(1024))'
      '1102311724=AS'
      '1102311725=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '1102311726=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_' +
        'LIST'#39';'
      '1102311727=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102311728=DECLARE VARIABLE I INTEGER = 1;'
      '1102311729=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102311730=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102311731=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1102311732=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1102311733=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102311734=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1102311735=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1102311736=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1102311737=BEGIN'
      '1102311738='
      
        '1102311739=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1102311740=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102311741='
      '1102311742=  SELECT S.S_VALUE,'
      '1102311743=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1102311744=    FROM SYSTEM_SETUP S'
      '1102311745=   WHERE S.SYSTEM_SETUP = 1'
      '1102311746=    INTO :FORMULA_,'
      '1102311747=         :PRIHOD_CNT_;'
      '1102311748='
      '1102311749=  FOR SELECT GP.PATH,'
      '1102311750=             GP.G_PRODUCT'
      '1102311751=        FROM P_REP_TREE GP'
      '1102311752=       WHERE EXISTS (SELECT 1'
      '1102311753=                       FROM G_PRODUCT'
      '1102311754=                      WHERE IS_CATEGORY = 0'
      
        '1102311755=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1102311756=                    )'
      
        '1102311757=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102311758=              OR'
      '1102311759=              (:G_CATEGORY_ is NULL)'
      '1102311760=             )'
      '1102311761=       ORDER BY 1, 2'
      '1102311762=       INTO :PATH_NAME_,'
      '1102311763=            :G_PRODUCT_'
      '1102311764=  DO BEGIN'
      
        '1102311765=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1102311766=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1102311767=      SELECT COUNT(G.G_PRODUCT)'
      
        '1102311768=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102311769=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1102311770=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102311771=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102311772=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102311773=              OR'
      
        '1102311774=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1102311775=              or'
      
        '1102311776=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1102311777=             )'
      '1102311778=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102311779=         AND ((EXISTS (SELECT 1'
      '1102311780=                       FROM SKLAD S'
      '1102311781=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1102311782=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1102311783=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102311784=              OR'
      '1102311785=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1102311786=        INTO :CNT_;'
      '1102311787='
      '1102311788=      IF (CNT_ > 0) THEN BEGIN'
      
        '1102311789=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1102311790=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1102311791='
      
        '1102311792=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1102311793=                                              ARTICUL' +
        ','
      
        '1102311794=                                              BARCODE' +
        ','
      
        '1102311795=                                              NOMENCL' +
        'ATUR_NUM,'
      '1102311796=                                              NAME,'
      
        '1102311797=                                              UNIT_NA' +
        'ME,'
      '1102311798=                                              PRICE,'
      
        '1102311799=                                              VOLUME_' +
        'PRICE,'
      
        '1102311800=                                              SKIDKA_' +
        'PRICE,'
      '1102311801=                                              AMOUNT,'
      
        '1102311802=                                              AMOUNT_' +
        'RESERVE,'
      '1102311803=                                              SUMM,'
      
        '1102311804=                                              PRICE_S' +
        'ELF,'
      
        '1102311805=                                              SORT_CO' +
        'L,'
      
        '1102311806=                                              IS_CATE' +
        'GORY,'
      '1102311807=                                              NOTE,'
      
        '1102311808=                                              CROSSCO' +
        'DE_BLOB_TXT,'
      '1102311809=                                              PLACE,'
      '1102311810=                                              BRAND,'
      
        '1102311811=                                              AMOUNT_' +
        'VES_GRAMM)'
      
        '1102311812=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1102311813=                 G.ARTICUL,'
      '1102311814=                 G.BARCODE,'
      '1102311815=                 G.NOMENCLATUR_NUM,'
      '1102311816=                 G.NAME,'
      '1102311817=                 U.SHORT_NAME,'
      '1102311818=                 G.PRICE,'
      '1102311819=                 G.VOLUME_PRICE,'
      '1102311820=                 G.PRICE - GD.SKIDKA_SUM,'
      '1102311821=                 COALESCE(S.AMOUNT, 0),'
      '1102311822=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1102311823=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1102311824=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1102311825=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1102311826=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1102311827=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '1102311828=                  DECODE(:FORMULA_,'
      '1102311829=                         1,'
      
        '1102311830=                         (SELECT CAST(S.price AS MY_N' +
        'UMERIC)'
      '1102311831=                            FROM SKLAD S'
      
        '1102311832=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102311833=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1102311834=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1102311835=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1102311836=                                                     ' +
        'FROM SKLAD DD'
      
        '1102311837=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1102311838=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1102311839=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1102311840=                                                    )'
      '1102311841=                            ORDER BY 1 DESC'
      '1102311842=                            ROWS 1 TO 1'
      '1102311843=                         ),'
      
        '1102311844=                         (SELECT CAST(ROUND(SUM(T.AMO' +
        'UNT * T.PRICE)/SUM(T.AMOUNT), 2) AS MY_NUMERIC)'
      
        '1102311845=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1102311846=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1102311847=                                         SKLAD S'
      
        '1102311848=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1102311849=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1102311850=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1102311851=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1102311852=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1102311853=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '1102311854=                        )), 0) spr,'
      
        '1102311855=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1102311856=                 0'
      '1102311857=                 ,G.NOTE'
      
        '1102311858=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      '1102311859=                 ,G.PLACE'
      '1102311860=                 ,G.BRAND'
      '1102311861=                 ,COALESCE(S.AMOUNT, 0) * G.VES_GRAMM'
      
        '1102311862=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '1102311863=                                                FROM ' +
        'G_DISCOUNT D'
      
        '1102311864=                                                WHERE' +
        ' ((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '1102311865=                                                     ' +
        '   AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '1102311866=                                                     ' +
        '   AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '1102311867=                                                     ' +
        ' )'
      
        '1102311868=                                                     ' +
        ' OR'
      
        '1102311869=                                                     ' +
        ' (D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '1102311870=                                                 AND ' +
        '((:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '1102311871=                                                     ' +
        'OR'
      
        '1102311872=                                                     ' +
        '(D.G_TOCHKA IS NULL))'
      
        '1102311873=                                              ) GD ON' +
        ' G.G_PRODUCT = GD.G_PRODUCT'
      
        '1102311874=                             LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1102311875=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102311876=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1102311877=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102311878=             AND G.IS_CATEGORY = 0'
      '1102311879=             AND G.is_active = 1'
      '1102311880=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102311881=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102311882=                  OR'
      
        '1102311883=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1102311884=                  or'
      
        '1102311885=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1102311886=                 )'
      '1102311887=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102311888=             AND ((EXISTS (SELECT 1'
      '1102311889=                           FROM SKLAD S'
      
        '1102311890=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1102311891=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1102311892=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102311893=                  OR'
      '1102311894=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1102311895=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '1102311896=      END'
      '1102311897=  END'
      '1102311898='
      
        '1102311899=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1102311900='
      
        '1102311901=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE_BLOB_TXT, PLACE, NAME, BRAND, NOTE, UNIT_NAME,'
      
        '1102311902=             PRICE, VOLUME_PRICE, SKIDKA_PRICE, AMOUN' +
        'T, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEG' +
        'ORY, AMOUNT_VES_GRAMM,'
      '1102311903=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '1102311904=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1102311905=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, :CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME,'
      
        '1102311906=           :PRICE, :VOLUME_PRICE, :SKIDKA_PRICE, :AMO' +
        'UNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_CATEGO' +
        'RY, AMOUNT_VES_GRAMM, :TOVAR_NAME'
      '1102311907=  DO BEGIN'
      '1102311908=    I = I + 1;'
      '1102311909=    SUSPEND;'
      '1102311910=  END'
      '1102311911='
      '1102311912=     /*'
      '1102311913=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '1102311914='
      '1102311915=     SELECT :I,'
      
        '1102311916=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045 +
        #1044#1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      
        '1102311917=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058 +
        #1054
      '1102311918=             U.SHORT_NAME UNIT_NAME,'
      '1102311919=             SS.PRICE,'
      '1102311920=             SS.VOLUME_PRICE,'
      '1102311921=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '1102311922=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE' +
        '(S.AMOUNT, 0)),'
      '1102311923=             SS.IS_CATEGORY'
      '1102311924=        FROM (WITH RECURSIVE TREE'
      '1102311925=              AS (SELECT T.G_PRODUCT,'
      '1102311926=                       T.NAME AS ARTICUL,'
      
        '1102311927=                       CAST(NULL AS VARCHAR(500)) NAM' +
        'E,'
      
        '1102311928=                       CAST(NULL AS NUMERIC(15,2)) PR' +
        'ICE,'
      
        '1102311929=                       CAST(NULL AS NUMERIC(15,2)) VO' +
        'LUME_PRICE,'
      '1102311930=                       T.IS_CATEGORY,'
      '1102311931=                       NULL G_UNIT'
      '1102311932=                  FROM G_PRODUCT T'
      '1102311933=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '1102311934=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T' +
        '.G_PRODUCT||'#39'~'#39
      '1102311935=                UNION ALL'
      '1102311936=                SELECT T.G_PRODUCT,'
      '1102311937=                       DECODE(T. T.ARTICUL,'
      '1102311938=                       T.NAME,'
      '1102311939=                       T.PRICE,'
      '1102311940=                       T.VOLUME_PRICE,'
      '1102311941=                       T.IS_CATEGORY,'
      '1102311942=                       T.G_UNIT'
      
        '1102311943=                  FROM G_PRODUCT T INNER JOIN TREE PR' +
        'IOR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '1102311944=                 WHERE T.IS_ACTIVE = 1'
      '1102311945=                )'
      '1102311946=             SELECT * FROM TREE) SS'
      
        '1102311947=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS' +
        '.G_PRODUCT = S.G_PRODUCT'
      
        '1102311948=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = ' +
        'U.G_UNIT'
      
        '1102311949=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PR' +
        'ODUCT = GD.G_PRODUCT'
      '1102311950=    INTO :ROW_NUM,'
      '1102311951=        :ARTICUL,'
      '1102311952=        :NAME,'
      '1102311953=        :UNIT_NAME,'
      '1102311954=        :PRICE,'
      '1102311955=        :VOLUME_PRICE,'
      '1102311956=        :SKIDKA_PRICE,'
      '1102311957=        :AMOUNT,'
      '1102311958=        :IS_CATEGORY'
      '1102311959=    DO BEGIN'
      '1102311960=      I = I + 1;'
      '1102311961=      SUSPEND;'
      '1102311962=    END  */'
      '1102311963=WHEN ANY DO BEGIN'
      '1102311964=    Err_code = -20500;'
      
        '1102311965=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102311966=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102311967=  END'
      '1102311968=end'
      '1102311969=;'
      '1102311970='
      '1102311971='
      
        '1102311972=UPDATE SYSTEM_SETUP SET S_VALUE = 110231 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102311973=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102311974=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102320=ALTER PROCEDURE G_PRODUCT_SET_NEW_PRICES('
      '1102321=  CONFIG_ SMALLINT,'
      '1102322=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102323=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102324=  CHANGE_PRICE_ INTEGER,'
      '1102325=  MODE_ INTEGER,'
      '1102326=  WHAT_PRICE_ INTEGER,'
      '1102327=  NEW_VAL_ NUMERIC(15,2),'
      '1102328=  COURSE_OLD_ NUMERIC(15,2),'
      '1102329=  COURSE_NEW_ NUMERIC(15,2),'
      '11023210=  ROUND_MODE_ INTEGER,'
      '11023211=  CHANGE_CATEGORY_ INTEGER,'
      
        '11023212=  NEW_CATEGORY_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT *' +
        '/ BIGINT,'
      '11023213=  CHANGE_MIN_AMOUNT_ INTEGER,'
      
        '11023214=  NEW_MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUN' +
        'T */ NUMERIC(15,2),'
      '11023215=  CHANGE_SALES_COMM_ INTEGER,'
      
        '11023216=  NEW_SALES_COMM_ /* TYPE OF COLUMN G_PRODUCT.SALES_COM' +
        'M */ NUMERIC(15,2),'
      '11023217=  CHANGE_KIT_TYPE_ INTEGER,'
      '11023218=  IS_KASPI_SHOP_ SMALLINT,'
      '11023219=  IS_KASPI_SHOP_MODE_ SMALLINT)'
      '11023220=RETURNS ('
      '11023221=  ERR_CODE INTEGER,'
      '11023222=  ERR_MSG VARCHAR(1000))'
      '11023223=AS'
      '11023224=BEGIN'
      '11023225=  SUSPEND;'
      '11023226=END'
      '11023227=;'
      '11023228='
      '11023229='
      
        '11023230=/******************************************************' +
        '************************/'
      
        '11023231=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11023232=/******************************************************' +
        '************************/'
      '11023233=ALTER PROCEDURE G_PRODUCT_SET_NEW_PRICES('
      '11023234=  CONFIG_ SMALLINT,'
      '11023235=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11023236=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11023237=  CHANGE_PRICE_ INTEGER,'
      '11023238=  MODE_ INTEGER,'
      '11023239=  WHAT_PRICE_ INTEGER,'
      '11023240=  NEW_VAL_ NUMERIC(15,2),'
      '11023241=  COURSE_OLD_ NUMERIC(15,2),'
      '11023242=  COURSE_NEW_ NUMERIC(15,2),'
      '11023243=  ROUND_MODE_ INTEGER,'
      '11023244=  CHANGE_CATEGORY_ INTEGER,'
      '11023245=  NEW_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11023246=  CHANGE_MIN_AMOUNT_ INTEGER,'
      '11023247=  NEW_MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11023248=  CHANGE_SALES_COMM_ INTEGER,'
      '11023249=  NEW_SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11023250=  CHANGE_KIT_TYPE_ INTEGER,'
      '11023251=  IS_KASPI_SHOP_ SMALLINT,'
      '11023252=  IS_KASPI_SHOP_MODE_ SMALLINT)'
      '11023253=RETURNS ('
      '11023254=  ERR_CODE INTEGER,'
      '11023255=  ERR_MSG VARCHAR(1000))'
      '11023256=AS'
      '11023257=/*'
      '11023258=CONFIG_ - '#1050#1054#1053#1060#1048#1043#1059#1056#1040#1062#1048#1071' '#1052#1040#1043#1040#1047#1048#1053#1040', 4 - '#1070#1042#1045#1051#1048#1056#1050#1040
      '11023259='
      
        '11023260=ROUND_MODE_ 0 - '#1076#1077#1089#1103#1090#1099#1077', 1 - '#1094#1077#1083#1099#1077', 2 '#1076#1077#1089#1103#1090#1082#1080', 3 '#1089#1086#1090#1085#1080',' +
        ' 4 '#1090#1099#1089#1103#1095#1080
      '11023261='
      '11023262=CHANGE_KIT_TYPE_ - '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040
      '11023263=*/'
      
        '11023264=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '11023265=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE;'
      
        '11023266=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.VO' +
        'LUME_PRICE;'
      '11023267=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '11023268=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '11023269=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11023270=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '11023271=BEGIN'
      '11023272='
      '11023273=  SQL_STR_ = '#39'UPDATE G_PRODUCT P'#39'||'
      '11023274=               '#39' SET '#39';'
      '11023275='
      '11023276=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '11023277='
      '11023278=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '11023279=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '11023280=      IF (ROUND_MODE_ = 0) THEN'
      '11023281=          ROUND_ = 1;'
      '11023282=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '11023283=          ROUND_ = 0;'
      '11023284=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '11023285=          ROUND_ = -1;'
      '11023286=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '11023287=          ROUND_ = -2;'
      '11023288=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '11023289=          ROUND_ = -3;'
      '11023290='
      
        '11023291=      -- '#1045#1057#1051#1048' '#1054#1041#1067#1063#1053#1067#1049' '#1052#1040#1043#1040#1047', '#1048#1051#1048' '#1070#1042#1045#1051#1048#1056#1050#1040' '#1053#1054' '#1052#1045#1053#1071#1070#1058' '#1054#1041#1067 +
