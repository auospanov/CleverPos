        'idx from raz*4+3 for 2) as int));'
      '110157239=      if (buf1 != '#39#39') then begin'
      '110157240=        /* '#1055#1086#1076#1073#1086#1088' '#1086#1082#1086#1085#1095#1072#1085#1080#1103' '#1076#1083#1103' '#1088#1072#1079#1088#1103#1076#1072' */'
      '110157241=        if (i = 1) then begin'
      '110157242=          if (raz = 1) then buf1 = buf1 || '#39#1072#39';'
      '110157243=        end else'
      '110157244=        if (i in (2,3,4)) then begin'
      '110157245=          if (raz = 1) then buf1 = buf1 || '#39#1080#39';'
      '110157246=          else if (raz > 1) then buf1 = buf1 || '#39#1072#39';'
      '110157247=        end else'
      '110157248=          if (raz > 1) then buf1 = buf1 || '#39#1086#1074#39';'
      '110157249=        buf = buf || '#39' '#39' || buf1;'
      '110157250=      end'
      '110157251=    end else'
      '110157252=      buf = '#39#39';'
      '110157253='
      
        '110157254=    /* '#1055#1088#1080#1089#1086#1077#1076#1080#1085#1103#1077#1084' '#1086#1073#1088#1072#1073#1086#1090#1072#1085#1085#1091#1102' '#1090#1088#1080#1072#1076#1091' '#1082' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1091' *' +
        '/'
      
        '110157255=    if (curr_str != '#39#39' and buf != '#39#39') then buf = buf |' +
