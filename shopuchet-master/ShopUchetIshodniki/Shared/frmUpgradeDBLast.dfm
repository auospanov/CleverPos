      '1102282791='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1102282792=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1102282793=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
