        '110621223=                                                  :ZAK' +
        'AZ_,   --ZAKAZ_'
      
        '110621224=                                                  NULL' +
        ','
      
        '110621225=                                                  :G_P' +
        'AYMENT_TYPE_,'
      
        '110621226=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110621227=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621228=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110621229=                      EXIT;'
      '110621230=                    END'
      '110621231=                END'
      '110621232=            END'
      
        '110621233=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058 +
        #1068#1048
      
        '110621234=            --========================================' +
        '========================='
      '110621235='
      
        '110621236=            --========================================' +
        '========================='
      '110621237=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '110621238=            --========================================' +
        '========================='
      '110621239=            PNT_ = '#39'12'#39';'
      
        '110621240=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SAL' +
        'ES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) ' +
        'THEN BEGIN'
      '110621241=                KASSA_ = NULL;'
      '110621242='
      '110621243=                SELECT S.S_VALUE'
      '110621244=                  FROM SYSTEM_SETUP S'
      '110621245=                 WHERE S.SYSTEM_SETUP = 4'
      '110621246=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '110621247='
      '110621248=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '110621249=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110621250=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110621251='
      
        '110621252=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051 +
        #1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '110621253=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) ' +
        'THEN'
      
        '110621254=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7 ' +
        '- DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKD' +
        'AY FROM CURRENT_DATE)));'
      '110621255='
      '110621256=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '110621257=                ELSE'
      
        '110621258=                   ACTION_DATE_ZP_ = Current_date - EX' +
        'TRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_dat' +
        'e - EXTRACT(DAY FROM current_date) + 32);'
      '110621259='
      '110621260=                SELECT K.KASSA, K.SUMM'
      '110621261=                FROM KASSA K'
      '110621262=                WHERE K.G_PRIHOD_RASHOD = -1'
      '110621263=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110621264=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110621265=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110621266='
      '110621267=                IF (KASSA_ IS NULL) THEN'
      
        '110621268=                    EXECUTE PROCEDURE K_INS_KASSA(1,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110621269=                                                  -1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '110621270=                                                  :SAL' +
        'ES_COMM_SUMM_ALL_,'
      
        '110621271=                                                  :ACT' +
        'ION_DATE_ZP_,'
      
        '110621272=                                                  :OFF' +
        'ICIAL_NAME_,'
      
        '110621273=                                                  NULL' +
        ',     --:ZAKAZ_,'
      
        '110621274=                                                  NULL' +
        ',     --:SKLAD_,'
      '110621275=                                                  1,'
      
        '110621276=                                                  :G_T' +
        'OCHKA_,'
      
        '110621277=                                                  :G_O' +
        'FFICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110621278=                ELSE BEGIN'
      
        '110621279=                    EXECUTE PROCEDURE K_UPD_KASSA(:KAS' +
        'SA_,'
      
        '110621280=                                                  1,  ' +
        '   -- ACTION_'
      
