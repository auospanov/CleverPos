      '110192417=      END ELSE BEGIN'
      '110192418='
      
        '110192419=          INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERA' +
        'TION, G_OFFICIAL,'
      '110192420=            ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110192421=          VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIM' +
        'ESTAMP, 3, :USER_ID_, 13, :G_PRODUCT_LOC_, :STR1_, :STR2_);'
      '110192422='
      '110192423=          delete from LT_SKLAD_PRODUCT g'
      '110192424=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110192425='
      '110192426=          delete from lt_barcode g'
      '110192427=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110192428='
