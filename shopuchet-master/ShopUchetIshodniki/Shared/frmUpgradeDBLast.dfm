      '1102014834=                 '#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1082#1086#1085#1077#1094#39','
      '1102014835=                 NULL,'
      
        '1102014836=                 (select (select COALESCE(sum(amount)' +
        ', 0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1102014837=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1102014838=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1102014839=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102014840=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1102014841=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1102014842=                        and zrp.ZAKAZ_DATE > :DATE_EN' +
        'D_)'
      '1102014843=                       +'
      
        '1102014844=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1102014845=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1102014846=                        and zd.zakaz = z.zakaz and z.' +
        'z_date > :DATE_END_'
      '1102014847=                        and z.is_reserve = 0'
      
        '1102014848=                        and z.IS_SPISANIE <> 2   -- '#1085 +
        #1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' ' +
        #1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102014849=                        and not (z.IS_SPISANIE = 0 an' +
        'd z.NOT_MINUS_OSTATOK = 1))'
      '1102014850=                       +'
      
        '1102014851=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1102014852=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt > :DATE_END_)'
      '1102014853=                       +'
      
        '1102014854=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1102014855=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1102014856=                        and od.other = o.other and o.' +
        'op_date > :DATE_END_)'
      '1102014857=                       -'
      
        '1102014858=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102014859=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102014860=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt > :DATE_END_ and not (sp.IS_VOZVRAT = 0 and sp.IS_EX' +
        'PECTED = 1))'
      '1102014861=                       -'
      
        '1102014862=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102014863=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1102014864=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||SP.g_tochka||'#39'-'#39' and sp.date_receipt > :DATE_END_ and sp.I' +
        'S_EXPECTED = 0)'
      '1102014865=                  from rdb$database) PRICE,'
      '1102014866=                 NULL,'
      '1102014867=                 NULL,'
      '1102014868=                 NULL,'
      '1102014869=                 NULL'
      '1102014870=            FROM G_PRODUCT G'
      '1102014871=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '1102014872=         ORDER BY 2, 1, 3'
      '1102014873=            INTO :ROW,'
      '1102014874=                 :DATE_SORT,'
      '1102014875=                 :DATE_ACT,'
      '1102014876=                 :OPER,'
      '1102014877=                 :PRICE_PRIHOD,'
      '1102014878=                 :AMOUNT_PRIHOD,'
      '1102014879=                 :SUMM_PRIHOD,'
      '1102014880=                 :PRICE_UHOD,'
      '1102014881=                 :AMOUNT_UHOD,'
      '1102014882=                 :SUMM_UHOD'
      '1102014883=      DO BEGIN'
      '1102014884=        IF (ROW not in (-2, -1, 13)) THEN BEGIN'
      '1102014885=            PRICE_PRIHOD = COALESCE(PRICE_PRIHOD, 0);'
      
        '1102014886=            AMOUNT_PRIHOD = COALESCE(AMOUNT_PRIHOD, 0' +
        ');'
      '1102014887=            SUMM_PRIHOD = COALESCE(SUMM_PRIHOD, 0);'
      '1102014888=            PRICE_UHOD = COALESCE(PRICE_UHOD, 0);'
      '1102014889=            AMOUNT_UHOD = COALESCE(AMOUNT_UHOD, 0);'
      '1102014890=            SUMM_UHOD  = COALESCE(SUMM_UHOD, 0);'
      '1102014891=        END'
      '1102014892=        SUSPEND;'
      '1102014893=      END'
      '1102014894=  END'
      '1102014895=WHEN ANY DO BEGIN'
      '1102014896=    Err_code = -20500;'
      
        '1102014897=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1048#1057#1058#1054#1056#1048#1048' '#1058#1054#1042#1040#1056#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102014898=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102014899=  END'
      '1102014900=end'
      '1102014901=;'
      '1102014902='
      '1102014903=ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '1102014904=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102014905=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1102014906=  DATE_BEGIN_ DATE,'
      '1102014907=  DATE_END_ DATE,'
      '1102014908=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102014909=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1102014910=RETURNS ('
      '1102014911=  DATE_BEGIN_OUT_ DATE,'
      '1102014912=  DATE_END_OUT_ DATE,'
      '1102014913=  STR_ VARCHAR(500),'
      '1102014914=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '1102014915=  NAME VARCHAR(1000),'
      '1102014916=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1102014917=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1102014918=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102014919=  AMOUNT_IN MY_NUMERIC_5,'
      
        '1102014920=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '1102014921=  SUMM_PRIHOD NUMERIC(15,2),'
      '1102014922=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1102014923=  SUMM_UHOD NUMERIC(15,2),'
      
        '1102014924=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1102014925=  SUMM_SPISANO NUMERIC(15,2),'
      
        '1102014926=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1102014927=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '1102014928=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.A' +
        'MOUNT,'
      '1102014929=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '1102014930=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1102014931=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '1102014932=  AMOUNT_OUT MY_NUMERIC_5,'
      '1102014933=  IS_HEAD INTEGER,'
      '1102014934=  ERR_CODE INTEGER,'
      '1102014935=  ERR_MSG VARCHAR(1024))'
      '1102014936=AS'
      
        '1102014937=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1102014938=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102014939=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '1102014940=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1102014941=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT = 0;'
      '1102014942=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1102014943=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1102014944=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1102014945=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1102014946=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1102014947=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102014948=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1102014949=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102014950=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1102014951=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1102014952=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1102014953=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102014954=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1102014955=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102014956=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1102014957=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102014958=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1102014959=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102014960=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1102014961=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102014962=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1102014963=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102014964=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0' +
        ';'
      
        '1102014965=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102014966=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1102014967=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1102014968=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1102014969=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102014970=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '1102014971=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1102014972=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '1102014973=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102014974=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1102014975=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1102014976=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      '1102014977=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '1102014978=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39';'
      
        '1102014979=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '1102014980=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '1102014981=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      '1102014982=BEGIN'
      '1102014983='
      '1102014984=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '1102014985=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1102014986='
      '1102014987=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '1102014988=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '1102014989=               (select (select COALESCE(sum(amount), ' +
        '0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1102014990=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1102014991=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1102014992=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102014993=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1102014994=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1102014995=                        and zrp.ZAKAZ_DATE >= :DATE_B' +
        'EGIN_)'
      '1102014996=                       +'
      
        '1102014997=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1102014998=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1102014999=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      '1102015000=                        and z.IS_RESERVE = 0'
      
        '1102015001=                        and z.IS_SPISANIE <> 2   -- '#1085 +
        #1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' ' +
        #1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102015002=                        and not (z.IS_SPISANIE = 0 an' +
        'd z.NOT_MINUS_OSTATOK = 1))'
      '1102015003=                       +'
      
        '1102015004=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1102015005=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1102015006=                       +'
      
        '1102015007=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1102015008=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1102015009=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1102015010=                       -'
      
        '1102015011=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102015012=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102015013=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_ and not (sp.IS_VOZVRAT = 0 and sp.IS' +
        '_EXPECTED = 1))'
      '1102015014=                       -'
      
        '1102015015=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102015016=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1102015017=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||Sp.g_tochka||'#39'-'#39' and sp.date_receipt >= :DATE_BEGIN_ and s' +
        'p.IS_EXPECTED = 0)'
      '1102015018=                  from rdb$database) AMOUNT_OUT,'
      '1102015019=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1102015020=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1102015021=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102015022=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102015023=                   AND SP.IS_VOZVRAT = 0'
      '1102015024=                   AND SP.IS_EXPECTED = 0'
      
        '1102015025=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') AMOUNT_PRIHOD,'
      '1102015026=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1102015027=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1102015028=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1102015029=                   AND SP.IS_VOZVRAT = 0'
      '1102015030=                   AND SP.IS_EXPECTED = 0'
      
        '1102015031=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') SUMM_PRIHOD,'
      '1102015032=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '1102015033=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1102015034=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102015035=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102015036=                   AND Z.IS_SPISANIE = 0'
      '1102015037=                   AND Z.IS_RESERVE = 0'
      '1102015038=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1102015039=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_UHOD,'
      '1102015040=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1102015041=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102015042=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102015043=                   AND Z.IS_SPISANIE = 0'
      '1102015044=                   AND Z.IS_RESERVE = 0'
      '1102015045=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1102015046=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_UHOD,'
      '1102015047=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102015048=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1102015049=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
