      '1102251894=               NULL SUMM_DEBET,'
      '1102251895=               S.SUMM SUMM_CREDIT,'
      '1102251896=               S.DATE_RECEIPT SORT_ROW'
      '1102251897=          FROM SKLAD_PARENT S'
      '1102251898=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251899=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
