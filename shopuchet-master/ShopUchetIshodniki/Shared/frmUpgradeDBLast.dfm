      '110249735='
      '110249736=ALTER PROCEDURE INS_SKLAD_BASED_ON_ZAKAZ('
      '110249737=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110249738=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110249739=  ROZN_OR_COST_PRICE_ INTEGER = 0)'
      '110249740=RETURNS ('
      '110249741=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110249742=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      
        '110249743=  G_NON_CASH_PAY_TYPE_ TYPE OF COLUMN ZAKAZ.G_NONCASH_' +
        'PAY_TYPE,'
      '110249744=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD,'
      
        '110249745=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PAY' +
        '_TRANSACTION_ID)'
      '110249746=AS'
      '110249747=/*'
      
        '110249748=ROZN_OR_COST_PRICE_ - '#1050#1072#1082#1091#1102' '#1094#1077#1085#1091' '#1102#1079#1072#1090#1100' '#1087#1088#1080' '#1090#1088#1072#1085#1089#1092#1077#1088#1077', ' +
        '0 - '#1079#1072#1082#1091#1087#1086#1095#1085#1091#1102', 1 - '#1088#1086#1079#1085#1080#1095#1085#1091#1102
      '110249749=*/'
      '110249750=BEGIN'
      '110249751='
      '110249752=  IF (ZAKAZ_ > 0) THEN BEGIN'
      '110249753=      SELECT Z.G_PAYMENT_TYPE,'
      '110249754=             Z.G_NONCASH_PAY_TYPE,'
      '110249755=             Z.POS_PAY_METHOD,'
      '110249756=             Z.POS_PAY_TRANSACTION_ID,'
      '110249757=             Z.G_CLIENT'
      '110249758=        FROM ZAKAZ Z'
      '110249759=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110249760=        INTO :G_PAYMENT_TYPE_,'
      '110249761=             :G_NON_CASH_PAY_TYPE_,'
      '110249762=             :POS_PAY_METHOD_,'
      '110249763=             :POS_PAY_TRANSACTION_ID_,'
      '110249764=             :G_CLIENT_;'
      '110249765='
      '110249766=      insert into sklad_tmp'
      '110249767=      select GEN_ID(gen_details_tmp, 1),'
      '110249768=           zd.g_product,'
      '110249769=           zd.amount,'
      '110249770=           zd.price - zd.discount_tenge,'
      '110249771=           zd.summ,'
      
        '110249772=           zd.NDS, zd.NDS_SUMM, NULL, 0, 0, 0, 0, 0,0,' +
        '0,'
      '110249773=           zd.mark_code,'
      '110249774=           zd.cost_price'
      '110249775=       from zakaz_details zd'
      '110249776=      where zd.zakaz = :ZAKAZ_;'
      '110249777=  END'
      '110249778=  ELSE IF (SKLAD_PARENT_ > 0) THEN BEGIN'
      
        '110249779=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, G_P' +
        'RODUCT, AMOUNT, PRICE, SUMM)'
      '110249780=      SELECT GEN_ID(gen_details_tmp, 1),'
      '110249781=           SD.g_product,'
      '110249782=           SD.amount,'
      
        '110249783=           (CASE WHEN :ROZN_OR_COST_PRICE_ = 0 THEN SD' +
        '.PRICE ELSE G.PRICE END),'
      
        '110249784=           (CASE WHEN :ROZN_OR_COST_PRICE_ = 0 THEN SD' +
        '.SUMM ELSE G.PRICE * SD.AMOUNT END)'
      '110249785=       FROM sklad sd, G_PRODUCT G'
      '110249786=      WHERE sd.SKLAD_PARENT = :SKLAD_PARENT_'
      '110249787=        AND SD.G_PRODUCT = G.G_PRODUCT;'
      '110249788=  END'
      '110249789=END'
      '110249790=;'
      '110249791='
      '110249792=ALTER PROCEDURE INS_ZAKAZ('
