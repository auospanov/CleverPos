        '110223680=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110223681=                     G.barcode         = DECODE(CHAR_L' +
