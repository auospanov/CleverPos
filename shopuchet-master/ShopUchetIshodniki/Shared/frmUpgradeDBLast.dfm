        #1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110233625=  --**************************************************' +
        '***************************************'
      '110233626=  IS_FIRST_  = 1;'
      '110233627=  SUM_ZAKAZ_ = 0;'
      '110233628=  SUM_COST_  = 0;'
      '110233629=  PROFIT_    = 0;'
      '110233630=  NDS_SUMM_  = 0;'
      '110233631=  FOR SELECT SUM(ZD.SUMM)'
      '110233632=           ,TR.PATH'
      '110233633=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '110233634=           ,SUM(ZD.nds_summ)'
