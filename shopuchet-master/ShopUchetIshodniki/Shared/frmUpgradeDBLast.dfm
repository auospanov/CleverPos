        '110202974=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110202975=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT;'
      
        '110202976=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT_RESERVE;'
      '110202977=BEGIN'
      '110202978=  PNT_ = '#39'00'#39';'
      '110202979=  ERR_CODE = 0;'
      '110202980=  ERR_MSG = '#39#39';'
      '110202981=  ERR_BODY = '#39#39';'
      '110202982='
      '110202983=  FOR SELECT L.ID,'
      '110202984=             L.SQLSTMT'
      '110202985=        FROM LOGS L'
      '110202986=       WHERE L.USR = '#39'REPLICAT'#39
      '110202987=         AND L.DAT IS NULL'
      '110202988=         AND L.IS_TRANSFERED = 0'
      '110202989=        ORDER BY L.ID_ORIGINAL'
      '110202990=        INTO :LOGS_ID_,'
      '110202991=             :SQL_'
      '110202992=  DO BEGIN'
      '110202993=    BEGIN'
      '110202994=        SQLCODE_ = 0;'
      '110202995='
      
        '110202996=        -- '#1057#1054#1041#1048#1056#1040#1070' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1057 +
        #1063#1048#1058#1067#1042#1040#1058#1068
      
        '110202997=        IF (POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN SQL_) > 0)' +
        ' THEN BEGIN'
      
        '110202998=          ID_STR_ = SUBSTRING(SQL_ FROM 18 FOR CHAR_LE' +
        'NGTH(SQL_) - 17);'
      '110202999='
      
        '1102021000=          IF (POSITION(ID_STR_ IN PRODUCT_ID_ARR_) = ' +
        '0) THEN'
      
        '1102021001=            PRODUCT_ID_ARR_ = PRODUCT_ID_ARR_ || '#39'~'#39' ' +
        '|| ID_STR_;'
      '1102021002=        END'
      '1102021003=        ELSE BEGIN'
      '1102021004=            EXECUTE STATEMENT SQL_;'
      '1102021005='
      
        '1102021006=            IF (POSITION('#39'EXECUTE PROCEDURE K_RECALC_' +
        'KASSA'#39' IN SQL_) > 0) THEN BEGIN'
      '1102021007=              IF (ERR_CODE <> 0) THEN BEGIN'
      '1102021008=                SQLCODE_ = ERR_CODE;'
      '1102021009=                IF (ERR_BODY = '#39#39') THEN'
      
        '1102021010=                  ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084 +
        #1077#1085#1077#1085#1080#1081'.'#39';'
      '1102021011=                ERR_BODY = ERR_BODY ||'#39
      
        '1102021012=                '#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||ERR_CODE||'#39'. '#1044 +
        #1077#1090#1072#1083#1080': '#39'||ERR_MSG;'
      '1102021013='
      '1102021014=                ERR_CODE = 0;'
      '1102021015=                ERR_MSG = '#39#39';'
      '1102021016=              END'
      '1102021017=            END'
      '1102021018=        END'
      '1102021019='
      '1102021020=    WHEN ANY DO'
      '1102021021=        BEGIN'
      '1102021022=            SQLCODE_ = GDSCODE;'
      '1102021023=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102021024=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102021025=            ERR_BODY = ERR_BODY ||'#39
      '1102021026='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102021027=        END'
      '1102021028=    END'
      '1102021029='
      
        '1102021030=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102021031=    UPDATE LOGS L'
      
        '1102021032=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102021033=           L.ERR_CODE = :SQLCODE_'
      '1102021034=     WHERE L.ID = :LOGS_ID_;'
      '1102021035=  END'
      '1102021036='
      '1102021037=  POS_ = 0;'
      '1102021038=  FOR SELECT L.ID,'
      '1102021039=             L.SQLSTMT,'
      '1102021040=             L.DAT,'
      '1102021041=             L.RR'
      '1102021042=        FROM LOGS L'
      '1102021043=       WHERE L.USR = '#39'REPLICAT'#39
      '1102021044=         AND L.DAT IS NOT NULL'
      '1102021045=         AND L.IS_TRANSFERED = 0'
      '1102021046=        ORDER BY L.ID_ORIGINAL'
      '1102021047=        INTO :LOGS_ID_,'
      '1102021048=             :SQL_,'
      '1102021049=             :DAT_,'
      '1102021050=             :IDX_'
      '1102021051=  DO BEGIN'
      '1102021052=    POS_ = POSITION('#39'.'#39', SQL_);'
      '1102021053=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '1102021054=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR P' +
        'OS_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_' +
        ' - 1)||'#39' = :DAT_'#39'||'
      
        '1102021055=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ +' +
        ' 1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '1102021056='
      '1102021057=    BEGIN'
      '1102021058=        SQLCODE_ = 0;'
      '1102021059=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '1102021060=    WHEN ANY DO'
      '1102021061=        BEGIN'
      '1102021062=            SQLCODE_ = GDSCODE;'
      '1102021063=            ERR_BODY = ERR_BODY ||'#39
      '1102021064='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102021065=        END'
      '1102021066=    END'
      '1102021067='
      
        '1102021068=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1102021069='
      '1102021070=    UPDATE LOGS L'
      
        '1102021071=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1102021072=           L.ERR_CODE = :SQLCODE_'
      '1102021073=     WHERE L.ID = :LOGS_ID_;'
      '1102021074=  END'
      '1102021075='
      '1102021076='
      '1102021077=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      '1102021078=  POS_ = 1;'
      '1102021079=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '1102021080=    BEGIN'
      
        '1102021081=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ F' +
        'ROM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '1102021082='
      '1102021083=        WHILE (POS_ > 0) DO BEGIN'
      '1102021084=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '1102021085='
      '1102021086=            IF (POS_ > 0) THEN'
      
        '1102021087=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1' +
        ' FOR POS_ - 1);'
      '1102021088=            ELSE'
      '1102021089=              STR_ = PRODUCT_ID_ARR_;'
      '1102021090='
      
        '1102021091=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 F' +
        'OR POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '1102021092=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSI' +
        'TION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN ST' +
        'R_)) AS BIGINT);'
      '1102021093='
      
        '1102021094=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_' +
        'ARR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '1102021095='
      '1102021096=            select ('
      '1102021097=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '1102021098=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s, sklad_parent sp'
      '1102021099=                    where sp.SKLAD = s.SKLAD_PARENT'
      '1102021100=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '1102021101=                      and s.g_product = :G_PRODUCT_'
      
        '1102021102=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077 +
        ' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '1102021103='
      '1102021104=                   -'
      '1102021105=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102021106=                   (select COALESCE(sum(zr.AMOUNT_ALL' +
        '), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1102021107=                    where zr.g_product = :G_PRODUCT_ ' +
        'and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '1102021108=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZA' +
        'KAZ_REAL_PARENT)'
      '1102021109='
      '1102021110=                   -'
      '1102021111=                   -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '1102021112=                   (select COALESCE(sum(zd.amount), 0' +
        ') from zakaz_details zd, zakaz z'
      
        '1102021113=                    where zd.g_product = :G_PRODUCT_ ' +
        'and Z.G_TOCHKA = :G_TOCHKA_'
      '1102021114=                    and zd.zakaz = z.zakaz'
      
        '1102021115=                    and z.IS_RESERVE = 0      -- '#1085#1077' '#1074 +
        #1099#1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081 +
        #1076#1077#1090' '#1085#1080#1078#1077
      
        '1102021116=                    and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095 +
        #1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' ' +
        #1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1102021117=                    and not (z.IS_SPISANIE = 0 and z.' +
        'NOT_MINUS_OSTATOK = 1)'
      '1102021118=                   )'
      '1102021119='
      '1102021120=                   -'
      '1102021121=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '1102021122=                   (select COALESCE(sum(s.amount), 0)' +
        ' from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat =' +
        ' 3'
      '1102021123=                    and S.g_client = :G_TOCHKA_)'
      '1102021124='
      '1102021125=                   -'
      '1102021126=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '1102021127=                   (select COALESCE(sum(od.amount), 0' +
        ') from other_details od, other o'
      
        '1102021128=                    where od.g_product = :G_PRODUCT_ ' +
        'and o.G_TOCHKA = :G_TOCHKA_'
      '1102021129=                    and od.other = o.other)'
      '1102021130=                   ) amount,'
      '1102021131='
      
        '1102021132=                   (SELECT COALESCE(sum(ZD.amount), 0' +
        ') FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102021133=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AN' +
        'D Z.IS_RESERVE = 1'
      
        '1102021134=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.' +
        'G_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '1102021135=            from rdb$database'
      '1102021136=            INTO :AMOUNT_,'
      '1102021137=                 :AMOUNT_RESERVE_;'
      '1102021138='
      '1102021139=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '1102021140=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :' +
        'G_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '1102021141=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_' +
        'TOCHKA = CD.G_TOCHKA)'
      '1102021142=            WHEN MATCHED THEN'
      
        '1102021143=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.A' +
        'MOUNT_RESERVE = :AMOUNT_RESERVE_'
      '1102021144=            WHEN NOT MATCHED THEN'
      
        '1102021145=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, ' +
        'AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102021146=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, ' +
        ' 1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '1102021147=        END'
      '1102021148=    WHEN ANY DO'
      '1102021149=        BEGIN'
      '1102021150=            SQLCODE_ = GDSCODE;'
      '1102021151=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102021152=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086 +
        #1074'.'#39';'
      '1102021153=            ERR_BODY = ERR_BODY ||'#39
      
        '1102021154=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE' +
        ';'
      '1102021155=        END'
      '1102021156=    END'
      '1102021157=  END'
      '1102021158=END'
      '1102021159=;'
      '1102021160='
      '1102021161=ALTER PROCEDURE SYNC_UPLOAD('
      '1102021162=  SYNC_COMPS_ TYPE OF COLUMN SYNC_COMPS.SYNC_COMPS)'
      '1102021163=RETURNS ('
      '1102021164=  ID TYPE OF COLUMN LOGS.ID,'
      '1102021165=  SQLSTMT TYPE OF COLUMN LOGS.SQLSTMT,'
      '1102021166=  TTABLE TYPE OF COLUMN LOGS.TTABLE,'
      '1102021167=  USR TYPE OF COLUMN LOGS.USR,'
      '1102021168=  RR TYPE OF COLUMN LOGS.RR,'
      '1102021169=  DAT TYPE OF COLUMN LOGS.DAT)'
      '1102021170=AS'
      '1102021171=/*'
      '1102021172=*/'
      
        '1102021173=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_UPLOAD'#39 +
        ';'
      '1102021174=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102021175=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '1102021176=BEGIN'
      '1102021177=  FOR SELECT ID, SQLSTMT, TTABLE, USR, RR, DAT'
      '1102021178=      FROM LOGS'
      '1102021179=      WHERE IS_TRANSFERED = 0'
      '1102021180=        AND USR <> '#39'REPLICAT'#39
      '1102021181=      ORDER BY ID'
      '1102021182=      INTO :ID, :SQLSTMT, :TTABLE, :USR, :RR, :DAT'
      '1102021183=  DO BEGIN'
      '1102021184=    UPDATE LOGS L'
      '1102021185=       SET L.IS_TRANSFERED = 1'
      '1102021186=     WHERE L.ID = :ID;'
      '1102021187='
      '1102021188=    SUSPEND;'
      '1102021189=  END'
      '1102021190=end'
      '1102021191=;'
      '1102021192='
      '1102021193='
      
        '1102021194=UPDATE SYSTEM_SETUP SET S_VALUE = 110202 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102021195=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102021196=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1102030=UPDATE SYSTEM_SETUP SET S_VALUE = 110203 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1102031=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1102032=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102040='
      '1102041=ALTER PROCEDURE FILL_FIRST_DATA('
      '1102042=  PRODUCTY_ INTEGER = 0,'
      '1102043=  HIM_ INTEGER = 0,'
      '1102044=  APTEKA_ INTEGER = 0)'
      '1102045=AS'
      '1102046=BEGIN'
      '1102047=  IF (PRODUCTY_ = 1 OR HIM_ = 1) THEN BEGIN'
      '1102048=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '1102049=      VALUES (2, '#39#1073#1091#1090'.'#39', '#39#1073#1091#1090'.'#39');'
      '11020410=  END'
      '11020411='
      '11020412=  IF (APTEKA_ = 1) THEN BEGIN'
      '11020413='
      '11020414=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020415=      VALUES (3, '#39#1082#1075#39', '#39#1082#1075#39');'
      '11020416=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020417=      VALUES (5, '#39#1091#1087#1072#1082'.'#39', '#39#1091#1087#1072#1082'.'#39');'
      '11020418=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020419=      VALUES (6, '#39#1092#1083#1072#1082'.'#39', '#39#1092#1083#1072#1082'.'#39');'
      '11020420=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020421=      VALUES (7, '#39#1087#1086#1076#1075#1091#1079'.'#39', '#39#1087#1086#1076#1075#1091#1079'.'#39');'
      '11020422=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020423=      VALUES (8, '#39#1087#1083#1072#1089#1090'.'#39', '#39#1087#1083#1072#1089#1090'.'#39');'
      '11020424=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020425=      VALUES (9, '#39#1087#1072#1082'.'#39', '#39#1087#1072#1082'.'#39');'
      '11020426=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020427=      VALUES (10, '#39#1090#1072#1073'.'#39', '#39#1090#1072#1073'.'#39');'
      '11020428=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020429=      VALUES (11, '#39#1072#1084#1087'.'#39', '#39#1072#1084#1087'.'#39');'
      '11020430=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020431=      VALUES (12, '#39#1082#1086#1088'.'#39', '#39#1082#1086#1088'.'#39');'
      '11020432=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020433=      VALUES (13, '#39#1090#1091#1073#1072#39', '#39#1090#1091#1073#1072#39');'
      '11020434=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020435=      VALUES (14, '#39#1087#1072#1088'.'#39', '#39#1087#1072#1088'.'#39');'
      '11020436=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020437=      VALUES (15, '#39#1090#1085#1075'.'#39', '#39#1090#1085#1075'.'#39');'
      '11020438=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020439=      VALUES (16, '#39#1089#1072#1083#1092#1077#1090'.'#39', '#39#1089#1072#1083#1092#1077#1090'.'#39');'
      '11020440=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11020441=      VALUES (17, '#39#1053#1072#1073#1086#1088#39', '#39#1085#1072#1073#1086#1088#39');'
      '11020442=  END'
      '11020443='
      '11020444=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_UNIT TO 35'#39';'
      '11020445='
      '11020446=  IF (PRODUCTY_ = 1) THEN'
      
        '11020447=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE,'
      
        '11020448=                           VOLUME_PRICE, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLA' +
        'CE,'
      
        '11020449=                           SALES_COMM, IS_MARKED, IS_WE' +
        'IGHT)'
      
        '11020450=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLAT' +
        'UR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '11020451=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, IS' +
        '_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM, 0, 0'
      '11020452=      FROM G_PRODUCT_FILL T'
      '11020453=     WHERE T.G_PRODUCT BETWEEN 0 AND 40000'
      '11020454=    ORDER BY 1;'
      '11020455='
      '11020456=  IF (HIM_ = 1) THEN'
      
        '11020457=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE,'
      
        '11020458=                           VOLUME_PRICE, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLA' +
        'CE,'
      
        '11020459=                           SALES_COMM, IS_MARKED, IS_WE' +
        'IGHT)'
      
        '11020460=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLAT' +
        'UR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '11020461=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, IS' +
        '_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM, 0, 0'
      '11020462=      FROM G_PRODUCT_FILL T'
      '11020463=     WHERE T.G_PRODUCT BETWEEN 40000 AND 50000'
      '11020464=    ORDER BY 1;'
      '11020465='
      '11020466=  IF (APTEKA_ = 1) THEN'
      
        '11020467=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE,'
      
        '11020468=                           VOLUME_PRICE, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLA' +
        'CE,'
      
        '11020469=                           SALES_COMM, IS_MARKED, IS_WE' +
        'IGHT)'
      
        '11020470=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLAT' +
        'UR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '11020471=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, IS' +
        '_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM, 0, 0'
      '11020472=      FROM G_PRODUCT_FILL T'
      '11020473=     WHERE T.G_PRODUCT BETWEEN 53051 AND 70000'
      '11020474=    ORDER BY 1;'
      '11020475='
      
        '11020476=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_PRODUCT TO 700' +
        '01'#39';'
      
        '11020477=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_ARTICUL TO 40000' +
        #39';'
      '11020478=END'
      '11020479=;'
      '11020480='
      '11020481=ALTER PROCEDURE G_INS_G_DISCOUNT('
      
        '11020482=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11020483=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      '11020484=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '11020485=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '11020486=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '11020487=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '11020488=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '11020489=  G_TOCHKA_ BLOB SUB_TYPE 1)'
      '11020490=RETURNS ('
      '11020491=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '11020492=  ERR_CODE INTEGER,'
      '11020493=  ERR_MSG VARCHAR(1024))'
      '11020494=AS'
      '11020495=DECLARE VARIABLE CNT_ INTEGER;'
      
        '11020496=DECLARE VARIABLE G_PRODUCT_REC_ TYPE OF COLUMN G_DISCOU' +
        'NT.G_PRODUCT;'
      
        '11020497=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_DISCOUNT.G' +
        '_PRODUCT;'
      
        '11020498=DECLARE VARIABLE SKIDKA_PROC_R_ TYPE OF COLUMN G_DISCOU' +
        'NT.SKIDKA_PROC; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      
        '11020499=DECLARE VARIABLE SKIDKA_SUM_R_ TYPE OF COLUMN G_DISCOUN' +
        'T.SKIDKA_SUM; /* '#1044#1051#1071' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' */'
      
        '110204100=DECLARE VARIABLE G_TOCHKA_ID_ TYPE OF COLUMN G_TOCHKA.' +
        'G_TOCHKA;'
      
        '110204101=DECLARE VARIABLE IS_CONST_ TYPE OF COLUMN G_DISCOUNT.I' +
        'S_CONST = 0;'
      '110204102=BEGIN'
      '110204103='
      '110204104=    FOR SELECT NULL G_TOCHKA'
      '110204105=          FROM RDB$DATABASE'
      '110204106=         WHERE :G_TOCHKA_ IS NULL'
      '110204107=        UNION ALL'
      '110204108=        SELECT G.G_TOCHKA'
      '110204109=          FROM G_TOCHKA G'
      
        '110204110=         WHERE :G_TOCHKA_ CONTAINING '#39'~'#39'||G.G_TOCHKA||' +
        #39'~'#39
      '110204111=        ORDER BY 1'
      '110204112=          INTO :G_TOCHKA_ID_'
      '110204113=    DO BEGIN'
      '110204114=            FOR SELECT G.G_PRODUCT,'
      '110204115=                       G.PRICE'
      '110204116=                  FROM G_PRODUCT G'
      
        '110204117=                 WHERE G.G_PRODUCT_PAR = DECODE(:G_PRO' +
        'DUCT_PAR_, -1, G.G_PRODUCT_PAR, :G_PRODUCT_PAR_)'
      
        '110204118=                   AND G.G_PRODUCT = COALESCE(:G_PRODU' +
        'CT_, G.G_PRODUCT)'
      '110204119=                   AND G.IS_ACTIVE = 1'
      '110204120=                   AND G.IS_CATEGORY = 0'
      '110204121=                   AND G.PRICE > 0'
      '110204122=                  INTO :G_PRODUCT_REC_,'
      '110204123=                       :PRICE_REC_'
      '110204124=            DO BEGIN'
      
        '110204125=                -- '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1045#1050#1059#1065#1040#1071' '#1057#1050#1048#1044#1050#1040' '#1048' '#1048#1044#1045#1058' '#1043#1056#1059 +
        #1055#1055#1054#1042#1054#1045' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1045' '#1057#1050#1048#1044#1050#1048', '#1058#1054' '#1040#1042#1058#1054#1052#1040#1058#1054#1052' '#1059#1041#1048#1056#1040#1070' '#1057#1050#1048#1044#1050#1059', '#1048' '#1047#1040#1052#1045#1053#1071#1070' ' +
        #1053#1054#1042#1054#1049
      
        '110204126=                -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1054#1044#1048#1053#1054#1063#1053#1054#1045' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1045', '#1058'.'#1045 +
        '. '#1055#1054' '#1050#1054#1053#1050#1056#1045#1058#1053#1054#1052#1059' '#1058#1054#1042#1040#1056#1059', '#1058#1054' '#1054#1064#1048#1041#1050#1040
      '110204127=                if (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110204128=                  DELETE FROM G_DISCOUNT'
      
        '110204129=                   WHERE COALESCE(DATE_BEGIN, CURRENT_' +
        'DATE) <= CURRENT_DATE AND COALESCE(DATE_END, CURRENT_DATE) >= CU' +
        'RRENT_DATE'
      '110204130=                     AND G_PRODUCT = :G_PRODUCT_REC_'
      '110204131=                     AND G_TOCHKA = :G_TOCHKA_ID_;'
      '110204132=                ELSE BEGIN'
      '110204133=                    SELECT COUNT(*)'
      '110204134=                      FROM G_DISCOUNT'
      '110204135=                     WHERE G_PRODUCT = :G_PRODUCT_REC_'
      
        '110204136=                       AND COALESCE(DATE_BEGIN, CURREN' +
        'T_DATE) <= CURRENT_DATE'
      
        '110204137=                       AND COALESCE(DATE_END, CURRENT_' +
        'DATE) >= CURRENT_DATE'
      
        '110204138=                       AND ((G_TOCHKA = COALESCE(:G_TO' +
        'CHKA_ID_, 0))'
      '110204139=                            OR'
      
        '110204140=                            (G_TOCHKA IS NOT NULL AND ' +
        ':G_TOCHKA_ID_ IS NULL)'
      '110204141=                            OR'
      '110204142=                            (G_TOCHKA IS NULL)'
      '110204143=                           )'
      '110204144=                      INTO CNT_;'
      '110204145='
      '110204146=                    IF (CNT_ <> 0) THEN BEGIN'
      '110204147=                      ERR_CODE = -20500;'
      
        '110204148=                      EXECUTE PROCEDURE GET_ERR_MSG(ER' +
        'R_CODE, '#39#1053#1072' '#1076#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072'!'#39') RETURNIN' +
        'G_VALUES (:ERR_MSG);'
      '110204149=                      EXIT;'
      '110204150=                    END'
      '110204151=                END'
      '110204152='
      
        '110204153=                -- '#1055#1056#1048' '#1043#1056#1059#1055#1055#1054#1042#1067#1061' '#1044#1054#1041#1040#1042#1051#1045#1053#1048#1071' '#1044#1048#1057#1050#1054#1053#1058#1054#1042' ' +
        #1055#1054#1051#1059#1063#1040#1045#1058#1057#1071' '#1063#1058#1054' '#1054#1044#1053#1054' '#1048#1047' '#1055#1054#1051#1045#1049' - '#1055#1059#1057#1058#1054#1045
      '110204154=                SKIDKA_PROC_R_ = SKIDKA_PROC_;'
      '110204155=                SKIDKA_SUM_R_  = SKIDKA_SUM_;'
      '110204156=                IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '110204157=                  IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '110204158=                    SKIDKA_PROC_R_ = ROUND(SKIDKA_SUM_' +
        ' * 100 / PRICE_REC_ , 2);'
      '110204159=                  IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '110204160=                    SKIDKA_SUM_R_ = ROUND(PRICE_REC_ *' +
        ' SKIDKA_PROC_ / 100 , 2);'
      '110204161=                END'
      '110204162='
      
        '110204163=                IF (DATE_BEGIN_ IS NULL AND DATE_END_ ' +
        'IS NULL) THEN'
      '110204164=                  IS_CONST_ = 1;'
      '110204165='
      
        '110204166=                INSERT INTO G_DISCOUNT (G_DISCOUNT, G_' +
        'PRODUCT, DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA_' +
        'SUM, G_TOCHKA, IS_CONST)'
      
        '110204167=                VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G_' +
        'PRODUCT_REC_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :SK' +
        'IDKA_PROC_R_, :SKIDKA_SUM_R_'
      '110204168=                        ,:G_TOCHKA_ID_, :IS_CONST_)'
      '110204169=                RETURNING G_DISCOUNT'
      '110204170=                INTO :G_DISCOUNT_;'
      '110204171=            END'
      '110204172=    END'
      '110204173=end'
      '110204174=;'
      '110204175='
      '110204176=ALTER PROCEDURE G_UPD_G_DISCOUNT('
      '110204177=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT,'
      '110204178=  G_PRODUCT_ TYPE OF COLUMN G_DISCOUNT.G_PRODUCT,'
      
        '110204179=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110204180=  DATE_BEGIN_ TYPE OF COLUMN G_DISCOUNT.DATE_BEGIN,'
      '110204181=  DATE_END_ TYPE OF COLUMN G_DISCOUNT.DATE_END,'
      '110204182=  NAME_ TYPE OF COLUMN G_DISCOUNT.NAME,'
      '110204183=  PRICE_ TYPE OF COLUMN G_DISCOUNT.PRICE,'
      '110204184=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '110204185=  SKIDKA_SUM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '110204186=  G_TOCHKA_ BLOB SUB_TYPE 1)'
      '110204187=RETURNS ('
      '110204188=  ERR_CODE INTEGER,'
      '110204189=  ERR_MSG VARCHAR(1024))'
      '110204190=AS'
      '110204191=/*'
      
        '110204192='#1059#1044#1040#1051#1071#1070' '#1058#1045#1050#1059#1065#1059#1070' '#1040#1050#1062#1048#1070' '#1048' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1067#1045', '#1045#1057#1051#1048' '#1044#1054' '#1056#1045#1044#1040#1050#1058#1048#1056#1054 +
        #1042#1040#1053#1048#1071':'
      
        '110204193=1) '#1040#1050#1062#1048#1071' '#1056#1040#1057#1055#1056#1054#1057#1058#1056#1040#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1054#1044#1053#1059' '#1058#1054#1063#1050#1059', '#1040' '#1055#1054#1057#1051#1045' '#1057#1058#1040#1051#1040 +
        ' '#1053#1040' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      
        '110204194=2) '#1040#1050#1062#1048#1071' '#1056#1040#1057#1055#1056#1054#1057#1058#1056#1040#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1042#1057#1045' '#1058#1054#1063#1050#1048' ('#1058'.'#1045'. '#1041#1067#1051#1040' '#1054#1044#1053#1040 +
        ' '#1047#1040#1055#1048#1057#1068' '#1057' G_TOCHKA = NULL), '#1040' '#1047#1040#1058#1045#1052' '#1057#1058#1040#1051#1040' '#1053#1045' '#1053#1040' '#1042#1057#1045' '#1058#1054#1063#1050#1048
      '110204195=*/'
      '110204196=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110204197=DECLARE VARIABLE PRICE_REC_ TYPE OF COLUMN G_PRODUCT.P' +
        'RICE;'
      
        '110204198=DECLARE VARIABLE G_TOCHKA_ID_ TYPE OF COLUMN G_TOCHKA.' +
        'G_TOCHKA;'
      '110204199=DECLARE VARIABLE POSITION_ INTEGER;'
      
        '110204200=DECLARE VARIABLE IS_CONST_ TYPE OF COLUMN G_DISCOUNT.I' +
        'S_CONST = 0;'
      '110204201=BEGIN'
      
        '110204202=    -- '#1058#1040#1050#1048#1052' '#1054#1041#1056#1040#1047#1054#1052' '#1071' '#1059#1047#1053#1040#1070' '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1063#1045#1050' '#1055#1056#1048#1057#1051#1040#1051#1048' '#1057' ' +
        #1045#1050#1047#1045#1064#1053#1048#1050#1040
      
        '110204203=    SELECT POSITION('#39'~'#39', :G_TOCHKA_, POSITION('#39'~'#39', :G_' +
        'TOCHKA_, POSITION('#39'~'#39', :G_TOCHKA_)+1)+1)'
      '110204204=      FROM rdb$DATABASE'
      '110204205=      INTO :POSITION_;'
      '110204206='
      '110204207=    IF (POSITION_ > 0 OR G_TOCHKA_ IS NULL) THEN'
      
        '110204208=      DELETE FROM G_DISCOUNT G WHERE G.G_DISCOUNT = :G' +
        '_DISCOUNT_;'
      '110204209='
      '110204210=    FOR SELECT NULL G_TOCHKA'
      '110204211=          FROM RDB$DATABASE'
      '110204212=         WHERE :G_TOCHKA_ IS NULL'
      '110204213=        UNION ALL'
      '110204214=        SELECT G.G_TOCHKA'
      '110204215=          FROM G_TOCHKA G'
      
        '110204216=         WHERE :G_TOCHKA_ CONTAINING '#39'~'#39'||G.G_TOCHKA||' +
        #39'~'#39
      '110204217=        ORDER BY 1'
      '110204218=          INTO :G_TOCHKA_ID_'
      '110204219=    DO BEGIN'
      '110204220=        SELECT COUNT(*)'
      '110204221=          FROM G_DISCOUNT'
      '110204222=         WHERE G_PRODUCT = :G_PRODUCT_'
      
        '110204223=           AND COALESCE(DATE_BEGIN, CURRENT_DATE) <= C' +
        'URRENT_DATE'
      
        '110204224=           AND COALESCE(DATE_END, CURRENT_DATE) >= CUR' +
        'RENT_DATE'
      '110204225=           AND G_DISCOUNT <> :G_DISCOUNT_'
      
        '110204226=           AND ((G_TOCHKA = COALESCE(:G_TOCHKA_ID_, 0)' +
        ')'
      '110204227=                OR'
      
        '110204228=                (G_TOCHKA IS NOT NULL AND :G_TOCHKA_ID' +
        '_ IS NULL)'
      '110204229=                OR'
      '110204230=                (G_TOCHKA IS NULL)'
      '110204231=               )'
      '110204232=          INTO CNT_;'
      '110204233='
      '110204234=        IF (CNT_ <> 0) THEN BEGIN'
      '110204235=          ERR_CODE = -20500;'
      
        '110204236=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1072' ' +
        #1076#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088' '#1091#1078#1077' '#1077#1089#1090#1100' '#1076#1077#1081#1089#1090#1074#1091#1102#1097#1072#1103' '#1089#1082#1080#1076#1082#1072' '#1085#1072' '#1076#1072#1085#1085#1086#1081' '#1090#1086#1088#1075#1086#1074#1086#1081' '#1090#1086#1095#1082 +
        #1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110204237=          EXIT;'
      '110204238=        END'
      '110204239='
      '110204240=        PRICE_REC_ = PRICE_;'
      
        '110204241=        IF (SKIDKA_PROC_ IS NULL OR SKIDKA_SUM_ IS NUL' +
        'L) THEN BEGIN'
      '110204242=          SELECT G.PRICE'
      '110204243=            FROM G_PRODUCT G'
      '110204244=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110204245=            INTO :PRICE_REC_;'
      '110204246='
      '110204247=          IF (SKIDKA_PROC_ IS NULL) THEN'
      
        '110204248=            SKIDKA_PROC_ = ROUND(SKIDKA_SUM_ * 100 / P' +
        'RICE_REC_ , 2);'
      '110204249=          IF (SKIDKA_SUM_ IS NULL) THEN'
      
        '110204250=            SKIDKA_SUM_ = ROUND(PRICE_REC_ * SKIDKA_PR' +
        'OC_ / 100 , 2);'
      '110204251=        END'
      '110204252='
      
        '110204253=        IF (DATE_BEGIN_ IS NULL AND DATE_END_ IS NULL)' +
        ' THEN'
      '110204254=           IS_CONST_ = 1;'
      '110204255='
      
        '110204256=        -- '#1045#1057#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1058#1056#1054#1050' '#1053#1045' '#1055#1054#1052#1045#1053#1071#1051#1054#1057#1068' '#1044#1054' '#1048' '#1055#1054 +
        #1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071
      '110204257=        IF (POSITION_ = 0) THEN'
      '110204258=            UPDATE G_DISCOUNT'
      '110204259=            SET G_PRODUCT = :G_PRODUCT_,'
      '110204260=                DATE_BEGIN = :DATE_BEGIN_,'
      '110204261=                DATE_END = :DATE_END_,'
      '110204262=                NAME = :NAME_,'
      '110204263=                PRICE = :PRICE_REC_,'
      '110204264=                SKIDKA_PROC = :SKIDKA_PROC_,'
      '110204265=                SKIDKA_SUM = :SKIDKA_SUM_,'
      '110204266=                G_TOCHKA = :G_TOCHKA_ID_,'
      '110204267=                IS_CONST = :IS_CONST_'
      '110204268=            WHERE (G_DISCOUNT = :G_DISCOUNT_);'
      '110204269='
      
        '110204270=        -- '#1045#1057#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1058#1056#1054#1050' '#1055#1054#1052#1045#1053#1071#1051#1054#1057#1068' '#1044#1054' '#1048' '#1055#1054#1057#1051#1045 +
        ' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071
      '110204271=        ELSE'
      
        '110204272=            INSERT INTO G_DISCOUNT (G_DISCOUNT, G_PROD' +
        'UCT, DATE_BEGIN, DATE_END, NAME, PRICE, SKIDKA_PROC, SKIDKA_SUM,' +
        ' G_TOCHKA, IS_CONST)'
      
        '110204273=            VALUES (GEN_ID(GEN_G_DISCOUNT, 1), :G_PROD' +
        'UCT_, :DATE_BEGIN_, :DATE_END_, :NAME_, :PRICE_REC_, :SKIDKA_PRO' +
        'C_, :SKIDKA_SUM_'
      '110204274=                    ,:G_TOCHKA_ID_, :IS_CONST_);'
      '110204275=    END'
      '110204276=END'
      '110204277=;'
      '110204278='
      '110204279=ALTER PROCEDURE GET_SYS_PARAM_COUNT('
      '110204280=  MODE_ INTEGER,'
      '110204281=  PARAM1_ INTEGER)'
      '110204282=RETURNS ('
      '110204283=  PARAM1_OUT_ DM_BIGINT,'
      '110204284=  PARAM2_OUT_ DM_BIGINT,'
      '110204285=  PARAM1_STR_OUT_ VARCHAR(50),'
      '110204286=  PARAM2_STR_OUT_ VARCHAR(50))'
      '110204287=AS'
      '110204288=/*'
      '110204289='#1045#1057#1051#1048' MODE_ = 0'
      
        '110204290='#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1055#1056#1048' '#1047#1040#1055#1059#1057#1050#1045' '#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071', '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045 +
        #1049' '#1041#1054#1051#1068#1064#1045' '#1054#1044#1053#1054#1043#1054','
      
        '110204291='#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043#1054' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054#1043#1044#1040' '#1042#1067#1044 +
        #1040#1042#1040#1058#1068' '#1054#1050#1053#1054' '#1057' '#1042#1067#1041#1054#1056#1054#1052' '#1051#1054#1043#1048#1053#1040'/'#1055#1040#1056#1054#1051#1071'.'
      
        '110204292='#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1045#1049' '#1053#1045#1058', '#1048#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1054#1044#1048#1053' '#1048' '#1059' '#1053#1045#1043#1054 +
        ' '#1053#1045' '#1047#1040#1044#1040#1053' '#1055#1040#1056#1054#1051#1068', '#1058#1054' '#1054#1050#1053#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      '110204293='
      '110204294='#1045#1057#1051#1048' MODE_ = 1'
      
        '110204295='#1055#1056#1054#1042#1045#1056#1071#1045#1058#1057#1071' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1050#1051#1040#1044#1054#1042' '#1048' '#1042#1067#1044#1040#1045#1058#1057#1071' '#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052#1054 +
        #1051#1063#1040#1053#1048#1070'.'
      
        '110204296='#1057#1050#1051#1040#1044' '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1048#1065#1059' '#1055#1054' '#1070#1047#1045#1056#1059', '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1046#1059', '#1058#1054' '#1057#1058 +
        #1040#1042#1051#1070' '#1057#1050#1051#1040#1044' 1'
      '110204297=*/'
      '110204298=BEGIN'
      '110204299='
      '110204300=  IF (MODE_ = 0) THEN BEGIN'
      '110204301=      SELECT COUNT(*)'
      '110204302=        FROM G_OFFICIAL G'
      '110204303=       WHERE G.G_OFFICIAL > 0'
      '110204304=         AND G.IS_ACTIVE = 1'
      '110204305=        INTO :PARAM1_OUT_;'
      '110204306='
      '110204307=      if (PARAM1_OUT_ = 1) then'
      '110204308=        SELECT G.PASS'
      '110204309=          FROM G_OFFICIAL G'
      '110204310=       WHERE G.G_OFFICIAL > 0'
      '110204311=         AND G.IS_ACTIVE = 1'
      '110204312=          INTO :PARAM1_STR_OUT_;'
      '110204313='
      '110204314=  END ELSE BEGIN'
      '110204315=    SELECT COUNT(*)'
      '110204316=      FROM G_TOCHKA G'
      '110204317=      INTO :PARAM1_OUT_;'
      '110204318='
      '110204319=    IF (PARAM1_OUT_ > 1) THEN BEGIN'
      '110204320=      SELECT G.G_TOCHKA'
      '110204321=        FROM G_OFFICIAL G'
      
        '110204322=       WHERE G.G_OFFICIAL = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 1)'
      '110204323=        INTO :PARAM2_OUT_;'
      '110204324='
      '110204325=      if (COALESCE(PARAM2_OUT_, 0)  = 0) then'
      '110204326=        PARAM2_OUT_ = 1;'
      '110204327=    END'
      '110204328=  END'
      '110204329=END'
      '110204330=;'
      '110204331='
      '110204332='
      
        '110204333=UPDATE SYSTEM_SETUP SET S_VALUE = 110204 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110204334=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110204335=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102050='
      '1102051=CREATE PROCEDURE P_REP_CLIENT_ORDER('
      '1102052=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1102053=  CURRENCY_ INTEGER,'
      
        '1102054=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT,'
      
        '1102055=  G_FIRM_REKVIZIT_ /* TYPE OF COLUMN G_FIRM_REKVIZIT.G_F' +
        'IRM_REKVIZIT */ BIGINT,'
      
        '1102056=  G_FIRM_ADDRESS_ /* TYPE OF COLUMN G_FIRM_ADDRESS.G_ADD' +
        'RESS */ BIGINT)'
      '1102057=RETURNS ('
      '1102058=  NUM_ VARCHAR(50),'
      '1102059=  CLIENT_INFO_ VARCHAR(300),'
      '11020510=  COMPANY_INFO_ VARCHAR(1000),'
      
        '11020511=  G_OFFICIAL_FM_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC *' +
        '/ VARCHAR(150),'
      '11020512=  VSEGO_NAIM_ VARCHAR(500),'
      '11020513=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '11020514=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMER' +
        'IC(15,2),'
      '11020515=  DOLG_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      '11020516=  ROW_NUM INTEGER,'
      
        '11020517=  BRAND /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(15' +
        '0),'
      
        '11020518=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '11020519=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11020520=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11020521=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      
        '11020522=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.SHORT_NAME */ VAR' +
        'CHAR(10),'
      
        '11020523=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUME' +
        'RIC(18,5),'
      
        '11020524=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERI' +
        'C(15,2),'
      
        '11020525=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      '11020526=  ERR_CODE INTEGER,'
      '11020527=  ERR_MSG VARCHAR(1024))'
      '11020528=AS'
      '11020529=BEGIN'
      '11020530=  SUSPEND;'
      '11020531=END'
      '11020532=;'
      '11020533='
      '11020534='
      
        '11020535=/******************************************************' +
        '************************/'
      
        '11020536=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11020537=/******************************************************' +
        '************************/'
      '11020538=ALTER PROCEDURE P_REP_CLIENT_ORDER('
      '11020539=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11020540=  CURRENCY_ INTEGER,'
      '11020541=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      
        '11020542=  G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM_REKVIZIT.G_FIR' +
        'M_REKVIZIT,'
      
        '11020543=  G_FIRM_ADDRESS_ TYPE OF COLUMN G_FIRM_ADDRESS.G_ADDRE' +
        'SS)'
      '11020544=RETURNS ('
      '11020545=  NUM_ VARCHAR(50),'
      '11020546=  CLIENT_INFO_ VARCHAR(300),'
      '11020547=  COMPANY_INFO_ VARCHAR(1000),'
      '11020548=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11020549=  VSEGO_NAIM_ VARCHAR(500),'
      '11020550=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11020551=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11020552=  DOLG_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11020553=  ROW_NUM INTEGER,'
      '11020554=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11020555=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '11020556=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11020557=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11020558=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11020559=  SHORT_NAME TYPE OF COLUMN G_UNIT.SHORT_NAME,'
      '11020560=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11020561=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11020562=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '11020563=  ERR_CODE INTEGER,'
      '11020564=  ERR_MSG VARCHAR(1024))'
      '11020565=AS'
      
        '11020566=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_CLIENT_O' +
        'RDER'#39';'
      '11020567=DECLARE VARIABLE I INTEGER;'
      '11020568=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      '11020569=DECLARE VARIABLE VSEGO_K_OPLATE_ VARCHAR(500);'
      '11020570=DECLARE VARIABLE VAL_STR_ VARCHAR(20);'
      '11020571=BEGIN'
      '11020572='
      
        '11020573=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39'||lpad(EXTRACT(D' +
        'AY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DAT' +
        'E), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE),'
      '11020574=         C.NAME||'#39
      
        '11020575='#1058#1077#1083'.: '#39'||(CASE WHEN C.PHONE IS NULL THEN '#39#39' ELSE C.PHON' +
        'E END),'
      '11020576=         (SELECT CURR_STR from CURRENCYSTR(Z.SUMM, 0)),'
      '11020577=         Z.SUMM,'
      '11020578=         Z.SUMM_FACT + Z.SUMM_BONUS,'
      '11020579=         Z.SUMM - (Z.SUMM_FACT + Z.SUMM_BONUS)'
      '11020580=    FROM ZAKAZ Z,'
      '11020581=         G_CLIENT C'
      '11020582=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11020583=     AND Z.G_CLIENT = C.G_CLIENT'
      '11020584=    INTO :NUM_,'
      '11020585=         :CLIENT_INFO_,'
      '11020586=         :VSEGO_K_OPLATE_,'
      '11020587=         :SUMM_,'
      '11020588=         :SUMM_FACT_,'
      '11020589=         :DOLG_;'
      '11020590='
      
        '11020591=    SELECT F.NAME||'#39', '#39'||DECODE(F.IP_OR_JUR, 0, '#39#1048#1048#1053#39', ' +
        #39#1041#1048#1053#39')||'#39' '#39'||F.IDN||'#39
      '11020592='#39
      '11020593=      FROM G_FIRM_REKVIZIT F'
      
        '11020594=     WHERE ((F.IS_DEFAULT = 1 AND :G_FIRM_REKVIZIT_ IS ' +
        'NULL)'
      '11020595=            OR'
      
        '11020596=            (F.G_FIRM_REKVIZIT = :G_FIRM_REKVIZIT_ AND ' +
        ':G_FIRM_REKVIZIT_ IS NOT NULL)'
      '11020597=           )'
      '11020598=      INTO :COMPANY_INFO_;'
      '11020599='
      '110205100=    SELECT :COMPANY_INFO_ || '#39#1040#1076#1088#1077#1089': '#39'||G.ADDRESS||'#39
      
        '110205101='#1058#1077#1083'.:'#39'||(CASE WHEN G.PHONE IS NULL THEN '#39#39' ELSE G.PHON' +
        'E END)'
      '110205102=      FROM G_FIRM_ADDRESS G'
      
        '110205103=     WHERE ((G.IS_DEFAULT = 1 AND :G_FIRM_ADDRESS_ IS ' +
        'NULL)'
      '110205104=            OR'
      
        '110205105=            (G.G_ADDRESS = :G_FIRM_ADDRESS_ AND :G_FIR' +
        'M_ADDRESS_ IS NOT NULL)'
      '110205106=           )'
      '110205107=      INTO :COMPANY_INFO_;'
      '110205108='
      
        '110205109=  -- '#1042#1054' '#1060#1056#1040#1047#1045' '#1042#1057#1045#1043#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1049' '#1045#1057#1058#1068' '#1042#1040#1051#1070#1058#1040', '#1055#1054#1069#1058#1054#1052#1059' ' +
        #1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1050#1051#1054#1053#1071#1058#1068
      '110205110=  if (CURRENCY_ = 0) then'
      '110205111=    CURR_STR_ = '#39' '#1090#1077#1085#1075#1077#39';'
      '110205112=  else begin'
      '110205113=      SELECT CAST(TRUNC(SUM(Z.SUMM)) AS VARCHAR(20))'
      '110205114=        FROM ZAKAZ Z'
      '110205115=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110205116=      INTO :VAL_STR_;'
      '110205117='
      
        '110205118=      i = cast(substring(VAL_STR_ from CHAR_LENGTH(VAL' +
        '_STR_) for 1) as int);'
      '110205119='
      '110205120=      if (i=1) then begin'
      '110205121=        if (CURRENCY_ = 1) then'
      '110205122=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1100#39';'
      '110205123=        else'
      '110205124=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1072#39';'
      '110205125='
      '110205126=      end ELSE if ((i=2) or (I=3)) then begin'
      '110205127=        if (CURRENCY_ = 1) then'
      '110205128=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1103#39';'
      '110205129=        ELSE'
      '110205130=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1099#39';'
      '110205131=      END ELSE BEGIN'
      '110205132=        if (CURRENCY_ = 1) then'
      '110205133=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1077#1081#39';'
      '110205134=        ELSE'
      '110205135=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1077#1085#39';'
      '110205136=      end'
      '110205137=  end'
      '110205138='
      
        '110205139=  SELECT '#39#1042#1089#1077#1075#1086' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1081' '#39'||COUNT(ZD.ZAKAZ_DETAILS' +
        ')||'#39', '#1085#1072' '#1089#1091#1084#1084#1091' '#39'||CAST(SUM(ZD.SUMM) AS VARCHAR(20))||:CURR_STR_|' +
        '|'
      '110205140=         '#39' ('#39'||:VSEGO_K_OPLATE_||'#39')'#39
      '110205141=    FROM ZAKAZ Z,'
      '110205142=         ZAKAZ_DETAILS ZD'
      '110205143=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110205144=     AND Z.ZAKAZ = ZD.ZAKAZ'
      '110205145=  INTO :VSEGO_NAIM_;'
      '110205146='
      
        '110205147=  -- '#1042' '#1048#1058#1054#1043#1045' '#1042' '#1045#1050#1057#1045#1051#1045' '#1042#1057#1045' '#1062#1048#1060#1056#1067' '#1042#1067#1042#1054#1044#1071#1058#1057#1071' '#1057' '#1044#1045#1057#1071#1058#1048#1063#1053#1067#1052 +
        ' '#1056#1040#1047#1044#1045#1051#1048#1058#1045#1051#1045#1052' '#1058#1054#1063#1050#1040', '#1040' '#1053#1045' '#1047#1040#1055#1071#1058#1040#1071'. '#1053#1045' '#1047#1053#1040#1051' '#1063#1058#1054' '#1055#1056#1048#1044#1059#1052#1040#1058#1068' '#1048' '#1055#1054#1058#1054#1052 +
        #1059' '#1055#1054#1057#1058#1040#1042#1048#1051' '#1058#1059#1058' '#1058#1059#1055#1054' '#1047#1040#1052#1045#1053#1059
      '110205148=  VSEGO_NAIM_ = REPLACE(VSEGO_NAIM_, '#39'.'#39', '#39','#39');'
      '110205149='
      
        '110205150=  SELECT DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FM||'#39' '#39 +
        '||GG.NM||'#39' '#39'||GG.FT, GG.FIO_DOC)'
      '110205151=    FROM G_OFFICIAL GG'
      '110205152=   WHERE GG.G_OFFICIAL = :G_OFFICIAL_'
      '110205153=    INTO :G_OFFICIAL_FM_;'
      '110205154='
      '110205155=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      '110205156=  I = 1;'
      '110205157=  FOR'
      '110205158=    SELECT :I,'
      '110205159=           G.BRAND,'
      '110205160=           G.NAME,'
      '110205161=           G.ARTICUL,'
      '110205162=           G.BARCODE,'
      '110205163=           G.NOMENCLATUR_NUM,'
      '110205164=           ZD.AMOUNT,'
      '110205165=           U.SHORT_NAME'
      '110205166=           ,ZD.PRICE - ZD.DISCOUNT_TENGE'
      '110205167=           ,ZD.SUMM'
      '110205168=      FROM ZAKAZ Z,'
      '110205169=           ZAKAZ_DETAILS ZD,'
      '110205170=           G_PRODUCT G,'
      '110205171=           G_UNIT U'
      '110205172=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110205173=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110205174=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110205175=       AND G.G_UNIT = U.G_UNIT'
      '110205176=   ORDER BY G.NAME, ZD.ZAKAZ_DETAILS'
      '110205177=    INTO :ROW_NUM,'
      '110205178=        :BRAND,'
      '110205179=        :NAME,'
      '110205180=        :ARTICUL,'
      '110205181=        :BARCODE,'
      '110205182=        :NOMENCLATUR_NUM,'
      '110205183=        :AMOUNT,'
      '110205184=        :SHORT_NAME'
      '110205185=        ,:PRICE'
      '110205186=        ,:SUMM'
      '110205187=  DO BEGIN'
      '110205188=    I = I + 1;'
      '110205189=    SUSPEND;'
      '110205190=  END'
      '110205191='
      '110205192=WHEN ANY DO BEGIN'
      '110205193=    ERR_CODE = GDSCODE;'
      
        '110205194=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110205195=  END'
      '110205196=end'
      '110205197=;'
      '110205198='
      '110205199='
      
        '110205200=UPDATE SYSTEM_SETUP SET S_VALUE = 110205 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110205201=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110205202=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102060='
      '1102061=ALTER PROCEDURE DEL_SKLAD('
      '1102062=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1102063=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1102064=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102065=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '1102066=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102067=RETURNS ('
      '1102068=  ERR_CODE INTEGER,'
      '1102069=  ERR_MSG VARCHAR(1024))'
      '11020610=AS'
      '11020611=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD'#39';'
      '11020612=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11020613=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11020614=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '11020615=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      '11020616=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11020617=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      
        '11020618=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11020619=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071')' +
        ' */'
      
        '11020620=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA.N' +
        'AME;'
      
        '11020621=DECLARE VARIABLE DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE' +
        '_RECEIPT;'
      
        '11020622=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11020623=DECLARE VARIABLE REC_ID_ TYPE OF COLUMN SKLAD_PARENT.RE' +
        'C_ID;'
      '11020624=BEGIN'
      '11020625='
      '11020626=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '11020627=    SELECT S_VALUE'
      '11020628=      FROM SYSTEM_SETUP'
      '11020629=     WHERE SYSTEM_SETUP = 2'
      '11020630=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11020631='
      '11020632=  SELECT SP.IS_VOZVRAT,'
      
        '11020633=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TOCH' +
        'KA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '11020634=         ,G.NAME'
      '11020635=         ,SP.DATE_RECEIPT'
      '11020636=         ,SP.SUMM'
      '11020637=         ,SP.REC_ID'
      '11020638=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '11020639=   WHERE SP.SKLAD = :SKLAD_'
      '11020640=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '11020641=    INTO :IS_VOZVRAT_,'
      '11020642=         :G_TOCHKA_'
      '11020643=         ,:TOCHKA_NAME_'
      '11020644=         ,:DATE_'
      '11020645=         ,:SUMM_'
      '11020646=         ,:REC_ID_;'
      '11020647='
      '11020648=  PNT_ = '#39'02'#39';'
      '11020649=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '11020650=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        ' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '11020651=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040#1045#1058 +
        ' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      
        '11020652=  -- 13.10.2021 '#1055#1054#1051#1059#1063#1048#1051#1040#1057#1068' '#1057#1048#1058#1059#1040#1062#1048#1071' '#1055#1056#1048' '#1059#1044#1040#1051#1045#1053#1048#1048' '#1043#1056#1059#1055#1055#1067 +
        ' '#1058#1054#1042#1040#1056#1054#1042', '#1048#1057#1063#1045#1047#1051#1048' ID-'#1064#1050#1048' '#1048#1047' LT_SKLAD_PRODUCT '#1048' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054
      
        '11020653=  -- '#1053#1040#1063#1040#1051#1040' '#1042#1054#1047#1053#1048#1050#1040#1058#1068' '#1054#1064#1048#1041#1050#1040', '#1063#1058#1054' '#1058#1054#1042#1040#1056#1054#1042' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040 +
        #1058#1045#1051#1068#1053#1054', '#1055#1054#1069#1058#1054#1052#1059' '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056#1040' '#1042' LT_SKLAD_PRODUCT '#1042#1054#1054#1041#1065#1045' '#1053#1045#1058', '#1058#1054' '#1054#1064 +
        #1048#1041#1050#1059' '#1053#1045' '#1042#1054#1047#1041#1059#1046#1044#1040#1070
      '11020654=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '11020655=      FOR SELECT S.G_PRODUCT,'
      '11020656=                 SUM(S.AMOUNT)'
      '11020657=            FROM SKLAD S'
      '11020658=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '11020659=           GROUP BY S.G_PRODUCT'
      '11020660=            INTO :G_PRODUCT_,'
      '11020661=                 :AMOUNT_PRIHOD_'
      '11020662=      DO BEGIN'
      '11020663=          SELECT L.AMOUNT,'
      '11020664=                 G.NAME'
      '11020665=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '11020666=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '11020667=             AND L.G_PRODUCT = G.G_PRODUCT'
      '11020668=             AND L.G_TOCHKA = :G_TOCHKA_'
      '11020669=            INTO :AMOUNT_LAST_,'
      '11020670=                 :NAME_;'
      '11020671='
      
        '11020672=          IF (ROW_COUNT > 0 AND ((:AMOUNT_LAST_ - :AMOU' +
        'NT_PRIHOD_) < 0)) THEN BEGIN'
      '11020673=              ERR_CODE = -20500;'
      
        '11020674=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||NAME_||'#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||TOCHKA_NAME_||'#39'" '#1089#1090#1072#1085 +
        #1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNI' +
        'NG_VALUES (:ERR_MSG);'
      
        '11020675=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '11020676=              EXIT;'
      '11020677=          END'
      '11020678=      END'
      '11020679=  END'
      '11020680='
      
        '11020681=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11020682=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11020683=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11020684=    EXIT;'
      '11020685=  END'
      '11020686='
      '11020687=  -------------------------------------'
      
        '11020688=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069 +
        #1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040 +
        #1044#1040
      
        '11020689=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053#1067#1045 +
        ' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1055#1054 +
        #1044#1056#1071#1044
      '11020690=  PNT_ = '#39'05'#39';'
      '11020691=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '11020692=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '11020693=      FOR SELECT S.KASSA'
      '11020694=            FROM KASSA S'
      '11020695=           WHERE S.SKLAD = :SKLAD_'
      '11020696=            INTO :KASSA_'
      '11020697=      DO BEGIN'
      
        '11020698=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11020699=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110206100=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '110206101=             EXIT;'
      '110206102=          END'
      '110206103=      END'
      '110206104='
      '110206105=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '110206106=      FOR SELECT S.KASSA_BEZNAL'
      '110206107=            FROM KASSA_BEZNAL S'
      '110206108=           WHERE S.SKLAD = :SKLAD_'
      '110206109=            INTO :KASSA_'
      '110206110=      DO BEGIN'
      
        '110206111=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110206112=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110206113=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '110206114=             EXIT;'
      '110206115=          END'
      '110206116=      END'
      '110206117=  END'
      '110206118=  -------------------------------------'
      '110206119='
      '110206120=  PNT_ = '#39'06'#39';'
      '110206121=  DELETE FROM sklad_PARENT'
      '110206122=  WHERE sklad = :sklad_;'
      '110206123='
      '110206124=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '110206125=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ IN (0,1,2' +
        ')) THEN BEGIN'
      '110206126=    UPDATE SYNC_EXT_APP AP'
      '110206127=       SET AP.OPER = 3,'
      '110206128=           AP.ID = COALESCE(:REC_ID_, :SKLAD_)'
      '110206129=     WHERE AP.OBJECT_TYPE = 2'
      '110206130=       AND AP.ID = :SKLAD_'
      '110206131=       AND AP.IS_LOADING = 0;'
      '110206132='
      '110206133=    IF (ROW_COUNT = 0) THEN'
      
        '110206134=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110206135=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, COALES' +
        'CE(:REC_ID_, :SKLAD_), 3);'
      '110206136=  END'
      '110206137='
      '110206138=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110206139=  EXECUTE PROCEDURE LOG_OPER_INS(IS_VOZVRAT_, :USER_ID' +
        '_, :SKLAD_, :DATE_, 3, :SUMM_, :LOG_BODY_, 1);'
      '110206140='
      '110206141=WHEN SQLCODE -530 DO'
      '110206142=  begin'
      '110206143=    ERR_CODE = -20500;'
      
        '110206144=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110206145=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110206146=  end'
      '110206147=END'
      '110206148=;'
      '110206149='
      '110206150=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '110206151=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110206152=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110206153=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110206154=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110206155=RETURNS ('
      '110206156=  ERR_CODE INTEGER,'
      '110206157=  ERR_MSG VARCHAR(1024))'
      '110206158=AS'
      
        '110206159=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODU' +
        'CT'#39';'
      '110206160=DECLARE VARIABLE CNT_ INTEGER;'
      '110206161=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110206162=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110206163=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110206164=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110206165=BEGIN'
      '110206166='
      
        '110206167=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', '#39 +
        ')'
      '110206168=                    FROM g_product_kit K, g_product g'
      
        '110206169=                   WHERE K.g_product_item = :G_PRODUCT' +
        '_'
      
        '110206170=                     and k.g_product = g.g_product) FR' +
        'OM 1 FOR 999)'
      '110206171=  FROM RDB$DATABASE'
      '110206172=   INTO :PROD_NAME_;'
      '110206173=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '110206174=    ERR_CODE = -20500;'
      
        '110206175=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083#1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'. '#1059#1076#1072#1083#1080#1090 +
        #1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110206176=                                  '#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090 +
        #1077' '#1077#1075#1086' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1072' '#1090#1086#1074#1072#1088#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110206177=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110206178=    EXIT;'
      '110206179=  END'
      '110206180='
      '110206181=  SELECT G.NAME'
      '110206182=    FROM G_PRODUCT G'
      '110206183=   WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110206184=    INTO :NAME_;'
      '110206185='
      '110206186=  delete from revision g'
      '110206187=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110206188='
      '110206189=  delete from g_product_image g'
      '110206190=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110206191='
      '110206192=  delete from G_DISCOUNT g'
      '110206193=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110206194='
      '110206195=  SELECT ('
      
        '110206196=          (SELECT COUNT(*) FROM ZAKAZ_DETAILS ZD WHERE' +
        ' ZD.G_PRODUCT = :G_PRODUCT_)'
      '110206197=          +'
      
        '110206198=          (SELECT COUNT(*) FROM SKLAD SD WHERE SD.G_PR' +
        'ODUCT = :G_PRODUCT_)'
      '110206199=          +'
      
        '110206200=          (SELECT COUNT(*) FROM OTHER_DETAILS OD WHERE' +
        ' OD.G_PRODUCT = :G_PRODUCT_)'
      '110206201=          +'
      
        '110206202=          (SELECT COUNT(*) FROM ZAKAZ_NA_REAL RD WHERE' +
        ' RD.G_PRODUCT = :G_PRODUCT_)'
      '110206203=         )'
      '110206204=    FROM RDB$DATABASE'
      '110206205=    INTO :CNT_;'
      '110206206='
      
        '110206207=  -- 18.05.2021 '#1057' '#1058#1048#1052#1054#1049' '#1056#1045#1064#1048#1051#1048', '#1045#1057#1051#1048' '#1060#1048#1047#1048#1063#1045#1057#1050#1048' '#1059' '#1052#1045#1053#1071' ' +
        #1058#1054#1042#1040#1056' '#1053#1045' '#1059#1044#1040#1051#1071#1045#1058#1057#1071', '#1058#1054' '#1045#1052#1059' '#1071' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1042#1067#1057#1067#1051#1040#1070', '#1055#1059#1057#1058#1068' '#1041#1054#1051#1058#1040#1045#1058#1057#1071',' +
        ' '#1055#1054#1050#1040' '#1041#1045#1047' '#1055#1056#1048#1047#1053#1040#1050#1040' '#1058#1040#1052' '#1054#1041#1054#1049#1044#1045#1052#1057#1071
      
        '110206208=  -- '#1053#1054' '#1055#1056#1048' '#1069#1058#1054#1052' '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1040#1055#1044#1045#1049#1058' G_PRODUCT_PAR, '#1063#1058#1054 +
        #1041#1067' '#1045#1057#1051#1048' '#1063#1058#1054' '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1040' '#1052#1054#1043#1051#1040' '#1059#1044#1040#1051#1048#1058#1057#1071
      '110206209=  IF (CNT_ = 0) THEN BEGIN'
      '110206210=    delete from LT_SKLAD_PRODUCT g'
      '110206211=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110206212='
      '110206213=    delete from lt_barcode g'
      '110206214=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110206215='
      '110206216=    delete from g_product_KIT g'
      '110206217=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110206218='
      
        '110206219=    delete from G_PRODUCT g where g.G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '110206220='
      
        '110206221=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110206222=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110206223=      UPDATE SYNC_EXT_APP AP'
      '110206224=         SET AP.OPER = 3'
      '110206225=       WHERE AP.OBJECT_TYPE = 4'
      '110206226=         AND AP.ID = :G_PRODUCT_'
      '110206227=         AND AP.IS_LOADING = 0;'
      '110206228='
      '110206229=      IF (ROW_COUNT = 0) THEN'
      
        '110206230=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110206231=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRO' +
        'DUCT_, 3);'
      '110206232=    END'
      '110206233=  END ELSE BEGIN'
      '110206234=    UPDATE G_PRODUCT G'
      '110206235=       SET G.IS_ACTIVE = 0,'
      '110206236=           G.G_PRODUCT_PAR = -1'
      '110206237=     WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110206238='
      
        '110206239=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER)'
      
        '110206240=      SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G_PRODUC' +
        'T_, 2'
      '110206241=        FROM RDB$DATABASE'
      
        '110206242=       WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP' +
        ' WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_ AND AP.IS_LOAD' +
        'ING = 0);'
      '110206243=  END'
      '110206244='
      '110206245=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110206246=  EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_PRO' +
        'DUCT_, NULL, 3, 0, :LOG_BODY_, 0, :NAME_);'
      '110206247='
      '110206248=when sqlcode -530 DO'
      '110206249=  begin'
      '110206250=    SELECT G.IS_CATEGORY'
      '110206251=      FROM G_PRODUCT G'
      '110206252=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110206253=      INTO :IS_CATEGORY_;'
      '110206254='
      '110206255=    ERR_CODE = -20500;'
      '110206256=    if (IS_CATEGORY_ = 0) then'
      
        '110206257=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '110206258=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076 +
        #1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081 +
        #1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110206259=    ELSE'
      
        '110206260=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110206261=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110206262=  end'
      '110206263=end'
      '110206264=;'
      '110206265='
      '110206266=ALTER PROCEDURE G_DEL_G_PRODUCT_CAT('
      '110206267=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110206268=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110206269=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110206270=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110206271=RETURNS ('
      '110206272=  LOG_ BLOB SUB_TYPE 1 SEGMENT SIZE 16384,'
      '110206273=  SUCCESS_CNT_ INTEGER,'
      '110206274=  FAIL_CNT_ INTEGER,'
      '110206275=  ERR_CODE INTEGER,'
      '110206276=  ERR_MSG VARCHAR(1024))'
      '110206277=AS'
      
        '110206278=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODU' +
        'CT_CAT'#39';'
      '110206279=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110206280=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110206281=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110206282=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110206283=DECLARE VARIABLE G_PRODUCT_CAT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110206284=DECLARE VARIABLE G_PRODUCT_LOC_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      '110206285=DECLARE VARIABLE LVL_ INTEGER;'
      '110206286=DECLARE VARIABLE STR1_ VARCHAR(500);'
      '110206287=DECLARE VARIABLE STR2_ VARCHAR(500);'
      
        '110206288=DECLARE VARIABLE CATEGORY_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      '110206289=DECLARE VARIABLE CRLF VARCHAR(5);'
      '110206290=BEGIN'
      '110206291=  LOG_ = '#39#39';'
      '110206292=  SUCCESS_CNT_ = 0;'
      '110206293=  FAIL_CNT_ = 0;'
      '110206294=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110206295='
      '110206296=  FOR WITH RECURSIVE TREE AS (SELECT T.G_PRODUCT,'
      '110206297=                                   1 LVL,'
      '110206298=                                   T.NAME'
      '110206299=                              FROM G_PRODUCT T'
      '110206300=                             WHERE T.IS_CATEGORY = 1'
      
        '110206301=                               AND T.G_PRODUCT = :G_PR' +
        'ODUCT_'
      '110206302=                            UNION ALL'
      '110206303=                            SELECT T.G_PRODUCT,'
      '110206304=                                   (GG.LVL + 1) LVL,'
      '110206305=                                   T.NAME'
      
        '110206306=                              FROM G_PRODUCT T INNER J' +
        'OIN TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '110206307=                             WHERE T.IS_CATEGORY = 1'
      '110206308=                        )'
      
        '110206309=    SELECT G_PRODUCT, LVL, NAME FROM TREE ORDER BY 2 D' +
        'ESC'
      '110206310=    INTO :G_PRODUCT_CAT_, :LVL_, :CATEGORY_NAME_'
      '110206311=  DO BEGIN'
      '110206312='
      
        '110206313=    -- '#1059#1044#1040#1051#1071#1070' '#1057#1053#1040#1063#1040#1051#1040' '#1058#1045#1061', '#1063#1058#1054' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040#1061'/' +
        #1055#1056#1048#1061#1054#1044#1040#1061
      '110206314=    FOR SELECT P.G_PRODUCT,'
      '110206315=               '#39#1058#1086#1074#1072#1088' '#39'|| P.NAME,'
      
        '110206316=               '#39#1058#1086#1074#1072#1088' '#39'||P.NAME||'#39' (ID'#39' || P.G_PRODUCT' +
        ' || '#39'), '#1072#1088#1090#1080#1082#1091#1083' '#39'||P.ARTICUL'
      '110206317=        FROM G_PRODUCT P'
      '110206318=        WHERE G_PRODUCT_PAR = :G_PRODUCT_CAT_'
      
        '110206319=        AND EXISTS (SELECT 1 FROM ZAKAZ_DETAILS WHERE ' +
        'G_PRODUCT = P.G_PRODUCT'
      '110206320=                  UNION ALL'
      
        '110206321=                  SELECT 1 FROM SKLAD SD WHERE SD.G_PR' +
        'ODUCT = P.G_PRODUCT'
      '110206322=                  UNION ALL'
      
        '110206323=                  SELECT 1 FROM OTHER_DETAILS OD WHERE' +
        ' OD.G_PRODUCT = P.G_PRODUCT'
      '110206324=                  UNION ALL'
      
        '110206325=                  SELECT 1 FROM ZAKAZ_NA_REAL RD WHERE' +
        ' RD.G_PRODUCT = P.G_PRODUCT'
      '110206326=                 )'
      '110206327=        INTO :G_PRODUCT_LOC_,'
      '110206328=             :STR1_,'
      '110206329=             :STR2_'
      '110206330=    DO BEGIN'
      '110206331=      PROD_NAME_ = '#39#39';'
      
        '110206332=      SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', ' +
        #39', '#39')'
      
        '110206333=                        FROM g_product_kit K, g_produc' +
        't g'
      
        '110206334=                       WHERE K.g_product_item = :G_PRO' +
        'DUCT_LOC_'
      
        '110206335=                         and k.g_product = g.g_product' +
        ') FROM 1 FOR 999)'
      '110206336=      FROM RDB$DATABASE'
      '110206337=       INTO :PROD_NAME_;'
      '110206338='
      '110206339=      IF (PROD_NAME_ IS NOT NULL) THEN BEGIN'
      
        '110206340=        LOG_ = LOG_ || STR1_||'#39' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083 +
        #1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'.'#39'||CRLF;'
      '110206341=        FAIL_CNT_ = FAIL_CNT_ + 1;'
      '110206342=        UPDATE G_PRODUCT D'
      '110206343=           SET D.G_PRODUCT_PAR = -1'
      '110206344=         WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206345='
      '110206346=      END ELSE BEGIN'
      '110206347='
      
        '110206348=          -- '#1059#1044#1040#1051#1071#1070' '#1057#1053#1040#1063#1040#1051#1040' '#1058#1045#1061', '#1063#1058#1054' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054 +
        #1044#1040#1046#1040#1061'/'#1055#1056#1048#1061#1054#1044#1040#1061
      
        '110206349=          INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERA' +
        'TION, G_OFFICIAL,'
      '110206350=            ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110206351=          VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIM' +
        'ESTAMP, 3, :USER_ID_, 13, :G_PRODUCT_LOC_, :STR1_, :STR2_);'
      '110206352='
      '110206353=          delete from revision g'
      '110206354=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206355='
      '110206356=          delete from g_product_image g'
      '110206357=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206358='
      '110206359=          delete from g_product_KIT g'
      '110206360=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206361='
      '110206362=          delete from G_DISCOUNT g'
      '110206363=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206364='
      '110206365=          UPDATE G_PRODUCT D'
      '110206366=             SET D.IS_ACTIVE = 0,'
      '110206367=                 D.G_PRODUCT_PAR = -1'
      '110206368=           WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206369='
      
        '110206370=          -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071 +
        #1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      
        '110206371=          -- 18.05.2021 '#1057' '#1058#1048#1052#1054#1049' '#1056#1045#1064#1048#1051#1048', '#1045#1057#1051#1048' '#1060#1048#1047#1048#1063#1045#1057#1050#1048 +
        ' '#1059' '#1052#1045#1053#1071' '#1058#1054#1042#1040#1056' '#1053#1045' '#1059#1044#1040#1051#1071#1045#1058#1057#1071', '#1058#1054' '#1045#1052#1059' '#1071' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1042#1067#1057#1067#1051#1040#1070', '#1055#1059#1057#1058#1068' '#1041#1054 +
        #1051#1058#1040#1045#1058#1057#1071', '#1055#1054#1050#1040' '#1041#1045#1047' '#1055#1056#1048#1047#1053#1040#1050#1040' '#1058#1040#1052' '#1054#1041#1054#1049#1044#1045#1052#1057#1071
      
        '110206372=          -- '#1053#1054' '#1055#1056#1048' '#1069#1058#1054#1052' '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1040#1055#1044#1045#1049#1058' G_PRODUCT_' +
        'PAR, '#1063#1058#1054#1041#1067' '#1045#1057#1051#1048' '#1063#1058#1054' '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1040' '#1052#1054#1043#1051#1040' '#1059#1044#1040#1051#1048#1058#1057#1071
      '110206373=          IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      
        '110206374=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110206375=              SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :' +
        'G_PRODUCT_LOC_, 2'
      '110206376=                FROM RDB$DATABASE'
      
        '110206377=               WHERE NOT EXISTS (SELECT 1 FROM SYNC_EX' +
        'T_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT_LOC_ AN' +
        'D AP.IS_LOADING = 0);'
      '110206378=          END'
      '110206379=          /*'
      '110206380=            UPDATE SYNC_EXT_APP AP'
      '110206381=               SET AP.OPER = 3'
      '110206382=             WHERE AP.OBJECT_TYPE = 4'
      '110206383=               AND AP.ID = :G_PRODUCT_LOC_'
      '110206384=               AND AP.IS_LOADING = 0;'
      '110206385='
      '110206386=            IF (ROW_COUNT = 0) THEN'
      
        '110206387=                INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP' +
        ', OBJECT_TYPE, ID, OPER)'
      
        '110206388=                VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4' +
        ', :G_PRODUCT_LOC_, 3);'
      '110206389=          */'
      '110206390='
      '110206391=          SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110206392=      END'
      '110206393=    END'
      '110206394='
      '110206395='
      
        '110206396=    -- '#1058#1045#1055#1045#1056#1068' '#1059#1044#1040#1051#1071#1070' '#1058#1045#1061', '#1063#1058#1054' '#1053#1045' '#1059#1063#1040#1057#1058#1042#1054#1042#1040#1051#1048' '#1042' '#1055#1056#1054#1044#1040#1046#1040 +
        #1061'/'#1055#1056#1048#1061#1054#1044#1040#1061
      '110206397=    FOR SELECT P.G_PRODUCT,'
      '110206398=               '#39#1058#1086#1074#1072#1088' '#39'|| P.NAME,'
      
        '110206399=               '#39#1058#1086#1074#1072#1088' '#39'||P.NAME||'#39' (ID'#39' || P.G_PRODUCT' +
        ' || '#39'), '#1072#1088#1090#1080#1082#1091#1083' '#39'||P.ARTICUL'
      '110206400=        FROM G_PRODUCT P'
      '110206401=        WHERE G_PRODUCT_PAR = :G_PRODUCT_CAT_'
      
        '110206402=        AND NOT EXISTS (SELECT 1 FROM ZAKAZ_DETAILS WH' +
        'ERE G_PRODUCT = P.G_PRODUCT'
      '110206403=                          UNION ALL'
      
        '110206404=                          SELECT 1 FROM SKLAD SD WHERE' +
        ' SD.G_PRODUCT = P.G_PRODUCT'
      '110206405=                          UNION ALL'
      
        '110206406=                          SELECT 1 FROM OTHER_DETAILS ' +
        'OD WHERE OD.G_PRODUCT = P.G_PRODUCT'
      '110206407=                          UNION ALL'
      
        '110206408=                          SELECT 1 FROM ZAKAZ_NA_REAL ' +
        'RD WHERE RD.G_PRODUCT = P.G_PRODUCT'
      '110206409=                         )'
      '110206410=        INTO :G_PRODUCT_LOC_,'
      '110206411=             :STR1_,'
      '110206412=             :STR2_'
      '110206413=    DO BEGIN'
      '110206414=      PROD_NAME_ = '#39#39';'
      
        '110206415=      SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', ' +
        #39', '#39')'
      
        '110206416=                        FROM g_product_kit K, g_produc' +
        't g'
      
        '110206417=                       WHERE K.g_product_item = :G_PRO' +
        'DUCT_LOC_'
      
        '110206418=                         and k.g_product = g.g_product' +
        ') FROM 1 FOR 999)'
      '110206419=      FROM RDB$DATABASE'
      '110206420=       INTO :PROD_NAME_;'
      '110206421='
      '110206422=      IF (PROD_NAME_ IS NOT NULL) THEN BEGIN'
      
        '110206423=        LOG_ = LOG_ || STR1_||'#39' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083 +
        #1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'.'#39'||CRLF;'
      '110206424=        FAIL_CNT_ = FAIL_CNT_ + 1;'
      '110206425=        UPDATE G_PRODUCT D'
      '110206426=           SET D.G_PRODUCT_PAR = -1'
      '110206427=         WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206428='
      '110206429=      END ELSE BEGIN'
      '110206430='
      
        '110206431=          INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERA' +
        'TION, G_OFFICIAL,'
      '110206432=            ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110206433=          VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIM' +
        'ESTAMP, 3, :USER_ID_, 13, :G_PRODUCT_LOC_, :STR1_, :STR2_);'
      '110206434='
      '110206435=          delete from LT_SKLAD_PRODUCT g'
      '110206436=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206437='
      '110206438=          delete from lt_barcode g'
      '110206439=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206440='
      '110206441=          delete from revision g'
      '110206442=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206443='
      '110206444=          delete from g_product_image g'
      '110206445=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206446='
      '110206447=          delete from g_product_KIT g'
      '110206448=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206449='
      '110206450=          delete from G_DISCOUNT g'
      '110206451=            where g.G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206452='
      '110206453=          DELETE FROM G_PRODUCT C'
      '110206454=           WHERE G_PRODUCT = :G_PRODUCT_LOC_;'
      '110206455='
      
        '110206456=          -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071 +
        #1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110206457=          IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110206458=            UPDATE SYNC_EXT_APP AP'
      '110206459=               SET AP.OPER = 3'
      '110206460=             WHERE AP.OBJECT_TYPE = 4'
      '110206461=               AND AP.ID = :G_PRODUCT_LOC_'
      '110206462=               AND AP.IS_LOADING = 0;'
      '110206463='
      '110206464=            IF (ROW_COUNT = 0) THEN'
      
        '110206465=                INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP' +
        ', OBJECT_TYPE, ID, OPER)'
      
        '110206466=                VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4' +
        ', :G_PRODUCT_LOC_, 3);'
      '110206467=          END'
      '110206468='
      '110206469=          SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110206470=      END'
      '110206471=    END'
      '110206472='
      
        '110206473=    INSERT INTO LOG_OPER (LOG_OPER, ODATE, OPERATION, ' +
        'G_OFFICIAL,'
      '110206474=      ITEM_TYPE, ITEM_ID, HEADER, BODY)'
      
        '110206475=    VALUES (GEN_ID(GEN_LOG_OPER, 1), CURRENT_TIMESTAMP' +
        ', 3, :USER_ID_, 13, :G_PRODUCT_CAT_,'
      '110206476=        '#39#1043#1088#1091#1087#1087#1072' '#1090#1086#1074#1072#1088#1086#1074' '#39'||:CATEGORY_NAME_,'
      
        '110206477=        '#39#1043#1088#1091#1087#1087#1072' '#1090#1086#1074#1072#1088#1086#1074' '#39'||:CATEGORY_NAME_ || '#39' (ID'#39' |' +
        '| :G_PRODUCT_CAT_ || '#39')'#39');'
      '110206478='
      '110206479=    DELETE FROM G_PRODUCT C'
      '110206480=     WHERE G_PRODUCT = :G_PRODUCT_CAT_;'
      '110206481='
      
        '110206482=    -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110206483=    IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110206484=        UPDATE SYNC_EXT_APP AP'
      '110206485=           SET AP.OPER = 3'
      '110206486=         WHERE AP.OBJECT_TYPE = 4'
      '110206487=           AND AP.ID = :G_PRODUCT_CAT_'
      '110206488=           AND AP.IS_LOADING = 0;'
      '110206489='
      '110206490=        IF (ROW_COUNT = 0) THEN'
      
        '110206491=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110206492=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G' +
        '_PRODUCT_CAT_, 3);'
      '110206493=    END'
      '110206494='
      '110206495=    SUCCESS_CNT_ = SUCCESS_CNT_ + 1;'
      '110206496=  END'
      '110206497='
      '110206498=  IF (FAIL_CNT_ = 0) THEN'
      
        '110206499=    LOG_ = '#39#1059#1076#1072#1083#1077#1085#1086' '#1091#1089#1087#1077#1096#1085#1086': '#39' || SUCCESS_CNT_ || '#39' '#1079#1072 +
        #1087#1080#1089#1077#1081'(-'#1080').'#39';'
      '110206500=  ELSE'
      
        '110206501=    LOG_ = '#39#1059#1076#1072#1083#1077#1085#1086' '#1091#1089#1087#1077#1096#1085#1086': '#39' || SUCCESS_CNT_ || '#39' '#1079#1072 +
        #1087#1080#1089#1077#1081'(-'#1080').'#39'||CRLF||'
      
        '110206502=        '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1091#1076#1072#1083#1077#1085#1080#1080': '#39' || FAIL_CNT_ || '#39' '#1079#1072#1087#1080 +
        #1089#1077#1081'(-'#1080').'#39'||CRLF||CRLF||'
      
        '110206503=        '#39#1057#1083#1077#1076#1091#1102#1097#1080#1077' '#1090#1086#1074#1072#1088#1099' '#1091#1076#1072#1083#1080#1090#1100' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#1054#1085#1080' '#1073#1099#1083#1080 +
        ' '#1087#1077#1088#1077#1085#1077#1089#1077#1085#1099' '#1074' '#1075#1088#1091#1087#1087#1091' "'#1041#1077#1079' '#1075#1088#1091#1087#1087#1099'".'#39'||CRLF||'#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090#1077 +
        ' '#1080#1093' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1086#1074' '#1090#1086#1074#1072#1088#1086#1074'.'#39'||CRLF||'
      '110206504=        '#39'==========================='#39'||CRLF||LOG_;'
      '110206505='
      '110206506=WHEN ANY DO BEGIN'
      '110206507=    ERR_CODE = -20500;'
      
        '110206508=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073#1082#1072' '#1087#1088 +
        #1080' '#1091#1076#1072#1083#1077#1085#1080#1080' '#1075#1088#1091#1087#1099#1099'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '110206509=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110206510=  END'
      '110206511=END'
      '110206512=;'
      '110206513='
      '110206514=ALTER PROCEDURE G_SET_G_PRODUCT_NOT_ACTIVE('
      '110206515=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110206516=  IS_ACTIVE_ INTEGER,'
      
        '110206517=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110206518=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110206519=RETURNS ('
      '110206520=  ERR_CODE INTEGER,'
      '110206521=  ERR_MSG VARCHAR(1024))'
      '110206522=AS'
      
        '110206523=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_SET_G_PRODU' +
        'CT_NOT_ACTIVE'#39';'
      '110206524=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110206525=BEGIN'
      '110206526='
      '110206527=    UPDATE G_PRODUCT g'
      '110206528=       SET G.IS_ACTIVE = :IS_ACTIVE_'
      '110206529=     WHERE g.G_PRODUCT = :G_PRODUCT_'
      '110206530=    RETURNING'
      '110206531=      G.NAME'
      '110206532=    INTO'
      '110206533=      :NAME_;'
      '110206534='
      '110206535=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110206536=    EXECUTE PROCEDURE LOG_OPER_INS(13, :USER_ID_, :G_P' +
        'RODUCT_, NULL, 2, 0, :LOG_BODY_, 0, :NAME_);'
      '110206537='
      '110206538=END'
      '110206539=;'
      '110206540='
      '110206541=ALTER PROCEDURE INS_ZAKAZ('
      '110206542=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110206543=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110206544=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110206545=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110206546=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110206547=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110206548=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110206549=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110206550=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110206551=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110206552=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110206553=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110206554=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110206555=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110206556=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110206557=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110206558=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110206559=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110206560=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110206561=  IS_MEBEL_ INTEGER = 0,'
      
        '110206562=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110206563=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      
        '110206564=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NUL' +
        'L,'
      '110206565=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '110206566=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110206567=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110206568=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110206569=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110206570=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110206571=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL)'
      '110206572=RETURNS ('
      '110206573=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110206574=  ERR_CODE INTEGER,'
      '110206575=  ERR_MSG VARCHAR(1024))'
      '110206576=AS'
      '110206577=/*'
      '110206578=IS_SPISANIE_'
      '110206579=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110206580=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110206581=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110206582=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110206583='
      '110206584='
      
        '110206585=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110206586=*/'
      '110206587=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110206588=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110206589=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110206590=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110206591=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110206592=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110206593=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110206594=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110206595=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110206596=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110206597=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110206598=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110206599=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110206600=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110206601=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '110206602=DECLARE VARIABLE CNT_ INTEGER;'
      '110206603=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110206604=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110206605=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110206606=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110206607=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110206608=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110206609=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110206610=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110206611=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110206612=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110206613=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110206614=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110206615=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110206616=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110206617=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110206618=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110206619=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      
        '110206620=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.MARK_CODE;'
      '110206621=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '110206622=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN L' +
        'OG_OPER.OPERATION;'
      
        '110206623=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '110206624=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110206625=BEGIN'
      '110206626='
      
        '110206627=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110206628=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110206629=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110206630=  IF (CNT_ = 0) THEN BEGIN'
      '110206631=    ERR_CODE = -20500;'
      
        '110206632=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110206633=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110206634=    EXIT;'
      '110206635=  END'
      '110206636='
      '110206637=  IF (G_TOCHKA_ IS NULL) THEN'
      '110206638=    SELECT ID'
      '110206639=      FROM CUR_PARAMS'
      '110206640=     WHERE CUR_PARAMS = 2'
      '110206641=      INTO :G_TOCHKA_;'
      '110206642='
      '110206643=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110206644=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110206645=      PNT_ = '#39'01'#39';'
      
        '110206646=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110206647=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110206648=      ELSE'
      '110206649=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110206650='
      '110206651=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110206652=      SELECT G.G_OFFICIAL,'
      '110206653=             G.DO_NOT_SALES_COMM,'
      '110206654=             G.FM||'#39' '#39'||G.NM'
      '110206655=        FROM G_OFFICIAL G'
      
        '110206656=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110206657=        INTO :G_OFFICIAL_,'
      '110206658=             :DO_NOT_SALES_COMM_,'
      '110206659=             :OFFICIAL_NAME_;'
      '110206660='
      '110206661=      INSERT INTO ZAKAZ'
      '110206662=      ('
      '110206663=       ZAKAZ,'
      '110206664=       G_TOCHKA,'
      '110206665=       Z_DATE,'
      '110206666=       Z_TIME,'
      '110206667=       G_CLIENT,'
