      '110206971=  END'
      '110206972=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110206973=  ----------------------------------------'
      '110206974=  ----------------------------------------'
      '110206975=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110206976=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '110206977=      PNT_ = '#39'25'#39';'
      
        '110206978=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
        'A)'
      
        '110206979=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLI' +
        'ENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA' +
        '_)'
      '110206980=      RETURNING ZAKAZ_REAL_PARENT'
      '110206981=      INTO :ZAKAZ_REAL_PARENT_;'
      '110206982='
      
        '110206983=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCO' +
        'UNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '110206984=            FROM ZAKAZ_DETAILS_TMP Z'
      '110206985=          INTO :G_PRODUCT,'
      '110206986=              :AMOUNT,'
      '110206987=              :PRICE,'
      '110206988=              :SUMM,'
      '110206989=              :DISCOUNT_PERC,'
      '110206990=              :DISCOUNT_TENGE,'
      '110206991=              :DISCOUNT_SUMM,'
      '110206992=              :NDS,'
      '110206993=              :NDS_SUMM'
      '110206994=      DO BEGIN'
      '110206995=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110206996=          UPDATE LT_SKLAD_PRODUCT L'
      '110206997=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '110206998=                 L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP' +
        '_'
      '110206999=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102061000=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102061001='
      
        '1102061002=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102061003=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102061004=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1102061005=            Err_Code = -20500;'
      
        '1102061006=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102061007=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102061008=            EXIT;'
      '1102061009=          END ELSE if (ROW_COUNT = 0) then'
      
        '1102061010=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102061011=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102061012='
      
        '1102061013=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1102061014=                                     G_PRODUCT,'
      '1102061015=                                     PRICE,'
      
        '1102061016=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1102061017=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1102061018=                                     NDS_SUMM)'
      
        '1102061019=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1102061020=                  :G_PRODUCT,'
      
        '1102061021=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1102061022=                  :AMOUNT, :SUMM,'
      '1102061023=                  0, --AMOUNT_PAYED,'
      '1102061024=                  0, --SUMM_PAYED,'
      '1102061025=                  0, --IS_PAYED_ALL,'
      '1102061026=                  :DISCOUNT_PERC,'
      '1102061027=                  :DISCOUNT_TENGE,'
      '1102061028=                  :DISCOUNT_SUMM,'
      '1102061029=                  :NDS,'
      '1102061030=                  :NDS_SUMM)'
      '1102061031=          RETURNING ZAKAZ_NA_REAL'
      '1102061032=          INTO :ZAKAZ_;'
      '1102061033=      END'
      '1102061034=  END'
      '1102061035=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102061036=  ----------------------------------------'
      '1102061037=  ----------------------------------------'
      '1102061038=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1102061039=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1102061040=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102061041=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102061042=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1102061043=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102061044=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102061045=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102061046=      RETURNING SKLAD'
      '1102061047=      INTO :ZAKAZ_;'
      '1102061048='
      '1102061049=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102061050=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102061051=          INTO :G_PRODUCT,'
      '1102061052=              :AMOUNT,'
      '1102061053=              :PRICE,'
      '1102061054=              :SUMM'
      '1102061055=      DO BEGIN'
      '1102061056=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102061057=        UPDATE LT_SKLAD_PRODUCT L'
      '1102061058=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1102061059=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102061060=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102061061=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102061062='
      '1102061063=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102061064=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1102061065=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1102061066=        SELECT MAX(SK.DATE_RECEIPT)'
      '1102061067=            FROM SKLAD SK'
      '1102061068=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102061069=             AND SK.IS_LAST = 1'
      '1102061070=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1102061071=            INTO :DATE_LAST_;'
      '1102061072='
      
        '1102061073=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102061074=            UPDATE SKLAD SK'
      '1102061075=               SET SK.IS_LAST = 0'
      '1102061076=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102061077=               AND SK.IS_LAST = 1'
      '1102061078=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102061079='
      '1102061080=            IS_THIS_LAST_ = 1;'
      '1102061081=        END */'
      '1102061082='
      '1102061083='
      '1102061084=        INSERT INTO SKLAD'
      '1102061085=        ('
      '1102061086=         SKLAD,'
      '1102061087=         SKLAD_PARENT,'
      '1102061088=         DATE_RECEIPT,'
      '1102061089=         G_CLIENT,'
      '1102061090=         G_PRODUCT,'
      '1102061091=         AMOUNT,'
      '1102061092=         PRICE,'
      '1102061093=         SUMM,'
      '1102061094=         G_PAYMENT_TYPE,'
      '1102061095=         OSNOVANIE,'
      '1102061096=         NOTE,'
      '1102061097=         NDS,'
      '1102061098=         NDS_SUMM,'
      '1102061099=         IS_LAST,'
      '1102061100=         IS_VOZVRAT,'
      '1102061101=         G_TOCHKA'
      '1102061102=        ) VALUES ('
      '1102061103=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102061104=         :ZAKAZ_,'
      '1102061105=         :Z_DATE_,'
      '1102061106=         :G_TOCHKA_,'
      '1102061107=         :G_PRODUCT,'
      '1102061108=         :AMOUNT,'
      '1102061109=         :PRICE,'
      '1102061110=         :SUMM,'
      '1102061111=         :G_PAYMENT_TYPE_,'
      '1102061112=         :OSNOVANIE_,'
      '1102061113=         :NOTE_,'
      '1102061114=         0,  --:RNDS_,'
      '1102061115=         0,  --:RNDS_SUMM_,'
      
        '1102061116=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102061117=         3,  --:IS_VOZVRAT_,'
      '1102061118=         :G_CLIENT_'
      '1102061119=        );'
      '1102061120='
      
        '1102061121=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102061122=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102061123=        PNT_ = '#39'02'#39';'
      '1102061124=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102061125=            UPDATE LT_SKLAD_PRODUCT L'
      '1102061126=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102061127=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102061128=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102061129=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102061130='
      '1102061131=            IF (ROW_COUNT = 0) THEN'
      
        '1102061132=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102061133=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102061134=        END'
      '1102061135=      END'
      '1102061136=  END'
      '1102061137='
      '1102061138=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102061139='
      
        '1102061140=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102061141=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102061142=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102061143=                                  G_PRIHOD_,'
      '1102061144=                                  :SUMM_PRIHOD_,'
      '1102061145=                                  :Z_DATE_,'
      
        '1102061146=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102061147=                                  :ZAKAZ_,'
      '1102061148=                                  NULL,'
      '1102061149=                                  :G_PAYMENT_TYPE_,'
      '1102061150=                                  :G_TOCHKA_,'
      '1102061151=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102061152=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102061153=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102061154=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102061155=      EXIT;'
      '1102061156=    END'
      '1102061157=  END'
      '1102061158='
      
        '1102061159=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102061160=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102061161=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102061162=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102061163='
      '1102061164=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102061165=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102061166='
      '1102061167=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102061168=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102061169=end'
      '1102061170=;'
      '1102061171='
      '1102061172=ALTER PROCEDURE SYNC_DOWNLOAD'
      '1102061173=RETURNS ('
      '1102061174=  ERR_CODE INTEGER,'
      '1102061175=  ERR_MSG VARCHAR(1024),'
      '1102061176=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '1102061177=AS'
      '1102061178=/*'
      '1102061179='#1060#1048#1053#1040#1051' 07.02.2019'
      '1102061180=*/'
      
        '1102061181=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_DOWNLOA' +
        'D'#39';'
      '1102061182=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102061183=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '1102061184=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
      '1102061185=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '1102061186=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '1102061187=DECLARE VARIABLE POS_ INTEGER = 0;'
      '1102061188=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '1102061189=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '1102061190=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '1102061191=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGM' +
        'ENT SIZE 80 = '#39#39';'
      '1102061192=DECLARE VARIABLE ID_STR_ VARCHAR(50);'
      '1102061193=DECLARE VARIABLE STR_ VARCHAR(100);'
      
        '1102061194=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102061195=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102061196=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PROD' +
        'UCT.AMOUNT;'
      
        '1102061197=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT_RESERVE;'
      '1102061198=BEGIN'
      '1102061199=  PNT_ = '#39'00'#39';'
      '1102061200=  ERR_CODE = 0;'
      '1102061201=  ERR_MSG = '#39#39';'
      '1102061202=  ERR_BODY = '#39#39';'
      '1102061203='
      '1102061204=  FOR SELECT L.ID,'
      '1102061205=             L.SQLSTMT'
      '1102061206=        FROM LOGS L'
      '1102061207=       WHERE L.USR = '#39'REPLICAT'#39
      '1102061208=         AND L.DAT IS NULL'
      '1102061209=         AND L.IS_TRANSFERED = 0'
      
        '1102061210=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTM' +
        'T) = 0'
      '1102061211=        ORDER BY L.ID_ORIGINAL'
      '1102061212=        INTO :LOGS_ID_,'
      '1102061213=             :SQL_'
      '1102061214=  DO BEGIN'
      '1102061215=    BEGIN'
      '1102061216=        SQLCODE_ = 0;'
      '1102061217='
      
        '1102061218=        --'#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054 +
        ' '#1053#1048#1046#1045' '#1054#1058#1044#1045#1051#1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048 +
        #1042' '#1057#1054#1041#1048#1056#1040#1058#1068'?'
      '1102061219=        /*'
      
        '1102061220=        -- '#1057#1054#1041#1048#1056#1040#1070' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1053#1040#1044#1054' '#1055#1045#1056#1045 +
        #1057#1063#1048#1058#1067#1042#1040#1058#1068
      
        '1102061221=        IF (POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN SQL_) > 0' +
        ') THEN BEGIN'
      
        '1102061222=          ID_STR_ = SUBSTRING(SQL_ FROM 18 FOR CHAR_L' +
        'ENGTH(SQL_) - 17);'
      '1102061223='
      
        '1102061224=          IF (POSITION(ID_STR_ IN PRODUCT_ID_ARR_) = ' +
        '0) THEN'
      
        '1102061225=            PRODUCT_ID_ARR_ = PRODUCT_ID_ARR_ || '#39'~'#39' ' +
        '|| ID_STR_;'
      '1102061226=        END'
      '1102061227=        ELSE BEGIN'
      '1102061228=            EXECUTE STATEMENT SQL_;'
      '1102061229='
      
        '1102061230=            IF (POSITION('#39'EXECUTE PROCEDURE K_RECALC_' +
        'KASSA'#39' IN SQL_) > 0) THEN BEGIN'
      '1102061231=              IF (ERR_CODE <> 0) THEN BEGIN'
      '1102061232=                SQLCODE_ = ERR_CODE;'
      '1102061233=                IF (ERR_BODY = '#39#39') THEN'
      
        '1102061234=                  ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084 +
        #1077#1085#1077#1085#1080#1081'.'#39';'
      '1102061235=                ERR_BODY = ERR_BODY ||'#39
      
        '1102061236=                '#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||ERR_CODE||'#39'. '#1044 +
        #1077#1090#1072#1083#1080': '#39'||ERR_MSG;'
      '1102061237='
      '1102061238=                ERR_CODE = 0;'
      '1102061239=                ERR_MSG = '#39#39';'
      '1102061240=              END'
      '1102061241=            END'
      '1102061242=        END*/'
      '1102061243=        EXECUTE STATEMENT SQL_;'
      '1102061244='
      
        '1102061245=        IF (POSITION('#39'EXECUTE PROCEDURE K_RECALC_KASS' +
        'A'#39' IN SQL_) > 0) THEN BEGIN'
      '1102061246=          IF (ERR_CODE <> 0) THEN BEGIN'
      '1102061247=            SQLCODE_ = ERR_CODE;'
      '1102061248=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102061249=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102061250=            ERR_BODY = ERR_BODY ||'#39
      
        '1102061251=            '#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||ERR_CODE||'#39'. '#1044#1077#1090#1072#1083 +
        #1080': '#39'||ERR_MSG;'
      '1102061252='
      '1102061253=            ERR_CODE = 0;'
      '1102061254=            ERR_MSG = '#39#39';'
      '1102061255=          END'
      '1102061256=        END'
      '1102061257='
      '1102061258=    WHEN ANY DO'
      '1102061259=        BEGIN'
      '1102061260=            SQLCODE_ = GDSCODE;'
      '1102061261=            IF (ERR_BODY = '#39#39') THEN'
      
        '1102061262=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1102061263=            ERR_BODY = ERR_BODY ||'#39
      '1102061264='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1102061265=        END'
      '1102061266=    END'
      '1102061267='
      
        '1102061268=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
