        '1101131821=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101131822=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101131823=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101131824=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101131825=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101131826=              EXIT;'
      '1101131827=            END'
      '1101131828=        END'
