      '1104498='
      
        '1104499=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRODAZHA_WAYBIL' +
        'L('
      '11044100=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ INTEGER,'
