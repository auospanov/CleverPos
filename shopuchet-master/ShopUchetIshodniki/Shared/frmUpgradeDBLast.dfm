        '11013542=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ BIGINT,'
      
        '11013543=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      '11013544=  HAVERIGHT_ INTEGER,'
      '11013545=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '11013546=  NOT_MINUS_OSTATOK_ /* TYPE OF COLUMN SKLAD_PARENT.IS_' +
        'EXPECTED */ INTEGER,'
