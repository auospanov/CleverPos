        '110533845=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '110533846=                       +'
      
        '110533847=                       (select COALESCE(sum(zd.amount)' +
