      '1102251856=          FROM ZAKAZ Z'
      '1102251857=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '1102251858=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102251859=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1102251860=           AND :MODE_ = 0'
      '1102251861=        UNION ALL'
      '1102251862=        SELECT 2 ROW,'
      
        '1102251863=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1085#1072#1082#1083#1072#1076#1085#1091#1102' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090 +
        ' '#39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT' +
        '(MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DAT' +
        'E) STR,'
      '1102251864=               K.ZAKAZ ID,'
      '1102251865=               K.ACTION_DATE OPER_DATE,'
      '1102251866=               NULL SUMM_DEBET,'
      '1102251867=               K.SUMM SUMM_CREDIT,'
      '1102251868=               K.ACTION_DATE SORT_ROW'
      
        '1102251869=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
