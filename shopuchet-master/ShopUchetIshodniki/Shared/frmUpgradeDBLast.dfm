      '11096556=                END'
      '11096557=            END'
      '11096558=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '11096559=            --=========================================' +
        '========================'
      '11096560='
      '11096561=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '11096562='
      '11096563=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '11096564=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0) ' +
        'THEN'
      
        '11096565=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_' +
        'TYPE, ID, OPER)'
      
        '11096566=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ_' +
        ', 2);'
      '11096567=  END'
      '11096568=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '11096569=  -----------------------------------------------------' +
        '----------'
      
        '11096570=  --***************************************************' +
        '**********'
      
        '11096571=  -----------------------------------------------------' +
        '----------'
      '11096572=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11096573=  ELSE BEGIN'
      '11096574=      PNT_ = '#39'020'#39';'
      '11096575=      SELECT SP.G_TOCHKA,'
      '11096576=             SP.G_CLIENT'
      '11096577=        FROM SKLAD_PARENT SP'
      '11096578=       WHERE SP.SKLAD = :ZAKAZ_'
      '11096579=        INTO :G_TOCHKA_OLD_,'
      '11096580=             :G_TOCHKA_;'
      '11096581='
      
        '11096582=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040 +
        #1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '11096583=      PNT_ = '#39'021'#39';'
      '11096584=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '11096585=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, N' +
        'ULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '11096586=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11096587=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
