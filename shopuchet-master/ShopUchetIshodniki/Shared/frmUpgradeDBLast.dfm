        '1102461778=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1102461779=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1102461780=                                              NULL,'
      
        '1102461781=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1102461782=                                              :G_TOCH' +
        'KA_,'
      
        '1102461783=                                              :UPLOAD' +
        '_TO_EXT_APP_'
      
        '1102461784=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102461785=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102461786=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1102461787=                  EXIT;'
      '1102461788=                END'
      '1102461789=            END'
      '1102461790='
      '1102461791=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1102461792=        END ELSE BEGIN'
      '1102461793=            PNT_ = '#39'06'#39';'
      
        '1102461794=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1102461795=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1102461796=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1102461797=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102461798=                ELSE'
      
        '1102461799=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102461800='
      
        '1102461801=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1102461802=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102461803='
      
        '1102461804=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1102461805='
      '1102461806=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1102461807=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102461808=                                                  1, ' +
