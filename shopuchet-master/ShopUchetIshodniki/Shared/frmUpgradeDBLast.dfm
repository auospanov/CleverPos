      '110236892='
      '110236893=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '110236894=  END ELSE IF (IS_SPISANIE_ = 1) THEN'
      '110236895=  BEGIN'
      '110236896=      FOR'
      '110236897=        SELECT T.ZAKAZ,'
      
        '110236898=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042 +
        #1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '110236899=               T.G_TOCHKA,'
      '110236900=               T.Z_DATE,'
      '110236901=               T.Z_TIME,'
      '110236902=               T.G_CLIENT,'
      '110236903=               T.OSNOVANIE,'
      '110236904=               T.NOTE,'
      '110236905=               NULL,'
      '110236906=               SUBSTRING((SELECT'
      
