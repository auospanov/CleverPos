        '/ NUMERIC(15,2),'
      
        '1102371256=  SUMM_BONUS_GOT /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_G' +
        'OT */ NUMERIC(15,2),'
      
        '1102371257=  BY_RECIPE /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTE' +
        'GER,'
      
        '1102371258=  IS_RESERVE /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ IN' +
        'TEGER,'
      
        '1102371259=  G_OFFICIAL /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL ' +
        '*/ BIGINT,'
      
        '1102371260=  G_OFFICIAL_FIO /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC' +
        ' */ VARCHAR(150),'
      
        '1102371261=  ADDRESS /* TYPE OF COLUMN G_ADDRESS.ADDRESS */ VARC' +
        'HAR(500),'
      
        '1102371262=  G_NONCASH_PAY_TYPE /* TYPE OF COLUMN G_NONCASH_PAY_' +
        'TYPE.G_NONCASH_PAY_TYPE */ BIGINT,'
      
        '1102371263=  G_NONCASH_PAY_TYPE_NAME /* TYPE OF COLUMN G_NONCASH' +
        '_PAY_TYPE.NAME */ VARCHAR(150),'
      
        '1102371264=  BONUSALL /* TYPE OF COLUMN G_DISCONT_CARD.SUMM */ N' +
        'UMERIC(15,2),'
      
        '1102371265=  REQUEST_NUMBER /* TYPE OF COLUMN ZAKAZ.REQUEST_NUMB' +
        'ER */ VARCHAR(100))'
      '1102371266=AS'
      '1102371267=BEGIN'
      '1102371268=  SUSPEND;'
      '1102371269=END'
      '1102371270=;'
      '1102371271='
      '1102371272='
      
        '1102371273=/****************************************************' +
        '**************************/'
      
        '1102371274=/****                      Altering stored procedures' +
        '                      ****/'
      
        '1102371275=/****************************************************' +
        '**************************/'
      '1102371276=ALTER PROCEDURE INS_SKLAD('
      '1102371277=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '1102371278=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT,'
      
        '1102371279=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102371280=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102371281=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102371282=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102371283=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102371284=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '1102371285=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102371286=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1102371287=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102371288=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102371289=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102371290=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102371291=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102371292=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102371293=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102371294=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102371295=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102371296=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '1102371297=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL,'
      '1102371298=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = NULL)'
      '1102371299=RETURNS ('
      '1102371300=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102371301=  ERR_CODE INTEGER,'
      '1102371302=  ERR_MSG VARCHAR(1024))'
      '1102371303=AS'
      '1102371304=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '1102371305=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054 +
        #1042#1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '1102371306=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '1102371307=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '1102371308=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059 +
        #1055#1050#1048
      
        '1102371309=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '1102371310=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053 +
        #1050#1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054 +
        #1047#1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '1102371311=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041 +
        #1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUM' +
        'M '#1041#1059#1044#1059
      '1102371312=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '1102371313=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048 +
        #1047#1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053 +
        #1048' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '1102371314=--'
      
        '1102371315=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1102371316=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '1102371317='
      
        '1102371318=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057 +
        #1056#1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102371319=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '1102371320=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102371321=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1102371322=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1102371323=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1102371324=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1102371325=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '1102371326=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_' +
        'SUMM = 0;'
      
        '1102371327=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      '1102371328=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102371329=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PR' +
        'IHOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '1102371330=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102371331=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102371332=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1102371333=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102371334=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102371335=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      '1102371336=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102371337=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102371338=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1102371339=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1102371340=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1102371341=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1102371342=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK' +
        '_CODE;'
      
        '1102371343=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COS' +
        'T_PRICE;'
      
        '1102371344=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1102371345=DECLARE VARIABLE SUMM_BONUS_ TYPE OF COLUMN G_DISCONT' +
        '_CARD.SUMM;'
      
        '1102371346=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM;'
      
        '1102371347=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM;'
      '1102371348=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '1102371349=BEGIN'
      '1102371350='
      '1102371351=  PNT_ = '#39'00'#39';'
      '1102371352=  IS_THIS_LAST_ = 0;'
      '1102371353='
      '1102371354=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102371355=    SELECT ID'
      '1102371356=      FROM CUR_PARAMS'
      '1102371357=     WHERE CUR_PARAMS = 2'
      '1102371358=      INTO :G_TOCHKA_;'
      '1102371359='
      '1102371360=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '1102371361=  IF (G_OFFICIAL_ IS NULL) THEN'
      '1102371362=      SELECT ID'
      '1102371363=        FROM CUR_PARAMS'
      '1102371364=       WHERE CUR_PARAMS = 1'
      '1102371365=        INTO :G_OFFICIAL_;'
      '1102371366='
      '1102371367=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '1102371368=                            DATE_RECEIPT,'
      '1102371369=                            TIME_RECEIPT,'
      '1102371370=                            G_CLIENT,'
      '1102371371=                            G_PAYMENT_TYPE,'
      '1102371372=                            OSNOVANIE,'
      '1102371373=                            NOTE,'
      '1102371374=                            SUMM,'
      '1102371375=                            SUMM_FACT,'
      '1102371376=                            SUMM_CURRENCY,'
      '1102371377=                            IS_PAYED_ALL,'
      '1102371378=                            IS_VOZVRAT,'
      '1102371379=                            G_TOCHKA'
      '1102371380=                            ,G_OFFICIAL'
      '1102371381=                            ,IS_EXPECTED'
      '1102371382=                            ,G_NONCASH_PAY_TYPE'
      '1102371383=                            ,REC_ID'
      '1102371384=                            ,ZAKAZ)'
      '1102371385=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1102371386=          :DATE_RECEIPT_,'
      '1102371387=          :TIME_RECEIPT_,'
      '1102371388=          :G_CLIENT_,'
      '1102371389=          :G_PAYMENT_TYPE_,'
      '1102371390=          :OSNOVANIE_,'
      '1102371391=          :NOTE_,'
      '1102371392=          :SUMM_,'
      '1102371393=          :SUMM_FACT_,'
      '1102371394=          :SUMM_CURRENCY_,'
      
        '1102371395=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE' +
        ' 0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045 +
        #1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102371396=          :IS_VOZVRAT_,'
      '1102371397=          :G_TOCHKA_'
      '1102371398=          ,:G_OFFICIAL_'
      '1102371399=          ,:IS_EXPECTED_'
      '1102371400=          ,:G_NONCASH_PAY_TYPE_'
      '1102371401=          ,:REC_ID_'
      '1102371402=          ,:ZAKAZ_)'
      '1102371403=  RETURNING'
      '1102371404=    SKLAD'
      '1102371405=  INTO'
      '1102371406=    :SKLAD_;'
      '1102371407='
      '1102371408=  PNT_ = '#39'01'#39';'
      '1102371409=  FOR SELECT SKLAD,'
      '1102371410=             T.G_PRODUCT,'
      '1102371411=             AMOUNT,'
      '1102371412=             T.PRICE,'
      '1102371413=             SUMM,'
      '1102371414=             NDS,'
      '1102371415=             NDS_SUMM'
      '1102371416=             ,PRICE_CURRENCY'
      '1102371417=             ,SUMM_CURRENCY'
      '1102371418=             ,PRICE_ROZN'
      '1102371419=             ,GG.PRICE'
      '1102371420=             ,T.MARK_CODE'
      '1102371421=             ,T.COST_PRICE'
      '1102371422=        FROM SKLAD_TMP T,'
      '1102371423=             G_PRODUCT GG'
      '1102371424=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '1102371425=      ORDER BY 1'
      '1102371426=      INTO :SKLAD_TMP_,'
      '1102371427=           :RG_PRODUCT_,'
      '1102371428=           :RAMOUNT_,'
      '1102371429=           :RPRICE_,'
      '1102371430=           :RSUMM_,'
      '1102371431=           :RNDS_,'
      '1102371432=           :RNDS_SUMM_'
      '1102371433=           ,:PRICE_CURRENCY_'
      '1102371434=           ,:SUMM_CURRENCY_TMP_'
      '1102371435=           ,:SALE_PRICE_'
      '1102371436=           ,:SALE_PRICE_CUR_'
      '1102371437=           ,:MARK_CODE_'
      '1102371438=           ,:COST_PRICE_'
      '1102371439=  DO BEGIN'
      '1102371440=    INSERT INTO SKLAD'
      '1102371441=    ('
      '1102371442=     SKLAD,'
      '1102371443=     SKLAD_PARENT,'
      '1102371444=     DATE_RECEIPT,'
      '1102371445=     G_CLIENT,'
      '1102371446=     G_PRODUCT,'
      '1102371447=     AMOUNT,'
      '1102371448=     PRICE,'
      '1102371449=     SUMM,'
      '1102371450=     G_PAYMENT_TYPE,'
      '1102371451=     OSNOVANIE,'
      '1102371452=     NOTE,'
      '1102371453=     NDS,'
      '1102371454=     NDS_SUMM,'
      '1102371455=     IS_LAST,'
      '1102371456=     IS_VOZVRAT,'
      '1102371457=     G_TOCHKA'
      '1102371458=     ,PRICE_CURRENCY'
      '1102371459=     ,SUMM_CURRENCY'
      '1102371460=     ,MARK_CODE'
      '1102371461=     ,COST_PRICE'
      '1102371462=    ) VALUES ('
      '1102371463=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '1102371464=     :SKLAD_,'
      '1102371465=     :DATE_RECEIPT_,'
      '1102371466=     :G_CLIENT_,'
      '1102371467=     :RG_PRODUCT_,'
      '1102371468=     :RAMOUNT_,'
      '1102371469=     :RPRICE_,'
      '1102371470=     :RSUMM_,'
      '1102371471=     :G_PAYMENT_TYPE_,'
      '1102371472=     :OSNOVANIE_,'
      '1102371473=     :NOTE_,'
      '1102371474=     COALESCE(:RNDS_, 0),'
      '1102371475=     COALESCE(:RNDS_SUMM_, 0),'
      
        '1102371476=     0, --DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069 +
