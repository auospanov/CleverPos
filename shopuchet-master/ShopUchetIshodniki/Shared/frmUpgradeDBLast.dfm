        'T'
      '110236910=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '110236911=                          GROUP BY ZAKAZ) FROM 1 FOR 9' +
        '99) DETAILS_STR,'
      '110236912=               T.IS_SPISANIE,'
      '110236913=               0,'
      '110236914=               NULL,'
      '110236915=               NULL,'
      '110236916=               NULL,'
      '110236917=               T.SUMM,'
      '110236918=               T.SUMM_FACT,'
      '110236919=               0,'
      '110236920=               0,'
      '110236921=               0'
      '110236922=          FROM ZAKAZ T'
      
        '110236923=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
