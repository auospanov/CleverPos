      '1101825508=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825509=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101825510=                  EXIT;'
      '1101825511=                END'
      '1101825512='
      
        '1101825513=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101825514=            END'
      '1101825515='
      
        '1101825516=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101825517=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101825518=                FROM KASSA K'
      '1101825519=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101825520=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
      '1101825521=                UNION'
      '1101825522=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1101825523=                  FROM KASSA K'
      '1101825524=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1101825525=                   AND K.SUMM = 0'
      '1101825526=                UNION'
      
        '1101825527=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101825528=                FROM KASSA_BEZNAL K'
      '1101825529=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101825530=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA_BEZNAL||'#39'~'#39
      '1101825531=                UNION'
      
        '1101825532=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101825533=                FROM KASSA_BEZNAL K'
      '1101825534=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101825535=                 AND K.SUMM = 0'
      '1101825536=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101825537=            DO BEGIN'
      '1101825538=                PNT_ = '#39'08'#39';'
      
        '1101825539=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_' +
        ', :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101825540=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825541=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '1101825542=                    EXIT;'
      '1101825543=                END'
      '1101825544=            END'
      '1101825545='
      
        '1101825546=            --=======================================' +
        '=========================='
      '1101825547=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101825548=            --=======================================' +
        '=========================='
      
