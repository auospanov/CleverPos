      '11020710='
      '11020711='
      
        '11020712=/******************************************************' +
        '************************/'
      
        '11020713=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11020714=/******************************************************' +
        '************************/'
      '11020715='
      '11020716=ALTER PROCEDURE INS_SKLAD_TMP('
      '11020717=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '11020718=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '11020719=  PRICE_ NUMERIC(15,2),'
      '11020720=  SUMM_ NUMERIC(15,2),'
      '11020721=  NDS_ NUMERIC(15,2),'
      '11020722=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '11020723=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY =' +
        ' 0,'
      
        '11020724=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = 0' +
        ','
      
        '11020725=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZ' +
        'N_PROC = 0,'
      '11020726=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0,'
      
        '11020727=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_' +
        'PROC = 0,'
      '11020728=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0,'
      
        '11020729=  CHANGE_SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.CHANGE_SA' +
        'LE_PRICE = 0,'
      '11020730=  MARK_CODE_ TYPE OF COLUMN SKLAD_TMP.MARK_CODE = '#39#39')'
      '11020731=RETURNS ('
      '11020732=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '11020733=  ERR_CODE INTEGER,'
      '11020734=  ERR_MSG VARCHAR(1024))'
      '11020735=AS'
      
        '11020736=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TMP' +
        #39';'
      '11020737=BEGIN'
      '11020738='
      '11020739=  IF (CHAR_LENGTH(MARK_CODE_) = 0) THEN'
      '11020740=      SELECT T.SKLAD'
      '11020741=        FROM SKLAD_TMP T'
      '11020742=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11020743=         AND T.PRICE = :PRICE_'
      '11020744=        INTO :SKLAD_;'
      '11020745='
      '11020746=  IF (SKLAD_ IS NOT NULL) THEN'
      '11020747=    UPDATE SKLAD_TMP T'
      '11020748=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '11020749=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '11020750=     WHERE T.SKLAD = :SKLAD_;'
      '11020751='
      '11020752=  ELSE BEGIN'
      '11020753=      IF (PRICE_ = 0) THEN BEGIN'
      '11020754=        CHARGE_ROZN_PROC_ = 0;'
      '11020755=        CHARGE_OPT_PROC_ = 0;'
      '11020756=      END ELSE BEGIN'
      
        '11020757=        CHARGE_ROZN_PROC_ = ROUND((:PRICE_ROZN_ - :PRIC' +
        'E_) * 100 / :PRICE_, 2);'
      
        '11020758=        CHARGE_OPT_PROC_ = ROUND((:PRICE_OPT_ - :PRICE_' +
        ') * 100 / :PRICE_, 2);'
      '11020759=      END'
      '11020760='
      
        '11020761=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '11020762=                            CHARGE_ROZN_PROC,'
      '11020763=                            PRICE_ROZN,'
      '11020764=                            CHARGE_OPT_PROC,'
      
        '11020765=                            PRICE_OPT, CHANGE_SALE_PRIC' +
        'E, MARK_CODE)'
      
        '11020766=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, ' +
        ':AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '11020767=        ,:PRICE_CURRENCY_'
      '11020768=        ,:SUMM_CURRENCY_'
      '11020769=        ,:CHARGE_ROZN_PROC_'
      '11020770=        ,:PRICE_ROZN_'
      '11020771=        ,:CHARGE_OPT_PROC_'
      '11020772=        ,:PRICE_OPT_'
      
        '11020773=        ,0        -- :CHANGE_SALE_PRICE_ '#1055#1054' '#1048#1044#1045#1045' '#1059#1046#1045' '#1053#1045 +
        ' '#1053#1059#1046#1053#1054', '#1062#1045#1053#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1048' '#1058#1040#1050', '#1058#1045#1055#1045#1056#1068' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1042#1054#1054#1041#1065#1045' '#1053#1048#1063#1045#1043#1054' '#1053#1045 +
        ' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071', '#1055#1054#1047#1046#1045' '#1053#1040#1044#1054' '#1059#1041#1056#1040#1058#1068' 15.10.2021'
      '11020774=        ,:MARK_CODE_)'
      '11020775=      RETURNING SKLAD'
      '11020776=      INTO :SKLAD_;'
      '11020777=  END'
      '11020778=end'
      '11020779=;'
      '11020780='
      '11020781='
      
        '11020782=UPDATE SYSTEM_SETUP SET S_VALUE = 110207 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '11020783=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
