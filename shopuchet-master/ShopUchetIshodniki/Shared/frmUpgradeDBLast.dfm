        '1101322755=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101322756=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101322757=            ELSE'
      
        '1101322758=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101322759='
      '1101322760=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101322761=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101322762='
      
