      '110231308=  VES_GRAMM_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM)'
      '110231309=RETURNS ('
      '110231310=  ERR_CODE INTEGER,'
      '110231311=  ERR_MSG VARCHAR(1000))'
      '110231312=AS'
      
        '110231313=/*ROUND_MODE_ 0 - '#1076#1077#1089#1103#1090#1099#1077', 1 - '#1094#1077#1083#1099#1077', 2 '#1076#1077#1089#1103#1090#1082#1080', 3 '#1089#1086#1090 +
        #1085#1080', 4 '#1090#1099#1089#1103#1095#1080
      '110231314='
      '110231315=CHANGE_KIT_TYPE_ - '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040
      '110231316=*/'
      
        '110231317=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '110231318=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE' +
        ';'
      
        '110231319=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.V' +
        'OLUME_PRICE;'
      '110231320=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '110231321=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '110231322=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110231323=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '110231324=BEGIN'
      '110231325='
      '110231326=  SQL_STR_ = '#39'UPDATE G_PRODUCT P'#39'||'
      '110231327=               '#39' SET '#39';'
      '110231328='
      '110231329=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110231330='
      '110231331=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '110231332=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '110231333=      IF (ROUND_MODE_ = 0) THEN'
      '110231334=          ROUND_ = 1;'
      '110231335=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '110231336=          ROUND_ = 0;'
      '110231337=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '110231338=          ROUND_ = -1;'
      '110231339=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '110231340=          ROUND_ = -2;'
      '110231341=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '110231342=          ROUND_ = -3;'
      '110231343='
      '110231344=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' %'
      '110231345=      IF (MODE_ = 0) THEN'
      
        '110231346=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '110231347=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '110231348='
      '110231349=      -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '110231350=      ELSE IF (MODE_ = 1) THEN'
      
        '110231351=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110231352=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110231353='
      '110231354=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' %'
      '110231355=      ELSE IF (MODE_ = 2) THEN'
      
        '110231356=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' * (1 - '#39'||:NEW_VAL_||'#39'/100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '110231357=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE * (1 - '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '110231358='
      '110231359=      -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '110231360=      ELSE IF (MODE_ = 3) THEN'
      
        '110231361=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        ' - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110231362=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110231363='
      '110231364=      --'#1048#1047#1052#1045#1053#1048#1058#1068' '#1055#1054' '#1042#1040#1051#1070#1058#1045
      '110231365=      ELSE IF (MODE_ = 4) THEN'
      
        '110231366=        SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.PRICE' +
        '/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110231367=                   '#39' P.VOLUME_PRICE = ROUND(P.VOLUME_P' +
        'RICE/'#39'||:COURSE_OLD_||'#39' * '#39'||:COURSE_NEW_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110231368='
      '110231369=      ELSE BEGIN'
      '110231370=        SELECT ID'
      '110231371=          FROM CUR_PARAMS'
      '110231372=         WHERE CUR_PARAMS = 2'
      '110231373=          INTO :G_TOCHKA_;'
      '110231374='
      '110231375=        IF (WHAT_PRICE_ = 0) THEN'
      
        '110231376=          SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND((SELE' +
        'CT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_||'#39', 0))' +
        ' * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '110231377=        ELSE'
      
        '110231378=          SQL_STR_ = SQL_STR_ ||'#39'P.VOLUME_PRICE = ROUN' +
        'D((SELECT * FROM get_last_self_price(P.g_product, '#39'||:G_TOCHKA_|' +
        '|'#39', 0)) * (1 + '#39'||:NEW_VAL_||'#39' / 100), '#39'||:ROUND_||'#39')'#39';'
      '110231379=      END'
      '110231380=  END'
      '110231381='
      '110231382=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '110231383=  IF (CHANGE_CATEGORY_ = 1) THEN BEGIN'
      '110231384=    IF (CHANGE_PRICE_ = 1) THEN'
      '110231385=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110231386='
      
        '110231387=    SQL_STR_ = SQL_STR_ ||'#39'P.G_PRODUCT_PAR = '#39'||:NEW_C' +
        'ATEGORY_;'
      '110231388=  END'
      '110231389='
      '110231390=  -- '#1052#1045#1053#1071#1070' '#1052#1048#1053' '#1054#1057#1058#1040#1058#1054#1050
      '110231391=  IF (CHANGE_MIN_AMOUNT_ = 1) THEN BEGIN'
      '110231392=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_) > 0) THEN'
      '110231393=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110231394='
      
        '110231395=    SQL_STR_ = SQL_STR_ ||'#39'P.MIN_AMOUNT = '#39'||:NEW_MIN_' +
        'AMOUNT_;'
      '110231396=  END'
      '110231397='
      '110231398=  -- '#1052#1045#1053#1071#1070' '#1050#1054#1052#1048#1057#1057#1048#1070' '#1055#1056#1054#1044#1040#1042#1062#1040
      '110231399=  IF (CHANGE_SALES_COMM_ = 1) THEN BEGIN'
      
        '110231400=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_) > 0) THEN'
      '110231401=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110231402='
      
        '110231403=    SQL_STR_ = SQL_STR_ ||'#39'P.SALES_COMM = '#39'||:NEW_SALE' +
        'S_COMM_;'
      '110231404=  END'
      '110231405='
      
        '110231406=  -- '#1052#1045#1053#1071#1070' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040' - '#1057' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1053#1040' '#1055#1056#1054#1044#1059#1050#1058' '#1048#1051#1048' '#1053 +
        #1040#1054#1041#1054#1056#1054#1058
      '110231407=  IF (CHANGE_KIT_TYPE_ > 1) THEN BEGIN'
      
        '110231408=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_ + CHANGE_SALES_COMM_) > 0) THEN'
      '110231409=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110231410='
      
        '110231411=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KIT = '#39'||:CHANGE_KIT_T' +
        'YPE_;'
      '110231412='
      
        '110231413=    -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1058#1048#1055' '#1058#1054#1042#1040#1056#1040' '#1057' "'#1057#1054#1057#1058#1040#1042#1053#1054#1049'" '#1053#1040' "'#1055#1056#1054#1044 +
        #1059#1050#1058'", '#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1053#1059#1051#1048#1058#1068' '#1042#1057#1045' '#1054#1057#1058#1040#1058#1050#1048' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042
      '110231414=    IF (CHANGE_KIT_TYPE_ = 2) THEN'
      '110231415=      UPDATE LT_SKLAD_PRODUCT P'
      '110231416=         SET P.AMOUNT = 0,'
      '110231417=             P.NEED_TO_EXPORT = 1'
      '110231418=       WHERE EXISTS (SELECT 1'
      '110231419=                       FROM G_PRODUCT GP'
      '110231420=                      WHERE GP.G_PRODUCT = P.G_PRODUCT'
      '110231421=                        AND GP.IS_KIT = 1'
      
        '110231422=                        AND ((:G_PRODUCT_ CONTAINING '#39 +
        '~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110231423=                             OR'
      
        '110231424=                             (GP.G_PRODUCT = GP.G_PROD' +
        'UCT AND :G_PRODUCT_ IS NULL)'
      '110231425=                            )'
      '110231426=                        AND ('
      
        '110231427=                             ((GP.G_PRODUCT_PAR IN (SE' +
        'LECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE :G_CATEGORY_ CONTAINI' +
        'NG '#39'~'#39'||PT.G_PRODUCT||'#39'~'#39')) AND :g_category_ IS NOT NULL)'
      '110231428=                              OR'
      
        '110231429=                             (GP.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT_PAR AND :g_category_ IS NULL)'
      '110231430=                            )'
      '110231431=                    );'
      '110231432=  END'
      '110231433='
      
        '110231434=  --'#1052#1045#1053#1071#1070' '#1055#1056#1048#1047#1053#1040#1050' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1058#1054#1042#1040#1056' '#1042' KASPI '#1052#1040#1043#1040#1047#1048#1053' '#1048#1051#1048' ' +
        #1053#1045#1058
      '110231435=  IF (:IS_KASPI_SHOP_ = 1) THEN'
      '110231436=  BEGIN'
      
        '110231437=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_ + CHANGE_SALES_COMM_ + CHANGE_KIT_TYPE_) > 0) THEN'
      '110231438=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110231439='
      
        '110231440=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KASPI_SHOP = '#39'||:IS_KA' +
        'SPI_SHOP_MODE_;'
      '110231441=  END'
      '110231442='
      '110231443=  --'#1052#1045#1053#1071#1070' '#1042#1045#1057' '#1042' '#1043#1056#1040#1052#1052#1040#1061
      '110231444=  IF (:CHANGE_VES_GRAMM_ = 1) THEN'
      '110231445=  BEGIN'
      
        '110231446=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_ + CHANGE_SALES_COMM_ + CHANGE_KIT_TYPE_ + IS_KASPI_SHOP' +
        '_) > 0) THEN'
      '110231447=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110231448='
      
        '110231449=    SQL_STR_ = SQL_STR_ ||'#39'P.VES_GRAMM = '#39'||:VES_GRAMM' +
        '_;'
      '110231450=  END'
      '110231451='
      '110231452=  SQL_STR_ = SQL_STR_ ||'#39'  WHERE P.IS_ACTIVE = 1'#39';'
      '110231453='
      '110231454=  IF (CHANGE_KIT_TYPE_ = 0) THEN'
      '110231455=    SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_KIT <> 1'#39';'
      '110231456='
      '110231457=  SQL_STR_ = SQL_STR_ ||'#39' AND P.IS_CATEGORY = 0'#39';'
      '110231458='
      '110231459=  IF (g_category_ IS NOT NULL) THEN'
      
        '110231460=    SQL_STR_ = SQL_STR_ ||'#39' AND P.G_PRODUCT_PAR IN (SE' +
        'LECT PT.G_PRODUCT FROM P_REP_TREE PT WHERE '#39#39#39'||G_CATEGORY_||'#39#39#39 +
        ' CONTAINING '#39#39'~'#39#39'||PT.G_PRODUCT||'#39#39'~'#39#39')'#39';'
      '110231461='
      '110231462='
      '110231463=  IF (G_PRODUCT_ IS NOT NULL) THEN'
      
        '110231464=    SQL_STR_ = SQL_STR_ ||'#39' AND '#39#39#39'||G_PRODUCT_||'#39#39#39' C' +
        'ONTAINING '#39#39'~'#39#39'||P.G_PRODUCT||'#39#39'~'#39#39#39';'
      '110231465='
      '110231466=  --ERR_CODE = -20500;'
      '110231467=  --ERR_MSG = SQL_STR_; EXIT;'
      '110231468='
      '110231469=  EXECUTE STATEMENT :SQL_STR_;'
      '110231470=END'
      '110231471=;'
      '110231472='
      '110231473=ALTER PROCEDURE P_REP_KASSIR('
      '110231474=  DATE_BEGIN_ DATE,'
      '110231475=  DATE_END_ DATE,'
      '110231476=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110231477=RETURNS ('
      '110231478=  PERIOD_ VARCHAR(40),'
      '110231479=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '110231480=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '110231481=  IN_SUMM_NONCASH_ TYPE OF MY_NUMERIC,'
      '110231482=  OUT_SUMM_NONCASH_ TYPE OF MY_NUMERIC,'
      '110231483=  ROWCOL INTEGER,'
      '110231484=  Z_DATE VARCHAR(60),'
      '110231485=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110231486=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110231487=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110231488=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110231489=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '110231490=AS'
      '110231491=/*'
      
        '110231492='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071',' +
        ' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '110231493=*/'
      '110231494=DECLARE VARIABLE SORT_COL INTEGER;'
      '110231495=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '110231496=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '110231497=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '110231498=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = 0' +
        ';'
      
        '110231499=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = 0' +
        ';'
      
        '110231500=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      
        '110231501=DECLARE VARIABLE SUMM_SALES_ALL_ TYPE OF NUMERIC_NULL ' +
        '= 0;'
      
        '110231502=DECLARE VARIABLE SUMM_RETURNS_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '110231503=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      
        '110231504=DECLARE VARIABLE SUMM_PRIHOD_BEZNAL_ TYPE OF NUMERIC_N' +
        'ULL = 0;'
      
        '110231505=DECLARE VARIABLE SUMM_RASHOD_BEZNAL_ TYPE OF NUMERIC_N' +
        'ULL = 0;'
      
        '110231506=DECLARE VARIABLE SUMM_PRIHOD_ALL_BEZNAL_ TYPE OF NUMER' +
        'IC_NULL = 0;'
      
        '110231507=DECLARE VARIABLE SUMM_RASHOD_ALL_BEZNAL_ TYPE OF NUMER' +
        'IC_NULL = 0;'
      '110231508=BEGIN'
      
        '110231509=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110231510=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110231511='
      '110231512=  SELECT S."INPUT"'
      '110231513=    FROM kassa_state S'
      '110231514=   WHERE S.k_date = :DATE_BEGIN_'
      '110231515=     AND S.g_tochka = :G_TOCHKA_'
      '110231516=    INTO :IN_SUMM_;'
      '110231517='
      '110231518=  IF (ROW_COUNT = 0) THEN'
      '110231519=    SELECT S."OUTPUT"'
      '110231520=      FROM kassa_state S'
      '110231521=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '110231522=                         FROM KASSA_STATE ST'
      '110231523=                        WHERE ST.k_date < :DATE_BEGIN_'
      '110231524=                         AND ST.g_tochka = :G_TOCHKA_)'
      '110231525=      AND S.g_tochka = :G_TOCHKA_'
      '110231526=      INTO :IN_SUMM_;'
      '110231527='
      '110231528=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '110231529='
      '110231530=  SELECT S."INPUT"'
      '110231531=    FROM kassa_beznal_state S'
      '110231532=   WHERE S.k_date = :DATE_BEGIN_'
      '110231533=    INTO :IN_SUMM_NONCASH_;'
      '110231534='
      '110231535=  IF (ROW_COUNT = 0) THEN'
      '110231536=    SELECT S."OUTPUT"'
      '110231537=      FROM kassa_beznal_state S'
      '110231538=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '110231539=                         FROM KASSA_BEZNAL_STATE ST'
      
        '110231540=                        WHERE ST.k_date < :DATE_BEGIN_' +
        ')'
      '110231541=      INTO :IN_SUMM_NONCASH_;'
      '110231542='
      '110231543=  IN_SUMM_NONCASH_ = COALESCE(IN_SUMM_NONCASH_, 0);'
      '110231544='
      
        '110231545=  /* '#1050#1054#1056#1054#1063#1045' '#1048#1047'-'#1047#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048' '#1063#1058#1054'-'#1058#1054' '#1050#1056#1048#1042#1054' '#1057' '#1044#1042#1048#1046#1045#1053#1048 +
        #1045#1052' '#1044#1045#1053#1045#1043', '#1071' '#1061#1059#1049' '#1055#1054#1049#1052#1048' '#1055#1054#1063#1045#1052#1059' '#1048' '#1048#1047'-'#1047#1040' '#1063#1045#1043#1054' '#1047#1040#1045#1041#1040#1051#1054' '#1057#1059#1050#1040
      
