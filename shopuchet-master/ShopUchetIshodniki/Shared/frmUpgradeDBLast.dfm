      '110135286='
      '110135287='
      
        '110135288=/*****************************************************' +
        '*************************/'
      
        '110135289=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110135290=/*****************************************************' +
        '*************************/'
      '110135291=ALTER PROCEDURE DEL_ZAKAZ_DETAIL('
      '110135292=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '110135293=RETURNS ('
      '110135294=  ERR_CODE INTEGER,'
      '110135295=  ERR_MSG VARCHAR(1024))'
      '110135296=AS'
      
        '110135297=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ_DET' +
        'AIL'#39';'
      '110135298=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '110135299=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110135300=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110135301=DECLARE VARIABLE IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_' +
        'SPISANIE;'
      
        '110135302=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '110135303=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110135304=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110135305=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110135306=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110135307=DECLARE VARIABLE NOT_MINUS_OSTATOK_ TYPE OF COLUMN ZAK' +
        'AZ.NOT_MINUS_OSTATOK;'
      '110135308=BEGIN'
      '110135309=  PNT_ = '#39'00'#39';'
      
        '110135310=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1040' '#1042#1044#1056#1059#1043' '#1059#1044#1040#1051#1071#1070' '#1054#1055#1051#1040#1058#1059' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051 +
        #1048#1047#1040#1062#1048#1070
      '110135311=  SELECT Z.IS_SPISANIE,'
      '110135312=         Z.G_TOCHKA'
      '110135313=         ,Z.IS_RESERVE'
      '110135314=         ,Z.NOT_MINUS_OSTATOK'
      '110135315=    FROM ZAKAZ Z'
      '110135316=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110135317=    INTO :IS_SPISANIE_,'
      '110135318=         :G_TOCHKA_'
      '110135319=         ,:IS_RESERVE_'
      '110135320=         ,:NOT_MINUS_OSTATOK_;'
      '110135321='
      
        '110135322=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1048#1051#1048' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040'. '#1058#1054' '#1057 +
        #1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110135323=  if (IS_SPISANIE_ <> 2) then BEGIN'
      '110135324=      FOR SELECT G_PRODUCT,'
      '110135325=                 AMOUNT'
      '110135326=            FROM ZAKAZ_DETAILS Z'
      '110135327=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110135328=           INTO :G_PRODUCT_,'
      '110135329=                :AMOUNT_'
      '110135330=      DO BEGIN'
      '110135331=        BEGIN'
      
        '110135332=            -- '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1050' '#1054#1057#1053#1054#1042#1053#1054#1052#1059' ' +
        #1054#1057#1058#1040#1058#1050#1059
      
        '110135333=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK_' +
        ' = 0) THEN'
      '110135334=                UPDATE LT_SKLAD_PRODUCT LT'
      
        '110135335=                   SET LT.AMOUNT = LT.AMOUNT + :AMOUNT' +
        '_'
      '110135336=                 WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110135337=                   AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110135338='
      
        '110135339=            -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1056#1045#1047#1045#1056#1042', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1054#1058' '#1047#1040#1056#1045#1047#1045#1056#1042 +
        #1048#1056#1054#1042#1040#1053#1053#1054#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040
      '110135340=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '110135341=                UPDATE LT_SKLAD_PRODUCT LT'
      
        '110135342=                   SET LT.AMOUNT_RESERVE = LT.AMOUNT_R' +
        'ESERVE - :AMOUNT_'
      '110135343=                 WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110135344=                   AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110135345=        WHEN EXCEPTION NOL_EXCEPTION DO'
      '110135346=          begin'
      '110135347=            ERR_CODE = -20500;'
      
        '110135348=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042 +
        ' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1086#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072 +
        #1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110135349=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110135350=            EXIT;'
      '110135351=          end'
      '110135352=        END'
      '110135353=      END'
      '110135354='
      
        '110135355=  --**************************************************' +
        '*********'
      
        '110135356=  -- '#1045#1057#1051#1048' '#1059#1044#1040#1051#1071#1045#1058#1057#1071' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051', '#1058#1054' '#1053#1040#1044#1054' '#1042 +
        #1054#1057#1057#1058#1040#1053#1054#1042#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1045' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      
        '110135357=  -- '#1048#1065#1059' '#1055#1054' '#1044#1040#1053#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1048' '#1055#1056#1048#1041 +
        #1040#1042#1051#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050' '#1053#1045#1052#1059', '#1045#1057#1051#1048' '#1042#1045#1057#1068' '#1058#1054#1042#1040#1056' '#1054#1055#1051#1040#1063#1045#1053', '#1058#1054' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059 +
        #1070' '#1047#1040#1055#1048#1057#1068
      '110135358=  END ELSE BEGIN'
      '110135359=      FOR SELECT ZD.AMOUNT,'
      '110135360=                 ZD.PRICE,'
      '110135361=                 ZD.DISCOUNT_TENGE,'
      '110135362=                 LZ.ZAKAZ_NA_REAL'
      '110135363=            FROM ZAKAZ Z,'
      '110135364=                 ZAKAZ_DETAILS ZD,'
      '110135365=                 LT_ZAKAZ_REAL LZ'
      '110135366=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110135367=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110135368=             AND ZD.ZAKAZ_DETAILS = LZ.ZAKAZ_DETAILS'
      '110135369=           INTO :AMOUNT_,'
      '110135370=                :PRICE_,'
      '110135371=                :DISCOUNT_TENGE_,'
      '110135372=                :ZAKAZ_NA_REAL_'
      '110135373=      DO BEGIN'
      '110135374=          UPDATE ZAKAZ_NA_REAL ZRR'
      
        '110135375=             SET ZRR.AMOUNT_PAYED = ZRR.AMOUNT_PAYED -' +
        ' :AMOUNT_,'
      
        '110135376=                 ZRR.SUMM_PAYED = ZRR.SUMM_PAYED - :AM' +
        'OUNT_ * (:PRICE_ - :DISCOUNT_TENGE_),'
      '110135377=                 ZRR.IS_PAYED_ALL = 0'
      '110135378=           WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110135379=      END'
      '110135380='
      '110135381=      -- '#1059#1044#1040#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1048#1047' '#1057#1042#1071#1047#1059#1070#1065#1045#1049' '#1058#1040#1041#1051#1048#1062#1067
      
        '110135382=      DELETE FROM LT_ZAKAZ_REAL R WHERE R.ZAKAZ_DETAIL' +
        'S IN (SELECT ZAKAZ_DETAILS FROM ZAKAZ_DETAILS ZD WHERE ZD.ZAKAZ ' +
        '= :ZAKAZ_);'
      '110135383=  END'
      '110135384='
      '110135385=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '110135386=  PNT_ = '#39'03'#39';'
      '110135387=  DELETE from zakaz_DETAILS z'
      '110135388=  WHERE z.zakaz = :zakaz_;'
      '110135389='
      '110135390=when sqlcode -530 DO'
      '110135391=  begin'
      '110135392=    ERR_CODE = -20500;'
      
        '110135393=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      
        '110135394=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110135395=  end'
      '110135396=WHEN ANY DO'
      '110135397=  begin'
      '110135398=    ERR_CODE = sqlcode;'
      '110135399=  end'
      '110135400=end'
      '110135401=;'
      '110135402='
      '110135403=ALTER PROCEDURE G_GET_SYTEM_SETUP('
      
        '110135404=  SYSTEM_SETUP_ TYPE OF COLUMN SYSTEM_SETUP.SYSTEM_SET' +
        'UP)'
      '110135405=RETURNS ('
      '110135406=  S_VALUE_ TYPE OF COLUMN SYSTEM_SETUP.S_VALUE,'
      '110135407=  STR_VALUE_ TYPE OF COLUMN SYSTEM_SETUP.STR_VALUE,'
      '110135408=  ERR_CODE INTEGER,'
      '110135409=  ERR_MSG VARCHAR(1024))'
      '110135410=AS'
      '110135411=begin'
      '110135412=    SELECT D.S_VALUE, D.STR_VALUE'
      '110135413=    FROM SYSTEM_SETUP D'
      '110135414=    WHERE D.SYSTEM_SETUP = :SYSTEM_SETUP_'
      '110135415=    INTO :S_VALUE_, :STR_VALUE_;'
      '110135416=end'
      '110135417=;'
      '110135418='
      '110135419=ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '110135420=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110135421=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '110135422=RETURNS ('
      '110135423=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110135424=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110135425=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110135426=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110135427=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110135428=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110135429=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110135430=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110135431=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110135432=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110135433=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110135434=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110135435=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110135436=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110135437=  CNT_Z_ INTEGER,'
      
        '110135438=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110135439=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110135440=  HAVERIGHT_ INTEGER,'
      '110135441=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110135442=  NOT_MINUS_OSTATOK_ TYPE OF COLUMN SKLAD_PARENT.IS_EX' +
        'PECTED,'
      '110135443=  ERR_CODE INTEGER,'
      '110135444=  ERR_MSG VARCHAR(1024))'
      '110135445=AS'
      '110135446=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      
        '110135447=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110135448=begin'
      '110135449='
      '110135450=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1086#1076#1072#1078', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110135451=  /*CNT_Z_ = 0;'
      '110135452=  SELECT COUNT(*)'
      '110135453=    FROM (SELECT Z.ZAKAZ'
      '110135454=            FROM ZAKAZ Z ROWS 1 TO 100)'
      '110135455=    INTO :CNT_Z_;*/'
      '110135456='
      
        '110135457=  --**************************************************' +
        '**************'
      '110135458=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '110135459=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110135460=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '110135461=          SELECT'
      '110135462=            T.G_TOCHKA,'
      '110135463=            T.Z_DATE,'
      '110135464=            T.Z_TIME,'
      '110135465=            T.G_CLIENT,'
      '110135466=            T.G_PAYMENT_TYPE,'
      '110135467=            T.OSNOVANIE,'
      '110135468=            T.NOTE,'
      '110135469=            T.SUMM,'
      '110135470=            T.SUMM_FACT,'
      '110135471=            T.SUMM_BONUS,'
      '110135472=            T.summ_bonus_got,'
      '110135473=            T.IS_PAYED_ALL,'
      '110135474=            COALESCE(T.BY_RECIPE, 0)'
      '110135475=            ,IS_RESERVE'
      '110135476=            ,NOT_MINUS_OSTATOK'
      '110135477=          FROM ZAKAZ T'
      '110135478=          WHERE T.ZAKAZ = :ZAKAZ_'
      '110135479=          INTO'
      '110135480=            :G_TOCHKA_,'
      '110135481=            :Z_DATE_,'
      '110135482=            :Z_TIME_,'
      '110135483=            :G_CLIENT_,'
      '110135484=            :G_PAYMENT_TYPE_,'
      '110135485=            :OSNOVANIE_,'
      '110135486=            :NOTE_,'
      '110135487=            :SUMM_,'
      '110135488=            :SUMM_FACT_,'
      '110135489=            :SUMM_PAY_BONUS_,'
      '110135490=            :SUMM_GOT_BONUS_,'
      '110135491=            :IS_PAYED_ALL_,'
      '110135492=            :BY_RECIPE_,'
      '110135493=            :IS_RESERVE_,'
      '110135494=            :NOT_MINUS_OSTATOK_;'
      '110135495='
      '110135496=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '110135497=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS,' +
        ' ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_' +
        'TENGE,'
      
        '110135498=                                        DISCOUNT_SUMM,' +
        ' NDS, NDS_SUMM, COST_PRICE)'
      
        '110135499=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AM' +
        'OUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110135500=                   DISCOUNT_SUMM, NDS, NDS_SUMM, COST_' +
        'PRICE'
      '110135501=              FROM ZAKAZ_DETAILS'
      '110135502=             WHERE ZAKAZ = :ZAKAZ_'
      '110135503=             ORDER BY 1;'
      '110135504='
      '110135505=          -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110135506=          SELECT K.G_PRIHOD_RASHOD,'
      '110135507=                 K.SUMM'
      
        '110135508=            FROM (SELECT * FROM KASSA UNION SELECT * F' +
        'ROM KASSA_BEZNAL) K'
      '110135509=           WHERE K.ZAKAZ = :ZAKAZ_'
      '110135510=             AND K.G_PRIHOD_RASHOD NOT IN (1, -5)'
      '110135511=            INTO :G_PRIHOD_,'
      '110135512=                 :SUMM_PRIHOD_;'
      '110135513=      END'
      '110135514='
      
        '110135515=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RET' +
        'URNING_VALUES :PAYMENTS_;'
      '110135516=  END'
      '110135517=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110135518=  --*************************************************'
      '110135519=  --*************************************************'
      '110135520=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110135521=  ELSE BEGIN'
      '110135522=    SELECT'
      '110135523=        T.G_CLIENT,'
      '110135524=        T.DATE_RECEIPT,'
      '110135525=        T.TIME_RECEIPT,'
      '110135526=        T.G_TOCHKA,'
      '110135527=        T.G_PAYMENT_TYPE,'
      '110135528=        T.OSNOVANIE,'
      '110135529=        T.NOTE,'
      '110135530=        T.SUMM,'
      '110135531=        T.SUMM_FACT,'
      '110135532=        0,'
      '110135533=        0,'
      '110135534=        0,'
      '110135535=        T.IS_EXPECTED'
      '110135536=      FROM SKLAD_PARENT T'
      '110135537=      WHERE T.SKLAD = :ZAKAZ_'
      '110135538=      INTO'
      '110135539=        :G_TOCHKA_,'
      '110135540=        :Z_DATE_,'
      '110135541=        :Z_TIME_,'
      '110135542=        :G_CLIENT_,'
      '110135543=        :G_PAYMENT_TYPE_,'
      '110135544=        :OSNOVANIE_,'
      '110135545=        :NOTE_,'
      '110135546=        :SUMM_,'
      '110135547=        :SUMM_FACT_,'
      '110135548=        :SUMM_PAY_BONUS_,'
      '110135549=        :IS_PAYED_ALL_,'
      '110135550=        :BY_RECIPE_,'
      '110135551=        :NOT_MINUS_OSTATOK_;'
      '110135552='
      '110135553=      -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110135554=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '110135555=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '110135556=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE,' +
        ' SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047#1040 +
        #1055#1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '110135557=        FROM SKLAD'
      '110135558=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '110135559=      ORDER BY 1;'
      '110135560=  END'
      '110135561='
      
        '110135562=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110135563=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110135564=  HaveRight_ = 1;'
      '110135565=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '110135566=    SELECT ID'
      '110135567=      FROM CUR_PARAMS'
      '110135568=     WHERE CUR_PARAMS = 1'
      '110135569=      INTO :G_OFFICIAL_CUR_;'
      '110135570='
      
        '110135571=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110135572=      HaveRight_ = 1;'
      '110135573=    else'
      
        '110135574=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110135575='
      '110135576=    /* '#1040#1053#1040#1051#1048#1047' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045
      '110135577=    if (HaveRight_ = 0) then begin'
      
        '110135578=      ERR_CODE = -20500; // '#1053#1077' '#1076#1086#1089#1090#1072#1090#1086#1095#1085#1086' '#1087#1088#1072#1074' '#1076#1083#1103' '#1074#1099#1087 +
        #1086#1083#1085#1077#1085#1080#1103' '#1086#1087#1077#1088#1072#1094#1080#1080
      
        '110135579=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' '#1085#1077' '#1086 +
        #1073#1083#1072#1076#1072#1077#1090#1077' '#1087#1088#1072#1074#1086#1084' '#1076#1083#1103' '#1088#1077#1076#1072#1082#1090#1080#1088#1086#1074#1072#1085#1080#1103' '#1085#1072#1082#1083#1072#1076#1085#1099#1093#39'||ascii_char(10)||'#39 +
        #1079#1072' '#1087#1088#1086#1096#1083#1099#1077' '#1076#1072#1090#1099'.'#39') RETURNING_VALUES(:ERR_MSG);'
      '110135580=      EXIT;'
      '110135581=    end*/'
      '110135582=  END'
      '110135583=end'
      '110135584=;'
      '110135585='
      '110135586=ALTER PROCEDURE INS_ZAKAZ('
      '110135587=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110135588=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110135589=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110135590=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110135591=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110135592=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110135593=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110135594=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110135595=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110135596=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110135597=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110135598=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110135599=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110135600=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110135601=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110135602=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110135603=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110135604=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110135605=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110135606=  IS_MEBEL_ INTEGER = 0,'
      
        '110135607=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110135608=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      '110135609=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '110135610=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '110135611=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110135612=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110135613=  NOT_MINUS_OSTATOK_ INTEGER = 0)'
      '110135614=RETURNS ('
      '110135615=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110135616=  ERR_CODE INTEGER,'
      '110135617=  ERR_MSG VARCHAR(1024))'
      '110135618=AS'
      '110135619=/*'
      '110135620=IS_SPISANIE_'
      '110135621=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110135622=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110135623=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110135624=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110135625='
      '110135626='
      
        '110135627=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '110135628=*/'
      '110135629=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110135630=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110135631=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110135632=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110135633=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110135634=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110135635=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110135636=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110135637=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110135638=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110135639=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110135640=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110135641=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110135642=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110135643=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '110135644=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110135645=DECLARE VARIABLE CNT_ INTEGER;'
      '110135646=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110135647=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110135648=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110135649=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110135650=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110135651=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110135652=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110135653=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110135654=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110135655=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110135656=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110135657=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110135658=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110135659=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110135660=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110135661=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110135662=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110135663=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      '110135664=BEGIN'
      '110135665='
      
        '110135666=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110135667=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110135668=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110135669=  IF (CNT_ = 0) THEN BEGIN'
      '110135670=    ERR_CODE = -20500;'
      
        '110135671=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110135672=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110135673=    EXIT;'
      '110135674=  END'
      '110135675='
      '110135676=  IF (G_TOCHKA_ IS NULL) THEN'
      '110135677=    SELECT ID'
      '110135678=      FROM CUR_PARAMS'
      '110135679=     WHERE CUR_PARAMS = 2'
      '110135680=      INTO :G_TOCHKA_;'
      '110135681='
      '110135682=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110135683=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110135684=      PNT_ = '#39'01'#39';'
      
        '110135685=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110135686=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110135687=      ELSE'
      '110135688=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110135689='
      '110135690=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110135691=      SELECT G.G_OFFICIAL,'
      '110135692=             G.DO_NOT_SALES_COMM,'
      '110135693=             G.FM||'#39' '#39'||G.NM'
      '110135694=        FROM G_OFFICIAL G'
      
        '110135695=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110135696=        INTO :G_OFFICIAL_,'
      '110135697=             :DO_NOT_SALES_COMM_,'
      '110135698=             :OFFICIAL_NAME_;'
      '110135699='
      '110135700=      INSERT INTO ZAKAZ'
      '110135701=      ('
      '110135702=       ZAKAZ,'
      '110135703=       G_TOCHKA,'
      '110135704=       Z_DATE,'
      '110135705=       Z_TIME,'
      '110135706=       G_CLIENT,'
      '110135707=       G_PAYMENT_TYPE,'
      '110135708=       OSNOVANIE,'
      '110135709=       IS_SPISANIE,'
      '110135710=       NOTE,'
      '110135711=       SUMM,'
      '110135712=       SUMM_FACT,'
      '110135713=       SUMM_BONUS,'
      '110135714=       IS_PAYED_ALL'
      '110135715=       ,G_OFFICIAL'
      '110135716=       ,BY_RECIPE'
      '110135717=       ,SUMM_BONUS_GOT'
      '110135718=       ,IS_RESERVE'
      '110135719=       ,SUMM_CASH'
      '110135720=       ,SUMM_NONCASH'
      '110135721=       ,NOT_MINUS_OSTATOK'
      '110135722=      ) VALUES ('
      '110135723=       GEN_ID(GEN_ZAKAZ, 1),'
      '110135724=       :G_TOCHKA_,'
      '110135725=       :Z_DATE_,'
      '110135726=       :Z_TIME_,'
      '110135727=       :G_CLIENT_,'
      '110135728=       :G_PAYMENT_TYPE_,'
      '110135729=       :OSNOVANIE_,'
      '110135730=       :IS_SPISANIE_,'
      '110135731=       :NOTE_,'
      '110135732=       :SUMM_,'
      '110135733=       :SUMM_FACT_1_,'
      '110135734=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110135735=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110135736=       ,:G_OFFICIAL_'
      '110135737=       ,:BY_RECIPE_'
      '110135738=       ,:SUMM_BONUS_GOT_'
      '110135739=       ,:IS_RESERVE_'
      '110135740=       ,COALESCE(:SUMM_CASH_, 0)'
      '110135741=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110135742=       ,:NOT_MINUS_OSTATOK_'
      '110135743=      )'
      '110135744=      RETURNING'
      '110135745=        ZAKAZ'
      '110135746=      INTO'
      '110135747=        :ZAKAZ_;'
      '110135748='
      '110135749=      PNT_ = '#39'02'#39';'
      
        '110135750=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110135751=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM'
      '110135752=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110135753=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110135754=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110135755=              :G_PRODUCT,'
      '110135756=              :AMOUNT,'
      '110135757=              :PRICE,'
      '110135758=              :SUMM,'
      '110135759=              :DISCOUNT_PERC,'
      '110135760=              :DISCOUNT_TENGE,'
      '110135761=              :DISCOUNT_SUMM,'
      '110135762=              :NDS,'
      '110135763=              :NDS_SUMM,'
      '110135764=              :COST_PRICE,'
      '110135765=              :SALES_COMM_'
      '110135766=      DO BEGIN'
      
        '110135767=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110135768=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '110135769=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/1' +
        '00;'
      
        '110135770=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110135771=        END'
      '110135772='
      '110135773=        INSERT INTO ZAKAZ_DETAILS'
      '110135774=        VALUES('
      '110135775=          :ZAKAZ_DETAILS_TMP_,'
      '110135776=          :ZAKAZ_,'
      '110135777=          :G_PRODUCT,'
      '110135778=          :AMOUNT,'
      '110135779=          :PRICE,'
      '110135780=          :SUMM,'
      '110135781=          :DISCOUNT_PERC,'
      '110135782=          :DISCOUNT_TENGE,'
      '110135783=          :DISCOUNT_SUMM,'
      '110135784=          :NDS,'
      '110135785=          :NDS_SUMM,'
      '110135786=          :COST_PRICE,'
      '110135787=          :SALES_COMM_SUMM_ITER_'
      '110135788=        );'
      '110135789='
      '110135790=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '110135791=        IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK_ = 0' +
        ') THEN BEGIN'
      '110135792=            UPDATE LT_SKLAD_PRODUCT L'
      '110135793=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110135794=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110135795=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110135796='
      '110135797=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110135798=            -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', ' +
        #1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053 +
        #1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110135799=            -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040 +
        #1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '110135800=            PNT_ = '#39'04'#39';'
      
        '110135801=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE F' +
        'ROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110135802=              Err_Code = -20500;'
      
        '110135803=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODU' +
        'CT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088 +
        #1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110135804=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110135805=              EXIT;'
      '110135806=            END ELSE if (ROW_COUNT = 0) then'
      
        '110135807=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110135808=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110135809=        END'
      '110135810='
      '110135811=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110135812=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110135813=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110135814=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :AMOUNT'
      '110135815=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110135816=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110135817=      END'
      '110135818='
      '110135819=      ----------------------------------------'
      
        '110135820=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063 +
        #1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110135821=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '110135822=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110135823='
      
        '110135824=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048',' +
        ' '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044 +
        #1048#1053' '#1055#1051#1040#1058#1045#1046
      '110135825=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110135826=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110135827=                PNT_ = '#39'05'#39';'
      
        '110135828=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110135829=                                              1,     -' +
        '- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110135830=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110135831=                                              :Z_DATE_' +
        ','
      
        '110135832=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110135833=                                              ZAKAZ_, ' +
        '  --ZAKAZ_'
      '110135834=                                              NULL,'
      
        '110135835=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110135836=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110135837=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110135838=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110135839=                  EXIT;'
      '110135840=                END'
      '110135841=            END'
      '110135842='
      '110135843=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110135844=        END ELSE BEGIN'
      '110135845=            PNT_ = '#39'06'#39';'
      
        '110135846=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110135847=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110135848=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110135849=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110135850=                ELSE'
      
        '110135851=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110135852='
      
        '110135853=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110135854=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110135855='
      
        '110135856=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110135857='
      '110135858=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110135859=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110135860=                                                  1,  ' +
        '   --:G_PRIHOD_RASHOD_,'
      
        '110135861=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110135862=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110135863=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110135864=                                                  :ZAK' +
        'AZ_,'
      
        '110135865=                                                  NULL' +
        ',     --:SKLAD_,'
      
        '110135866=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110135867=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110135868=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110135869=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110135870=                      EXIT;'
      '110135871=                    END'
      '110135872=                END'
      '110135873=            END'
      '110135874=        END'
      '110135875=      END'
      '110135876='
      
        '110135877=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '110135878=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041 +
        #1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '110135879=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052 +
        ' '#1057#1051#1059#1063#1040#1045
      
        '110135880=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054' ' +
        #1051#1048#1062#1040'"'
      '110135881=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '110135882=          UPDATE G_DISCONT_CARD D'
      
        '110135883=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_,' +
        ' 0) + :SUMM_BONUS_GOT_,'
      '110135884=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110135885=          WHERE D.G_CLIENT = :G_CLIENT_'
      '110135886=          RETURNING'
      '110135887=            D.SUMM_ALL'
      '110135888=          INTO'
      '110135889=            :CLIENT_SUMM_ALL_;'
      '110135890='
      '110135891=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '110135892=            FROM G_CLIENT_DISC_VAL_GRID G'
      '110135893=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '110135894=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '110135895=          ORDER BY G.SUMM_FROM'
      '110135896=          ROWS 1 TO 1'
      '110135897=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '110135898='
      '110135899=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '110135900=            UPDATE G_CLIENT G'
      '110135901=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '110135902=             WHERE G.G_CLIENT = :G_CLIENT_'
      '110135903=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '110135904='
      '110135905=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '110135906=            UPDATE G_DISCONT_CARD D'
      '110135907=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '110135908=             WHERE D.G_CLIENT = :G_CLIENT_'
      '110135909=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '110135910=      END'
      '110135911='
      '110135912=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '110135913=      PNT_ = '#39'07'#39';'
      
        '110135914=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_COM' +
        'M_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN B' +
        'EGIN'
      '110135915=        SELECT S.S_VALUE'
      '110135916=          FROM SYSTEM_SETUP S'
      '110135917=         WHERE S.SYSTEM_SETUP = 4'
      '110135918=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '110135919='
      '110135920=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '110135921=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110135922=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110135923='
      
        '110135924=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' ' +
        #1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '110135925=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '110135926=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE' +
        '(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM ' +
        'CURRENT_DATE)));'
      '110135927='
      '110135928=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '110135929=        ELSE'
      
        '110135930=           ACTION_DATE_ZP_ = Current_date - EXTRACT(DA' +
        'Y FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXTR' +
        'ACT(DAY FROM current_date) + 32);'
      '110135931='
      '110135932=        KASSA_ = NULL;'
      '110135933=        SELECT K.KASSA, K.SUMM'
      '110135934=        FROM KASSA K'
      '110135935=        WHERE K.G_PRIHOD_RASHOD = -1'
      '110135936=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '110135937=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '110135938=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110135939=         INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '110135940='
      '110135941=        IF (KASSA_ IS NULL) THEN'
      
        '110135942=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110135943=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110135944=                                          :SALES_COMM_' +
        'SUMM_ALL_,'
      
        '110135945=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110135946=                                          :OFFICIAL_NA' +
        'ME_,'
      
        '110135947=                                          NULL,     --' +
        ':ZAKAZ_,'
      
        '110135948=                                          NULL,     --' +
        ':SKLAD_,'
      '110135949=                                          1,'
      '110135950=                                          :G_TOCHKA_,'
      '110135951=                                          :G_OFFICIAL_'
      
        '110135952=                                          ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110135953=        ELSE'
      '110135954=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110135955=                                          1,     -- AC' +
        'TION_'
      
        '110135956=                                          -1,     --:G' +
        '_PRIHOD_RASHOD_,'
      
        '110135957=                                          :SALES_COMM_' +
        'SUMM_ITER_ + :SALES_COMM_SUMM_ALL_,'
      
        '110135958=                                          :ACTION_DATE' +
        '_ZP_,'
      
        '110135959=                                          :OFFICIAL_NA' +
        'ME_,   --NOTE_'
      '110135960=                                          NULL,'
      '110135961=                                          NULL,'
      
        '110135962=                                          :PAYMENT_TYP' +
        'E_,'
      '110135963=                                          :G_OFFICIAL_'
      
        '110135964=                                          ) RETURNING_' +
        'VALUES :ERR_CODE, :ERR_MSG;'
      '110135965='
      '110135966=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110135967=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110135968=          EXIT;'
      '110135969=        END'
      '110135970=      END'
      '110135971='
      '110135972=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '110135973=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0)' +
        ' THEN'
      
        '110135974=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110135975=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 1);'
      '110135976=  END'
      '110135977=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110135978=  ----------------------------------------'
      '110135979=  ----------------------------------------'
      '110135980=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110135981=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '110135982=      PNT_ = '#39'25'#39';'
      
        '110135983=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
        'A)'
      
        '110135984=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLI' +
        'ENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA' +
        '_)'
      '110135985=      RETURNING ZAKAZ_REAL_PARENT'
      '110135986=      INTO :ZAKAZ_REAL_PARENT_;'
      '110135987='
      
        '110135988=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCO' +
        'UNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '110135989=            FROM ZAKAZ_DETAILS_TMP Z'
      '110135990=          INTO :G_PRODUCT,'
      '110135991=              :AMOUNT,'
      '110135992=              :PRICE,'
      '110135993=              :SUMM,'
      '110135994=              :DISCOUNT_PERC,'
      '110135995=              :DISCOUNT_TENGE,'
      '110135996=              :DISCOUNT_SUMM,'
      '110135997=              :NDS,'
      '110135998=              :NDS_SUMM'
      '110135999=      DO BEGIN'
      '1101351000=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101351001=          UPDATE LT_SKLAD_PRODUCT L'
      '1101351002=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101351003=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101351004=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101351005='
      
        '1101351006=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101351007=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1101351008=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101351009=            Err_Code = -20500;'
      
        '1101351010=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101351011=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101351012=            EXIT;'
      '1101351013=          END ELSE if (ROW_COUNT = 0) then'
      
        '1101351014=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101351015=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '1101351016='
      
        '1101351017=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1101351018=                                     G_PRODUCT,'
      '1101351019=                                     PRICE,'
      
        '1101351020=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1101351021=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1101351022=                                     NDS_SUMM)'
      
        '1101351023=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1101351024=                  :G_PRODUCT,'
      
        '1101351025=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1101351026=                  :AMOUNT, :SUMM,'
      '1101351027=                  0, --AMOUNT_PAYED,'
      '1101351028=                  0, --SUMM_PAYED,'
      '1101351029=                  0, --IS_PAYED_ALL,'
      '1101351030=                  :DISCOUNT_PERC,'
      '1101351031=                  :DISCOUNT_TENGE,'
      '1101351032=                  :DISCOUNT_SUMM,'
      '1101351033=                  :NDS,'
      '1101351034=                  :NDS_SUMM)'
      '1101351035=          RETURNING ZAKAZ_NA_REAL'
      '1101351036=          INTO :ZAKAZ_;'
      '1101351037=      END'
      '1101351038=  END'
      '1101351039=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101351040=  ----------------------------------------'
      '1101351041=  ----------------------------------------'
      '1101351042=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1101351043=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1101351044=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101351045=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1101351046=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1101351047=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1101351048=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1101351049=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1101351050=      RETURNING SKLAD'
      '1101351051=      INTO :SKLAD_;'
      '1101351052='
      '1101351053=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101351054=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101351055=          INTO :G_PRODUCT,'
      '1101351056=              :AMOUNT,'
      '1101351057=              :PRICE,'
      '1101351058=              :SUMM'
      '1101351059=      DO BEGIN'
      '1101351060=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101351061=        UPDATE LT_SKLAD_PRODUCT L'
      '1101351062=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '1101351063=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101351064=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101351065='
      '1101351066=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101351067=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1101351068=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1101351069=        SELECT MAX(SK.DATE_RECEIPT)'
      '1101351070=            FROM SKLAD SK'
      '1101351071=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101351072=             AND SK.IS_LAST = 1'
      '1101351073=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1101351074=            INTO :DATE_LAST_;'
      '1101351075='
      
        '1101351076=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101351077=            UPDATE SKLAD SK'
      '1101351078=               SET SK.IS_LAST = 0'
      '1101351079=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101351080=               AND SK.IS_LAST = 1'
      '1101351081=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101351082='
      '1101351083=            IS_THIS_LAST_ = 1;'
      '1101351084=        END */'
      '1101351085='
      '1101351086='
      '1101351087=        INSERT INTO SKLAD'
      '1101351088=        ('
      '1101351089=         SKLAD,'
      '1101351090=         SKLAD_PARENT,'
      '1101351091=         DATE_RECEIPT,'
      '1101351092=         G_CLIENT,'
      '1101351093=         G_PRODUCT,'
      '1101351094=         AMOUNT,'
      '1101351095=         PRICE,'
      '1101351096=         SUMM,'
      '1101351097=         G_PAYMENT_TYPE,'
      '1101351098=         OSNOVANIE,'
      '1101351099=         NOTE,'
      '1101351100=         NDS,'
      '1101351101=         NDS_SUMM,'
      '1101351102=         IS_LAST,'
      '1101351103=         IS_VOZVRAT,'
      '1101351104=         G_TOCHKA'
      '1101351105=        ) VALUES ('
      '1101351106=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101351107=         :SKLAD_,'
      '1101351108=         :Z_DATE_,'
      '1101351109=         :G_TOCHKA_,'
      '1101351110=         :G_PRODUCT,'
      '1101351111=         :AMOUNT,'
      '1101351112=         :PRICE,'
      '1101351113=         :SUMM,'
      '1101351114=         :G_PAYMENT_TYPE_,'
      '1101351115=         :OSNOVANIE_,'
      '1101351116=         :NOTE_,'
      '1101351117=         0,  --:RNDS_,'
      '1101351118=         0,  --:RNDS_SUMM_,'
      
        '1101351119=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1101351120=         3,  --:IS_VOZVRAT_,'
      '1101351121=         :G_CLIENT_'
      '1101351122=        );'
      '1101351123='
      
        '1101351124=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101351125=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1101351126=        PNT_ = '#39'02'#39';'
      '1101351127=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101351128=            UPDATE LT_SKLAD_PRODUCT L'
      '1101351129=               SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '1101351130=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101351131=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1101351132='
      '1101351133=            IF (ROW_COUNT = 0) THEN'
      
        '1101351134=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLA' +
        'D_PRODUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '1101351135=        END'
      '1101351136=      END'
      '1101351137=  END'
      '1101351138='
      '1101351139=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101351140='
      
        '1101351141=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1101351142=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101351143=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1101351144=                                  G_PRIHOD_,'
      '1101351145=                                  :SUMM_PRIHOD_,'
      '1101351146=                                  :Z_DATE_,'
      
        '1101351147=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101351148=                                  :ZAKAZ_,'
      '1101351149=                                  NULL,'
      '1101351150=                                  :G_PAYMENT_TYPE_,'
      
        '1101351151=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101351152=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101351153=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101351154=      EXIT;'
      '1101351155=    END'
      '1101351156=  END'
      '1101351157='
      
        '1101351158=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1101351159=  IF (IS_MEBEL_ = 1) THEN'
      
        '1101351160=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1101351161=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1101351162=end'
      '1101351163=;'
      '1101351164='
      '1101351165=ALTER PROCEDURE LOG_INIT'
      '1101351166=AS'
      '1101351167=DECLARE VARIABLE TN VARCHAR(64);'
      '1101351168=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '1101351169=DECLARE VARIABLE FN VARCHAR(64);'
      '1101351170=DECLARE VARIABLE TP INTEGER;'
      
        '1101351171=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1101351172=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1101351173=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1101351174=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80; /* VARCHAR(30000); */'
      '1101351175=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '1101351176=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '1101351177=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '1101351178=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000) */'
      
        '1101351179=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      
        '1101351180=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      '1101351181=DECLARE VARIABLE ANZ INTEGER;'
      '1101351182=DECLARE VARIABLE L INTEGER;'
      '1101351183=DECLARE VARIABLE P INTEGER;'
      '1101351184=DECLARE VARIABLE S INTEGER;'
      '1101351185=DECLARE VARIABLE FT CHAR(1);'
      '1101351186=DECLARE VARIABLE CRLF VARCHAR(10);'
      '1101351187=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '1101351188=BEGIN'
      '1101351189=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '1101351190='
      '1101351191=  TN_ALT='#39#39';'
      '1101351192=  TRGI='#39#39';'
      '1101351193=  TRGU='#39#39';'
      '1101351194=  TRGD='#39#39';'
      '1101351195=  TRGIX='#39#39';'
      '1101351196=  TRGUX='#39#39';'
      '1101351197=  TRGDX='#39#39';'
      '1101351198=  SQLF='#39#39';'
      '1101351199=  SQLV='#39#39';'
      '1101351200=  SQLU='#39#39';'
      '1101351201=  FT='#39#39';'
      '1101351202='
      '1101351203=  FOR SELECT R.RDB$RELATION_NAME,'
      '1101351204=            R.RDB$FIELD_NAME,'
      '1101351205=            F.RDB$FIELD_TYPE,'
      '1101351206=            F.RDB$FIELD_LENGTH,'
      '1101351207=            F.RDB$FIELD_PRECISION,'
      '1101351208=            F.RDB$FIELD_SCALE'
      '1101351209=        FROM RDB$RELATION_FIELDS R,'
      '1101351210=             RDB$FIELDS F'
      '1101351211=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1101351212=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '1101351213=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '1101351214=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39 +
        ', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '1101351215=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1101351216=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1101351217=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1101351218=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1101351219=                                         '#39'REVISION'#39', ' +
        #39'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1101351220=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PRO' +
        'DUCT_FILL'#39','
      
        '1101351221=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39')'
      '1101351222=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '1101351223=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '1101351224=              OR'
      
        '1101351225=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD' +
        '_SUB_TYPE <> 0)'
      '1101351226=             )'
      
        '1101351227=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSIT' +
        'ION'
      '1101351228=        INTO :TN,:FN,:TP,:L,:P,:S'
      '1101351229=  DO BEGIN'
      '1101351230=    TN=TRIM(TN);'
      '1101351231=    FN=TRIM(FN);'
      '1101351232=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '1101351233=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '1101351234=      EXECUTE STATEMENT TRGI;'
      '1101351235=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '1101351236=      EXECUTE STATEMENT TRGU;'
      '1101351237=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '1101351238=      EXECUTE STATEMENT TRGD;'
      '1101351239='
      '1101351240=      SQLF='#39#39';'
      '1101351241=      SQLV='#39#39';'
      '1101351242=      SQLU='#39#39';'
      '1101351243=    END'
      '1101351244=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '1101351245=      ID_COLUMN = FN;'
      '1101351246='
      '1101351247=    S=-S;'
      
        '1101351248=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp' +
        '=27)) then'
      '1101351249=      ft='#39'N'#39';   --numerisch'
      '1101351250=    else'
      '1101351251=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '1101351252=        ft='#39'Z'#39';   --zeit'
      '1101351253=      else'
      '1101351254=        ft='#39'T'#39';'
      '1101351255='
      '1101351256=    IF (SQLF='#39#39') THEN'
      '1101351257=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '1101351258=    ELSE'
      '1101351259=      SQLF=SQLF||'#39','#39'||FN;'
      '1101351260='
      '1101351261=    if (ft='#39'N'#39') then begin'
      '1101351262=      IF (SQLV='#39#39') THEN'
      
        '1101351263=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1101351264=      ELSE'
      
        '1101351265=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1101351266='
