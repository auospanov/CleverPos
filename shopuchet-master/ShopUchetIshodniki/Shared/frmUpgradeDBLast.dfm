        'NG '#39'~'#39'||PT.G_PRODUCT||'#39'~'#39')) AND :g_category_ IS NOT NULL)'
      '110237264=                              OR'
      
        '110237265=                             (GP.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT_PAR AND :g_category_ IS NULL)'
      '110237266=                            )'
      '110237267=                    );'
      '110237268=  END'
      '110237269='
      
        '110237270=  --'#1052#1045#1053#1071#1070' '#1055#1056#1048#1047#1053#1040#1050' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1058#1054#1042#1040#1056' '#1042' KASPI '#1052#1040#1043#1040#1047#1048#1053' '#1048#1051#1048' ' +
        #1053#1045#1058
      '110237271=  IF (:IS_KASPI_SHOP_ = 1) THEN'
      '110237272=  BEGIN'
      
        '110237273=    IF ((CHANGE_PRICE_ + CHANGE_CATEGORY_ + CHANGE_MIN' +
        '_AMOUNT_ + CHANGE_SALES_COMM_ + CHANGE_KIT_TYPE_) > 0) THEN'
      '110237274=      SQL_STR_ = SQL_STR_ ||'#39','#39';'
      '110237275='
      
        '110237276=    SQL_STR_ = SQL_STR_ ||'#39'P.IS_KASPI_SHOP = '#39'||:IS_KA' +
        'SPI_SHOP_MODE_;'
      '110237277=  END'
      '110237278='
