      '11067317=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '11067318=DECLARE VARIABLE SUMM_OLD_ NUMERIC(15,2) = 0;'
      '11067319=DECLARE VARIABLE KASSA_NEW_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11067320=DECLARE VARIABLE ACTION_DATE_OLD_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '11067321=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11067322=BEGIN'
      
        '11067323=  -----------------------------------------------------' +
