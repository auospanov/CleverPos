      '110240635=          :DISCOUNT_TENGE,'
      '110240636=          :DISCOUNT_SUMM,'
      '110240637=          :NDS,'
      '110240638=          :NDS_SUMM,'
      '110240639=          :COST_PRICE,'
      '110240640=          :SALES_COMM_SUMM_ITER_,'
      '110240641=          :MARK_CODE_'
      '110240642=        );'
      '110240643='
      
        '110240644=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045 +
        ' 10%'
      '110240645=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '110240646=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK_' +
        ' = 0) THEN BEGIN'
      '110240647=                UPDATE LT_SKLAD_PRODUCT L'
      '110240648=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '110240649=                       L.NEED_TO_EXPORT = :UPLOAD_TO_E' +
        'XT_APP_  -- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067 +
        ' '#1055#1056#1048#1061#1054#1044', '#1061#1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '110240650=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '110240651=                   AND L.G_TOCHKA = :G_TOCHKA_;'
