      '110249817=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110249818=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110249819=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110249820=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110249821=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '110249822=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '110249823=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE = NULL,'
      
        '110249824=  POS_PAY_METHOD_ TYPE OF COLUMN ZAKAZ.POS_PAY_METHOD ' +
        '= NULL,'
      
        '110249825=  POS_PAY_TRANSACTION_ID_ TYPE OF COLUMN ZAKAZ.POS_PAY' +
        '_TRANSACTION_ID = NULL,'
      
        '110249826=  REQUEST_NUMBER_ TYPE OF COLUMN ZAKAZ.REQUEST_NUMBER ' +
        '= NULL)'
      '110249827=RETURNS ('
      '110249828=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110249829=  ERR_CODE INTEGER,'
      '110249830=  ERR_MSG VARCHAR(1024))'
      '110249831=AS'
      '110249832=/*'
      '110249833=IS_SPISANIE_'
      '110249834=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110249835=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110249836=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110249837=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110249838='
      '110249839='
      
        '110249840=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110249841=*/'
      '110249842=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110249843=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110249844=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110249845=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110249846=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110249847=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110249848=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110249849=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110249850=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110249851=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110249852=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110249853=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110249854=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110249855=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110249856=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '110249857=DECLARE VARIABLE CNT_ INTEGER;'
      '110249858=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110249859=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110249860=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110249861=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110249862=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110249863=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110249864=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110249865=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110249866=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110249867=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110249868=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110249869=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110249870=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110249871=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110249872=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110249873=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110249874=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      
        '110249875=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.MARK_CODE;'
      '110249876=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '110249877=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN L' +
        'OG_OPER.OPERATION;'
      
        '110249878=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '110249879=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110249880=BEGIN'
      '110249881='
      
        '110249882=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110249883=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110249884=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110249885=  IF (CNT_ = 0) THEN BEGIN'
      '110249886=    ERR_CODE = -20500;'
      
        '110249887=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110249888=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110249889=    EXIT;'
      '110249890=  END'
      '110249891='
      '110249892=  IF (G_TOCHKA_ IS NULL) THEN'
      '110249893=    SELECT ID'
      '110249894=      FROM CUR_PARAMS'
      '110249895=     WHERE CUR_PARAMS = 2'
      '110249896=      INTO :G_TOCHKA_;'
      '110249897='
      '110249898=  IF (G_TOCHKA_ IS NULL) THEN BEGIN'
      '110249899=    ERR_CODE = -20500;'
      
        '110249900=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077' '#1091#1082#1072#1079#1072#1085 +
        ' '#1089#1082#1083#1072#1076' '#1087#1088#1086#1076#1072#1078#1080'! '#1054#1073#1088#1072#1090#1080#1090#1077#1089#1100' '#1082' '#1088#1072#1079#1088#1072#1073#1086#1090#1095#1080#1082#1091'!'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110249901=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110249902=    EXIT;'
      '110249903=  END'
      '110249904='
      '110249905=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110249906=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110249907=      PNT_ = '#39'01'#39';'
      
        '110249908=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110249909=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110249910=      ELSE'
      '110249911=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110249912='
      '110249913=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110249914=      SELECT G.G_OFFICIAL,'
      '110249915=             G.DO_NOT_SALES_COMM,'
      '110249916=             G.FM||'#39' '#39'||G.NM'
      '110249917=        FROM G_OFFICIAL G'
      
        '110249918=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110249919=        INTO :G_OFFICIAL_,'
      '110249920=             :DO_NOT_SALES_COMM_,'
      '110249921=             :OFFICIAL_NAME_;'
      '110249922='
      '110249923=      INSERT INTO ZAKAZ'
      '110249924=      ('
      '110249925=       ZAKAZ,'
      '110249926=       G_TOCHKA,'
      '110249927=       Z_DATE,'
      '110249928=       Z_TIME,'
      '110249929=       G_CLIENT,'
      '110249930=       G_PAYMENT_TYPE,'
      '110249931=       OSNOVANIE,'
      '110249932=       IS_SPISANIE,'
      '110249933=       NOTE,'
      '110249934=       SUMM,'
      '110249935=       SUMM_FACT,'
      '110249936=       SUMM_BONUS,'
      '110249937=       IS_PAYED_ALL'
      '110249938=       ,G_OFFICIAL'
      '110249939=       ,BY_RECIPE'
      '110249940=       ,SUMM_BONUS_GOT'
      '110249941=       ,IS_RESERVE'
      '110249942=       ,SUMM_CASH'
      '110249943=       ,SUMM_NONCASH'
      '110249944=       ,NOT_MINUS_OSTATOK'
      '110249945=       ,DELIVERY_ADDRESS'
      '110249946=       ,REC_ID'
      '110249947=       ,G_NONCASH_PAY_TYPE'
      '110249948=       ,POS_PAY_METHOD'
      '110249949=       ,POS_PAY_TRANSACTION_ID'
      '110249950=       ,REQUEST_NUMBER'
      '110249951=       ,BARCODE'
      '110249952=      ) VALUES ('
      '110249953=       GEN_ID(GEN_ZAKAZ, 1),'
      '110249954=       :G_TOCHKA_,'
      '110249955=       :Z_DATE_,'
      '110249956=       :Z_TIME_,'
      '110249957=       :G_CLIENT_,'
      '110249958=       :G_PAYMENT_TYPE_,'
      '110249959=       :OSNOVANIE_,'
      '110249960=       :IS_SPISANIE_,'
      '110249961=       :NOTE_,'
      '110249962=       :SUMM_,'
      '110249963=       :SUMM_FACT_1_,'
      '110249964=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110249965=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110249966=       ,:G_OFFICIAL_'
      '110249967=       ,:BY_RECIPE_'
      '110249968=       ,:SUMM_BONUS_GOT_'
      '110249969=       ,:IS_RESERVE_'
      '110249970=       ,COALESCE(:SUMM_CASH_, 0)'
      '110249971=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110249972=       ,:NOT_MINUS_OSTATOK_'
      '110249973=       ,:ADDRESS_'
      '110249974=       ,:REC_ID_'
      '110249975=       ,:G_NONCASH_PAY_TYPE_'
      '110249976=       ,:POS_PAY_METHOD_'
      '110249977=       ,:POS_PAY_TRANSACTION_ID_'
      '110249978=       ,:REQUEST_NUMBER_'
      
        '110249979=       ,'#39'SHO'#39'||LPAD(GEN_ID(GEN_ZAKAZ_BARCODE,  1), 12,' +
        ' '#39'0'#39')'
      '110249980=      )'
      '110249981=      RETURNING'
      '110249982=        ZAKAZ'
      '110249983=      INTO'
      '110249984=        :ZAKAZ_;'
      '110249985='
      '110249986=      PNT_ = '#39'02'#39';'
      
        '110249987=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110249988=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM, Z.MARK_CODE'
      '110249989=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110249990=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110249991=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110249992=              :G_PRODUCT,'
      '110249993=              :AMOUNT,'
      '110249994=              :PRICE,'
      '110249995=              :SUMM,'
      '110249996=              :DISCOUNT_PERC,'
      '110249997=              :DISCOUNT_TENGE,'
      '110249998=              :DISCOUNT_SUMM,'
      '110249999=              :NDS,'
      '1102491000=              :NDS_SUMM,'
      '1102491001=              :COST_PRICE,'
      '1102491002=              :SALES_COMM_,'
      '1102491003=              :MARK_CODE_'
      '1102491004=      DO BEGIN'
      
        '1102491005=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102491006=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '1102491007=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/' +
        '100;'
      
        '1102491008=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102491009=        END'
      '1102491010='
      '1102491011=        INSERT INTO ZAKAZ_DETAILS'
      '1102491012=        VALUES('
      '1102491013=          :ZAKAZ_DETAILS_TMP_,'
      '1102491014=          :ZAKAZ_,'
      '1102491015=          :G_PRODUCT,'
      '1102491016=          :AMOUNT,'
      '1102491017=          :PRICE,'
      '1102491018=          :SUMM,'
      '1102491019=          :DISCOUNT_PERC,'
      '1102491020=          :DISCOUNT_TENGE,'
      '1102491021=          :DISCOUNT_SUMM,'
      '1102491022=          :NDS,'
      '1102491023=          :NDS_SUMM,'
      '1102491024=          :COST_PRICE,'
      '1102491025=          :SALES_COMM_SUMM_ITER_,'
      '1102491026=          :MARK_CODE_'
      '1102491027=        );'
      '1102491028='
      
        '1102491029=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048 +
        #1045' 10%'
      '1102491030=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '1102491031=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN BEGIN'
      '1102491032=                UPDATE LT_SKLAD_PRODUCT L'
      '1102491033=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102491034=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_  -- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051 +
        #1067' '#1055#1056#1048#1061#1054#1044', '#1061#1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '1102491035=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102491036=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102491037='
      '1102491038=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1102491039=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043 +
        #1045#1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051 +
        #1048#1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
