      '11019429=RETURNS ('
      
        '11019430=  CLIENT_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCH' +
        'AR(250),'
      
        '11019431=  PAYMENT_NAME_ /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME *' +
        '/ VARCHAR(256),'
      
        '11019432=  SUMM_COST_ALL_ /* TYPE OF COLUMN P_REP_PROFIT_TABLE.S' +
        'UMM */ NUMERIC(15,2),'
      '11019433=  SUMM_COST_ALL_STR VARCHAR(50),'
