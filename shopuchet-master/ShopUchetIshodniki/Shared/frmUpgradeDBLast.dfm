      '1102462077=         IS_VOZVRAT,'
      '1102462078=         G_TOCHKA'
      '1102462079=        ) VALUES ('
      '1102462080=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102462081=         :ZAKAZ_,'
