      '1101351876=                 :AMOUNT_PRIHOD,'
      '1101351877=                 :SUMM_PRIHOD,'
      '1101351878=                 :PRICE_UHOD,'
      '1101351879=                 :AMOUNT_UHOD,'
      '1101351880=                 :SUMM_UHOD'
      '1101351881=      DO BEGIN'
      '1101351882=        IF (ROW not in (-2, -1, 13)) THEN BEGIN'
      '1101351883=            PRICE_PRIHOD = COALESCE(PRICE_PRIHOD, 0);'
      
        '1101351884=            AMOUNT_PRIHOD = COALESCE(AMOUNT_PRIHOD, 0' +
        ');'
      '1101351885=            SUMM_PRIHOD = COALESCE(SUMM_PRIHOD, 0);'
      '1101351886=            PRICE_UHOD = COALESCE(PRICE_UHOD, 0);'
      '1101351887=            AMOUNT_UHOD = COALESCE(AMOUNT_UHOD, 0);'
      '1101351888=            SUMM_UHOD  = COALESCE(SUMM_UHOD, 0);'
      '1101351889=        END'
      '1101351890=        SUSPEND;'
      '1101351891=      END'
      '1101351892=  END'
      '1101351893=WHEN ANY DO BEGIN'
      '1101351894=    Err_code = -20500;'
      
        '1101351895=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1048#1057#1058#1054#1056#1048#1048' '#1058#1054#1042#1040#1056#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101351896=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101351897=  END'
      '1101351898=end'
      '1101351899=;'
      '1101351900='
      '1101351901=ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '1101351902=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101351903=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101351904=  DATE_BEGIN_ DATE,'
      '1101351905=  DATE_END_ DATE,'
      '1101351906=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101351907=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101351908=RETURNS ('
      '1101351909=  DATE_BEGIN_OUT_ DATE,'
      '1101351910=  DATE_END_OUT_ DATE,'
      '1101351911=  STR_ VARCHAR(500),'
      '1101351912=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '1101351913=  NAME VARCHAR(1000),'
      '1101351914=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101351915=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101351916=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101351917=  AMOUNT_IN MY_NUMERIC_5,'
      
        '1101351918=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '1101351919=  SUMM_PRIHOD NUMERIC(15,2),'
      '1101351920=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101351921=  SUMM_UHOD NUMERIC(15,2),'
      
        '1101351922=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1101351923=  SUMM_SPISANO NUMERIC(15,2),'
      
        '1101351924=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1101351925=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '1101351926=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.A' +
        'MOUNT,'
      '1101351927=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '1101351928=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1101351929=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '1101351930=  AMOUNT_OUT MY_NUMERIC_5,'
      '1101351931=  IS_HEAD INTEGER,'
      '1101351932=  ERR_CODE INTEGER,'
      '1101351933=  ERR_MSG VARCHAR(1024))'
      '1101351934=AS'
      
        '1101351935=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1101351936=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101351937=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '1101351938=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1101351939=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT = 0;'
      '1101351940=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1101351941=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1101351942=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1101351943=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1101351944=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1101351945=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101351946=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1101351947=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1101351948=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1101351949=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1101351950=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101351951=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101351952=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1101351953=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1101351954=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1101351955=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101351956=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1101351957=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101351958=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1101351959=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101351960=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1101351961=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101351962=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0' +
        ';'
      
        '1101351963=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101351964=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1101351965=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1101351966=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1101351967=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101351968=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '1101351969=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101351970=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '1101351971=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101351972=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1101351973=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101351974=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      '1101351975=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '1101351976=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39';'
      
        '1101351977=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '1101351978=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '1101351979=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      '1101351980=BEGIN'
      '1101351981='
      '1101351982=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '1101351983=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1101351984='
      '1101351985=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '1101351986=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '1101351987=               (select (select COALESCE(sum(amount), ' +
        '0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1101351988=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1101351989=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1101351990=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1101351991=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1101351992=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1101351993=                        and zrp.ZAKAZ_DATE >= :DATE_B' +
        'EGIN_)'
      '1101351994=                       +'
      
        '1101351995=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1101351996=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1101351997=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      
        '1101351998=                        and z.IS_SPISANIE <> 2   -- '#1085 +
        #1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' ' +
        #1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1101351999=                        and not (z.IS_SPISANIE = 0 an' +
        'd z.NOT_MINUS_OSTATOK = 1))'
      '1101352000=                       +'
      
        '1101352001=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1101352002=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1101352003=                       +'
      
        '1101352004=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1101352005=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1101352006=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1101352007=                       -'
      
        '1101352008=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1101352009=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101352010=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_ and not (sp.IS_VOZVRAT = 0 and sp.IS' +
        '_EXPECTED = 1))'
      '1101352011=                       -'
      
        '1101352012=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1101352013=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1101352014=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||Sp.g_tochka||'#39'-'#39' and sp.date_receipt >= :DATE_BEGIN_ and s' +
        'p.IS_EXPECTED = 0)'
      '1101352015=                  from rdb$database) AMOUNT_OUT,'
      '1101352016=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1101352017=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1101352018=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1101352019=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1101352020=                   AND SP.IS_VOZVRAT = 0'
      '1101352021=                   AND SP.IS_EXPECTED = 0'
      
        '1101352022=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') AMOUNT_PRIHOD,'
      '1101352023=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1101352024=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1101352025=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1101352026=                   AND SP.IS_VOZVRAT = 0'
      '1101352027=                   AND SP.IS_EXPECTED = 0'
      
        '1101352028=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') SUMM_PRIHOD,'
      '1101352029=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '1101352030=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1101352031=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101352032=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101352033=                   AND Z.IS_SPISANIE = 0'
      '1101352034=                   AND Z.IS_RESERVE = 0'
      '1101352035=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1101352036=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_UHOD,'
      '1101352037=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1101352038=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101352039=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101352040=                   AND Z.IS_SPISANIE = 0'
      '1101352041=                   AND Z.IS_RESERVE = 0'
      '1101352042=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1101352043=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_UHOD,'
      '1101352044=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101352045=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1101352046=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101352047=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101352048=                   AND Z.IS_SPISANIE = 1'
      
        '1101352049=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_SPISANO,'
      '1101352050=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1101352051=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101352052=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101352053=                   AND Z.IS_SPISANIE = 1'
      
        '1101352054=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_SPISANO,'
      '1101352055=               -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101352056=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1101352057=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1101352058=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1101352059=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1101352060=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') AMOUNT_VOZVRAT,'
      '1101352061=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1101352062=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1101352063=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1101352064=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1101352065=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') SUMM_VOZVRAT,'
      
        '1101352066=               -- '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059 +
        #1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1067#1056#1040#1042#1053#1048#1042#1040#1053#1048#1045' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1042' '#1056#1045#1047#1059#1051 +
        #1068#1058#1040#1058#1045' '#1056#1045#1042#1048#1047#1048#1048
      '1101352067=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      '1101352068=                  FROM SKLAD S, SKLAD_PARENT SP'
      '1101352069=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      '1101352070=                   AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1101352071=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1101352072=                   AND SP.IS_VOZVRAT IN (3, 4, 5)'
      
        '1101352073=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39
      
        '1101352074=                   AND NOT (SP.IS_VOZVRAT = 3 AND SP.' +
        'IS_EXPECTED = 1)) AMOUNT_PRIHOD_SKL,'
      '1101352075=               (SELECT COALESCE(SUM(S.SUMM),0)'
      '1101352076=                  FROM SKLAD S, SKLAD_PARENT SP'
      '1101352077=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      '1101352078=                   AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1101352079=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1101352080=                   AND SP.IS_VOZVRAT IN (3, 4, 5)'
      
        '1101352081=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39
      
        '1101352082=                   AND NOT (SP.IS_VOZVRAT = 3 AND SP.' +
        'IS_EXPECTED = 1)) SUMM_PRIHOD_SKL,'
      
        '1101352083=               -- '#1059#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1059#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1044#1056'. '#1057#1050 +
        #1051#1040#1044' '#1048' '#1059#1061#1054#1044' '#1050#1054#1052#1055#1051#1045#1050#1058#1059#1070#1065#1048#1061' '#1055#1056#1048' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1045', '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058 +
