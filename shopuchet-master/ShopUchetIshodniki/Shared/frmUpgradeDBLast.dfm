      '110402354=        END'
      '110402355=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110402356=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '110402357=                                          :G_PRIHOD_,'
      
        '110402358=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110402359=                                          :DATE_RECEIP' +
        'T_,'
      
        '110402360=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110402361=                                          NULL,   --ZA' +
        'KAZ_'
      
        '110402362=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110402363=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110402364=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
