      '1102013814=  --*************************************************'
      
        '1102013815=  ---------------------------------------------------' +
        '-------------------'
      
        '1102013816=  ---------------------------------------------------' +
        '-------------------'
      '1102013817=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '1102013818=  ELSE BEGIN'
      '1102013819=      PNT_ = '#39'01A'#39';'
      
        '1102013820=      -- '#1045#1057#1051#1048' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040', '#1058#1054' '#1059#1044#1040#1051#1071#1070' '#1057#1058#1040#1056#1059#1070' '#1047#1040#1055#1048#1057 +
        #1068' '#1048' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1047#1040' '#1053#1054#1042#1059#1070' '#1044#1040#1058#1059
      '1102013821=      SELECT L.ACTION_DATE,'
      '1102013822=             L.SUMM,'
      '1102013823=             L.G_TOCHKA'
      '1102013824=        FROM KASSA_BEZNAL L'
      '1102013825=       WHERE L.KASSA_BEZNAL = :KASSA_'
      '1102013826=        INTO :ACTION_DATE_OLD_,'
      '1102013827=             :SUMM_OLD_,'
      '1102013828=             :G_TOCHKA_;'
      '1102013829='
      
        '1102013830=      IF ((SUMM_OLD_ <> SUMM_) or (ACTION_DATE_OLD_ <' +
        '> ACTION_DATE_)) THEN BEGIN'
      
        '1102013831=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102013832=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013833=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102013834=            EXIT;'
      '1102013835=          END'
      '1102013836='
      '1102013837=          PNT_ = '#39'02A'#39';'
      '1102013838=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '1102013839=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1102013840=                                        :SUMM_,'
      
        '1102013841=                                        :ACTION_DATE_' +
        ','
      '1102013842=                                        :NOTE_,'
      '1102013843=                                        :ZAKAZ_,'
      '1102013844=                                        :SKLAD_,'
      
        '1102013845=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1102013846=                                        :G_TOCHKA_,'
      
        '1102013847=                                        :G_OFFICIAL_)' +
        ' RETURNING_VALUES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '1102013848=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013849=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102013850=            EXIT;'
      '1102013851=          END'
      '1102013852='
      
        '1102013853=          -- '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1053#1045' '#1041#1067#1051#1054' '#1055#1056#1054#1041#1051#1045#1052' '#1042' ' +
        #1042#1067#1047#1067#1042#1040#1070#1065#1045#1049' '#1055#1056#1054#1062#1045#1044#1059#1056#1045', '#1048#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1052#1045#1053#1071#1070' '#1053#1054#1042#1067#1049' ID '#1050#1040#1057#1057#1067' '#1053#1040' '#1057 +
        #1058#1040#1056#1067#1049','
      
        '1102013854=          -- '#1042#1045#1044#1068' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1042#1067#1047#1067#1042#1040#1051#1057#1071' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1056#1040#1047#1059#1052#1045 +
        #1042#1040#1045#1058#1057#1071' '#1063#1058#1054' ID '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071
      '1102013855=          UPDATE KASSA_BEZNAL SS'
      '1102013856=             SET SS.KASSA_BEZNAL = :KASSA_'
      '1102013857=           WHERE SS.KASSA_BEZNAL = :KASSA_NEW_;'
      '1102013858='
      
        '1102013859=          EXECUTE procedure K_RECALC_KASSA_BEZNAL(:AC' +
        'TION_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1102013860=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013861=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102013862=            EXIT;'
      '1102013863=          END'
      '1102013864=      END'
      '1102013865=      UPDATE KASSA_BEZNAL'
      '1102013866=         SET ACTION = :ACTION_,'
      '1102013867=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '1102013868=             SUMM = :SUMM_,'
      '1102013869=             ACTION_DATE = :ACTION_DATE_,'
      '1102013870=             NOTE = COALESCE(:NOTE_, NOTE)'
      '1102013871=      WHERE KASSA_BEZNAL = :KASSA_;'
      '1102013872=  END'
      '1102013873='
      '1102013874=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      '1102013875=  IF (LOG_BODY_ IS NOT NULL) THEN'
      
        '1102013876=    EXECUTE PROCEDURE LOG_OPER_INS(10 + :ACTION_, :US' +
        'ER_ID_, :KASSA_, :ACTION_DATE_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1102013877=end'
      '1102013878=;'
      '1102013879='
      '1102013880=ALTER PROCEDURE K_UPD_KASSA_ROUTINE('
      '1102013881=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      
        '1102013882=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102013883=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1102013884=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1102013885=  ACTION_DATE_OLD_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1102013886=  SUMM_OLD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102013887=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      '1102013888=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102013889=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102013890=RETURNS ('
      '1102013891=  ERR_CODE INTEGER,'
      '1102013892=  ERR_MSG VARCHAR(1024))'
      '1102013893=AS'
      '1102013894=/*'
      
        '1102013895='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1102013896=*/'
      '1102013897=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1102013898=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102013899=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1102013900=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1102013901=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      
        '1102013902=DECLARE VARIABLE ACTION_DT_ TYPE OF COLUMN KASSA.ACTI' +
        'ON_DATE;'
      '1102013903=DECLARE VARIABLE SMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1102013904=DECLARE VARIABLE INPUT_ TYPE OF COLUMN KASSA_STATE."I' +
        'NPUT";'
      '1102013905=BEGIN'
      '1102013906=  PROCNAME = '#39'K_UPD_KASSA_ROUTINE'#39';'
      '1102013907='
      '1102013908=  --*************************************************'
      
        '1102013909=  -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040', '#1045#1057#1051#1048' '#1057#1058#1040#1056#1040#1071' '#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1067' '#1057#1054 +
        #1042#1055#1040#1044#1040#1070#1058', '#1058#1054' '#1040#1055#1044#1045#1049#1058' '#1054#1044#1048#1053', '#1045#1057#1051#1048' '#1053#1045#1058', '#1058#1054' '#1040#1055#1044#1045#1049#1058#1040' '#1044#1042#1040
      '1102013910=  --*************************************************'
      '1102013911=  FOR SELECT :ACTION_DATE_OLD_,'
      '1102013912=             :SUMM_ - :SUMM_OLD_'
      '1102013913=        FROM RDB$DATABASE'
      '1102013914=       WHERE :ACTION_DATE_OLD_ = :ACTION_DATE_'
      '1102013915=      UNION ALL'
      '1102013916=      SELECT :ACTION_DATE_OLD_,'
      '1102013917=             -:SUMM_OLD_'
      '1102013918=        FROM RDB$DATABASE'
      '1102013919=       WHERE :ACTION_DATE_OLD_ <> :ACTION_DATE_'
      '1102013920=      UNION ALL'
      '1102013921=      SELECT :ACTION_DATE_,'
      '1102013922=             :SUMM_'
      '1102013923=        FROM RDB$DATABASE'
      '1102013924=       WHERE :ACTION_DATE_OLD_ <> :ACTION_DATE_'
      '1102013925=        INTO :ACTION_DT_,'
      '1102013926=             :SMM_'
      '1102013927=  DO BEGIN'
      '1102013928=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1102013929=      PNT_ = '#39'01'#39';'
      '1102013930=      IF (:ACTION_ = 0) THEN'
      '1102013931=        CREDIT_ = SMM_;'
      '1102013932=      ELSE'
      '1102013933=        DEBET_ = SMM_;'
      '1102013934='
      
        '1102013935=      EXECUTE PROCEDURE K_UPD_KASSA_STATE(:ACTION_DT_' +
        ', :G_TOCHKA_, :DEBET_, :CREDIT_, COALESCE(G_PAYMENT_TYPE_, 0), :' +
        'UPLOAD_TO_EXT_APP_)'
      '1102013936=          RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102013937='
      '1102013938=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102013939=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102013940=          EXIT;'
      '1102013941=      END'
      '1102013942=  END'
      '1102013943='
      '1102013944=WHEN ANY DO'
      '1102013945=  begin'
      '1102013946=    ERR_CODE = sqlcode;'
      
        '1102013947=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073#1082#1072' '#1087 +
        #1088#1080' '#1080#1079#1084#1077#1085#1077#1085#1080#1080' '#1082#1072#1089#1089#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '1102013948=    ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '1102013949=  end'
      '1102013950=end'
      '1102013951=;'
      '1102013952='
      '1102013953=ALTER PROCEDURE K_UPD_KASSA_STATE('
      '1102013954=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1102013955=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102013956=  DEBET_ MY_NUMERIC,'
      '1102013957=  CREDIT_ MY_NUMERIC,'
      '1102013958=  NAL_BEZNAL_ INTEGER,'
      '1102013959=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102013960=RETURNS ('
      '1102013961=  ERR_CODE INTEGER,'
      '1102013962=  ERR_MSG VARCHAR(1024))'
      '1102013963=AS'
      
        '1102013964=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_UPD_KASSA_' +
        'STATE'#39';'
      '1102013965=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102013966=DECLARE VARIABLE INPUT_ MY_NUMERIC = 0;'
      '1102013967=DECLARE VARIABLE SQL_STMT_ VARCHAR(2000);'
      '1102013968=BEGIN'
      '1102013969='
      '1102013970=  PNT_ = '#39'01'#39';'
      '1102013971=  -- '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067
      '1102013972=  IF (NAL_BEZNAL_ = 1) THEN BEGIN'
      '1102013973=      UPDATE KASSA_STATE K'
      
        '1102013974=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESC' +
        'E(:DEBET_, 0),'
      
        '1102013975=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALE' +
        'SCE(:CREDIT_, 0),'
      
        '1102013976=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALE' +
        'SCE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0)' +
        ' + COALESCE(:CREDIT_, 0)),'
      '1102013977=             K.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102013978=       WHERE K.K_DATE = :ACTION_DATE_'
      '1102013979=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '1102013980='
      
        '1102013981=      IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044 +
        #1053#1071' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '1102013982=        -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '1102013983=        PNT_ = '#39'02'#39';'
      '1102013984=        BEGIN'
      '1102013985=            SELECT K.OUTPUT'
      '1102013986=              FROM KASSA_STATE K'
      '1102013987=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '1102013988=                                 FROM KASSA_STATE S'
      
        '1102013989=                                WHERE S.K_DATE < :ACT' +
        'ION_DATE_'
      
        '1102013990=                                  AND S.G_TOCHKA = :G' +
        '_TOCHKA_)'
      '1102013991=               AND K.G_TOCHKA = :G_TOCHKA_'
      '1102013992=            INTO :INPUT_;'
      '1102013993='
      '1102013994=            if (ROW_COUNT = 0) then'
      
        '1102013995=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' ' +
        #1055#1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '1102013996=        WHEN ANY DO'
      '1102013997=          BEGIN'
      '1102013998=            Err_Code = -20500;'
      
        '1102013999=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MS' +
        'G);'
      
        '1102014000=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102014001=            EXIT;'
      '1102014002=          END'
      '1102014003=        END'
      '1102014004='
      '1102014005=        PNT_ = '#39'03'#39';'
      '1102014006=        INSERT INTO KASSA_STATE'
      '1102014007=          (KASSA_STATE, K_DATE,'
      '1102014008=           INPUT, DEBET, CREDIT, OUTPUT,'
      '1102014009=           G_TOCHKA, NEED_TO_EXPORT)'
      '1102014010=        VALUES'
      '1102014011=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_,'
      
        '1102014012=          COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0),' +
        ' COALESCE(:CREDIT_, 0), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_,' +
        ' 0) + COALESCE(:CREDIT_,0),'
      '1102014013=          :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102014014='
      
        '1102014015=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042 +
        #1048#1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102014016=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE S' +
        'YSTEM_SETUP = 5) > 0) THEN BEGIN'
      '1102014017=            SQL_STMT_ ='#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '1102014018=                       '#39'USING (select CAST('#39#39#39'||ACTIO' +
        'N_DATE_||'#39#39#39' AS DATE) as K_DATE, '#39'||G_TOCHKA_||'#39' AS G_TOCHKA '#39'||'
      '1102014019=                       '#39' from RDB$DATABASE) cd '#39'||'
      
        '1102014020=                       '#39'ON (c.K_DATE = cd.K_DATE AND ' +
        'C.G_TOCHKA = CD.G_TOCHKA) '#39'||'
      '1102014021=                       '#39'WHEN MATCHED THEN '#39'||'
      '1102014022=                       '#39' UPDATE SET '#39'||'
      
        '1102014023=                       '#39'  C.INPUT  = COALESCE((SELECT' +
        ' "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'|' +
        '|'
      
        '1102014024=                                                     ' +
        '                                           '#39' FROM KASSA_STATE '#39'|' +
        '|'
      
        '1102014025=                                                     ' +
        '                                           '#39' WHERE K_DATE < CD.K' +
        '_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '1102014026=                                                     ' +
        '                                           '#39' AND G_TOCHKA = CD.G' +
        '_TOCHKA), 0), '#39'||'
      
        '1102014027=                       '#39'  C.DEBET  = C.DEBET + '#39'||DEB' +
        'ET_||'#39', '#39'||'
      
        '1102014028=                       '#39'  C.CREDIT = C.CREDIT + '#39'||CR' +
        'EDIT_||'#39', '#39'||'
      
        '1102014029=                       '#39'  C.OUTPUT = COALESCE((SELECT' +
        ' "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'|' +
        '|'
      
        '1102014030=                                                     ' +
        '                                           '#39' FROM KASSA_STATE '#39'|' +
        '|'
      
        '1102014031=                                                     ' +
        '                                           '#39' WHERE K_DATE < CD.K' +
        '_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '1102014032=                                                     ' +
        '                                           '#39' AND G_TOCHKA = CD.G' +
        '_TOCHKA), 0) - (C.DEBET + '#39'||DEBET_||'#39') + (C.CREDIT + '#39'||CREDIT_' +
        '||'#39') '#39'||'
      '1102014033=                       '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '1102014034=                       '#39' INSERT (KASSA_STATE, K_DATE,' +
        ' "INPUT", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '1102014035=                       '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_' +
        'STATE, 0)||'#39', '#39#39#39'||ACTION_DATE_||'#39#39#39', COALESCE((SELECT "OUTPUT" ' +
        'FROM KASSA_STATE WHERE '#39'||'
      
        '1102014036=                            '#39'K_DATE = (SELECT MAX(K_D' +
        'ATE) '#39'||'
      '1102014037=                            '#39' FROM KASSA_STATE '#39'||'
      
        '1102014038=                            '#39' WHERE K_DATE < CD.K_DAT' +
        'E AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '1102014039=                            '#39' AND G_TOCHKA = CD.G_TOC' +
        'HKA), 0), '#39'||DEBET_||'#39', '#39'||CREDIT_||'#39', COALESCE((SELECT "OUTPUT"' +
        ' FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '1102014040=                                                     ' +
        '                                               '#39' FROM KASSA_STAT' +
        'E '#39'||'
      
        '1102014041=                                                     ' +
        '                                               '#39' WHERE K_DATE < ' +
        'CD.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '1102014042=                                                     ' +
        '                                               '#39' AND G_TOCHKA = ' +
        'CD.G_TOCHKA), 0) - '#39'||DEBET_||'#39' + '#39'||CREDIT_||'#39', '#39'||G_TOCHKA_||'#39 +
        ');'#39';'
      
        '1102014043=            INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TR' +
        'ANSFERED, SYSDATE, ERR_CODE)'
      
        '1102014044=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, ' +
        #39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102014045=        END'
      '1102014046=      END'
      '1102014047=      ELSE BEGIN'
      
        '1102014048=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042 +
        #1048#1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102014049=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE S' +
        'YSTEM_SETUP = 5) > 0) THEN BEGIN'
      '1102014050=            SQL_STMT_ ='#39'UPDATE KASSA_STATE K '#39'||'
      
        '1102014051=                         '#39'SET K.DEBET = COALESCE(K.DE' +
        'BET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '1102014052=                            '#39'K.CREDIT = COALESCE(K.CR' +
        'EDIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '1102014053=                            '#39'K.OUTPUT = COALESCE(K.IN' +
        'PUT, 0) - (COALESCE(K.DEBET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39') + ' +
        '(COALESCE(K.CREDIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39') '#39'||'
      
        '1102014054=                       '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION' +
        '_DATE_||'#39#39#39' '#39'||'
      
        '1102014055=                         '#39'AND K.G_TOCHKA = '#39'||G_TOCHK' +
        'A_||'#39';'#39';'
      
        '1102014056=            INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TR' +
        'ANSFERED, SYSDATE, ERR_CODE)'
      
        '1102014057=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, ' +
        #39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102014058=        END'
      '1102014059=      END'
      '1102014060=  END'
      '1102014061='
      '1102014062=  -- '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1041#1045#1047#1053#1040#1051
      '1102014063=  ELSE BEGIN'
      '1102014064=    UPDATE KASSA_BEZNAL_STATE K'
      
        '1102014065=       SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE(' +
        ':DEBET_, 0),'
      
        '1102014066=           K.CREDIT = COALESCE(K.CREDIT, 0) + COALESC' +
        'E(:CREDIT_, 0),'
      
        '1102014067=           K.OUTPUT = COALESCE(K.INPUT, 0) - (COALESC' +
        'E(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) +' +
        ' COALESCE(:CREDIT_, 0))'
      '1102014068=     WHERE K.K_DATE = :ACTION_DATE_;'
      '1102014069='
      
        '1102014070=    IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071 +
        ' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '1102014071=      -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '1102014072=      PNT_ = '#39'03A'#39';'
      '1102014073=      BEGIN'
      '1102014074=        SELECT K.OUTPUT'
      '1102014075=          FROM KASSA_BEZNAL_STATE K'
      '1102014076=         WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      
        '1102014077=                             FROM KASSA_BEZNAL_STATE ' +
        'S'
      
        '1102014078=                            WHERE S.K_DATE < :ACTION_' +
        'DATE_)'
      '1102014079=        INTO :INPUT_;'
      '1102014080='
      '1102014081=        if (ROW_COUNT = 0) then'
      
        '1102014082=          INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042 +
        #1040#1071' '#1047#1040#1055#1048#1057#1068
      '1102014083=      WHEN ANY DO'
      '1102014084=        BEGIN'
      '1102014085=          Err_Code = -20500;'
      
        '1102014086=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064 +
        #1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1102014087=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102014088=          EXIT;'
      '1102014089=        END'
      '1102014090=      END'
      '1102014091='
      '1102014092=      INSERT INTO KASSA_BEZNAL_STATE'
      
        '1102014093=        (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CR' +
        'EDIT, OUTPUT)'
      '1102014094=      VALUES'
      
        '1102014095=        (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, C' +
        'OALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0)' +
        ', COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDIT' +
        '_,0));'
      '1102014096='
      
        '1102014097=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058 +
        #1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102014098=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYS' +
        'TEM_SETUP = 5) > 0) THEN BEGIN'
      
        '1102014099=            SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE' +
        ' c '#39'||'
      
        '1102014100=                       '#39'USING (select CAST('#39#39#39'||ACTIO' +
        'N_DATE_||'#39#39#39' AS DATE) as K_DATE'#39'||'
      '1102014101=                       '#39' from RDB$DATABASE) cd '#39'||'
      '1102014102=                       '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '1102014103=                       '#39'WHEN MATCHED THEN '#39'||'
      '1102014104=                       '#39' UPDATE SET '#39'||'
      
        '1102014105=                       '#39'  C.INPUT  = COALESCE((SELECT' +
        ' "OUTPUT" FROM KASSA_BEZNAL_STATE WHERE K_DATE = (SELECT MAX(K_D' +
        'ATE) '#39'||'
      
        '1102014106=                                                     ' +
        '                                           '#39' FROM KASSA_BEZNAL_S' +
        'TATE '#39'||'
      
        '1102014107=                                                     ' +
        '                                           '#39' WHERE K_DATE < CD.K' +
        '_DATE) '#39'||'
      
        '1102014108=                                                     ' +
        '                                           '#39' ), 0), '#39'||'
      
        '1102014109=                       '#39'  C.DEBET  = C.DEBET + '#39'||DEB' +
        'ET_||'#39', '#39'||'
      
        '1102014110=                       '#39'  C.CREDIT = C.CREDIT + '#39'||CR' +
        'EDIT_||'#39', '#39'||'
      
        '1102014111=                       '#39'  C.OUTPUT = COALESCE((SELECT' +
        ' "OUTPUT" FROM KASSA_BEZNAL_STATE WHERE K_DATE = (SELECT MAX(K_D' +
        'ATE) '#39'||'
      
        '1102014112=                                                     ' +
        '                                           '#39' FROM KASSA_BEZNAL_S' +
        'TATE '#39'||'
      
        '1102014113=                                                     ' +
        '                                           '#39' WHERE K_DATE < CD.K' +
        '_DATE) '#39'||'
      
        '1102014114=                                                     ' +
        '                                           '#39' ), 0) - (C.DEBET + ' +
        #39'||DEBET_||'#39') + (C.CREDIT + '#39'||CREDIT_||'#39') '#39'||'
      '1102014115=                       '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '1102014116=                       '#39' INSERT (KASSA_BEZNAL_STATE, ' +
        'K_DATE, "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
        '1102014117=                       '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_' +
        'STATE, 0)||'#39', '#39#39#39'||ACTION_DATE_||'#39#39#39', COALESCE((SELECT "OUTPUT" ' +
        'FROM KASSA_BEZNAL_STATE WHERE '#39'||'
      
        '1102014118=                            '#39'K_DATE = (SELECT MAX(K_D' +
        'ATE) '#39'||'
      
        '1102014119=                            '#39' FROM KASSA_BEZNAL_STATE' +
        ' '#39'||'
      
        '1102014120=                            '#39' WHERE K_DATE < CD.K_DAT' +
        'E) '#39'||'
      
        '1102014121=                            '#39' ), 0), '#39'||DEBET_||'#39', '#39'|' +
        '|CREDIT_||'#39', COALESCE((SELECT "OUTPUT" FROM KASSA_BEZNAL_STATE W' +
        'HERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '1102014122=                                                     ' +
        '                                               '#39' FROM KASSA_BEZN' +
        'AL_STATE '#39'||'
      
        '1102014123=                                                     ' +
        '                                               '#39' WHERE K_DATE < ' +
        'CD.K_DATE) '#39'||'
      
        '1102014124=                                                     ' +
        '                                               '#39' ), 0) - '#39'||DEBE' +
        'T_||'#39' + '#39'||CREDIT_||'#39');'#39';'
      
        '1102014125=            INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TR' +
        'ANSFERED, SYSDATE, ERR_CODE)'
      
        '1102014126=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, ' +
        #39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102014127=      END'
      '1102014128=    END'
      '1102014129=    ELSE BEGIN'
      
        '1102014130=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042 +
        #1048#1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '1102014131=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE S' +
        'YSTEM_SETUP = 5) > 0) THEN BEGIN'
      
        '1102014132=            SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39 +
        '||'
      
        '1102014133=                         '#39'SET K.DEBET = COALESCE(K.DE' +
        'BET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '1102014134=                            '#39'K.CREDIT = COALESCE(K.CR' +
        'EDIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '1102014135=                            '#39'K.OUTPUT = COALESCE(K.IN' +
        'PUT, 0) - (COALESCE(K.DEBET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39') + ' +
        '(COALESCE(K.CREDIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39') '#39'||'
      
        '1102014136=                       '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION' +
        '_DATE_||'#39#39#39';'#39';'
      
        '1102014137=            INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TR' +
        'ANSFERED, SYSDATE, ERR_CODE)'
      
        '1102014138=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, ' +
        #39'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '1102014139=        END'
      '1102014140=    END'
      '1102014141=  END'
      '1102014142=END'
      '1102014143=;'
      '1102014144='
      '1102014145=ALTER PROCEDURE LOG_INIT'
      '1102014146=AS'
      '1102014147=DECLARE VARIABLE TN VARCHAR(64);'
      '1102014148=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '1102014149=DECLARE VARIABLE FN VARCHAR(64);'
      '1102014150=DECLARE VARIABLE TP INTEGER;'
      
        '1102014151=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102014152=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102014153=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000); */'
      
        '1102014154=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80; /* VARCHAR(30000); */'
      '1102014155=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '1102014156=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '1102014157=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '1102014158=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        '; /* VARCHAR(30000) */'
      
        '1102014159=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      
        '1102014160=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80' +
        ';'
      '1102014161=DECLARE VARIABLE ANZ INTEGER;'
      '1102014162=DECLARE VARIABLE L INTEGER;'
      '1102014163=DECLARE VARIABLE P INTEGER;'
      '1102014164=DECLARE VARIABLE S INTEGER;'
      '1102014165=DECLARE VARIABLE FT CHAR(1);'
      '1102014166=DECLARE VARIABLE CRLF VARCHAR(10);'
      '1102014167=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '1102014168=BEGIN'
      '1102014169=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '1102014170='
      '1102014171=  TN_ALT='#39#39';'
      '1102014172=  TRGI='#39#39';'
      '1102014173=  TRGU='#39#39';'
      '1102014174=  TRGD='#39#39';'
      '1102014175=  TRGIX='#39#39';'
      '1102014176=  TRGUX='#39#39';'
      '1102014177=  TRGDX='#39#39';'
      '1102014178=  SQLF='#39#39';'
      '1102014179=  SQLV='#39#39';'
      '1102014180=  SQLU='#39#39';'
      '1102014181=  FT='#39#39';'
      '1102014182='
      '1102014183=  FOR SELECT R.RDB$RELATION_NAME,'
      '1102014184=            R.RDB$FIELD_NAME,'
      '1102014185=            F.RDB$FIELD_TYPE,'
      '1102014186=            F.RDB$FIELD_LENGTH,'
      '1102014187=            F.RDB$FIELD_PRECISION,'
      '1102014188=            F.RDB$FIELD_SCALE'
      '1102014189=        FROM RDB$RELATION_FIELDS R,'
      '1102014190=             RDB$FIELDS F'
      '1102014191=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1102014192=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '1102014193=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '1102014194=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39 +
        ', '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '1102014195=                                         '#39'IMPORT_TBL_' +
        'TMP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '1102014196=                                         '#39'P_REP_KASSI' +
        'R_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '1102014197=                                         '#39'P_REP_PROFI' +
        'T_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39 +
        ','
      
        '1102014198=                                         '#39'P_REP_TREE'#39 +
        ', '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPOR' +
        'T'#39','
      
        '1102014199=                                         '#39'REVISION'#39', ' +
        #39'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '1102014200=                                         '#39'ZAKAZ_DETAI' +
        'LS_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PRO' +
        'DUCT_FILL'#39','
      
        '1102014201=                                         '#39'KASSA_STATE' +
        #39', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39')'
      '1102014202=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '1102014203=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '1102014204=              OR'
      
        '1102014205=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD' +
        '_SUB_TYPE <> 0)'
      '1102014206=             )'
      
        '1102014207=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSIT' +
        'ION'
      '1102014208=        INTO :TN,:FN,:TP,:L,:P,:S'
      '1102014209=  DO BEGIN'
      '1102014210=    TN=TRIM(TN);'
      '1102014211=    FN=TRIM(FN);'
      '1102014212=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '1102014213=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '1102014214=      EXECUTE STATEMENT TRGI;'
      '1102014215=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '1102014216=      EXECUTE STATEMENT TRGU;'
      '1102014217=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '1102014218=      EXECUTE STATEMENT TRGD;'
      '1102014219='
      '1102014220=      SQLF='#39#39';'
      '1102014221=      SQLV='#39#39';'
      '1102014222=      SQLU='#39#39';'
      '1102014223=    END'
      '1102014224=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '1102014225=      ID_COLUMN = FN;'
      '1102014226='
      '1102014227=    S=-S;'
      
        '1102014228=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp' +
        '=27)) then'
      '1102014229=      ft='#39'N'#39';   --numerisch'
      '1102014230=    else'
      '1102014231=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '1102014232=        ft='#39'Z'#39';   --zeit'
      '1102014233=      else'
      '1102014234=        ft='#39'T'#39';'
      '1102014235='
      '1102014236=    IF (SQLF='#39#39') THEN'
      '1102014237=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '1102014238=    ELSE'
      '1102014239=      SQLF=SQLF||'#39','#39'||FN;'
      '1102014240='
      '1102014241=    if (ft='#39'N'#39') then begin'
      '1102014242=      IF (SQLV='#39#39') THEN'
      
        '1102014243=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102014244=      ELSE'
      
        '1102014245=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102014246='
      '1102014247=      IF (SQLU='#39#39') THEN'
      
        '1102014248=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UP' +
        'DATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102014249=      ELSE'
      
        '1102014250=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'|' +
        '|FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1102014251=    end'
      '1102014252=    else'
      '1102014253=      if (ft='#39'Z'#39') then begin'
      '1102014254=        IF (SQLV='#39#39') THEN'
      
        '1102014255=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||r' +
        'eplace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
