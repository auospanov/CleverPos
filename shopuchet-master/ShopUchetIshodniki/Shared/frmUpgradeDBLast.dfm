        '110168957=  OSNOVANIE /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCH' +
        'AR(150),'
      '110168958=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '110168959=  CLIENT_ID /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIG' +
        'INT,'
      '110168960=  IDN /* TYPE OF COLUMN G_CLIENT.IDN */ VARCHAR(12),'
      
        '110168961=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCH' +
        'AR(250),'
      
        '110168962=  SKLAD_NAME /* TYPE OF COLUMN G_TOCHKA.NAME */ VARCHA' +
        'R(250),'
      
        '110168963=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMER' +
        'IC(15,2),'
      
        '110168964=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */' +
        ' NUMERIC(15,2),'
      '110168965=  SUMM_SERT /* MY_NUMERIC */ NUMERIC(15,2),'
      
        '110168966=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110168967=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(30),'
      
        '110168968=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLA' +
        'TUR_NUM */ VARCHAR(150),'
      
        '110168969=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCH' +
        'AR(250),'
      
        '110168970=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUM' +
        'ERIC(18,5),'
      
        '110168971=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMER' +
        'IC(15,2),'
      
