      '110129291=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110129292=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110129293=  ROW_NUM INTEGER,'
      
        '110129294=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250' +
        '),'
      '110129295=  NAME_ART VARCHAR(1000),'
      '110129296=  AMOUNT VARCHAR(50),'
      
        '110129297=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(' +
        '50),'
      '110129298=  PRICE VARCHAR(50),'
      '110129299=  PRICE_N VARCHAR(50),'
      '110129300=  SUMM VARCHAR(50),'
      '110129301=  SUMM_N VARCHAR(50),'
      '110129302=  SUMM_POLUCH_ VARCHAR(50),'
      '110129303=  SUMM_SDACH_ VARCHAR(50),'
      '110129304=  SUMM_STR_ VARCHAR(200),'
      '110129305=  SLOGAN_ VARCHAR(80),'
      '110129306=  SUMM_SKIDKA_ VARCHAR(50),'
      '110129307=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '110129308=  BONUS_STR_ VARCHAR(50),'
      '110129309=  ERR_CODE NUMERIC(15,2),'
      '110129310=  ERR_MSG VARCHAR(1024))'
      '110129311=AS'
      '110129312=BEGIN'
      '110129313=  SUSPEND;'
      '110129314=END'
      '110129315=;'
      '110129316='
      '110129317=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '110129318=RETURNS ('
      
        '110129319=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZA' +
        'KAZ_DETAILS */ BIGINT,'
      
        '110129320=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ B' +
        'IGINT,'
      
        '110129321=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PROD' +
        'UCT */ BIGINT,'
      
        '110129322=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */' +
        ' NUMERIC(18,5),'
      
        '110129323=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ N' +
        'UMERIC(15,2),'
      
        '110129324=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUM' +
        'ERIC(15,2),'
      
        '110129325=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_PERC */ NUMERIC(15,2),'
      
        '110129326=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.D' +
        'ISCOUNT_TENGE */ NUMERIC(15,2),'
      
        '110129327=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_SUMM */ NUMERIC(15,2),'
      
        '110129328=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMER' +
        'IC(15,2),'
      
        '110129329=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUM' +
        'M */ NUMERIC(15,2),'
      
        '110129330=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VAR' +
        'CHAR(250),'
      
        '110129331=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCH' +
        'AR(30),'
      
        '110129332=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCH' +
        'AR(30),'
      
        '110129333=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ N' +
        'UMERIC(15,2),'
      
        '110129334=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_' +
        'PRICE */ NUMERIC(15,2),'
      
        '110129335=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER' +
        ','
      
        '110129336=  SUM_TO_CHARGE_BONUS /* TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.SUMM */ NUMERIC(15,2))'
      '110129337=AS'
      '110129338=BEGIN'
      '110129339=  SUSPEND;'
      '110129340=END'
      '110129341=;'
      '110129342='
      '110129343='
      
        '110129344=/*****************************************************' +
        '*************************/'
      
        '110129345=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110129346=/*****************************************************' +
        '*************************/'
      '110129347=ALTER PROCEDURE G_GET_DCARD_BY_CODE('
      
        '110129348=  G_DISCONT_CARD_ TYPE OF COLUMN G_DISCONT_CARD.G_DISC' +
        'ONT_CARD,'
      '110129349=  CARD_CODE_ VARCHAR(13))'
      '110129350=RETURNS ('
      '110129351=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110129352=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110129353=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110129354=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110129355=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110129356=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110129357=  ERR_CODE INTEGER,'
      '110129358=  ERR_MSG VARCHAR(1024))'
      '110129359=AS'
      
        '110129360=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_GET_DCARD_B' +
        'Y_CODE'#39';'
      '110129361=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110129362=BEGIN'
      '110129363=  SELECT'
      '110129364=    C.G_CLIENT,'
      '110129365=    C.NAME,'
      '110129366=    D.BARCODE,'
      '110129367=    D.N_PERCENT,'
      '110129368=    D.SUMM,'
      '110129369=    D.SUMM_ALL'
      '110129370=  FROM G_DISCONT_CARD D, G_CLIENT C'
      '110129371=  WHERE ('
      
        '110129372=            ((BARCODE = :CARD_CODE_ AND CHAR_LENGTH(:C' +
        'ARD_CODE_) > 0)  -- '#1063#1058#1054#1041#1067' '#1057#1058#1056#1054#1050#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1051#1048#1057#1068' '#1055#1054' '#1055#1059#1057#1058#1054#1058#1045
      '110129373=             OR'
      
        '110129374=             (C.PHONE LIKE '#39'%'#39'||:CARD_CODE_||'#39'%'#39' AND C' +
        'HAR_LENGTH(:CARD_CODE_) > 0)'
      '110129375=             )'
      
        '110129376=         or (D.G_DISCONT_CARD = COALESCE(:G_DISCONT_CA' +
        'RD_, 0))'
      '110129377=        )'
      '110129378=    AND D.G_CLIENT = C.G_CLIENT'
      '110129379=  INTO'
      '110129380=    :G_CLIENT_,'
      '110129381=    :CLIENT_NAME_,'
      '110129382=    :BARCODE_,'
      '110129383=    :N_PERCENT_,'
      '110129384=    :SUMM_,'
      '110129385=    :SUMM_ALL_;'
      '110129386=END'
      '110129387=;'
      '110129388='
      '110129389=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110129390=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110129391=RETURNS ('
      
        '110129392=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110129393=  ARTICUL_ VARCHAR(30),'
      '110129394=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110129395=  BARCODE_ VARCHAR(30),'
      '110129396=  NAME_ VARCHAR(500),'
      '110129397=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110129398=  PRICE_ NUMERIC(15,2),'
      '110129399=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110129400=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110129401=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110129402=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110129403=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110129404=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110129405=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110129406=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110129407=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110129408=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110129409=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110129410=  DO_NOT_SHOW_RMK_ TYPE OF COLUMN G_PRODUCT.DO_NOT_SHO' +
        'W_RMK,'
      
        '110129411=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110129412=  ERR_CODE INTEGER,'
      '110129413=  ERR_MSG VARCHAR(1024))'
      '110129414=AS'
      '110129415=begin'
      '110129416=    SELECT'
      '110129417=        G_PRODUCT_PAR,'
      '110129418=        ARTICUL,'
      '110129419=        NOMENCLATUR_NUM,'
      '110129420=        BARCODE,'
      '110129421=        NAME,'
      '110129422=        G_UNIT,'
      '110129423=        PRICE,'
      '110129424=        VOLUME_PRICE,'
      '110129425=        PACK_AMOUNT,'
      '110129426=        MF_COUNTRY,'
      '110129427=        NOTE,'
      '110129428=        CROSSCODE,'
      '110129429=        IS_KIT,'
      '110129430=        MIN_AMOUNT,'
      '110129431=        PLACE,'
      '110129432=        SALES_COMM,'
      '110129433=        KOD_TNVD,'
      '110129434=        FAST_TOVAR,'
      '110129435=        DO_NOT_SHOW_RMK,'
      '110129436=        DO_NOT_CHARGE_BONUS'
      '110129437=    FROM G_PRODUCT T'
      '110129438=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110129439=    INTO'
      '110129440=        :G_PRODUCT_PAR_,'
      '110129441=        :ARTICUL_,'
      '110129442=        :NOMENCLATUR_NUM_,'
      '110129443=        :BARCODE_,'
      '110129444=        :NAME_,'
      '110129445=        :G_UNIT_,'
      '110129446=        :PRICE_,'
      '110129447=        :VOLUME_PRICE_,'
      '110129448=        :PACK_AMOUNT_,'
      '110129449=        :MF_COUNTRY_,'
      '110129450=        :NOTE_,'
      '110129451=        :CROSSCODE_,'
      '110129452=        :IS_KIT_,'
      '110129453=        :MIN_AMOUNT_,'
      '110129454=        :PLACE_,'
      '110129455=        :SALES_COMM_,'
      '110129456=        :KOD_TNVD_,'
      '110129457=        :FAST_TOVAR_,'
      '110129458=        :DO_NOT_SHOW_RMK_,'
      '110129459=        :DO_NOT_CHARGE_BONUS_;'
      '110129460='
      '110129461=    INSERT INTO LT_BARCODE_TMP'
      
        '110129462=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110129463='
      '110129464=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110129465=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110129466='
      '110129467=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '110129468=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '110129469=end'
      '110129470=;'
      '110129471='
      '110129472=ALTER PROCEDURE G_INS_G_PRODUCT('
      
        '110129473=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110129474=  ARTICUL_ VARCHAR(30),'
      '110129475=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110129476=  BARCODE_ VARCHAR(30),'
      '110129477=  NAME_ VARCHAR(500),'
      '110129478=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110129479=  PRICE_ NUMERIC(15,2),'
      '110129480=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110129481=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110129482=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110129483=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110129484=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110129485=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110129486=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110129487=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110129488=  IS_CATEGORY_ INTEGER,'
      '110129489=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110129490=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110129491=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110129492=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS)'
      '110129493=RETURNS ('
      '110129494=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110129495=  ERR_CODE INTEGER,'
      '110129496=  ERR_MSG VARCHAR(1024))'
      '110129497=AS'
      
        '110129498=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_INS_G_PRODU' +
        'CT'#39';'
      '110129499=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110129500=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110129501=begin'
      
        '110129502=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110129503=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '110129504=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110129505=                      FROM G_PRODUCT G'
      
        '110129506=                     WHERE UPPER(G.ARTICUL) = UPPER(TR' +
        'IM(:ARTICUL_))'
      '110129507=                       AND TRIM(G.ARTICUL) <> '#39#39
      
        '110129508=                       AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '110129509=          ERR_CODE = -20500;'
      
        '110129510=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '110129511=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110129512=          EXIT;'
      '110129513=        END'
      '110129514=    end'
      '110129515='
      '110129516=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '110129517=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then' +
        ' begin'
      '110129518=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110129519=                     FROM G_PRODUCT G'
      
        '110129520=                    WHERE UPPER(G.NOMENCLATUR_NUM) = U' +
        'PPER(TRIM(:NOMENCLATUR_NUM_))'
      
        '110129521=                      AND TRIM(G.NOMENCLATUR_NUM) <> '#39 +
        #39
      '110129522=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110129523=          ERR_CODE = -20500;'
      
        '110129524=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '110129525=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110129526=          EXIT;'
      '110129527=        END'
      '110129528=    end'
      '110129529='
      '110129530=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110129531=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110129532=        IF (EXISTS (SELECT FIRST 1 G_PRODUCT'
      '110129533=                      FROM G_PRODUCT G'
      
        '110129534=                     WHERE UPPER(G.BARCODE) = UPPER(TR' +
        'IM(:BARCODE_))'
      '110129535=                       AND TRIM(G.BARCODE) <> '#39#39
      
        '110129536=                       AND G.IS_ACTIVE = 1)) THEN BEGI' +
        'N'
      '110129537=          ERR_CODE = -20500;'
      
        '110129538=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110129539=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110129540=          EXIT;'
      '110129541=        END'
      '110129542='
      '110129543=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '110129544=                     FROM G_PRODUCT G, LT_BARCODE L'
      '110129545=                    WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110129546=                      AND L.BARCODE = TRIM(:BARCODE_)'
      '110129547=                      AND TRIM(L.BARCODE) <> '#39#39
      '110129548=                      AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110129549=          ERR_CODE = -20500;'
      
        '110129550=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074 +
        #1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110129551=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110129552=          EXIT;'
      '110129553=        END'
      '110129554=    end'
      '110129555='
      
        '110129556=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PR' +
        'ICE,'
      
        '110129557=                           IS_CATEGORY, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE, SALES_COM' +
        'M, KOD_TNVD,'
      
        '110129558=                           FAST_TOVAR, DO_NOT_CHARGE_B' +
        'ONUS)'
      
        '110129559=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRI' +
        'CE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '110129560=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROS' +
        'SCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_, :SALES_COMM_, :KOD_TNVD' +
        '_,'
      '110129561=            :FAST_TOVAR_, :DO_NOT_CHARGE_BONUS_)'
      '110129562=    RETURNING G_PRODUCT'
      '110129563=    INTO :G_PRODUCT_;'
      '110129564='
      '110129565=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '110129566=    if (:IS_CATEGORY_ = 0) then begin'
      
        '110129567=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110129568=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '110129569='
      '110129570=        INSERT INTO LT_BARCODE'
      
        '110129571=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110129572='
      
        '110129573=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090 +
        #1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '110129574=        INSERT into G_PRODUCT_IMAGE'
      
        '110129575=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYP' +
        'E from G_PRODUCT_IMAGE_TMP;'
      '110129576='
      
        '110129577=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089 +
        #1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '110129578=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091 +
        #1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '110129579=        IF (is_kit_ > 0) THEN begin'
      '110129580=            INSERT INTO G_PRODUCT_KIT'
      
        '110129581=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP;'
      '110129582='
      '110129583=            if (is_kit_ = 1) then begin'
      
        '110129584=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110129585=                  FROM G_PRODUCT_KIT K,'
      '110129586=                       LT_SKLAD_PRODUCT L'
      '110129587=                 WHERE K.g_product = :G_PRODUCT_'
      '110129588=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110129589=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110129590=                 GROUP BY K.G_PRODUCT'
      '110129591=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110129592='
      '110129593=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110129594=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_' +
        'SOSTAV_AMOUNT_, 0)'
      '110129595=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110129596=            end'
      '110129597=        END'
      '110129598=    END'
      '110129599=end'
      '110129600=;'
      '110129601='
      '110129602=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110129603=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110129604=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110129605=  ARTICUL_ VARCHAR(30),'
      '110129606=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110129607=  BARCODE_ VARCHAR(30),'
      '110129608=  NAME_ VARCHAR(500),'
      '110129609=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110129610=  PRICE_ NUMERIC(15,2),'
      '110129611=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110129612=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110129613=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110129614=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110129615=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110129616=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110129617=  IS_CATEGORY_ INTEGER,'
      '110129618=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110129619=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110129620=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110129621=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110129622=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110129623=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS)'
      '110129624=RETURNS ('
      '110129625=  ERR_CODE INTEGER,'
      '110129626=  ERR_MSG VARCHAR(1024))'
      '110129627=AS'
      
        '110129628=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODU' +
        'CT'#39';'
      
        '110129629=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110129630=begin'
      
        '110129631=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110129632=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '110129633=                  FROM G_PRODUCT G'
      
        '110129634=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:' +
        'ARTICUL_))'
      '110129635=                   AND TRIM(G.ARTICUL) <> '#39#39
      '110129636=                   AND TRIM(:ARTICUL_) <> '#39#39
      '110129637=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110129638=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110129639=      ERR_CODE = -20500;'
      
        '110129640=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      '110129641=      EXIT;'
      '110129642=    END'
      '110129643='
      '110129644=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110129645=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110129646=                  FROM G_PRODUCT G'
      
        '110129647=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPPE' +
        'R(TRIM(:NOMENCLATUR_NUM_))'
      '110129648=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110129649=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '110129650=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110129651=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110129652=      ERR_CODE = -20500;'
      
        '110129653=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110129654=      EXIT;'
      '110129655=    END'
      '110129656='
      '110129657=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110129658=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110129659=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110129660=                  FROM G_PRODUCT G'
      
        '110129661=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(:' +
        'BARCODE_))'
      '110129662=                   AND TRIM(G.BARCODE) <> '#39#39
      '110129663=                   AND TRIM(:BARCODE_) <> '#39#39
      '110129664=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110129665=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110129666=          ERR_CODE = -20500;'
      
        '110129667=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110129668=          EXIT;'
      '110129669=        END'
      '110129670='
      '110129671=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '110129672=                    FROM G_PRODUCT G, LT_BARCODE L'
      '110129673=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110129674=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '110129675=                     AND TRIM(L.BARCODE) <> '#39#39
      '110129676=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110129677=          ERR_CODE = -20500;'
      
        '110129678=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110129679=          EXIT;'
      '110129680=        END'
      '110129681=    END'
      '110129682='
      '110129683=    update G_PRODUCT'
      '110129684=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110129685=        ARTICUL = :ARTICUL_,'
      '110129686=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110129687=        BARCODE = :BARCODE_,'
      '110129688=        NAME = :NAME_,'
      '110129689=        G_UNIT = :G_UNIT_,'
      '110129690=        PRICE = :PRICE_,'
      '110129691=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110129692=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110129693=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110129694=        NOTE         = :NOTE_,'
      '110129695=        CROSSCODE    = :CROSSCODE_,'
      '110129696=        IS_KIT       = :IS_KIT_,'
      '110129697=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110129698=        PLACE        = :PLACE_,'
      '110129699=        SALES_COMM   = :SALES_COMM_,'
      '110129700=        KOD_TNVD     = :KOD_TNVD_,'
      '110129701=        FAST_TOVAR   = :FAST_TOVAR_,'
      '110129702=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_'
      '110129703=    where (G_PRODUCT = :G_PRODUCT_);'
      '110129704='
      '110129705=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110129706=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110129707='
      '110129708=        INSERT INTO LT_BARCODE'
      
        '110129709=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110129710='
      '110129711=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110129712=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110129713=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110129714='
      
        '110129715=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110129716=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110129717='
      '110129718=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110129719=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110129720=            INSERT INTO G_PRODUCT_KIT'
      
        '110129721=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110129722=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110129723=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110129724=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110129725='
      
        '110129726=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110129727=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110129728='
      '110129729=            UPDATE G_PRODUCT_KIT G'
      
        '110129730=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110129731=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110129732=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110129733=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110129734='
      
        '110129735=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110129736=            if (is_kit_ = 1) then begin'
      
        '110129737=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110129738=                  FROM G_PRODUCT_KIT K,'
      '110129739=                       LT_SKLAD_PRODUCT L'
      '110129740=                 WHERE K.g_product = :G_PRODUCT_'
      '110129741=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110129742=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110129743=                 GROUP BY K.G_PRODUCT'
      '110129744=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110129745='
      '110129746=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110129747=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110129748=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110129749=            end'
      '110129750=        END'
      '110129751=    END'
      '110129752=end'
      '110129753=;'
      '110129754='
      '110129755=ALTER PROCEDURE INS_SKLAD('
      '110129756=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110129757=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110129758=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110129759=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110129760=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110129761=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110129762=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110129763=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110129764=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110129765=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110129766=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110129767=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110129768=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110129769=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110129770=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0,'
      '110129771=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110129772=RETURNS ('
      '110129773=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110129774=  ERR_CODE INTEGER,'
      '110129775=  ERR_MSG VARCHAR(1024))'
      '110129776=AS'
      '110129777=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110129778=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110129779=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110129780=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110129781=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110129782=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110129783=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110129784=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110129785=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110129786=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110129787=--'
      
        '110129788=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110129789=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110129790=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110129791=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110129792=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110129793=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110129794=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110129795=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110129796=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110129797=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110129798=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110129799=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110129800=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110129801=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110129802=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110129803=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110129804=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110129805=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110129806=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110129807=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110129808=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110129809=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110129810=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110129811=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      
        '110129812=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110129813=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      '110129814=BEGIN'
      '110129815='
      '110129816=  PNT_ = '#39'00'#39';'
      '110129817=  IS_THIS_LAST_ = 0;'
      '110129818='
      '110129819=  IF (G_TOCHKA_ IS NULL) THEN'
      '110129820=    SELECT ID'
      '110129821=      FROM CUR_PARAMS'
      '110129822=     WHERE CUR_PARAMS = 2'
      '110129823=      INTO :G_TOCHKA_;'
      '110129824='
      '110129825=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110129826=  SELECT ID'
      '110129827=    FROM CUR_PARAMS'
      '110129828=   WHERE CUR_PARAMS = 1'
      '110129829=    INTO :G_OFFICIAL_;'
      '110129830='
      '110129831=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110129832=                            DATE_RECEIPT,'
      '110129833=                            TIME_RECEIPT,'
      '110129834=                            G_CLIENT,'
      '110129835=                            G_PAYMENT_TYPE,'
      '110129836=                            OSNOVANIE,'
      '110129837=                            NOTE,'
      '110129838=                            SUMM,'
      '110129839=                            SUMM_FACT,'
      '110129840=                            SUMM_CURRENCY,'
      '110129841=                            IS_PAYED_ALL,'
      '110129842=                            IS_VOZVRAT,'
      '110129843=                            G_TOCHKA'
      '110129844=                            ,G_OFFICIAL'
      '110129845=                            ,IS_EXPECTED)'
      '110129846=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110129847=          :DATE_RECEIPT_,'
      '110129848=          :TIME_RECEIPT_,'
      '110129849=          :G_CLIENT_,'
      '110129850=          :G_PAYMENT_TYPE_,'
      '110129851=          :OSNOVANIE_,'
      '110129852=          :NOTE_,'
      '110129853=          :SUMM_,'
      '110129854=          :SUMM_FACT_,'
      '110129855=          :SUMM_CURRENCY_,'
      
        '110129856=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PA' +
        'YED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "' +
        #1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110129857=          :IS_VOZVRAT_,'
      '110129858=          :G_TOCHKA_'
      '110129859=          ,:G_OFFICIAL_'
      '110129860=          ,:IS_EXPECTED_)'
      '110129861=  RETURNING'
      '110129862=    SKLAD'
      '110129863=  INTO'
      '110129864=    :SKLAD_;'
      '110129865='
      '110129866=  PNT_ = '#39'01'#39';'
      '110129867=  FOR SELECT SKLAD,'
      '110129868=             T.G_PRODUCT,'
      '110129869=             AMOUNT,'
      '110129870=             T.PRICE,'
      '110129871=             SUMM,'
      '110129872=             NDS,'
      '110129873=             NDS_SUMM'
      '110129874=             ,PRICE_CURRENCY'
      '110129875=             ,SUMM_CURRENCY'
      '110129876=             ,PRICE_ROZN'
      '110129877=             ,GG.PRICE'
      '110129878=        FROM SKLAD_TMP T,'
      '110129879=             G_PRODUCT GG'
      '110129880=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110129881=      ORDER BY 1'
      '110129882=      INTO :SKLAD_TMP_,'
      '110129883=           :RG_PRODUCT_,'
      '110129884=           :RAMOUNT_,'
      '110129885=           :RPRICE_,'
      '110129886=           :RSUMM_,'
      '110129887=           :RNDS_,'
      '110129888=           :RNDS_SUMM_'
      '110129889=           ,:PRICE_CURRENCY_'
      '110129890=           ,:SUMM_CURRENCY_TMP_'
      '110129891=           ,:SALE_PRICE_'
      '110129892=           ,:SALE_PRICE_CUR_'
      '110129893=  DO BEGIN'
      '110129894=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110129895=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110129896=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110129897=      IS_THIS_LAST_ = 0;'
      '110129898=      SELECT MAX(SK.DATE_RECEIPT)'
      '110129899=        FROM SKLAD SK'
      '110129900=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110129901=         AND SK.IS_LAST = 1'
      '110129902=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110129903=        INTO :DATE_LAST_;'
      '110129904='
      
        '110129905=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110129906=        UPDATE SKLAD SK'
      '110129907=           SET SK.IS_LAST = 0'
      '110129908=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110129909=           AND SK.IS_LAST = 1'
      '110129910=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110129911='
      '110129912=        IS_THIS_LAST_ = 1;'
      '110129913=      END'
      '110129914=    END'
      '110129915='
      '110129916=    INSERT INTO SKLAD'
      '110129917=    ('
      '110129918=     SKLAD,'
      '110129919=     SKLAD_PARENT,'
      '110129920=     DATE_RECEIPT,'
      '110129921=     G_CLIENT,'
      '110129922=     G_PRODUCT,'
      '110129923=     AMOUNT,'
      '110129924=     PRICE,'
      '110129925=     SUMM,'
      '110129926=     G_PAYMENT_TYPE,'
      '110129927=     OSNOVANIE,'
      '110129928=     NOTE,'
      '110129929=     NDS,'
      '110129930=     NDS_SUMM,'
      '110129931=     IS_LAST,'
      '110129932=     IS_VOZVRAT,'
      '110129933=     G_TOCHKA'
      '110129934=     ,PRICE_CURRENCY'
      '110129935=     ,SUMM_CURRENCY'
      '110129936=    ) VALUES ('
      '110129937=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110129938=     :SKLAD_,'
      '110129939=     :DATE_RECEIPT_,'
      '110129940=     :G_CLIENT_,'
      '110129941=     :RG_PRODUCT_,'
      '110129942=     :RAMOUNT_,'
      '110129943=     :RPRICE_,'
      '110129944=     :RSUMM_,'
      '110129945=     :G_PAYMENT_TYPE_,'
      '110129946=     :OSNOVANIE_,'
      '110129947=     :NOTE_,'
      '110129948=     :RNDS_,'
      '110129949=     :RNDS_SUMM_,'
      
        '110129950=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110129951=     :IS_VOZVRAT_,'
      '110129952=     :G_TOCHKA_'
      '110129953=     ,:PRICE_CURRENCY_'
      '110129954=     ,:SUMM_CURRENCY_TMP_'
      '110129955=    );'
      '110129956='
      
        '110129957=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110129958=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110129959=        PNT_ = '#39'02'#39';'
      '110129960=        UPDATE LT_SKLAD_PRODUCT L'
      '110129961=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110129962=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110129963=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110129964='
      '110129965=        IF (ROW_COUNT = 0) THEN'
      
        '110129966=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110129967=    END'
      '110129968='
      
        '110129969=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054 +
        #1044#1045
      '110129970=      UPDATE G_PRODUCT G'
      '110129971=         SET G.PRICE = :SALE_PRICE_'
      '110129972=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110129973=  END'
      '110129974=  ----------------------------------------'
      '110129975='
      
        '110129976=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110129977=  PNT_ = '#39'05'#39';'
      
        '110129978=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110129979=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110129980=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110129981=      ELSE'
      '110129982=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110129983='
      
        '110129984=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110129985=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110129986=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110129987=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110129988=                                        :SUMM_FACT_,'
      
        '110129989=                                        :DATE_RECEIPT_' +
        ','
      
        '110129990=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110129991=                                        NULL,   --ZAKA' +
        'Z_'
      '110129992=                                        :SKLAD_,'
      
        '110129993=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110129994=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110129995=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110129996=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110129997=            EXIT;'
      '110129998=          END'
      '110129999=      END ELSE BEGIN'
      '1101291000=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1101291001=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1101291002=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1101291003=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1101291004=            ELSE'
      
        '1101291005=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1101291006='
      '1101291007=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1101291008=                RETURNING_VALUES :PAYMENT_ID_, :PAYME' +
        'NT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101291009='
      
        '1101291010=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101291011='
      '1101291012=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101291013=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101291014=                                              :G_PRIH' +
        'OD_RASHOD_,'
      
        '1101291015=                                              :PAYMEN' +
        'T_SUMM_,'
      
        '1101291016=                                              :PAYMEN' +
        'T_DATE_,'
      
        '1101291017=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101291018=                                              NULL,  ' +
        ' --ZAKAZ_'
      
        '1101291019=                                              :SKLAD_' +
        ','
      
        '1101291020=                                              :PAYMEN' +
        'T_TYPE_,'
      
        '1101291021=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101291022=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101291023=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101291024=                  EXIT;'
      '1101291025=                END'
      '1101291026=            END'
      '1101291027=          END'
      '1101291028=      END'
      '1101291029=  END'
      '1101291030='
      '1101291031=  DELETE FROM SKLAD_TMP;'
      '1101291032='
      
        '1101291033=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '1101291034=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101291035=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =' +
        '> :ACTION_'
      '1101291036=                                  G_PRIHOD_,'
      '1101291037=                                  :SUMM_PRIHOD_,'
      '1101291038=                                  :DATE_RECEIPT_,'
      
        '1101291039=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101291040=                                  NULL,   --:ZAKAZ_,'
      '1101291041=                                  :SKLAD_,'
      '1101291042=                                  :G_PAYMENT_TYPE_,'
      
        '1101291043=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101291044=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101291045=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101291046=      EXIT;'
      '1101291047=    END'
      '1101291048=  END'
      '1101291049='
      '1101291050=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101291051=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THE' +
        'N'
      
        '1101291052=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101291053=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_, ' +
        '1);'
      '1101291054=end'
      '1101291055=;'
      '1101291056='
      '1101291057=ALTER PROCEDURE P_REP_BILL('
      '1101291058=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101291059=  SUMM_DANO_ NUMERIC(15,2),'
      '1101291060=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1101291061=  CURRENCY_ INTEGER,'
      '1101291062=  MODE_ INTEGER,'
      '1101291063=  PRINT_SLOGAN_ VARCHAR(80),'
      '1101291064=  DECIMAL_ INTEGER,'
      '1101291065=  BONUS_ NUMERIC(15,2))'
      '1101291066=RETURNS ('
      '1101291067=  FIRM_NAME_ VARCHAR(600),'
      '1101291068=  IDN_STR_ VARCHAR(30),'
      '1101291069=  FIRM_IDN_ VARCHAR(50),'
      '1101291070=  FIRM_ADDRESS_ VARCHAR(550),'
      '1101291071=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101291072=  DATE_ VARCHAR(100),'
      '1101291073=  PAYMENT_TYPE_ VARCHAR(100),'
      '1101291074=  G_CLIENT_NAME_ VARCHAR(300),'
      '1101291075=  G_OFFICIAL_FM_ VARCHAR(300),'
      '1101291076=  SUMM_VSEGO_ VARCHAR(50),'
      '1101291077=  SUMM_VSEGO_N_ VARCHAR(50),'
      '1101291078=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1101291079=  ROW_NUM INTEGER,'
      '1101291080=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101291081=  NAME_ART VARCHAR(1000),'
      '1101291082=  AMOUNT VARCHAR(50),'
      '1101291083=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101291084=  PRICE VARCHAR(50),'
      '1101291085=  PRICE_N VARCHAR(50),'
      '1101291086=  SUMM VARCHAR(50),'
      '1101291087=  SUMM_N VARCHAR(50),'
      '1101291088=  SUMM_POLUCH_ VARCHAR(50),'
      '1101291089=  SUMM_SDACH_ VARCHAR(50),'
      '1101291090=  SUMM_STR_ VARCHAR(200),'
      '1101291091=  SLOGAN_ VARCHAR(80),'
      '1101291092=  SUMM_SKIDKA_ VARCHAR(50),'
      '1101291093=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101291094=  BONUS_STR_ VARCHAR(50),'
      '1101291095=  ERR_CODE NUMERIC(15,2),'
      '1101291096=  ERR_MSG VARCHAR(1024))'
      '1101291097=AS'
      '1101291098=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '1101291099=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '1101291100=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101291101=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101291102=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101291103=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1101291104=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.AMOUNT;'
      
        '1101291105=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101291106=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      '1101291107=BEGIN'
      '1101291108=  SLOGAN_ = PRINT_SLOGAN_;'
      '1101291109='
      '1101291110=  IF (BONUS_ > 0) THEN BEGIN'
      
        '1101291111=    BONUS_STR_ = '#39#1057#1091#1084#1084#1072' '#1073#1086#1085#1091#1089#1086#1074' '#1079#1072' '#1087#1086#1082#1091#1087#1082#1091' - '#39' || SUB' +
        'STRING(BONUS_ FROM 1 FOR POSITION('#39'.00'#39' IN BONUS_)-1);'
      '1101291112=  END'
      '1101291113='
      '1101291114=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1101291115=  SELECT z.ZAKAZ'
      '1101291116=         ,P.NAME'
      
        '1101291117=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39 +
        ')||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '1101291118=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '1101291119=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COA' +
        'LESCE(O.NM, '#39#39')'
      '1101291120=         ,Z.summ_noncash'
      '1101291121=         ,Z.summ_cash'
      '1101291122=         ,Z.NOTE'
      
        '1101291123=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_' +
        'OFFICIAL = O.G_OFFICIAL,'
      '1101291124=         G_CLIENT G,'
      '1101291125=         G_PAYMENT_TYPE P'
      '1101291126=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101291127=     AND Z.G_CLIENT = G.G_CLIENT'
      '1101291128=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1101291129=    INTO :NUM_'
      '1101291130=        ,:PAYMENT_TYPE_'
      '1101291131=        ,:DATE_'
      '1101291132=        ,:G_CLIENT_NAME_'
      '1101291133=        ,:G_OFFICIAL_FM_'
      '1101291134=        ,:SUMM_NONCASH_'
      '1101291135=        ,:SUMM_CASH_'
      '1101291136=        ,:NOTE_'
      '1101291137=        ;'
      '1101291138='
      '1101291139=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '1101291140=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '1101291141='
      '1101291142=  SELECT R.G_FIRM_REKVIZIT,'
      '1101291143=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '1101291144=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086 +
        #1088#1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '1101291145=    FROM G_FIRM_REKVIZIT R'
      '1101291146=   WHERE R.is_default = 1'
      '1101291147=    INTO :G_FIRM_REKVIZIT_,'
      '1101291148=         :FIRM_NAME_,'
      '1101291149=         :FIRM_IDN_;'
      '1101291150='
      '1101291151=  SELECT SUM(ZD.AMOUNT),'
      
        '1101291152=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARC' +
        'HAR(100)),'
      
        '1101291153=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), ' +
        '2) AS VARCHAR(100)),'
      '1101291154=         CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '1101291155=  FROM ZAKAZ_DETAILS ZD'
      '1101291156=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101291157=  INTO :AMOUNT_VSEGO_NUM_,'
      '1101291158=       :SUMM_SKIDKA_,'
      '1101291159=       :SUMM_VSEGO_,'
      '1101291160=       :SUMM_VSEGO_N_;'
      '1101291161='
      '1101291162=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '1101291163=    FROM G_FIRM_ADDRESS R'
      '1101291164=   WHERE R.IS_DEFAULT = 1'
      '1101291165=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '1101291166=    INTO :FIRM_ADDRESS_;'
      '1101291167='
      
        '1101291168=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047 +
        #1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '1101291169=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':' +
        #39');'
      '1101291170=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '1101291171=    IF (CURRENCY_ = 0) THEN'
      '1101291172=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '1101291173=    ELSE'
      '1101291174=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '1101291175=  END'
      '1101291176='
      '1101291177=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '1101291178='
      
        '1101291179=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR' +
        '(100));'
      
        '1101291180=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCH' +
        'AR(100));'
      '1101291181='
      '1101291182=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '1101291183=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '1101291184=  INTO :SUMM_STR_;'
      '1101291185='
      '1101291186=  FOR'
      '1101291187=    SELECT :I,'
      '1101291188=           G.NAME,'
      
        '1101291189=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39',' +
        ' '#39#39'),'
      '1101291190=           ZD.AMOUNT,'
      '1101291191=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '1101291192=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) ' +
        'AS VARCHAR(100))'
      '1101291193=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '1101291194=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENG' +
        'E, 0) AS VARCHAR(100))'
      '1101291195=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '1101291196=      FROM ZAKAZ Z,'
      '1101291197=           ZAKAZ_DETAILS ZD,'
      '1101291198=           G_PRODUCT G,'
      '1101291199=           G_UNIT U'
      '1101291200=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101291201=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101291202=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101291203=       AND G.G_UNIT = U.G_UNIT'
      '1101291204=     ORDER BY ZD.zakaz_details'
      '1101291205=    INTO :ROW_NUM,'
      '1101291206=        :NAME,'
      '1101291207=        :NAME_ART,'
      '1101291208=        :AMOUNT_NUM_,'
      '1101291209=        :PRICE,'
      '1101291210=        :SUMM'
      '1101291211=        ,:SHORT_NAME'
      '1101291212=        ,:PRICE_N'
      '1101291213=        ,:SUMM_N'
      '1101291214=  DO BEGIN'
      '1101291215=    I = I + 1;'
      '1101291216='
      
        '1101291217=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068 +
        ' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '1101291218=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '1101291219=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '1101291220=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '1101291221=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '1101291222=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '1101291223=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE)-1);'
      '1101291224=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '1101291225=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR P' +
        'OSITION('#39'.00'#39' IN PRICE_N)-1);'
      '1101291226=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '1101291227=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM)-1);'
      '1101291228=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '1101291229=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN SUMM_N)-1);'
      '1101291230=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '1101291231=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '1101291232=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '1101291233=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '1101291234=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '1101291235=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '1101291236='
      '1101291237=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1101291238=    IF (DECIMAL_ = 2) THEN BEGIN'
      '1101291239=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '1101291240=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,2));'
      '1101291241=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '1101291242=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '1101291243=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,3));'
      '1101291244=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '1101291245=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '1101291246=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,4));'
      '1101291247=    END ELSE BEGIN'
      '1101291248=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '1101291249=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,5));'
      '1101291250=    END'
      '1101291251='
      
        '1101291252=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT) > 0) then'
      
        '1101291253=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR PO' +
        'SITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '1101291254='
      
        '1101291255=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT_VSEGO_) > 0) then'
      
        '1101291256=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1' +
        ' FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '1101291257='
      '1101291258=    SUSPEND;'
      '1101291259=  END'
      '1101291260=WHEN ANY DO BEGIN'
      '1101291261=    Err_code = -20500;'
      
        '1101291262=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101291263=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101291264=  END'
      '1101291265=end'
      '1101291266=;'
      '1101291267='
      '1101291268=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1101291269=RETURNS ('
      
        '1101291270=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '1101291271=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '1101291272=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '1101291273=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101291274=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101291275=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1101291276=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '1101291277=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '1101291278=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '1101291279=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1101291280=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1101291281=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101291282=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101291283=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101291284=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101291285=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PR' +
        'ICE,'
      '1101291286=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      
        '1101291287=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TM' +
        'P.SUMM)'
      '1101291288=AS'
      '1101291289=begin'
      '1101291290='
      '1101291291=  FOR'
      '1101291292=    SELECT T.ZAKAZ_DETAILS,'
      '1101291293=           T.ZAKAZ,'
      '1101291294=           T.G_PRODUCT,'
      '1101291295=           T.AMOUNT,'
      '1101291296=           T.PRICE,'
      '1101291297=           T.SUMM,'
      '1101291298=           T.DISCOUNT_PERC,'
      '1101291299=           T.DISCOUNT_TENGE,'
      '1101291300=           T.DISCOUNT_SUMM,'
      '1101291301=           T.NDS,'
      '1101291302=           T.NDS_SUMM,'
      '1101291303=           P.NAME PRODUCT_NAME'
      '1101291304=           ,P.BARCODE'
      '1101291305=           ,P.ARTICUL'
      '1101291306=           ,P.PRICE'
      '1101291307=           ,P.IS_KIT'
      
        '1101291308=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_T' +
        'MP TM, G_PRODUCT GP'
      
        '1101291309=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.D' +
        'O_NOT_CHARGE_BONUS = 0)'
      '1101291310=           ,T.COST_PRICE'
      '1101291311=      FROM ZAKAZ_DETAILS_TMP T,'
      '1101291312=           G_PRODUCT P'
      '1101291313=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101291314=    ORDER BY t.ZAKAZ_DETAILS'
      '1101291315=    INTO :ZAKAZ_DETAILS,'
      '1101291316=          :ZAKAZ,'
      '1101291317=          :G_PRODUCT,'
      '1101291318=          :AMOUNT,'
      '1101291319=          :PRICE,'
      '1101291320=          :SUMM,'
      '1101291321=          :DISCOUNT_PERC,'
      '1101291322=          :DISCOUNT_TENGE,'
      '1101291323=          :DISCOUNT_SUMM,'
      '1101291324=          :NDS,'
      '1101291325=          :NDS_SUMM,'
      '1101291326=          :PRODUCT_NAME'
      '1101291327=          ,:BARCODE'
      '1101291328=          ,:ARTICUL'
      '1101291329=          ,:PRODUCT_PRICE'
      '1101291330=          ,:IS_KIT'
      '1101291331=          ,:SUM_TO_CHARGE_BONUS'
      '1101291332=          ,:COST_PRICE'
      '1101291333=  DO'
      '1101291334=    suspend;'
      '1101291335=end'
      '1101291336=;'
      
        '1101291337=UPDATE SYSTEM_SETUP SET S_VALUE = 110129 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101291338=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101291339=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101300=ALTER PROCEDURE P_REP_BILL('
      '1101301=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101302=  SUMM_DANO_ NUMERIC(15,2),'
      '1101303=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1101304=  CURRENCY_ INTEGER,'
      '1101305=  MODE_ INTEGER,'
      '1101306=  PRINT_SLOGAN_ VARCHAR(80),'
      '1101307=  DECIMAL_ INTEGER,'
      '1101308=  BONUS_ NUMERIC(15,2))'
      '1101309=RETURNS ('
      '11013010=  FIRM_NAME_ VARCHAR(600),'
      '11013011=  IDN_STR_ VARCHAR(30),'
      '11013012=  FIRM_IDN_ VARCHAR(50),'
      '11013013=  FIRM_ADDRESS_ VARCHAR(550),'
      '11013014=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11013015=  DATE_ VARCHAR(100),'
      '11013016=  PAYMENT_TYPE_ VARCHAR(100),'
      '11013017=  G_CLIENT_NAME_ VARCHAR(300),'
      '11013018=  G_OFFICIAL_FM_ VARCHAR(300),'
      '11013019=  SUMM_VSEGO_ VARCHAR(50),'
      '11013020=  SUMM_VSEGO_N_ VARCHAR(50),'
      '11013021=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11013022=  ROW_NUM INTEGER,'
      '11013023=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11013024=  NAME_ART VARCHAR(1000),'
      '11013025=  AMOUNT VARCHAR(50),'
      '11013026=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11013027=  PRICE VARCHAR(50),'
      '11013028=  PRICE_N VARCHAR(50),'
      '11013029=  SUMM VARCHAR(50),'
      '11013030=  SUMM_N VARCHAR(50),'
      '11013031=  SUMM_POLUCH_ VARCHAR(50),'
      '11013032=  SUMM_SDACH_ VARCHAR(50),'
      '11013033=  SUMM_STR_ VARCHAR(200),'
      '11013034=  SLOGAN_ VARCHAR(80),'
      '11013035=  SUMM_SKIDKA_ VARCHAR(50),'
      '11013036=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11013037=  BONUS_STR_ VARCHAR(100),'
      '11013038=  ERR_CODE NUMERIC(15,2),'
      '11013039=  ERR_MSG VARCHAR(1024))'
      '11013040=AS'
      '11013041=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '11013042=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '11013043=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11013044=DECLARE VARIABLE I INTEGER = 1;'
      
        '11013045=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11013046=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11013047=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.AMOUNT;'
      
        '11013048=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11013049=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      '11013050=BEGIN'
      '11013051=  SLOGAN_ = PRINT_SLOGAN_;'
      '11013052='
      '11013053=  IF (BONUS_ > 0) THEN BEGIN'
      
        '11013054=    BONUS_STR_ = '#39#1057#1091#1084#1084#1072' '#1073#1086#1085#1091#1089#1086#1074' '#1079#1072' '#1087#1086#1082#1091#1087#1082#1091' - '#39' || SUBST' +
        'RING(BONUS_ FROM 1 FOR POSITION('#39'.00'#39' IN BONUS_)-1);'
      '11013055=  END'
      '11013056='
      '11013057=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '11013058=  SELECT z.ZAKAZ'
      '11013059=         ,P.NAME'
      
        '11013060=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR ' +
        'FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')|' +
        '|'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '11013061=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '11013062=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COALE' +
        'SCE(O.NM, '#39#39')'
      '11013063=         ,Z.summ_noncash'
      '11013064=         ,Z.summ_cash'
      '11013065=         ,Z.NOTE'
      
        '11013066=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_OF' +
        'FICIAL = O.G_OFFICIAL,'
      '11013067=         G_CLIENT G,'
      '11013068=         G_PAYMENT_TYPE P'
      '11013069=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11013070=     AND Z.G_CLIENT = G.G_CLIENT'
      '11013071=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11013072=    INTO :NUM_'
      '11013073=        ,:PAYMENT_TYPE_'
      '11013074=        ,:DATE_'
      '11013075=        ,:G_CLIENT_NAME_'
      '11013076=        ,:G_OFFICIAL_FM_'
      '11013077=        ,:SUMM_NONCASH_'
      '11013078=        ,:SUMM_CASH_'
      '11013079=        ,:NOTE_'
      '11013080=        ;'
      '11013081='
      '11013082=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '11013083=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '11013084='
      '11013085=  SELECT R.G_FIRM_REKVIZIT,'
      '11013086=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '11013087=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088#1075 +
        '.: '#39'||COALESCE(R.IDN, '#39#39')'
      '11013088=    FROM G_FIRM_REKVIZIT R'
      '11013089=   WHERE R.is_default = 1'
      '11013090=    INTO :G_FIRM_REKVIZIT_,'
      '11013091=         :FIRM_NAME_,'
      '11013092=         :FIRM_IDN_;'
      '11013093='
      '11013094=  SELECT SUM(ZD.AMOUNT),'
      
        '11013095=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCHA' +
        'R(100)),'
      
        '11013096=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2)' +
        ' AS VARCHAR(100)),'
      '11013097=         CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '11013098=  FROM ZAKAZ_DETAILS ZD'
      '11013099=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110130100=  INTO :AMOUNT_VSEGO_NUM_,'
      '110130101=       :SUMM_SKIDKA_,'
      '110130102=       :SUMM_VSEGO_,'
      '110130103=       :SUMM_VSEGO_N_;'
      '110130104='
      '110130105=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110130106=    FROM G_FIRM_ADDRESS R'
      '110130107=   WHERE R.IS_DEFAULT = 1'
      '110130108=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110130109=    INTO :FIRM_ADDRESS_;'
      '110130110='
      
        '110130111=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110130112=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110130113=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110130114=    IF (CURRENCY_ = 0) THEN'
      '110130115=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110130116=    ELSE'
      '110130117=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110130118=  END'
      '110130119='
      '110130120=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110130121='
      
        '110130122=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110130123=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110130124='
      '110130125=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110130126=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110130127=  INTO :SUMM_STR_;'
      '110130128='
      '110130129=  FOR'
      '110130130=    SELECT :I,'
      '110130131=           G.NAME,'
      
        '110130132=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39', ' +
        #39#39'),'
      '110130133=           ZD.AMOUNT,'
      '110130134=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '110130135=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) A' +
        'S VARCHAR(100))'
      '110130136=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110130137=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE' +
        ', 0) AS VARCHAR(100))'
      '110130138=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110130139=      FROM ZAKAZ Z,'
      '110130140=           ZAKAZ_DETAILS ZD,'
      '110130141=           G_PRODUCT G,'
      '110130142=           G_UNIT U'
      '110130143=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110130144=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110130145=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110130146=       AND G.G_UNIT = U.G_UNIT'
      '110130147=     ORDER BY ZD.zakaz_details'
      '110130148=    INTO :ROW_NUM,'
      '110130149=        :NAME,'
      '110130150=        :NAME_ART,'
      '110130151=        :AMOUNT_NUM_,'
      '110130152=        :PRICE,'
      '110130153=        :SUMM'
      '110130154=        ,:SHORT_NAME'
      '110130155=        ,:PRICE_N'
      '110130156=        ,:SUMM_N'
      '110130157=  DO BEGIN'
      '110130158=    I = I + 1;'
      '110130159='
      
        '110130160=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110130161=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110130162=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110130163=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110130164=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110130165=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110130166=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110130167=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110130168=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110130169=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110130170=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110130171=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110130172=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110130173=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110130174=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110130175=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110130176=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110130177=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110130178=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110130179='
      '110130180=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110130181=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110130182=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110130183=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110130184=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110130185=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110130186=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110130187=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110130188=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110130189=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110130190=    END ELSE BEGIN'
      '110130191=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110130192=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110130193=    END'
      '110130194='
      
        '110130195=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110130196=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110130197='
      
        '110130198=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110130199=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110130200='
      '110130201=    SUSPEND;'
      '110130202=  END'
      '110130203=WHEN ANY DO BEGIN'
      '110130204=    Err_code = -20500;'
      
        '110130205=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110130206=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110130207=  END'
      '110130208=end'
      '110130209=;'
      
        '110130210=UPDATE SYSTEM_SETUP SET S_VALUE = 110130 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110130211=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110130212=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101310=ALTER PROCEDURE P_REP_BILL('
      '1101311=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101312=  SUMM_DANO_ NUMERIC(15,2),'
      '1101313=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1101314=  CURRENCY_ INTEGER,'
      '1101315=  MODE_ INTEGER,'
      '1101316=  PRINT_SLOGAN_ VARCHAR(80),'
      '1101317=  DECIMAL_ INTEGER,'
      '1101318=  BONUS_ NUMERIC(15,2))'
      '1101319=RETURNS ('
      '11013110=  FIRM_NAME_ VARCHAR(600),'
      '11013111=  IDN_STR_ VARCHAR(30),'
      '11013112=  FIRM_IDN_ VARCHAR(50),'
      '11013113=  FIRM_ADDRESS_ VARCHAR(550),'
      '11013114=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11013115=  DATE_ VARCHAR(100),'
      '11013116=  PAYMENT_TYPE_ VARCHAR(100),'
      '11013117=  G_CLIENT_NAME_ VARCHAR(300),'
      '11013118=  G_OFFICIAL_FM_ VARCHAR(300),'
      '11013119=  SUMM_VSEGO_ VARCHAR(50),'
      '11013120=  SUMM_VSEGO_N_ VARCHAR(50),'
      '11013121=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11013122=  ROW_NUM INTEGER,'
      '11013123=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11013124=  NAME_ART VARCHAR(1000),'
      '11013125=  AMOUNT VARCHAR(50),'
      '11013126=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11013127=  PRICE VARCHAR(50),'
      '11013128=  PRICE_N VARCHAR(50),'
      '11013129=  SUMM VARCHAR(50),'
      '11013130=  SUMM_N VARCHAR(50),'
      '11013131=  SUMM_POLUCH_ VARCHAR(50),'
      '11013132=  SUMM_SDACH_ VARCHAR(50),'
      '11013133=  SUMM_STR_ VARCHAR(200),'
      '11013134=  SLOGAN_ VARCHAR(80),'
      '11013135=  SUMM_SKIDKA_ VARCHAR(50),'
      '11013136=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11013137=  BONUS_STR_ VARCHAR(100),'
      '11013138=  ERR_CODE NUMERIC(15,2),'
      '11013139=  ERR_MSG VARCHAR(1024))'
      '11013140=AS'
      '11013141=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '11013142=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '11013143=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11013144=DECLARE VARIABLE I INTEGER = 1;'
      
        '11013145=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11013146=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11013147=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.AMOUNT;'
      
        '11013148=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11013149=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      '11013150=BEGIN'
      '11013151=  SLOGAN_ = PRINT_SLOGAN_;'
      '11013152='
      '11013153=  IF (BONUS_ > 0) THEN BEGIN'
      
        '11013154=    BONUS_STR_ = '#39#1057#1091#1084#1084#1072' '#1073#1086#1085#1091#1089#1086#1074' '#1079#1072' '#1087#1086#1082#1091#1087#1082#1091' - '#39' || REPLA' +
        'CE(CAST(BONUS_ AS VARCHAR(20)), '#39'.'#39', '#39','#39');'
      '11013155=  END'
      '11013156='
      '11013157=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '11013158=  SELECT z.ZAKAZ'
      '11013159=         ,P.NAME'
      
        '11013160=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR ' +
        'FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')|' +
        '|'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '11013161=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '11013162=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COALE' +
        'SCE(O.NM, '#39#39')'
      '11013163=         ,Z.summ_noncash'
      '11013164=         ,Z.summ_cash'
      '11013165=         ,Z.NOTE'
      
        '11013166=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_OF' +
        'FICIAL = O.G_OFFICIAL,'
      '11013167=         G_CLIENT G,'
      '11013168=         G_PAYMENT_TYPE P'
      '11013169=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11013170=     AND Z.G_CLIENT = G.G_CLIENT'
      '11013171=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11013172=    INTO :NUM_'
      '11013173=        ,:PAYMENT_TYPE_'
      '11013174=        ,:DATE_'
      '11013175=        ,:G_CLIENT_NAME_'
      '11013176=        ,:G_OFFICIAL_FM_'
      '11013177=        ,:SUMM_NONCASH_'
      '11013178=        ,:SUMM_CASH_'
      '11013179=        ,:NOTE_'
      '11013180=        ;'
      '11013181='
      '11013182=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '11013183=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '11013184='
      '11013185=  SELECT R.G_FIRM_REKVIZIT,'
      '11013186=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '11013187=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088#1075 +
        '.: '#39'||COALESCE(R.IDN, '#39#39')'
      '11013188=    FROM G_FIRM_REKVIZIT R'
      '11013189=   WHERE R.is_default = 1'
      '11013190=    INTO :G_FIRM_REKVIZIT_,'
      '11013191=         :FIRM_NAME_,'
      '11013192=         :FIRM_IDN_;'
      '11013193='
      '11013194=  SELECT SUM(ZD.AMOUNT),'
      
        '11013195=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCHA' +
        'R(100)),'
      
        '11013196=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2)' +
        ' AS VARCHAR(100)),'
      '11013197=         CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '11013198=  FROM ZAKAZ_DETAILS ZD'
      '11013199=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110131100=  INTO :AMOUNT_VSEGO_NUM_,'
      '110131101=       :SUMM_SKIDKA_,'
      '110131102=       :SUMM_VSEGO_,'
      '110131103=       :SUMM_VSEGO_N_;'
      '110131104='
      '110131105=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110131106=    FROM G_FIRM_ADDRESS R'
      '110131107=   WHERE R.IS_DEFAULT = 1'
      '110131108=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110131109=    INTO :FIRM_ADDRESS_;'
      '110131110='
      
        '110131111=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110131112=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110131113=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110131114=    IF (CURRENCY_ = 0) THEN'
      '110131115=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110131116=    ELSE'
      '110131117=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110131118=  END'
      '110131119='
      '110131120=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110131121='
      
        '110131122=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110131123=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110131124='
      '110131125=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110131126=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110131127=  INTO :SUMM_STR_;'
      '110131128='
      '110131129=  FOR'
      '110131130=    SELECT :I,'
      '110131131=           G.NAME,'
      
        '110131132=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39', ' +
        #39#39'),'
      '110131133=           ZD.AMOUNT,'
      '110131134=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '110131135=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) A' +
        'S VARCHAR(100))'
      '110131136=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110131137=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE' +
        ', 0) AS VARCHAR(100))'
      '110131138=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110131139=      FROM ZAKAZ Z,'
      '110131140=           ZAKAZ_DETAILS ZD,'
      '110131141=           G_PRODUCT G,'
      '110131142=           G_UNIT U'
      '110131143=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110131144=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110131145=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110131146=       AND G.G_UNIT = U.G_UNIT'
      '110131147=     ORDER BY ZD.zakaz_details'
      '110131148=    INTO :ROW_NUM,'
      '110131149=        :NAME,'
      '110131150=        :NAME_ART,'
      '110131151=        :AMOUNT_NUM_,'
      '110131152=        :PRICE,'
      '110131153=        :SUMM'
      '110131154=        ,:SHORT_NAME'
      '110131155=        ,:PRICE_N'
      '110131156=        ,:SUMM_N'
      '110131157=  DO BEGIN'
      '110131158=    I = I + 1;'
      '110131159='
      
        '110131160=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110131161=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110131162=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110131163=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110131164=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110131165=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110131166=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110131167=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110131168=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110131169=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110131170=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110131171=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110131172=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110131173=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110131174=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110131175=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110131176=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110131177=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110131178=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110131179='
      '110131180=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110131181=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110131182=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110131183=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110131184=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110131185=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110131186=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110131187=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110131188=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110131189=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110131190=    END ELSE BEGIN'
      '110131191=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110131192=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110131193=    END'
      '110131194='
      
        '110131195=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110131196=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110131197='
      
        '110131198=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110131199=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110131200='
      '110131201=    SUSPEND;'
      '110131202=  END'
      '110131203=WHEN ANY DO BEGIN'
      '110131204=    Err_code = -20500;'
      
        '110131205=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110131206=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110131207=  END'
      '110131208=end'
      '110131209=;'
      
        '110131210=UPDATE SYSTEM_SETUP SET S_VALUE = 110131 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110131211=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110131212=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101320=ALTER PROCEDURE G_DEL_G_OFFICIAL('
      
        '1101321=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT)'
      '1101322=RETURNS ('
      '1101323=  ERR_CODE INTEGER,'
      '1101324=  ERR_MSG VARCHAR(1024))'
      '1101325=AS'
      '1101326=BEGIN'
      '1101327=  SUSPEND;'
      '1101328=END'
      '1101329=;'
      '11013210='
      '11013211=ALTER PROCEDURE G_INS_G_OFFICIAL('
      '11013212=  FM_ /* TYPE OF COLUMN G_OFFICIAL.FM */ VARCHAR(100),'
      '11013213=  NM_ /* TYPE OF COLUMN G_OFFICIAL.NM */ VARCHAR(100),'
      '11013214=  FT_ /* TYPE OF COLUMN G_OFFICIAL.FT */ VARCHAR(100),'
      
        '11013215=  FIO_DOC_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */ VARC' +
        'HAR(150),'
      '11013216=  RNN_ /* TYPE OF COLUMN G_OFFICIAL.RNN */ VARCHAR(12),'
      '11013217=  IDN_ /* TYPE OF COLUMN G_OFFICIAL.IDN */ VARCHAR(12),'
      '11013218=  DT_ /* TYPE OF COLUMN G_OFFICIAL.DT */ DATE,'
      
        '11013219=  G_ID_KIND_ /* TYPE OF COLUMN G_OFFICIAL.G_ID_KIND */ ' +
        'VARCHAR(100),'
      
        '11013220=  ID_NUM_ /* TYPE OF COLUMN G_OFFICIAL.ID_NUM */ VARCHA' +
        'R(100),'
      
        '11013221=  ID_DATE_ /* TYPE OF COLUMN G_OFFICIAL.ID_DATE */ DATE' +
        ','
      
        '11013222=  ID_ISSUER_ /* TYPE OF COLUMN G_OFFICIAL.ID_ISSUER */ ' +
        'VARCHAR(100),'
      
        '11013223=  G_APPOINTMENT_ /* TYPE OF COLUMN G_OFFICIAL.G_APPOINT' +
        'MENT */ BIGINT,'
      
        '11013224=  IS_RUKOVODITEL_ /* TYPE OF COLUMN G_OFFICIAL.IS_RUKOV' +
        'ODITEL */ INTEGER,'
      
        '11013225=  IS_GLAVBUH_ /* TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH *' +
        '/ INTEGER,'
      
        '11013226=  IS_ISPOLNITEL_ /* TYPE OF COLUMN G_OFFICIAL.IS_ISPOLN' +
        'ITEL */ SMALLINT,'
      
        '11013227=  PASSWORD_ /* TYPE OF COLUMN G_OFFICIAL.PASS */ VARCHA' +
        'R(50),'
      
        '11013228=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGI' +
        'NT,'
      '11013229=  RIGHTS_ARR_ VARCHAR(500),'
      
        '11013230=  DO_NOT_SALES_COMM_ /* TYPE OF COLUMN G_OFFICIAL.DO_NO' +
        'T_SALES_COMM */ INTEGER,'
      '11013231=  KOD_ /* TYPE OF COLUMN G_OFFICIAL.KOD */ VARCHAR(50))'
      '11013232=RETURNS ('
      
        '11013233=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL *' +
        '/ BIGINT,'
      '11013234=  ERR_CODE INTEGER,'
      '11013235=  ERR_MSG VARCHAR(1024))'
      '11013236=AS'
      '11013237=BEGIN'
      '11013238=  SUSPEND;'
      '11013239=END'
      '11013240=;'
      '11013241='
      '11013242=ALTER PROCEDURE G_READ_G_OFFICIAL_LIST'
      '11013243=RETURNS ('
      
        '11013244=  G_OFFICIAL /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT,'
