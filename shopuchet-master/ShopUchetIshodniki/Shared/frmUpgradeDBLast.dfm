      '1102122084=        SELECT 20 COL,'
      '1102122085=               '#39#39' STR,'
      '1102122086=               '#39#39' AMOUNT,'
      '1102122087=               '#39#39' SUMM'
      '1102122088=          FROM RDB$DATABASE'
      '1102122089=        UNION'
      '1102122090=        SELECT 21 COL,'
      
        '1102122091=               lpad(EXTRACT(DAY FROM :DATE_), 2, '#39'0'#39')' +
        '||'#39'.'#39'||lpad(EXTRACT(MONTH FROM :DATE_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM :DATE_)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM CURRENT_TIMESTAMP)' +
        ', 2, '#39'0'#39')||'#39':'#39'||lpad(EXTRACT(MINUTE FROM CURRENT_TIMESTAMP), 2, ' +
        #39'0'#39') STR,'
      '1102122092=               '#39#39' AMOUNT,'
      '1102122093=               '#39#39' SUMM'
      '1102122094=          FROM RDB$DATABASE'
