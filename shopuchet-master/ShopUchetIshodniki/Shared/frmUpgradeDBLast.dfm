      '110239808='
      '110239809=ALTER TABLE LOGS ALTER COLUMN RR POSITION 6;'
      '110239810='
      '110239811=ALTER TABLE LOGS ALTER COLUMN DAT POSITION 7;'
      '110239812='
      
        '110239813=ALTER TABLE LOGS ALTER COLUMN IS_TRANSFERED POSITION 8' +
        ';'
