      '11019435=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '11019436=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '11019437=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '11019438=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '11019439=  PROFIT_ALL_ NUMERIC(15,2),'
