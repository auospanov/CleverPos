        '110261067=        VALUES (14, 2, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39#39', COALESCE((' +
        'SELECT SUM(K.summ)'
      
        '110261068=                                                     F' +
