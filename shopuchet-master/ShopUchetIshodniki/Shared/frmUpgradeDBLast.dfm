        ','
      '1106021542=                                        :NOTE_,'
      '1106021543=                                        :ZAKAZ_,'
      '1106021544=                                        :SKLAD_,'
      
        '1106021545=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1106021546=                                        :G_TOCHKA_,'
      '1106021547=                                        :G_OFFICIAL_'
      
        '1106021548=                                        ) RETURNING_V' +
        'ALUES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '1106021549=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021550=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021551=            EXIT;'
      '1106021552=          END'
      '1106021553='
      
        '1106021554=          -- '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1053#1045' '#1041#1067#1051#1054' '#1055#1056#1054#1041#1051#1045#1052' '#1042' ' +
        #1042#1067#1047#1067#1042#1040#1070#1065#1045#1049' '#1055#1056#1054#1062#1045#1044#1059#1056#1045', '#1048#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1052#1045#1053#1071#1070' '#1053#1054#1042#1067#1049' ID '#1050#1040#1057#1057#1067' '#1053#1040' '#1057 +
        #1058#1040#1056#1067#1049','
      
        '1106021555=          -- '#1042#1045#1044#1068' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1042#1067#1047#1067#1042#1040#1051#1057#1071' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1056#1040#1047#1059#1052#1045 +
        #1042#1040#1045#1058#1057#1071' '#1063#1058#1054' ID '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071
      '1106021556=          UPDATE KASSA SS'
      '1106021557=             SET SS.KASSA = :KASSA_'
      '1106021558=           WHERE SS.KASSA = :KASSA_NEW_;'
      '1106021559='
      
        '1106021560=          EXECUTE procedure K_RECALC_KASSA(:ACTION_DA' +
        'TE_, :G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1106021561=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021562=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021563=            EXIT;'
      '1106021564=          END'
      '1106021565=      END'
      '1106021566=      UPDATE KASSA'
      '1106021567=         SET ACTION = :ACTION_,'
      '1106021568=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '1106021569=             SUMM = :SUMM_,'
      '1106021570=             ACTION_DATE = :ACTION_DATE_,'
      '1106021571=             NOTE = :NOTE_'
      '1106021572=      WHERE KASSA = :KASSA_;'
      '1106021573=  END'
      
        '1106021574=  ---------------------------------------------------' +
        '-------------------'
      '1106021575=  --*************************************************'
      
        '1106021576=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021577=  ---------------------------------------------------' +
        '-------------------'
      '1106021578=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '1106021579=  ELSE BEGIN'
      '1106021580=      PNT_ = '#39'01A'#39';'
      
        '1106021581=      -- '#1045#1057#1051#1048' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040', '#1058#1054' '#1059#1044#1040#1051#1071#1070' '#1057#1058#1040#1056#1059#1070' '#1047#1040#1055#1048#1057 +
        #1068' '#1048' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1047#1040' '#1053#1054#1042#1059#1070' '#1044#1040#1058#1059
      '1106021582=      SELECT L.ACTION_DATE,'
      '1106021583=             L.SUMM,'
      '1106021584=             L.G_TOCHKA'
      '1106021585=        FROM KASSA_BEZNAL L'
      '1106021586=       WHERE L.KASSA_BEZNAL = :KASSA_'
      '1106021587=        INTO :ACTION_DATE_OLD_,'
      '1106021588=             :SUMM_OLD_,'
      '1106021589=             :G_TOCHKA_;'
      '1106021590='
      
        '1106021591=      IF ((SUMM_OLD_ <> SUMM_) or (ACTION_DATE_OLD_ <' +
        '> ACTION_DATE_)) THEN BEGIN'
      
        '1106021592=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106021593=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021594=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021595=            EXIT;'
      '1106021596=          END'
      '1106021597='
      '1106021598=          PNT_ = '#39'02A'#39';'
      '1106021599=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '1106021600=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1106021601=                                        :SUMM_,'
      
        '1106021602=                                        :ACTION_DATE_' +
        ','
      '1106021603=                                        :NOTE_,'
      '1106021604=                                        :ZAKAZ_,'
      '1106021605=                                        :SKLAD_,'
      
        '1106021606=                                        :G_PAYMENT_TY' +
        'PE_,'
      '1106021607=                                        :G_TOCHKA_,'
      
        '1106021608=                                        :G_OFFICIAL_)' +
        ' RETURNING_VALUES (:KASSA_NEW_, :ERR_CODE, :ERR_MSG);'
      '1106021609=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021610=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021611=            EXIT;'
      '1106021612=          END'
      '1106021613='
      
        '1106021614=          -- '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1053#1045' '#1041#1067#1051#1054' '#1055#1056#1054#1041#1051#1045#1052' '#1042' ' +
        #1042#1067#1047#1067#1042#1040#1070#1065#1045#1049' '#1055#1056#1054#1062#1045#1044#1059#1056#1045', '#1048#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1052#1045#1053#1071#1070' '#1053#1054#1042#1067#1049' ID '#1050#1040#1057#1057#1067' '#1053#1040' '#1057 +
        #1058#1040#1056#1067#1049','
      
        '1106021615=          -- '#1042#1045#1044#1068' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1042#1067#1047#1067#1042#1040#1051#1057#1071' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1056#1040#1047#1059#1052#1045 +
        #1042#1040#1045#1058#1057#1071' '#1063#1058#1054' ID '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071
      '1106021616=          UPDATE KASSA_BEZNAL SS'
      '1106021617=             SET SS.KASSA_BEZNAL = :KASSA_'
      '1106021618=           WHERE SS.KASSA_BEZNAL = :KASSA_NEW_;'
      '1106021619='
      
        '1106021620=          EXECUTE procedure K_RECALC_KASSA_BEZNAL(:AC' +
        'TION_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1106021621=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021622=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021623=            EXIT;'
      '1106021624=          END'
      '1106021625=      END'
      '1106021626=      UPDATE KASSA_BEZNAL'
      '1106021627=         SET ACTION = :ACTION_,'
      '1106021628=             G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_,'
      '1106021629=             SUMM = :SUMM_,'
      '1106021630=             ACTION_DATE = :ACTION_DATE_,'
      '1106021631=             NOTE = :NOTE_'
      '1106021632=      WHERE KASSA_BEZNAL = :KASSA_;'
      '1106021633=  END'
      '1106021634=end'
      '1106021635=;'
      '1106021636='
      '1106021637=ALTER PROCEDURE LT_BARCODE_TMP_DEL('
      '1106021638=  LT_BARCODE_ TYPE OF COLUMN LT_BARCODE.G_PRODUCT)'
      '1106021639=AS'
      '1106021640=BEGIN'
      '1106021641=  DELETE FROM LT_BARCODE_TMP'
      
        '1106021642=  WHERE LT_BARCODE = COALESCE(:LT_BARCODE_, LT_BARCOD' +
        'E);'
      '1106021643=END'
      '1106021644=;'
      '1106021645='
      '1106021646=ALTER PROCEDURE LT_BARCODE_TMP_INS('
      '1106021647=  G_PRODUCT_ TYPE OF COLUMN LT_BARCODE.G_PRODUCT,'
      '1106021648=  BARCODE_ TYPE OF COLUMN LT_BARCODE.BARCODE)'
      '1106021649=RETURNS ('
      '1106021650=  LT_BARCODE_ TYPE OF COLUMN LT_BARCODE.G_PRODUCT,'
      '1106021651=  ERR_CODE INTEGER,'
      '1106021652=  ERR_MSG VARCHAR(1024))'
      '1106021653=AS'
      '1106021654=declare variable CNT_ INTEGER;'
      '1106021655=BEGIN'
      '1106021656=  SELECT COUNT(*)'
      '1106021657=    FROM G_PRODUCT G'
      '1106021658=   WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1106021659=     AND TRIM(G.BARCODE) <> '#39#39
      '1106021660=    INTO :CNT_;'
      '1106021661='
      '1106021662=  if (CNT_ = 0) then'
      '1106021663=    SELECT COUNT(*)'
      '1106021664=      FROM G_PRODUCT G, LT_BARCODE L'
      '1106021665=     WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1106021666=       AND L.BARCODE = TRIM(:BARCODE_)'
      '1106021667=       AND TRIM(L.BARCODE) <> '#39#39
      '1106021668=      INTO :CNT_;'
      '1106021669='
      '1106021670=  IF (CNT_ > 0) THEN BEGIN'
      '1106021671=    ERR_CODE = -20500;'
      
        '1106021672=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089#1086 +
        ' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (' +
        ':ERR_MSG);'
      '1106021673=    EXIT;'
      '1106021674=  END'
      '1106021675='
      '1106021676=  INSERT INTO LT_BARCODE_TMP ('
      '1106021677=    LT_BARCODE,'
      '1106021678=    G_PRODUCT,'
      '1106021679=    BARCODE)'
      '1106021680=  VALUES ('
      '1106021681=    GEN_ID(GEN_LT_BARCODE, 1),'
      '1106021682=    :G_PRODUCT_,'
      '1106021683=    :BARCODE_)'
      '1106021684=  RETURNING'
      '1106021685=    LT_BARCODE'
      '1106021686=  INTO'
      '1106021687=    :LT_BARCODE_;'
      '1106021688=END'
      '1106021689=;'
      '1106021690='
      '1106021691=ALTER PROCEDURE LT_BARCODE_TMP_READ'
      '1106021692=RETURNS ('
      '1106021693=  LT_BARCODE TYPE OF COLUMN LT_BARCODE.LT_BARCODE,'
      '1106021694=  G_PRODUCT TYPE OF COLUMN LT_BARCODE.G_PRODUCT,'
      '1106021695=  BARCODE TYPE OF COLUMN LT_BARCODE.BARCODE)'
      '1106021696=AS'
      '1106021697=BEGIN'
      '1106021698=  FOR SELECT LT_BARCODE,'
      '1106021699=             G_PRODUCT,'
      '1106021700=             BARCODE'
      '1106021701=      FROM LT_BARCODE_TMP'
      '1106021702=      INTO :LT_BARCODE,'
      '1106021703=           :G_PRODUCT,'
      '1106021704=           :BARCODE'
      '1106021705=  DO'
      '1106021706=  BEGIN'
      '1106021707=    SUSPEND;'
      '1106021708=  END'
      '1106021709=END'
      '1106021710=;'
      '1106021711='
      '1106021712=ALTER PROCEDURE OTHER_READ('
      '1106021713=  DATE_BEGIN_ DATE,'
      '1106021714=  DATE_END_ DATE,'
      '1106021715=  OP_TYPE_ TYPE OF COLUMN OTHER.OP_TYPE,'
      '1106021716=  ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.ARRIVAL_TYPE)'
      '1106021717=RETURNS ('
      '1106021718=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '1106021719=  OP_DATE TYPE OF COLUMN OTHER.OP_DATE,'
      '1106021720=  NOTE TYPE OF COLUMN OTHER.NOTE,'
      '1106021721=  STRING_DTLS VARCHAR(1000),'
      '1106021722=  OTHER TYPE OF COLUMN OTHER.OTHER,'
      '1106021723=  AMOUNT TYPE OF COLUMN OTHER_DETAILS.AMOUNT)'
      '1106021724=AS'
      '1106021725=DECLARE VARIABLE CNT_ INTEGER;'
      '1106021726=BEGIN'
      '1106021727=  SELECT COUNT(*)'
      '1106021728=    FROM SKLAD T'
      '1106021729=   WHERE T.IS_VOZVRAT = 4'
      
        '1106021730=    AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '1106021731=    AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHERE' +
        ' CUR_PARAMS = 2)'
      '1106021732=    INTO CNT_;'
      '1106021733='
      '1106021734=  if (CNT_ = 0) then'
      '1106021735=    SELECT MAX(T.DATE_RECEIPT)'
      '1106021736=      FROM SKLAD T'
      '1106021737=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1106021738=       AND T.IS_VOZVRAT = 4'
      
        '1106021739=       AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1106021740=      INTO :DATE_BEGIN_;'
      '1106021741='
      '1106021742=  FOR SELECT S.SKLAD,'
      '1106021743=             S.DATE_RECEIPT,'
      '1106021744=             S.NOTE,'
      '1106021745=             G.NAME||'#39', '#1089#1077#1073#1077#1089#1090'-'#1090#1100' '#39'||SS.PRICE,'
      '1106021746=             SS.AMOUNT,'
      
        '1106021747=             /*SUBSTRING((SELECT LIST(G.NAME||'#39', '#1089#1077#1073#1077 +
        #1089#1090'-'#1090#1100' '#39'||D.PRICE, '#39', '#39')'
      '1106021748=                          FROM SKLAD D, G_PRODUCT G'
      
        '1106021749=                         WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '1106021750=                           AND D.SKLAD_PARENT = S.SKL' +
        'AD'
      
        '1106021751=                         GROUP BY SKLAD_PARENT) FROM ' +
        '1 FOR 999) DETAILS_STR*/'
      '1106021752=             O.OTHER'
      '1106021753=      FROM SKLAD_PARENT S,'
      '1106021754=           SKLAD SS,'
      '1106021755=           OTHER O,'
      '1106021756=           G_PRODUCT G'
      
        '1106021757=      WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1106021758=        AND S.is_vozvrat = 4'
      
        '1106021759=        AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1106021760=        AND S.sklad = O.sklad_parent_id'
      '1106021761=        AND S.SKLAD = SS.SKLAD_PARENT'
      '1106021762=        AND SS.G_PRODUCT = G.G_PRODUCT'
      '1106021763=      INTO :SKLAD,'
      '1106021764=           :OP_DATE,'
      '1106021765=           :NOTE,'
      '1106021766=           :STRING_DTLS'
      '1106021767=           ,:AMOUNT'
      '1106021768=           ,:OTHER'
      '1106021769=  DO'
      '1106021770=    SUSPEND;'
      '1106021771='
      '1106021772=  /*FOR SELECT OTHER,'
      '1106021773=             OP_DATE,'
      '1106021774=             OP_TYPE,'
      '1106021775=             ARRIVAL_TYPE,'
      '1106021776=             NOTE,'
      '1106021777=             SKLAD_PARENT_ID,'
      '1106021778=             G_TOCHKA,'
      '1106021779=             SUBSTRING((SELECT'
      
        '1106021780=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT|' +
        '|'#39')'#39', '#39', '#39')'
      
        '1106021781=                        FROM OTHER_DETAILS D, G_PRODU' +
        'CT G'
      
        '1106021782=                        WHERE D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '1106021783=                          AND D.OTHER = T.OTHER'
      
        '1106021784=                          GROUP BY OTHER) FROM 1 FOR ' +
        '999) DETAILS_STR'
      '1106021785=      FROM OTHER T'
      
        '1106021786=      WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      
        '1106021787=        AND T.OP_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '1106021788=        AND T.OP_TYPE = :OP_TYPE_'
      '1106021789=        AND T.ARRIVAL_TYPE = :ARRIVAL_TYPE_'
      '1106021790=      INTO :OTHER,'
      '1106021791=           :OP_DATE,'
      '1106021792=           :OP_TYPE,'
      '1106021793=           :ARRIVAL_TYPE,'
      '1106021794=           :NOTE,'
      '1106021795=           :SKLAD_PARENT_ID,'
      '1106021796=           :G_TOCHKA,'
      '1106021797=           :STRING_DTLS'
      '1106021798=  DO BEGIN'
      '1106021799=    SUSPEND;'
      '1106021800=  END*/'
      '1106021801=END'
      '1106021802=;'
      '1106021803='
      '1106022111=ALTER PROCEDURE P_REP_BUILD_TREE('
      '1106022112=  MODE_ INTEGER,'
      '1106022113=  TYPE_ INTEGER)'
      '1106022114=AS'
      '1106022115=/*'
      
        '1106022116='#1086#1073#1077' '#1087#1077#1088#1077#1084#1077#1085#1085#1099#1077' '#1080#1089#1087#1086#1083#1100#1079#1091#1102#1090#1089#1103' '#1074' '#1089#1072#1083#1086#1085#1091#1095#1077#1090', '#1086#1090#1082#1091#1076#1072' '#1087#1088#1086#1094#1077 +
        #1076#1091#1088#1072' '#1080' '#1087#1077#1088#1077#1082#1086#1095#1077#1074#1072#1083#1072
      '1106022117=*/'
      '1106022118=begin'
      '1106022119=    DELETE FROM P_REP_TREE;'
      '1106022120='
      '1106022121='
      '1106022122=    INSERT INTO P_REP_TREE'
      '1106022123=    WITH RECURSIVE TREE AS (SELECT T.G_PRODUCT,'
      '1106022124=                                T.G_PRODUCT_PAR,'
      
        '1106022125=                                DECODE(T.g_product, -' +
        '1, '#39#1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) PATH       --'#1076#1083#1103' '#1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '1106022126=                              FROM G_PRODUCT T'
      
        '1106022127=                             WHERE T.G_PRODUCT_PAR IS' +
        ' NULL'
      '1106022128=                            UNION ALL'
      '1106022129=                            SELECT T.G_PRODUCT,'
      '1106022130=                                   T.G_PRODUCT_PAR,'
      
        '1106022131=                                   GG.PATH||'#39' - '#39'||T.' +
        'NAME PATH     --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      
        '1106022132=                              FROM G_PRODUCT T INNER ' +
        'JOIN TREE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '1106022133=                             WHERE T.IS_CATEGORY = 1'
      '1106022134=                            )'
      
        '1106022135=    SELECT GEN_ID(GEN_P_REP_TREE, 1), G_PRODUCT, G_PR' +
        'ODUCT_PAR, PATH FROM TREE ORDER BY 4, 2;'
      '1106022136=end'
      '1106022137=;'
      '1106022138='
      '1106022139=ALTER PROCEDURE P_REP_INVOICE('
      '1106022140=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '1106022141=  CURRENCY_ INTEGER)'
      '1106022142=RETURNS ('
      '1106022143=  NUM_ VARCHAR(50),'
      '1106022144=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '1106022145=  POSTAVSHIK_IDN_ADDRESS_ VARCHAR(1000),'
      '1106022146=  ACCOUNT_ VARCHAR(500),'
      '1106022147=  AGREEMENT_ VARCHAR(500),'
      '1106022148=  G_PAYMENT_TYPE_ VARCHAR(1000),'
      '1106022149=  PUNKT_ VARCHAR(1000),'
      '1106022150=  DOVERKA_ VARCHAR(1000),'
      '1106022151=  SPOSOB_OTPRAVKI_ VARCHAR(1000),'
      '1106022152=  NAKLADNAYA_ VARCHAR(1000),'
      '1106022153=  GRUZOOTPRAVITEL_ VARCHAR(1000),'
      '1106022154=  GRUZOPOLUCHATEL_ VARCHAR(1000),'
      '1106022155=  POLUCHATEL_ VARCHAR(1000),'
      '1106022156=  POLUCHATEL_ADDRESS_ VARCHAR(1000),'
      '1106022157=  POLUCHATEL_IIK_ VARCHAR(1000),'
      '1106022158=  RUKOVODITEL_ VARCHAR(1000),'
      '1106022159=  GLAVBUH_ VARCHAR(1000),'
      '1106022160=  ISPOLNITEL_APP_ VARCHAR(1000),'
      '1106022161=  ISPOLNITEL_ VARCHAR(1000),'
      '1106022162=  NUM_W_ VARCHAR(20),'
      '1106022163=  DATE_ VARCHAR(20),'
      '1106022164=  IDN_KPP_POST_ VARCHAR(30),'
      '1106022165=  IDN_KPP_POLUCH_ VARCHAR(30),'
      '1106022166=  CURR_STR_ VARCHAR(15),'
      '1106022167=  ROW_NUM VARCHAR(10),'
      '1106022168=  NAME VARCHAR(1000),'
      '1106022169=  SHORT_NAME VARCHAR(1000),'
      '1106022170=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106022171=  AMOUNT MY_NUMERIC_5,'
      '1106022172=  PRICE VARCHAR(500),'
      '1106022173=  WITHOUT_NDS VARCHAR(500),'
      '1106022174=  NDS VARCHAR(500),'
      '1106022175=  NDS_SUMM VARCHAR(500),'
      '1106022176=  SUMM VARCHAR(500),'
      '1106022177=  STOIM_TOVAROV_ VARCHAR(500),'
      '1106022178=  SUMM_NDS_ VARCHAR(500),'
      '1106022179=  SUMM_VSEGO_ VARCHAR(500),'
      '1106022180=  ERR_CODE INTEGER,'
      '1106022181=  ERR_MSG VARCHAR(1024))'
      '1106022182=AS'
      
        '1106022183=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_INVOIC' +
        'E'#39';'
      '1106022184=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106022185=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1106022186=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NOL_VMESTO_BEZ;'
      
        '1106022187=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REK' +
        'VIZIT.NDS_VALUE;'
      '1106022188=DECLARE VARIABLE I INTEGER = 1;'
      
        '1106022189=DECLARE VARIABLE ZSUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      '1106022190=BEGIN'
      '1106022191='
      '1106022192=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      
        '1106022193=  SELECT DECODE(:CURRENCY_, 0, '#39#1055#1086#1089#1090#1072#1074#1097#1080#1082': '#39', '#39#39')||I.' +
        'POSTAVSHIK,'
      '1106022194=         DECODE(:CURRENCY_,'
      
        '1106022195=                0, DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39 +
        #1041#1048#1053#39')||'#39' '#1080' '#1077#1075#1086' '#1072#1076#1088#1077#1089': '#39'||DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')' +
        '||'#39': '#39'||G.IDN||'#39', '#39','
      '1106022196=                '#39#39')||I.POSTAVSHIK||'#39', '#39'||FD.ADDRESS||'
      
        '1106022197=                DECODE(G.is_nds, 1, '#39'. '#1057#1074#1080#1076#1077#1090#1077#1083#1100#1089#1090#1074#1086' ' +
        #1086' '#1087#1086#1089#1090#1072#1085#1086#1074#1082#1077' '#1085#1072' '#1088#1077#1075#1080#1089#1090#1088#1072#1094#1080#1086#1085#1085#1099#1081' '#1091#1095#1077#1090' '#1087#1086' '#1053#1044#1057': '#1057#1077#1088#1080#1103' '#39'||G.nds_seri' +
        'al'
      
        '1106022198=                       ||'#39', '#8470#39'||G.nds_num||'#39' '#1086#1090' '#39'||EX' +
        'TRACT(DAY from g.nds_date)||'#39'.'#39'||EXTRACT(MONTH from g.nds_date)|' +
        '|'#39'.'#39'||EXTRACT(YEAR from g.nds_date), '#39#39'),'
      
        '1106022199=         '#39#1048#1048#1050' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1072': '#39'||FC.ACCOUNT||'#39' '#1074' '#39'||FB.NA' +
        'ME||'#39', '#1041#1048#1050': '#39'||FB.BIK,'
      
        '1106022200=         '#39#1044#1086#1075#1086#1074#1086#1088' ('#1082#1086#1085#1090#1088#1072#1082#1090') '#1085#1072' '#1087#1086#1089#1090#1072#1074#1082#1091' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073 +
        #1086#1090', '#1091#1089#1083#1091#1075'): '#39'||COALESCE(TRIM(I.AGREEMENT), '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39'),'
      
        '1106022201=         '#39#1059#1089#1083#1086#1074#1080#1103' '#1086#1087#1083#1072#1090#1099' '#1087#1086' '#1076#1086#1075#1086#1074#1086#1088#1091' ('#1082#1086#1085#1090#1088#1072#1082#1090#1091'): '#39'||' +
        'GP.NAME,'
      
        '1106022202=         '#39#1055#1091#1085#1082#1090' '#1085#1072#1079#1085#1072#1095#1077#1085#1080#1103' '#1087#1086#1089#1090#1072#1074#1083#1103#1077#1084#1099#1093' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086 +
        #1090', '#1091#1089#1083#1091#1075'): '#39'||I.PUNKT_NAZNACHENIYA,'
      
        '1106022203=         '#39#1055#1086#1089#1090#1072#1074#1082#1072' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086#1090','#1091#1089#1083#1091#1075') '#1086#1089#1091#1097#1077#1089#1090#1074#1083#1077#1085#1072 +
        ' '#1087#1086' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080': '#39'||I.DOVERENNOST,'
      '1106022204=         '#39#1057#1087#1086#1089#1086#1073' '#1086#1090#1087#1088#1072#1074#1083#1077#1085#1080#1103': '#39'||I.SPOSOB_OTPRAVKI,'
      
        '1106022205=         '#39#1058#1086#1074#1072#1088#1085#1086'-'#1090#1088#1072#1085#1089#1087#1086#1088#1090#1085#1072#1103' '#1085#1072#1082#1083#1072#1076#1085#1072#1103': '#39'||I.NAKLAD' +
        'NAYA,'
      
        '1106022206=         DECODE(:CURRENCY_, 0, '#39#1043#1088#1091#1079#1086#1086#1090#1087#1088#1072#1074#1080#1090#1077#1083#1100': '#39', ' +
        #39#39')||I.GRUZOOTPRAVITEL,'
      
        '1106022207=         DECODE(:CURRENCY_, 0, '#39#1043#1088#1091#1079#1086#1087#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39', '#39 +
        #39')||I.GRUZOPOLUCHATEL,'
      
        '1106022208=         DECODE(:CURRENCY_, 0, '#39#1055#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39', '#39#39')||I' +
        '.CLIENT_NAME,'
      '1106022209=         DECODE(:CURRENCY_,'
      
        '1106022210=                0, '#39#1048#1048#1053'/'#1041#1048#1053' '#1080' '#1072#1076#1088#1077#1089' '#1084#1077#1089#1090#1086#1085#1072#1093#1086#1078#1076#1077#1085#1080#1103' '#1087 +
        #1086#1083#1091#1095#1072#1090#1077#1083#1103': '#39'||COALESCE(I.IDN_CLIENT, '#39#39'),'
      '1106022211=                '#39#39')||COALESCE('#39', '#39'||AD.ADDRESS, '#39#39'),'
      
        '1106022212=         '#39#1048#1048#1050' '#1087#1086#1083#1091#1095#1072#1090#1077#1083#1103': '#39'||COALESCE(CC.ACCOUNT||'#39' '#1074 +
        ' '#39'||CC.NAME||'#39', '#1041#1048#1050': '#39'||CC.BIK, '#39#39'),'
      '1106022213=         RO.FIO_DOC,'
      '1106022214=         COALESCE(GO.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '1106022215=         AP.NAME,'
      '1106022216=         IO.FIO_DOC,'
      
        '1106022217=         '#39#1057#1095#1077#1090'-'#1092#1072#1082#1090#1091#1088#1072' '#8470#39'||I.NUM||'#39' '#1086#1090' '#39'||EXTRACT(DAY' +
        ' FROM I.INIT_DATE)||'#39' '#39'||'
      
        '1106022218=           (SELECT * FROM GET_RUSSIAN_MONTH(EXTRACT(M' +
        'ONTH FROM I.INIT_DATE), 1))||'#39' '#39'||EXTRACT(YEAR FROM I.INIT_DATE)' +
        '||'#39' '#1075'.'#39','
      '1106022219=         I.ZAKAZ,'
      '1106022220=         -- '#1044#1051#1071' '#1056#1054#1057#1057#1048#1049#1057#1050#1054#1049' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1067
      '1106022221=         I.NUM,'
      
        '1106022222=         EXTRACT(DAY FROM I.INIT_DATE)||'#39' '#39'||(SELECT ' +
        '* FROM GET_RUSSIAN_MONTH(EXTRACT(MONTH FROM I.INIT_DATE), 1))||'#39 +
        ' '#39'||EXTRACT(YEAR FROM I.INIT_DATE)||'#39' '#1075'.'#39','
      '1106022223=         G.IDN||'#39'/'#39'||G.KPP,'
      '1106022224=         G.nol_vmesto_bez,'
      '1106022225=         G.NDS_VALUE,'
      '1106022226=         I.IDN_CLIENT,'
      
        '1106022227=         DECODE(:CURRENCY_, 1, '#39#1056#1091#1073#1083#1100', 643'#39', 2, '#39#1043#1088#1080#1074 +
        #1085#1072', 980'#39')'
      '1106022228=    FROM INVOICE I'
      
        '1106022229=           LEFT OUTER JOIN G_OFFICIAL RO ON I.G_OFFIC' +
        'IAL_RUKOVOD = RO.G_OFFICIAL'
      
        '1106022230=           LEFT OUTER JOIN G_OFFICIAL GO ON I.G_OFFIC' +
        'IAL_GB = GO.G_OFFICIAL'
      
        '1106022231=           LEFT OUTER JOIN G_ADDRESS  AD ON I.ADDRESS' +
        '_POKUPATEL = AD.G_ADDRESS'
      
        '1106022232=           LEFT OUTER JOIN (SELECT GA.g_account, GA.a' +
        'ccount, CB.name, CB.BIK'
      
        '1106022233=                            FROM g_account GA, g_bank' +
        ' CB WHERE GA.g_bank = CB.g_bank) CC ON I.IIK_CLIENT = CC.G_ACCOU' +
        'NT,'
      '1106022234=         G_FIRM_REKVIZIT G,'
      '1106022235=         G_FIRM_ACCOUNT  FC,'
      '1106022236=         G_FIRM_ADDRESS  FD,'
      '1106022237=         G_BANK          FB,'
      '1106022238=         ---'
      '1106022239=         G_PAYMENT_TYPE  GP,'
      '1106022240=         G_OFFICIAL      IO,'
      '1106022241=         G_APPOINTMENT   AP'
      '1106022242=   WHERE I.INVOICE = :INVOICE_'
      
        '1106022243=     AND ((I.g_firm = G.g_firm_rekvizit AND I.g_firm ' +
        'IS NOT NULL) OR (G.is_default = 1 AND I.g_firm IS NULL))  -- '#1044#1054' ' +
        '02.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '1106022244=     AND I.ADDRESS = FD.G_ADDRESS'
      '1106022245=     AND I.IIK = FC.G_ACCOUNT'
      '1106022246=     AND FC.G_BANK = FB.G_BANK'
      '1106022247=     AND I.G_PAYMENT_TYPE = GP.G_PAYMENT_TYPE'
      '1106022248=     AND I.G_OFFICIAL = IO.G_OFFICIAL'
      '1106022249=     AND IO.G_APPOINTMENT = AP.G_APPOINTMENT'
      '1106022250=   INTO  :POSTAVSHIK_NAME_,'
      '1106022251=         :POSTAVSHIK_IDN_ADDRESS_,'
      '1106022252=         :ACCOUNT_,'
      '1106022253=         :AGREEMENT_,'
      '1106022254=         :G_PAYMENT_TYPE_,'
      '1106022255=         :PUNKT_,'
      '1106022256=         :DOVERKA_,'
      '1106022257=         :SPOSOB_OTPRAVKI_,'
      '1106022258=         :NAKLADNAYA_,'
      '1106022259=         :GRUZOOTPRAVITEL_,'
      '1106022260=         :GRUZOPOLUCHATEL_,'
      '1106022261=         :POLUCHATEL_,'
      '1106022262=         :POLUCHATEL_ADDRESS_,'
      '1106022263=         :POLUCHATEL_IIK_,'
      '1106022264=         :RUKOVODITEL_,'
      '1106022265=         :GLAVBUH_,'
      '1106022266=         :ISPOLNITEL_APP_,'
      '1106022267=         :ISPOLNITEL_,'
      '1106022268=         :NUM_,'
      '1106022269=         :ZAKAZ_,'
      '1106022270=         :NUM_W_,'
      '1106022271=         :DATE_,'
      '1106022272=         :IDN_KPP_POST_,'
      '1106022273=         :BEZ_NDS_,'
      '1106022274=         :NDS_VALUE_,'
      '1106022275=         :IDN_KPP_POLUCH_,'
      '1106022276=         :CURR_STR_;'
      '1106022277='
      '1106022278=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '1106022279=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' (' +
        #1088#1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080#1079#1072#1094 +
        #1080#1080'"'
      
        '1106022280=  -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052#1059' '#1063 +
        #1058#1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048#1058#1040#1045 +
        #1058#1057#1071
      '1106022281=  SELECT Z.SUMM'
      '1106022282=    FROM ZAKAZ Z'
      '1106022283=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106022284=    INTO :ZSUMM_;'
      '1106022285='
      
        '1106022286=  STOIM_TOVAROV_ = REPLACE(CAST(ROUND(ZSUMM_/(1 + :ND' +
        'S_VALUE_/100), 2) AS VARCHAR(10)), '#39'.'#39', '#39','#39');'
      '1106022287=  IF (ZSUMM_ <> 0) then'
      
        '1106022288=    SUMM_NDS_    = REPLACE(CAST(CAST(ROUND(ZSUMM_ * N' +
        'DS_VALUE_/(100 + NDS_VALUE_), 2) AS NUMERIC(15,2)) AS VARCHAR(10' +
        ')), '#39'.'#39', '#39','#39');'
      '1106022289=  ELSE'
      '1106022290=    SUMM_NDS_    = '#39#39';'
      
        '1106022291=  SUMM_VSEGO_    = REPLACE(CAST(ZSUMM_ AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39');'
      '1106022292='
      '1106022293=  FOR'
      '1106022294=    SELECT :I,'
      '1106022295=           G.NAME||DECODE(G.articul,'
      '1106022296=                          NULL, '#39#39','
      '1106022297=                          '#39#39', '#39#39','
      '1106022298=                          '#39', '#1072#1088#1090'. '#39'||G.articul),'
      '1106022299=           U.SHORT_NAME,'
      '1106022300=           G.barcode,'
      '1106022301=           CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '1106022302=           REPLACE(CAST(ROUND((ZD.PRICE - COALESCE(ZD' +
        '.DISCOUNT_TENGE, 0))/(1 + :NDS_VALUE_/100), 2) AS VARCHAR(10)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1106022303=           REPLACE(CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE' +
        '_/100), 2) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      '1106022304=           DECODE(:NDS_VALUE_,'
      
        '1106022305=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1106022306=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1106022307=                             '#39'0,00'#39'),'
      
        '1106022308=                   REPLACE(CAST(:NDS_VALUE_ AS VARCHA' +
        'R(10)), '#39'.'#39', '#39','#39')),'
      
        '1106022309=           REPLACE(CAST(DECODE(ZD.SUMM, 0, NULL, ZD.S' +
        'UMM - CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15' +
        ',2))) AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1106022310=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39'.'#39',' +
        ' '#39','#39')'
      '1106022311=      FROM ZAKAZ Z,'
      '1106022312=           ZAKAZ_DETAILS ZD,'
      '1106022313=           G_PRODUCT G,'
      '1106022314=           G_UNIT U'
      '1106022315=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106022316=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106022317=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106022318=       AND G.G_UNIT = U.G_UNIT'
      '1106022319=    INTO :ROW_NUM,'
      '1106022320=        :NAME,'
      '1106022321=        :SHORT_NAME,'
      '1106022322=        :BARCODE,'
      '1106022323=        :AMOUNT,'
      '1106022324=        :PRICE,'
      '1106022325=        :WITHOUT_NDS,'
      '1106022326=        :NDS,'
      '1106022327=        :NDS_SUMM,'
      '1106022328=        :SUMM'
      '1106022329=  DO BEGIN'
      '1106022330=    I = I + 1;'
      '1106022331=    SUSPEND;'
      '1106022332=  END'
      '1106022333='
      '1106022334=WHEN ANY DO BEGIN'
      '1106022335=    Err_code = -20500;'
      
        '1106022336=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106022337=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106022338=  END'
      '1106022339=end'
      '1106022340=;'
      '1106022341='
      '1106022342=ALTER PROCEDURE P_REP_INVOICE_PAY('
      
        '1106022343=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY' +
        ','
      '1106022344=  CURRENCY_ INTEGER)'
      '1106022345=RETURNS ('
      '1106022346=  NUM_ VARCHAR(500),'
      '1106022347=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '1106022348=  POSTAVSHIK_IDN_ VARCHAR(20),'
      '1106022349=  POSTAVSHIK_IDN_SELF_ VARCHAR(20),'
      '1106022350=  POSTAVSHIK_KPP_ VARCHAR(20),'
      '1106022351=  ACCOUNT_ VARCHAR(50),'
      '1106022352=  KBE_ VARCHAR(50),'
      '1106022353=  BANK_ VARCHAR(1000),'
      '1106022354=  BIK_ VARCHAR(20),'
      '1106022355=  KNP_ VARCHAR(20),'
      '1106022356=  POSTAVSHIK_ VARCHAR(1000),'
      '1106022357=  POKUPATEL_ VARCHAR(1000),'
      '1106022358=  AGREEMENT_ VARCHAR(500),'
      '1106022359=  SUMM_ VARCHAR(100),'
      '1106022360=  NDS_ VARCHAR(100),'
      '1106022361=  VSEGO_NAIM_ VARCHAR(500),'
      '1106022362=  VSEGO_K_OPLATE_ VARCHAR(500),'
      '1106022363=  ISPOLNITEL_ VARCHAR(500),'
      '1106022364=  ISPOLNITEL_APP_ VARCHAR(500),'
      '1106022365=  RUKOVODITEL_ VARCHAR(500),'
      '1106022366=  RUKOVODITEL_APP_ VARCHAR(500),'
      '1106022367=  ROW_NUM VARCHAR(100),'
      '1106022368=  ARTICUL VARCHAR(30),'
      '1106022369=  NAME VARCHAR(500),'
      '1106022370=  AMOUNT MY_NUMERIC_5,'
      '1106022371=  SHORT_NAME VARCHAR(1000),'
      '1106022372=  PRICE VARCHAR(500),'
      '1106022373=  SUMM VARCHAR(500),'
      '1106022374=  ERR_CODE INTEGER,'
      '1106022375=  ERR_MSG VARCHAR(1024))'
      '1106022376=AS'
      
        '1106022377=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_INVOIC' +
        'E_PAY'#39';'
      '1106022378=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106022379=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1106022380=DECLARE VARIABLE IS_PAY_NDS_ TYPE OF COLUMN G_FIRM_RE' +
        'KVIZIT.IS_NDS;'
      
        '1106022381=DECLARE VARIABLE NOL_VMESTO_NDS_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.NOL_VMESTO_BEZ;'
      
        '1106022382=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REK' +
        'VIZIT.NDS_VALUE;'
      '1106022383=DECLARE VARIABLE I INTEGER = 1;'
      '1106022384=DECLARE VARIABLE VAL_STR_ VARCHAR(20);'
      '1106022385=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      '1106022386=BEGIN'
      '1106022387='
      '1106022388=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      '1106022389=  SELECT I.POSTAVSHIK,'
      
        '1106022390=         DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39': ' +
        #39'||G.IDN,'
      '1106022391=         G.IDN,'
      '1106022392=         G.KPP,'
      '1106022393=         AC.ACCOUNT,'
      '1106022394=         I.KBE,'
      '1106022395=         I.BANK_NAME,  -- '#1041#1072#1085#1082' '#1073#1077#1085#1077#1092#1080#1094#1080#1072#1088#1072':'
      '1106022396=         I.BIK,        -- '#1041#1048#1050
      '1106022397=         I.KNP,  -- '#1050#1086#1076' '#1085#1072#1079#1085#1072#1095#1077#1085#1080#1103' '#1087#1083#1072#1090#1077#1078#1072
      
        '1106022398=         DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39': ' +
        #39'||G.IDN||'#39', '#39'||I.POSTAVSHIK||'#39', '#39'||AD.ADDRESS,'
      
        '1106022399=         DECODE(char_length(TRIM(I.IDN_CLIENT)), 0, '#39 +
        #39', '#39#1048#1048#1053'/'#1041#1048#1053': '#39'||I.IDN_CLIENT||'#39', '#39')||I.G_CLIENT||COALESCE('#39', '#39'||' +
        'ADC.ADDRESS, '#39#39'),'
      '1106022400=         COALESCE(TRIM(I.AGREEMENT), '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39'),'
      '1106022401=         I.ZAKAZ,'
      '1106022402=         '#39'/'#39'||O.FIO_DOC||'#39'/'#39','
      '1106022403=         A.NAME,'
      '1106022404=         G.IS_NDS,'
      '1106022405=         G.NDS_VALUE,'
      '1106022406=         G.NOL_VMESTO_BEZ,'
      
        '1106022407=         '#39#1057#1095#1077#1090' '#1085#1072' '#1086#1087#1083#1072#1090#1091' '#8470#39'||I.NUM||'#39' '#1086#1090' '#39'||EXTRACT(D' +
        'AY FROM I.INIT_DATE)||'#39' '#39'||'
      
        '1106022408=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(' +
        'EXTRACT(MONTH FROM I.INIT_DATE), 1))||'#39' '#39'||EXTRACT(YEAR FROM I.I' +
        'NIT_DATE)||'#39' '#1075'.'#39
      
        '1106022409=    FROM INVOICE_PAY I LEFT OUTER JOIN G_ADDRESS ADC ' +
        'ON I.address_pokupatel = ADC.g_address,'
      '1106022410=         G_FIRM_REKVIZIT G,'
      '1106022411=         (SELECT *'
      '1106022412=            FROM G_FIRM_ACCOUNT) AC,'
      '1106022413=         (SELECT *'
      '1106022414=            FROM G_FIRM_ADDRESS) AD,'
      '1106022415=         G_OFFICIAL O,'
      '1106022416=         G_APPOINTMENT A'
      '1106022417=   WHERE I.INVOICE_PAY = :INVOICE_PAY_'
      
        '1106022418=     AND ((I.g_firm = G.g_firm_rekvizit AND I.g_firm ' +
        'IS NOT NULL) OR (G.is_default = 1 AND I.g_firm IS NULL))  -- '#1044#1054' ' +
        '02.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '1106022419=     AND I.ADDRESS = AD.G_ADDRESS'
      '1106022420=     AND I.IIK = AC.G_ACCOUNT'
      '1106022421=     AND I.G_OFFICIAL = O.G_OFFICIAL'
      '1106022422=     AND O.G_APPOINTMENT = A.G_APPOINTMENT'
      '1106022423=  INTO :POSTAVSHIK_NAME_,'
      '1106022424=       :POSTAVSHIK_IDN_,'
      '1106022425=       :POSTAVSHIK_IDN_SELF_,'
      '1106022426=       :POSTAVSHIK_KPP_,'
      '1106022427=         :ACCOUNT_,'
      '1106022428=         :KBE_,'
      '1106022429=         :BANK_,'
      '1106022430=         :BIK_,'
      '1106022431=         :KNP_,'
      '1106022432=         :POSTAVSHIK_,'
      '1106022433=         :POKUPATEL_,'
      '1106022434=         :AGREEMENT_,'
      '1106022435=         :ZAKAZ_,'
      '1106022436=         :ISPOLNITEL_,'
      '1106022437=         :ISPOLNITEL_APP_,'
      '1106022438=         :IS_PAY_NDS_,'
      '1106022439=         :NDS_VALUE_,'
      '1106022440=         :NOL_VMESTO_NDS_,'
      '1106022441=         :NUM_;'
      '1106022442='
      '1106022443=  SELECT '#39'/'#39'||G.FIO_DOC||'#39'/'#39','
      '1106022444=         A.NAME'
      '1106022445=    FROM G_OFFICIAL G,'
      '1106022446=         G_APPOINTMENT A'
      '1106022447=    WHERE G.IS_RUKOVODITEL = 1'
      '1106022448=    AND G.G_APPOINTMENT = A.G_APPOINTMENT'
      '1106022449=  INTO :RUKOVODITEL_,'
      '1106022450=       :RUKOVODITEL_APP_;'
      '1106022451='
      '1106022452=  -- '#1053#1048#1046#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      '1106022453=  SELECT CAST(Z.SUMM AS VARCHAR(20)),'
      
        '1106022454=         '#39#1042#1089#1077#1075#1086' '#1082' '#1086#1087#1083#1072#1090#1077': '#39'||(SELECT CURR_STR from CU' +
        'RRENCYSTR(Z.SUMM, :CURRENCY_))'
      '1106022455=    FROM ZAKAZ Z'
      '1106022456=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106022457=  INTO :SUMM_,'
      '1106022458=       :VSEGO_K_OPLATE_;'
      '1106022459='
      
        '1106022460=  -- '#1042#1054' '#1060#1056#1040#1047#1045' '#1042#1057#1045#1043#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1049' '#1045#1057#1058#1068' '#1042#1040#1051#1070#1058#1040', '#1055#1054#1069#1058#1054#1052#1059 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1050#1051#1054#1053#1071#1058#1068
      '1106022461=  if (CURRENCY_ = 0) then'
      '1106022462=    CURR_STR_ = '#39' '#1090#1077#1085#1075#1077#39';'
      '1106022463=  else begin'
      '1106022464=      SELECT CAST(TRUNC(SUM(Z.SUMM)) AS VARCHAR(20))'
      '1106022465=        FROM ZAKAZ Z'
      '1106022466=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106022467=      INTO :VAL_STR_;'
      '1106022468='
      
        '1106022469=      i = cast(substring(VAL_STR_ from CHAR_LENGTH(VA' +
        'L_STR_) for 1) as int);'
      '1106022470='
      '1106022471=      if (i=1) then begin'
      '1106022472=        if (CURRENCY_ = 1) then'
      '1106022473=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1100#39';'
      '1106022474=        else'
      '1106022475=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1072#39';'
      '1106022476='
      '1106022477=      end ELSE if ((i=2) or (I=3)) then begin'
      '1106022478=        if (CURRENCY_ = 1) then'
      '1106022479=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1103#39';'
      '1106022480=        ELSE'
      '1106022481=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1099#39';'
      '1106022482=      END ELSE BEGIN'
      '1106022483=        if (CURRENCY_ = 1) then'
      '1106022484=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1077#1081#39';'
      '1106022485=        ELSE'
      '1106022486=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1077#1085#39';'
      '1106022487=      end'
      '1106022488=  end'
      '1106022489='
      
        '1106022490=  SELECT '#39#1042#1089#1077#1075#1086' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1081' '#39'||COUNT(ZD.ZAKAZ_DETAIL' +
        'S)||'#39', '#1085#1072' '#1089#1091#1084#1084#1091' '#39'||CAST(SUM(ZD.SUMM) AS VARCHAR(20))||:CURR_STR_' +
        ','
      '1106022491=         DECODE(:IS_PAY_NDS_,'
      
        '1106022492=                0, DECODE(:NOL_VMESTO_NDS_, 0, '#39#1041#1077#1079' '#1053 +
        #1044#1057#39', '#39'0,00'#39'),  -- '#1055#1048#1057#1040#1058#1068' "0" '#1048#1051#1048' "'#1041#1077#1079' '#1053#1044#1057'"'
      '1106022493=                CAST(SUM(ZD.NDS_SUMM) AS VARCHAR(20))'
      '1106022494=               )'
      '1106022495=    FROM ZAKAZ Z,'
      '1106022496=         ZAKAZ_DETAILS ZD'
      '1106022497=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106022498=     AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106022499=  INTO :VSEGO_NAIM_,'
      '1106022500=       :NDS_;'
      '1106022501='
      
        '1106022502=  -- '#1042' '#1048#1058#1054#1043#1045' '#1042' '#1045#1050#1057#1045#1051#1045' '#1042#1057#1045' '#1062#1048#1060#1056#1067' '#1042#1067#1042#1054#1044#1071#1058#1057#1071' '#1057' '#1044#1045#1057#1071#1058#1048#1063#1053#1067 +
        #1052' '#1056#1040#1047#1044#1045#1051#1048#1058#1045#1051#1045#1052' '#1058#1054#1063#1050#1040', '#1040' '#1053#1045' '#1047#1040#1055#1071#1058#1040#1071'. '#1053#1045' '#1047#1053#1040#1051' '#1063#1058#1054' '#1055#1056#1048#1044#1059#1052#1040#1058#1068' '#1048' '#1055#1054#1058#1054 +
        #1052#1059' '#1055#1054#1057#1058#1040#1042#1048#1051' '#1058#1059#1058' '#1058#1059#1055#1054' '#1047#1040#1052#1045#1053#1059
      '1106022503=  SUMM_ = REPLACE(SUMM_, '#39'.'#39', '#39','#39');'
      '1106022504=  VSEGO_NAIM_ = REPLACE(VSEGO_NAIM_, '#39'.'#39', '#39','#39');'
      '1106022505='
      '1106022506=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      '1106022507=  I = 1;'
      '1106022508=  FOR'
      '1106022509=    SELECT :I,'
      '1106022510=           G.NAME,'
      '1106022511=           G.ARTICUL,'
      '1106022512=           ZD.AMOUNT,'
      '1106022513=           U.SHORT_NAME,'
      
        '1106022514=           REPLACE(CAST(ZD.PRICE - ZD.DISCOUNT_TENGE ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1106022515=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39'.'#39',' +
        ' '#39','#39')'
      '1106022516=      FROM ZAKAZ Z,'
      '1106022517=           ZAKAZ_DETAILS ZD,'
      '1106022518=           G_PRODUCT G,'
      '1106022519=           G_UNIT U'
      '1106022520=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106022521=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106022522=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106022523=       AND G.G_UNIT = U.G_UNIT'
      '1106022524=   ORDER BY G.NAME, ZD.ZAKAZ_DETAILS'
      '1106022525=    INTO :ROW_NUM,'
      '1106022526=        :NAME,'
      '1106022527=        :ARTICUL,'
      '1106022528=        :AMOUNT,'
      '1106022529=        :SHORT_NAME,'
      '1106022530=        :PRICE,'
      '1106022531=        :SUMM'
      '1106022532=  DO BEGIN'
      '1106022533=    I = I + 1;'
      '1106022534=    SUSPEND;'
      '1106022535=  END'
      '1106022536='
      '1106022537=WHEN ANY DO BEGIN'
      '1106022538=    Err_code = -20500;'
      
        '1106022539=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106022540=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106022541=  END'
      '1106022542=end'
      '1106022543=;'
      '1106022544='
      '1106022545=ALTER PROCEDURE P_REP_INVOICE_PAY_TMP('
      '1106022546=  CURRENCY_ INTEGER,'
      '1106022547=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1106022548=  AGREEMENT_IN_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106022549=  SUMM_IN_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106022550=  AMOUNT_IN_ INTEGER,'
      '1106022551=  NDS_SUMM_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS_SUMM,'
      '1106022552=  DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE)'
      '1106022553=RETURNS ('
      '1106022554=  NUM_ VARCHAR(500),'
      '1106022555=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '1106022556=  POSTAVSHIK_IDN_ VARCHAR(20),'
      '1106022557=  POSTAVSHIK_IDN_SELF_ VARCHAR(20),'
      '1106022558=  POSTAVSHIK_KPP_ VARCHAR(20),'
      '1106022559=  ACCOUNT_ VARCHAR(50),'
      '1106022560=  KBE_ VARCHAR(50),'
      '1106022561=  BANK_ VARCHAR(1000),'
      '1106022562=  BIK_ VARCHAR(20),'
      '1106022563=  KNP_ VARCHAR(20),'
      '1106022564=  POSTAVSHIK_ VARCHAR(1000),'
      '1106022565=  POKUPATEL_ VARCHAR(1000),'
      '1106022566=  AGREEMENT_ VARCHAR(500),'
      '1106022567=  SUMM_ VARCHAR(100),'
      '1106022568=  NDS_ VARCHAR(100),'
      '1106022569=  VSEGO_NAIM_ VARCHAR(500),'
      '1106022570=  VSEGO_K_OPLATE_ VARCHAR(500),'
      '1106022571=  ISPOLNITEL_ VARCHAR(500),'
      '1106022572=  ISPOLNITEL_APP_ VARCHAR(500),'
      '1106022573=  RUKOVODITEL_ VARCHAR(500),'
      '1106022574=  RUKOVODITEL_APP_ VARCHAR(500),'
      '1106022575=  ROW_NUM VARCHAR(100),'
      '1106022576=  ARTICUL VARCHAR(30),'
      '1106022577=  NAME VARCHAR(500),'
      '1106022578=  AMOUNT VARCHAR(500),'
      '1106022579=  SHORT_NAME VARCHAR(1000),'
      '1106022580=  PRICE VARCHAR(500),'
      '1106022581=  SUMM VARCHAR(500),'
      '1106022582=  ERR_CODE INTEGER,'
      '1106022583=  ERR_MSG VARCHAR(1024))'
      '1106022584=AS'
      
        '1106022585=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_INVOIC' +
        'E_PAY'#39';'
      '1106022586=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106022587=DECLARE VARIABLE IS_PAY_NDS_ TYPE OF COLUMN G_FIRM_RE' +
        'KVIZIT.IS_NDS;'
      
        '1106022588=DECLARE VARIABLE NOL_VMESTO_NDS_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.NOL_VMESTO_BEZ;'
      '1106022589=DECLARE VARIABLE I INTEGER = 1;'
      '1106022590=DECLARE VARIABLE VAL_STR_ VARCHAR(20);'
      '1106022591=DECLARE VARIABLE CURR_STR_ VARCHAR(10);'
      
        '1106022592=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.g_official;'
      '1106022593=BEGIN'
      '1106022594='
      '1106022595=  -- '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059
      
        '1106022596=  SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VARC' +
        'HAR(20)) -- NVL '#1055#1054#1057#1058#1040#1042#1048#1051
      '1106022597=    FROM INVOICE_PAY P'
      '1106022598=    INTO :NUM_;'
      
        '1106022599=  if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059' '#1042 +
        #1054#1054#1041#1065#1045' '#1053#1045#1058
      '1106022600=    NUM_ = '#39'1'#39';'
      '1106022601='
      '1106022602=  -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1106022603=  SELECT G.name'
      
        '1106022604=         ,DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39':' +
        ' '#39'||G.IDN'
      '1106022605=         ,G.IDN'
      '1106022606=         ,G.KPP'
      '1106022607=         ,AC.ACCOUNT'
      '1106022608=         ,G.kbe'
      '1106022609=         ,AC.NAME'
      '1106022610=         ,AC.BIK'
      '1106022611=         ,'#39#39'        --'#1050#1053#1055
      
        '1106022612=         ,DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39':' +
        ' '#39'||G.IDN||'#39', '#39'||G.name||'#39', '#39'||COALESCE(AD.ADDRESS, '#39#39')'
      
        '1106022613=         ,DECODE(char_length(TRIM(GC.idn)), 0, '#39#39', '#39#1048 +
        #1048#1053'/'#1041#1048#1053': '#39'||GC.idn||'#39', '#39')||GC.name||COALESCE('#39', '#39'||ADC.ADDRESS, '#39 +
        #39')'
      
        '1106022614=         ,COALESCE(TRIM(:AGREEMENT_IN_), '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088 +
        #1072#39')'
      '1106022615=         ,G.IS_NDS'
      '1106022616=         ,G.NOL_VMESTO_BEZ'
      
        '1106022617=         ,'#39#1057#1095#1077#1090' '#1085#1072' '#1086#1087#1083#1072#1090#1091' '#8470#39'||:NUM_||'#39' '#1086#1090' '#39'||EXTRACT(' +
        'DAY FROM :DATE_)||'#39' '#39'||'
      
        '1106022618=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(' +
        'EXTRACT(MONTH FROM :DATE_), 1))||'#39' '#39'||EXTRACT(YEAR FROM :DATE_)|' +
        '|'#39' '#1075'.'#39
      '1106022619=  FROM G_FIRM_REKVIZIT g'
      '1106022620=         LEFT OUTER JOIN (SELECT A.G_ACCOUNT,'
      '1106022621=                                 A.ACCOUNT,'
      '1106022622=                                 A.G_FIRM_REKVIZIT,'
      '1106022623=                                 A.G_BANK,'
      '1106022624=                                 B.BIK, B.NAME'
      '1106022625=                            FROM G_FIRM_ACCOUNT A,'
      '1106022626=                                 G_BANK B'
      '1106022627=                           WHERE A.G_BANK = B.G_BANK'
      
        '1106022628=                             AND A.IS_DEFAULT = 1) AC' +
        ' ON G.G_FIRM_REKVIZIT = AC.G_FIRM_REKVIZIT'
      
        '1106022629=         LEFT OUTER JOIN (SELECT F.g_firm_rekvizit, F' +
        '.address'
      '1106022630=                            FROM G_FIRM_ADDRESS F'
      
        '1106022631=                           WHERE F.IS_DEFAULT = 1) AD' +
        ' ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT,'
      
        '1106022632=       G_CLIENT GC LEFT OUTER JOIN (SELECT GGG.g_clie' +
        'nt, GGG.address'
      
        '1106022633=                                      FROM G_ADDRESS ' +
        'GGG'
      
        '1106022634=                                     WHERE GGG.IS_DEF' +
        'AULT = 1) ADC ON GC.G_CLIENT = ADC.G_CLIENT'
      '1106022635=    WHERE G.IS_DEFAULT = 1'
      '1106022636=      AND GC.g_client = :G_CLIENT_'
      '1106022637=   INTO :POSTAVSHIK_NAME_,'
      '1106022638=        :POSTAVSHIK_IDN_,'
      '1106022639=        :POSTAVSHIK_IDN_SELF_,'
      '1106022640=        :POSTAVSHIK_KPP_,'
      '1106022641=        :ACCOUNT_,'
      '1106022642=        :KBE_,'
      '1106022643=        :BANK_,'
      '1106022644=        :BIK_,'
      '1106022645=        :KNP_,'
      '1106022646=        :POSTAVSHIK_,'
      '1106022647=        :POKUPATEL_,'
      '1106022648=        :AGREEMENT_,'
      '1106022649=        :IS_PAY_NDS_,'
      '1106022650=        :NOL_VMESTO_NDS_,'
      '1106022651=        :NUM_;'
      '1106022652='
      
        '1106022653=  --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054#1041 +
        #1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      '1106022654=  PNT_ = '#39'05'#39';'
      '1106022655=  SELECT C.id'
      '1106022656=    FROM cur_params C'
      '1106022657=   WHERE C.cur_params = 1'
      '1106022658=  INTO :G_OFFICIAL_;'
      '1106022659='
      '1106022660=  IF (ROW_COUNT = 0) then BEGIN'
      '1106022661=      SELECT MIN(O.G_OFFICIAL)'
      '1106022662=        FROM G_OFFICIAL O'
      '1106022663=        INTO :G_OFFICIAL_;'
      '1106022664=      IF (ROW_COUNT = 0) then BEGIN'
      '1106022665=          Err_Code = -20500;'
      
        '1106022666=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057#1087 +
        #1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      
        '1106022667=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1106022668=          EXIT;'
      '1106022669=      END'
      '1106022670=  END'
      '1106022671='
      '1106022672=  SELECT '#39'/'#39'||O.FIO_DOC||'#39'/'#39','
      '1106022673=         A.name'
      '1106022674=    FROM G_OFFICIAL O, G_APPOINTMENT A'
      '1106022675=   WHERE O.g_official = :G_OFFICIAL_'
      '1106022676=     AND O.G_APPOINTMENT = A.G_APPOINTMENT'
      '1106022677=    INTO :ISPOLNITEL_'
      '1106022678=         ,:ISPOLNITEL_APP_;'
      '1106022679='
      '1106022680=  SELECT '#39'/'#39'||G.FIO_DOC||'#39'/'#39','
      '1106022681=         A.NAME'
      '1106022682=    FROM G_OFFICIAL G,'
      '1106022683=         G_APPOINTMENT A'
      '1106022684=    WHERE G.IS_RUKOVODITEL = 1'
      '1106022685=    AND G.G_APPOINTMENT = A.G_APPOINTMENT'
      '1106022686=  INTO :RUKOVODITEL_,'
      '1106022687=       :RUKOVODITEL_APP_;'
      '1106022688='
      '1106022689=  -- '#1053#1048#1046#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      '1106022690=  SELECT CAST(:summ_in_ AS VARCHAR(20)),'
      
        '1106022691=         '#39#1042#1089#1077#1075#1086' '#1082' '#1086#1087#1083#1072#1090#1077': '#39'||(SELECT CURR_STR from CU' +
        'RRENCYSTR(:summ_in_, :CURRENCY_))'
      '1106022692=    FROM RDB$DATABASE'
      '1106022693=  INTO :SUMM_,'
      '1106022694=       :VSEGO_K_OPLATE_;'
      '1106022695='
      
        '1106022696=  -- '#1042#1054' '#1060#1056#1040#1047#1045' '#1042#1057#1045#1043#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1049' '#1045#1057#1058#1068' '#1042#1040#1051#1070#1058#1040', '#1055#1054#1069#1058#1054#1052#1059 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1050#1051#1054#1053#1071#1058#1068
      '1106022697=  if (CURRENCY_ = 0) then'
      '1106022698=    CURR_STR_ = '#39' '#1090#1077#1085#1075#1077#39';'
      '1106022699=  else begin'
      '1106022700=      SELECT CAST(TRUNC(:summ_in_) AS VARCHAR(20))'
      '1106022701=        FROM RDB$DATABASE'
      '1106022702=      INTO :VAL_STR_;'
      '1106022703='
      
        '1106022704=      i = cast(substring(VAL_STR_ from CHAR_LENGTH(VA' +
        'L_STR_) for 1) as int);'
      '1106022705='
      '1106022706=      if (i=1) then begin'
      '1106022707=        if (CURRENCY_ = 1) then'
      '1106022708=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1100#39';'
      '1106022709=        else'
      '1106022710=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1072#39';'
      '1106022711='
      '1106022712=      end ELSE if ((i=2) or (I=3)) then begin'
      '1106022713=        if (CURRENCY_ = 1) then'
      '1106022714=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1103#39';'
      '1106022715=        ELSE'
      '1106022716=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1085#1099#39';'
      '1106022717=      END ELSE BEGIN'
      '1106022718=        if (CURRENCY_ = 1) then'
      '1106022719=          CURR_STR_ = '#39' '#1088#1091#1073#1083#1077#1081#39';'
      '1106022720=        ELSE'
      '1106022721=          CURR_STR_ = '#39' '#1075#1088#1080#1074#1077#1085#39';'
      '1106022722=      end'
      '1106022723=  end'
      '1106022724='
      
        '1106022725=  SELECT '#39#1042#1089#1077#1075#1086' '#1085#1072#1080#1084#1077#1085#1086#1074#1072#1085#1080#1081' '#39'||:AMOUNT_IN_||'#39', '#1085#1072' '#1089#1091 +
        #1084#1084#1091' '#39'||CAST(:SUMM_IN_ AS VARCHAR(20))||:CURR_STR_,'
      '1106022726=         DECODE(:IS_PAY_NDS_,'
      
        '1106022727=                0, DECODE(:NOL_VMESTO_NDS_, 0, '#39#1041#1077#1079' '#1053 +
        #1044#1057#39', '#39'0,00'#39'),  -- '#1055#1048#1057#1040#1058#1068' "0" '#1048#1051#1048' "'#1041#1077#1079' '#1053#1044#1057'"'
      '1106022728=                CAST(:NDS_SUMM_IN_ AS VARCHAR(20))'
      '1106022729=               )'
      '1106022730=    FROM RDB$DATABASE'
      '1106022731=  INTO :VSEGO_NAIM_,'
      '1106022732=       :NDS_;'
      '1106022733='
      
        '1106022734=  -- '#1042' '#1048#1058#1054#1043#1045' '#1042' '#1045#1050#1057#1045#1051#1045' '#1042#1057#1045' '#1062#1048#1060#1056#1067' '#1042#1067#1042#1054#1044#1071#1058#1057#1071' '#1057' '#1044#1045#1057#1071#1058#1048#1063#1053#1067 +
        #1052' '#1056#1040#1047#1044#1045#1051#1048#1058#1045#1051#1045#1052' '#1058#1054#1063#1050#1040', '#1040' '#1053#1045' '#1047#1040#1055#1071#1058#1040#1071'. '#1053#1045' '#1047#1053#1040#1051' '#1063#1058#1054' '#1055#1056#1048#1044#1059#1052#1040#1058#1068' '#1048' '#1055#1054#1058#1054 +
        #1052#1059' '#1055#1054#1057#1058#1040#1042#1048#1051' '#1058#1059#1058' '#1058#1059#1055#1054' '#1047#1040#1052#1045#1053#1059
      '1106022735=  SUMM_ = REPLACE(SUMM_, '#39'.'#39', '#39','#39');'
      '1106022736=  VSEGO_NAIM_ = REPLACE(VSEGO_NAIM_, '#39'.'#39', '#39','#39');'
      '1106022737='
      '1106022738=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      '1106022739=  I = 1;'
      '1106022740=  FOR'
      '1106022741=    SELECT :I,'
      '1106022742=           G.NAME,'
      '1106022743=           G.ARTICUL,'
      '1106022744=           ZD.AMOUNT,'
      '1106022745=           U.SHORT_NAME,'
      
        '1106022746=           REPLACE(CAST(ZD.PRICE - ZD.DISCOUNT_TENGE ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1106022747=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39'.'#39',' +
        ' '#39','#39')'
      '1106022748=      FROM ZAKAZ_DETAILS_TMP ZD,'
      '1106022749=           G_PRODUCT G,'
      '1106022750=           G_UNIT U'
      '1106022751=     WHERE ZD.G_PRODUCT = G.G_PRODUCT'
      '1106022752=       AND G.G_UNIT = U.G_UNIT'
      '1106022753=   ORDER BY G.NAME, ZD.ZAKAZ_DETAILS'
      '1106022754=    INTO :ROW_NUM,'
      '1106022755=        :NAME,'
      '1106022756=        :ARTICUL,'
      '1106022757=        :AMOUNT,'
      '1106022758=        :SHORT_NAME,'
      '1106022759=        :PRICE,'
      '1106022760=        :SUMM'
      '1106022761=  DO BEGIN'
      '1106022762=    I = I + 1;'
      '1106022763=    SUSPEND;'
      '1106022764=  END'
      '1106022765='
      '1106022766=WHEN ANY DO BEGIN'
      '1106022767=    Err_code = -20500;'
      
        '1106022768=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106022769=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106022770=  END'
      '1106022771=end'
      '1106022772=;'
      '1106022773='
      '1106022774=ALTER PROCEDURE P_REP_KASSIR('
      '1106022775=  DATE_BEGIN_ DATE,'
      '1106022776=  DATE_END_ DATE,'
      '1106022777=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1106022778=RETURNS ('
      '1106022779=  PERIOD_ VARCHAR(40),'
      '1106022780=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '1106022781=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '1106022782=  ROWCOL INTEGER,'
      '1106022783=  Z_DATE VARCHAR(40),'
      '1106022784=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106022785=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106022786=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106022787=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106022788=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '1106022789=AS'
      '1106022790=/*'
      
        '1106022791='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071 +
        ', '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '1106022792=*/'
      '1106022793=DECLARE VARIABLE SORT_COL INTEGER;'
      '1106022794=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '1106022795=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '1106022796=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '1106022797=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1106022798=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = ' +
        '0;'
      
        '1106022799=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      
        '1106022800=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NUL' +
        'L = 0;'
      '1106022801=BEGIN'
      
        '1106022802=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1106022803=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1106022804='
      '1106022805=  SELECT S."INPUT"'
      '1106022806=    FROM kassa_state S'
      '1106022807=   WHERE S.k_date = :DATE_BEGIN_'
      '1106022808=     AND S.g_tochka = :G_TOCHKA_'
      '1106022809=    INTO :IN_SUMM_;'
      '1106022810='
      '1106022811=  IF (ROW_COUNT = 0) THEN'
      '1106022812=    SELECT S."OUTPUT"'
      '1106022813=      FROM kassa_state S'
      '1106022814=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1106022815=                         FROM KASSA_STATE ST'
      
        '1106022816=                        WHERE ST.k_date < :DATE_BEGIN' +
        '_'
      
        '1106022817=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1106022818=      AND S.g_tochka = :G_TOCHKA_'
      '1106022819=      INTO :IN_SUMM_;'
      '1106022820='
      '1106022821=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '1106022822='
      '1106022823=  SELECT S."OUTPUT"'
      '1106022824=    FROM kassa_state S'
      '1106022825=   WHERE S.k_date = :DATE_END_'
      '1106022826=     AND S.g_tochka = :G_TOCHKA_'
      '1106022827=    INTO :OUT_SUMM_;'
      '1106022828='
      '1106022829=  IF (ROW_COUNT = 0) THEN'
      '1106022830=    SELECT S."OUTPUT"'
      '1106022831=      FROM kassa_state S'
      '1106022832=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1106022833=                         FROM KASSA_STATE ST'
      '1106022834=                        WHERE ST.k_date < :DATE_END_'
      
        '1106022835=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1106022836=      AND S.g_tochka = :G_TOCHKA_'
      '1106022837=      INTO :OUT_SUMM_;'
      '1106022838='
      '1106022839=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '1106022840='
      '1106022841=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '1106022842=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')' +
        '||'#39'.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(' +
        'YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_STR'
      '1106022843=           ,Z.Z_DATE'
      '1106022844=           ,GP.ARTICUL'
      '1106022845=           ,GP.BARCODE'
      '1106022846=           ,GP.NAME'
      '1106022847=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '1106022848=           ,SUM(ZD.summ)    SUMM'
      '1106022849=      FROM ZAKAZ Z'
      '1106022850=           ,ZAKAZ_DETAILS ZD'
      '1106022851=           ,G_PRODUCT GP'
      '1106022852=     WHERE Z.is_spisanie in (0, 2)'
      '1106022853=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106022854=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1106022855=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106022856=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '1106022857=       AND Z.G_TOCHKA = :G_TOCHKA_'
      
        '1106022858=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NA' +
        'ME'
      '1106022859=      INTO :date_str,'
      '1106022860=           :Z_DATE,'
      '1106022861=           :ARTICUL,'
      '1106022862=           :BARCODE,'
      '1106022863=           :NAME,'
      '1106022864=           :AMOUNT,'
      '1106022865=           :SUMM'
      '1106022866=  DO BEGIN'
      '1106022867=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1106022868=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1106022869=      VALUES (1, 1, '#39#1055#1088#1086#1076#1072#1078#1072#39');'
      '1106022870=      FIRST_ITER = 1;'
      '1106022871=    END'
      '1106022872='
      
        '1106022873=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '1106022874=      VALUES (2, 2, :DATE_STR, :z_date,  :ARTICUL, :B' +
        'ARCODE, :NAME, :AMOUNT, :SUMM);'
      '1106022875=  END'
      '1106022876='
      '1106022877=  IF (first_iter > 0) THEN BEGIN'
      
        '1106022878=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1106022879=        VALUES (3, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', (SELECT SUM(K.S' +
        'UMM)'
      
        '1106022880=                                         FROM KASSA K' +
        ','
      '1106022881=                                              ZAKAZ Z'
      
        '1106022882=                                        WHERE K.G_TOC' +
        'HKA = :G_TOCHKA_'
      
        '1106022883=                                          AND K.ZAKAZ' +
        ' = Z.ZAKAZ'
      
        '1106022884=                                          AND Z.z_dat' +
        'e BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1106022885=                                          AND Z.G_TOC' +
        'HKA = :G_TOCHKA_'
      
        '1106022886=                                          AND Z.is_sp' +
        'isanie in (0, 2)'
      
        '1106022887=                                          AND K.ACTIO' +
        'N_DATE = Z.Z_DATE)'
      '1106022888=               )'
      '1106022889=      RETURNING'
      '1106022890=        SUMM'
      '1106022891=      INTO'
      '1106022892=        :SUMM_PRIHOD_ALL_;'
      '1106022893='
      
        '1106022894=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR, SUMM)'
      
        '1106022895=        VALUES (4, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39', (SELECT SUM(' +
        'K.SUMM)'
      
        '1106022896=                                             FROM KAS' +
        'SA_BEZNAL K,'
      
        '1106022897=                                                  ZAK' +
        'AZ Z'
      
        '1106022898=                                            WHERE K.G' +
        '_TOCHKA = :G_TOCHKA_'
      
        '1106022899=                                              AND K.Z' +
        'AKAZ = Z.ZAKAZ'
      
        '1106022900=                                              AND Z.z' +
        '_date BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1106022901=                                              AND Z.G' +
