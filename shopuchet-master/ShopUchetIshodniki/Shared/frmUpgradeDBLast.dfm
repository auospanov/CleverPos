      '1101360=ALTER PROCEDURE P_REP_AVERAGE_BILL('
      '1101361=  DATE_BEGIN_ DATE,'
      '1101362=  DATE_END_ DATE,'
      '1101363=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101364=RETURNS ('
      '1101365=  CNT_ INTEGER,'
      
        '1101366=  SUMM_ /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      '1101367=  ERR_CODE INTEGER,'
      '1101368=  ERR_MSG VARCHAR(1024))'
      '1101369=AS'
      '11013610=BEGIN'
      '11013611=  SUSPEND;'
      '11013612=END'
      '11013613=;'
      '11013614='
      '11013615='
      
        '11013616=/******************************************************' +
        '************************/'
      
        '11013617=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11013618=/******************************************************' +
        '************************/'
      '11013619=ALTER PROCEDURE P_REP_AVERAGE_BILL('
      '11013620=  DATE_BEGIN_ DATE,'
      '11013621=  DATE_END_ DATE,'
      '11013622=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11013623=RETURNS ('
      '11013624=  CNT_ INTEGER,'
      '11013625=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '11013626=  ERR_CODE INTEGER,'
      '11013627=  ERR_MSG VARCHAR(1024))'
      '11013628=AS'
      
        '11013629=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_AVERAGE_' +
        'BILL'#39';'
      '11013630=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11013631=BEGIN'
      '11013632=  SUMM_ = 0;'
      '11013633='
      '11013634=  SELECT COUNT(*)'
      '11013635=    FROM ZAKAZ ZZ'
      '11013636=   WHERE ZZ.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11013637=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOCHKA||'#39'-' +
        #39
      '11013638=    INTO :CNT_;'
      '11013639='
      '11013640=  SELECT ROUND(SUM(Z.SUMM) / :CNT_, 2)'
      '11013641=    FROM ZAKAZ Z'
      '11013642=   WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11013643=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '11013644=    INTO :SUMM_;'
      '11013645='
      '11013646=  /*FOR'
      '11013647=  SELECT :SUMM_'
      '11013648=    FROM RDB$DATABASE R'
      '11013649=    INTO :SUMM_'
      '11013650=  DO'
      '11013651=    SUSPEND; */'
      '11013652='
      '11013653=WHEN ANY DO BEGIN'
      '11013654=    Err_code = -20500;'
      
        '11013655=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' "'#1057#1056#1045#1044#1053#1048#1049' '#1063#1045#1050'"!'#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      
        '11013656=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11013657=  END'
      '11013658=end'
      '11013659=;'
      
        '11013660=UPDATE SYSTEM_SETUP SET S_VALUE = 110136 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
