      '11068590=  POLUCHATEL_ VARCHAR(1000),'
      '11068591=  POLUCHATEL_ADDRESS_ VARCHAR(1000),'
      '11068592=  POLUCHATEL_IIK_ VARCHAR(1000),'
      '11068593=  RUKOVODITEL_ VARCHAR(1000),'
      '11068594=  GLAVBUH_ VARCHAR(1000),'
      '11068595=  ISPOLNITEL_APP_ VARCHAR(1000),'
      '11068596=  ISPOLNITEL_ VARCHAR(1000),'
      '11068597=  NUM_W_ VARCHAR(20),'
      '11068598=  DATE_ VARCHAR(20),'
      '11068599=  IDN_KPP_POST_ VARCHAR(30),'
      '11068600=  IDN_KPP_POLUCH_ VARCHAR(30),'
      '11068601=  CURR_STR_ VARCHAR(15),'
      '11068602=  ROW_NUM VARCHAR(10),'
      '11068603=  NAME VARCHAR(1000),'
      '11068604=  SHORT_NAME VARCHAR(1000),'
      
        '11068605=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11068606=  KOD_TNVD /* TYPE OF COLUMN G_PRODUCT.KOD_TNVD */ VARC' +
        'HAR(50),'
      '11068607=  AMOUNT /* MY_NUMERIC_5 */ NUMERIC(18,5),'
      '11068608=  PRICE VARCHAR(500),'
      '11068609=  WITHOUT_NDS VARCHAR(500),'
      '11068610=  NDS VARCHAR(500),'
      '11068611=  NDS_SUMM VARCHAR(500),'
      '11068612=  SUMM VARCHAR(500),'
      '11068613=  STOIM_TOVAROV_ VARCHAR(500),'
      '11068614=  SUMM_NDS_ VARCHAR(500),'
      '11068615=  SUMM_VSEGO_ VARCHAR(500),'
      '11068616=  ERR_CODE INTEGER,'
      '11068617=  ERR_MSG VARCHAR(1024))'
      '11068618=AS'
      '11068619=BEGIN'
      '11068620=  SUSPEND;'
      '11068621=END'
      '11068622=;'
      '11068623='
      '11068624='
      
        '11068625=/******************************************************' +
        '************************/'
      
        '11068626=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11068627=/******************************************************' +
        '************************/'
      '11068628=ALTER PROCEDURE FILL_FIRST_DATA('
      '11068629=  PRODUCTY_ INTEGER = 0,'
      '11068630=  HIM_ INTEGER = 0,'
      '11068631=  APTEKA_ INTEGER = 0)'
      '11068632=AS'
      '11068633=BEGIN'
      '11068634=  IF (PRODUCTY_ = 1 OR HIM_ = 1) THEN BEGIN'
      '11068635=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068636=      VALUES (2, '#39#1073#1091#1090'.'#39', '#39#1073#1091#1090'.'#39');'
      '11068637=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068638=      VALUES (3, '#39#1082#1075#39', '#39#1082#1075#39');'
      '11068639=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068640=      VALUES (4, '#39#1096#1080#39', '#39#1096#1080#39');'
      '11068641=  END'
      '11068642='
      '11068643=  IF (APTEKA_ = 1) THEN BEGIN'
      '11068644=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068645=      VALUES (18, '#39#1091#1087#1072#1082#39', '#39#1091#1087#1072#1082#39');'
      '11068646=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068647=      VALUES (19, '#39#1092#1083#1072#1082#39', '#39#1092#1083#1072#1082#39');'
      '11068648=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068649=      VALUES (20, '#39#1087#1086#1076#1075#1091#1079'..'#39', '#39#1087#1086#1076#1075#1091#1079'..'#39');'
      '11068650=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068651=      VALUES (21, '#39#1064#1058#39', '#39#1064#1058#39');'
      '11068652=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068653=      VALUES (22, '#39#1055#1051#1040#1057#1058'.'#39', '#39#1055#1051#1040#1057#1058'.'#39');'
      '11068654=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068655=      VALUES (23, '#39#1087#1072#1082'.'#39', '#39#1087#1072#1082'.'#39');'
      '11068656=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068657=      VALUES (24, '#39#1090#1072#1073'.'#39', '#39#1090#1072#1073'.'#39');'
      '11068658=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068659=      VALUES (25, '#39#1072#1084#1087'.'#39', '#39#1072#1084#1087'.'#39');'
      '11068660=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068661=      VALUES (26, '#39#1087#1083#1072#1089#1090'.'#39', '#39#1087#1083#1072#1089#1090'.'#39');'
      '11068662=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068663=      VALUES (27, '#39#1082#1086#1088'.'#39', '#39#1082#1086#1088'.'#39');'
      '11068664=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068665=      VALUES (28, '#39#1087#1072#1082#39', '#39#1087#1072#1082#39');'
      '11068666=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068667=      VALUES (29, '#39#1090#1091#1073#1072#39', '#39#1090#1091#1073#1072#39');'
      '11068668=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068669=      VALUES (30, '#39#1087#1072#1088#39', '#39#1087#1072#1088#39');'
      '11068670=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068671=      VALUES (31, '#39#1090#1085#1075#39', '#39#1090#1085#1075#39');'
      '11068672=    INSERT INTO G_UNIT (G_UNIT, NAME, SHORT_NAME)'
      '11068673=      VALUES (32, '#39#1089#1072#1083#1092#1077#1090'.'#39', '#39#1089#1072#1083#1092#1077#1090'.'#39');'
      '11068674=  END'
      '11068675='
      '11068676=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_UNIT TO 35'#39';'
      '11068677='
      '11068678=  IF (PRODUCTY_ = 1) THEN'
      
        '11068679=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE,'
      
        '11068680=                           VOLUME_PRICE, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLA' +
        'CE,'
      '11068681=                           SALES_COMM)'
      
        '11068682=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLAT' +
        'UR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '11068683=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, IS' +
        '_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM'
      '11068684=      FROM G_PRODUCT_FILL T'
      '11068685=     WHERE T.G_PRODUCT BETWEEN 22080 AND 36644'
      '11068686=    ORDER BY 1;'
      '11068687='
      '11068688=  IF (HIM_ = 1) THEN'
      
        '11068689=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE,'
      
        '11068690=                           VOLUME_PRICE, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLA' +
        'CE,'
      '11068691=                           SALES_COMM)'
      
        '11068692=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLAT' +
        'UR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '11068693=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, IS' +
        '_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM'
      '11068694=      FROM G_PRODUCT_FILL T'
      '11068695=     WHERE T.G_PRODUCT BETWEEN 36645 AND 39663'
      '11068696=    ORDER BY 1;'
      '11068697='
      '11068698=  IF (APTEKA_ = 1) THEN'
      
        '11068699=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, AR' +
        'TICUL, NOMENCLATUR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE,'
      
        '11068700=                           VOLUME_PRICE, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, IS_ACTIVE, IS_CATEGORY, IS_KIT, MIN_AMOUNT, PLA' +
        'CE,'
      '11068701=                           SALES_COMM)'
      
        '11068702=    SELECT G_PRODUCT, G_PRODUCT_PAR, ARTICUL, NOMENCLAT' +
        'UR_NUM, BARCODE, CROSSCODE, NAME, G_UNIT, PRICE, VOLUME_PRICE,'
      
        '11068703=           PACK_AMOUNT, MF_COUNTRY, NOTE, IS_ACTIVE, IS' +
        '_CATEGORY, IS_KIT, MIN_AMOUNT, PLACE, SALES_COMM'
      '11068704=      FROM G_PRODUCT_FILL T'
      '11068705=     WHERE T.G_PRODUCT BETWEEN 53051 AND 64823'
      '11068706=    ORDER BY 1;'
      '11068707='
      
        '11068708=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_G_PRODUCT TO 649' +
        '00'#39';'
      
        '11068709=  EXECUTE STATEMENT '#39'SET GENERATOR GEN_ARTICUL TO 29045' +
        #39';'
      '11068710=END'
      '11068711=;'
      '11068712='
      '11068713=ALTER PROCEDURE G_GET_G_OFFICIAL('
      '11068714=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '11068715=RETURNS ('
      '11068716=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '11068717=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '11068718=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '11068719=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11068720=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '11068721=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '11068722=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '11068723=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '11068724=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '11068725=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '11068726=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '11068727=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTMEN' +
        'T,'
      
        '11068728=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVODI' +
        'TEL,'
      '11068729=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '11068730=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNITE' +
        'L,'
      '11068731=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '11068732=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11068733=  RIGHTS_ARR_ VARCHAR(1000),'
      
        '11068734=  DO_NOT_SALES_COMM_ TYPE OF COLUMN G_OFFICIAL.DO_NOT_S' +
        'ALES_COMM,'
      '11068735=  KOD_ TYPE OF COLUMN G_OFFICIAL.KOD,'
      '11068736=  ERR_CODE INTEGER,'
      '11068737=  ERR_MSG VARCHAR(1024))'
      '11068738=AS'
      
        '11068739=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_ITE' +
        'M.RIGHTS_ITEM;'
      '11068740=begin'
      
        '11068741=    select FM, NM, FT, FIO_DOC, RNN, IDN, DT, G_ID_KIND' +
        ', ID_NUM, ID_DATE, ID_ISSUER, G_APPOINTMENT,'
      
        '11068742=           IS_RUKOVODITEL, IS_GLAVBUH, IS_ISPOLNITEL, P' +
        'ASS, G_TOCHKA, DO_NOT_SALES_COMM, KOD'
      '11068743=    from G_OFFICIAL'
      '11068744=    where G_OFFICIAL = :G_OFFICIAL_'
      
        '11068745=    into :FM_, :NM_, :FT_, :FIO_DOC_, :RNN_, :IDN_, :DT' +
        '_, :G_ID_KIND_, :ID_NUM_, :ID_DATE_, :ID_ISSUER_, :G_APPOINTMENT' +
        '_,'
      
        '11068746=         :IS_RUKOVODITEL_, :IS_GLAVBUH_, :IS_ISPOLNITEL' +
        '_, :PASSWORD_, :G_TOCHKA_, :DO_NOT_SALES_COMM_, :KOD_;'
      '11068747='
      '11068748=    -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1052#1040#1057#1057#1048#1042' '#1055#1056#1040#1042
      '11068749=    FOR SELECT RIGHTS_ITEM'
      '11068750=        FROM G_OFFICIAL_RIGHT'
      '11068751=       WHERE G_OFFICIAL = :G_OFFICIAL_'
      '11068752=        INTO :RIGHTS_ITEM_'
      '11068753=    DO BEGIN'
      '11068754=      if (RIGHTS_ARR_ IS NULL) then'
      
        '11068755=        RIGHTS_ARR_ = '#39'-'#39'||CAST(RIGHTS_ITEM_ AS VARCHAR' +
        '(5))||'#39'-'#39';'
      '11068756=      ELSE'
      
        '11068757=        RIGHTS_ARR_ = RIGHTS_ARR_||CAST(RIGHTS_ITEM_ AS' +
        ' VARCHAR(5))||'#39'-'#39';'
      '11068758=    END'
      '11068759=end'
      '11068760=;'
      '11068761='
      '11068762=ALTER PROCEDURE G_GET_G_PRODUCT('
      '11068763=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '11068764=RETURNS ('
      
        '11068765=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11068766=  ARTICUL_ VARCHAR(30),'
      '11068767=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '11068768=  BARCODE_ VARCHAR(30),'
      '11068769=  NAME_ VARCHAR(500),'
      '11068770=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '11068771=  PRICE_ NUMERIC(15,2),'
      '11068772=  VOLUME_PRICE_ NUMERIC(15,2),'
      '11068773=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11068774=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11068775=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11068776=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11068777=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '11068778=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11068779=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11068780=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11068781=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11068782=  ERR_CODE INTEGER,'
      '11068783=  ERR_MSG VARCHAR(1024))'
      '11068784=AS'
      '11068785=begin'
      '11068786=    SELECT'
      '11068787=        G_PRODUCT_PAR,'
      '11068788=        ARTICUL,'
      '11068789=        NOMENCLATUR_NUM,'
      '11068790=        BARCODE,'
      '11068791=        NAME,'
      '11068792=        G_UNIT,'
      '11068793=        PRICE,'
      '11068794=        VOLUME_PRICE,'
      '11068795=        PACK_AMOUNT,'
      '11068796=        MF_COUNTRY,'
      '11068797=        NOTE,'
      '11068798=        CROSSCODE,'
      '11068799=        IS_KIT,'
      '11068800=        MIN_AMOUNT,'
      '11068801=        PLACE,'
      '11068802=        SALES_COMM,'
      '11068803=        KOD_TNVD'
      '11068804=    FROM G_PRODUCT T'
      '11068805=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11068806=    INTO'
      '11068807=        :G_PRODUCT_PAR_,'
      '11068808=        :ARTICUL_,'
      '11068809=        :NOMENCLATUR_NUM_,'
      '11068810=        :BARCODE_,'
      '11068811=        :NAME_,'
      '11068812=        :G_UNIT_,'
      '11068813=        :PRICE_,'
      '11068814=        :VOLUME_PRICE_,'
      '11068815=        :PACK_AMOUNT_,'
      '11068816=        :MF_COUNTRY_,'
      '11068817=        :NOTE_,'
      '11068818=        :CROSSCODE_,'
      '11068819=        :IS_KIT_,'
      '11068820=        :MIN_AMOUNT_,'
      '11068821=        :PLACE_,'
      '11068822=        :SALES_COMM_,'
      '11068823=        :KOD_TNVD_;'
      '11068824='
      '11068825=    INSERT INTO LT_BARCODE_TMP'
      
        '11068826=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARCO' +
        'DE WHERE G_PRODUCT = :G_PRODUCT_;'
      '11068827='
      '11068828=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '11068829=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G_' +
        'PRODUCT_;'
      '11068830='
      '11068831=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '11068832=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '11068833=end'
      '11068834=;'
      '11068835='
      '11068836=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '11068837=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11068838=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11068839=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '11068840=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11068841=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11068842=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '11068843=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11068844=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11068845=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11068846=  SELF_PRICE_ NUMERIC(15,2),'
      '11068847=  AMOUNT_ MY_NUMERIC_5,'
      '11068848=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11068849=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11068850=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11068851=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11068852=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11068853=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11068854=  IS_THIS_LAST_ INTEGER,'
      '11068855=  UPDATE_IF_EXIST_ INTEGER)'
      '11068856=RETURNS ('
      '11068857=  ERR_CODE INTEGER,'
      '11068858=  ERR_MSG VARCHAR(1024))'
      '11068859=AS'
      
        '11068860=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11068861=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11068862=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '11068863=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11068864=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11068865=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11068866=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11068867=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11068868=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11068869=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11068870=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11068871=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11068872=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11068873=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11068874=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11068875=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11068876=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11068877=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11068878=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11068879=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11068880=BEGIN'
      '11068881=    ERR_MSG = '#39#39';'
      '11068882='
      '11068883=    SELECT ID'
      '11068884=      FROM CUR_PARAMS'
      '11068885=    WHERE CUR_PARAMS = 2'
      '11068886=      INTO :G_TOCHKA_;'
      '11068887='
      '11068888=    SELECT G.G_UNIT'
      '11068889=      FROM G_UNIT G'
      
        '11068890=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11068891=      INTO :G_UNIT_;'
      '11068892=    if (ROW_COUNT = 0) then'
      '11068893=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11068894='
      '11068895=    PNT_ = '#39'02'#39';'
      
        '11068896=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11068897=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
