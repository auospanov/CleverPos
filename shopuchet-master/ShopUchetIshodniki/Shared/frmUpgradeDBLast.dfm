      '110606177=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '110606178=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110606179=RETURNS ('
      '110606180=  ERR_CODE INTEGER,'
      '110606181=  ERR_MSG VARCHAR(1024))'
      '110606182=AS'
      '110606183=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '110606184=DECLARE VARIABLE CNT_ INTEGER;'
      '110606185=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '110606186=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110606187=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '110606188=BEGIN'
      '110606189=  PROCNAME = '#39'G_DEL_G_PRODUCT'#39';'
      '110606190='
      '110606191=  SELECT COUNT(*)'
      '110606192=    FROM G_PRODUCT'
      '110606193=   WHERE G_PRODUCT_PAR = :G_PRODUCT_'
      '110606194=    into :CNT_;'
      '110606195=  IF (CNT_ > 0) then BEGIN'
      '110606196=    ERR_CODE = -20500;'
      
        '110606197=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076 +
        #1072#1083#1080#1090#1100' '#1076#1072#1085#1085#1091#1102' '#1075#1088#1091#1087#1087#1091', '#1090'.'#1082'. '#1074' '#1085#1077#1081' '#1089#1086#1089#1090#1086#1103#1090' '#1090#1086#1074#1072#1088#1099'/'#1075#1088#1091#1087#1087#1099'. '#1059#1076#1072#1083#1080#1090#1077' '#1074 +
        #1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110606198=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110606199=    EXIT;'
      '110606200=  END'
      '110606201='
      '110606202='
      
        '110606203=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', '#39 +
        ')'
      '110606204=                    FROM g_product_kit K, g_product g'
      
        '110606205=                   WHERE K.g_product_item = :G_PRODUCT' +
        '_'
      
        '110606206=                     and k.g_product = g.g_product) FR' +
        'OM 1 FOR 999)'
      '110606207=  FROM RDB$DATABASE'
      '110606208=   INTO :PROD_NAME_;'
      '110606209=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '110606210=    ERR_CODE = -20500;'
      
        '110606211=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083#1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'. '#1059#1076#1072#1083#1080#1090 +
        #1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110606212=                                  '#39#1044#1083#1103' '#1091#1076#1072#1083#1077#1085#1080#1103' '#1091#1073#1077#1088#1080#1090 +
        #1077' '#1077#1075#1086' '#1080#1079' '#1089#1086#1089#1090#1072#1074#1072' '#1090#1086#1074#1072#1088#1072'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110606213=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110606214=    EXIT;'
      '110606215=  END'
      '110606216='
      
        '110606217=  SELECT ZA.zakaz||'#39' '#1086#1090' '#39'||lpad(extract(day from ZA.Z_' +
        'DATE),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from ZA.Z_DATE),2,'#39'0'#39')' +
        ' || '#39'.'#39' || extract(year from ZA.Z_DATE)'
      '110606218=    FROM ZAKAZ ZA'
      '110606219=   WHERE ZA.zakaz = (SELECT MIN(Z.ZAKAZ)'
      '110606220=                        FROM ZAKAZ_DETAILS Z'
      
        '110606221=                       WHERE Z.G_PRODUCT = :G_PRODUCT_' +
        ')'
      '110606222=  INTO :NAKL_PROD_;'
      '110606223=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110606224=    ERR_CODE = -20500;'
      
        '110606225=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1091#1093#1086#1076#1072' ('#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110606226='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        #39'||'#39
      
        '110606227='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110606228=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110606229=    EXIT;'
      '110606230=  END'
      '110606231='
      
        '110606232=  SELECT SP.sklad||'#39' '#1086#1090' '#39'||lpad(extract(day from SP.da' +
        'te_receipt),2,'#39'0'#39') || '#39'.'#39' || lpad(extract(month from SP.date_rec' +
        'eipt),2,'#39'0'#39') || '#39'.'#39' || extract(year from SP.date_receipt)'
      '110606233=    FROM sklad_parent SP'
      '110606234=   WHERE SP.sklad = ( SELECT MIN(S.sklad_parent)'
      '110606235=                        FROM sklad s'
      
        '110606236=                       WHERE s.G_PRODUCT = :G_PRODUCT_' +
        ')'
      '110606237=    INTO :NAKL_PROD_;'
      '110606238=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110606239=    ERR_CODE = -20500;'
      
        '110606240=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1086#1087#1077#1088#1072#1094#1080#1103#1093' '#1087#1088#1080#1093#1086#1076#1072' ('#1086#1087#1088#1080#1093#1086#1076#1086#1074#1072#1085#1080#1077'/'#1074#1086#1079#1074#1088#1072#1090'/'#1087#1077#1088#1077#1084 +
        #1077#1097#1077#1085#1080#1077' '#1080' '#1076#1088'.).'
      
        '110606241='#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||NAKL_PROD_||'#39'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'.' +
        ' '#39'||'#39
      
        '110606242='#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078 +
        #1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110606243=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110606244=    EXIT;'
      '110606245=  END'
      '110606246='
      
        '110606247=  SELECT lpad(extract(day from MIN(za.op_date)),2,'#39'0'#39')' +
        ' || '#39'.'#39' || lpad(extract(month from MIN(za.op_date)),2,'#39'0'#39') || '#39'.' +
        #39' || extract(year from MIN(za.op_date))'
      '110606248=    FROM OTHER ZA, OTHER_DETAILS Z'
      '110606249=   WHERE ZA.OTHER = Z.other'
      '110606250=     AND Z.G_PRODUCT = :G_PRODUCT_'
      '110606251=  INTO :NAKL_PROD_;'
      '110606252=  if (NAKL_PROD_ IS NOT NULL) then BEGIN'
      '110606253=    ERR_CODE = -20500;'
      
        '110606254=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1044#1072#1085#1085#1099#1081' '#1090#1086 +
        #1074#1072#1088' '#1091#1095#1072#1074#1089#1090#1074#1086#1074#1072#1083' '#1074' '#1087#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1077' '#1090#1086#1074#1072#1088#1072' '#1086#1090' '#39'||NAKL_PROD_||'#39' '#1095#1080#1089#1083#1072'.' +
        ' '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'. '#39'||'
      
        '110606255=                                  '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076#1077#1083#1072#1090 +
        #1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081#1089'-'#1083#1080 +
        #1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110606256=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110606257=    EXIT;'
      '110606258=  END'
      '110606259='
      '110606260=  delete from LT_SKLAD_PRODUCT g'
      '110606261=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110606262='
      '110606263=  delete from lt_barcode g'
      '110606264=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110606265='
      '110606266=  delete from revision g'
      '110606267=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110606268='
      '110606269=  delete from g_product_image g'
      '110606270=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110606271='
      '110606272=  delete from g_product_KIT g'
      '110606273=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110606274='
      '110606275=  delete from G_PRODUCT g'
      '110606276=    where g.G_PRODUCT = :G_PRODUCT_;'
      '110606277='
      '110606278=when sqlcode -530 DO'
      '110606279=  begin'
      '110606280=    SELECT G.IS_CATEGORY'
      '110606281=      FROM G_PRODUCT G'
      '110606282=     WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110606283=      INTO :IS_CATEGORY_;'
      '110606284='
      '110606285=    ERR_CODE = -20500;'
      '110606286=    if (IS_CATEGORY_ = 0) then'
      
        '110606287=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1100' '#1090#1086#1074#1072#1088' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'! '#39'||'
      
        '110606288=                                      '#39#1053#1086' '#1042#1099' '#1084#1086#1078#1077#1090#1077' '#1089#1076 +
        #1077#1083#1072#1090#1100' '#1077#1075#1086' '#1053#1045#1040#1050#1058#1048#1042#1053#1067#1052', '#1095#1090#1086#1073#1099' '#1086#1085' '#1085#1077' '#1086#1090#1088#1072#1078#1072#1083#1089#1103' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077' '#1080' '#1087#1088#1072#1081 +
        #1089'-'#1083#1080#1089#1090#1077'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110606289=    ELSE'
      
        '110606290=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085 +
        #1085#1086#1081' '#1082#1072#1090#1077#1075#1086#1088#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'! '#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110606291=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110606292=  end'
      '110606293=end'
      '110606294=;'
      '110606295='
      '110606296=ALTER PROCEDURE G_GET_G_ACCOUNT('
      '110606297=  G_ACCOUNT_ TYPE OF COLUMN G_ACCOUNT.G_ACCOUNT)'
      '110606298=RETURNS ('
      '110606299=  ACCOUNT_ TYPE OF COLUMN G_ACCOUNT.ACCOUNT,'
      '110606300=  G_CLIENT_ TYPE OF COLUMN G_ACCOUNT.G_CLIENT,'
      '110606301=  G_BANK_ TYPE OF COLUMN G_ACCOUNT.G_BANK,'
      '110606302=  IS_DEFAULT_ TYPE OF COLUMN G_ACCOUNT.IS_DEFAULT,'
      '110606303=  ERR_CODE INTEGER,'
      '110606304=  ERR_MSG VARCHAR(1024))'
      '110606305=AS'
      '110606306=begin'
      '110606307=    select ACCOUNT, G_CLIENT, G_BANK, IS_DEFAULT'
      '110606308=    from G_ACCOUNT'
      '110606309=    WHERE G_ACCOUNT = :G_ACCOUNT_'
      
        '110606310=    into :ACCOUNT_, :G_CLIENT_, :G_BANK_, :IS_DEFAULT_' +
        ';'
      '110606311=end'
      '110606312=;'
      '110606313='
      '110606314=ALTER PROCEDURE G_GET_G_ADDRESS('
