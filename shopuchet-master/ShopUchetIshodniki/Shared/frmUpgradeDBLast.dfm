        '110233601=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, :V_SUMM_, 0, :REC_SUM_COST_, :REC_profit_, 0);'
      '110233602='
      '110233603=    SUM_COST_ = SUM_COST_  + REC_SUM_COST_;'
      '110233604=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '110233605=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110233606=  END'
      '110233607='
      '110233608=  IF (SUM_ZAKAZ_ <> 0) then BEGIN'
