        'MM_FACT;'
      
        '1101823516=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '1101823517=DECLARE VARIABLE CNT_ INTEGER;'
      '1101823518=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '1101823519=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      
        '1101823520=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101823521=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
