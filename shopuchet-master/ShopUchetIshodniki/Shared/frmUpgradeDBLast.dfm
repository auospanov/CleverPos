        'CHKA||'#39'-'#39
      '1102251749=              AND ZAKAZ IS NULL'
      '1102251750=           union all'
      
        '1102251751=           select SKLAD, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1102251752=             from kassa_beznal'
      
        '1102251753=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1102251754=              AND ZAKAZ IS NULL) K'
      '1102251755=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1102251756=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251757=       AND K.SKLAD = S.SKLAD'
      '1102251758=       AND K.ACTION_DATE <= :DATE_END_'
      '1102251759=       AND K.G_PRIHOD_RASHOD = 3'
      '1102251760=    GROUP BY S.G_CLIENT'
      '1102251761=      INTO :SUMM_OUT_DEBET_;'
      '1102251762='
      
        '1102251763=    -- 12.12.2021 '#1055#1054' '#1042#1054#1047#1042#1056#1040#1058#1040#1052' '#1053#1045' '#1047#1053#1040#1070' '#1050#1040#1050' '#1057#1044#1045#1051#1040#1058#1068' '#1056#1040 +
        #1047#1041#1048#1042#1050#1059' '#1055#1054' '#1050#1054#1052#1055#1040#1053#1048#1071#1052
      
        '1102251764=    SELECT :SUMM_OUT_CREDIT_ + SUM(S.SUMM)           ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1102251765=      FROM SKLAD_PARENT S'
      '1102251766=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1102251767=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '1102251768=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1102251769=    GROUP BY S.G_CLIENT'
      '1102251770=      INTO :SUMM_OUT_CREDIT_;'
      '1102251771='
      '1102251772=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '1102251773=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1102251774=    -------------------------'
      '1102251775='
      '1102251776=    IF (COALESCE(SUMM_IN_, 0) > 0) then'
      '1102251777=      DEBET_IN_ = SUMM_IN_;'
      '1102251778=    ELSE'
      '1102251779=      CREDIT_IN_ = SUMM_IN_;'
      '1102251780='
      '1102251781=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '1102251782=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '1102251783='
      '1102251784=    if (COALESCE(SUMM_OUT_, 0) > 0) then'
      '1102251785=      DEBET_OUT_ = SUMM_OUT_;'
      '1102251786=    ELSE'
      '1102251787=      CREDIT_OUT_ = ABS(SUMM_OUT_);'
      '1102251788='
      '1102251789=    --------------------'
      '1102251790=    -- '#1047#1040#1044#1054#1051#1046#1045#1053#1053#1054#1057#1058#1068
      '1102251791=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '1102251792=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '1102251793='
      '1102251794=        if (DEBET_OUT_ > 0) then'
      
        '1102251795=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE' +
        '(CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1102251796=        else'
      
        '1102251797=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLA' +
        'CE(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1102251798=    end else'
      '1102251799=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '1102251800='
      '1102251801=    FOR -- '#1055#1054' '#1057#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1053#1067#1052' '#1057#1060
      '1102251802=        SELECT 1 ROW,'
      
        '1102251803=               '#39#1055#1088#1086#1076#1072#1078#1072', '#1085#1072#1082#1083#1072#1076#1085#1072#1103' '#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39 +
        '||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MO' +
        'NTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE) st' +
        'r,'
      '1102251804=               Z.ZAKAZ ID,'
      '1102251805=               Z.Z_DATE OPER_DATE,'
      '1102251806=               Z.SUMM SUMM_DEBET,'
      '1102251807=               NULL SUMM_CREDIT,'
      '1102251808=               Z.Z_DATE SORT_ROW'
      '1102251809=          FROM ZAKAZ Z, INVOICE I'
      '1102251810=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '1102251811=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
