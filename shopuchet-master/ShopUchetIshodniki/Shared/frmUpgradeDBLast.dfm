      '1104037=END'
      '1104038='#39';'
      '1104039='
      '1104040=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SKLAD('
      
        '1104041=  SKLAD_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */ INTEGER' +
        ','
      '1104042=  MODE_ INTEGER)'
      '1104043=RETURNS ('
      
        '1104044=  G_PROD_NAME_ /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCH' +
        'AR(250),'
      
        '1104045=  DATE_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.DATE_RECE' +
        'IPT */ DATE,'
      
        '1104046=  TIME_RECEIPT_ /* TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT */ TIME,'
      
        '1104047=  G_CLIENT_ /* TYPE OF COLUMN SKLAD_PARENT.G_CLIENT */ I' +
        'NTEGER,'
      
        '1104048=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN SKLAD_PARENT.G_PAYME' +
        'NT_TYPE */ INTEGER,'
      
        '1104049=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE */' +
        ' VARCHAR(150),'
      
        '1104050=  NOTE_ /* TYPE OF COLUMN SKLAD_PARENT.NOTE */ VARCHAR(2' +
        '00),'
      
        '1104051=  SUMM_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(1' +
        '5,2),'
      
        '1104052=  SUMM_FACT_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT */' +
        ' NUMERIC(15,2),'
      
        '1104053=  SUMM_CURRENCY_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY */ NUMERIC(15,2),'
      
        '1104054=  IS_PAYED_ALL_ /* TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_' +
        'ALL */ INTEGER,'
      '1104055=  CNT_T_ INTEGER,'
      
        '1104056=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD */ INTEGER,'
      
        '1104057=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(1' +
        '5,2),'
      '1104058=  HAVERIGHT_ INTEGER,'
      '1104059=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1104060=  ERR_CODE INTEGER,'
