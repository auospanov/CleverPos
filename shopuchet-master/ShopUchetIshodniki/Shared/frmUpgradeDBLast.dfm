      '1101852650='
      
        '1101852651=            --=======================================' +
        '=========================='
      '1101852652=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101852653=            --=======================================' +
        '=========================='
      '1101852654=            PNT_ = '#39'12'#39';'
      
        '1101852655=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1101852656=                KASSA_ZP_ID_ = NULL;'
      '1101852657='
      '1101852658=                SELECT S.S_VALUE'
      '1101852659=                  FROM SYSTEM_SETUP S'
      '1101852660=                 WHERE S.SYSTEM_SETUP = 4'
      '1101852661=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101852662='
      '1101852663=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101852664=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101852665=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101852666='
      
        '1101852667=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101852668=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1101852669=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1101852670='
      '1101852671=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101852672=                ELSE'
      
        '1101852673=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1101852674='
      '1101852675=                SELECT K.KASSA, K.SUMM'
      '1101852676=                FROM KASSA K'
      '1101852677=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1101852678=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101852679=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101852680=                 AND K.G_TOCHKA = :G_TOCHKA_'
      
        '1101852681=                 INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM' +
        '_ITER_;'
      '1101852682='
      
        '1101852683=                LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090 +
        ' "'#39' || EXTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month' +
        ' FROM ACTION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_' +
        ') || '#39'"'#39';'
      '1101852684='
      '1101852685=                IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1101852686=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101852687=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101852688=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101852689=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101852690=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1101852691=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1101852692=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1101852693=                                                  1,'
      
        '1101852694=                                                  :G_' +
        'TOCHKA_,'
      
        '1101852695=                                                  :G_' +
        'OFFICIAL_) RETURNING_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG)' +
        ';'
      '1101852696=                    LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101852697=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES' +
        '_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101852698='
      '1101852699=                END ELSE BEGIN'
      
        '1101852700=                    SALES_COMM_SUMM_ALL_ = SALES_COMM' +
        '_SUMM_ITER_ + SALES_COMM_SUMM_ALL_ - SALES_COMM_OLD_;'
      '1101852701=                    LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101852702=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' ' +
        '"'#39' || SALES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101852703=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39' '#1085#1072' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101852704='
      
        '1101852705=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_ZP_ID_,'
      
        '1101852706=                                                  1, ' +
        '    -- ACTION_'
      
        '1101852707=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101852708=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101852709=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101852710=                                                  :OF' +
        'FICIAL_NAME_,   --NOTE_'
      
        '1101852711=                                                  NUL' +
        'L,'
      
        '1101852712=                                                  NUL' +
        'L,'
      
        '1101852713=                                                  1, ' +
        '  --:PAYMENT_TYPE_,'
      
        '1101852714=                                                  :G_' +
        'OFFICIAL_'
      
        '1101852715=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101852716=                END'
      '1101852717=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101852718=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101852719=                  EXIT;'
      '1101852720=                END'
      '1101852721=            END'
      
        '1101852722=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1101852723=            --=======================================' +
        '=========================='
      '1101852724='
      '1101852725=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1101852726='
      '1101852727=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101852728=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101852729=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101852730=        SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 2'
      '1101852731=          FROM RDB$DATABASE'
      
        '1101852732=         WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP' +
        ' AP WHERE AP.OBJECT_TYPE = 1 AND AP.ID = :ZAKAZ_ AND AP.IS_LOADI' +
        'NG = 0);'
      '1101852733=  END'
      '1101852734=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1101852735=  ---------------------------------------------------' +
        '------------'
      
        '1101852736=  --*************************************************' +
        '************'
      
        '1101852737=  ---------------------------------------------------' +
        '------------'
      '1101852738=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101852739=  ELSE BEGIN'
      '1101852740=      PNT_ = '#39'020'#39';'
      '1101852741=      SELECT SP.G_TOCHKA,'
      '1101852742=             SP.G_CLIENT,'
      '1101852743=             SP.IS_EXPECTED'
      '1101852744=        FROM SKLAD_PARENT SP'
      '1101852745=       WHERE SP.SKLAD = :ZAKAZ_'
      '1101852746=        INTO :G_TOCHKA_OLD_,'
      '1101852747=             :G_TOCHKA_,'
      '1101852748=             :IS_EXPECTED_OLD_;'
      '1101852749='
      
        '1101852750=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101852751=      PNT_ = '#39'021'#39';'
      '1101852752=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '1101852753=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' NULL, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '1101852754=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101852755=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101852756=            EXIT;'
      '1101852757=          END'
      '1101852758='
      '1101852759=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101852760=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101852761=                FROM ZAKAZ_DETAILS_TMP Z'
      '1101852762=              INTO :G_PRODUCT_,'
      '1101852763=                  :Z_AMOUNT_,'
      '1101852764=                  :PRICE_,'
      '1101852765=                  :SUMMM_'
      '1101852766=          DO BEGIN'
      '1101852767=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101852768=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1101852769=            IS_THIS_LAST_ = 0;'
      '1101852770=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101852771=                FROM SKLAD SK'
      '1101852772=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101852773=                 AND SK.IS_LAST = 1'
      '1101852774=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1101852775=                INTO :DATE_LAST_;'
      '1101852776='
      
        '1101852777=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101852778=                UPDATE SKLAD SK'
      '1101852779=                   SET SK.IS_LAST = 0'
      '1101852780=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101852781=                   AND SK.IS_LAST = 1'
      '1101852782=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101852783='
      '1101852784=                IS_THIS_LAST_ = 1;'
      '1101852785=            END'
      '1101852786='
      '1101852787='
      '1101852788=            INSERT INTO SKLAD'
      '1101852789=            ('
      '1101852790=             SKLAD,'
      '1101852791=             SKLAD_PARENT,'
      '1101852792=             DATE_RECEIPT,'
      '1101852793=             G_CLIENT,'
      '1101852794=             G_PRODUCT,'
      '1101852795=             AMOUNT,'
      '1101852796=             PRICE,'
      '1101852797=             SUMM,'
      '1101852798=             G_PAYMENT_TYPE,'
      '1101852799=             OSNOVANIE,'
      '1101852800=             NOTE,'
      '1101852801=             NDS,'
      '1101852802=             NDS_SUMM,'
      '1101852803=             IS_LAST,'
      '1101852804=             IS_VOZVRAT,'
      '1101852805=             G_TOCHKA'
      '1101852806=            ) VALUES ('
      '1101852807=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101852808=             :ZAKAZ_,'
      '1101852809=             :Z_DATE_,'
      '1101852810=             :G_TOCHKA_,'
      '1101852811=             :G_PRODUCT_,'
      '1101852812=             :Z_AMOUNT_,'
      '1101852813=             :PRICE_,'
      '1101852814=             :SUMMM_,'
      '1101852815=             :G_PAYMENT_TYPE_,'
      '1101852816=             :OSNOVANIE_,'
      '1101852817=             :NOTE_,'
      '1101852818=             0,  --:RNDS_,'
      '1101852819=             0,  --:RNDS_SUMM_,'
      
        '1101852820=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1101852821=             3,  --:IS_VOZVRAT_,'
      '1101852822=             :G_CLIENT_'
      '1101852823=            );'
      '1101852824='
      
        '1101852825=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1101852826=            UPDATE LT_SKLAD_PRODUCT L'
      '1101852827=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_,'
      
        '1101852828=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101852829=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101852830=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101852831='
      
        '1101852832=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101852833=            PNT_ = '#39'023'#39';'
      '1101852834=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101852835=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101852836=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_,'
      
        '1101852837=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1101852838=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101852839=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1101852840='
      '1101852841=                IF (ROW_COUNT = 0) THEN'
      
        '1101852842=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101852843=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1101852844=            END'
      '1101852845=          END'
      '1101852846=      END'
      '1101852847=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1101852848=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1101852849=      ELSE BEGIN'
      
        '1101852850=          -------------------------------------------' +
        '------------------'
      
        '1101852851=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1101852852=          PNT_ = '#39'025'#39';'
      '1101852853=          FOR SELECT SKLAD,'
      '1101852854=                     AMOUNT,'
      '1101852855=                     G_PRODUCT'
      '1101852856=                FROM SKLAD S'
      '1101852857=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1101852858=                 AND NOT EXISTS (SELECT 1'
      
        '1101852859=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1101852860=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1101852861=          INTO :SKLAD_,'
      '1101852862=               :Z_AMOUNT_,'
      '1101852863=               :G_PRODUCT_'
      '1101852864=          DO BEGIN'
      
        '1101852865=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :E' +
        'RR_MSG);'
      '1101852866=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101852867=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101852868=              EXIT;'
      '1101852869=            END'
      '1101852870=          END'
      '1101852871='
      '1101852872=          PNT_ = '#39'030'#39';'
      '1101852873=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1101852874=                     S.G_PRODUCT,'
      '1101852875=                     S.AMOUNT,'
      '1101852876=                     S.PRICE,'
      '1101852877=                     S.SUMM,'
      '1101852878=                     T.SKLAD,'
      '1101852879=                     T.AMOUNT,'
      '1101852880=                     T.IS_LAST,'
      '1101852881=                     T.DATE_RECEIPT'
      
        '1101852882=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1101852883=                INTO :ZAKAZ_DETAILS_,'
      '1101852884=                     :G_PRODUCT_,'
      '1101852885=                     :Z_AMOUNT_,'
      '1101852886=                     :PRICE_,'
      '1101852887=                     :SUMMM_,'
      '1101852888=                     :SKLAD_OLD_,'
      '1101852889=                     :AMOUNT_OLD_,'
      '1101852890=                     :IS_THIS_LAST_,'
      '1101852891=                     :DATE_RECEIPT_OLD_'
      '1101852892=          DO BEGIN'
      
        '1101852893=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101852894=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1101852895=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1101852896=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1101852897=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1101852898=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101852899=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1101852900=                       )'
      '1101852901=                RETURNING'
      '1101852902=                  SKLAD'
      '1101852903=                INTO'
      '1101852904=                  :SKLAD_;'
      '1101852905='
      
        '1101852906=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101852907=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101852908=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1101852909=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
