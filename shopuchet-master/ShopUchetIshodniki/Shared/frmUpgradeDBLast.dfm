        '|'#39#39' '#39#39'||ERR_MSG;'
      '110402265=              EXIT;'
      '110402266=            END'
      '110402267='
      
        '110402268=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~'#39#39'; ' +
        '  -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '110402269=      END'
      '110402270='
      
        '110402271=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059#1044 +
        #1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '110402272=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110402273=            FROM KASSA K'
      '110402274=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110402275=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA||'#39#39'~'#39#39
      '110402276=           UNION'
      '110402277=          SELECT KASSA, 1 PAYMENT_TYPE'
      '110402278=            FROM KASSA K'
      '110402279=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110402280=             AND K.SUMM = 0'
      '110402281=          UNION'
      '110402282=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110402283=            FROM KASSA_BEZNAL K'
      '110402284=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110402285=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA_BEZNAL||'#39#39'~'#39#39
      '110402286=          UNION'
      '110402287=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110402288=            FROM KASSA_BEZNAL K'
      '110402289=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110402290=             AND K.SUMM = 0'
      '110402291=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110402292=      DO BEGIN'
      '110402293=        PNT_ = '#39#39'011A'#39#39';'
      
        '110402294=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYMEN' +
        'T_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110402295=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402296=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110402297=          EXIT;'
      '110402298=        END'
      '110402299=      END'
      '110402300=  END'
      '110402301='
      
        '110402302=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      '110402303=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110402304=    SELECT K.KASSA'
      '110402305=      FROM KASSA K'
      '110402306=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110402307=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110402308=      INTO :KASSA_POP_;'
      '110402309=  ELSE'
      '110402310=    SELECT K.KASSA_BEZNAL'
      '110402311=      FROM KASSA_BEZNAL K'
      '110402312=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110402313=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110402314=       INTO :KASSA_POP_;'
      '110402315='
      
        '110402316=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053 +
        #1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '110402317=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEGI' +
        'N'
      '110402318=      PNT_ = '#39#39'012'#39#39';'
      '110402319=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      '110402320=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_,'
      
        '110402321=                                          1,     -- AC' +
        'TION_'
      '110402322=                                          :G_PRIHOD_,'
      
        '110402323=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110402324=                                          :DATE_RECEIP' +
        'T_,'
      
        '110402325=                                          NULL,   --NO' +
        'TE_'
      '110402326=                                          NULL,'
      
        '110402327=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110402328=                                          :G_PAYMENT_T' +
        'YPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110402329=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110402330=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110402331=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_'
      '110402332=                                          :G_PRIHOD_,'
      
        '110402333=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110402334=                                          :DATE_RECEIP' +
        'T_,'
      
        '110402335=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      '110402336=                                          NULL,'
      
        '110402337=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110402338=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110402339=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110402340=      END'
      '110402341=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402342=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110402343=        EXIT;'
      '110402344=      END'
      '110402345='
      
        '110402346=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048 +
        #1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110402347=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048 +
        #1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110402348=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110402349=        PNT_ = '#39#39'013'#39#39';'
      
        '110402350=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110402351=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402352=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
