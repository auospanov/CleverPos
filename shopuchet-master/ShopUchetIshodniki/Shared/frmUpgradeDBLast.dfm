      '110236999='
      
        '1102361000=UPDATE SYSTEM_SETUP SET S_VALUE = 110236 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102361001=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102361002=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102370=UPDATE LT_SKLAD_PRODUCT LL'
      '1102371=SET LL.AMOUNT = (SELECT ('
      
        '1102372=   (SELECT COALESCE(SUM(OD.AMOUNT), 0) FROM OTHER_DETAIL' +
        'S OD, OTHER O'
      
        '1102373=    WHERE OD.G_PRODUCT = LL.G_PRODUCT AND LL.G_TOCHKA = ' +
        'O.G_TOCHKA'
      '1102374=    AND OD.OTHER = O.OTHER)'
      '1102375=   +'
      
        '1102376=   (SELECT COALESCE(SUM(S.AMOUNT), 0) FROM SKLAD S WHERE' +
        ' S.G_PRODUCT = LL.G_PRODUCT'
      '1102377=    AND LL.G_TOCHKA = S.G_TOCHKA'
      '1102378=    AND S.IS_VOZVRAT <> 3)'
      '1102379=   +'
      
        '11023710=   (SELECT COALESCE(SUM(S.AMOUNT), 0) FROM SKLAD S WHER' +
        'E S.G_PRODUCT = LL.G_PRODUCT AND S.IS_VOZVRAT = 3'
      '11023711=    AND LL.G_TOCHKA = S.G_TOCHKA)'
      '11023712=   -'
      
        '11023713=   (SELECT COALESCE(SUM(ZR.AMOUNT_ALL), 0) FROM ZAKAZ_N' +
        'A_REAL ZR, ZAKAZ_REAL_PARENT ZRP'
      
        '11023714=    WHERE ZR.G_PRODUCT = LL.G_PRODUCT AND LL.G_TOCHKA =' +
        ' ZRP.G_TOCHKA'
      '11023715=    AND ZR.ZAKAZ_REAL_PARENT = ZRP.ZAKAZ_REAL_PARENT)'
      '11023716=   -'
      
        '11023717=   (SELECT COALESCE(SUM(ZD.AMOUNT), 0) FROM ZAKAZ_DETAI' +
        'LS ZD, ZAKAZ Z'
      
        '11023718=    WHERE ZD.G_PRODUCT = LL.G_PRODUCT AND LL.G_TOCHKA =' +
        ' Z.G_TOCHKA'
      '11023719=    AND ZD.ZAKAZ = Z.ZAKAZ'
      
        '11023720=    AND Z.IS_SPISANIE <> 2)   -- '#1053#1045' '#1059#1063#1048#1058#1067#1042#1040#1070' '#1054#1055#1051#1040#1058#1059' '#1047#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', '#1058'.'#1050'. '#1050#1054#1043#1044#1040' '#1058#1054#1042#1040#1056' '#1059#1064#1045#1051', '#1040' '#1050#1054#1043#1044#1040' '#1041#1067#1051' '#1054#1055#1051#1040#1063#1045#1053' - '#1053#1045#1055#1054#1053#1071#1058 +
        #1053#1054
      '11023721=   -'
      
        '11023722=   (SELECT COALESCE(SUM(S.AMOUNT), 0) FROM SKLAD S WHER' +
        'E S.G_PRODUCT = LL.G_PRODUCT AND S.IS_VOZVRAT = 3'
      '11023723=    AND LL.G_TOCHKA = S.G_CLIENT)'
      '11023724=   )'
      '11023725=FROM RDB$DATABASE)'
      '11023726=WHERE LL.AMOUNT IS NULL;'
      
        '11023727=UPDATE LT_SKLAD_PRODUCT SET AMOUNT_RESERVE = 0 WHERE AM' +
        'OUNT_RESERVE IS NULL; COMMIT WORK;'
      '11023728='
      '11023729=ALTER PROCEDURE G_PRODUCT_SET_NEW_PRICES('
      '11023730=  CONFIG_ SMALLINT,'
      '11023731=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11023732=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11023733=  CHANGE_PRICE_ INTEGER,'
      '11023734=  MODE_ INTEGER,'
      '11023735=  WHAT_PRICE_ INTEGER,'
      '11023736=  NEW_VAL_ NUMERIC(15,2),'
      '11023737=  COURSE_OLD_ NUMERIC(15,2),'
      '11023738=  COURSE_NEW_ NUMERIC(15,2),'
      '11023739=  ROUND_MODE_ INTEGER,'
      '11023740=  CHANGE_CATEGORY_ INTEGER,'
      
        '11023741=  NEW_CATEGORY_ /* TYPE OF COLUMN G_PRODUCT.G_PRODUCT *' +
        '/ BIGINT,'
      '11023742=  CHANGE_MIN_AMOUNT_ INTEGER,'
      
        '11023743=  NEW_MIN_AMOUNT_ /* TYPE OF COLUMN G_PRODUCT.MIN_AMOUN' +
        'T */ NUMERIC(15,2),'
      '11023744=  CHANGE_SALES_COMM_ INTEGER,'
      
        '11023745=  NEW_SALES_COMM_ /* TYPE OF COLUMN G_PRODUCT.SALES_COM' +
        'M */ NUMERIC(15,2),'
      '11023746=  CHANGE_KIT_TYPE_ INTEGER,'
      '11023747=  IS_KASPI_SHOP_ SMALLINT,'
      '11023748=  IS_KASPI_SHOP_MODE_ SMALLINT)'
      '11023749=RETURNS ('
      '11023750=  ERR_CODE INTEGER,'
      '11023751=  ERR_MSG VARCHAR(1000))'
      '11023752=AS'
      '11023753=BEGIN'
      '11023754=  SUSPEND;'
      '11023755=END;'
      '11023756='
      '11023757='
      
        '11023758=/******************************************************' +
        '************************/'
      
        '11023759=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11023760=/******************************************************' +
        '************************/'
      '11023761=ALTER PROCEDURE G_PRODUCT_SET_NEW_PRICES('
      '11023762=  CONFIG_ SMALLINT,'
      '11023763=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11023764=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11023765=  CHANGE_PRICE_ INTEGER,'
      '11023766=  MODE_ INTEGER,'
      '11023767=  WHAT_PRICE_ INTEGER,'
      '11023768=  NEW_VAL_ NUMERIC(15,2),'
      '11023769=  COURSE_OLD_ NUMERIC(15,2),'
      '11023770=  COURSE_NEW_ NUMERIC(15,2),'
      '11023771=  ROUND_MODE_ INTEGER,'
      '11023772=  CHANGE_CATEGORY_ INTEGER,'
      '11023773=  NEW_CATEGORY_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11023774=  CHANGE_MIN_AMOUNT_ INTEGER,'
      '11023775=  NEW_MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '11023776=  CHANGE_SALES_COMM_ INTEGER,'
      '11023777=  NEW_SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '11023778=  CHANGE_KIT_TYPE_ INTEGER,'
      '11023779=  IS_KASPI_SHOP_ SMALLINT,'
      '11023780=  IS_KASPI_SHOP_MODE_ SMALLINT)'
      '11023781=RETURNS ('
      '11023782=  ERR_CODE INTEGER,'
      '11023783=  ERR_MSG VARCHAR(1000))'
      '11023784=AS'
      '11023785=/*'
      '11023786=CONFIG_ - '#1050#1054#1053#1060#1048#1043#1059#1056#1040#1062#1048#1071' '#1052#1040#1043#1040#1047#1048#1053#1040', 4 - '#1070#1042#1045#1051#1048#1056#1050#1040
      '11023787='
      
        '11023788=ROUND_MODE_ 0 - '#1076#1077#1089#1103#1090#1099#1077', 1 - '#1094#1077#1083#1099#1077', 2 '#1076#1077#1089#1103#1090#1082#1080', 3 '#1089#1086#1090#1085#1080',' +
        ' 4 '#1090#1099#1089#1103#1095#1080
      '11023789='
      '11023790=CHANGE_KIT_TYPE_ - '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1058#1048#1055#1040' '#1058#1054#1042#1040#1056#1040
      '11023791=*/'
      
        '11023792=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '11023793=DECLARE VARIABLE PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE;'
      
        '11023794=DECLARE VARIABLE VOL_PRICE_ TYPE OF COLUMN G_PRODUCT.VO' +
        'LUME_PRICE;'
      '11023795=DECLARE VARIABLE NEW_PRICE_ NUMERIC(15,2);'
      '11023796=DECLARE VARIABLE ROUND_ INTEGER;'
      
        '11023797=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11023798=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      '11023799=BEGIN'
      '110237100='
      '110237101=  SQL_STR_ = '#39'UPDATE G_PRODUCT P'#39'||'
      '110237102=               '#39' SET '#39';'
      '110237103='
      '110237104=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110237105='
      '110237106=  -- '#1052#1045#1053#1071#1070' '#1062#1045#1053#1059
      '110237107=  IF (CHANGE_PRICE_ = 1) THEN BEGIN'
      '110237108=      IF (ROUND_MODE_ = 0) THEN'
      '110237109=          ROUND_ = 1;'
      '110237110=      ELSE IF (ROUND_MODE_ = 1) THEN'
      '110237111=          ROUND_ = 0;'
      '110237112=      ELSE IF (ROUND_MODE_ = 2) THEN'
      '110237113=          ROUND_ = -1;'
      '110237114=      ELSE IF (ROUND_MODE_ = 3) THEN'
      '110237115=          ROUND_ = -2;'
      '110237116=      ELSE IF (ROUND_MODE_ = 4) THEN'
      '110237117=          ROUND_ = -3;'
      '110237118='
      
        '110237119=      -- '#1045#1057#1051#1048' '#1054#1041#1067#1063#1053#1067#1049' '#1052#1040#1043#1040#1047', '#1048#1051#1048' '#1070#1042#1045#1051#1048#1056#1050#1040', '#1053#1054' '#1052#1045#1053#1071#1070#1058' '#1054 +
        #1041#1067#1063#1053#1067#1045' '#1062#1045#1053#1067', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068
      
        '110237120=      IF (CONFIG_ <> 4 OR (CONFIG_ = 4 AND ((WHAT_PRIC' +
        'E_ = 0  AND MODE_ <> 4) OR (MODE_ = 4 AND WHAT_PRICE_ <> 2)))) T' +
        'HEN BEGIN'
      '110237121=          -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' %'
      '110237122=          IF (MODE_ = 0) THEN BEGIN'
      
        '110237123=            SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.P' +
        'RICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '110237124=                       '#39' P.VOLUME_PRICE = ROUND(P.VOLU' +
        'ME_PRICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '110237125='
      '110237126=            IF (CONFIG_ = 4) THEN'
      
        '110237127=               SQL_STR_ = SQL_STR_ ||'#39', P.VES_GRAMM_PR' +
        'ICE = ROUND(P.PRICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100) / P.VES_GRAMM, ' +
        #39'||:ROUND_||'#39')'#39';'
      '110237128='
      '110237129=          -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '110237130=          END ELSE IF (MODE_ = 1) THEN BEGIN'
      
        '110237131=            SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.P' +
        'RICE + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110237132=                       '#39' P.VOLUME_PRICE = ROUND(P.VOLU' +
        'ME_PRICE + '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110237133='
      '110237134=            IF (CONFIG_ = 4) THEN'
      
        '110237135=               SQL_STR_ = SQL_STR_ ||'#39', P.VES_GRAMM_PR' +
        'ICE = ROUND((P.PRICE + '#39'||:NEW_VAL_||'#39') / P.VES_GRAMM, '#39'||:ROUND' +
        '_||'#39')'#39';'
      '110237136='
      '110237137=          -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' %'
      '110237138=          END ELSE IF (MODE_ = 2) THEN BEGIN'
      
        '110237139=            SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.P' +
        'RICE * (1 - '#39'||:NEW_VAL_||'#39'/100), '#39'||:ROUND_||'#39'),'#39'||'
      
        '110237140=                       '#39' P.VOLUME_PRICE = ROUND(P.VOLU' +
        'ME_PRICE * (1 - '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39')'#39';'
      '110237141='
      '110237142=            IF (CONFIG_ = 4) THEN'
      
        '110237143=               SQL_STR_ = SQL_STR_ ||'#39', P.VES_GRAMM_PR' +
        'ICE = ROUND(P.PRICE * (1 - '#39'||:NEW_VAL_||'#39'/100) / P.VES_GRAMM, '#39 +
        '||:ROUND_||'#39')'#39';'
      '110237144='
      '110237145=          -- '#1059#1052#1045#1053#1068#1064#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '110237146=          END ELSE IF (MODE_ = 3) THEN BEGIN'
      
        '110237147=            SQL_STR_ = SQL_STR_ ||'#39'P.PRICE = ROUND(P.P' +
        'RICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39'),'#39'||'
      
        '110237148=                       '#39' P.VOLUME_PRICE = ROUND(P.VOLU' +
        'ME_PRICE - '#39'||:NEW_VAL_||'#39', '#39'||:ROUND_||'#39')'#39';'
      '110237149='
      '110237150=            IF (CONFIG_ = 4) THEN'
      
        '110237151=               SQL_STR_ = SQL_STR_ ||'#39', P.VES_GRAMM_PR' +
