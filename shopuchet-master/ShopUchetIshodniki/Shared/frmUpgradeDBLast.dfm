      '110411380='
      '110411381=      -- '#1058#1045#1055#1045#1056#1068' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1070#1058' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110411382=      FOR SELECT DATE_OPER, NOTE, G_PRODUCT, AMOUNT'
      '110411383=          FROM UPLOAD_TABLE_TMP'
      '110411384=          WHERE MODE = 6'
      '110411385=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110411386=          INTO :DATE_OPER_, :NOTE_, :G_PRODUCT_, :AMOU' +
        'NT_'
      '110411387=      DO BEGIN'
      '110411388=        EXECUTE PROCEDURE DO_PRODUCT(:G_TOCHKA_,'
