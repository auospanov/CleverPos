        #1068
      '1102461768=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1102461769='
      
        '1102461770=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1102461771=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1102461772=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1102461773=                PNT_ = '#39'05'#39';'
      
        '1102461774=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1102461775=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
