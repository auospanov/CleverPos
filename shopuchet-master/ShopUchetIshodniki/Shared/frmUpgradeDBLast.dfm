      '11015862=               :VOLUME_PRICE_,'
      '11015863=               :IS_KIT_,'
      '11015864=               :IS_MARKED_;'
      '11015865='
      '11015866=    if (ROW_COUNT = 0) then BEGIN'
      
        '11015867=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1049#1044#1045#1053' '#1042' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045', '#1058#1054' '#1048#1065#1059' '#1042' '#1044#1054 +
        #1055#1054#1051#1053#1048#1058#1045#1051#1068#1053#1054#1049
      
        '11015868=      IF (SUBSTRING(BARCODE_ FROM 1 FOR 2) = PREFIX_) T' +
