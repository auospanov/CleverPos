      '1101322241=               )'
      
        '1101322242=          AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||G.G_PRODU' +
        'CT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101322243=                 OR'
      '1101322244=                 (:G_PRODUCT_ IS NULL)'
      '1101322245=               )'
      '1101322246=          AND ((EXISTS (SELECT 1'
      '1101322247=                           FROM SKLAD S'
      
        '1101322248=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1101322249=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101322250=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101322251=                            AND S.DATE_RECEIPT BETWEE' +
        'N :DATE_BEGIN_ AND :DATE_END_) AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101322252=                  OR'
      '1101322253=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1101322254=       ORDER BY 2, 3, 1'
      '1101322255=    INTO :REC_G_PRODUCT_,'
      '1101322256=        :PATH_,'
      '1101322257=        :GNAME_,'
      '1101322258=        :REC_AMOUNT_IN_,'
      '1101322259=        :REC_AMOUNT_PRIHOD_,'
      '1101322260=        :REC_SUMM_PRIHOD_,'
      '1101322261=        :REC_AMOUNT_UHOD_,'
      '1101322262=        :REC_SUMM_UHOD_,'
      '1101322263=        :REC_AMOUNT_SPISANO_,'
      '1101322264=        :REC_SUMM_SPISANO_,'
      '1101322265=        :REC_AMOUNT_VOZVRAT_,'
      '1101322266=        :REC_SUMM_VOZVRAT_,'
      '1101322267=        :REC_AMOUNT_PRIHOD_SKL_,'
      '1101322268=        :REC_SUMM_PRIHOD_SKL_,'
      '1101322269=        :REC_AMOUNT_UHOD_SKL_,'
      '1101322270=        :REC_SUMM_UHOD_SKL_,'
      '1101322271=        :REC_AMOUNT_OUT_'
      '1101322272=    DO BEGIN'
      '1101322273=      IF (PATH_OLD_ <> PATH_) THEN BEGIN'
      
        '1101322274=        IF (PATH_OLD_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101322275=            -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101322276=            INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1101322277=              (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMO' +
        'UNT_PRIHOD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO,' +
        ' SUMM_SPISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
