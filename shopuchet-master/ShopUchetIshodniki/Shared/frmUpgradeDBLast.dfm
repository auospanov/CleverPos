      '1102130='
      '1102131=ALTER PROCEDURE G_DEL_G_PRODUCT('
      '1102132=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1102133=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102134=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '1102135=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102136=RETURNS ('
      '1102137=  ERR_CODE INTEGER,'
      '1102138=  ERR_MSG VARCHAR(1024))'
      '1102139=AS'
      
        '11021310=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_DEL_G_PRODUC' +
        'T'#39';'
      '11021311=DECLARE VARIABLE CNT_ INTEGER;'
      '11021312=DECLARE VARIABLE NAKL_PROD_ VARCHAR(30);'
      
        '11021313=DECLARE VARIABLE PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      '11021314=DECLARE VARIABLE IS_CATEGORY_ INTEGER;'
      '11021315=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '11021316=BEGIN'
      '11021317='
      '11021318=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', '#39')'
      '11021319=                    FROM g_product_kit K, g_product g'
      '11021320=                   WHERE K.g_product_item = :G_PRODUCT_'
      
        '11021321=                     and k.g_product = g.g_product) FRO' +
        'M 1 FOR 999)'
      '11021322=  FROM RDB$DATABASE'
      '11021323=   INTO :PROD_NAME_;'
      '11021324=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '11021325=    ERR_CODE = -20500;'
      
