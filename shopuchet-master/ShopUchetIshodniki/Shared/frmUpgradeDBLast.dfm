        'NAL_STATE||'#39#39', '#39#39#39#39#39#39'||NEW.K_DATE||'#39#39#39#39#39#39', COALESCE((SELECT "OUT' +
        'PUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110751662=                                                      ' +
