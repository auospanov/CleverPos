        '1102112454=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102112455=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
