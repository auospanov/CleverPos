        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1102282833=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1102282834=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1102282835=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102282836=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1102282837=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1102282838=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1102282839=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1102282840=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102282841=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      
        '1102282842=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KA' +
        'SSA;'
      '1102282843=BEGIN'
      '1102282844='
      '1102282845=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1102282846=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102282847=      SELECT Z.G_PAYMENT_TYPE,'
      '1102282848=             Z.G_TOCHKA,'
      '1102282849=             Z.SUMM,'
      '1102282850=             Z.SUMM_BONUS,'
      '1102282851=             Z.SUMM_BONUS_GOT,'
      '1102282852=             z.g_client,'
      '1102282853=             Z.G_OFFICIAL,'
      '1102282854=             G.DO_NOT_SALES_COMM,'
      '1102282855=             G.FM||'#39' '#39'||G.NM'
      
        '1102282856=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1102282857=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102282858=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1102282859=             :G_TOCHKA_,'
      '1102282860=             :SUMM_OLD_,'
      '1102282861=             :SUMM_BONUS_OLD_,'
      '1102282862=             :SUMM_BONUS_GOT_OLD_,'
      '1102282863=             :g_client_old_,'
      '1102282864=             :G_OFFICIAL_,'
      '1102282865=             :DO_NOT_SALES_COMM_,'
      '1102282866=             :OFFICIAL_NAME_;'
      '1102282867='
      
        '1102282868=      -- 07.09.2021 '#1055#1054#1050#1040' '#1059#1041#1056#1040#1051' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059', '#1041#1059#1044#1059#1058' '#1054#1058#1063#1045#1058#1067' '#1044#1045#1056#1043#1040#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047
      
        '1102282869=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1102282870=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1102282871=        SELECT SUM(ZD.SALES_COMM)'
      '1102282872=          FROM ZAKAZ_DETAILS ZD'
      '1102282873=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102282874=          INTO :SALES_COMM_OLD_;'
      '1102282875=      */'
      '1102282876='
      '1102282877=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1102282878=      PNT_ = '#39'02'#39';'
      
        '1102282879=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102282880=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102282881=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102282882=        EXIT;'
      '1102282883=      END'
      '1102282884='
      
        '1102282885=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1102282886=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1102282887=      ELSE'
      '1102282888=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1102282889='
      '1102282890=      PNT_ = '#39'01'#39';'
      '1102282891=      UPDATE zakaz'
      '1102282892=      SET'
      '1102282893=       G_TOCHKA = :G_TOCHKA_,'
      '1102282894=       Z_DATE = :Z_DATE_,'
      '1102282895=       Z_TIME = :Z_TIME_,'
      '1102282896=       G_CLIENT = :G_CLIENT_,'
      '1102282897=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102282898=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102282899=       NOTE = COALESCE(:NOTE_, NOTE),'
      
        '1102282900=       DELIVERY_ADDRESS = COALESCE(:ADDRESS_, DELIVER' +
        'Y_ADDRESS),'
      '1102282901=       SUMM = :SUMM_,'
      '1102282902=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1102282903=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102282904=       ,BY_RECIPE = :BY_RECIPE_'
      '1102282905=       ,IS_RESERVE = :IS_RESERVE_'
      '1102282906=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1102282907=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1102282908=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1102282909=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1102282910=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1102282911=       ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102282912=      WHERE'
      '1102282913=        zakaz = :zakaz_;'
      '1102282914='
      
        '1102282915=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1102282916=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1102282917=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1102282918=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1102282919=          UPDATE G_DISCONT_CARD D'
      '1102282920=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1102282921=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1102282922=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1102282923='
      
        '1102282924=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1102282925=          SUMM_OLD_           = 0;'
      '1102282926=      END'
      '1102282927=      UPDATE G_DISCONT_CARD D'
      
        '1102282928=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1102282929=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1102282930=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1102282931='
      '1102282932=      PNT_ = '#39'03'#39';'
      '1102282933=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1102282934=                 T.G_PRODUCT,'
      '1102282935=                 T.AMOUNT,'
      '1102282936=                 T.SUMM,'
      '1102282937=                 G.SALES_COMM'
      '1102282938=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1102282939=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1102282940=      INTO :ZAKAZ_DETAILS_,'
      '1102282941=           :G_PRODUCT_,'
      '1102282942=           :Z_AMOUNT_,'
      '1102282943=           :DETAILS_SUMM_,'
      '1102282944=           :SALES_COMM_'
      '1102282945=      DO BEGIN'
      
        '1102282946=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1102282947=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1102282948=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1102282949=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_A' +
        'LL_ + SALES_COMM_SUMM_ITER_;'
      '1102282950=        END'
      '1102282951='
      
        '1102282952=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102282953=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1102282954=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1102282955=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1102282956=          FROM ZAKAZ_DETAILS_TMP Z'
      '1102282957=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1102282958='
      '1102282959=        -- -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045' 10%'
      '1102282960=        IF (G_PRODUCT_ <> -2) THEN BEGIN'
      
        '1102282961=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' ' +
        #1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '1102282962=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK' +
        '_ = 0) THEN'
      '1102282963=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102282964=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1102282965=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102282966=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102282967=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102282968='
      '1102282969=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1102282970=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '1102282971=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102282972=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RE' +
        'SERVE + :Z_AMOUNT_'
      '1102282973=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102282974=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102282975=        END'
      '1102282976=      END'
      '1102282977='
      '1102282978=      ----------------------------------------'
      
        '1102282979=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102282980=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1102282981=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1102282982=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102282983=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1102282984=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1102282985=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102282986=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1102282987=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1102282988=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1102282989=                PNT_ = '#39'04'#39';'
      
        '1102282990=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1102282991=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1102282992=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102282993=                ELSE'
      
        '1102282994=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102282995='
      
