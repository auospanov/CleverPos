      '11096113=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11096114=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11096115=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11096116=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11096117=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11096118=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11096119=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11096120=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
