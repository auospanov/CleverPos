        '1102503751=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1102503752=                FROM KASSA_BEZNAL K'
      '1102503753=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1102503754=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
