        'Z_DATE_STR, SUMM)'
      
        '1102401698=  VALUES (40, 1, '#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1085#1072' '#1088'/'#1089#1095#1077#1090' '#1085#1072' '#1089#1091#1084#1084 +
        #1091#39', :SUMM_PRIHOD_ALL_BEZNAL_);'
      '1102401699='
      
