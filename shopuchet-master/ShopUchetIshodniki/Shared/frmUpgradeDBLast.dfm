      '110483657=                 D.COST_PRICE PRICE,'
      '110483658=                 D.AMOUNT,'
      '110483659=                 D.COST_PRICE * D.AMOUNT SUMM'
      '110483660=            FROM OTHER O,'
      '110483661=                 G_TOCHKA C,'
      '110483662=                 OTHER_DETAILS D,'
      '110483663=                 G_PRODUCT G'
      
        '110483664=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||O.G_' +
        'TOCHKA||'#39#39'-'#39#39
      
        '110483665=             AND O.OP_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '110483666=             AND O.OTHER = D.OTHER'
      '110483667=             AND D.G_PRODUCT = G.G_PRODUCT'
      '110483668=             AND D.G_PRODUCT = :G_PRODUCT_'
      '110483669=             AND O.G_TOCHKA = C.G_TOCHKA'
      '110483670=          UNION ALL'
      '110483671=          SELECT 13,'
      
        '110483672=                 CAST('#39#39'31.12.2099'#39#39' AS DATE) DATE_SOR' +
        'T,'
      '110483673=                 NULL,'
      '110483674=                 '#39#39#1054#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1082#1086#1085#1077#1094#39#39','
      '110483675=                 NULL,'
      
        '110483676=                 (select (select amount from lt_sklad_' +
        'product where g_product = G.G_PRODUCT'
      
        '110483677=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '110483678=                       +'
      
        '110483679=                       (select COALESCE(sum(zd.amount)' +
        ', 0) from zakaz_details zd, zakaz z'
      
        '110483680=                        where zd.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110483681=                        and zd.zakaz = z.zakaz and z.z' +
        '_date > :DATE_END_)'
      '110483682=                       +'
      
        '110483683=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110483684=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '110483685=                       +'
      
        '110483686=                       (select COALESCE(sum(od.amount)' +
        ', 0) from other_details od, other o'
      
        '110483687=                        where od.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '110483688=                        and od.other = o.other and o.o' +
        'p_date > :DATE_END_)'
      '110483689=                       -'
      
        '110483690=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '110483691=                        and s.is_vozvrat <> 3 and s.da' +
        'te_receipt > :DATE_END_)'
      '110483692=                       -'
      
        '110483693=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110483694=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '110483695=                  from rdb$database) PRICE,'
      '110483696=                 NULL,'
      '110483697=                 NULL,'
      '110483698=                 NULL,'
      '110483699=                 NULL'
      '110483700=            FROM G_PRODUCT G'
      '110483701=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110483702=         ORDER BY 2, 1, 3'
      '110483703=            INTO :ROW,'
      '110483704=                 :DATE_SORT,'
      '110483705=                 :DATE_ACT,'
      '110483706=                 :OPER,'
      '110483707=                 :PRICE_PRIHOD,'
      '110483708=                 :AMOUNT_PRIHOD,'
      '110483709=                 :SUMM_PRIHOD,'
      '110483710=                 :PRICE_UHOD,'
      '110483711=                 :AMOUNT_UHOD,'
      '110483712=                 :SUMM_UHOD'
      '110483713=      DO BEGIN'
      '110483714=        IF (ROW not in (-2, -1, 13)) THEN BEGIN'
      '110483715=            PRICE_PRIHOD = COALESCE(PRICE_PRIHOD, 0);'
      
        '110483716=            AMOUNT_PRIHOD = COALESCE(AMOUNT_PRIHOD, 0)' +
        ';'
      '110483717=            SUMM_PRIHOD = COALESCE(SUMM_PRIHOD, 0);'
      '110483718=            PRICE_UHOD = COALESCE(PRICE_UHOD, 0);'
      '110483719=            AMOUNT_UHOD = COALESCE(AMOUNT_UHOD, 0);'
      '110483720=            SUMM_UHOD  = COALESCE(SUMM_UHOD, 0);'
      '110483721=        END'
      '110483722=        SUSPEND;'
      '110483723=      END'
      '110483724=  END'
      '110483725=WHEN ANY DO BEGIN'
      '110483726=    Err_code = -20500;'
      
        '110483727=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1048#1057#1058#1054#1056#1048#1048' '#1058#1054#1042#1040#1056#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110483728=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110483729=  END'
      '110483730=end'
      '110483731='#39';'
      '110483732=END  --END_EXECUTE_BLOCK'
      '110483733=EXECUTE BLOCK AS BEGIN'
      '110483734='
      
        '110483735=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAYAVKA_POSTA' +
        'VSHIK('
      '110483736=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110483737=  BEGIN_DATE_ DATE,'
      '110483738=  END_DATE_ DATE,'
      '110483739=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110483740=  DO_SKLAD_ INTEGER,'
      '110483741=  MODE_ INTEGER,'
      '110483742=  MODE_VYBOR_ INTEGER,'
      '110483743=  MODE_VAL_ INTEGER,'
      '110483744=  NEW_VAL_ MY_NUMERIC_5,'
      '110483745=  ROUND_MODE_ INTEGER)'
      '110483746=RETURNS ('
      '110483747=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110483748=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '110483749=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110483750=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110483751=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110483752=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110483753=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '110483754=  ERR_CODE INTEGER,'
      '110483755=  ERR_MSG VARCHAR(1024))'
      '110483756=AS'
      '110483757=DECLARE VARIABLE ROUND_ INTEGER;'
      '110483758=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '110483759=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      
        '110483760=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110483761=BEGIN'
      '110483762=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110483763='
      '110483764=  IF (G_TOCHKA_ IS NULL) THEN'
      '110483765=    SELECT ID'
      '110483766=      FROM CUR_PARAMS'
      '110483767=     WHERE CUR_PARAMS = 2'
      '110483768=      INTO :G_TOCHKA_;'
      '110483769='
      '110483770=  IF (ROUND_MODE_ = 0) THEN'
      '110483771=      ROUND_ = 0;'
      '110483772=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '110483773=      ROUND_ = -1;'
      '110483774=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '110483775=      ROUND_ = -2;'
      '110483776=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '110483777=      ROUND_ = -3;'
      '110483778=  ELSE IF (ROUND_MODE_ = -1) THEN'
      '110483779=      ROUND_ = 5;'
      '110483780='
      
        '110483781=  SQL_STR_ = '#39#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39#39';'
      '110483782='
      
        '110483783=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040' ' +
        #1053#1040' '#1057#1050#1051#1040#1044#1045
      '110483784=  IF (MODE_ = 0) THEN BEGIN'
      
        '110483785=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39#39';'
      '110483786=    IF (MODE_VAL_ = 0) THEN'
      '110483787=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110483788=    ELSE'
      
        '110483789=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110483790='
      '110483791=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110483792=  END'
      '110483793=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '110483794=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '110483795=    SQL_STR_ = SQL_STR_ || '#39#39'ROUND(ABS(LT.AMOUNT)'#39#39';'
      '110483796=    IF (MODE_VAL_ = 0) THEN'
      '110483797=        SQL_STR_ = SQL_STR_ || '#39#39' + :NEW_VAL_'#39#39';'
      '110483798=    ELSE'
      
        '110483799=        SQL_STR_ = SQL_STR_ || '#39#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39#39';'
      '110483800='
      '110483801=    SQL_STR_ = SQL_STR_ || '#39#39', :ROUND_)'#39#39';'
      '110483802=  END'
      '110483803='
      
        '110483804=  SQL_STR_ = SQL_STR_ || '#39#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39#39'||'
      
        '110483805=            '#39#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39#39';'
      '110483806='
      '110483807=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '110483808=    SQL_STR_ = SQL_STR_ ||'#39#39'AND EXISTS (SELECT 1'#39#39'||'
      
        '110483809=                                        '#39#39' FROM SKLAD ' +
        'S'#39#39'||'
      
        '110483810=                                        '#39#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39#39'||'
      
        '110483811=                                        '#39#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39#39'||'
      
        '110483812=                                        '#39#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39#39';'
      '110483813=    IF (MODE_VYBOR_ = 2) THEN'
      
        '110483814=      SQL_STR_ = SQL_STR_ ||'#39#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39#39';'
      '110483815=    ELSE'
      
        '110483816=      SQL_STR_ = SQL_STR_ ||'#39#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' ' +
        #1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042 +
        #1057#1045#1043#1044#1040
      '110483817=    SQL_STR_ = SQL_STR_ ||'#39#39') '#39#39';'
      '110483818=  END ELSE BEGIN'
      
        '110483819=    SQL_STR_ = SQL_STR_ ||'#39#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39#39';  -' +
        '- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '110483820=  END'
      '110483821='
      '110483822=  IF (MODE_ = 0) THEN'
      
        '110483823=    SQL_STR_ = SQL_STR_ || '#39#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39#39';'
      '110483824=  ELSE IF (MODE_ = 1) THEN'
      '110483825=    SQL_STR_ = SQL_STR_ || '#39#39' AND LT.AMOUNT < 0'#39#39';'
      
        '110483826=  SQL_STR_ = SQL_STR_ || '#39#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39#39';'
      '110483827='
      '110483828=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '110483829=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '110483830=      FOR EXECUTE STATEMENT'
      
        '110483831=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110483832=          INTO :G_PRODUCT,'
      '110483833=               :CATEGORY_NAME,'
      '110483834=               :NAME,'
      '110483835=               :ARTICUL,'
      '110483836=               :AMOUNT_CUR,'
      '110483837=               :MIN_AMOUNT,'
      '110483838=               :AMOUNT_TO_ZAKAZ'
      '110483839=        DO BEGIN'
      
        '110483840=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_P' +
        'RODUCT, :G_TOCHKA_, 0)'
      '110483841=              RETURNING_VALUES :COST_PRICE_;'
      '110483842='
      
        '110483843=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, A' +
        'MOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110483844=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_P' +
        'RODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO_' +
        'ZAKAZ, 0, 0);'
      '110483845=        END'
      '110483846='
      '110483847=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110483848=                                      CURRENT_DATE,'
      '110483849=                                      CURRENT_TIME,'
      '110483850=                                      :G_CLIENT_,'
      '110483851=                                      1,'
      
        '110483852=                                      NULL, --:OSNOVAN' +
        'IE__,'
      '110483853=                                      NULL, --:NOTE__,'
      
        '110483854=                                      0, --:IS_VOZVRAT' +
        '_,'
      
        '110483855=                                      (SELECT SUM(S.SU' +
        'MM) FROM SKLAD_TMP S),'
      
        '110483856=                                      0, -- :SUMM_FACT' +
        '_'
      '110483857=                                      0, --:G_PRIHOD_,'
      
        '110483858=                                      0 --:SUMM_PRIHOD' +
        '_)'
      '110483859=                                      ,NULL --PAYMENTS'
      
        '110483860=                                     )RETURNING_VALUES' +
        ' :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110483861=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110483862=          ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39#39'||ERR_MSG;'
      '110483863=          EXIT;'
      '110483864=        END'
      '110483865=  END'
      '110483866=  ELSE BEGIN'
      '110483867=      FOR EXECUTE STATEMENT'
      
        '110483868=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := N' +
        'EW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN_' +
        'DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '110483869=      INTO :G_PRODUCT,'
      '110483870=           :CATEGORY_NAME,'
      '110483871=           :NAME,'
      '110483872=           :ARTICUL,'
      '110483873=           :AMOUNT_CUR,'
      '110483874=           :MIN_AMOUNT,'
      '110483875=           :AMOUNT_TO_ZAKAZ'
      '110483876=      DO SUSPEND;'
      '110483877=  END'
      '110483878=END'
      '110483879='#39';'
      '110483880='
      
        '110483881=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_PARENT_L' +
        'IST('
      '110483882=  DATE_BEGIN_ DATE,'
      '110483883=  DATE_END_ DATE,'
      '110483884=  IS_VOZVRAT_ INTEGER)'
      '110483885=RETURNS ('
      '110483886=  SKLAD TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      
        '110483887=  DATE_RECEIPT TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIP' +
        'T,'
      '110483888=  G_CLIENT TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      '110483889=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '110483890=  G_PAYMENT_TYPE TYPE OF COLUMN SKLAD_PARENT.G_PAYMENT' +
        '_TYPE,'
      '110483891=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '110483892=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110483893=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110483894=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110483895=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110483896=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_AL' +
        'L,'
      '110483897=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '110483898=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110483899=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110483900=  DETAILS_STR VARCHAR(1000))'
      '110483901=AS'
      '110483902=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110483903=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110483904=BEGIN'
      '110483905='
      '110483906=  SELECT ID'
      '110483907=    FROM CUR_PARAMS'
      '110483908=   WHERE CUR_PARAMS = 2'
      '110483909=    INTO :G_TOCHKA_;'
      '110483910='
      '110483911=  SELECT COUNT(*)'
      '110483912=    FROM SKLAD_PARENT T'
      
        '110483913=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110483914=     AND ((T.IS_VOZVRAT = :IS_VOZVRAT_ AND :IS_VOZVRAT' +
        '_ <> 1)'
      
        '110483915=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ ' +
        '= 1))'
      '110483916=     AND T.G_TOCHKA = :G_TOCHKA_'
      '110483917=    INTO CNT_;'
      '110483918='
      '110483919=  if (CNT_ = 0) then'
      '110483920=    SELECT MAX(T.DATE_RECEIPT)'
      '110483921=      FROM SKLAD_PARENT T'
      '110483922=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '110483923=       AND ((T.IS_VOZVRAT = :IS_VOZVRAT_ AND :IS_VOZVR' +
        'AT_ <> 1)'
      
        '110483924=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_ ' +
        '= 1))'
      '110483925=       AND T.G_TOCHKA = :G_TOCHKA_'
      '110483926=      INTO :DATE_BEGIN_;'
      '110483927='
      '110483928=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '110483929=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '110483930=      FOR'
      '110483931=        SELECT T.SKLAD,'
      '110483932=               T.DATE_RECEIPT,'
      '110483933=               T.G_CLIENT,'
      '110483934=               GC.NAME,'
      '110483935=               T.G_PAYMENT_TYPE,'
      '110483936=               PT.NAME,'
      '110483937=               T.OSNOVANIE,'
      '110483938=               T.NOTE,'
      '110483939=               T.SUMM,'
      '110483940=               T.SUMM_FACT,'
      '110483941=               T.IS_PAYED_ALL,'
      '110483942=               T.IS_VOZVRAT,'
      '110483943=               T.g_official,'
      
        '110483944=               COALESCE(GO.fio_doc, GO.FM||'#39#39' '#39#39'||GO.n' +
        'm)'
      '110483945=          FROM SKLAD_PARENT T'
      
        '110483946=                    LEFT OUTER JOIN G_CLIENT GC ON T.G' +
        '_CLIENT = GC.G_CLIENT'
      
        '110483947=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT ' +
        'ON T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '110483948=                    LEFT OUTER JOIN G_OFFICIAL GO ON T' +
        '.g_official = GO.G_OFFICIAL'
      
        '110483949=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVRA' +
        'T_ = 0)'
      
        '110483950=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVR' +
        'AT_ = 1))'
      '110483951=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '110483952=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110483953=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '110483954=        INTO :SKLAD,'
      '110483955=             :DATE_RECEIPT,'
      '110483956=             :G_CLIENT,'
      '110483957=             :CLIENT_NAME,'
      '110483958=             :G_PAYMENT_TYPE,'
      '110483959=             :PAYMENT_NAME,'
      '110483960=             :OSNOVANIE,'
      '110483961=             :NOTE,'
      '110483962=             :SUMM,'
      '110483963=             :SUMM_FACT,'
      '110483964=             :IS_PAYED_ALL,'
      '110483965=             :IS_VOZVRAT,'
      '110483966=             :G_OFFICIAL,'
      '110483967=             :G_OFFICIAL_FIO'
      '110483968=      DO'
      '110483969=        suspend;'
      '110483970=  END ELSE BEGIN'
      '110483971=      FOR'
      '110483972=        SELECT T.SKLAD,'
      '110483973=               T.DATE_RECEIPT,'
      '110483974=               T.G_TOCHKA,'
      '110483975=               G.NAME,'
      '110483976=               T.OSNOVANIE,'
      '110483977=               T.NOTE,'
      '110483978=               T.SUMM'
      
        '110483979=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHKA' +
        ' G ON T.G_CLIENT = G.G_TOCHKA'
      '110483980=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '110483981=           AND T.IS_VOZVRAT = 3'
      
        '110483982=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110483983=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '110483984=        INTO :SKLAD,'
      '110483985=             :DATE_RECEIPT,'
      '110483986=             :G_CLIENT,'
      '110483987=             :CLIENT_NAME,'
      '110483988=             --:DETAILS_STR,'
      '110483989=             :OSNOVANIE,'
      '110483990=             :NOTE,'
      '110483991=             :SUMM'
      '110483992=      DO'
      '110483993=        suspend;'
      '110483994=  END'
      '110483995=end'
      '110483996='#39';'
      '110483997='
      '110483998='
      '110483999=EXECUTE STATEMENT '#39'ALTER TRIGGER LT_SKLAD_PRODUCT_BU0'
      '110484000=AS'
      
        '110484001=declare variable G_NAME_  TYPE OF COLUMN G_PRODUCT.NAM' +
        'E;'
      '110484002=declare variable CNT_     INTEGER;'
      
        '110484003=declare variable T_NAME_  TYPE OF COLUMN G_TOCHKA.NAME' +
        ' = '#39#39#39#39';'
      '110484004=begin'
      
        '110484005=  if (((NEW.AMOUNT - NEW.AMOUNT_RESERVE) < 0) AND (SEL' +
        'ECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) then ' +
        'BEGIN'
      '110484006=    SELECT G.NAME'
      '110484007=      FROM G_PRODUCT G'
      '110484008=     WHERE G.G_PRODUCT = NEW.G_PRODUCT'
      '110484009=      INTO :G_NAME_;'
      '110484010='
      '110484011=    if ((SELECT COUNT(*) FROM G_TOCHKA) > 1) then'
      '110484012=      SELECT '#39#39' '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39#39'||G.NAME||'#39#39'"'#39#39
      '110484013=        FROM G_TOCHKA G'
      '110484014=       WHERE G.G_TOCHKA = NEW.G_TOCHKA'
      '110484015=        INTO :T_NAME_;'
      '110484016='
      
        '110484017=    --'#39#39'/Q\'#39#39' - '#1041#1059#1044#1059' '#1042' '#1044#1045#1051#1068#1060#1071#1061' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1050#1040#1050' '#1050#1054#1053#1045#1062' ' +
        #1057#1054#1054#1041#1065#1045#1053#1048#1071', '#1048' '#1042#1057#1045' '#1063#1058#1054' '#1044#1040#1051#1068#1064#1045' - '#1042#1067#1056#1045#1047#1040#1058#1068', '#1040' '#1058#1054' FIREBIRD '#1057#1040#1052' '#1044#1054#1041#1040#1042#1051 +
        #1071#1045#1058
      '110484018=    -- '#1055#1054#1058#1054#1052' '#1043#1044#1045' '#1048' '#1042' '#1050#1040#1050#1054#1052' '#1058#1056#1048#1043#1043#1045#1056#1045' '#1055#1056#1054#1048#1047#1054#1064#1051#1040' '#1054#1064#1048#1041#1050#1040
      
        '110484019=    EXCEPTION NOL_EXCEPTION '#39#39'/R\'#1042' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088#1072#1094#1080#1080 +
        ' '#1086#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39#39'||G_NAME_||'#39#39'"'#39#39'||T_NAME_||'#39#39' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077 +
        #1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'./Q\'#39#39';'
      '110484020=  END'
      '110484021=end'
      '110484022='#39';'
      '110484023='
      '110484024=EXECUTE STATEMENT '#39'ALTER TRIGGER PRODUCT_AMOUNT_AI0'
      '110484025=AS'
      
        '110484026=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057 +
        #1054#1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056 +
        #1040', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '110484027=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050 +
        ' '#1055#1056#1048#1052#1045#1056#1059' '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1057#1058#1040#1050#1040#1053#1040' (5 '#1064#1058') '#1048' '#1050#1056#1067#1064#1050#1048' (4 '#1064#1058')' +
        ', '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110484028=  -- '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' = 4'
      
        '110484029=  -- '#1053#1040#1042#1045#1057#1048#1051' '#1053#1040' '#1058#1056#1048#1043#1043#1045#1056', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1053#1054#1043#1054' '#1043#1044#1045' '#1053#1040#1044#1054' '#1069#1058#1054 +
        ' '#1044#1045#1051#1040#1058#1068' - '#1055#1056#1048#1061#1054#1044', '#1055#1056#1054#1044#1040#1046#1048', '#1056#1045#1044#1040#1050#1058#1048#1056#1042#1054#1040#1053#1048#1045' '#1055#1056#1048#1061#1054#1044#1054#1042'/'#1055#1056#1054#1044#1040#1046
      
        '110484030=DECLARE VARIABLE G_PRODUCT_SOSTAV_  TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '110484031=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110484032=DECLARE VARIABLE CNT_ INTEGER;'
      '110484033=BEGIN'
      '110484034=  FOR SELECT K.G_PRODUCT'
      '110484035=        FROM G_PRODUCT_KIT K, G_PRODUCT G'
      '110484036=       WHERE K.G_PRODUCT_ITEM = NEW.g_product'
      '110484037=         AND K.g_product = G.g_product'
      '110484038=         AND G.is_kit = 1'
      
        '110484039=         AND (SELECT COUNT(1)               -- '#1042#1057#1045' '#1057#1054#1057 +
        #1058#1040#1042#1051#1071#1070#1065#1048#1045' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1048#1061' '#1052#1054#1046#1045#1058' '#1053#1045' '#1041#1067#1058#1068' '#1045#1057#1051#1048' '#1057#1050#1051#1040#1044' '#1053#1054#1042 +
        #1067#1049', '#1058#1054#1043#1044' '#1042' LT_SKLAD_PRODUCT '#1058#1059#1055#1054' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049
      '110484040=                FROM G_PRODUCT_KIT KK'
      '110484041=               WHERE KK.g_product = K.G_PRODUCT'
      
        '110484042=                 AND NOT EXISTS (SELECT 1 FROM LT_SKLA' +
        'D_PRODUCT L WHERE L.G_TOCHKA = NEW.g_tochka AND L.G_PRODUCT = KK' +
        '.G_PRODUCT_ITEM)) = 0'
      '110484043=       INTO :G_PRODUCT_SOSTAV_'
      '110484044=  DO BEGIN'
      '110484045=    SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE)/K.amount)'
      '110484046=      FROM G_PRODUCT_KIT K,'
      '110484047=           LT_SKLAD_PRODUCT L'
      '110484048=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '110484049=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '110484050=       AND L.G_TOCHKA = NEW.g_tochka'
      '110484051=     GROUP BY K.G_PRODUCT'
      '110484052=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110484053='
      '110484054=    UPDATE LT_SKLAD_PRODUCT L'
      '110484055=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '110484056=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_'
      '110484057=       AND L.G_TOCHKA = NEW.g_tochka;'
      '110484058='
      '110484059=    IF (ROW_COUNT = 0) THEN'
      
        '110484060=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, ' +
        'G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110484061=      VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PROD' +
        'UCT_SOSTAV_, :G_PRODUCT_SOSTAV_AMOUNT_, 0, NEW.G_TOCHKA);'
      '110484062=  END'
      '110484063=end'
      '110484064='#39';'
      '110484065='
      '110484066=EXECUTE STATEMENT '#39'ALTER TRIGGER PRODUCT_AMOUNT_BI0'
      '110484067=AS'
      
        '110484068=  -- '#1045#1057#1051#1048' '#1057#1056#1045#1044#1048' '#1058#1054#1042#1040#1056#1054#1042' '#1045#1057#1058#1068' '#1058#1054#1042#1040#1056', '#1050#1054#1058#1054#1056#1067#1049' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057 +
        #1054#1057#1058#1040#1042' '#1044#1056#1059#1043#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1058#1054' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056 +
        #1040', '#1055#1056#1048#1063#1045#1052' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1052#1059
      
        '110484069=  -- '#1053#1040#1048#1052#1045#1053#1068#1064#1045#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1048#1047' '#1042#1057#1045#1061' '#1045#1043#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061', '#1050 +
        ' '#1055#1056#1048#1052#1045#1056#1059' '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' '#1057#1054#1057#1058#1054#1048#1058' '#1048#1047' '#1057#1058#1040#1050#1040#1053#1040' (5 '#1064#1058') '#1048' '#1050#1056#1067#1064#1050#1048' (4 '#1064#1058')' +
        ', '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110484070=  -- '#1050#1054#1060#1045' '#1053#1040' '#1042#1067#1053#1054#1057' = 4'
      
        '110484071=  -- '#1053#1040#1042#1045#1057#1048#1051' '#1053#1040' '#1058#1056#1048#1043#1043#1045#1056', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1053#1054#1043#1054' '#1043#1044#1045' '#1053#1040#1044#1054' '#1069#1058#1054 +
        ' '#1044#1045#1051#1040#1058#1068' - '#1055#1056#1048#1061#1054#1044', '#1055#1056#1054#1044#1040#1046#1048', '#1056#1045#1044#1040#1050#1058#1048#1056#1042#1054#1040#1053#1048#1045' '#1055#1056#1048#1061#1054#1044#1054#1042'/'#1055#1056#1054#1044#1040#1046
      
        '110484072=DECLARE VARIABLE G_PRODUCT_SOSTAV_  TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '110484073=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110484074=DECLARE VARIABLE CNT_ INTEGER;'
      '110484075=BEGIN'
      '110484076=  FOR SELECT K.G_PRODUCT'
      '110484077=        FROM G_PRODUCT_KIT K, G_PRODUCT G'
      '110484078=       WHERE K.G_PRODUCT_ITEM = NEW.g_product'
      '110484079=         AND K.g_product = G.g_product'
      '110484080=         AND G.is_kit = 1'
      
        '110484081=         AND (SELECT COUNT(1)               -- '#1042#1057#1045' '#1057#1054#1057 +
        #1058#1040#1042#1051#1071#1070#1065#1048#1045' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1048#1061' '#1052#1054#1046#1045#1058' '#1053#1045' '#1041#1067#1058#1068' '#1045#1057#1051#1048' '#1057#1050#1051#1040#1044' '#1053#1054#1042 +
        #1067#1049', '#1058#1054#1043#1044' '#1042' LT_SKLAD_PRODUCT '#1058#1059#1055#1054' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049
      '110484082=                FROM G_PRODUCT_KIT KK'
      '110484083=               WHERE KK.g_product = K.G_PRODUCT'
      
        '110484084=                 AND NOT EXISTS (SELECT 1 FROM LT_SKLA' +
        'D_PRODUCT L WHERE L.G_TOCHKA = NEW.g_tochka AND L.G_PRODUCT = KK' +
        '.G_PRODUCT_ITEM)) = 0'
      '110484085=       INTO :G_PRODUCT_SOSTAV_'
      '110484086=  DO BEGIN'
      '110484087=    SELECT MIN((L.AMOUNT - L.AMOUNT_RESERVE)/K.amount)'
      '110484088=      FROM G_PRODUCT_KIT K,'
      '110484089=           LT_SKLAD_PRODUCT L'
      '110484090=     WHERE K.g_product = :G_PRODUCT_SOSTAV_'
      '110484091=       AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      '110484092=       AND L.G_TOCHKA = NEW.g_tochka'
      '110484093=     GROUP BY K.G_PRODUCT'
      '110484094=      INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110484095='
      '110484096=    UPDATE LT_SKLAD_PRODUCT L'
      '110484097=       SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMOUNT_'
      '110484098=     WHERE L.G_PRODUCT = :G_PRODUCT_SOSTAV_'
      '110484099=       AND L.G_TOCHKA = NEW.g_tochka;'
      '110484100='
      '110484101=    IF (ROW_COUNT = 0) THEN'
      
        '110484102=      INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT, ' +
        'G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110484103=      VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PROD' +
        'UCT_SOSTAV_, :G_PRODUCT_SOSTAV_AMOUNT_, 0, NEW.G_TOCHKA);'
      '110484104=  END'
      '110484105=end'
      '110484106='#39';'
      '110484107='
      '110484108='
      '110484109=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_PRODUCT('
      '110484110=  SKLAD_ TYPE OF COLUMN OTHER.SKLAD_PARENT_ID)'
      '110484111=RETURNS ('
      '110484112=  ERR_CODE INTEGER,'
      '110484113=  ERR_MSG VARCHAR(1024))'
      '110484114=AS'
      
        '110484115=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'DEL_PRODUCT' +
        #39#39';'
      '110484116=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110484117=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '110484118=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' */'
      
        '110484119=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110484120=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110484121=DECLARE VARIABLE ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.AR' +
        'RIVAL_TYPE;'
      
        '110484122=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110484123=BEGIN'
      '110484124='
      '110484125=  PNT_ = '#39#39'00'#39#39';'
      '110484126=  SELECT O.G_TOCHKA'
      '110484127=    FROM SKLAD_PARENT O'
      '110484128=   WHERE O.SKLAD = :SKLAD_'
      '110484129=    INTO :G_TOCHKA_;'
      '110484130='
      '110484131=  FOR SELECT D.AMOUNT'
      '110484132=            ,D.G_PRODUCT'
      '110484133=            ,O.ARRIVAL_TYPE'
      '110484134=        FROM OTHER O,'
      '110484135=             OTHER_DETAILS D'
      '110484136=       WHERE O.sklad_parent_id = :SKLAD_'
      '110484137=         AND O.OTHER = D.OTHER'
      '110484138=        INTO :AMOUNT_NEED_'
      '110484139=            ,:G_PRODUCT_KIT_'
      '110484140=            ,:ARRIVAL_TYPE_'
      '110484141=  DO BEGIN'
      '110484142=    UPDATE LT_SKLAD_PRODUCT L'
      
        '110484143=       SET L.AMOUNT = L.AMOUNT + DECODE(:ARRIVAL_TYPE_' +
        ', 0, -:AMOUNT_NEED_, :AMOUNT_NEED_)   -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040',' +
        ' '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1048' '#1053#1040#1054#1041#1054#1056#1054#1058
      '110484144=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110484145=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110484146=  END'
      '110484147='
      '110484148=  PNT_ = '#39#39'01'#39#39';'
      
        '110484149=  DELETE FROM OTHER_DETAILS D WHERE EXISTS (SELECT 1 F' +
        'ROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_ AND OTHER = D.OTHER);'
      '110484150=  DELETE FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_;'
      '110484151='
      '110484152=  PNT_ = '#39#39'02'#39#39';'
      
        '110484153=  EXECUTE PROCEDURE DEL_SKLAD(:SKLAD_, NULL) RETURNING' +
        '_VALUES (:ERR_CODE, :ERR_MSG);'
      '110484154=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110484155=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110484156=      EXIT;'
      '110484157=  END'
      '110484158=END'
      '110484159='#39';'
      '110484160='
      '110484161=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD('
      '110484162=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110484163=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '110484164=RETURNS ('
      '110484165=  ERR_CODE INTEGER,'
      '110484166=  ERR_MSG VARCHAR(1024))'
      '110484167=AS'
      '110484168=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD'#39#39';'
      '110484169=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110484170=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110484171=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '110484172=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110484173=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110484174=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110484175=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110484176=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.A' +
        'MOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071 +
        ') */'
      
        '110484177=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA.' +
        'NAME;'
      '110484178=BEGIN'
      '110484179='
      '110484180=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '110484181=    SELECT S_VALUE'
      '110484182=      FROM SYSTEM_SETUP'
      '110484183=     WHERE SYSTEM_SETUP = 2'
      '110484184=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110484185='
      '110484186=  SELECT SP.IS_VOZVRAT,'
      '110484187=         SP.G_TOCHKA'
      '110484188=         ,G.NAME'
      '110484189=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '110484190=   WHERE SP.SKLAD = :SKLAD_'
      '110484191=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '110484192=    INTO :IS_VOZVRAT_,'
      '110484193=         :G_TOCHKA_'
      '110484194=         ,:TOCHKA_NAME_;'
      '110484195='
      '110484196=  PNT_ = '#39#39'02'#39#39';'
      '110484197=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '110484198=      FOR SELECT S.G_PRODUCT,'
      '110484199=                 SUM(S.AMOUNT)'
      '110484200=            FROM SKLAD S'
      '110484201=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '110484202=           GROUP BY S.G_PRODUCT'
      '110484203=            INTO :G_PRODUCT_,'
      '110484204=                 :AMOUNT_PRIHOD_'
      '110484205=      DO BEGIN'
      '110484206=          SELECT L.AMOUNT,'
      '110484207=                 G.NAME'
      '110484208=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '110484209=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110484210=             AND L.G_PRODUCT = G.G_PRODUCT'
      '110484211=             AND L.G_TOCHKA = :G_TOCHKA_'
      '110484212=            INTO :AMOUNT_LAST_,'
      '110484213=                 :NAME_;'
      '110484214='
      
        '110484215=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) T' +
        'HEN BEGIN'
      '110484216=              ERR_CODE = -20500;'
      
        '110484217=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39#39'||NAME_||'#39#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39#39'||TOCHKA_NAME_||'#39#39 +
        '" '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') ' +
        'RETURNING_VALUES (:ERR_MSG);'
      
        '110484218=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110484219=              EXIT;'
      '110484220=          END'
      '110484221=      END'
      '110484222=  END'
      '110484223='
      
        '110484224=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110484225=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110484226=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110484227=    EXIT;'
      '110484228=  END'
      '110484229=  PNT_ = '#39#39'05'#39#39';'
      '110484230=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '110484231=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '110484232=      FOR SELECT S.KASSA'
      '110484233=            FROM KASSA S'
      '110484234=           WHERE S.SKLAD = :SKLAD_'
      '110484235=            INTO :KASSA_'
      '110484236=      DO BEGIN'
      
        '110484237=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110484238=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110484239=             ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||' +
        #39#39' '#39#39'||ERR_MSG;'
      '110484240=             EXIT;'
      '110484241=          END'
      '110484242=      END'
      '110484243='
      '110484244=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '110484245=      FOR SELECT S.KASSA_BEZNAL'
      '110484246=            FROM KASSA_BEZNAL S'
      '110484247=           WHERE S.SKLAD = :SKLAD_'
      '110484248=            INTO :KASSA_'
      '110484249=      DO BEGIN'
      
        '110484250=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110484251=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110484252=             ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||' +
        #39#39' '#39#39'||ERR_MSG;'
      '110484253=             EXIT;'
      '110484254=          END'
      '110484255=      END'
      '110484256=  END'
      '110484257=  -------------------------------------'
      '110484258='
      '110484259=  PNT_ = '#39#39'06'#39#39';'
      '110484260=  DELETE FROM sklad_PARENT'
      '110484261=  WHERE sklad = :sklad_;'
      '110484262='
      '110484263=when sqlcode -530 DO'
      '110484264=  begin'
      '110484265=    ERR_CODE = -20500;'
      
        '110484266=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '110484267=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110484268=  end'
      '110484269=end'
      '110484270='#39';'
      '110484271='
      '110484272=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD_DETAIL('
      '110484273=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110484274=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '110484275=RETURNS ('
      '110484276=  ERR_CODE INTEGER,'
      '110484277=  ERR_MSG VARCHAR(1024))'
      '110484278=AS'
      
        '110484279=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD_DE' +
        'TAIL'#39#39';'
      '110484280=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '110484281=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '110484282=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110484283=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '110484284=DECLARE VARIABLE IS_LAST_ TYPE OF COLUMN SKLAD.IS_LAST' +
        ';'
      
        '110484285=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110484286=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110484287=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110484288=DECLARE VARIABLE G_PRODUCT_SOSTAV_ TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT;'
      
        '110484289=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      
        '110484290=DECLARE VARIABLE IS_EXPECTED_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_EXPECTED;'
      
        '110484291=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.A' +
        'MOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071 +
        ') */'
      
        '110484292=DECLARE VARIABLE G_TOCHKA_PROVIDER_ TYPE OF COLUMN G_T' +
        'OCHKA.G_TOCHKA;'
      '110484293=BEGIN'
      '110484294=  PNT_ = '#39#39'01'#39#39';'
      '110484295=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1053#1048#1052#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110484296=  FOR SELECT S.G_PRODUCT,'
      '110484297=             S.AMOUNT,'
      '110484298=             S.IS_LAST'
      '110484299=             ,SP.IS_VOZVRAT'
      '110484300=             ,SP.G_TOCHKA'
      '110484301=             ,SP.IS_EXPECTED'
      '110484302=             ,SP.G_CLIENT'
      '110484303=        FROM SKLAD S, SKLAD_PARENT SP'
      '110484304=       WHERE SP.SKLAD = S.SKLAD_PARENT'
      '110484305=         AND S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110484306=         AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '110484307=       INTO :G_PRODUCT_,'
      '110484308=            :AMOUNT_,'
      '110484309=            :IS_LAST_'
      '110484310=            ,:IS_VOZVRAT_'
      '110484311=            ,:G_TOCHKA_'
      '110484312=            ,:IS_EXPECTED_'
      '110484313=            ,:G_TOCHKA_PROVIDER_'
      '110484314=  DO BEGIN'
      '110484315=    IF (IS_EXPECTED_ = 0) THEN'
      '110484316=        UPDATE LT_SKLAD_PRODUCT LT'
      '110484317=           SET LT.AMOUNT = LT.AMOUNT - :AMOUNT_'
      '110484318=         WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110484319=           AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110484320='
      
        '110484321=    IF (IS_LAST_ = 1) then    -- '#1045#1057#1051#1048' '#1057#1058#1054#1048#1058' IS_LAST, '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1045#1043#1054' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048', '#1063#1058#1054#1041#1067' '#1053#1045' '#1058#1045#1056#1071#1058#1068' '#1055#1054#1057#1051#1045#1044#1053#1070 +
        #1070' '#1055#1054#1057#1058#1040#1042#1050#1059
      '110484322=        UPDATE SKLAD SK'
      '110484323=             SET SK.IS_LAST = 1'
      '110484324=           WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110484325=             AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110484326=                               FROM SKLAD SS'
      
        '110484327=                              WHERE SS.G_TOCHKA = :G_T' +
        'OCHKA_'
      
        '110484328=                                AND SS.G_PRODUCT = SK.' +
        'G_PRODUCT'
      
        '110484329=                                AND SS.SKLAD_PARENT <>' +
        ' :SKLAD_PARENT_'
      
        '110484330=                                AND SS.DATE_RECEIPT = ' +
        '(SELECT MAX(SSS.DATE_RECEIPT)'
      
        '110484331=                                                      ' +
        '   FROM SKLAD SSS'
      
        '110484332=                                                      ' +
        '  WHERE SSS.G_PRODUCT = SS.G_PRODUCT'
      
        '110484333=                                                      ' +
        '    AND SSS.IS_VOZVRAT in (0, 4)'
      
        '110484334=                                                      ' +
        '    AND SSS.SKLAD_PARENT <> :SKLAD_PARENT_'
      
        '110484335=                                                      ' +
        '    AND SSS.G_TOCHKA = :G_TOCHKA_));'
      '110484336='
      '110484337=  END'
      '110484338='
      '110484339=  PNT_ = '#39#39'02'#39#39';'
      '110484340=  IF (IS_VOZVRAT_ = 2) THEN BEGIN'
      '110484341=    FOR SELECT ZD.AMOUNT,'
      '110484342=             ZD.PRICE,'
      '110484343=             LZ.ZAKAZ_NA_REAL'
      '110484344=        FROM SKLAD ZD,'
      '110484345=             LT_ZAKAZ_REAL LZ'
      '110484346=       WHERE ZD.SKLAD_PARENT = :SKLAD_PARENT_'
      '110484347=         AND ZD.SKLAD = COALESCE(:SKLAD_, ZD.SKLAD)'
      '110484348=         AND ZD.SKLAD = LZ.SKLAD'
      '110484349=       INTO :AMOUNT_,'
      '110484350=            :PRICE_,'
      '110484351=            :ZAKAZ_NA_REAL_'
      '110484352=    DO BEGIN'
      '110484353=      UPDATE ZAKAZ_NA_REAL ZRR'
      
        '110484354=         SET ZRR.AMOUNT_RETURNED = ZRR.AMOUNT_RETURNED' +
        ' - :AMOUNT_,'
      
        '110484355=             ZRR.SUMM_RETURNED = ZRR.SUMM_RETURNED - :' +
        'AMOUNT_ * :PRICE_,'
      '110484356=             ZRR.IS_PAYED_ALL = 0'
      '110484357=       WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110484358=    END'
      '110484359='
      '110484360=    IF (SKLAD_ IS NOT NULL) THEN'
      
        '110484361=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD = :SKL' +
        'AD_;'
      '110484362=    ELSE'
      
        '110484363=      DELETE FROM LT_ZAKAZ_REAL L WHERE L.SKLAD IN (SE' +
        'LECT SKLAD FROM SKLAD WHERE SKLAD_PARENT = :SKLAD_PARENT_);'
      '110484364=  END'
      '110484365=  ELSE IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '110484366=    FOR SELECT S.G_PRODUCT,'
      '110484367=               S.AMOUNT'
      '110484368=          FROM SKLAD S'
      '110484369=         WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110484370=           AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD)'
      '110484371=          INTO :G_PRODUCT_,'
      '110484372=               :AMOUNT_PRIHOD_'
      '110484373=    DO BEGIN'
      '110484374=      UPDATE LT_SKLAD_PRODUCT L'
      '110484375=         SET L.AMOUNT = L.AMOUNT + :AMOUNT_PRIHOD_'
      '110484376=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110484377=         AND L.G_TOCHKA = :G_TOCHKA_PROVIDER_;'
      '110484378=    END'
      '110484379=  END'
      '110484380='
      '110484381=  PNT_ = '#39#39'03'#39#39';'
      '110484382=  -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '110484383=  PNT_ = '#39#39'04'#39#39';'
      '110484384=  DELETE from SKLAD S'
      '110484385=  WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110484386=    AND S.SKLAD = COALESCE(:SKLAD_, S.SKLAD);'
      '110484387='
      '110484388=when sqlcode -530 DO'
      '110484389=  begin'
      '110484390=    ERR_CODE = -20500;'
      
        '110484391=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '110484392=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110484393=  end'
      '110484394=end'
      '110484395='#39';'
      '110484396='
      '110484397=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD_TMP('
      '110484398=  SKLAD_ TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110484399=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '110484400=RETURNS ('
      '110484401=  ERR_CODE INTEGER,'
      '110484402=  ERR_MSG VARCHAR(1024))'
      '110484403=AS'
      
        '110484404=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_SKLAD_TM' +
        'P'#39#39';'
      '110484405=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110484406=DECLARE VARIABLE G_PRODUCT_ INTEGER;'
      
        '110484407=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT = 0;'
      
        '110484408=DECLARE VARIABLE AMOUNT_CUR_SKLAD_ TYPE OF COLUMN SKLA' +
        'D.AMOUNT = 0;'
      
        '110484409=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110484410=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT = 0;'
      '110484411=BEGIN'
      '110484412='
      '110484413=  SELECT T.SKLAD_PARENT'
      '110484414=    FROM SKLAD_TMP T'
      '110484415=   WHERE T.SKLAD = :SKLAD_'
      '110484416=    INTO :SKLAD_PARENT_;'
      '110484417='
      '110484418=  DELETE FROM SKLAD_TMP'
      '110484419=  WHERE SKLAD = COALESCE(:sklad_, sklad);'
      '110484420='
      
        '110484421=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SKL' +
        'AD_PARENT_, 0) <> 0)) then BEGIN'
      '110484422=      SELECT L.G_PRODUCT,'
      '110484423=             L.AMOUNT'
      '110484424=        FROM SKLAD S,'
      '110484425=             LT_SKLAD_PRODUCT L'
      '110484426=       WHERE S.SKLAD = :SKLAD_'
      '110484427=         AND S.G_PRODUCT = L.G_PRODUCT'
      '110484428=         AND S.G_TOCHKA = L.G_TOCHKA'
      '110484429=        INTO :G_PRODUCT_,'
      '110484430=             :AMOUNT_CUR_;'
      '110484431='
      '110484432=      SELECT SUM(AMOUNT)'
      '110484433=        FROM SKLAD T'
      '110484434=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110484435=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '110484436=        INTO :AMOUNT_OLD_;'
      '110484437='
      '110484438=      SELECT SUM(AMOUNT)'
      '110484439=        FROM SKLAD_TMP T'
      '110484440=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110484441=       INTO :AMOUNT_CUR_SKLAD_;'
      '110484442='
      
        '110484443=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD_' +
        ') THEN BEGIN'
      
        '110484444=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_CU' +
        'R_SKLAD_)) < 0) THEN BEGIN'
      '110484445=            ERR_CODE = -20500;'
      
        '110484446=            ERR_MSG = '#39#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086 +
        #1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39#39'||ASCII_CHAR(10)||'
      
        '110484447=                      '#39#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'.'#39#39';'
      
        '110484448=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110484449=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110484450=            EXIT;'
      '110484451=          END'
      '110484452=      END'
      '110484453=  END'
      '110484454='
      '110484455=when sqlcode -530 DO'
      '110484456=  begin'
      '110484457=    ERR_CODE = -20500;'
      
        '110484458=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '110484459=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110484460=  end'
      '110484461=end'
      '110484462='#39';'
      '110484463='
      '110484464=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_ZAKAZ_DETAIL('
      '110484465=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '110484466=RETURNS ('
      '110484467=  ERR_CODE INTEGER,'
      '110484468=  ERR_MSG VARCHAR(1024))'
      '110484469=AS'
      
        '110484470=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_ZAKAZ_DE' +
        'TAIL'#39#39';'
      '110484471=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '110484472=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110484473=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110484474=DECLARE VARIABLE IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_' +
        'SPISANIE;'
      
        '110484475=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '110484476=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110484477=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110484478=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110484479=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110484480=BEGIN'
      '110484481=  SELECT Z.IS_SPISANIE,'
      '110484482=         Z.G_TOCHKA'
      '110484483=         ,Z.IS_RESERVE'
      '110484484=    FROM ZAKAZ Z'
      '110484485=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110484486=    INTO :IS_SPISANIE_,'
      '110484487=         :G_TOCHKA_'
      '110484488=         ,:IS_RESERVE_;'
      '110484489='
      '110484490=  if (IS_SPISANIE_ <> 2) then BEGIN'
      '110484491=      FOR SELECT G_PRODUCT,'
      '110484492=                 AMOUNT'
      '110484493=            FROM ZAKAZ_DETAILS Z'
      '110484494=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110484495=           INTO :G_PRODUCT_,'
      '110484496=                :AMOUNT_'
      '110484497=      DO BEGIN'
      '110484498=        IF (IS_RESERVE_ = 0) THEN'
      '110484499=            UPDATE LT_SKLAD_PRODUCT LT'
      '110484500=               SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_'
      '110484501=             WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110484502=               AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110484503='
      '110484504=        ELSE'
      '110484505=            UPDATE LT_SKLAD_PRODUCT LT'
      
        '110484506=               SET LT.AMOUNT_RESERVE = LT.AMOUNT_RESER' +
        'VE - :AMOUNT_'
      '110484507=             WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110484508=               AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110484509=      END'
      '110484510='
      '110484511=  END ELSE BEGIN'
      '110484512=      FOR SELECT ZD.AMOUNT,'
      '110484513=                 ZD.PRICE,'
      '110484514=                 ZD.DISCOUNT_TENGE,'
      '110484515=                 LZ.ZAKAZ_NA_REAL'
      '110484516=            FROM ZAKAZ Z,'
      '110484517=                 ZAKAZ_DETAILS ZD,'
      '110484518=                 LT_ZAKAZ_REAL LZ'
      '110484519=           WHERE Z.ZAKAZ = :ZAKAZ_'
      '110484520=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '110484521=             AND ZD.ZAKAZ_DETAILS = LZ.ZAKAZ_DETAILS'
      '110484522=           INTO :AMOUNT_,'
      '110484523=                :PRICE_,'
      '110484524=                :DISCOUNT_TENGE_,'
      '110484525=                :ZAKAZ_NA_REAL_'
      '110484526=      DO BEGIN'
      '110484527=          UPDATE ZAKAZ_NA_REAL ZRR'
      
        '110484528=             SET ZRR.AMOUNT_PAYED = ZRR.AMOUNT_PAYED -' +
        ' :AMOUNT_,'
      
        '110484529=                 ZRR.SUMM_PAYED = ZRR.SUMM_PAYED - :AM' +
        'OUNT_ * (:PRICE_ - :DISCOUNT_TENGE_),'
      '110484530=                 ZRR.IS_PAYED_ALL = 0'
      '110484531=           WHERE ZRR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110484532=      END'
      '110484533='
      
        '110484534=      DELETE FROM LT_ZAKAZ_REAL R WHERE R.ZAKAZ_DETAIL' +
        'S IN (SELECT ZAKAZ_DETAILS FROM ZAKAZ_DETAILS ZD WHERE ZD.ZAKAZ ' +
        '= :ZAKAZ_);'
      '110484535=  END'
      '110484536='
      '110484537=  PNT_ = '#39#39'03'#39#39';'
      '110484538=  DELETE from zakaz_DETAILS z'
      '110484539=  WHERE z.zakaz = :zakaz_;'
      '110484540='
      '110484541=when sqlcode -530 DO'
      '110484542=  begin'
      '110484543=    ERR_CODE = -20500;'
      
        '110484544=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      
        '110484545=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110484546=  end'
      '110484547=WHEN ANY DO'
      '110484548=  begin'
      '110484549=    ERR_CODE = sqlcode;'
      '110484550=  end'
      '110484551=end'
      '110484552='#39';'
      '110484553=END  --END_EXECUTE_BLOCK'
      '110484554=EXECUTE BLOCK AS BEGIN'
      '110484555='
      '110484556=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_ZAKAZ_NA_REAL('
      
        '110484557=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL)'
      '110484558=RETURNS ('
      '110484559=  ERR_CODE INTEGER,'
      '110484560=  ERR_MSG VARCHAR(1024))'
      '110484561=AS'
      
        '110484562=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'DEL_ZAKAZ_NA' +
        '_REAL'#39#39';'
      '110484563=DECLARE VARIABLE PNT_ VARCHAR(30);'
      
        '110484564=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110484565=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110484566=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      '110484567=DECLARE VARIABLE CNT_ INTEGER;'
      
        '110484568=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110484569=begin'
      '110484570=  FOR SELECT G_PRODUCT,'
      '110484571=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED,'
      '110484572=             Z.ZAKAZ_REAL_PARENT,'
      '110484573=             ZP.G_TOCHKA'
      '110484574=        FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      '110484575=       WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110484576=         AND Z.IS_PAYED_ALL = 0'
      
        '110484577=         AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PAREN' +
        'T'
      '110484578=       INTO :G_PRODUCT_,'
      '110484579=            :AMOUNT_,'
      '110484580=            :ZAKAZ_REAL_PARENT_,'
      '110484581=            :G_TOCHKA_'
      '110484582=  DO BEGIN'
      '110484583=    UPDATE LT_SKLAD_PRODUCT LT'
      '110484584=       SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_'
      '110484585=     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110484586=       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110484587=  END'
      '110484588='
      '110484589=  PNT_ = '#39#39'03'#39#39';'
      '110484590=  DELETE from ZAKAZ_NA_REAL z'
      '110484591=  WHERE z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110484592='
      '110484593=  SELECT COUNT(*)'
      '110484594=    FROM ZAKAZ_NA_REAL Z'
      '110484595=   WHERE Z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_'
      '110484596=    INTO :CNT_;'
      '110484597='
      '110484598=  if (CNT_ = 0) then'
      '110484599=      DELETE from ZAKAZ_REAL_PARENT z'
      '110484600=      WHERE z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_;'
      '110484601='
      '110484602=when sqlcode -530 DO'
      '110484603=  begin'
      '110484604=    ERR_CODE = -20500;'
      
        '110484605=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '110484606=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110484607=  end'
      '110484608=end'
      '110484609='#39';'
      '110484610='
      '110484611=EXECUTE STATEMENT '#39'ALTER PROCEDURE DO_PRODUCT('
      '110484612=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110484613=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '110484614=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110484615=  AMOUNT_ INTEGER,'
      '110484616=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '110484617=RETURNS ('
      '110484618=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '110484619=  ERR_CODE INTEGER,'
      '110484620=  ERR_MSG VARCHAR(1024))'
      '110484621=AS'
      
        '110484622=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'DO_PRODUCT'#39 +
        #39';'
      '110484623=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110484624=DECLARE VARIABLE CAN_SELL_ INTEGER;'
      
        '110484625=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PROD' +
        'UCT;'
      
        '110484626=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.AMOUNT;'
      
        '110484627=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT;'
      '110484628=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110484629=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110484630=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ' = 0;'
      
        '110484631=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '110484632=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      '110484633=BEGIN'
      '110484634=  PNT_ = '#39#39'00'#39#39';'
      '110484635='
      '110484636=  IF (G_TOCHKA_ IS NULL) THEN'
      '110484637=    SELECT ID'
      '110484638=      FROM CUR_PARAMS'
      '110484639=     WHERE CUR_PARAMS = 2'
      '110484640=      INTO :G_TOCHKA_;'
      '110484641='
      '110484642=  SELECT P.S_VALUE'
      '110484643=    FROM SYSTEM_SETUP P'
      '110484644=   WHERE P.SYSTEM_SETUP = 2'
      '110484645=    INTO :CAN_SELL_;'
      '110484646='
      '110484647=  SELECT MAX(G.NAME)'
      '110484648=    FROM G_PRODUCT G,'
      '110484649=         G_PRODUCT_KIT K'
      '110484650=   WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '110484651=     AND K.G_PRODUCT = :G_PRODUCT_'
      
        '110484652=     AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PRODU' +
        'CT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCHKA_' +
        '), 0) < (K.AMOUNT * :AMOUNT_)'
      '110484653=    INTO :NAME_;'
      '110484654='
      '110484655=  IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEGIN'
      '110484656=    ERR_CODE = -20500;'
      
        '110484657=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1089#1090#1072#1090#1086#1082' ' +
        #1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39#39'||NAME_||'#39#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1089#1086#1073 +
        #1088#1072#1090#1100' '#1087#1088#1086#1076#1091#1082#1090'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110484658=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110484659=    EXIT;'
      '110484660=  END'
      '110484661='
      '110484662=  PNT_ = '#39#39'01'#39#39';'
      '110484663=  -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      
        '110484664=  INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIVAL_' +
        'TYPE, PARENT_ID, NOTE, G_TOCHKA)'
      
        '110484665=  VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0, 1' +
        ', :OTHER_, :NOTE_, :G_TOCHKA_)'
      '110484666=  RETURNING OTHER'
      '110484667=  INTO :OTHER_;'
      '110484668='
      '110484669=  FOR SELECT K.G_PRODUCT_ITEM'
      '110484670=            ,K.AMOUNT*:AMOUNT_'
      '110484671=            ,K.amount'
      '110484672=            ,G.G_PRODUCT'
      '110484673=        FROM G_PRODUCT_KIT K'
      '110484674=            ,G_PRODUCT G'
      '110484675=       WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110484676=         AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '110484677=        INTO :ITEM_'
      '110484678=            ,:AMOUNT_NEED_'
      '110484679=            ,:AMOUNT_NEED_ONE_'
      '110484680=            ,:G_PRODUCT_KIT_'
      '110484681=  DO BEGIN'
      
        '110484682=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_K' +
        'IT_, NULL, 1)'
      '110484683=      RETURNING_VALUES :SELF_PRICE_;'
      '110484684='
      '110484685=    UPDATE LT_SKLAD_PRODUCT L'
      '110484686=       SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110484687=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110484688=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110484689='
      '110484690=    IF (ROW_COUNT = 0) THEN'
      
        '110484691=      INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(GEN_' +
        'LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G_TOC' +
        'HKA_);'
      '110484692='
      
        '110484693=    INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHER, G' +
        '_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110484694=    VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_, :G_' +
        'PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110484695='
      
        '110484696=    COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*SELF_' +
        'PRICE_;'
      '110484697=  END'
      '110484698='
      '110484699='
      
        '110484700=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063#1040#1051#1045' ' +
        #1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110484701=  PNT_ = '#39#39'02'#39#39';'
      
        '110484702=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM)'
      
        '110484703=  VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_, :AM' +
        'OUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110484704='
      '110484705=  EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110484706=                              :DATE_,'
      '110484707=                              CURRENT_TIME,'
      '110484708=                              NULL, --:G_CLIENT__,'
      
        '110484709=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110484710=                              NULL, --:OSNOVANIE__,'
      '110484711=                              :NOTE_,'
      '110484712=                              4, --:IS_VOZVRAT_,'
      '110484713=                              :AMOUNT_*:COST_PRICE_,'
      '110484714=                              :AMOUNT_*:COST_PRICE_,'
      '110484715=                              0, --:G_PRIHOD_,'
      '110484716=                              0 --:SUMM_PRIHOD_)'
      '110484717=                              ,NULL     --PAYMENTS_'
      
        '110484718=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110484719=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110484720=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110484721=      EXIT;'
      '110484722=  END'
      '110484723='
      '110484724=  UPDATE OTHER O'
      '110484725=    SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110484726=  WHERE O.OTHER = :OTHER_;'
      '110484727=END'
      '110484728='#39';'
      '110484729='
      
        '110484730=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_PRODUCT_SAL' +
        'EMODE('
      '110484731=  G_PRODUCT_ INTEGER,'
      '110484732=  G_TOCHKA_ INTEGER)'
      '110484733=RETURNS ('
      '110484734=  NAME_ VARCHAR(500),'
      '110484735=  PRICE_ NUMERIC(15,2),'
      '110484736=  ROZN_PRICE_ NUMERIC(15,2),'
      '110484737=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110484738=  AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110484739=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110484740=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '110484741=  SKIDKA_SUMM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '110484742=  ERR_CODE INTEGER,'
      '110484743=  ERR_MSG VARCHAR(1024))'
      '110484744=AS'
      '110484745=BEGIN'
      '110484746=    SELECT'
      '110484747=        t.NAME,'
      '110484748=        t.PRICE,'
      '110484749=        T.price,'
      '110484750=        t.VOLUME_PRICE,'
      '110484751=        t.PACK_AMOUNT'
      
        '110484752=        ,COALESCE(P.AMOUNT, 0) - COALESCE(P.AMOUNT_RES' +
        'ERVE, 0) AMOUNT'
      '110484753=        ,COALESCE(PP.SKIDKA_PROC, 0)'
      '110484754=        ,COALESCE(PP.SKIDKA_SUM, 0)'
      '110484755=    FROM G_PRODUCT T'
      
        '110484756=         LEFT OUTER JOIN (SELECT G_PRODUCT, AMOUNT, AM' +
        'OUNT_RESERVE FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_) ' +
        ' P ON T.G_PRODUCT = P.G_PRODUCT'
      
        '110484757=         LEFT OUTER JOIN (SELECT G_PRODUCT, D.SKIDKA_P' +
        'ROC, D.SKIDKA_SUM'
      
        '110484758=                                        FROM G_DISCOUN' +
        'T D'
      
        '110484759=                                        WHERE (D.DATE_' +
        'BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110484760=                                                AND D.' +
        'DATE_END >= CURRENT_TIMESTAMP'
      
        '110484761=                                                AND D.' +
        'DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      '110484762=                                              )'
      '110484763=                                              OR'
      
        '110484764=                                              (D.DATE_' +
        'BEGIN IS NULL AND D.DATE_END IS NULL)'
      
        '110484765=                                     ) PP ON T.G_PRODU' +
        'CT = PP.G_PRODUCT'
      '110484766=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110484767=    INTO'
      '110484768=        :NAME_,'
      '110484769=        :PRICE_,'
      '110484770=        :ROZN_PRICE_,'
      '110484771=        :VOLUME_PRICE_,'
      '110484772=        :PACK_AMOUNT_,'
      '110484773=        :AMOUNT_,'
      '110484774=        :SKIDKA_PROC_,'
      '110484775=        :SKIDKA_SUMM_;'
      '110484776=end'
      '110484777='#39';'
      '110484778='
      '110484779=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '110484780=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110484781=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110484782=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110484783=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110484784=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110484785=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110484786=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110484787=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110484788=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110484789=  SELF_PRICE_ NUMERIC(15,2),'
      '110484790=  AMOUNT_ NUMERIC(15,2),'
      '110484791=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110484792=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110484793=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110484794=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110484795=  IS_THIS_LAST_ INTEGER,'
      '110484796=  UPDATE_IF_EXIST_ INTEGER)'
      '110484797=RETURNS ('
      '110484798=  ERR_CODE INTEGER,'
      '110484799=  ERR_MSG VARCHAR(1024))'
      '110484800=AS'
      
        '110484801=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'G_IMPORT_G_P' +
        'RODUCT'#39#39';'
      '110484802=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110484803=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '110484804=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110484805=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110484806=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110484807=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110484808=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      '110484809=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110484810=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110484811=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110484812=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110484813=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110484814=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110484815=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110484816=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110484817=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110484818=BEGIN'
      '110484819=    ERR_MSG = '#39#39#39#39';'
      '110484820='
      '110484821=    SELECT ID'
      '110484822=      FROM CUR_PARAMS'
      '110484823=    WHERE CUR_PARAMS = 2'
      '110484824=      INTO :G_TOCHKA_;'
      '110484825='
      '110484826=    SELECT G.G_UNIT'
      '110484827=      FROM G_UNIT G'
      
        '110484828=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME' +
        '_G_UNIT_))'
      '110484829=      INTO :G_UNIT_;'
      '110484830=    if (ROW_COUNT = 0) then'
      '110484831=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110484832='
      '110484833=    PNT_ = '#39#39'02'#39#39';'
      
        '110484834=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110484835=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '110484836=        SELECT G.G_PRODUCT,'
      '110484837=               G.NAME'
      '110484838=          FROM G_PRODUCT G'
      
        '110484839=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110484840=           AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '110484841=          INTO :G_PRODUCT_,'
      '110484842=               :G_PRODUCT_NAME_;'
      '110484843='
      
        '110484844=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110484845=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110484846=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110484847=              UPDATE G_PRODUCT G'
      '110484848=                 SET G.NAME = :NAME_,'
      '110484849=                     G.G_UNIT = :G_UNIT_,'
      '110484850=                     G.PRICE  = :PRICE_,'
      '110484851=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110484852=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110484853=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110484854=                     G.PLACE = :PLACE_,'
      
        '110484855=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110484856=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110484857=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '110484858=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110484859='
      
        '110484860=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39 +
        #39'||UPPER(TRIM(:ARTICUL_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '110484861=            END ELSE'
      
        '110484862=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110484863=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODUCT_' +
        'NAME_||'#39#39'.'#39#39';'
      '110484864=        END'
      '110484865=    END ELSE'
      
        '110484866=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110484867='
      
        '110484868=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110484869=    PNT_ = '#39#39'02a'#39#39';'
      
        '110484870=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110484871=        SELECT G.G_PRODUCT,'
      '110484872=               G.NAME'
      '110484873=          FROM G_PRODUCT G'
      
        '110484874=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110484875=           AND TRIM(G.nomenclatur_num) <> '#39#39#39#39
      '110484876=          INTO :G_PRODUCT_,'
      '110484877=               :G_PRODUCT_NAME_;'
      '110484878='
      
        '110484879=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110484880=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110484881=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110484882=              UPDATE G_PRODUCT G'
      '110484883=                 SET G.NAME = :NAME_,'
      '110484884=                     G.G_UNIT = :G_UNIT_,'
      '110484885=                     G.PRICE  = :PRICE_,'
      '110484886=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110484887=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110484888=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110484889=                     G.PLACE = :PLACE_,'
      
        '110484890=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110484891=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110484892=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '110484893=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110484894='
      
        '110484895=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099 +
        '.'#39#39';'
      '110484896=            END ELSE'
      
        '110484897=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110484898=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077 +
        ' - '#39#39'||G_PRODUCT_NAME_||'#39#39'.'#39#39';'
      '110484899=        END'
      '110484900=    end'
      '110484901='
      
        '110484902=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110484903=    PNT_ = '#39#39'02b'#39#39';'
      
        '110484904=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110484905=        SELECT G.G_PRODUCT,'
      '110484906=               G.NAME'
      '110484907=          FROM G_PRODUCT G'
      '110484908=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110484909=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '110484910=          INTO :G_PRODUCT_,'
      '110484911=               :G_PRODUCT_NAME_;'
      '110484912='
      '110484913=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110484914=          SELECT G.G_PRODUCT,'
      '110484915=                 G.NAME'
      '110484916=            FROM G_PRODUCT G, LT_BARCODE L'
      '110484917=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110484918=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110484919=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '110484920=            INTO :G_PRODUCT_,'
      '110484921=                 :G_PRODUCT_NAME_;'
      '110484922='
      
        '110484923=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110484924=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110484925=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110484926=              UPDATE G_PRODUCT G'
      '110484927=                 SET G.NAME = :NAME_,'
      '110484928=                     G.G_UNIT = :G_UNIT_,'
      '110484929=                     G.PRICE  = :PRICE_,'
      '110484930=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110484931=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110484932=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110484933=                     G.PLACE = :PLACE_,'
      
        '110484934=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110484935=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110484936=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '110484937=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110484938='
      
        '110484939=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '110484940=            END ELSE'
      
        '110484941=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110484942=                ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39#39'||UPPER(TRIM(:BARCODE_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODU' +
        'CT_NAME_||'#39#39'.'#39#39';'
      '110484943=        END'
      
        '110484944=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110484945=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110484946='
      '110484947=    PNT_ = '#39#39'02b'#39#39';'
      '110484948=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '110484949=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110484950=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE)'
      
        '110484951=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_P' +
        'AR_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, ' +
        ':PRICE_,'
      
        '110484952=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_)'
      '110484953=        returning G_PRODUCT'
      '110484954=        into :G_PRODUCT_;'
      '110484955='
      
        '110484956=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110484957=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_);'
      '110484958=    end'
      '110484959='
      
        '110484960=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110484961=    PNT_ = '#39#39'03'#39#39';'
      '110484962=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110484963=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110484964=                                       :AMOUNT_,'
      '110484965=                                       :SELF_PRICE_,'
      
        '110484966=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110484967=                                       0, --nds_,'
      '110484968=                                       0 --nds_summ_,'
      
        '110484969=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110484970=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110484971=          ERR_MSG  = '#39#39' PNT_ '#39#39'||PNT_||'#39#39' -> '#39#39'||ERR_M' +
        'SG;'
      '110484972=          EXIT;'
      '110484973=        END'
      '110484974=    END'
      '110484975='
      
        '110484976=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110484977=    PNT_ = '#39#39'04'#39#39';'
      '110484978=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110484979=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110484980=        FROM SKLAD_TMP T'
      '110484981=        INTO :CNT_;'
      '110484982='
      '110484983=      if (CNT_ > 0) then BEGIN'
      '110484984=        SELECT SUM(T.SUMM)'
      '110484985=          FROM SKLAD_TMP T'
      '110484986=          INTO :SUMM_;'
      '110484987='
      '110484988=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110484989=                                DATE_RECEIPT,'
      '110484990=                                TIME_RECEIPT,'
      '110484991=                                G_CLIENT,'
      '110484992=                                G_PAYMENT_TYPE,'
      '110484993=                                OSNOVANIE,'
      '110484994=                                NOTE,'
      '110484995=                                SUMM,'
      '110484996=                                SUMM_FACT,'
      '110484997=                                IS_PAYED_ALL,'
      '110484998=                                IS_VOZVRAT,'
      '110484999=                                G_TOCHKA)'
      '110485000=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110485001=                CURRENT_DATE,'
      '110485002=                CURRENT_TIME,'
      '110485003=                :G_CLIENT_,'
      '110485004=                1,'
      '110485005=                NULL,  --:OSNOVANIE_,'
      '110485006=                NULL,  -- :NOTE_,'
      '110485007=                :SUMM_,'
      '110485008=                :SUMM_,'
      
        '110485009=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110485010=                0,'
      '110485011=                :G_TOCHKA_)'
      '110485012=        RETURNING'
      '110485013=          SKLAD'
      '110485014=        INTO'
      '110485015=          :SKLAD_PARENT_;'
      '110485016='
      '110485017=        PNT_ = '#39#39'05'#39#39';'
      '110485018=        FOR SELECT SKLAD,'
      '110485019=                   G_PRODUCT,'
      '110485020=                   AMOUNT,'
      '110485021=                   PRICE,'
      '110485022=                   SUMM'
      '110485023=              FROM SKLAD_TMP'
      '110485024=             ORDER BY 1'
      '110485025=              INTO :SKLAD_TMP_,'
      '110485026=                   :RG_PRODUCT_,'
      '110485027=                   :RAMOUNT_,'
      '110485028=                   :RPRICE_,'
      '110485029=                   :RSUMM_'
      '110485030=        DO BEGIN'
      '110485031='
      '110485032=            UPDATE SKLAD SK'
      '110485033=               SET SK.IS_LAST = 0'
      '110485034=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110485035=               AND SK.IS_LAST = 1;'
      '110485036='
      '110485037=            INSERT INTO SKLAD'
      '110485038=            ('
      '110485039=             SKLAD,'
      '110485040=             SKLAD_PARENT,'
      '110485041=             DATE_RECEIPT,'
      '110485042=             G_CLIENT,'
      '110485043=             G_PRODUCT,'
      '110485044=             AMOUNT,'
      '110485045=             PRICE,'
      '110485046=             SUMM,'
      '110485047=             G_PAYMENT_TYPE,'
      '110485048=             OSNOVANIE,'
      '110485049=             NOTE,'
      '110485050=             NDS,'
      '110485051=             NDS_SUMM,'
      '110485052=             IS_LAST,'
      '110485053=             IS_VOZVRAT,'
      '110485054=             G_TOCHKA'
      '110485055=            ) VALUES ('
      '110485056=             :SKLAD_TMP_,'
      '110485057=             :SKLAD_PARENT_,'
      '110485058=             CURRENT_DATE,'
      '110485059=             :G_CLIENT_,'
      '110485060=             :RG_PRODUCT_,'
      '110485061=             :RAMOUNT_,'
      '110485062=             :RPRICE_,'
      '110485063=             :RSUMM_,'
      '110485064=             1,       --:G_PAYMENT_TYPE_,'
      '110485065=             NULL,    --:OSNOVANIE_,'
      '110485066=             NULL,    --:NOTE_,'
      '110485067=             0,       --:RNDS_,'
      '110485068=             0,       --:RNDS_SUMM_,'
      '110485069=             1,       --IS_LAST_'
      '110485070=             0,        --:IS_VOZVRAT_'
      '110485071=             :G_TOCHKA_'
      '110485072=            );'
      '110485073='
      
        '110485074=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110485075=            PNT_ = '#39#39'06'#39#39';'
      '110485076=            UPDATE LT_SKLAD_PRODUCT L'
      '110485077=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110485078=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110485079=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110485080='
      '110485081=            PNT_ = '#39#39'06a'#39#39';'
      '110485082=            IF (ROW_COUNT = 0) THEN'
      
        '110485083=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '110485084=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '110485085=        END'
      '110485086='
      '110485087=        PNT_ = '#39#39'07'#39#39';'
      
        '110485088=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110485089=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110485090=                                :SUMM_,'
      '110485091=                                CURRENT_DATE,'
      
        '110485092=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110485093=                                NULL,   --ZAKAZ_'
      '110485094=                                :SKLAD_PARENT_,'
      '110485095=                                1,'
      
        '110485096=                                :G_TOCHKA_) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110485097=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110485098=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110485099=          EXIT;'
      '110485100=        END'
      '110485101='
      '110485102=        DELETE FROM SKLAD_TMP;'
      '110485103=      END'
      '110485104=    END'
      '110485105='
      
        '110485106=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110485107=    if (ERR_MSG_ IS NOT NULL) then'
      '110485108=      ERR_MSG = ERR_MSG_;'
      '110485109='
      '110485110=WHEN ANY DO BEGIN'
      '110485111=    Err_code = gdscode;'
      
        '110485112=    ERR_MSG = '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39#39'||gdscode||'#39 +
        #39' --> PNT_ '#39#39'||PNT_;'
      '110485113=  END'
      '110485114=END'
      '110485115='#39';'
      '110485116='
      '110485117=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_PRODUCT('
      '110485118=  G_PRODUCT_PAR_ INTEGER,'
      '110485119=  ARTICUL_ VARCHAR(30),'
      '110485120=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110485121=  BARCODE_ VARCHAR(30),'
      '110485122=  NAME_ VARCHAR(500),'
      '110485123=  G_UNIT_ INTEGER,'
      '110485124=  PRICE_ NUMERIC(15,2),'
      '110485125=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110485126=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110485127=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110485128=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110485129=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110485130=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110485131=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110485132=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110485133=  IS_CATEGORY_ INTEGER)'
      '110485134=RETURNS ('
      '110485135=  G_PRODUCT_ INTEGER,'
      '110485136=  ERR_CODE INTEGER,'
      '110485137=  ERR_MSG VARCHAR(1024))'
      '110485138=AS'
      
        '110485139=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'G_INS_G_PROD' +
        'UCT'#39#39';'
      '110485140=DECLARE VARIABLE CNT_ INTEGER;'
      '110485141=DECLARE VARIABLE N INTEGER;'
      '110485142=DECLARE VARIABLE N_CURR_ INTEGER;'
      
        '110485143=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110485144=begin'
      
        '110485145=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110485146=    if (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) then begin'
      '110485147=        SELECT COUNT(*)'
      '110485148=          FROM G_PRODUCT G'
      
        '110485149=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110485150=           AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '110485151=          INTO :CNT_;'
      '110485152='
      '110485153=        IF (CNT_ > 0) THEN BEGIN'
      '110485154=          ERR_CODE = -20500;'
      
        '110485155=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39'||ARTICUL_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110485156=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110485157=          EXIT;'
      '110485158=        END'
      '110485159=    end'
      '110485160='
      '110485161=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      
        '110485162=    if (CHAR_LENGTH(TRIM(:NOMENCLATUR_NUM_)) > 0) then' +
        ' begin'
      '110485163=        SELECT COUNT(*)'
      '110485164=          FROM G_PRODUCT G'
      
        '110485165=         WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:' +
        'NOMENCLATUR_NUM_))'
      '110485166=           AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39#39#39
      '110485167=        INTO :CNT_;'
      '110485168=        IF (CNT_ > 0) THEN BEGIN'
      '110485169=          ERR_CODE = -20500;'
      
        '110485170=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086 +
        #1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||NOMENCLATUR_NUM_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39 +
        #39') RETURNING_VALUES (:ERR_MSG);'
      '110485171=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110485172=          EXIT;'
      '110485173=        END'
      '110485174=    end'
      '110485175='
      '110485176=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110485177=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110485178=        SELECT COUNT(*)'
      '110485179=          FROM G_PRODUCT G'
      
        '110485180=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110485181=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '110485182=          INTO :CNT_;'
      '110485183='
      '110485184=        IF (CNT_ = 0) then'
      '110485185=          SELECT COUNT(*)'
      '110485186=            FROM G_PRODUCT G, LT_BARCODE L'
      '110485187=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110485188=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110485189=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '110485190=            INTO :CNT_;'
      '110485191='
      '110485192=        IF (CNT_ > 0) THEN BEGIN'
      '110485193=          ERR_CODE = -20500;'
      
        '110485194=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39#39'||:BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING' +
        '_VALUES (:ERR_MSG);'
      '110485195=          ERR_MSG = PROCNAME||ERR_MSG;'
      '110485196=          EXIT;'
      '110485197=        END'
      '110485198=    end'
      '110485199='
      
        '110485200=    INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR, A' +
        'RTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME_PR' +
        'ICE,'
      
        '110485201=                           IS_CATEGORY, PACK_AMOUNT, M' +
        'F_COUNTRY, NOTE, CROSSCODE, IS_KIT, MIN_AMOUNT, PLACE)'
      
        '110485202=    VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PAR_,' +
        ' :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :PRI' +
        'CE_, :VOLUME_PRICE_, :IS_CATEGORY_,'
      
        '110485203=            :PACK_AMOUNT_, :MF_COUNTRY_, :NOTE_, :CROS' +
        'SCODE_, :IS_KIT_, :MIN_AMOUNT_, :PLACE_)'
      '110485204=    RETURNING G_PRODUCT'
      '110485205=    INTO :G_PRODUCT_;'
      '110485206='
      '110485207=    -- '#1057#1056#1040#1047#1059' '#1044#1054#1041#1040#1042#1051#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1059' '#1054#1057#1058#1040#1058#1050#1054#1042
      '110485208=    if (:IS_CATEGORY_ = 0) then begin'
      
        '110485209=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110485210=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2));'
      '110485211='
      '110485212=        INSERT INTO LT_BARCODE'
      
        '110485213=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110485214='
      
        '110485215=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1092#1086#1090#1086#1075#1088#1072#1092#1080#1080', '#1090#1086' '#1074#1089#1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090 +
        #1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091
      '110485216=        INSERT into G_PRODUCT_IMAGE'
      
        '110485217=        select G_PRODUCT_IMAGE, :G_PRODUCT_, BODY, TYP' +
        'E from G_PRODUCT_IMAGE_TMP;'
      '110485218='
      
        '110485219=        -- '#1077#1089#1083#1080' '#1077#1089#1090#1100' '#1050#1054#1052#1055#1051#1045#1050#1058' '#1057#1054#1057#1058#1040#1042#1053#1067#1061' '#1058#1054#1042#1040#1056#1054#1042', '#1090#1086' '#1074#1089 +
        #1090#1072#1074#1083#1103#1102' '#1080#1093' '#1074' '#1087#1086#1089#1090#1086#1103#1085#1085#1091#1102' '#1090#1072#1073#1083#1080#1094#1091', '#1048' '#1052#1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      
        '110485220=        -- '#1058#1054#1051#1068#1050#1054' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088', '#1072' '#1085#1077' '#1087#1088#1086#1076#1091 +
        #1082#1090', '#1087#1088#1086#1076#1091#1082#1090#1099' '#1073#1091#1076#1091#1090' '#1087#1088#1086#1080#1079#1074#1086#1076#1080#1090#1100#1089#1103
      '110485221=        IF (is_kit_ > 0) THEN begin'
      '110485222=            INSERT INTO G_PRODUCT_KIT'
      
        '110485223=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP;'
      '110485224='
      '110485225=            if (is_kit_ = 1) then begin'
      
        '110485226=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110485227=                  FROM G_PRODUCT_KIT K,'
      '110485228=                       LT_SKLAD_PRODUCT L'
      '110485229=                 WHERE K.g_product = :G_PRODUCT_'
      '110485230=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110485231=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110485232=                 GROUP BY K.G_PRODUCT'
      '110485233=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110485234='
      '110485235=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110485236=                   SET L.AMOUNT = COALESCE(:G_PRODUCT_' +
        'SOSTAV_AMOUNT_, 0)'
      '110485237=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110485238=            end'
      '110485239=        END'
      '110485240=    END'
      '110485241=end'
      '110485242='#39';'
      '110485243='
      '110485244=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110485245=  G_PRODUCT_ INTEGER,'
      '110485246=  G_PRODUCT_PAR_ INTEGER,'
      '110485247=  ARTICUL_ VARCHAR(30),'
      '110485248=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110485249=  BARCODE_ VARCHAR(30),'
      '110485250=  NAME_ VARCHAR(500),'
      '110485251=  G_UNIT_ INTEGER,'
      '110485252=  PRICE_ NUMERIC(15,2),'
      '110485253=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110485254=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110485255=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110485256=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110485257=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110485258=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110485259=  IS_CATEGORY_ INTEGER,'
      '110485260=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110485261=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE)'
      '110485262=RETURNS ('
      '110485263=  ERR_CODE INTEGER,'
      '110485264=  ERR_MSG VARCHAR(1024))'
      '110485265=AS'
      
        '110485266=declare variable PROCNAME varchar(15) = '#39#39'G_UPD_G_PROD' +
        'UCT'#39#39';'
      '110485267=declare variable N_CURR_ integer;'
      '110485268=declare variable N integer;'
      '110485269=declare variable CNT_ integer;'
      
        '110485270=declare variable G_PRODUCT_SOSTAV_AMOUNT_ type of colu' +
        'mn LT_SKLAD_PRODUCT.AMOUNT;'
      '110485271=begin'
      
        '110485272=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110485273=    SELECT COUNT(*)'
      '110485274=      FROM G_PRODUCT G'
      '110485275=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '110485276=       AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '110485277=       AND TRIM(:ARTICUL_) <> '#39#39#39#39
      '110485278=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110485279=      INTO :CNT_;'
      '110485280='
      '110485281=    IF (CNT_ > 0) THEN BEGIN'
      '110485282=      ERR_CODE = -20500;'
      
        '110485283=      ERR_MSG  = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39'||ARTICUL_||'#39#39' ' +
        #1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39';'
      '110485284=      EXIT;'
      '110485285=    END'
      '110485286='
      '110485287=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110485288=    SELECT COUNT(*)'
      '110485289=      FROM G_PRODUCT G'
      
        '110485290=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOME' +
        'NCLATUR_NUM_))'
      '110485291=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39#39#39
      '110485292=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39#39#39
      '110485293=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '110485294=    INTO :CNT_;'
      '110485295=    IF (CNT_ > 0) THEN BEGIN'
      '110485296=      ERR_CODE = -20500;'
      
        '110485297=      ERR_MSG  = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||NOMENC' +
        'LATUR_NUM_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39';'
      '110485298=      EXIT;'
      '110485299=    END'
      '110485300='
      '110485301=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110485302=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110485303=        SELECT COUNT(*)'
      '110485304=          FROM G_PRODUCT G'
      
        '110485305=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_' +
        '))'
      '110485306=           AND TRIM(G.BARCODE) <> '#39#39#39#39
      '110485307=           AND TRIM(:BARCODE_) <> '#39#39#39#39
      '110485308=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '110485309=          INTO :CNT_;'
      '110485310='
      '110485311=        IF (CNT_ = 0) then'
      '110485312=          SELECT COUNT(*)'
      '110485313=            FROM G_PRODUCT G, LT_BARCODE L'
      '110485314=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110485315=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110485316=             AND TRIM(L.BARCODE) <> '#39#39#39#39
      '110485317=            INTO :CNT_;'
      '110485318='
      '110485319=        IF (CNT_ > 0) THEN BEGIN'
      '110485320=          ERR_CODE = -20500;'
      
        '110485321=          ERR_MSG  = '#39#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39#39'||:BARCOD' +
        'E_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39';'
      '110485322=          EXIT;'
      '110485323=        END'
      '110485324=    END'
      '110485325='
      '110485326=    update G_PRODUCT'
      '110485327=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110485328=        ARTICUL = :ARTICUL_,'
      '110485329=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110485330=        BARCODE = :BARCODE_,'
      '110485331=        NAME = :NAME_,'
      '110485332=        G_UNIT = :G_UNIT_,'
      '110485333=        PRICE = :PRICE_,'
      '110485334=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110485335=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110485336=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110485337=        NOTE         = :NOTE_,'
      '110485338=        CROSSCODE    = :CROSSCODE_,'
      '110485339=        IS_KIT       = :IS_KIT_,'
      '110485340=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110485341=        PLACE   = :PLACE_'
      '110485342=    where (G_PRODUCT = :G_PRODUCT_);'
      '110485343='
      '110485344=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110485345=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110485346='
      '110485347=        INSERT INTO LT_BARCODE'
      
        '110485348=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110485349='
      '110485350=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110485351=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110485352=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110485353='
      
        '110485354=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE);'
      '110485355='
      '110485356=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110485357=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110485358=            INSERT INTO G_PRODUCT_KIT'
      
        '110485359=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110485360=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110485361=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110485362=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110485363='
      
        '110485364=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110485365=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110485366='
      '110485367=            UPDATE G_PRODUCT_KIT G'
      
        '110485368=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110485369=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110485370=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110485371=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110485372='
      
        '110485373=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110485374=            if (is_kit_ = 1) then begin'
      '110485375=                SELECT MIN(L.AMOUNT)'
      '110485376=                  FROM G_PRODUCT_KIT K,'
      '110485377=                       LT_SKLAD_PRODUCT L'
      '110485378=                 WHERE K.g_product = :G_PRODUCT_'
      '110485379=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110485380=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110485381=                 GROUP BY K.G_PRODUCT'
      '110485382=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110485383='
      '110485384=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110485385=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110485386=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110485387=            end'
      '110485388=        END'
      '110485389=    END'
      '110485390=end'
      '110485391='#39';'
      '110485392=END  --END_EXECUTE_BLOCK'
      '110485393=EXECUTE BLOCK AS BEGIN'
      '110485394='
      
        '110485395=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_LAST_SELF_PRICE' +
        '('
      '110485396=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110485397=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110485398=  MODE_ INTEGER)'
      '110485399=RETURNS ('
      '110485400=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '110485401=AS'
      
        '110485402=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE;'
      '110485403=BEGIN'
      '110485404=  IF (G_TOCHKA_ IS NULL) THEN'
      '110485405=    SELECT ID'
      '110485406=      FROM CUR_PARAMS'
      '110485407=     WHERE CUR_PARAMS = 2'
      '110485408=      INTO :G_TOCHKA_;'
      '110485409='
      '110485410=  if (COALESCE(MODE_, 0) = 0) then'
      '110485411=      SELECT S.PRICE'
      '110485412=        FROM SKLAD S'
      '110485413=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110485414=         AND S.IS_LAST = 1'
      '110485415=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110485416=        INTO :PRICE_;'
      '110485417='
      
        '110485418=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047 +
        #1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '110485419=  ELSE BEGIN'
      '110485420=    SELECT S.S_VALUE'
      '110485421=      FROM SYSTEM_SETUP S'
      '110485422=     WHERE S.SYSTEM_SETUP = 1'
      '110485423=      INTO :FORMULA_;'
      '110485424='
      '110485425=    IF (FORMULA_ = 1) THEN BEGIN'
      '110485426=      SELECT S.PRICE'
      '110485427=        FROM SKLAD S'
      '110485428=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110485429=         AND S.IS_LAST = 1'
      '110485430=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110485431=        INTO :PRICE_;'
      '110485432='
      
        '110485433=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045 +
        #1058' '#1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052 +
        #1048'" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '110485434=      IF (ROW_COUNT = 0) THEN'
      '110485435=        SELECT S.PRICE'
      '110485436=          FROM SKLAD S'
      '110485437=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110485438=                            FROM SKLAD SS'
      
        '110485439=                           WHERE /*SS.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '110485440=                             AND */SS.G_PRODUCT = :G_P' +
        'RODUCT_'
      
        '110485441=                             AND SS.DATE_RECEIPT = (SE' +
        'LECT MAX(SSS.DATE_RECEIPT)'
      
        '110485442=                                                      ' +
        'FROM SKLAD SSS'
      
        '110485443=                                                     W' +
        'HERE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '110485444=                                                      ' +
        ' AND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '110485445=                                                      ' +
        ' AND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '110485446=                                                   )'
      
        '110485447=                             AND SS.IS_VOZVRAT IN (0, ' +
        '4) --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '110485448=                         )'
      '110485449=          INTO :PRICE_;'
      '110485450=    END ELSE'
      
        '110485451=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUN' +
        'T), 2)'
      '110485452=        FROM (SELECT S.AMOUNT, S.PRICE'
      '110485453=                FROM SKLAD_PARENT SP,'
      '110485454=                     SKLAD S'
      '110485455=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '110485456=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '110485457=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '110485458=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '110485459=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.' +
        'IS_VOZVRAT IN (0, 3, 4)'
      
        '110485460=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO' +
        ' 5) T'
      '110485461=        INTO :PRICE_;'
      '110485462=  END'
      '110485463='
      '110485464=  PRICE_ = COALESCE(:PRICE_, 0);'
      '110485465=  SUSPEND;'
      '110485466=END'
      '110485467='#39';'
      '110485468='
      '110485469=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SKLAD('
      '110485470=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110485471=  MODE_ INTEGER)'
      '110485472=RETURNS ('
      '110485473=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '110485474=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110485475=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110485476=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '110485477=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '110485478=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110485479=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110485480=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110485481=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110485482=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY,'
      
        '110485483=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '110485484=  CNT_T_ INTEGER,'
      
        '110485485=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110485486=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110485487=  HAVERIGHT_ INTEGER,'
      '110485488=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110485489=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ','
      '110485490=  ERR_CODE INTEGER,'
      '110485491=  ERR_MSG VARCHAR(1024))'
      '110485492=AS'
      '110485493=/*'
      
        '110485494=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083 +
        #1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '110485495=*/'
      
        '110485496=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110485497=begin'
      
        '110485498=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080 +
        ' INS '#1080' '#1087#1088#1080' UPD'
      '110485499=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110485500=  CNT_T_ = 0;'
      '110485501=  SELECT COUNT(*)'
      '110485502=    FROM (SELECT S.SKLAD'
      '110485503=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '110485504=    INTO :CNT_T_;'
      '110485505='
      '110485506=  SELECT'
      '110485507=    T.DATE_RECEIPT,'
      '110485508=    T.TIME_RECEIPT,'
      '110485509=    T.G_CLIENT,'
      '110485510=    T.G_PAYMENT_TYPE,'
      '110485511=    T.OSNOVANIE,'
      '110485512=    T.NOTE,'
      '110485513=    T.SUMM,'
      '110485514=    T.SUMM_FACT,'
      '110485515=    T.IS_PAYED_ALL'
      '110485516=    ,T.SUMM_CURRENCY'
      '110485517=    ,T.is_expected'
      '110485518=  FROM SKLAD_PARENT T'
      '110485519=  WHERE T.SKLAD = :SKLAD_'
      '110485520=  INTO'
      '110485521=    :DATE_RECEIPT_,'
      '110485522=    :TIME_RECEIPT_,'
      '110485523=    :G_CLIENT_,'
      '110485524=    :G_PAYMENT_TYPE_,'
      '110485525=    :OSNOVANIE_,'
      '110485526=    :NOTE_,'
      '110485527=    :SUMM_,'
      '110485528=    :SUMM_FACT_,'
      '110485529=    :IS_PAYED_ALL_'
      '110485530=    ,:SUMM_CURRENCY_'
      '110485531=    ,:IS_EXPECTED_;'
      '110485532='
      '110485533=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110485534=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY)'
      
        '110485535=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), G_PRODUCT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, :SKLAD_,' +
        ' PRICE_CURRENCY, SUMM_CURRENCY'
      '110485536=    FROM SKLAD'
      '110485537=   WHERE SKLAD_PARENT = :SKLAD_'
      '110485538=   ORDER BY SKLAD;'
      '110485539='
      '110485540=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110485541=  SELECT K.G_PRIHOD_RASHOD,'
      '110485542=         K.SUMM'
      
        '110485543=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110485544=   WHERE K.SKLAD = :SKLAD_'
      '110485545=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110485546=    INTO :G_PRIHOD_,'
      '110485547=         :SUMM_PRIHOD_;'
      '110485548='
      
        '110485549=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110485550='
      '110485551=  HaveRight_ = 1;'
      '110485552=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110485553=    SELECT ID'
      '110485554=      FROM CUR_PARAMS'
      '110485555=     WHERE CUR_PARAMS = 1'
      '110485556=      INTO :G_OFFICIAL_CUR_;'
      '110485557='
      
        '110485558=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110485559=      HaveRight_ = 1;'
      '110485560=    else'
      
        '110485561=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110485562=  END'
      '110485563=end'
      '110485564='#39';'
      '110485565='
      '110485566=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_SKLAD_TMP('
      '110485567=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD)'
      '110485568=RETURNS ('
      '110485569=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110485570=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110485571=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110485572=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '110485573=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '110485574=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110485575=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110485576=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110485577=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110485578=  ERR_CODE INTEGER,'
      '110485579=  ERR_MSG VARCHAR(1024))'
      '110485580=AS'
      '110485581=begin'
      '110485582=  SELECT'
      '110485583=    T.G_PRODUCT,'
      '110485584=    T.AMOUNT,'
      '110485585=    T.PRICE,'
      '110485586=    T.SUMM,'
      '110485587=    T.PRICE_CURRENCY,'
      '110485588=    T.SUMM_CURRENCY,'
      '110485589=    T.NDS,'
      '110485590=    T.NDS_SUMM,'
      '110485591=    P.NAME'
      
        '110485592=  FROM SKLAD_TMP T LEFT OUTER JOIN G_PRODUCT P ON T.G_' +
        'PRODUCT = P.G_PRODUCT'
      '110485593=  WHERE T.SKLAD = :SKLAD_'
      '110485594=  INTO'
      '110485595=    :G_PRODUCT_,'
      '110485596=    :AMOUNT_,'
      '110485597=    :PRICE_,'
      '110485598=    :SUMM_,'
      '110485599=    :PRICE_CURRENCY_,'
      '110485600=    :SUMM_CURRENCY_,'
      '110485601=    :NDS_,'
      '110485602=    :NDS_SUMM_,'
      '110485603=    :G_PROD_NAME_;'
      '110485604=end'
      '110485605='#39';'
      '110485606='
      '110485607=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_TOVS_BY_ZAKAZ('
      '110485608=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '110485609=RETURNS ('
      '110485610=  TOVAR_ VARCHAR(1500))'
      '110485611=AS'
      '110485612=BEGIN'
      '110485613='
      '110485614=  SELECT SUBSTRING((SELECT'
      
        '110485615=                      LIST(G.NAME||'#39#39'('#39#39'||D.AMOUNT||'#39#39 +
        ')'#39#39', '#39#39', '#39#39')'
      
        '110485616=                    FROM ZAKAZ Z, ZAKAZ_DETAILS D, G_P' +
        'RODUCT G'
      '110485617=                    WHERE D.G_PRODUCT = G.G_PRODUCT'
      '110485618=                      AND D.ZAKAZ = Z.ZAKAZ'
      
        '110485619=                      AND Z.ZAKAZ = :ZAKAZ_) FROM 1 FO' +
        'R 1500)'
      '110485620=    FROM RDB$DATABASE'
      '110485621=    INTO TOVAR_;'
      '110485622='
      '110485623=  SUSPEND;'
      '110485624=end'
      '110485625='#39';'
      '110485626='
      '110485627=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '110485628=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110485629=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '110485630=RETURNS ('
      '110485631=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110485632=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110485633=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110485634=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110485635=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110485636=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110485637=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110485638=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110485639=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110485640=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110485641=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110485642=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110485643=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110485644=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110485645=  CNT_Z_ INTEGER,'
      
        '110485646=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110485647=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110485648=  HAVERIGHT_ INTEGER,'
      '110485649=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110485650=  ERR_CODE INTEGER,'
      '110485651=  ERR_MSG VARCHAR(1024))'
      '110485652=AS'
      
        '110485653=declare variable G_OFFICIAL_CUR_ type of column G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110485654=begin'
      '110485655=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110485656=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '110485657=          SELECT'
      '110485658=            T.G_TOCHKA,'
      '110485659=            T.Z_DATE,'
      '110485660=            T.Z_TIME,'
      '110485661=            T.G_CLIENT,'
      '110485662=            T.G_PAYMENT_TYPE,'
      '110485663=            T.OSNOVANIE,'
      '110485664=            T.NOTE,'
      '110485665=            T.SUMM,'
      '110485666=            T.SUMM_FACT,'
      '110485667=            T.SUMM_BONUS,'
      '110485668=            T.summ_bonus_got,'
      '110485669=            T.IS_PAYED_ALL,'
      '110485670=            COALESCE(T.BY_RECIPE, 0)'
      '110485671=            ,IS_RESERVE'
      '110485672=          FROM ZAKAZ T'
      '110485673=          WHERE T.ZAKAZ = :ZAKAZ_'
      '110485674=          INTO'
      '110485675=            :G_TOCHKA_,'
      '110485676=            :Z_DATE_,'
      '110485677=            :Z_TIME_,'
      '110485678=            :G_CLIENT_,'
      '110485679=            :G_PAYMENT_TYPE_,'
      '110485680=            :OSNOVANIE_,'
      '110485681=            :NOTE_,'
      '110485682=            :SUMM_,'
      '110485683=            :SUMM_FACT_,'
      '110485684=            :SUMM_PAY_BONUS_,'
      '110485685=            :SUMM_GOT_BONUS_,'
      '110485686=            :IS_PAYED_ALL_,'
      '110485687=            :BY_RECIPE_,'
      '110485688=            :IS_RESERVE_;'
      '110485689='
      '110485690=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '110485691=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS,' +
        ' ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_' +
        'TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '110485692=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AM' +
        'OUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM,' +
        ' NDS, NDS_SUMM, COST_PRICE'
      '110485693=              FROM ZAKAZ_DETAILS'
      '110485694=             WHERE ZAKAZ = :ZAKAZ_'
      '110485695=             ORDER BY 1;'
      '110485696='
      '110485697=          SELECT K.G_PRIHOD_RASHOD,'
      '110485698=                 K.SUMM'
      
        '110485699=            FROM (SELECT * FROM KASSA UNION SELECT * F' +
        'ROM KASSA_BEZNAL) K'
      '110485700=           WHERE K.ZAKAZ = :ZAKAZ_'
      '110485701=             AND K.G_PRIHOD_RASHOD <> 1'
      '110485702=            INTO :G_PRIHOD_,'
      '110485703=                 :SUMM_PRIHOD_;'
      '110485704=      END'
      '110485705='
      
        '110485706=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RET' +
        'URNING_VALUES :PAYMENTS_;'
      '110485707=  END'
      '110485708=  ELSE BEGIN'
      '110485709=    SELECT'
      '110485710=        T.G_CLIENT,'
      '110485711=        T.DATE_RECEIPT,'
      '110485712=        T.TIME_RECEIPT,'
      '110485713=        T.G_TOCHKA,'
      '110485714=        T.G_PAYMENT_TYPE,'
      '110485715=        T.OSNOVANIE,'
      '110485716=        T.NOTE,'
      '110485717=        T.SUMM,'
      '110485718=        T.SUMM_FACT,'
      '110485719=        0,'
      '110485720=        0,'
      '110485721=        0'
      '110485722=      FROM SKLAD_PARENT T'
      '110485723=      WHERE T.SKLAD = :ZAKAZ_'
      '110485724=      INTO'
      '110485725=        :G_TOCHKA_,'
      '110485726=        :Z_DATE_,'
      '110485727=        :Z_TIME_,'
      '110485728=        :G_CLIENT_,'
      '110485729=        :G_PAYMENT_TYPE_,'
      '110485730=        :OSNOVANIE_,'
      '110485731=        :NOTE_,'
      '110485732=        :SUMM_,'
      '110485733=        :SUMM_FACT_,'
      '110485734=        :SUMM_PAY_BONUS_,'
      '110485735=        :IS_PAYED_ALL_,'
      '110485736=        :BY_RECIPE_;'
      '110485737='
      
        '110485738=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '110485739=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '110485740=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE,' +
        ' SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047#1040 +
        #1055#1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '110485741=        FROM SKLAD'
      '110485742=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '110485743=      ORDER BY 1;'
      '110485744=  END'
      '110485745='
      '110485746=  HaveRight_ = 1;'
      '110485747=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '110485748=    SELECT ID'
      '110485749=      FROM CUR_PARAMS'
      '110485750=     WHERE CUR_PARAMS = 1'
      '110485751=      INTO :G_OFFICIAL_CUR_;'
      '110485752='
      '110485753=    if (G_OFFICIAL_CUR_ IS NULL) then'
      '110485754=      HaveRight_ = 1;'
      '110485755=    else'
      
        '110485756=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110485757=  END'
      '110485758=end'
      '110485759='#39';'
      '110485760='
      
        '110485761=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_ZAKAZ_DETAILS_R' +
        'EAL('
      '110485762=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110485763=  IS_VOZVRAT_ INTEGER)'
      '110485764=RETURNS ('
      '110485765=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110485766=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110485767=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110485768=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110485769=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110485770=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110485771=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110485772=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110485773=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110485774=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110485775=  CNT_Z_ INTEGER,'
      
        '110485776=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110485777=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110485778=  ERR_CODE INTEGER,'
      '110485779=  ERR_MSG VARCHAR(1024))'
      '110485780=AS'
      '110485781=begin'
      '110485782=      SELECT'
      '110485783=        T.G_TOCHKA,'
      '110485784=        T.Z_DATE,'
      '110485785=        T.Z_TIME,'
      '110485786=        T.G_CLIENT,'
      '110485787=        T.G_PAYMENT_TYPE,'
      '110485788=        T.OSNOVANIE,'
      '110485789=        T.NOTE,'
      '110485790=        T.SUMM,'
      '110485791=        T.SUMM_FACT,'
      '110485792=        T.IS_PAYED_ALL'
      '110485793=      FROM ZAKAZ T'
      '110485794=      WHERE T.ZAKAZ = :ZAKAZ_'
      '110485795=        AND :IS_VOZVRAT_ = 0'
      '110485796=      UNION ALL'
      '110485797=      SELECT'
      '110485798=        0 G_TOCHKA,'
      '110485799=        T.DATE_RECEIPT,'
      '110485800=        T.TIME_RECEIPT,'
      '110485801=        T.G_CLIENT,'
      '110485802=        T.G_PAYMENT_TYPE,'
      '110485803=        T.OSNOVANIE,'
      '110485804=        T.NOTE,'
      '110485805=        T.SUMM,'
      '110485806=        T.SUMM_FACT,'
      '110485807=        T.IS_PAYED_ALL'
      '110485808=      FROM SKLAD_PARENT T'
      '110485809=      WHERE T.SKLAD = :ZAKAZ_'
      '110485810=        AND :IS_VOZVRAT_ = 1'
      '110485811=      INTO'
      '110485812=        :G_TOCHKA_,'
      '110485813=        :Z_DATE_,'
      '110485814=        :Z_TIME_,'
      '110485815=        :G_CLIENT_,'
      '110485816=        :G_PAYMENT_TYPE_,'
      '110485817=        :OSNOVANIE_,'
      '110485818=        :NOTE_,'
      '110485819=        :SUMM_,'
      '110485820=        :SUMM_FACT_,'
      '110485821=        :IS_PAYED_ALL_;'
      '110485822='
      
        '110485823=      INSERT INTO ZAKAZ_DETAILS_TMP_REAL(ZAKAZ_DETAILS' +
        ', ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM,'
      
        '110485824=                                         DISCOUNT_PERC' +
        ', DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM, IS_ADDED_FOR_UPD' +
        'ATE, ZAKAZ_NA_REAL, COST_PRICE)'
      
        '110485825=        SELECT Z.ZAKAZ_DETAILS, Z.ZAKAZ, Z.G_PRODUCT, ' +
        'Z.AMOUNT, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.' +
        'DISCOUNT_SUMM, Z.NDS, Z.NDS_SUMM, 1, L.ZAKAZ_NA_REAL, Z.cost_pri' +
        'ce'
      '110485826=          FROM ZAKAZ_DETAILS Z, LT_ZAKAZ_REAL L'
      '110485827=         WHERE ZAKAZ = :ZAKAZ_'
      '110485828=           AND Z.ZAKAZ_DETAILS = L.ZAKAZ_DETAILS'
      '110485829=           AND :IS_VOZVRAT_ = 0'
      '110485830=        UNION ALL'
      
        '110485831=        SELECT S.SKLAD ZAKAZ_DETAILS, S.SKLAD_PARENT Z' +
        'AKAZ, S.G_PRODUCT, S.AMOUNT, S.PRICE, S.SUMM, 0 DISCOUNT_PERC, 0' +
        ' DISCOUNT_TENGE, 0 DISCOUNT_SUMM, S.NDS, S.NDS_SUMM, 1, L.ZAKAZ_' +
        'NA_REAL, 0 COST_PRICE'
      '110485832=          FROM SKLAD S, LT_ZAKAZ_REAL L'
      '110485833=         WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '110485834=           AND S.SKLAD = L.SKLAD'
      '110485835=           AND :IS_VOZVRAT_ = 1'
      '110485836=        ORDER BY 1;'
      '110485837=end'
      '110485838='#39';'
      '110485839='
      
        '110485840=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_ZAKAZ_DETAILS_T' +
        'MP('
      
        '110485841=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS)'
      '110485842=RETURNS ('
      
        '110485843=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110485844=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110485845=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110485846=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110485847=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '110485848=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '110485849=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '110485850=  NDS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '110485851=  NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '110485852=  TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110485853=  ROZN_PRICE_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110485854=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110485855=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110485856=  OSTATOK_ INTEGER,'
      '110485857=  CNT_Z_ INTEGER,'
      '110485858=  ERR_CODE INTEGER,'
      '110485859=  ERR_MSG VARCHAR(1024))'
      '110485860=AS'
      '110485861=BEGIN'
      '110485862=  SELECT'
      '110485863=    t.G_PRODUCT,'
      '110485864=    t.AMOUNT,'
      '110485865=    t.PRICE,'
      '110485866=    t.SUMM,'
      '110485867=    t.DISCOUNT_PERC,'
      '110485868=    T.DISCOUNT_TENGE,'
      '110485869=    T.DISCOUNT_SUMM,'
      '110485870=    T.NDS,'
      '110485871=    T.NDS_SUMM,'
      '110485872=    G.NAME,'
      '110485873=    G.price,'
      '110485874=    G.VOLUME_PRICE,'
      '110485875=    G.PACK_AMOUNT,'
      '110485876=    LT.AMOUNT'
      '110485877=  FROM ZAKAZ_DETAILS_TMP t,'
      
        '110485878=       G_PRODUCT G LEFT OUTER JOIN LT_SKLAD_PRODUCT LT' +
        ' ON G.G_PRODUCT = LT.G_PRODUCT AND LT.G_TOCHKA = (SELECT ID FROM' +
        ' CUR_PARAMS WHERE CUR_PARAMS = 2)'
      '110485879=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '110485880=    AND T.G_PRODUCT = G.G_PRODUCT'
      '110485881=  INTO'
      '110485882=    :G_PRODUCT_,'
      '110485883=    :AMOUNT_,'
      '110485884=    :PRICE_,'
      '110485885=    :SUMM_,'
      '110485886=    :DISCOUNT_PERC_,'
      '110485887=    :DISCOUNT_TENGE_,'
      '110485888=    :DISCOUNT_SUMM_,'
      '110485889=    :NDS_,'
      '110485890=    :NDS_SUMM_,'
      '110485891=    :TOVAR_NAME_,'
      '110485892=    :ROZN_PRICE_,'
      '110485893=    :VOLUME_PRICE_,'
      '110485894=    :PACK_AMOUNT_,'
      '110485895=    :OSTATOK_;'
      '110485896=end'
      '110485897='#39';'
      '110485898='
      '110485899=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_ZAKAZ_NA_REAL('
      
        '110485900=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL)'
      '110485901=RETURNS ('
      '110485902=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '110485903=  PRODUCT_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110485904=  PRICE_ TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      '110485905=  AMOUNT_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '110485906=  SUMM_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      
        '110485907=  AMOUNT_PAYED_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PA' +
        'YED,'
      '110485908=  SUMM_PAYED_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '110485909=  AMOUNT_RETURNED_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT' +
        '_RETURNED,'
      
        '110485910=  SUMM_RETURNED_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_RET' +
        'URNED,'
      
        '110485911=  AMOUNT_LEFT_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PAY' +
        'ED,'
      '110485912=  SUMM_LEFT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '110485913=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.IS_PAYED_' +
        'ALL,'
      '110485914=  ERR_CODE INTEGER,'
      '110485915=  ERR_MSG VARCHAR(1024))'
      '110485916=AS'
      '110485917=begin'
      '110485918=  SELECT Z.G_PRODUCT,'
      '110485919=         P.NAME,'
      '110485920=         Z.PRICE,'
      '110485921=         Z.AMOUNT_ALL,'
      '110485922=         Z.SUMM_ALL,'
      '110485923=         Z.AMOUNT_PAYED,'
      '110485924=         Z.SUMM_PAYED,'
      '110485925=         Z.AMOUNT_RETURNED,'
      '110485926=         Z.SUMM_RETURNED,'
      
        '110485927=         Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE(Z.AM' +
        'OUNT_RETURNED, 0),'
      
        '110485928=         Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.SUMM_R' +
        'ETURNED, 0),'
      '110485929=         Z.IS_PAYED_ALL'
      '110485930=    FROM ZAKAZ_NA_REAL Z, G_PRODUCT P'
      '110485931=   WHERE Z.G_PRODUCT = P.G_PRODUCT'
      '110485932=     AND Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110485933=  INTO :G_PRODUCT_,'
      '110485934=       :PRODUCT_NAME_,'
      '110485935=       :PRICE_,'
      '110485936=       :AMOUNT_ALL_,'
      '110485937=       :SUMM_ALL_,'
      '110485938=       :AMOUNT_PAYED_,'
      '110485939=       :SUMM_PAYED_,'
      '110485940=       :AMOUNT_RETURNED_,'
      '110485941=       :SUMM_RETURNED_,'
      '110485942=       :AMOUNT_LEFT_,'
      '110485943=       :SUMM_LEFT_,'
      '110485944=       :IS_PAYED_ALL_;'
      '110485945=end'
      '110485946='#39';'
      '110485947='
      
        '110485948=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_ZAKAZ_TOVAR_STR' +
        '('
      '110485949=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ)'
      '110485950=RETURNS ('
      '110485951=  STR_ VARCHAR(1000))'
      '110485952=AS'
      '110485953=-- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1045#1058' '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1048#1047' '#1044#1045#1058#1040#1051#1045#1049' '#1047#1040#1050#1040#1047#1040
      '110485954=DECLARE VARIABLE NAME TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110485955=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      '110485956=begin'
      '110485957=  FOR SELECT L.NAME,'
      '110485958=         Z.AMOUNT'
      '110485959=    FROM ZAKAZ_DETAILS Z,'
      '110485960=         G_PRODUCT L'
      '110485961=   WHERE ZAKAZ = :ZAKAZ_'
      '110485962=     AND Z.G_PRODUCT = L.G_PRODUCT'
      '110485963=  ORDER BY 1'
      '110485964=  INTO :NAME,'
      '110485965=       :AMOUNT'
      '110485966=  DO BEGIN'
      '110485967=    IF (:AMOUNT > 1) THEN BEGIN'
      '110485968=      IF (:STR_ IS NULL) THEN'
      
        '110485969=        STR_ = :NAME||'#39#39'('#39#39'||CAST(:AMOUNT AS CHARACTER' +
        ')||'#39#39')'#39#39';'
      '110485970=      ELSE'
      
        '110485971=        STR_ = STR_||'#39#39', '#39#39'||:NAME||'#39#39'('#39#39'||CAST(:AMOUN' +
        'T AS CHARACTER)||'#39#39')'#39#39';'
      '110485972=    END ELSE BEGIN'
      '110485973=      IF (:STR_ IS NULL) THEN'
      '110485974=        STR_ = :NAME;'
      '110485975=      ELSE'
      '110485976=        STR_ = STR_||'#39#39', '#39#39'||:NAME;'
      '110485977=    END'
      '110485978='
      '110485979=    SUSPEND;'
      '110485980=  END'
      '110485981=end'
      '110485982='#39';'
      '110485983='
      '110485984=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD('
      '110485985=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110485986=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110485987=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110485988=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110485989=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110485990=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110485991=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110485992=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110485993=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110485994=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110485995=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110485996=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110485997=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110485998=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110485999=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110486000=RETURNS ('
      '110486001=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110486002=  ERR_CODE INTEGER,'
      '110486003=  ERR_MSG VARCHAR(1024))'
      '110486004=AS'
      
        '110486005=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD'#39#39 +
        ';'
      '110486006=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110486007=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110486008=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110486009=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110486010=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110486011=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110486012=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110486013=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110486014=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110486015=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110486016=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT;'
      '110486017=DECLARE VARIABLE IS_THIS_LAST_ INTEGER;'
      
        '110486018=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110486019=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110486020=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110486021=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110486022=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110486023=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110486024=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110486025=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110486026=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110486027=BEGIN'
      '110486028='
      '110486029=  PNT_ = '#39#39'00'#39#39';'
      '110486030=  IS_THIS_LAST_ = 0;'
      '110486031='
      '110486032=  IF (G_TOCHKA_ IS NULL) THEN'
      '110486033=    SELECT ID'
      '110486034=      FROM CUR_PARAMS'
      '110486035=     WHERE CUR_PARAMS = 2'
      '110486036=      INTO :G_TOCHKA_;'
      '110486037='
      '110486038=  SELECT ID'
      '110486039=    FROM CUR_PARAMS'
      '110486040=   WHERE CUR_PARAMS = 1'
      '110486041=    INTO :G_OFFICIAL_;'
      '110486042='
      '110486043=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110486044=                            DATE_RECEIPT,'
      '110486045=                            TIME_RECEIPT,'
      '110486046=                            G_CLIENT,'
      '110486047=                            G_PAYMENT_TYPE,'
      '110486048=                            OSNOVANIE,'
      '110486049=                            NOTE,'
      '110486050=                            SUMM,'
      '110486051=                            SUMM_FACT,'
      '110486052=                            SUMM_CURRENCY,'
      '110486053=                            IS_PAYED_ALL,'
      '110486054=                            IS_VOZVRAT,'
      '110486055=                            G_TOCHKA'
      '110486056=                            ,G_OFFICIAL'
      '110486057=                            ,IS_EXPECTED)'
      '110486058=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110486059=          :DATE_RECEIPT_,'
      '110486060=          :TIME_RECEIPT_,'
      '110486061=          :G_CLIENT_,'
      '110486062=          :G_PAYMENT_TYPE_,'
      '110486063=          :OSNOVANIE_,'
      '110486064=          :NOTE_,'
      '110486065=          :SUMM_,'
      '110486066=          :SUMM_FACT_,'
      '110486067=          :SUMM_CURRENCY_,'
      '110486068=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),'
      '110486069=          :IS_VOZVRAT_,'
      '110486070=          :G_TOCHKA_'
      '110486071=          ,:G_OFFICIAL_'
      '110486072=          ,:IS_EXPECTED_)'
      '110486073=  RETURNING'
      '110486074=    SKLAD'
      '110486075=  INTO'
      '110486076=    :SKLAD_;'
      '110486077='
      '110486078=  PNT_ = '#39#39'01'#39#39';'
      '110486079=  FOR SELECT SKLAD,'
      '110486080=             G_PRODUCT,'
      '110486081=             AMOUNT,'
      '110486082=             PRICE,'
      '110486083=             SUMM,'
      '110486084=             NDS,'
      '110486085=             NDS_SUMM'
      '110486086=             ,PRICE_CURRENCY'
      '110486087=             ,SUMM_CURRENCY'
      '110486088=        FROM SKLAD_TMP'
      '110486089=      ORDER BY 1'
      '110486090=      INTO :SKLAD_TMP_,'
      '110486091=           :RG_PRODUCT_,'
      '110486092=           :RAMOUNT_,'
      '110486093=           :RPRICE_,'
      '110486094=           :RSUMM_,'
      '110486095=           :RNDS_,'
      '110486096=           :RNDS_SUMM_'
      '110486097=           ,:PRICE_CURRENCY_'
      '110486098=           ,:SUMM_CURRENCY_TMP_'
      '110486099=  DO BEGIN'
      '110486100=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      '110486101=      IS_THIS_LAST_ = 0;'
      '110486102=      SELECT MAX(SK.DATE_RECEIPT)'
      '110486103=        FROM SKLAD SK'
      '110486104=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110486105=         AND SK.IS_LAST = 1'
      '110486106=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110486107=        INTO :DATE_LAST_;'
      '110486108='
      
        '110486109=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN'
      '110486110=        UPDATE SKLAD SK'
      '110486111=           SET SK.IS_LAST = 0'
      '110486112=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110486113=           AND SK.IS_LAST = 1'
      '110486114=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110486115='
      '110486116=        IS_THIS_LAST_ = 1;'
      '110486117=      END'
      '110486118=    END'
      '110486119='
      '110486120=    INSERT INTO SKLAD'
      '110486121=    ('
      '110486122=     SKLAD,'
      '110486123=     SKLAD_PARENT,'
      '110486124=     DATE_RECEIPT,'
      '110486125=     G_CLIENT,'
      '110486126=     G_PRODUCT,'
      '110486127=     AMOUNT,'
      '110486128=     PRICE,'
      '110486129=     SUMM,'
      '110486130=     G_PAYMENT_TYPE,'
      '110486131=     OSNOVANIE,'
      '110486132=     NOTE,'
      '110486133=     NDS,'
      '110486134=     NDS_SUMM,'
      '110486135=     IS_LAST,'
      '110486136=     IS_VOZVRAT,'
      '110486137=     G_TOCHKA'
      '110486138=     ,PRICE_CURRENCY'
      '110486139=     ,SUMM_CURRENCY'
      '110486140=    ) VALUES ('
      '110486141=     :SKLAD_TMP_,'
      '110486142=     :SKLAD_,'
      '110486143=     :DATE_RECEIPT_,'
      '110486144=     :G_CLIENT_,'
      '110486145=     :RG_PRODUCT_,'
      '110486146=     :RAMOUNT_,'
      '110486147=     :RPRICE_,'
      '110486148=     :RSUMM_,'
      '110486149=     :G_PAYMENT_TYPE_,'
      '110486150=     :OSNOVANIE_,'
      '110486151=     :NOTE_,'
      '110486152=     :RNDS_,'
      '110486153=     :RNDS_SUMM_,'
      '110486154=     DECODE(:IS_THIS_LAST_, 1, 1, 0),'
      '110486155=     :IS_VOZVRAT_,'
      '110486156=     :G_TOCHKA_'
      '110486157=     ,:PRICE_CURRENCY_'
      '110486158=     ,:SUMM_CURRENCY_TMP_'
      '110486159=    );'
      '110486160='
      '110486161=    IF (IS_EXPECTED_ = 0) THEN BEGIN'
      '110486162=        PNT_ = '#39#39'02'#39#39';'
      '110486163=        UPDATE LT_SKLAD_PRODUCT L'
      '110486164=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110486165=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110486166=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110486167='
      '110486168=        IF (ROW_COUNT = 0) THEN'
      
        '110486169=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110486170=    END'
      '110486171=  END'
      '110486172=  PNT_ = '#39#39'05'#39#39';'
      
        '110486173=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110486174=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110486175=        G_PRIHOD_RASHOD_ = 3;'
      '110486176=      ELSE'
      '110486177=        G_PRIHOD_RASHOD_ = 2;'
      '110486178='
      '110486179=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110486180=          EXECUTE PROCEDURE K_INS_KASSA(1,'
      
        '110486181=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110486182=                                        :SUMM_FACT_,'
      
        '110486183=                                        :DATE_RECEIPT_' +
        ','
      '110486184=                                        NULL,'
      '110486185=                                        NULL,'
      '110486186=                                        :SKLAD_,'
      
        '110486187=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110486188=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110486189=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110486190=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110486191=            EXIT;'
      '110486192=          END'
      '110486193=      END ELSE BEGIN'
      '110486194=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110486195=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110486196=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110486197=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110486198=            ELSE'
      
        '110486199=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110486200='
      '110486201=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110486202=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110486203='
      
        '110486204=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110486205='
      '110486206=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      '110486207=                EXECUTE PROCEDURE K_INS_KASSA(1,'
      
        '110486208=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110486209=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110486210=                                              :PAYMENT' +
        '_DATE_,'
      '110486211=                                              NULL,'
      '110486212=                                              NULL,'
      '110486213=                                              :SKLAD_,'
      
        '110486214=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110486215=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110486216=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110486217=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110486218=                  EXIT;'
      '110486219=                END'
      '110486220=            END'
      '110486221=          END'
      '110486222=      END'
      '110486223=  END'
      '110486224='
      '110486225=  DELETE FROM SKLAD_TMP;'
      '110486226='
      '110486227=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '110486228=    EXECUTE PROCEDURE K_INS_KASSA(1,'
      '110486229=                                  G_PRIHOD_,'
      '110486230=                                  :SUMM_PRIHOD_,'
      '110486231=                                  :DATE_RECEIPT_,'
      '110486232=                                  NULL,'
      '110486233=                                  NULL,'
      '110486234=                                  :SKLAD_,'
      '110486235=                                  :G_PAYMENT_TYPE_,'
      
        '110486236=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110486237=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110486238=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110486239=      EXIT;'
      '110486240=    END'
      '110486241=  END'
      '110486242=end'
      '110486243='#39';'
      '110486244=END  --END_EXECUTE_BLOCK'
      '110486245=EXECUTE BLOCK AS BEGIN'
      '110486246='
      '110486247=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_SKLAD_TMP('
      '110486248=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110486249=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110486250=  PRICE_ NUMERIC(15,2),'
      '110486251=  SUMM_ NUMERIC(15,2),'
      '110486252=  NDS_ NUMERIC(15,2),'
      '110486253=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110486254=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110486255=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0)'
      '110486256=RETURNS ('
      '110486257=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110486258=  ERR_CODE INTEGER,'
      '110486259=  ERR_MSG VARCHAR(1024))'
      '110486260=AS'
      
        '110486261=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INS_SKLAD_T' +
        'MP'#39#39';'
      '110486262=BEGIN'
      '110486263=  SELECT T.SKLAD'
      '110486264=    FROM SKLAD_TMP T'
      '110486265=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110486266=     AND T.PRICE = :PRICE_'
      '110486267=    INTO :SKLAD_;'
      '110486268='
      '110486269=  IF (SKLAD_ IS NOT NULL) THEN'
      '110486270=    UPDATE SKLAD_TMP T'
      '110486271=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110486272=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110486273=     WHERE T.G_PRODUCT = :G_PRODUCT_;'
      '110486274='
      '110486275=  ELSE'
      
        '110486276=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY)'
      
        '110486277=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110486278=        ,:PRICE_CURRENCY_'
      '110486279=        ,:SUMM_CURRENCY_)'
      '110486280=      RETURNING SKLAD'
      '110486281=      INTO :SKLAD_;'
      '110486282=end'
      '110486283='#39';'
      '110486284='
      '110486285=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ('
      '110486286=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110486287=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110486288=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110486289=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110486290=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110486291=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110486292=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110486293=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110486294=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110486295=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110486296=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110486297=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110486298=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110486299=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110486300=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110486301=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110486302=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110486303=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110486304=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110486305=  IS_MEBEL_ INTEGER = 0,'
      
        '110486306=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110486307=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      '110486308=  ADDRESS_ TYPE OF COLUMN DELIVERY.ADDRESS = NULL,'
      '110486309=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL)'
      '110486310=RETURNS ('
      '110486311=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110486312=  ERR_CODE INTEGER,'
      '110486313=  ERR_MSG VARCHAR(1024))'
      '110486314=AS'
      '110486315=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'INS_ZAKAZ'#39#39';'
      '110486316=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110486317=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110486318=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110486319=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110486320=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110486321=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110486322=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110486323=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110486324=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110486325=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110486326=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110486327=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110486328=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110486329=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '110486330=DECLARE VARIABLE ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAK' +
        'AZ_REAL_PARENT.ZAKAZ_REAL_PARENT;'
      
        '110486331=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      '110486332=DECLARE VARIABLE CNT_ INTEGER;'
      '110486333=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110486334=DECLARE VARIABLE DATE_LAST_ DATE;'
      '110486335=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110486336=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110486337=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110486338=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110486339=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110486340=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110486341=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110486342=BEGIN'
      '110486343=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110486344=  IF (CNT_ = 0) THEN BEGIN'
      '110486345=    ERR_CODE = -20500;'
      
        '110486346=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1090' '#1090#1086#1074#1072 +
        #1088#1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100 +
        #1090#1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '110486347=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ 00 '#39#39'||ERR_MSG;'
      '110486348=    EXIT;'
      '110486349=  END'
      '110486350='
      '110486351=  IF (G_TOCHKA_ IS NULL) THEN'
      '110486352=    SELECT ID'
      '110486353=      FROM CUR_PARAMS'
      '110486354=     WHERE CUR_PARAMS = 2'
      '110486355=      INTO :G_TOCHKA_;'
      '110486356='
      '110486357=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110486358=      PNT_ = '#39#39'01'#39#39';'
      '110486359=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN'
      '110486360=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110486361=      ELSE'
      '110486362=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110486363=      SELECT ID'
      '110486364=        FROM CUR_PARAMS'
      '110486365=       WHERE CUR_PARAMS = 1'
      '110486366=        INTO :G_OFFICIAL_;'
      '110486367='
      '110486368=      INSERT INTO ZAKAZ'
      '110486369=      ('
      '110486370=       ZAKAZ,'
      '110486371=       G_TOCHKA,'
      '110486372=       Z_DATE,'
      '110486373=       Z_TIME,'
      '110486374=       G_CLIENT,'
      '110486375=       G_PAYMENT_TYPE,'
      '110486376=       OSNOVANIE,'
      '110486377=       IS_SPISANIE,'
      '110486378=       NOTE,'
      '110486379=       SUMM,'
      '110486380=       SUMM_FACT,'
      '110486381=       SUMM_BONUS,'
      '110486382=       IS_PAYED_ALL'
      '110486383=       ,G_OFFICIAL'
      '110486384=       ,BY_RECIPE'
      '110486385=       ,SUMM_BONUS_GOT'
      '110486386=       ,IS_RESERVE'
      '110486387=       ,SUMM_CASH'
      '110486388=       ,SUMM_NONCASH'
      '110486389=      ) VALUES ('
      '110486390=       GEN_ID(GEN_ZAKAZ, 1),'
      '110486391=       :G_TOCHKA_,'
      '110486392=       :Z_DATE_,'
      '110486393=       :Z_TIME_,'
      '110486394=       :G_CLIENT_,'
      '110486395=       :G_PAYMENT_TYPE_,'
      '110486396=       :OSNOVANIE_,'
      '110486397=       :IS_SPISANIE_,'
      '110486398=       :NOTE_,'
      '110486399=       :SUMM_,'
      '110486400=       :SUMM_FACT_1_,'
      '110486401=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110486402=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)'
      '110486403=       ,:G_OFFICIAL_'
      '110486404=       ,:BY_RECIPE_'
      '110486405=       ,:SUMM_BONUS_GOT_'
      '110486406=       ,:IS_RESERVE_'
      '110486407=       ,COALESCE(:SUMM_CASH_, 0)'
      '110486408=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110486409=      )'
      '110486410=      RETURNING'
      '110486411=        ZAKAZ'
      '110486412=      INTO'
      '110486413=        :ZAKAZ_;'
      '110486414='
      '110486415=      PNT_ = '#39#39'02'#39#39';'
      
        '110486416=      FOR SELECT ZAKAZ_DETAILS, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS' +
        '_SUMM, COST_PRICE'
      '110486417=            FROM ZAKAZ_DETAILS_TMP Z'
      '110486418=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110486419=              :G_PRODUCT,'
      '110486420=              :AMOUNT,'
      '110486421=              :PRICE,'
      '110486422=              :SUMM,'
      '110486423=              :DISCOUNT_PERC,'
      '110486424=              :DISCOUNT_TENGE,'
      '110486425=              :DISCOUNT_SUMM,'
      '110486426=              :NDS,'
      '110486427=              :NDS_SUMM,'
      '110486428=              :COST_PRICE'
      '110486429=      DO BEGIN'
      '110486430=        INSERT INTO ZAKAZ_DETAILS'
      '110486431=        VALUES('
      '110486432=          :ZAKAZ_DETAILS_TMP_,'
      '110486433=          :ZAKAZ_,'
      '110486434=          :G_PRODUCT,'
      '110486435=          :AMOUNT,'
      '110486436=          :PRICE,'
      '110486437=          :SUMM,'
      '110486438=          :DISCOUNT_PERC,'
      '110486439=          :DISCOUNT_TENGE,'
      '110486440=          :DISCOUNT_SUMM,'
      '110486441=          :NDS,'
      '110486442=          :NDS_SUMM,'
      '110486443=          :COST_PRICE'
      '110486444=        );'
      '110486445='
      '110486446=        IF (IS_RESERVE_ = 0) THEN BEGIN'
      '110486447=            UPDATE LT_SKLAD_PRODUCT L'
      '110486448=               SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110486449=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110486450=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110486451='
      '110486452=            PNT_ = '#39#39'04'#39#39';'
      
        '110486453=            IF ((ROW_COUNT = 0) AND ((SELECT S_VALUE F' +
        'ROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110486454=              Err_Code = -20500;'
      
        '110486455=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRO' +
        'DUCT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080 +
        ' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110486456=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110486457=              EXIT;'
      '110486458=            END ELSE if (ROW_COUNT = 0) then'
      
        '110486459=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110486460=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110486461=        END'
      '110486462='
      '110486463=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110486464=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110486465=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :AMOUNT'
      '110486466=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '110486467=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110486468=      END'
      '110486469='
      '110486470=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110486471=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110486472=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110486473=                PNT_ = '#39#39'05'#39#39';'
      '110486474=                EXECUTE PROCEDURE K_INS_KASSA(0,'
      '110486475=                                              1,'
      
        '110486476=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110486477=                                              :Z_DATE_' +
        ','
      '110486478=                                              NULL,'
      '110486479=                                              ZAKAZ_,'
      '110486480=                                              NULL,'
      
        '110486481=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110486482=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110486483=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110486484=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110486485=                  EXIT;'
      '110486486=                END'
      '110486487=            END'
      '110486488=        END ELSE BEGIN'
      
        '110486489=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110486490=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENT' +
        'S_);'
      
        '110486491=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110486492=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110486493=                ELSE'
      
        '110486494=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110486495='
      
        '110486496=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110486497=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110486498='
      
        '110486499=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110486500='
      '110486501=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      '110486502=                    EXECUTE PROCEDURE K_INS_KASSA(0,'
      '110486503=                                                  1,'
      
        '110486504=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110486505=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110486506=                                                  NULL' +
        ','
      
        '110486507=                                                  :ZAK' +
        'AZ_,'
      
        '110486508=                                                  NULL' +
        ','
      
        '110486509=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110486510=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110486511=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110486512=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110486513=                      EXIT;'
      '110486514=                    END'
      '110486515=                END'
      '110486516=            END'
      '110486517=        END'
      '110486518=      END'
      '110486519=      UPDATE G_DISCONT_CARD D'
      
        '110486520=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0) ' +
        '+ :SUMM_BONUS_GOT_,'
      '110486521=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110486522=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110486523=  END'
      '110486524=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '110486525=      PNT_ = '#39#39'25'#39#39';'
      
        '110486526=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
        'A)'
      
        '110486527=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLI' +
        'ENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA' +
        '_)'
      '110486528=      RETURNING ZAKAZ_REAL_PARENT'
      '110486529=      INTO :ZAKAZ_REAL_PARENT_;'
      '110486530='
      
        '110486531=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCO' +
        'UNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '110486532=            FROM ZAKAZ_DETAILS_TMP Z'
      '110486533=          INTO :G_PRODUCT,'
      '110486534=              :AMOUNT,'
      '110486535=              :PRICE,'
      '110486536=              :SUMM,'
      '110486537=              :DISCOUNT_PERC,'
      '110486538=              :DISCOUNT_TENGE,'
      '110486539=              :DISCOUNT_SUMM,'
      '110486540=              :NDS,'
      '110486541=              :NDS_SUMM'
      '110486542=      DO BEGIN'
      '110486543=          UPDATE LT_SKLAD_PRODUCT L'
      '110486544=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110486545=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '110486546=             AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '110486547=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FRO' +
        'M SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110486548=            Err_Code = -20500;'
      
        '110486549=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODU' +
        'CT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087 +
        #1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110486550=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110486551=            EXIT;'
      '110486552=          END ELSE if (ROW_COUNT = 0) then'
      
        '110486553=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRO' +
        'DUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110486554=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :' +
        'G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110486555='
      
        '110486556=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZA' +
        'KAZ_REAL_PARENT,'
      '110486557=                                     G_PRODUCT,'
      '110486558=                                     PRICE,'
      
        '110486559=                                     AMOUNT_ALL, SUMM_' +
        'ALL,'
      
        '110486560=                                     AMOUNT_PAYED, SUM' +
        'M_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_S' +
        'UMM, NDS,'
      '110486561=                                     NDS_SUMM)'
      
        '110486562=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ' +
        '_REAL_PARENT_,'
      '110486563=                  :G_PRODUCT,'
      '110486564=                  :PRICE - :DISCOUNT_TENGE,'
      '110486565=                  :AMOUNT, :SUMM,'
      '110486566=                  0,'
      '110486567=                  0,'
      '110486568=                  0,'
      '110486569=                  :DISCOUNT_PERC,'
      '110486570=                  :DISCOUNT_TENGE,'
      '110486571=                  :DISCOUNT_SUMM,'
      '110486572=                  :NDS,'
      '110486573=                  :NDS_SUMM)'
      '110486574=          RETURNING ZAKAZ_NA_REAL'
      '110486575=          INTO :ZAKAZ_;'
      '110486576=      END'
      '110486577=  END'
      '110486578=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '110486579=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, T' +
        'IME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SU' +
        'MM_FACT,'
      
        '110486580=                                IS_PAYED_ALL, IS_VOZVR' +
        'AT, G_TOCHKA)'
      
        '110486581=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_' +
        ', :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SU' +
        'MM_FACT_,'
      '110486582=              1, 3, :G_CLIENT_)'
      '110486583=      RETURNING SKLAD'
      '110486584=      INTO :SKLAD_;'
      '110486585='
      '110486586=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110486587=            FROM ZAKAZ_DETAILS_TMP Z'
      '110486588=          INTO :G_PRODUCT,'
      '110486589=              :AMOUNT,'
      '110486590=              :PRICE,'
      '110486591=              :SUMM'
      '110486592=      DO BEGIN'
      '110486593=        UPDATE LT_SKLAD_PRODUCT L'
      '110486594=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110486595=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110486596=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110486597='
      '110486598=        INSERT INTO SKLAD'
      '110486599=        ('
      '110486600=         SKLAD,'
      '110486601=         SKLAD_PARENT,'
      '110486602=         DATE_RECEIPT,'
      '110486603=         G_CLIENT,'
      '110486604=         G_PRODUCT,'
      '110486605=         AMOUNT,'
      '110486606=         PRICE,'
      '110486607=         SUMM,'
      '110486608=         G_PAYMENT_TYPE,'
      '110486609=         OSNOVANIE,'
      '110486610=         NOTE,'
      '110486611=         NDS,'
      '110486612=         NDS_SUMM,'
      '110486613=         IS_LAST,'
      '110486614=         IS_VOZVRAT,'
      '110486615=         G_TOCHKA'
      '110486616=        ) VALUES ('
      '110486617=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '110486618=         :SKLAD_,'
      '110486619=         :Z_DATE_,'
      '110486620=         :G_TOCHKA_,'
      '110486621=         :G_PRODUCT,'
      '110486622=         :AMOUNT,'
      '110486623=         :PRICE,'
      '110486624=         :SUMM,'
      '110486625=         :G_PAYMENT_TYPE_,'
      '110486626=         :OSNOVANIE_,'
      '110486627=         :NOTE_,'
      '110486628=         0,'
      '110486629=         0,'
      '110486630=         DECODE(:IS_THIS_LAST_, 1, 1, 0),'
      '110486631=         3,'
      '110486632=         :G_CLIENT_'
      '110486633=        );'
      '110486634='
      '110486635=        PNT_ = '#39#39'02'#39#39';'
      '110486636=        UPDATE LT_SKLAD_PRODUCT L'
      '110486637=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '110486638=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110486639=           AND L.G_TOCHKA = :G_CLIENT_;'
      '110486640='
      '110486641=        IF (ROW_COUNT = 0) THEN'
      
        '110486642=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '110486643=      END'
      '110486644=  END'
      '110486645='
      '110486646=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110486647='
      '110486648=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110486649=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =>' +
        ' :ACTION_'
      '110486650=                                  G_PRIHOD_,'
      '110486651=                                  :SUMM_PRIHOD_,'
      '110486652=                                  :Z_DATE_,'
      
        '110486653=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110486654=                                  :ZAKAZ_,'
      '110486655=                                  NULL,'
      '110486656=                                  :G_PAYMENT_TYPE_,'
      
        '110486657=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110486658=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110486659=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110486660=      EXIT;'
      '110486661=    END'
      '110486662=  END'
      '110486663='
      '110486664=  IF (IS_MEBEL_ = 1) THEN'
      
        '110486665=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS' +
        ', ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '110486666=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, ' +
        ':ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '110486667=end'
      '110486668='#39';'
      '110486669='
      
        '110486670=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ_DETAILS_T' +
        'MP('
      
        '110486671=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110486672=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110486673=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110486674=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110486675=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110486676=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110486677=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110486678=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110486679=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110486680=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110486681=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110486682=  IS_SPISANIE_ INTEGER,'
      '110486683=  NEW_LINE_SALE_ INTEGER = 0,'
      '110486684=  MODE_ INTEGER = 0)'
      '110486685=RETURNS ('
      
        '110486686=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110486687=  ERR_CODE INTEGER,'
      '110486688=  ERR_MSG VARCHAR(1024))'
      '110486689=AS'
      
        '110486690=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39#39';'
      
        '110486691=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110486692=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      '110486693=DECLARE VARIABLE ZAKAZ_ INTEGER = 0;'
      
        '110486694=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110486695=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110486696=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110486697=DECLARE VARIABLE AMOUNT__ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.AMOUNT;'
      
        '110486698=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110486699=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110486700=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE;'
      
        '110486701=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110486702=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      '110486703=BEGIN'
      '110486704='
      '110486705=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110486706=    FROM ZAKAZ_DETAILS_TMP T'
      '110486707=   WHERE T.ZAKAZ IS NOT NULL'
      '110486708=    ROWS 1 TO 1'
      '110486709=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110486710='
      '110486711=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT'
      '110486712=           ,G.IS_KIT'
      '110486713=           ,K.AMOUNT * :AMOUNT_'
      '110486714=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110486715=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      
        '110486716=           ,(SELECT * FROM GET_LAST_SELF_PRICE(K.G_PRO' +
        'DUCT_ITEM, NULL, 1)) COST_PRICE'
      
        '110486717=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110486718=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110486719=       AND IS_KIT = 1'
      '110486720=    UNION'
      '110486721=    SELECT :G_PRODUCT_'
      '110486722=           ,G.IS_KIT'
      '110486723=           ,:AMOUNT_'
      '110486724=           ,:PRICE_'
      '110486725=           ,0'
      '110486726=           ,:COST_PRICE_'
      '110486727=      FROM G_PRODUCT G'
      '110486728=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110486729=       AND IS_KIT <> 1'
      '110486730=      INTO :G_PRODUCT_'
      '110486731=           ,:IS_KIT_'
      '110486732=           ,:AMOUNT_'
      '110486733=           ,:PRICE__'
      '110486734=           ,:SOSTAV_PRICE_'
      '110486735=           ,:COST_PRICE__'
      '110486736=  DO BEGIN'
      '110486737=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110486738=        IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110486739=          PRICE__ = COST_PRICE__;'
      '110486740='
      '110486741=        END ELSE IF (Discount_perc_ <> 0) THEN BEGIN'
      
        '110486742=          DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PERC_/1' +
        '00;'
      '110486743='
      '110486744='
      
        '110486745=        END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN BEG' +
        'IN'
      
        '110486746=          DISCOUNT_PERC_ = PRICE_ * 100 / SOSTAV_PRICE' +
        '_;'
      '110486747=          DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_;'
      '110486748=        END'
      '110486749='
      '110486750=        DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT_;'
      '110486751=        SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOUNT_;'
      '110486752=        NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110486753=      END'
      '110486754='
      '110486755=      IF (NEW_LINE_SALE_ = 0) THEN'
      '110486756=          SELECT ZD.zakaz_details'
      '110486757=            FROM zakaz_details_tmp ZD'
      '110486758=           WHERE ZD.G_PRODUCT = :g_product_'
      '110486759=             AND ZD.PRICE = :PRICE__'
      '110486760=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110486761=            INTO :ZAKAZ_DTLS_TMP_;'
      '110486762='
      '110486763='
      '110486764=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110486765=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110486766=           SET P.amount = P.amount + :amount_'
      
        '110486767=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110486768=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110486769=               ,P.NDS = :NDS_'
      '110486770=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110486771=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110486772='
      '110486773=      ELSE BEGIN'
      '110486774=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110486775=          ('
      '110486776=           ZAKAZ_DETAILS,'
      '110486777=           ZAKAZ,'
      '110486778=           G_PRODUCT,'
      '110486779=           AMOUNT,'
      '110486780=           PRICE,'
      '110486781=           SUMM,'
      '110486782=           DISCOUNT_PERC,'
      '110486783=           DISCOUNT_TENGE,'
      '110486784=           DISCOUNT_SUMM,'
      '110486785=           NDS,'
      '110486786=           NDS_SUMM,'
      '110486787=           COST_PRICE'
      '110486788=          ) VALUES ('
      '110486789=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110486790=           :ZAKAZ_,'
      '110486791=           :G_PRODUCT_,'
      '110486792=           :AMOUNT_,'
      '110486793=           :PRICE__,'
      '110486794=           :SUMM_,'
      '110486795=           :DISCOUNT_PERC_,'
      '110486796=           :DISCOUNT_TENGE_,'
      '110486797=           :DISCOUNT_SUMM_,'
      '110486798=           :NDS_,'
      '110486799=           :NDS_SUMM_,'
      '110486800=           :COST_PRICE__'
      '110486801=          )'
      '110486802=          RETURNING'
      '110486803=            ZAKAZ_DETAILS'
      '110486804=          INTO'
      '110486805=            :ZAKAZ_DETAILS_;'
      '110486806=      END'
      '110486807=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110486808=        FROM LT_SKLAD_PRODUCT L'
      '110486809=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110486810=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110486811=       INTO :AMOUNT_CUR_;'
      '110486812='
      '110486813=      if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '110486814=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110486815=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110486816=              SELECT SUM(AMOUNT)'
      '110486817=                FROM ZAKAZ_DETAILS T'
      '110486818=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110486819=                 AND T.ZAKAZ = :ZAKAZ_'
      '110486820=                INTO :AMOUNT_OLD_;'
      '110486821=            ELSE'
      '110486822=              SELECT SUM(AMOUNT)'
      '110486823=                FROM SKLAD T'
      '110486824=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110486825=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '110486826=                INTO :AMOUNT_OLD_;'
      '110486827=          END'
      '110486828=          SELECT SUM(AMOUNT)'
      '110486829=            FROM ZAKAZ_DETAILS_TMP T'
      '110486830=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110486831=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '110486832='
      
        '110486833=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKA' +
        'Z_, 0);'
      
        '110486834=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0)' +
        ';'
      '110486835='
      
        '110486836=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COA' +
        'LESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110486837=            SELECT NAME'
      '110486838=            FROM G_PRODUCT'
      '110486839=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110486840=            INTO :PRODUCT_NAME_;'
      '110486841='
      '110486842=            ERR_CODE = -20500;'
      
        '110486843=            ERR_MSG = '#39#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39#39'||PRODUCT' +
        '_NAME_||'#39#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39#39'||ASCII_CHAR(10)||'
      
        '110486844=                      '#39#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39#39';'
      
        '110486845=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110486846=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110486847=            EXIT;'
      '110486848=          END'
      '110486849=      END'
      '110486850=  END'
      '110486851=end'
      '110486852='#39';'
      '110486853='
      
        '110486854=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ_DETAILS_T' +
        'MP_REAL('
      
        '110486855=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110486856=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110486857=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110486858=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110486859=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '110486860=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '110486861=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      '110486862=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110486863=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110486864=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      
        '110486865=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL)'
      '110486866=RETURNS ('
      
        '110486867=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110486868=  ERR_CODE INTEGER,'
      '110486869=  ERR_MSG VARCHAR(1024))'
      '110486870=AS'
      
        '110486871=declare variable PROCNAME varchar(50) = '#39#39'INS_ZAKAZ_DE' +
        'TAILS_TMP_REAL'#39#39';'
      
        '110486872=declare variable AMOUNT_CUR_ type of column ZAKAZ_DETA' +
        'ILS.AMOUNT = 0;'
      
        '110486873=declare variable AMOUNT_CUR_ZAKAZ_ type of column ZAKA' +
        'Z_DETAILS.AMOUNT = 0;'
      '110486874=declare variable ZAKAZ_ integer = 0;'
      
        '110486875=declare variable AMOUNT_OLD_ type of column ZAKAZ_DETA' +
        'ILS.AMOUNT = 0;'
      '110486876=begin'
      '110486877=  INSERT INTO ZAKAZ_DETAILS_TMP_REAL'
      '110486878=  ('
      '110486879=   ZAKAZ_DETAILS,'
      '110486880=   G_PRODUCT,'
      '110486881=   AMOUNT,'
      '110486882=   PRICE,'
      '110486883=   SUMM,'
      '110486884=   DISCOUNT_PERC,'
      '110486885=   DISCOUNT_TENGE,'
      '110486886=   DISCOUNT_SUMM,'
      '110486887=   NDS,'
      '110486888=   NDS_SUMM,'
      '110486889=   IS_ADDED_FOR_UPDATE,'
      '110486890=   ZAKAZ_NA_REAL,'
      '110486891=   COST_PRICE'
      '110486892=  ) VALUES ('
      '110486893=   GEN_ID(GEN_DETAILS_TMP, 1),'
      '110486894=   :G_PRODUCT_,'
      '110486895=   :AMOUNT_,'
      '110486896=   :PRICE_,'
      '110486897=   :SUMM_,'
      '110486898=   :DISCOUNT_PERC_,'
      '110486899=   :DISCOUNT_TENGE_,'
      '110486900=   :DISCOUNT_SUMM_,'
      '110486901=   :NDS_,'
      '110486902=   :NDS_SUMM_,'
      '110486903=   0,'
      '110486904=   :ZAKAZ_NA_REAL_,'
      '110486905=   :COST_PRICE_'
      '110486906=  )'
      '110486907=  RETURNING'
      '110486908=    ZAKAZ_DETAILS'
      '110486909=  INTO'
      '110486910=    :ZAKAZ_DETAILS_;'
      '110486911='
      
        '110486912=  SELECT (L.AMOUNT_ALL - L.AMOUNT_PAYED - L.AMOUNT_RET' +
        'URNED)'
      '110486913=    FROM ZAKAZ_NA_REAL L'
      '110486914=   WHERE L.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110486915=   INTO :AMOUNT_CUR_;'
      '110486916=  SELECT Z.ZAKAZ'
      '110486917=    FROM ZAKAZ Z,'
      '110486918=         ZAKAZ_DETAILS ZD'
      '110486919=   WHERE Z.ZAKAZ = ZD.ZAKAZ'
      '110486920=     AND ZD.ZAKAZ_DETAILS IN (SELECT T.ZAKAZ_DETAILS'
      
        '110486921=                                FROM ZAKAZ_DETAILS_TMP' +
        '_REAL T'
      
        '110486922=                               WHERE T.IS_ADDED_FOR_UP' +
        'DATE = 1'
      
        '110486923=                                 AND T.ZAKAZ_NA_REAL =' +
        ' :ZAKAZ_NA_REAL_)'
      '110486924=    INTO :ZAKAZ_;'
      '110486925='
      '110486926=  IF (ROW_COUNT <> 0) THEN BEGIN'
      '110486927=    SELECT SUM(AMOUNT)'
      '110486928=      FROM ZAKAZ_DETAILS T'
      '110486929=     WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110486930=       AND T.ZAKAZ = :ZAKAZ_'
      '110486931=      INTO :AMOUNT_OLD_;'
      '110486932=  END'
      '110486933=  SELECT SUM(AMOUNT)'
      '110486934=    FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110486935=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110486936=     AND T.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110486937=   INTO :AMOUNT_CUR_ZAKAZ_;'
      '110486938='
      
        '110486939=  IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:A' +
        'MOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110486940=    ERR_CODE = -20500;'
      
        '110486941=    ERR_MSG = '#39#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1076#1086 +
        #1089#1090#1091#1087#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1076#1083#1103' '#1086#1087#1083#1072#1090#1099'! '#1044#1086#1089#1090#1091#1087#1085#1086' '#39#39'||'
      
        '110486942=              CAST((AMOUNT_CUR_ - (AMOUNT_CUR_ZAKAZ_ -' +
        ' AMOUNT_ - COALESCE(:AMOUNT_OLD_, 0))) AS VARCHAR(10))||'
      '110486943=              '#39#39', '#1042#1099' '#1074#1074#1086#1076#1080#1090#1077' '#39#39'||AMOUNT_;'
      
        '110486944=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_MSG) R' +
        'ETURNING_VALUES (:ERR_MSG);'
      '110486945=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110486946=    EXIT;'
      '110486947=  END'
      '110486948=end'
      '110486949='#39';'
      '110486950='
      '110486951=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_KASSIR('
      '110486952=  DATE_BEGIN_ DATE,'
      '110486953=  DATE_END_ DATE,'
      '110486954=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110486955=RETURNS ('
      '110486956=  PERIOD_ VARCHAR(40),'
      '110486957=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '110486958=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '110486959=  ROWCOL INTEGER,'
      '110486960=  Z_DATE VARCHAR(40),'
      '110486961=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110486962=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110486963=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110486964=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110486965=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '110486966=AS'
      '110486967=DECLARE VARIABLE SORT_COL INTEGER;'
      '110486968=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '110486969=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '110486970=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '110486971=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = 0' +
        ';'
      
        '110486972=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = 0' +
        ';'
      
        '110486973=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      
        '110486974=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      '110486975=BEGIN'
      
        '110486976=  PERIOD_ = '#39#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39#39'||lpad(EXTRACT(DAY FROM DA' +
        'TE_BEGIN_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN' +
        '_), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39#39' '#1087#1086' '#39#39'||'
      
        '110486977=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39#39'0'#39#39')||' +
        #39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||EXT' +
        'RACT(YEAR FROM DATE_END_);'
      '110486978='
      '110486979=  SELECT S."INPUT"'
      '110486980=    FROM kassa_state S'
      '110486981=   WHERE S.k_date = :DATE_BEGIN_'
      '110486982=     AND S.g_tochka = :G_TOCHKA_'
      '110486983=    INTO :IN_SUMM_;'
      '110486984='
      '110486985=  IF (ROW_COUNT = 0) THEN'
      '110486986=    SELECT S."OUTPUT"'
      '110486987=      FROM kassa_state S'
      '110486988=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '110486989=                         FROM KASSA_STATE ST'
      '110486990=                        WHERE ST.k_date < :DATE_BEGIN_'
      '110486991=                         AND ST.g_tochka = :G_TOCHKA_)'
      '110486992=      AND S.g_tochka = :G_TOCHKA_'
      '110486993=      INTO :IN_SUMM_;'
      '110486994='
      '110486995=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '110486996='
      '110486997=  SELECT S."OUTPUT"'
      '110486998=    FROM kassa_state S'
      '110486999=   WHERE S.k_date = :DATE_END_'
      '110487000=     AND S.g_tochka = :G_TOCHKA_'
      '110487001=    INTO :OUT_SUMM_;'
      '110487002='
      '110487003=  IF (ROW_COUNT = 0) THEN'
      '110487004=    SELECT S."OUTPUT"'
      '110487005=      FROM kassa_state S'
      '110487006=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '110487007=                         FROM KASSA_STATE ST'
      '110487008=                        WHERE ST.k_date < :DATE_END_'
      '110487009=                         AND ST.g_tochka = :G_TOCHKA_)'
      '110487010=      AND S.g_tochka = :G_TOCHKA_'
      '110487011=      INTO :OUT_SUMM_;'
      '110487012='
      '110487013=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '110487014='
      '110487015=  -- '#1055#1056#1054#1044#1040#1046#1040
      
        '110487016=  FOR SELECT lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39#39'0'#39#39 +
        ')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||E' +
        'XTRACT(YEAR FROM Z.Z_DATE)--CAST(Z.Z_DATE AS VARCHAR(10)) DATE_S' +
        'TR'
      '110487017=           ,Z.Z_DATE'
      '110487018=           ,GP.ARTICUL'
      '110487019=           ,GP.BARCODE'
      '110487020=           ,GP.NAME'
      '110487021=           ,SUM(ZD.AMOUNT)  AMOUNT'
      '110487022=           ,SUM(ZD.summ)    SUMM'
      '110487023=      FROM ZAKAZ Z'
      '110487024=           ,ZAKAZ_DETAILS ZD'
      '110487025=           ,G_PRODUCT GP'
      '110487026=     WHERE Z.is_spisanie in (0, 2)'
      '110487027=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110487028=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110487029=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110487030=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      '110487031=       AND Z.G_TOCHKA = :G_TOCHKA_'
      
        '110487032=     GROUP BY Z.z_date, GP.articul, GP.barcode, GP.NAM' +
        'E'
      '110487033=      INTO :date_str,'
      '110487034=           :Z_DATE,'
      '110487035=           :ARTICUL,'
      '110487036=           :BARCODE,'
      '110487037=           :NAME,'
      '110487038=           :AMOUNT,'
      '110487039=           :SUMM'
      '110487040=  DO BEGIN'
      '110487041=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110487042=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110487043=      VALUES (1, 1, '#39#39#1055#1088#1086#1076#1072#1078#1072#39#39');'
      '110487044=      FIRST_ITER = 1;'
      '110487045=    END'
      '110487046='
      
        '110487047=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '110487048=      VALUES (2, 2, :DATE_STR, :z_date,  :ARTICUL, :BA' +
        'RCODE, :NAME, :AMOUNT, :SUMM);'
      '110487049=  END'
      '110487050='
      '110487051=  IF (first_iter > 0) THEN BEGIN'
      
        '110487052=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110487053=        VALUES (3, 3, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39#39', (SELECT SUM(Z.' +
        'summ_cash)'
      '110487054=                                         FROM ZAKAZ Z'
      
        '110487055=                                        WHERE Z.z_date' +
        ' BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110487056=                                          AND Z.G_TOCH' +
        'KA = :G_TOCHKA_'
      
        '110487057=                                          AND Z.is_spi' +
        'sanie in (0, 2))'
      '110487058=               )'
      '110487059=      RETURNING'
      '110487060=        SUMM'
      '110487061=      INTO'
      '110487062=        :SUMM_PRIHOD_ALL_;'
      '110487063='
      
        '110487064=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110487065=        VALUES (4, 3, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1073#1077#1079#1085#1072#1083#39#39', (SELECT SUM' +
        '(Z.summ_noncash)'
      
        '110487066=                                            FROM ZAKAZ' +
        ' Z'
      
        '110487067=                                           WHERE Z.z_d' +
        'ate BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110487068=                                             AND Z.G_T' +
        'OCHKA = :G_TOCHKA_'
      
        '110487069=                                             AND Z.is_' +
        'spisanie in (0, 2))'
      '110487070=               );'
      '110487071='
      
        '110487072=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L)'
      '110487073=      VALUES(5, 1);'
      '110487074=  END'
      '110487075='
      '110487076=  -- '#1055#1056#1048#1061#1054#1044
      '110487077=  FIRST_ITER = 0;'
      
        '110487078=  FOR SELECT lpad(EXTRACT(DAY FROM S.date_receipt), 2,' +
        ' '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM S.date_receipt), 2, '#39#39'0'#39 +
        #39')||'#39#39'.'#39#39'||EXTRACT(YEAR FROM S.date_receipt)--CAST(S.date_receip' +
        't AS VARCHAR(10)) DATE_STR'
      '110487079=           ,S.date_receipt'
      '110487080=           ,GP.ARTICUL'
      '110487081=           ,GP.BARCODE'
      '110487082=           ,GP.NAME'
      '110487083=           ,SUM(SD.AMOUNT)  AMOUNT'
      '110487084=           ,SUM(SD.summ)    SUMM'
      '110487085=      FROM SKLAD_PARENT S'
      '110487086=           ,SKLAD SD'
      '110487087=           ,G_PRODUCT GP'
      '110487088=     WHERE S.is_vozvrat = 0'
      '110487089=       AND S.sklad = SD.sklad_parent'
      '110487090=       AND SD.G_PRODUCT = GP.G_PRODUCT'
      '110487091=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110487092=       AND S.date_receipt BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110487093=       AND S.G_TOCHKA = :G_TOCHKA_'
      
        '110487094=     GROUP BY S.date_receipt, GP.articul, GP.barcode, ' +
        'GP.NAME'
      '110487095=     INTO :date_str,'
      '110487096=           :Z_DATE,'
      '110487097=           :ARTICUL,'
      '110487098=           :BARCODE,'
      '110487099=           :NAME,'
      '110487100=           :AMOUNT,'
      '110487101=           :SUMM'
      '110487102=  DO BEGIN'
      '110487103=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110487104=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110487105=      VALUES (6, 1, '#39#39#1055#1088#1080#1093#1086#1076' '#1090#1086#1074#1072#1088#1072#39#39');'
      '110487106=      FIRST_ITER = 1;'
      '110487107=    END'
      '110487108='
      
        '110487109=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, ARTICUL, BARCODE, NAME, AMOUNT, SUMM)'
      
        '110487110=      VALUES (7, 2, :DATE_STR, :z_date,  :ARTICUL, :BA' +
        'RCODE, :NAME, :AMOUNT, :SUMM);'
      '110487111=  END'
      '110487112='
      '110487113=  IF (FIRST_ITER = 1) THEN BEGIN'
      
        '110487114=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR, SUMM)'
      
        '110487115=        VALUES (8, 3, '#39#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39#39', COALESCE((SELE' +
        'CT SUM(K.summ)'
      
        '110487116=                                                 FROM ' +
        'KASSA K'
      
        '110487117=                                                WHERE ' +
        'EXISTS (SELECT 1'
      
        '110487118=                                                      ' +
        '          FROM sklad_parent P'
      
        '110487119=                                                      ' +
        '         WHERE P.date_receipt BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110487120=                                                      ' +
