        'FICIAL = :G_OFFICIAL_LOCAL_)'
      '110236852=                   OR'
      '110236853=                  (:G_OFFICIAL_APPOINT_ = 1 )'
      '110236854=                 )'
      '110236855=                )'
      '110236856=                or'
      
        '110236857=                (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS' +
        '_SPISANIE_ <> 0)'
      '110236858=               )'
      
        '110236859=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110236860=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '110236861=        INTO :ZAKAZ,'
      '110236862=             :Z_NUM,'
      '110236863=             :G_TOCHKA,'
      '110236864=             :Z_DATE,'
      '110236865=             :Z_TIME,'
      '110236866=             :G_CLIENT,'
