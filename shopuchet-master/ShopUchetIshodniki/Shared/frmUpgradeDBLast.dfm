      '110243538='
      '110243539=ALTER PROCEDURE G_DEL_G_DISCOUNT('
      '110243540=  G_DISCOUNT_ TYPE OF COLUMN G_DISCOUNT.G_DISCOUNT)'
      '110243541=RETURNS ('
      '110243542=  ERR_CODE INTEGER,'
      '110243543=  ERR_MSG VARCHAR(1024))'
      '110243544=AS'
      '110243545=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '110243546=begin'
      '110243547=  PROCNAME = '#39'G_DEL_G_DISCOUNT'#39';'
      '110243548='
      '110243549=  IF (G_DISCOUNT_ <> -1000) THEN'
      '110243550=      delete from G_DISCOUNT g'
      '110243551=        where g.G_DISCOUNT = :G_DISCOUNT_;'
      '110243552='
      '110243553=  ELSE BEGIN'
      '110243554=      DELETE FROM G_DISCOUNT G'
      '110243555=        WHERE NOT EXISTS (SELECT 1'
      '110243556=                            FROM LT_SKLAD_PRODUCT LT'
      
        '110243557=                           WHERE LT.G_TOCHKA = (SELECT' +
        ' ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2)'
      
        '110243558=                             AND LT.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '110243559=                             AND (LT.AMOUNT + LT.AMOUN' +
        'T_RESERVE) <> 0);'
      '110243560=  END'
      '110243561='
      '110243562=when sqlcode -530 DO'
      '110243563=  begin'
      '110243564=    ERR_CODE = -20500;'
      
        '110243565=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1072#1082#1094#1080#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VALU' +
        'ES (:ERR_MSG);'
      '110243566=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110243567=  end'
      '110243568=end'
      '110243569=;'
      '110243570='
      '110243571=ALTER PROCEDURE G_NONCASH_PAY_TYPE_GET('
      
