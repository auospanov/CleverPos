      '1102112460=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1102112461=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1102112462=                  UPDATE LT_SKLAD_PRODUCT L'
      
