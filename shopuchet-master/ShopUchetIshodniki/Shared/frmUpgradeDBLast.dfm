      '110401636=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '110401637=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110401638='
      
        '110401639=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048',' +
        ' '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044 +
        #1048#1053' '#1055#1051#1040#1058#1045#1046
      '110401640=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110401641=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110401642=                PNT_ = '#39#39'05'#39#39';'
      
        '110401643=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110401644=                                              1,     -' +
        '- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110401645=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110401646=                                              :Z_DATE_' +
        ','
      
        '110401647=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110401648=                                              ZAKAZ_, ' +
        '  --ZAKAZ_'
      '110401649=                                              NULL,'
      
        '110401650=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110401651=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110401652=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110401653=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110401654=                  EXIT;'
      '110401655=                END'
      '110401656=            END'
      '110401657='
      '110401658=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110401659=        END ELSE BEGIN'
      
        '110401660=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110401661=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENT' +
        'S_);'
      
        '110401662=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110401663=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110401664=                ELSE'
      
        '110401665=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110401666='
      
        '110401667=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110401668=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110401669='
      
        '110401670=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110401671='
      '110401672=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110401673=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110401674=                                                  1,  ' +
