        '110170107=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110170108=/*****************************************************' +
        '*************************/'
      '110170109='
      '110170110=ALTER PROCEDURE P_REP_PRICE_LIST('
      '110170111=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110170112=  INCLUDE_NOL_ INTEGER,'
      '110170113=  INCLUDE_FEW_ INTEGER,'
      '110170114=  SORT_BY_NAME_ INTEGER,'
      '110170115=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110170116=  SCALE_PREFIX_ VARCHAR(2) = '#39#39','
      '110170117=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110170118=RETURNS ('
      '110170119=  PERIOD_ VARCHAR(40),'
      '110170120=  ROW_NUM VARCHAR(15),'
      '110170121=  ARTICUL VARCHAR(1000),'
      '110170122=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110170123=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110170124=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110170125=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110170126=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110170127=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110170128=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110170129=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110170130=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110170131=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110170132=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110170133=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110170134=  TOVAR_NAME VARCHAR(250),'
      '110170135=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110170136=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110170137=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110170138=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110170139=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110170140=  ERR_CODE INTEGER,'
      '110170141=  ERR_MSG VARCHAR(1024))'
      '110170142=AS'
      '110170143=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '110170144=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_L' +
        'IST'#39';'
      '110170145=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110170146=DECLARE VARIABLE I INTEGER = 1;'
      '110170147=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110170148=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110170149=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110170150=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110170151=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110170152=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110170153=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110170154=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110170155=BEGIN'
      '110170156='
      
        '110170157=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110170158=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110170159='
      '110170160=  SELECT S.S_VALUE,'
      '110170161=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110170162=    FROM SYSTEM_SETUP S'
      '110170163=   WHERE S.SYSTEM_SETUP = 1'
      '110170164=    INTO :FORMULA_,'
      '110170165=         :PRIHOD_CNT_;'
      '110170166='
      '110170167=  FOR SELECT GP.PATH,'
      '110170168=             GP.G_PRODUCT'
      '110170169=        FROM P_REP_TREE GP'
      '110170170=       WHERE EXISTS (SELECT 1'
      '110170171=                       FROM G_PRODUCT'
      '110170172=                      WHERE IS_CATEGORY = 0'
      
        '110170173=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110170174=                    )'
      
        '110170175=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110170176=              OR'
      '110170177=              (:G_CATEGORY_ is NULL)'
      '110170178=             )'
      '110170179=       ORDER BY 1, 2'
      '110170180=       INTO :PATH_NAME_,'
      '110170181=            :G_PRODUCT_'
      '110170182=  DO BEGIN'
      
        '110170183=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110170184=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110170185=      SELECT COUNT(G.G_PRODUCT)'
      
        '110170186=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110170187=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110170188=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110170189=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110170190=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110170191=              OR'
      
        '110170192=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110170193=              or'
      
        '110170194=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110170195=             )'
      '110170196=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110170197=         AND ((EXISTS (SELECT 1'
      '110170198=                       FROM SKLAD S'
      '110170199=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110170200=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110170201=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110170202=              OR'
      '110170203=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110170204=        INTO :CNT_;'
      '110170205='
      '110170206=      IF (CNT_ > 0) THEN BEGIN'
      
        '110170207=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110170208=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110170209='
      
        '110170210=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110170211=                                              ARTICUL,'
      '110170212=                                              BARCODE,'
      
        '110170213=                                              NOMENCLA' +
        'TUR_NUM,'
      '110170214=                                              NAME,'
      
        '110170215=                                              UNIT_NAM' +
        'E,'
      '110170216=                                              PRICE,'
      
        '110170217=                                              VOLUME_P' +
        'RICE,'
      
        '110170218=                                              SKIDKA_P' +
        'RICE,'
      '110170219=                                              AMOUNT,'
      
        '110170220=                                              AMOUNT_R' +
        'ESERVE,'
      '110170221=                                              SUMM,'
      
        '110170222=                                              PRICE_SE' +
        'LF,'
      
        '110170223=                                              SORT_COL' +
        ','
      
        '110170224=                                              IS_CATEG' +
        'ORY,'
      '110170225=                                              NOTE,'
      
        '110170226=                                              CROSSCOD' +
        'E,'
      '110170227=                                              PLACE,'
      '110170228=                                              BRAND)'
      
        '110170229=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110170230=                 G.ARTICUL,'
      '110170231=                 G.BARCODE,'
      '110170232=                 G.NOMENCLATUR_NUM,'
      '110170233=                 G.NAME,'
      '110170234=                 U.SHORT_NAME,'
      '110170235=                 G.PRICE,'
      '110170236=                 G.VOLUME_PRICE,'
      '110170237=                 G.PRICE - GD.SKIDKA_SUM,'
      '110170238=                 COALESCE(S.AMOUNT, 0),'
      '110170239=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110170240=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110170241=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110170242=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110170243=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110170244=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110170245=                  DECODE(:FORMULA_,'
      '110170246=                         1,'
      
        '110170247=                         (SELECT CAST(S.price AS MY_NU' +
        'MERIC)'
      '110170248=                            FROM SKLAD S'
      
        '110170249=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110170250=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110170251=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110170252=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110170253=                                                     F' +
        'ROM SKLAD DD'
      
        '110170254=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110170255=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110170256=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110170257=                                                    )'
      '110170258=                            ORDER BY 1 DESC'
      '110170259=                            ROWS 1 TO 1'
      '110170260=                         ),'
      
        '110170261=                         (SELECT CAST(ROUND(SUM(T.AMOU' +
        'NT * T.PRICE)/SUM(T.AMOUNT), 2) AS MY_NUMERIC)'
      
        '110170262=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110170263=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110170264=                                         SKLAD S'
      
        '110170265=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110170266=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110170267=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110170268=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110170269=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110170270=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '110170271=                        )), 0) spr,'
      
        '110170272=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110170273=                 0'
      '110170274=                 ,G.NOTE'
      
        '110170275=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110170276=                 ,G.PLACE'
      '110170277=                 ,G.BRAND'
      
        '110170278=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '110170279=                                                FROM G' +
        '_DISCOUNT D'
      
        '110170280=                                                WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110170281=                                                      ' +
        '  AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '110170282=                                                      ' +
        '  AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '110170283=                                                      ' +
        ')'
      
        '110170284=                                                      ' +
        'OR'
      
        '110170285=                                                      ' +
        '(D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '110170286=                                                 AND (' +
        '(:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '110170287=                                                     O' +
        'R'
      
        '110170288=                                                     (' +
        'D.G_TOCHKA IS NULL))'
      
        '110170289=                                              ) GD ON ' +
        'G.G_PRODUCT = GD.G_PRODUCT'
      
        '110170290=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110170291=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110170292=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110170293=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110170294=             AND G.IS_CATEGORY = 0'
      '110170295=             AND G.is_active = 1'
      '110170296=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110170297=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110170298=                  OR'
      
        '110170299=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110170300=                  or'
      
        '110170301=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110170302=                 )'
      '110170303=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110170304=             AND ((EXISTS (SELECT 1'
      '110170305=                           FROM SKLAD S'
      
        '110170306=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110170307=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110170308=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110170309=                  OR'
      '110170310=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110170311=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '110170312=      END'
      '110170313=  END'
      '110170314='
      
        '110170315=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110170316='
      
        '110170317=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, VOLUME_PRIC' +
        'E, SKIDKA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUN' +
        'T*PRICE_SELF, IS_CATEGORY,'
      '110170318=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110170319=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110170320=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, :CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRIC' +
        'E, :VOLUME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM' +
        ', :PRICE_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110170321=  DO BEGIN'
      '110170322=    I = I + 1;'
      '110170323=    SUSPEND;'
      '110170324=  END'
      '110170325='
      '110170326=     /*'
      '110170327=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110170328='
      '110170329=     SELECT :I,'
      
        '110170330=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110170331=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110170332=             U.SHORT_NAME UNIT_NAME,'
      '110170333=             SS.PRICE,'
      '110170334=             SS.VOLUME_PRICE,'
      '110170335=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110170336=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110170337=             SS.IS_CATEGORY'
      '110170338=        FROM (WITH RECURSIVE TREE'
      '110170339=              AS (SELECT T.G_PRODUCT,'
      '110170340=                       T.NAME AS ARTICUL,'
      
        '110170341=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110170342=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110170343=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110170344=                       T.IS_CATEGORY,'
      '110170345=                       NULL G_UNIT'
      '110170346=                  FROM G_PRODUCT T'
      '110170347=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110170348=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110170349=                UNION ALL'
      '110170350=                SELECT T.G_PRODUCT,'
      '110170351=                       DECODE(T. T.ARTICUL,'
      '110170352=                       T.NAME,'
      '110170353=                       T.PRICE,'
      '110170354=                       T.VOLUME_PRICE,'
      '110170355=                       T.IS_CATEGORY,'
      '110170356=                       T.G_UNIT'
      
        '110170357=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110170358=                 WHERE T.IS_ACTIVE = 1'
      '110170359=                )'
      '110170360=             SELECT * FROM TREE) SS'
      
        '110170361=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110170362=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110170363=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110170364=    INTO :ROW_NUM,'
      '110170365=        :ARTICUL,'
      '110170366=        :NAME,'
      '110170367=        :UNIT_NAME,'
      '110170368=        :PRICE,'
      '110170369=        :VOLUME_PRICE,'
      '110170370=        :SKIDKA_PRICE,'
      '110170371=        :AMOUNT,'
      '110170372=        :IS_CATEGORY'
      '110170373=    DO BEGIN'
      '110170374=      I = I + 1;'
      '110170375=      SUSPEND;'
      '110170376=    END  */'
      '110170377=WHEN ANY DO BEGIN'
      '110170378=    Err_code = -20500;'
      
        '110170379=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110170380=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110170381=  END'
      '110170382=end'
      '110170383=;'
      '110170384='
      '110170385='
      
        '110170386=/*****************************************************' +
        '*************************/'
      
        '110170387=/****                   Restoring deactivated procedur' +
        'es                   ****/'
      
        '110170388=/*****************************************************' +
        '*************************/'
      '110170389=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '110170390=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110170391=  INCLUDE_NOL_ INTEGER,'
      '110170392=  INCLUDE_FEW_ INTEGER,'
      '110170393=  SORT_BY_NAME_ INTEGER,'
      '110170394=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110170395=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '110170396=RETURNS ('
      '110170397=  PERIOD_ VARCHAR(40),'
      '110170398=  ROW_NUM VARCHAR(15),'
      '110170399=  ARTICUL VARCHAR(1000),'
      '110170400=  BARCODE VARCHAR(30),'
      
        '110170401=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110170402=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110170403=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110170404=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110170405=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110170406=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '110170407=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T_RESERVE,'
      '110170408=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '110170409=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '110170410=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '110170411=  TOVAR_NAME VARCHAR(250),'
      '110170412=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110170413=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110170414=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110170415=  ERR_CODE INTEGER,'
      '110170416=  ERR_MSG VARCHAR(1024))'
      '110170417=AS'
      
        '110170418=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK' +
        '_TOVAROV'#39';'
      '110170419=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110170420=DECLARE VARIABLE I INTEGER = 1;'
      '110170421=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110170422=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110170423=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; ' +
        '/* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '110170424=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '110170425=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110170426=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '110170427=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044 +
        #1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042 +
        #1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '110170428=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '110170429=BEGIN'
      '110170430='
      
        '110170431=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110170432=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110170433='
      '110170434=  SELECT S.S_VALUE,'
      '110170435=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '110170436=    FROM SYSTEM_SETUP S'
      '110170437=   WHERE S.SYSTEM_SETUP = 1'
      '110170438=    INTO :FORMULA_,'
      '110170439=         :PRIHOD_CNT_;'
      '110170440='
      '110170441=  FOR SELECT GP.PATH,'
      '110170442=             GP.G_PRODUCT'
      '110170443=        FROM P_REP_TREE GP'
      '110170444=       WHERE EXISTS (SELECT 1'
      '110170445=                       FROM G_PRODUCT'
      '110170446=                      WHERE IS_CATEGORY = 0'
      
        '110170447=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110170448=                    )'
      
        '110170449=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110170450=              OR'
      '110170451=              (:G_CATEGORY_ is NULL)'
      '110170452=             )'
      '110170453=       ORDER BY 1, 2'
      '110170454=       INTO :PATH_NAME_,'
      '110170455=            :G_PRODUCT_'
      '110170456=  DO BEGIN'
      
        '110170457=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110170458=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110170459=      SELECT COUNT(G.G_PRODUCT)'
      
        '110170460=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110170461=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110170462=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110170463=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110170464=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110170465=              OR'
      
        '110170466=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110170467=              or'
      
        '110170468=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110170469=             )'
      '110170470=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110170471=         AND ((EXISTS (SELECT 1'
      '110170472=                       FROM SKLAD S'
      '110170473=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110170474=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110170475=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110170476=              OR'
      '110170477=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110170478=        INTO :CNT_;'
      '110170479='
      '110170480=      IF (CNT_ > 0) THEN BEGIN'
      
        '110170481=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110170482=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110170483='
      
        '110170484=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110170485=                                              ARTICUL,'
      '110170486=                                              BARCODE,'
      
        '110170487=                                              NOMENCLA' +
        'TUR_NUM,'
      '110170488=                                              NAME,'
      
        '110170489=                                              UNIT_NAM' +
        'E,'
      '110170490=                                              PRICE,'
      
        '110170491=                                              VOLUME_P' +
        'RICE,'
      '110170492=                                              AMOUNT,'
      
        '110170493=                                              AMOUNT_R' +
        'ESERVE,'
      '110170494=                                              SUMM,'
      
        '110170495=                                              PRICE_SE' +
        'LF,'
      
        '110170496=                                              SORT_COL' +
        ','
      
        '110170497=                                              IS_CATEG' +
        'ORY,'
      '110170498=                                              NOTE,'
      
        '110170499=                                              CROSSCOD' +
        'E)'
      
        '110170500=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110170501=                 G.ARTICUL,'
      '110170502=                 G.BARCODE,'
      '110170503=                 G.NOMENCLATUR_NUM,'
      '110170504=                 G.NAME,'
      '110170505=                 U.SHORT_NAME,'
      '110170506=                 G.PRICE,'
      '110170507=                 G.VOLUME_PRICE,'
      '110170508=                 COALESCE(S.AMOUNT, 0),'
      '110170509=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110170510=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110170511=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110170512=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110170513=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110170514=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110170515=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110170516=                  DECODE(:FORMULA_,'
      '110170517=                         1,'
      '110170518=                         (SELECT S.price'
      '110170519=                            FROM SKLAD S'
      
        '110170520=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110170521=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110170522=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110170523=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110170524=                                                     F' +
        'ROM SKLAD DD'
      
        '110170525=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110170526=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110170527=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110170528=                                                    )'
      '110170529=                            ORDER BY 1 DESC'
      '110170530=                            ROWS 1 TO 1'
      '110170531=                         ),'
      
        '110170532=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110170533=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110170534=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110170535=                                         SKLAD S'
      
        '110170536=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110170537=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110170538=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110170539=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110170540=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110170541=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110170542=                         )), 0) spr,'
      
        '110170543=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110170544=                 0'
      '110170545=                 ,G.NOTE'
      
        '110170546=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      
        '110170547=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110170548=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110170549=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110170550=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110170551=             AND G.IS_CATEGORY = 0'
      '110170552=             AND G.is_active = 1'
      '110170553=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110170554=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110170555=                  OR'
      
        '110170556=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110170557=                  or'
      
        '110170558=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110170559=                 )'
      '110170560=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110170561=             AND ((EXISTS (SELECT 1'
      '110170562=                           FROM SKLAD S'
      
        '110170563=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110170564=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110170565=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110170566=                  OR'
      '110170567=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110170568=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '110170569=      END'
      '110170570=  END'
      '110170571='
      
        '110170572=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110170573='
      
        '110170574=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AMO' +
        'UNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '110170575=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110170576=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110170577=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE,' +
        ' :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_C' +
        'ATEGORY, :TOVAR_NAME'
      '110170578=  DO BEGIN'
      '110170579=    I = I + 1;'
      '110170580=    SUSPEND;'
      '110170581=  END'
      '110170582=WHEN ANY DO BEGIN'
      '110170583=    Err_code = -20500;'
      
        '110170584=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110170585=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110170586=  END'
      '110170587=end'
      '110170588=;'
      '110170589='
      '110170590=ALTER PROCEDURE P_REP_PLU_LIST('
      '110170591=  SCALE_PREFIX_ VARCHAR(2))'
      '110170592=RETURNS ('
      '110170593=  ROW_NUM VARCHAR(15),'
      '110170594=  ARTICUL VARCHAR(1000),'
      '110170595=  PLUCODE TYPE OF COLUMN G_PRODUCT.NAME,'
      '110170596=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110170597=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110170598=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110170599=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110170600=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '110170601=  ERR_CODE INTEGER,'
      '110170602=  ERR_MSG VARCHAR(1024))'
      '110170603=AS'
      '110170604=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1057#1055#1048#1057#1054#1050#1040' '#1055#1051#1059' '#1050#1054#1044#1054#1042
      
        '110170605=-- '#1052#1054#1046#1053#1054' '#1041#1067#1051#1054' '#1042#1057#1045' '#1047#1040#1055#1048#1061#1053#1059#1058#1068' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1059' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040', '#1053#1054 +
        ' '#1056#1045#1064#1048#1051' '#1063#1058#1054' '#1054#1053' '#1048' '#1058#1040#1050' '#1055#1045#1056#1045#1043#1056#1059#1046#1045#1053', '#1044#1054#1051#1043#1054' '#1041#1059#1044#1045#1058' '#1056#1040#1041#1054#1058#1040#1058#1068
      
        '110170606=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PLU_LIS' +
        'T'#39';'
      '110170607=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110170608=DECLARE VARIABLE I INTEGER = 1;'
      
        '110170609=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110170610=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      '110170611=BEGIN'
      '110170612='
      
        '110170613=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE' +
        '_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '110170614=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110170615='
      '110170616=  FOR SELECT GP.PATH,'
      '110170617=             GP.G_PRODUCT'
      '110170618=        FROM P_REP_TREE GP'
      '110170619=       WHERE EXISTS (SELECT 1'
      '110170620=                       FROM G_PRODUCT'
      '110170621=                      WHERE IS_CATEGORY = 0'
      
        '110170622=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      
        '110170623=                        AND SUBSTRING(BARCODE FROM 1 F' +
        'OR 2) = :SCALE_PREFIX_'
      '110170624=                    )'
      '110170625=       ORDER BY 1, 2'
      '110170626=       INTO :PATH_NAME_,'
      '110170627=            :G_PRODUCT_'
      '110170628=  DO BEGIN'
      
        '110170629=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, BARCODE, IS_CATEGORY)'
      
        '110170630=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110170631='
      
        '110170632=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110170633=                                              ARTICUL,'
      '110170634=                                              BARCODE,'
      '110170635=                                              NAME,'
      
        '110170636=                                              UNIT_NAM' +
        'E,'
      '110170637=                                              PRICE)'
      
        '110170638=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110170639=                 G.ARTICUL,'
      '110170640=                 SUBSTRING(G.BARCODE FROM 3 FOR 5),'
      '110170641=                 G.NAME,'
      '110170642=                 U.SHORT_NAME,'
      '110170643=                 G.PRICE'
      
        '110170644=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      '110170645=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110170646=             AND G.IS_CATEGORY = 0'
      '110170647=             AND G.is_active = 1'
      
        '110170648=             AND SUBSTRING(BARCODE FROM 1 FOR 2) = :SC' +
        'ALE_PREFIX_'
      '110170649=           ORDER BY G.NAME, 3, G.G_PRODUCT;'
      '110170650=  END'
      '110170651='
      
        '110170652=  FOR SELECT :I, ARTICUL, BARCODE, NAME, UNIT_NAME, PR' +
        'ICE, AMOUNT, IS_CATEGORY'
      '110170653=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110170654=      INTO :ROW_NUM, :ARTICUL, :PLUCODE, :NAME, :UNIT_' +
        'NAME, :PRICE, :AMOUNT, :IS_CATEGORY'
      '110170655=  DO BEGIN'
      '110170656=    I = I + 1;'
      '110170657=    SUSPEND;'
      '110170658=  END'
      '110170659=WHEN ANY DO BEGIN'
      '110170660=    Err_code = -20500;'
      
        '110170661=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110170662=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110170663=  END'
      '110170664=end'
      '110170665=;'
      '110170666='
      '110170667='
      
        '110170668=UPDATE SYSTEM_SETUP SET S_VALUE = 110170 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110170669=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110170670=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101710='
      '1101711=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1101712=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101713=  INCLUDE_NOL_ INTEGER,'
      '1101714=  INCLUDE_FEW_ INTEGER,'
      '1101715=  SORT_BY_NAME_ INTEGER,'
      
        '1101716=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      '1101717=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101718=RETURNS ('
      '1101719=  PERIOD_ VARCHAR(40),'
      '11017110=  ROW_NUM VARCHAR(15),'
      '11017111=  ARTICUL VARCHAR(1000),'
      '11017112=  BARCODE VARCHAR(30),'
      
        '11017113=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11017114=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '11017115=  UNIT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      
        '11017116=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15' +
        ',2),'
      
        '11017117=  VOLUME_PRICE /* TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ' */ NUMERIC(15,2),'
      
        '11017118=  AMOUNT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT */ N' +
        'UMERIC(18,5),'
      
        '11017119=  AMOUNT_RESERVE /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT_RESERVE */ NUMERIC(18,5),'
      '11017120=  SUMM /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,2),'
      
        '11017121=  PRICE_SELF /* TYPE OF COLUMN SKLAD.PRICE */ NUMERIC(1' +
        '5,2),'
      
        '11017122=  SUMM_SELF /* TYPE OF COLUMN SKLAD.SUMM */ NUMERIC(15,' +
        '2),'
      '11017123=  TOVAR_NAME VARCHAR(250),'
      
        '11017124=  CROSSCODE /* TYPE OF COLUMN G_PRODUCT.CROSSCODE */ BL' +
        'OB SUB_TYPE 1 SEGMENT SIZE 16384,'
      
        '11017125=  PLACE /* TYPE OF COLUMN G_PRODUCT.PLACE */ VARCHAR(25' +
        '0),'
      
        '11017126=  BRAND /* TYPE OF COLUMN G_PRODUCT.BRAND */ VARCHAR(15' +
        '0),'
      
        '11017127=  NOTE /* TYPE OF COLUMN G_PRODUCT.NOTE */ VARCHAR(300)' +
        ','
      
        '11017128=  IS_CATEGORY /* TYPE OF COLUMN G_PRODUCT.IS_CATEGORY *' +
        '/ INTEGER,'
      '11017129=  ERR_CODE INTEGER,'
      '11017130=  ERR_MSG VARCHAR(1024))'
      '11017131=AS'
      '11017132=BEGIN'
      '11017133=  SUSPEND;'
      '11017134=END'
      '11017135=;'
      '11017136='
      '11017137='
      
        '11017138=/******************************************************' +
        '************************/'
      
        '11017139=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11017140=/******************************************************' +
        '************************/'
      '11017141=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '11017142=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11017143=  INCLUDE_NOL_ INTEGER,'
      '11017144=  INCLUDE_FEW_ INTEGER,'
      '11017145=  SORT_BY_NAME_ INTEGER,'
      '11017146=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11017147=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '11017148=RETURNS ('
      '11017149=  PERIOD_ VARCHAR(40),'
      '11017150=  ROW_NUM VARCHAR(15),'
      '11017151=  ARTICUL VARCHAR(1000),'
      '11017152=  BARCODE VARCHAR(30),'
      
        '11017153=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11017154=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11017155=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11017156=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11017157=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11017158=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '11017159=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        '_RESERVE,'
      '11017160=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '11017161=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '11017162=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '11017163=  TOVAR_NAME VARCHAR(250),'
      '11017164=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11017165=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11017166=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '11017167=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11017168=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '11017169=  ERR_CODE INTEGER,'
      '11017170=  ERR_MSG VARCHAR(1024))'
      '11017171=AS'
      
        '11017172=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATOK_' +
        'TOVAROV'#39';'
      '11017173=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11017174=DECLARE VARIABLE I INTEGER = 1;'
      '11017175=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11017176=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11017177=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11017178=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11017179=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11017180=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11017181=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11017182=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '11017183=BEGIN'
      '11017184='
      
        '11017185=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11017186=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11017187='
      '11017188=  SELECT S.S_VALUE,'
      '11017189=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '11017190=    FROM SYSTEM_SETUP S'
      '11017191=   WHERE S.SYSTEM_SETUP = 1'
      '11017192=    INTO :FORMULA_,'
      '11017193=         :PRIHOD_CNT_;'
      '11017194='
      '11017195=  FOR SELECT GP.PATH,'
      '11017196=             GP.G_PRODUCT'
      '11017197=        FROM P_REP_TREE GP'
      '11017198=       WHERE EXISTS (SELECT 1'
      '11017199=                       FROM G_PRODUCT'
      '110171100=                      WHERE IS_CATEGORY = 0'
      
        '110171101=                        AND G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '110171102=                    )'
      
        '110171103=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODU' +
        'CT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110171104=              OR'
      '110171105=              (:G_CATEGORY_ is NULL)'
      '110171106=             )'
      '110171107=       ORDER BY 1, 2'
      '110171108=       INTO :PATH_NAME_,'
      '110171109=            :G_PRODUCT_'
      '110171110=  DO BEGIN'
      
        '110171111=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' ' +
        #1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063 +
        #1045#1057#1058#1042#1054
      
        '110171112=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058 +
        #1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '110171113=      SELECT COUNT(G.G_PRODUCT)'
      
        '110171114=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(L' +
        'L.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110171115=                                          WHERE :G_TOC' +
        'HKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT)' +
        ' L ON G.G_PRODUCT = L.G_PRODUCT'
      '110171116=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110171117=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110171118=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (C' +
        'OALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110171119=              OR'
      
        '110171120=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL' +
        '_, 0) = 1)'
      '110171121=              or'
      
        '110171122=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW' +
        '_, 0) = 1))'
      '110171123=             )'
      '110171124=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110171125=         AND ((EXISTS (SELECT 1'
      '110171126=                       FROM SKLAD S'
      '110171127=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '110171128=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '110171129=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110171130=              OR'
      '110171131=              COALESCE(:G_CLIENT_, 0) = 0)'
      '110171132=        INTO :CNT_;'
      '110171133='
      '110171134=      IF (CNT_ > 0) THEN BEGIN'
      
        '110171135=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRIC' +
        'E_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '110171136=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),' +
        ' :PATH_NAME_, 1);'
      '110171137='
      
        '110171138=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PR' +
        'ICE_LIST_TABLE,'
      '110171139=                                              ARTICUL,'
      '110171140=                                              BARCODE,'
      
        '110171141=                                              NOMENCLA' +
        'TUR_NUM,'
      '110171142=                                              NAME,'
      
        '110171143=                                              UNIT_NAM' +
        'E,'
      '110171144=                                              PRICE,'
      
        '110171145=                                              VOLUME_P' +
        'RICE,'
      '110171146=                                              AMOUNT,'
      
        '110171147=                                              AMOUNT_R' +
        'ESERVE,'
      '110171148=                                              SUMM,'
      
        '110171149=                                              PRICE_SE' +
        'LF,'
      
        '110171150=                                              SORT_COL' +
        ','
      
        '110171151=                                              IS_CATEG' +
        'ORY,'
      '110171152=                                              NOTE,'
      
        '110171153=                                              CROSSCOD' +
        'E,'
      '110171154=                                              PLACE,'
      '110171155=                                              BRAND)'
      
        '110171156=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110171157=                 G.ARTICUL,'
      '110171158=                 G.BARCODE,'
      '110171159=                 G.NOMENCLATUR_NUM,'
      '110171160=                 G.NAME,'
      '110171161=                 U.SHORT_NAME,'
      '110171162=                 G.PRICE,'
      '110171163=                 G.VOLUME_PRICE,'
      '110171164=                 COALESCE(S.AMOUNT, 0),'
      '110171165=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110171166=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110171167=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110171168=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110171169=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110171170=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '110171171=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 20' +
        '0 '#1047#1040#1050#1059#1055#1054#1050
      '110171172=                  DECODE(:FORMULA_,'
      '110171173=                         1,'
      '110171174=                         (SELECT S.price'
      '110171175=                            FROM SKLAD S'
      
        '110171176=                           WHERE :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '110171177=                             AND S.g_product = G.G_PRO' +
        'DUCT'
      
        '110171178=                             AND S.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      
        '110171179=                             AND S.date_receipt = (SEL' +
        'ECT MAX(DD.DATE_RECEIPT)'
      
        '110171180=                                                     F' +
        'ROM SKLAD DD'
      
        '110171181=                                                    WH' +
        'ERE DD.g_product = G.G_PRODUCT'
      
        '110171182=                                                      ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '110171183=                                                      ' +
        'AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '110171184=                                                    )'
      '110171185=                            ORDER BY 1 DESC'
      '110171186=                            ROWS 1 TO 1'
      '110171187=                         ),'
      
        '110171188=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110171189=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110171190=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110171191=                                         SKLAD S'
      
        '110171192=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110171193=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110171194=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110171195=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110171196=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110171197=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '110171198=                         )), 0) spr,'
      
        '110171199=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110171200=                 0'
      '110171201=                 ,G.NOTE'
      
        '110171202=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110171203=                 ,G.PLACE'
      '110171204=                 ,G.BRAND'
      
        '110171205=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110171206=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110171207=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110171208=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110171209=             AND G.IS_CATEGORY = 0'
      '110171210=             AND G.is_active = 1'
      '110171211=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110171212=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110171213=                  OR'
      
        '110171214=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110171215=                  or'
      
        '110171216=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110171217=                 )'
      '110171218=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110171219=             AND ((EXISTS (SELECT 1'
      '110171220=                           FROM SKLAD S'
      
        '110171221=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110171222=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110171223=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110171224=                  OR'
      '110171225=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110171226=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '110171227=      END'
      '110171228=  END'
      '110171229='
      
        '110171230=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110171231='
      
        '110171232=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, VOLUME_PRIC' +
        'E, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, ' +
        'IS_CATEGORY,'
      '110171233=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110171234=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110171235=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRICE' +
        ', :VOLUME_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :' +
        'SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110171236=  DO BEGIN'
      '110171237=    I = I + 1;'
      '110171238=    SUSPEND;'
      '110171239=  END'
      '110171240=WHEN ANY DO BEGIN'
      '110171241=    Err_code = -20500;'
      
        '110171242=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110171243=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110171244=  END'
      '110171245=end'
      '110171246=;'
      '110171247='
      '110171248='
      
        '110171249=UPDATE SYSTEM_SETUP SET S_VALUE = 110171 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110171250=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110171251=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101720='
      '1101721=ALTER PROCEDURE DO_PRODUCT('
      '1101722=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101723=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1101724=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101725=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101726=  NOTE_ TYPE OF COLUMN OTHER.NOTE,'
      '1101727=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL,'
      '1101728=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101729=RETURNS ('
      '11017210=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '11017211=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '11017212=  ERR_CODE INTEGER,'
      '11017213=  ERR_MSG VARCHAR(1024))'
      '11017214=AS'
      '11017215=/*'
      
        '11017216='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055#1056 +
        #1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '11017217='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '11017218=*/'
      '11017219=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39';'
      '11017220=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11017221=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042#1040 +
        #1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '11017222=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT;'
      
        '11017223=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '11017224=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067' ' +
        #1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '11017225=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11017226=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      '11017227=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM;'
      '11017228=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '11017229=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11017230=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '11017231=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      '11017232=DECLARE VARIABLE POS_ INTEGER;'
      '11017233=DECLARE VARIABLE STR_ VARCHAR(300);'
      '11017234=BEGIN'
      '11017235=  PNT_ = '#39'00'#39';'
      '11017236=  COST_PRICE_ = 0;'
      '11017237='
      '11017238=  IF (G_TOCHKA_ IS NULL) THEN'
      '11017239=    SELECT ID'
      '11017240=      FROM CUR_PARAMS'
      '11017241=     WHERE CUR_PARAMS = 2'
      '11017242=      INTO :G_TOCHKA_;'
      '11017243='
      '11017244=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '11017245=  SELECT P.S_VALUE'
      '11017246=    FROM SYSTEM_SETUP P'
      '11017247=   WHERE P.SYSTEM_SETUP = 2'
      '11017248=    INTO :CAN_SELL_;'
      '11017249='
      '11017250=  IF (LOG_BODY_ IS NOT NULL) THEN'
      '11017251=    LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM 3);'
      '11017252='
      '11017253=  FOR SELECT :G_PRODUCT_IN_,'
      '11017254=             :AMOUNT_IN_'
      '11017255=        FROM RDB$DATABASE'
      '11017256=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '11017257=      UNION ALL'
      '11017258=      SELECT G_PRODUCT,'
      '11017259=             AMOUNT'
      '11017260=        FROM ZAKAZ_DETAILS_TMP'
      '11017261=       WHERE :G_PRODUCT_IN_ IS NULL'
      '11017262=        INTO :G_PRODUCT_,'
      '11017263=             :AMOUNT_'
      '11017264=  DO BEGIN'
      '11017265=      SELECT MAX(G.NAME)'
      '11017266=        FROM G_PRODUCT G,'
      '11017267=             G_PRODUCT_KIT K'
      '11017268=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '11017269=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '11017270=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PR' +
        'ODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCH' +
        'KA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '11017271=        INTO :NAME_;'
      '11017272='
      
        '11017273=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEG' +
        'IN'
      '11017274=        ERR_CODE = -20500;'
      
        '11017275=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072#1090#1086 +
        #1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087#1088#1086 +
        #1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11017276=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11017277=        EXIT;'
      '11017278=      END'
      '11017279='
      '11017280=      PNT_ = '#39'01'#39';'
      
        '11017281=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TIME, OP_TY' +
        'PE, ARRIVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '11017282=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, C' +
        'URRENT_TIME, 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '11017283=      RETURNING OTHER'
      '11017284=      INTO :OTHER_;'
      '11017285='
      '11017286=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11017287=      COST_PRICE_ = 0;'
      '11017288=      FOR SELECT K.G_PRODUCT_ITEM'
      '11017289=                ,K.AMOUNT*:AMOUNT_'
      '11017290=                ,K.amount'
      '11017291=                ,G.G_PRODUCT'
      '11017292=            FROM G_PRODUCT_KIT K'
      '11017293=                ,G_PRODUCT G'
      '11017294=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11017295=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '11017296=            INTO :ITEM_'
      '11017297=                ,:AMOUNT_NEED_'
      '11017298=                ,:AMOUNT_NEED_ONE_'
      '11017299=                ,:G_PRODUCT_KIT_'
      '110172100=      DO BEGIN'
      
        '110172101=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODU' +
        'CT_KIT_, NULL, 1)'
      '110172102=          RETURNING_VALUES :SELF_PRICE_;'
      '110172103='
      '110172104=        UPDATE LT_SKLAD_PRODUCT L'
      '110172105=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '110172106=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '110172107=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110172108='
      '110172109=        IF (ROW_COUNT = 0) THEN'
      
        '110172110=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G' +
        '_TOCHKA_);'
      '110172111='
      
        '110172112=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHE' +
        'R, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110172113=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_,' +
        ' :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110172114='
      
        '110172115=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*S' +
        'ELF_PRICE_;'
      '110172116=      END'
      '110172117='
      
        '110172118=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063 +
        #1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110172119=      PNT_ = '#39'02'#39';'
      
        '110172120=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110172121=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110172122='
      '110172123=      SUMM_ = AMOUNT_*COST_PRICE_;'
      '110172124='
      '110172125=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110172126=                              :DATE_,'
      '110172127=                              CURRENT_TIME,'
      '110172128=                              NULL, --:G_CLIENT__,'
      
        '110172129=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110172130=                              NULL, --:OSNOVANIE__,'
      '110172131=                              :NOTE_,'
      '110172132=                              4, --:IS_VOZVRAT_,'
      '110172133=                              :SUMM_,'
      '110172134=                              :SUMM_,'
      '110172135=                              0, --:G_PRIHOD_,'
      '110172136=                              0 --:SUMM_PRIHOD_)'
      '110172137=                              ,NULL     --PAYMENTS_'
      
        '110172138=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110172139=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110172140=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110172141=          EXIT;'
      '110172142=      END'
      '110172143='
      '110172144=      UPDATE OTHER O'
      '110172145=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110172146=      WHERE O.OTHER = :OTHER_;'
      '110172147='
      '110172148=      -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110172149=      -- '#1048#1047' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1042' '#1058#1040#1050#1054#1052' '#1042#1048#1044#1045' "~*'#1041#1051#1040'-'#1041#1051#1040 +
        ' '#1058#1040#1050#1054#1049'-'#1058#1054' '#1058#1054#1042#1040#1056'~*'#1041#1051#1040'-'#1041#1051#1040' '#1042#1058#1054#1056#1054#1049' '#1058#1054#1042#1040#1056'~*"'
      
        '110172150=      -- '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1042#1067#1056#1045#1047#1040#1058#1068'. '#1040' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1058#1040#1050' '#1044#1045#1051#1040#1058#1068' ' +
        #1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045', '#1040' '#1058#1059#1058' '#1057#1054#1047#1044#1040#1045#1058#1057#1071
      '110172151=      -- '#1056#1040#1047#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048'-'#1047#1040#1055#1048#1057#1071#1052#1048
      '110172152=      IF (LOG_BODY_ IS NOT NULL) THEN BEGIN'
      '110172153=        POS_ = POSITION('#39'~*'#39' IN LOG_BODY_);'
      '110172154=        IF (CHAR_LENGTH(LOG_BODY_) <> (POS_ + 1)) THEN'
      
        '110172155=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR POS_ -' +
        ' 1);'
      '110172156=        ELSE'
      
        '110172157=          STR_ = SUBSTRING(LOG_BODY_ FROM 1 FOR CHAR_L' +
        'ENGTH(LOG_BODY_) - 3);'
      '110172158='
      '110172159=        --ERR_CODE = -20500;'
      '110172160=        --ERR_MSG = STR_; EXIT;'
      '110172161='
      
        '110172162=        EXECUTE PROCEDURE LOG_OPER_INS(4, :USER_ID_, :' +
        'OTHER_, :DATE_, 1, :SUMM_, :STR_, 1);'
      '110172163='
      
        '110172164=        LOG_BODY_   = SUBSTRING(LOG_BODY_ FROM (POSITI' +
        'ON('#39'~*'#39' IN LOG_BODY_)) + 2);'
      '110172165=      END'
      '110172166=  END'
      '110172167=END'
      '110172168=;'
      '110172169='
      '110172170='
      
        '110172171=UPDATE SYSTEM_SETUP SET S_VALUE = 110172 WHERE SYSTEM_' +
        'SETUP = 3;'
      
