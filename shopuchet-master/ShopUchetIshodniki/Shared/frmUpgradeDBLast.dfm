      '1101323302=                END'
      '1101323303=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323304=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101323305=                  EXIT;'
      '1101323306=                END'
      '1101323307='
      
        '1101323308=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101323309=            END'
      '1101323310='
      
        '1101323311=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101323312=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101323313=                FROM KASSA K'
      '1101323314=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101323315=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
      '1101323316=                UNION'
      '1101323317=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1101323318=                  FROM KASSA K'
      '1101323319=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1101323320=                   AND K.SUMM = 0'
      '1101323321=                UNION'
      
        '1101323322=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101323323=                FROM KASSA_BEZNAL K'
      '1101323324=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101323325=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA_BEZNAL||'#39'~'#39
      '1101323326=                UNION'
      
        '1101323327=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101323328=                FROM KASSA_BEZNAL K'
      '1101323329=                WHERE K.ZAKAZ = :ZAKAZ_'
