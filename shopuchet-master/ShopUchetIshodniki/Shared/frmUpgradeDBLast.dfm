      '11040540=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ('
      
        '11040541=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTE' +
        'GER,'
      '11040542=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '11040543=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '11040544=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ INTEGER' +
        ','
      
        '11040545=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYP' +
        'E */ INTEGER,'
      
        '11040546=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCH' +
        'AR(150),'
      
        '11040547=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ I' +
        'NTEGER,'
      '11040548=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '11040549=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '11040550=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMER' +
        'IC(15,2),'
      
        '11040551=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMER' +
        'IC(15,2),'
      
        '11040552=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */' +
        ' NUMERIC(15,2),'
      
        '11040553=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NUM' +
        'ERIC(15,2),'
      
        '11040554=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GO' +
        'T */ NUMERIC(15,2),'
      
        '11040555=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ INTEGER,'
      
        '11040556=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11040557=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTEG' +
        'ER,'
      
        '11040558=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ INT' +
        'EGER,'
      '11040559=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11040560=  IS_MEBEL_ INTEGER = 0)'
      '11040561=RETURNS ('
