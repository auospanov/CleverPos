      '110752588=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110752589=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110752590='
      
        '110752591=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '110752592=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110752593=                     SET L.AMOUNT = L.AMOUNT - (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110752594=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110752595=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110752596='
      
        '110752597=                END ELSE if (Z_AMOUNT_ > AMOUNT_OLD_) ' +
        'THEN BEGIN'
      
        '110752598=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
