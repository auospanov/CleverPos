      '1101683326=        FROM KASSA k, g_prihod_rashod G'
      
        '1101683327=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101683328=         AND K.ACTION = 0'
      
        '1101683329=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1101683330=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '1101683331=         AND K.g_tochka = :G_TOCHKA_'
      '1101683332=        GROUP BY 2, 3'
      '1101683333=        UNION ALL'
      
        '1101683334=        SELECT lpad(EXTRACT(DAY FROM K.action_date), ' +
        '2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM K.action_date),'
      '1101683335=             K.action_date,'
      '1101683336=             '#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1086#1084#39' name'
      '1101683337=             ,SUM(K.summ)'
      '1101683338=        FROM KASSA k'
      '1101683339=        WHERE K.G_PRIHOD_RASHOD = 1'
      
        '1101683340=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '1101683341=         AND K.action_date <> (SELECT Z_DATE FROM ZAK' +
        'AZ WHERE ZAKAZ = K.zakaz)'
      '1101683342=         AND K.g_tochka = :G_TOCHKA_'
      '1101683343=        GROUP BY 2, 3'
      '1101683344=        INTO :date_str,'
      '1101683345=           :Z_DATE,'
      '1101683346=           :NAME,'
      '1101683347=           :SUMM'
      '1101683348=  DO BEGIN'
      '1101683349=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1101683350=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1101683351=      VALUES (21, 1, '#39#1055#1088#1080#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1074' '#1082#1072#1089#1089#1091#39');'
      '1101683352=      FIRST_ITER = 1;'
      '1101683353=    END'
      '1101683354='
      
        '1101683355=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '1101683356=      VALUES (22, 2, :DATE_STR, :z_date, :NAME, :SUMM' +
        ');'
      '1101683357='
      '1101683358=    SUMM_PRIHOD_ = SUMM_PRIHOD_ + SUMM;'
      '1101683359=  END'
      '1101683360='
      '1101683361=  IF (FIRST_ITER = 1) THEN'
      
        '1101683362=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '1101683363=    VALUES (23, 3, '#39#1048#1090#1086#1075#1086' '#1087#1088#1080#1093#1086#1076' '#1076#1077#1085#1077#1075#39', :SUMM_PRIHOD' +
        '_);'
      '1101683364=  SUMM_PRIHOD_ALL_ = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD_;'
      '1101683365='
      '1101683366=  -- '#1056#1040#1057#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1048#1047' '#1050#1040#1057#1057#1067
      '1101683367=  FIRST_ITER = 0;'
      '1101683368=  SUMM_RASHOD_ = 0;'
      
        '1101683369=  FOR SELECT lpad(EXTRACT(DAY FROM K.action_date), 2,' +
        ' '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39'.'#39 +
        '||EXTRACT(YEAR FROM K.action_date),'
      '1101683370=             K.action_date,'
      
        '1101683371=             G.name||DECODE(CHAR_LENGTH(K.NOTE), 0, '#39 +
        #39', '#39' ('#39'||K.NOTE||'#39')'#39')'
      '1101683372=             ,SUM(K.summ)'
      '1101683373=        FROM KASSA k, g_prihod_rashod G'
      
        '1101683374=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101683375=         AND K.ACTION = 1'
      
        '1101683376=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1101683377=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '1101683378=         AND K.g_tochka = :G_TOCHKA_'
      '1101683379=        GROUP BY 2, 3'
      '1101683380=        UNION ALL'
      
        '1101683381=        SELECT lpad(EXTRACT(DAY FROM K.action_date), ' +
        '2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM K.action_date),'
      '1101683382=             K.action_date,'
      '1101683383=             '#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1091'/'#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39' name'
      '1101683384=             ,SUM(K.summ)'
      '1101683385=        FROM KASSA k'
      '1101683386=        WHERE K.G_PRIHOD_RASHOD in (2,3)'
      
        '1101683387=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '1101683388=         AND K.action_date <> (SELECT DATE_RECEIPT FR' +
        'OM SKLAD_PARENT WHERE SKLAD = K.sklad)'
      '1101683389=         AND K.g_tochka = :G_TOCHKA_'
      '1101683390=        GROUP BY 2, 3'
      '1101683391=        INTO :date_str,'
      '1101683392=           :Z_DATE,'
      '1101683393=           :NAME,'
      '1101683394=           :SUMM'
      '1101683395=  DO BEGIN'
      '1101683396=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '1101683397=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_C' +
        'OL, Z_DATE_STR)'
      '1101683398=      VALUES (24, 1, '#39#1056#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1080#1079' '#1082#1072#1089#1089#1099#39');'
      '1101683399=      FIRST_ITER = 1;'
      '1101683400=    END'
      '1101683401='
      
        '1101683402=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '1101683403=      VALUES (25, 2, :DATE_STR, :z_date, :NAME, :SUMM' +
        ');'
      '1101683404='
      '1101683405=    SUMM_RASHOD_ = SUMM_RASHOD_ + SUMM;'
      '1101683406=  END'
      '1101683407='
      '1101683408=  IF (FIRST_ITER = 1) THEN'
      
        '1101683409=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL' +
        ', Z_DATE_STR, SUMM)'
      
        '1101683410=    VALUES (26, 3, '#39#1048#1090#1086#1075#1086' '#1088#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075#39', :SUMM_RASHOD' +
        '_);'
      '1101683411=  SUMM_RASHOD_ALL_ = SUMM_RASHOD_ALL_ + SUMM_RASHOD_;'
      '1101683412='
      '1101683413=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '1101683414=  VALUES(27, 1);'
      '1101683415='
      
        '1101683416=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, SUMM)'
      
        '1101683417=  VALUES (28, 1, '#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' '#1085#1072' '#1089#1091#1084#1084#1091#39 +
        ', :SUMM_PRIHOD_ALL_);'
      '1101683418='
      
        '1101683419=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, ' +
        'Z_DATE_STR, SUMM)'
      
        '1101683420=  VALUES (29, 1, '#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1085#1072' '#1089#1091#1084#1084#1091#39', :SUM' +
        'M_RASHOD_ALL_);'
      '1101683421='
      '1101683422=  FOR SELECT SORT_COL'
      '1101683423=            ,ROW_COL'
      '1101683424=            ,Z_DATE'
      '1101683425=            ,Z_DATE_STR'
      '1101683426=            ,ARTICUL'
      '1101683427=            ,BARCODE'
      '1101683428=            ,NAME'
      '1101683429=            ,AMOUNT'
      '1101683430=            ,SUMM'
      '1101683431=        FROM P_REP_KASSIR_TABLE'
      '1101683432=    ORDER BY 1, 3, 7'
      '1101683433=    INTO :SORT_COL,'
      '1101683434=        :ROWCOL,'
      '1101683435=        :Z_DATE_LOC,'
      '1101683436=        :Z_DATE,'
      '1101683437=        :ARTICUL,'
      '1101683438=        :BARCODE,'
      '1101683439=        :NAME,'
      '1101683440=        :AMOUNT,'
      '1101683441=        :SUMM'
      '1101683442=  DO'
      '1101683443=    suspend;'
      '1101683444=end'
      '1101683445=;'
      '1101683446='
      '1101683447=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1101683448=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101683449=  INCLUDE_NOL_ INTEGER,'
      '1101683450=  INCLUDE_FEW_ INTEGER,'
      '1101683451=  SORT_BY_NAME_ INTEGER,'
      '1101683452=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101683453=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101683454=RETURNS ('
      '1101683455=  PERIOD_ VARCHAR(40),'
      '1101683456=  ROW_NUM VARCHAR(15),'
      '1101683457=  ARTICUL VARCHAR(1000),'
      '1101683458=  BARCODE VARCHAR(30),'
      
        '1101683459=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101683460=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101683461=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101683462=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101683463=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101683464=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1101683465=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      '1101683466=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1101683467=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1101683468=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1101683469=  TOVAR_NAME VARCHAR(250),'
      '1101683470=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101683471=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101683472=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1101683473=  ERR_CODE INTEGER,'
      '1101683474=  ERR_MSG VARCHAR(1024))'
      '1101683475=AS'
      
        '1101683476=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATO' +
        'K_TOVAROV'#39';'
      '1101683477=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101683478=DECLARE VARIABLE I INTEGER = 1;'
      '1101683479=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101683480=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101683481=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1101683482=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1101683483=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1101683484=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1101683485=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1101683486=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1101683487=BEGIN'
      '1101683488='
      
        '1101683489=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1101683490=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101683491='
      '1101683492=  SELECT S.S_VALUE,'
      '1101683493=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1101683494=    FROM SYSTEM_SETUP S'
      '1101683495=   WHERE S.SYSTEM_SETUP = 1'
      '1101683496=    INTO :FORMULA_,'
      '1101683497=         :PRIHOD_CNT_;'
      '1101683498='
      '1101683499=  FOR SELECT GP.PATH,'
      '1101683500=             GP.G_PRODUCT'
      '1101683501=        FROM P_REP_TREE GP'
      '1101683502=       WHERE EXISTS (SELECT 1'
      '1101683503=                       FROM G_PRODUCT'
      '1101683504=                      WHERE IS_CATEGORY = 0'
      
        '1101683505=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1101683506=                    )'
      
        '1101683507=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101683508=              OR'
      '1101683509=              (:G_CATEGORY_ is NULL)'
      '1101683510=             )'
      '1101683511=       ORDER BY 1, 2'
      '1101683512=       INTO :PATH_NAME_,'
      '1101683513=            :G_PRODUCT_'
      '1101683514=  DO BEGIN'
      
        '1101683515=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1101683516=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1101683517=      SELECT COUNT(G.G_PRODUCT)'
      
        '1101683518=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101683519=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1101683520=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101683521=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101683522=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101683523=              OR'
      
        '1101683524=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1101683525=              or'
      
        '1101683526=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1101683527=             )'
      '1101683528=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101683529=         AND ((EXISTS (SELECT 1'
      '1101683530=                       FROM SKLAD S'
      '1101683531=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1101683532=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1101683533=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101683534=              OR'
      '1101683535=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1101683536=        INTO :CNT_;'
      '1101683537='
      '1101683538=      IF (CNT_ > 0) THEN BEGIN'
      
        '1101683539=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1101683540=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1101683541='
      
        '1101683542=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1101683543=                                              ARTICUL' +
        ','
      
        '1101683544=                                              BARCODE' +
        ','
      
        '1101683545=                                              NOMENCL' +
        'ATUR_NUM,'
      '1101683546=                                              NAME,'
      
        '1101683547=                                              UNIT_NA' +
        'ME,'
      '1101683548=                                              PRICE,'
      
        '1101683549=                                              VOLUME_' +
        'PRICE,'
      '1101683550=                                              AMOUNT,'
      
        '1101683551=                                              AMOUNT_' +
        'RESERVE,'
      '1101683552=                                              SUMM,'
      
        '1101683553=                                              PRICE_S' +
        'ELF,'
      
        '1101683554=                                              SORT_CO' +
        'L,'
      
        '1101683555=                                              IS_CATE' +
        'GORY,'
      '1101683556=                                              NOTE,'
      
        '1101683557=                                              CROSSCO' +
        'DE)'
      
        '1101683558=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1101683559=                 G.ARTICUL,'
      '1101683560=                 G.BARCODE,'
      '1101683561=                 G.NOMENCLATUR_NUM,'
      '1101683562=                 G.NAME,'
      '1101683563=                 U.SHORT_NAME,'
      '1101683564=                 G.PRICE,'
      '1101683565=                 G.VOLUME_PRICE,'
      '1101683566=                 COALESCE(S.AMOUNT, 0),'
      '1101683567=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1101683568=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1101683569=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1101683570=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1101683571=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1101683572=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '1101683573=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 2' +
        '00 '#1047#1040#1050#1059#1055#1054#1050
      '1101683574=                  DECODE(:FORMULA_,'
      '1101683575=                         1,'
      '1101683576=                         (SELECT S.price'
      '1101683577=                            FROM SKLAD S'
      
        '1101683578=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101683579=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1101683580=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1101683581=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1101683582=                                                     ' +
        'FROM SKLAD DD'
      
        '1101683583=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1101683584=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1101683585=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1101683586=                                                    )'
      '1101683587=                            ORDER BY 1 DESC'
      '1101683588=                            ROWS 1 TO 1'
      '1101683589=                         ),'
      
        '1101683590=                         (SELECT ROUND(SUM(T.AMOUNT *' +
        ' T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '1101683591=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1101683592=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1101683593=                                         SKLAD S'
      
        '1101683594=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1101683595=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1101683596=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1101683597=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1101683598=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1101683599=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '1101683600=                         )), 0) spr,'
      
        '1101683601=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1101683602=                 0'
      '1101683603=                 ,G.NOTE'
      
        '1101683604=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      
        '1101683605=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1101683606=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101683607=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1101683608=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101683609=             AND G.IS_CATEGORY = 0'
      '1101683610=             AND G.is_active = 1'
      '1101683611=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101683612=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101683613=                  OR'
      
        '1101683614=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1101683615=                  or'
      
        '1101683616=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1101683617=                 )'
      '1101683618=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101683619=             AND ((EXISTS (SELECT 1'
      '1101683620=                           FROM SKLAD S'
      
        '1101683621=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1101683622=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101683623=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101683624=                  OR'
      '1101683625=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1101683626=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '1101683627=      END'
      '1101683628=  END'
      '1101683629='
      
        '1101683630=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1101683631='
      
        '1101683632=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, AMOUNT, AM' +
        'OUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEGORY,'
      '1101683633=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '1101683634=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1101683635=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE' +
        ', :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_' +
        'CATEGORY, :TOVAR_NAME'
      '1101683636=  DO BEGIN'
      '1101683637=    I = I + 1;'
      '1101683638=    SUSPEND;'
      '1101683639=  END'
      '1101683640=WHEN ANY DO BEGIN'
      '1101683641=    Err_code = -20500;'
      
        '1101683642=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101683643=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101683644=  END'
      '1101683645=end'
      '1101683646=;'
      '1101683647='
      '1101683648=ALTER PROCEDURE P_REP_PRICE_LIST('
      '1101683649=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101683650=  INCLUDE_NOL_ INTEGER,'
      '1101683651=  INCLUDE_FEW_ INTEGER,'
      '1101683652=  SORT_BY_NAME_ INTEGER,'
      '1101683653=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101683654=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101683655=RETURNS ('
      '1101683656=  PERIOD_ VARCHAR(40),'
      '1101683657=  ROW_NUM VARCHAR(15),'
      '1101683658=  ARTICUL VARCHAR(1000),'
      '1101683659=  BARCODE VARCHAR(30),'
      
        '1101683660=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101683661=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101683662=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101683663=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101683664=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101683665=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1101683666=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1101683667=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      '1101683668=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1101683669=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1101683670=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1101683671=  TOVAR_NAME VARCHAR(250),'
      '1101683672=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101683673=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101683674=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1101683675=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101683676=  ERR_CODE INTEGER,'
      '1101683677=  ERR_MSG VARCHAR(1024))'
      '1101683678=AS'
      '1101683679=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '1101683680=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_' +
        'LIST'#39';'
      '1101683681=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101683682=DECLARE VARIABLE I INTEGER = 1;'
      '1101683683=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101683684=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101683685=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1101683686=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1101683687=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1101683688=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1101683689=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1101683690=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1101683691=BEGIN'
      '1101683692='
      
        '1101683693=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1101683694=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101683695='
      '1101683696=  SELECT S.S_VALUE,'
      '1101683697=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1101683698=    FROM SYSTEM_SETUP S'
      '1101683699=   WHERE S.SYSTEM_SETUP = 1'
      '1101683700=    INTO :FORMULA_,'
      '1101683701=         :PRIHOD_CNT_;'
      '1101683702='
      '1101683703=  FOR SELECT GP.PATH,'
      '1101683704=             GP.G_PRODUCT'
      '1101683705=        FROM P_REP_TREE GP'
      '1101683706=       WHERE EXISTS (SELECT 1'
      '1101683707=                       FROM G_PRODUCT'
      '1101683708=                      WHERE IS_CATEGORY = 0'
      
        '1101683709=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1101683710=                    )'
      
        '1101683711=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101683712=              OR'
      '1101683713=              (:G_CATEGORY_ is NULL)'
      '1101683714=             )'
      '1101683715=       ORDER BY 1, 2'
      '1101683716=       INTO :PATH_NAME_,'
      '1101683717=            :G_PRODUCT_'
      '1101683718=  DO BEGIN'
      
        '1101683719=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1101683720=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1101683721=      SELECT COUNT(G.G_PRODUCT)'
      
        '1101683722=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101683723=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1101683724=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101683725=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101683726=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101683727=              OR'
      
        '1101683728=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1101683729=              or'
      
        '1101683730=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1101683731=             )'
      '1101683732=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101683733=         AND ((EXISTS (SELECT 1'
      '1101683734=                       FROM SKLAD S'
      '1101683735=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1101683736=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1101683737=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101683738=              OR'
      '1101683739=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1101683740=        INTO :CNT_;'
      '1101683741='
      '1101683742=      IF (CNT_ > 0) THEN BEGIN'
      
        '1101683743=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1101683744=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1101683745='
      
        '1101683746=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1101683747=                                              ARTICUL' +
        ','
      
        '1101683748=                                              BARCODE' +
        ','
      
        '1101683749=                                              NOMENCL' +
        'ATUR_NUM,'
      '1101683750=                                              NAME,'
      
        '1101683751=                                              UNIT_NA' +
        'ME,'
      '1101683752=                                              PRICE,'
      
        '1101683753=                                              VOLUME_' +
        'PRICE,'
      
        '1101683754=                                              SKIDKA_' +
        'PRICE,'
      '1101683755=                                              AMOUNT,'
      
        '1101683756=                                              AMOUNT_' +
        'RESERVE,'
      '1101683757=                                              SUMM,'
      
        '1101683758=                                              PRICE_S' +
        'ELF,'
      
        '1101683759=                                              SORT_CO' +
        'L,'
      
        '1101683760=                                              IS_CATE' +
        'GORY,'
      '1101683761=                                              NOTE,'
      
        '1101683762=                                              CROSSCO' +
        'DE,'
      '1101683763=                                              PLACE)'
      
        '1101683764=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1101683765=                 G.ARTICUL,'
      '1101683766=                 G.BARCODE,'
      '1101683767=                 G.NOMENCLATUR_NUM,'
      '1101683768=                 G.NAME,'
      '1101683769=                 U.SHORT_NAME,'
      '1101683770=                 G.PRICE,'
      '1101683771=                 G.VOLUME_PRICE,'
      '1101683772=                 G.PRICE - GD.SKIDKA_SUM,'
      '1101683773=                 COALESCE(S.AMOUNT, 0),'
      '1101683774=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1101683775=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1101683776=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1101683777=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1101683778=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1101683779=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '1101683780=                  DECODE(:FORMULA_,'
      '1101683781=                         1,'
      
        '1101683782=                         (SELECT CAST(S.price AS MY_N' +
        'UMERIC)'
      '1101683783=                            FROM SKLAD S'
      
        '1101683784=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101683785=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1101683786=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1101683787=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1101683788=                                                     ' +
        'FROM SKLAD DD'
      
        '1101683789=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1101683790=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1101683791=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1101683792=                                                    )'
      '1101683793=                            ORDER BY 1 DESC'
      '1101683794=                            ROWS 1 TO 1'
      '1101683795=                         ),'
      
        '1101683796=                         (SELECT CAST(ROUND(SUM(T.AMO' +
        'UNT * T.PRICE)/SUM(T.AMOUNT), 2) AS MY_NUMERIC)'
      
        '1101683797=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1101683798=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1101683799=                                         SKLAD S'
      
        '1101683800=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1101683801=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1101683802=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1101683803=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1101683804=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1101683805=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '1101683806=                        )), 0) spr,'
      
        '1101683807=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1101683808=                 0'
      '1101683809=                 ,G.NOTE'
      
        '1101683810=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      '1101683811=                 ,G.PLACE'
      
        '1101683812=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '1101683813=                                                FROM ' +
        'G_DISCOUNT D'
      
        '1101683814=                                                WHERE' +
        ' ((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '1101683815=                                                     ' +
        '   AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '1101683816=                                                     ' +
        '   AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '1101683817=                                                     ' +
        ' )'
      
        '1101683818=                                                     ' +
        ' OR'
      
        '1101683819=                                                     ' +
        ' (D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '1101683820=                                                 AND ' +
        '((:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '1101683821=                                                     ' +
        'OR'
      
        '1101683822=                                                     ' +
        '(D.G_TOCHKA IS NULL))'
      
        '1101683823=                                              ) GD ON' +
        ' G.G_PRODUCT = GD.G_PRODUCT'
      
        '1101683824=                             LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1101683825=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1101683826=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1101683827=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1101683828=             AND G.IS_CATEGORY = 0'
      '1101683829=             AND G.is_active = 1'
      '1101683830=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1101683831=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1101683832=                  OR'
      
        '1101683833=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1101683834=                  or'
      
        '1101683835=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1101683836=                 )'
      '1101683837=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101683838=             AND ((EXISTS (SELECT 1'
      '1101683839=                           FROM SKLAD S'
      
        '1101683840=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1101683841=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1101683842=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1101683843=                  OR'
      '1101683844=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1101683845=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '1101683846=      END'
      '1101683847=  END'
      '1101683848='
      
        '1101683849=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1101683850='
      
        '1101683851=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKI' +
        'DKA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRIC' +
        'E_SELF, IS_CATEGORY,'
      '1101683852=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '1101683853=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1101683854=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOL' +
        'UME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRIC' +
        'E_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '1101683855=  DO BEGIN'
      '1101683856=    I = I + 1;'
      '1101683857=    SUSPEND;'
      '1101683858=  END'
      '1101683859='
      '1101683860=     /*'
      '1101683861=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '1101683862='
      '1101683863=     SELECT :I,'
      
        '1101683864=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045 +
        #1044#1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      
        '1101683865=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058 +
        #1054
      '1101683866=             U.SHORT_NAME UNIT_NAME,'
      '1101683867=             SS.PRICE,'
      '1101683868=             SS.VOLUME_PRICE,'
      '1101683869=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '1101683870=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE' +
        '(S.AMOUNT, 0)),'
      '1101683871=             SS.IS_CATEGORY'
      '1101683872=        FROM (WITH RECURSIVE TREE'
      '1101683873=              AS (SELECT T.G_PRODUCT,'
      '1101683874=                       T.NAME AS ARTICUL,'
      
        '1101683875=                       CAST(NULL AS VARCHAR(500)) NAM' +
        'E,'
      
        '1101683876=                       CAST(NULL AS NUMERIC(15,2)) PR' +
        'ICE,'
      
        '1101683877=                       CAST(NULL AS NUMERIC(15,2)) VO' +
        'LUME_PRICE,'
      '1101683878=                       T.IS_CATEGORY,'
      '1101683879=                       NULL G_UNIT'
      '1101683880=                  FROM G_PRODUCT T'
      '1101683881=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '1101683882=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T' +
        '.G_PRODUCT||'#39'~'#39
      '1101683883=                UNION ALL'
      '1101683884=                SELECT T.G_PRODUCT,'
      '1101683885=                       DECODE(T. T.ARTICUL,'
      '1101683886=                       T.NAME,'
      '1101683887=                       T.PRICE,'
      '1101683888=                       T.VOLUME_PRICE,'
      '1101683889=                       T.IS_CATEGORY,'
      '1101683890=                       T.G_UNIT'
      
        '1101683891=                  FROM G_PRODUCT T INNER JOIN TREE PR' +
        'IOR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '1101683892=                 WHERE T.IS_ACTIVE = 1'
      '1101683893=                )'
      '1101683894=             SELECT * FROM TREE) SS'
      
        '1101683895=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS' +
        '.G_PRODUCT = S.G_PRODUCT'
      
        '1101683896=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = ' +
        'U.G_UNIT'
      
        '1101683897=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PR' +
        'ODUCT = GD.G_PRODUCT'
      '1101683898=    INTO :ROW_NUM,'
      '1101683899=        :ARTICUL,'
      '1101683900=        :NAME,'
      '1101683901=        :UNIT_NAME,'
      '1101683902=        :PRICE,'
      '1101683903=        :VOLUME_PRICE,'
      '1101683904=        :SKIDKA_PRICE,'
      '1101683905=        :AMOUNT,'
      '1101683906=        :IS_CATEGORY'
      '1101683907=    DO BEGIN'
      '1101683908=      I = I + 1;'
      '1101683909=      SUSPEND;'
      '1101683910=    END  */'
      '1101683911=WHEN ANY DO BEGIN'
      '1101683912=    Err_code = -20500;'
      
        '1101683913=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101683914=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101683915=  END'
      '1101683916=end'
      '1101683917=;'
      '1101683918='
      '1101683919=ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      '1101683920=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101683921=  CURRENCY_ INTEGER)'
      '1101683922=RETURNS ('
      '1101683923=  NUMBER_STR_ VARCHAR(200),'
      '1101683924=  ROW_NUM INTEGER,'
      '1101683925=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101683926=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101683927=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101683928=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101683929=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101683930=  AMOUNT MY_NUMERIC_5,'
      '1101683931=  PRICE_N VARCHAR(50),'
      '1101683932=  SUMM_N VARCHAR(50),'
      '1101683933=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1101683934=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '1101683935=  SUMM_VSEGO_ VARCHAR(50),'
      '1101683936=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101683937=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101683938=  SUMM_STR_ VARCHAR(500),'
      '1101683939=  ERR_CODE NUMERIC(15,2),'
      '1101683940=  ERR_MSG VARCHAR(1024))'
      '1101683941=AS'
      '1101683942=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '1101683943=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD' +
        '_WAYBILL'#39';'
      '1101683944=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101683945=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101683946=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101683947=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      '1101683948=BEGIN'
      '1101683949='
      
        '1101683950=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.sklad||'#39' '#1086#1090' '#39'||lpad(EXTRACT' +
        '(DAY FROM P.date_receipt), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM' +
        ' P.date_receipt), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.date_receipt),'
      '1101683951=         G.name,'
      '1101683952=         P.IS_VOZVRAT'
      
        '1101683953=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON' +
        ' P.g_client = G.G_CLIENT'
      '1101683954=   WHERE P.sklad = :sklad_parent_'
      '1101683955=    INTO :NUMBER_STR_,'
      '1101683956=         :POSTAVSHIK_NAME_,'
      '1101683957=         :IS_VOZVRAT_;'
      '1101683958='
      
        '1101683959=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058 +
        #1068' '#1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      '1101683960=  IF (IS_VOZVRAT_ = 3) THEN'
      '1101683961=    SELECT G.NAME'
      '1101683962=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '1101683963=     WHERE P.SKLAD = :sklad_parent_'
      '1101683964=       AND P.G_TOCHKA = G.G_TOCHKA'
      '1101683965=      INTO :POSTAVSHIK_NAME_;'
      '1101683966='
      
        '1101683967=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1101683968=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39 +
        '.'#39', '#39','#39')'
      
        '1101683969=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.sum' +
        'm), :CURRENCY_))'
      '1101683970=    FROM SKLAD S'
      '1101683971=   WHERE S.sklad_parent = :sklad_parent_'
      '1101683972=   GROUP BY S.sklad_parent'
      '1101683973=    INTO :AMOUNT_VSEGO_,'
      '1101683974=         :SUMM_VSEGO_,'
      '1101683975=         :summ_str_;'
      '1101683976='
      '1101683977=  SELECT NAME'
      '1101683978=    FROM CUR_PARAMS'
      '1101683979=   WHERE CUR_PARAMS = 1'
      '1101683980=    INTO :G_OFFICIAL_FM_;'
      '1101683981='
      '1101683982=  FOR SELECT :I,'
      '1101683983=             G.name,'
      '1101683984=             G.ARTICUL,'
      '1101683985=             G.BARCODE,'
      '1101683986=             G.NOMENCLATUR_NUM,'
      '1101683987=             U.short_name,'
      
        '1101683988=             S.amount,    --REPLACE(CAST(S.amount AS ' +
        'VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1101683989=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101683990=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39'),'
      '1101683991=             G.PRICE'
      '1101683992=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '1101683993=       WHERE S.sklad_parent = :sklad_parent_'
      '1101683994=         AND S.g_product = G.g_product'
      '1101683995=         AND G.g_unit = U.g_unit'
      '1101683996=        INTO :ROW_NUM,'
      '1101683997=            :NAME,'
      '1101683998=            :ARTICUL,'
      '1101683999=            :BARCODE,'
      '1101684000=            :NOMENCLATUR_NUM,'
      '1101684001=            :SHORT_NAME,'
      '1101684002=            :AMOUNT,'
      '1101684003=            :PRICE_N,'
      '1101684004=            :SUMM_N,'
      '1101684005=            :PRICE'
      '1101684006=  DO BEGIN'
      '1101684007=    I = I + 1;'
      '1101684008=    SUSPEND;'
      '1101684009=  END'
      '1101684010=WHEN ANY DO BEGIN'
      '1101684011=    Err_code = -20500;'
      
        '1101684012=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101684013=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101684014=  END'
      '1101684015=end'
      '1101684016=;'
      '1101684017='
      '1101684018=ALTER PROCEDURE P_REP_PRODAZHA_WAYBILL('
      '1101684019=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101684020=  CURRENCY_ INTEGER)'
      '1101684021=RETURNS ('
      '1101684022=  NUMBER_STR_ VARCHAR(200),'
      '1101684023=  ROW_NUM INTEGER,'
      '1101684024=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101684025=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101684026=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101684027=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101684028=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101684029=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101684030=  AMOUNT MY_NUMERIC_5,'
      '1101684031=  PRICE_N VARCHAR(50),'
      '1101684032=  SUMM_N VARCHAR(50),'
      '1101684033=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1101684034=  SUMM_VSEGO_ VARCHAR(50),'
      '1101684035=  NDS_SUMM_ VARCHAR(50),'
      '1101684036=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101684037=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101684038=  SUMM_STR_ VARCHAR(500),'
      '1101684039=  NDS_SUMM_STR_ VARCHAR(500),'
      '1101684040=  ERR_CODE NUMERIC(15,2),'
      '1101684041=  ERR_MSG VARCHAR(1024))'
      '1101684042=AS'
      '1101684043=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '1101684044=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRODAZ' +
        'HA_WAYBILL'#39';'
      '1101684045=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101684046=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101684047=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101684048=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S_SUMM;'
      '1101684049=BEGIN'
      '1101684050='
      
        '1101684051=  SELECT decode(P.is_spisanie, 1, '#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39', '#39#1053#1072#1082#1083#1072 +
        #1076#1085#1072#1103' '#8470#39'||P.ZAKAZ)||'#39' '#1086#1090' '#39'||lpad(EXTRACT(DAY FROM P.z_date), 2, '#39 +
        '0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39'.'#39'||EXTRACT' +
        '(YEAR FROM P.z_date),'
      '1101684052=         G.name'
      '1101684053=    FROM ZAKAZ P,'
      '1101684054=         G_CLIENT G'
      '1101684055=   WHERE P.ZAKAZ = :ZAKAZ_'
      '1101684056=     AND P.g_client = G.G_CLIENT'
      '1101684057=    INTO :NUMBER_STR_,'
      '1101684058=         :CLIENT_NAME_;'
      '1101684059='
      
        '1101684060=  SELECT SUM(S.amount)--REPLACE(CAST(SUM(S.amount) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1101684061=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39 +
        '.'#39', '#39','#39')'
      
        '1101684062=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.sum' +
        'm), :CURRENCY_))'
      
        '1101684063=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(50)' +
        '), '#39'.'#39', '#39','#39')'
      '1101684064=         ,SUM(S.nds_summ)'
      '1101684065=    FROM ZAKAZ_DETAILS S'
      '1101684066=   WHERE S.ZAKAZ = :ZAKAZ_'
      '1101684067=   GROUP BY S.ZAKAZ'
      '1101684068=    INTO :AMOUNT_VSEGO_,'
      '1101684069=         :SUMM_VSEGO_,'
      '1101684070=         :summ_str_,'
      '1101684071=         :NDS_SUMM_,'
      '1101684072=         :NDS_;'
      '1101684073='
      '1101684074=  if (NDS_ > 0) then'
      
        '1101684075=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENC' +
        'YSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '1101684076='
      '1101684077=  SELECT NAME'
      '1101684078=    FROM CUR_PARAMS'
      '1101684079=   WHERE CUR_PARAMS = 1'
      '1101684080=    INTO :G_OFFICIAL_FM_;'
      '1101684081='
      '1101684082=  FOR SELECT :I,'
      '1101684083=             C.NAME,'
      '1101684084=             G.name,'
      '1101684085=             G.ARTICUL,'
      '1101684086=             G.BARCODE,'
      '1101684087=             G.NOMENCLATUR_NUM,'
      '1101684088=             U.short_name,'
      
        '1101684089=             S.amount,--REPLACE(CAST(S.amount AS VARC' +
        'HAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1101684090=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.' +
        #39', '#39','#39'),'
      
        '1101684091=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39')'
      
        '1101684092=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, ' +
        'G_PRODUCT C'
      '1101684093=       WHERE S.ZAKAZ = :ZAKAZ_'
      '1101684094=         AND S.g_product = G.g_product'
      '1101684095=         AND G.g_unit = U.g_unit'
      '1101684096=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '1101684097=        INTO :ROW_NUM,'
      '1101684098=            :CATEGORY_NAME,'
      '1101684099=            :NAME,'
      '1101684100=            :ARTICUL,'
      '1101684101=            :BARCODE,'
      '1101684102=            :NOMENCLATUR_NUM,'
      '1101684103=            :SHORT_NAME,'
      '1101684104=            :AMOUNT,'
      '1101684105=            :PRICE_N,'
      '1101684106=            :SUMM_N'
      '1101684107=  DO BEGIN'
      '1101684108=    I = I + 1;'
      '1101684109=    SUSPEND;'
      '1101684110=  END'
      '1101684111=WHEN ANY DO BEGIN'
      '1101684112=    Err_code = -20500;'
      
        '1101684113=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101684114=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101684115=  END'
      '1101684116=end'
      '1101684117=;'
      '1101684118='
      '1101684119=ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '1101684120=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101684121=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101684122=  DATE_BEGIN_ DATE,'
      '1101684123=  DATE_END_ DATE,'
      '1101684124=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101684125=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101684126=RETURNS ('
      '1101684127=  DATE_BEGIN_OUT_ DATE,'
      '1101684128=  DATE_END_OUT_ DATE,'
      '1101684129=  STR_ VARCHAR(500),'
      '1101684130=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '1101684131=  NAME VARCHAR(1000),'
      '1101684132=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101684133=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101684134=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101684135=  AMOUNT_IN MY_NUMERIC_5,'
      
        '1101684136=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '1101684137=  SUMM_PRIHOD NUMERIC(15,2),'
      '1101684138=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101684139=  SUMM_UHOD NUMERIC(15,2),'
      
        '1101684140=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1101684141=  SUMM_SPISANO NUMERIC(15,2),'
      
        '1101684142=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1101684143=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '1101684144=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.A' +
        'MOUNT,'
      '1101684145=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '1101684146=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1101684147=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '1101684148=  AMOUNT_OUT MY_NUMERIC_5,'
      '1101684149=  IS_HEAD INTEGER,'
      '1101684150=  ERR_CODE INTEGER,'
      '1101684151=  ERR_MSG VARCHAR(1024))'
      '1101684152=AS'
      
        '1101684153=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'MOVE'#39';'
      '1101684154=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101684155=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '1101684156=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1101684157=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT = 0;'
      '1101684158=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1101684159=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1101684160=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1101684161=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1101684162=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1101684163=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101684164=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1101684165=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1101684166=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1101684167=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1101684168=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101684169=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101684170=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1101684171=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1101684172=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1101684173=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101684174=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1101684175=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101684176=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1101684177=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101684178=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1101684179=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101684180=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0' +
        ';'
      
        '1101684181=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101684182=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1101684183=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1101684184=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1101684185=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101684186=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '1101684187=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1101684188=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '1101684189=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101684190=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1101684191=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1101684192=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      '1101684193=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '1101684194=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39';'
      
        '1101684195=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '1101684196=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '1101684197=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      '1101684198=BEGIN'
      '1101684199='
      '1101684200=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '1101684201=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1101684202='
      '1101684203=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '1101684204=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '1101684205=               (select (select COALESCE(sum(amount), ' +
        '0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1101684206=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1101684207=                       +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1101684208=                       (select COALESCE(sum(zr.AMOUNT' +
        '_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '1101684209=                        where zr.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCHKA||'#39'-'#39
      
        '1101684210=                        and zr.ZAKAZ_REAL_PARENT = zr' +
        'p.ZAKAZ_REAL_PARENT'
      
        '1101684211=                        and zrp.ZAKAZ_DATE >= :DATE_B' +
        'EGIN_)'
      '1101684212=                       +'
      
        '1101684213=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1101684214=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      
        '1101684215=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_'
      
        '1101684216=                        and z.IS_SPISANIE <> 2   -- '#1085 +
        #1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' ' +
        #1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1101684217=                        and not (z.IS_SPISANIE = 0 an' +
        'd z.NOT_MINUS_OSTATOK = 1))'
      '1101684218=                       +'
      
        '1101684219=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1101684220=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1101684221=                       +'
      
        '1101684222=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1101684223=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA||'#39'-'#39
      
        '1101684224=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1101684225=                       -'
      
        '1101684226=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1101684227=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101684228=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_ and not (sp.IS_VOZVRAT = 0 and sp.IS' +
        '_EXPECTED = 1))'
      '1101684229=                       -'
      
        '1101684230=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1101684231=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1101684232=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||Sp.g_tochka||'#39'-'#39' and sp.date_receipt >= :DATE_BEGIN_ and s' +
        'p.IS_EXPECTED = 0)'
      '1101684233=                  from rdb$database) AMOUNT_OUT,'
      '1101684234=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1101684235=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1101684236=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1101684237=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1101684238=                   AND SP.IS_VOZVRAT = 0'
      '1101684239=                   AND SP.IS_EXPECTED = 0'
      
        '1101684240=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') AMOUNT_PRIHOD,'
      '1101684241=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1101684242=                  FROM SKLAD S, SKLAD_PARENT SP WHERE' +
        ' S.G_PRODUCT = G.G_PRODUCT AND S.SKLAD_PARENT = SP.SKLAD'
      
        '1101684243=                   AND SP.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1101684244=                   AND SP.IS_VOZVRAT = 0'
      '1101684245=                   AND SP.IS_EXPECTED = 0'
      
        '1101684246=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|SP.G_TOCHKA||'#39'-'#39') SUMM_PRIHOD,'
      '1101684247=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '1101684248=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1101684249=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101684250=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101684251=                   AND Z.IS_SPISANIE = 0'
      '1101684252=                   AND Z.IS_RESERVE = 0'
      '1101684253=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1101684254=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_UHOD,'
      '1101684255=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1101684256=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101684257=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101684258=                   AND Z.IS_SPISANIE = 0'
      '1101684259=                   AND Z.IS_RESERVE = 0'
      '1101684260=                   AND Z.NOT_MINUS_OSTATOK = 0'
      
        '1101684261=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_UHOD,'
      '1101684262=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101684263=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1101684264=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101684265=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101684266=                   AND Z.IS_SPISANIE = 1'
      
        '1101684267=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') AMOUNT_SPISANO,'
      '1101684268=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1101684269=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1101684270=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1101684271=                   AND Z.IS_SPISANIE = 1'
      
        '1101684272=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|Z.G_TOCHKA||'#39'-'#39') SUMM_SPISANO,'
      '1101684273=               -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1101684274=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1101684275=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1101684276=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1101684277=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1101684278=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') AMOUNT_VOZVRAT,'
      '1101684279=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1101684280=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1101684281=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1101684282=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1101684283=                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|S.G_TOCHKA||'#39'-'#39') SUMM_VOZVRAT,'
      
        '1101684284=               -- '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059 +
        #1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1067#1056#1040#1042#1053#1048#1042#1040#1053#1048#1045' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1042' '#1056#1045#1047#1059#1051 +
        #1068#1058#1040#1058#1045' '#1056#1045#1042#1048#1047#1048#1048
      '1101684285=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
