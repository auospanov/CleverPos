        '*************************/'
      '110102222=ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '110102223=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110102224=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110102225=  MODE_ INTEGER)'
      '110102226=RETURNS ('
      '110102227=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '110102228=AS'
      '110102229=/*'
      
        '110102230=11.04.2019 '#1047#1053#1040#1052#1045#1053#1040#1058#1045#1051#1068#1053#1067#1049' '#1044#1045#1053#1068', '#1056#1045#1064#1048#1051' '#1058#1045#1055#1045#1056#1068' '#1048#1057#1050#1040#1058#1068' '#1053#1045 +
        ' '#1055#1054' IS_LAST, '#1040' '#1055#1054' MAX DATE_RECEIPT'
      '110102231=*/'
      
        '110102232=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.' +
        'S_VALUE;'
      '110102233=BEGIN'
      '110102234=  IF (G_TOCHKA_ IS NULL) THEN'
      '110102235=    SELECT ID'
      '110102236=      FROM CUR_PARAMS'
      '110102237=     WHERE CUR_PARAMS = 2'
      '110102238=      INTO :G_TOCHKA_;'
      '110102239='
      '110102240=  if (COALESCE(MODE_, 0) = 0) then'
      '110102241=      SELECT S.price'
      '110102242=        FROM SKLAD S'
      '110102243=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110102244=         AND S.g_product = :G_PRODUCT_'
      '110102245=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '110102246=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECE' +
        'IPT)'
      '110102247=                                 FROM SKLAD DD'
      
        '110102248=                                WHERE DD.g_product = :' +
        'G_PRODUCT_'
      
        '110102249=                                  AND DD.G_TOCHKA = :G' +
        '_TOCHKA_'
      
        '110102250=                                  AND DD.IS_VOZVRAT IN' +
        ' (0, 4)'
      '110102251=                                )'
      '110102252=        ORDER BY S.SKLAD DESC'
      '110102253=        ROWS 1 TO 1'
      '110102254=        INTO :PRICE_;'
      '110102255=      /*SELECT S.PRICE'
      '110102256=        FROM SKLAD S'
      '110102257=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110102258=         AND S.IS_LAST = 1'
      '110102259=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110102260=        INTO :PRICE_;*/'
      '110102261='
      
        '110102262=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047 +
        #1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '110102263=  ELSE BEGIN'
      '110102264=    SELECT S.S_VALUE'
      '110102265=      FROM SYSTEM_SETUP S'
      '110102266=     WHERE S.SYSTEM_SETUP = 1'
      '110102267=      INTO :FORMULA_;'
      '110102268='
      '110102269=    IF (FORMULA_ = 1) THEN BEGIN'
      '110102270=      SELECT S.price'
      '110102271=        FROM SKLAD S'
      '110102272=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110102273=         AND S.g_product = :G_PRODUCT_'
      '110102274=         AND S.IS_VOZVRAT IN (0, 4)'
      
        '110102275=         AND S.date_receipt = (SELECT MAX(DD.DATE_RECE' +
        'IPT)'
      '110102276=                                 FROM SKLAD DD'
      
        '110102277=                                WHERE DD.g_product = :' +
        'G_PRODUCT_'
      
        '110102278=                                  AND DD.G_TOCHKA = :G' +
        '_TOCHKA_'
      
        '110102279=                                  AND DD.IS_VOZVRAT IN' +
        ' (0, 4)'
      '110102280=                                )'
      '110102281=        ORDER BY 1 DESC'
      '110102282=        ROWS 1 TO 1'
      '110102283=        INTO :PRICE_;'
      '110102284=      /*SELECT S.PRICE'
      '110102285=        FROM SKLAD S'
      '110102286=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '110102287=         AND S.IS_LAST = 1'
      '110102288=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110102289=        INTO :PRICE_;*/'
      '110102290='
      
        '110102291=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045 +
        #1058' '#1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052 +
        #1048'" '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '110102292=      IF (ROW_COUNT = 0) THEN'
      '110102293=        SELECT S.PRICE'
      '110102294=          FROM SKLAD S'
      '110102295=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110102296=                            FROM SKLAD SS'
      
        '110102297=                           WHERE /*SS.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '110102298=                             AND */SS.G_PRODUCT = :G_P' +
        'RODUCT_'
      
        '110102299=                             AND SS.DATE_RECEIPT = (SE' +
        'LECT MAX(SSS.DATE_RECEIPT)'
      
        '110102300=                                                      ' +
        'FROM SKLAD SSS'
      
        '110102301=                                                     W' +
        'HERE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '110102302=                                                      ' +
        ' AND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '110102303=                                                      ' +
        ' AND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '110102304=                                                   )'
      
        '110102305=                             AND SS.IS_VOZVRAT IN (0, ' +
        '4) --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '110102306=                         )'
      '110102307=          INTO :PRICE_;'
      '110102308=    END ELSE BEGIN'
      
        '110102309=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUN' +
        'T), 2)'
      '110102310=        FROM (SELECT S.AMOUNT, S.PRICE'
      '110102311=                FROM SKLAD_PARENT SP,'
      '110102312=                     SKLAD S'
      '110102313=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '110102314=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '110102315=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '110102316=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '110102317=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.' +
        'IS_VOZVRAT IN (0, 3, 4)'
      
        '110102318=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO' +
        ' 5) T'
      '110102319=        INTO :PRICE_;'
      '110102320='
      
        '110102321=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045 +
        #1058' '#1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048'"' +
        ' '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '110102322=      IF (PRICE_ IS NULL) THEN'
      
        '110102323=        SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMO' +
        'UNT), 2)'
      '110102324=        FROM (SELECT S.AMOUNT, S.PRICE'
      '110102325=                FROM SKLAD_PARENT SP,'
      '110102326=                     SKLAD S'
      '110102327=               WHERE SP.DATE_RECEIPT <= CURRENT_DATE'
      '110102328=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '110102329=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '110102330=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.' +
        'IS_VOZVRAT IN (0, 3, 4)'
      
        '110102331=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO' +
        ' 5) T'
      '110102332=          INTO :PRICE_;'
      '110102333=    END'
      '110102334=  END'
      '110102335='
      '110102336=  PRICE_ = COALESCE(:PRICE_, 0);'
      '110102337=  SUSPEND;'
      '110102338=END'
      '110102339=;'
      '110102340='
      '110102341=ALTER PROCEDURE GET_SKLAD('
      '110102342=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110102343=  MODE_ INTEGER)'
      '110102344=RETURNS ('
      '110102345=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '110102346=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110102347=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110102348=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '110102349=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '110102350=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110102351=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110102352=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110102353=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110102354=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY,'
      
        '110102355=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '110102356=  CNT_T_ INTEGER,'
      
        '110102357=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110102358=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110102359=  HAVERIGHT_ INTEGER,'
      '110102360=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110102361=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ','
      '110102362=  ERR_CODE INTEGER,'
      '110102363=  ERR_MSG VARCHAR(1024))'
      '110102364=AS'
      '110102365=/*'
      
        '110102366=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083 +
        #1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '110102367=*/'
      
        '110102368=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110102369=begin'
      
        '110102370=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080 +
        ' INS '#1080' '#1087#1088#1080' UPD'
      '110102371=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110102372=  CNT_T_ = 0;'
      '110102373=  SELECT COUNT(*)'
      '110102374=    FROM (SELECT S.SKLAD'
      '110102375=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '110102376=    INTO :CNT_T_;'
      '110102377='
      '110102378=  SELECT'
      '110102379=    T.DATE_RECEIPT,'
      '110102380=    T.TIME_RECEIPT,'
      '110102381=    T.G_CLIENT,'
      '110102382=    T.G_PAYMENT_TYPE,'
      '110102383=    T.OSNOVANIE,'
      '110102384=    T.NOTE,'
      '110102385=    T.SUMM,'
      '110102386=    T.SUMM_FACT,'
      '110102387=    T.IS_PAYED_ALL'
      '110102388=    ,T.SUMM_CURRENCY'
      '110102389=    ,T.is_expected'
      '110102390=  FROM SKLAD_PARENT T'
      '110102391=  WHERE T.SKLAD = :SKLAD_'
      '110102392=  INTO'
      '110102393=    :DATE_RECEIPT_,'
      '110102394=    :TIME_RECEIPT_,'
      '110102395=    :G_CLIENT_,'
      '110102396=    :G_PAYMENT_TYPE_,'
      '110102397=    :OSNOVANIE_,'
      '110102398=    :NOTE_,'
      '110102399=    :SUMM_,'
      '110102400=    :SUMM_FACT_,'
      '110102401=    :IS_PAYED_ALL_'
      '110102402=    ,:SUMM_CURRENCY_'
      '110102403=    ,:IS_EXPECTED_;'
      '110102404='
      '110102405=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110102406=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY, SALE_PRICE)'
      
        '110102407=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKL' +
        'AD_,'
      '110102408=         PRICE_CURRENCY, SUMM_CURRENCY, G.PRICE'
      '110102409=    FROM SKLAD S, G_PRODUCT G'
      '110102410=   WHERE SKLAD_PARENT = :SKLAD_'
      '110102411=     AND S.G_PRODUCT = G.G_PRODUCT'
      '110102412=   ORDER BY SKLAD;'
      '110102413='
      '110102414=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110102415=  SELECT K.G_PRIHOD_RASHOD,'
      '110102416=         K.SUMM'
      
        '110102417=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110102418=   WHERE K.SKLAD = :SKLAD_'
      '110102419=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110102420=    INTO :G_PRIHOD_,'
      '110102421=         :SUMM_PRIHOD_;'
      '110102422='
      
        '110102423=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110102424='
      
        '110102425=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110102426=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110102427=  HaveRight_ = 1;'
      '110102428=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110102429=    SELECT ID'
      '110102430=      FROM CUR_PARAMS'
      '110102431=     WHERE CUR_PARAMS = 1'
      '110102432=      INTO :G_OFFICIAL_CUR_;'
      '110102433='
      
        '110102434=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110102435=      HaveRight_ = 1;'
      '110102436=    else'
      
        '110102437=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110102438=  END'
      '110102439=end'
      '110102440=;'
      '110102441='
      '110102442=ALTER PROCEDURE INS_SKLAD('
      '110102443=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110102444=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110102445=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110102446=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110102447=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110102448=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110102449=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110102450=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110102451=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110102452=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110102453=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110102454=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110102455=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110102456=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110102457=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110102458=RETURNS ('
      '110102459=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110102460=  ERR_CODE INTEGER,'
      '110102461=  ERR_MSG VARCHAR(1024))'
      '110102462=AS'
      '110102463=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110102464=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110102465=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110102466=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110102467=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110102468=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110102469=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110102470=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110102471=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110102472=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110102473=--'
      
        '110102474=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110102475=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110102476=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110102477=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110102478=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110102479=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110102480=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110102481=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110102482=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110102483=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110102484=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110102485=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110102486=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110102487=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110102488=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110102489=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110102490=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110102491=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110102492=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110102493=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110102494=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110102495=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110102496=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110102497=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      
        '110102498=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'SALE_PRICE;'
      
        '110102499=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      '110102500=BEGIN'
      '110102501='
      '110102502=  PNT_ = '#39'00'#39';'
      '110102503=  IS_THIS_LAST_ = 0;'
      '110102504='
      '110102505=  IF (G_TOCHKA_ IS NULL) THEN'
      '110102506=    SELECT ID'
      '110102507=      FROM CUR_PARAMS'
      '110102508=     WHERE CUR_PARAMS = 2'
      '110102509=      INTO :G_TOCHKA_;'
      '110102510='
      '110102511=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110102512=  SELECT ID'
      '110102513=    FROM CUR_PARAMS'
      '110102514=   WHERE CUR_PARAMS = 1'
      '110102515=    INTO :G_OFFICIAL_;'
      '110102516='
      '110102517=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110102518=                            DATE_RECEIPT,'
      '110102519=                            TIME_RECEIPT,'
      '110102520=                            G_CLIENT,'
      '110102521=                            G_PAYMENT_TYPE,'
      '110102522=                            OSNOVANIE,'
      '110102523=                            NOTE,'
      '110102524=                            SUMM,'
      '110102525=                            SUMM_FACT,'
      '110102526=                            SUMM_CURRENCY,'
      '110102527=                            IS_PAYED_ALL,'
      '110102528=                            IS_VOZVRAT,'
      '110102529=                            G_TOCHKA'
      '110102530=                            ,G_OFFICIAL'
      '110102531=                            ,IS_EXPECTED)'
      '110102532=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110102533=          :DATE_RECEIPT_,'
      '110102534=          :TIME_RECEIPT_,'
      '110102535=          :G_CLIENT_,'
      '110102536=          :G_PAYMENT_TYPE_,'
      '110102537=          :OSNOVANIE_,'
      '110102538=          :NOTE_,'
      '110102539=          :SUMM_,'
      '110102540=          :SUMM_FACT_,'
      '110102541=          :SUMM_CURRENCY_,'
      
        '110102542=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PA' +
        'YED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "' +
        #1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110102543=          :IS_VOZVRAT_,'
      '110102544=          :G_TOCHKA_'
      '110102545=          ,:G_OFFICIAL_'
      '110102546=          ,:IS_EXPECTED_)'
      '110102547=  RETURNING'
      '110102548=    SKLAD'
      '110102549=  INTO'
      '110102550=    :SKLAD_;'
      '110102551='
      '110102552=  PNT_ = '#39'01'#39';'
      '110102553=  FOR SELECT SKLAD,'
      '110102554=             T.G_PRODUCT,'
      '110102555=             AMOUNT,'
      '110102556=             T.PRICE,'
      '110102557=             SUMM,'
      '110102558=             NDS,'
      '110102559=             NDS_SUMM'
      '110102560=             ,PRICE_CURRENCY'
      '110102561=             ,SUMM_CURRENCY'
      '110102562=             ,SALE_PRICE'
      '110102563=             ,GG.PRICE'
      '110102564=        FROM SKLAD_TMP T,'
      '110102565=             G_PRODUCT GG'
      '110102566=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110102567=      ORDER BY 1'
      '110102568=      INTO :SKLAD_TMP_,'
      '110102569=           :RG_PRODUCT_,'
      '110102570=           :RAMOUNT_,'
      '110102571=           :RPRICE_,'
      '110102572=           :RSUMM_,'
      '110102573=           :RNDS_,'
      '110102574=           :RNDS_SUMM_'
      '110102575=           ,:PRICE_CURRENCY_'
      '110102576=           ,:SUMM_CURRENCY_TMP_'
      '110102577=           ,:SALE_PRICE_'
      '110102578=           ,:SALE_PRICE_CUR_'
      '110102579=  DO BEGIN'
      '110102580=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110102581=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110102582=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110102583=      IS_THIS_LAST_ = 0;'
      '110102584=      SELECT MAX(SK.DATE_RECEIPT)'
      '110102585=        FROM SKLAD SK'
      '110102586=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110102587=         AND SK.IS_LAST = 1'
      '110102588=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110102589=        INTO :DATE_LAST_;'
      '110102590='
      
        '110102591=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110102592=        UPDATE SKLAD SK'
      '110102593=           SET SK.IS_LAST = 0'
      '110102594=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110102595=           AND SK.IS_LAST = 1'
      '110102596=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110102597='
      '110102598=        IS_THIS_LAST_ = 1;'
      '110102599=      END'
      '110102600=    END'
      '110102601='
      '110102602=    INSERT INTO SKLAD'
      '110102603=    ('
      '110102604=     SKLAD,'
      '110102605=     SKLAD_PARENT,'
      '110102606=     DATE_RECEIPT,'
      '110102607=     G_CLIENT,'
      '110102608=     G_PRODUCT,'
      '110102609=     AMOUNT,'
      '110102610=     PRICE,'
      '110102611=     SUMM,'
      '110102612=     G_PAYMENT_TYPE,'
      '110102613=     OSNOVANIE,'
      '110102614=     NOTE,'
      '110102615=     NDS,'
      '110102616=     NDS_SUMM,'
      '110102617=     IS_LAST,'
      '110102618=     IS_VOZVRAT,'
      '110102619=     G_TOCHKA'
      '110102620=     ,PRICE_CURRENCY'
      '110102621=     ,SUMM_CURRENCY'
      '110102622=    ) VALUES ('
      '110102623=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110102624=     :SKLAD_,'
      '110102625=     :DATE_RECEIPT_,'
      '110102626=     :G_CLIENT_,'
      '110102627=     :RG_PRODUCT_,'
      '110102628=     :RAMOUNT_,'
      '110102629=     :RPRICE_,'
      '110102630=     :RSUMM_,'
      '110102631=     :G_PAYMENT_TYPE_,'
      '110102632=     :OSNOVANIE_,'
      '110102633=     :NOTE_,'
      '110102634=     :RNDS_,'
      '110102635=     :RNDS_SUMM_,'
      
        '110102636=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110102637=     :IS_VOZVRAT_,'
      '110102638=     :G_TOCHKA_'
      '110102639=     ,:PRICE_CURRENCY_'
      '110102640=     ,:SUMM_CURRENCY_TMP_'
      '110102641=    );'
      '110102642='
      
        '110102643=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110102644=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110102645=        PNT_ = '#39'02'#39';'
      '110102646=        UPDATE LT_SKLAD_PRODUCT L'
      '110102647=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110102648=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110102649=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110102650='
      '110102651=        IF (ROW_COUNT = 0) THEN'
      
        '110102652=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110102653=    END'
      '110102654='
      '110102655=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_) THEN'
      '110102656=      UPDATE G_PRODUCT G'
      '110102657=         SET G.PRICE = :SALE_PRICE_'
      '110102658=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110102659=  END'
      '110102660=  ----------------------------------------'
      '110102661='
      
        '110102662=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110102663=  PNT_ = '#39'05'#39';'
      
        '110102664=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110102665=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110102666=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110102667=      ELSE'
      '110102668=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110102669='
      
        '110102670=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110102671=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110102672=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110102673=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110102674=                                        :SUMM_FACT_,'
      
        '110102675=                                        :DATE_RECEIPT_' +
        ','
      
        '110102676=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110102677=                                        NULL,   --ZAKA' +
        'Z_'
      '110102678=                                        :SKLAD_,'
      
        '110102679=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110102680=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110102681=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110102682=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110102683=            EXIT;'
      '110102684=          END'
      '110102685=      END ELSE BEGIN'
      '110102686=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110102687=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110102688=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110102689=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110102690=            ELSE'
      
        '110102691=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110102692='
      '110102693=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110102694=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110102695='
      
        '110102696=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110102697='
      '110102698=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110102699=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110102700=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110102701=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110102702=                                              :PAYMENT' +
        '_DATE_,'
      
        '110102703=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110102704=                                              NULL,   ' +
        '--ZAKAZ_'
      '110102705=                                              :SKLAD_,'
      
        '110102706=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110102707=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110102708=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110102709=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110102710=                  EXIT;'
      '110102711=                END'
      '110102712=            END'
      '110102713=          END'
      '110102714=      END'
      '110102715=  END'
      '110102716='
      '110102717=  DELETE FROM SKLAD_TMP;'
      '110102718='
      
        '110102719=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110102720=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110102721=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110102722=                                  G_PRIHOD_,'
      '110102723=                                  :SUMM_PRIHOD_,'
      '110102724=                                  :DATE_RECEIPT_,'
      
        '110102725=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110102726=                                  NULL,   --:ZAKAZ_,'
      '110102727=                                  :SKLAD_,'
      '110102728=                                  :G_PAYMENT_TYPE_,'
      
        '110102729=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110102730=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110102731=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110102732=      EXIT;'
      '110102733=    END'
      '110102734=  END'
      '110102735=end'
      '110102736=;'
      '110102737='
      '110102738=ALTER PROCEDURE INS_SKLAD_TMP('
      '110102739=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110102740=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110102741=  PRICE_ NUMERIC(15,2),'
      '110102742=  SUMM_ NUMERIC(15,2),'
      '110102743=  NDS_ NUMERIC(15,2),'
      '110102744=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110102745=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110102746=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0,'
      '110102747=  SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.SALE_PRICE = 0)'
      '110102748=RETURNS ('
      '110102749=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110102750=  ERR_CODE INTEGER,'
      '110102751=  ERR_MSG VARCHAR(1024))'
      '110102752=AS'
      
        '110102753=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110102754=BEGIN'
      '110102755=  SELECT T.SKLAD'
      '110102756=    FROM SKLAD_TMP T'
      '110102757=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110102758=     AND T.PRICE = :PRICE_'
      '110102759=    INTO :SKLAD_;'
      '110102760='
      '110102761=  IF (SKLAD_ IS NOT NULL) THEN'
      '110102762=    UPDATE SKLAD_TMP T'
      '110102763=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110102764=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110102765=     WHERE T.SKLAD = :SKLAD_;'
      '110102766='
      '110102767=  ELSE'
      
        '110102768=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY, SALE' +
        '_PRICE)'
      
        '110102769=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110102770=        ,:PRICE_CURRENCY_'
      '110102771=        ,:SUMM_CURRENCY_'
      '110102772=        ,:SALE_PRICE_)'
      '110102773=      RETURNING SKLAD'
      '110102774=      INTO :SKLAD_;'
      '110102775=end'
      '110102776=;'
      '110102777='
      '110102778=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '110102779=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110102780=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110102781=RETURNS ('
      '110102782=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110102783=  ERR_CODE INTEGER,'
      '110102784=  ERR_MSG VARCHAR(1024))'
      '110102785=AS'
      '110102786=/*'
      '110102787='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '110102788=*/'
      
        '110102789=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110102790=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110102791=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '110102792=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110102793=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '110102794=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT.' +
        'PRICE;'
      
        '110102795=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      '110102796=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110102797=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110102798=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110102799=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      '110102800=BEGIN'
      '110102801='
      '110102802=  PNT_ = '#39'01'#39';'
      
        '110102803=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCOD' +
        'E_, NULL, NULL, NULL, NULL)'
      
        '110102804=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGOR' +
        'Y_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :ERR_CODE, :ERR_MSG;'
      '110102805='
      '110102806=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110102807=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110102808=    EXIT;'
      '110102809=  END'
      '110102810='
      '110102811=  PNT_ = '#39'02'#39';'
      
        '110102812=  EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, :' +
        'G_TOCHKA_, 0)'
      '110102813=      RETURNING_VALUES :PRICE_;'
      '110102814='
      '110102815=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110102816=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110102817=    EXIT;'
      '110102818=  END'
      '110102819='
      '110102820=  AMOUNT_ = 1;'
      '110102821='
      '110102822=  SELECT T.SKLAD'
      '110102823=    FROM SKLAD_TMP T'
      '110102824=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110102825=     AND T.PRICE = :PRICE_'
      '110102826=    INTO :SKLAD_;'
      '110102827='
      '110102828=  IF (SKLAD_ IS NOT NULL) THEN'
      '110102829=    UPDATE SKLAD_TMP T'
      '110102830=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110102831=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110102832=     WHERE T.SKLAD = :SKLAD_;'
      '110102833='
      '110102834=  ELSE'
      
        '110102835=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, SALE_PRICE)'
      
        '110102836=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_, :SALE_PRICE_)'
      '110102837=      RETURNING SKLAD'
      '110102838=      INTO :SKLAD_;'
      '110102839=end'
      '110102840=;'
      '110102841='
      '110102842=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110102843=RETURNS ('
      '110102844=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110102845=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '110102846=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '110102847=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '110102848=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '110102849=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110102850=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110102851=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '110102852=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '110102853=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110102854=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110102855=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110102856=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE)'
      '110102857=AS'
      '110102858=begin'
      '110102859=  FOR'
      
        '110102860=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.' +
        'SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, T.SALE_PRICE, P.ARTI' +
        'CUL'
      '110102861=           ,PRICE_CURRENCY'
      '110102862=           ,SUMM_CURRENCY'
      '110102863=    FROM SKLAD_TMP T,'
      '110102864=         G_PRODUCT P'
      '110102865=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110102866=    ORDER BY T.sklad'
      
        '110102867=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :' +
        'NDS, :NDS_SUMM, :NAME, :BARCODE, :SALE_PRICE, :ARTICUL'
      '110102868=      ,:PRICE_CURRENCY'
      '110102869=      ,:SUMM_CURRENCY'
      '110102870=  DO'
      '110102871=    suspend;'
      '110102872=end'
      '110102873=;'
      '110102874='
      '110102875='
      
        '110102876=/*****************************************************' +
        '*************************/'
      
        '110102877=/****                   Restoring deactivated procedur' +
        'es                   ****/'
      
        '110102878=/*****************************************************' +
        '*************************/'
      '110102879=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '110102880=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110102881=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110102882=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110102883=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110102884=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110102885=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110102886=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110102887=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110102888=  SELF_PRICE_ NUMERIC(15,2),'
      '110102889=  AMOUNT_ MY_NUMERIC_5,'
      '110102890=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110102891=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110102892=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110102893=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110102894=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '110102895=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110102896=  CATEGORY_NAME_ VARCHAR(1000),'
      '110102897=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110102898=  IS_THIS_LAST_ INTEGER,'
      '110102899=  UPDATE_IF_EXIST_ INTEGER)'
      '110102900=RETURNS ('
      '110102901=  ERR_CODE INTEGER,'
      '110102902=  ERR_MSG VARCHAR(1024))'
      '110102903=AS'
      
        '110102904=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PR' +
        'ODUCT'#39';'
      '110102905=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110102906=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110102907=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR;'
      
        '110102908=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110102909=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110102910=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110102911=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110102912=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110102913=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110102914=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM_CURRENCY;'
      '110102915=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110102916=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110102917=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110102918=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110102919=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110102920=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110102921=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '110102922=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110102923=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '110102924=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110102925=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110102926=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110102927=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110102928=BEGIN'
      '110102929=    ERR_MSG = '#39#39';'
      '110102930=    PNT_ = '#39'00'#39';'
      '110102931='
      
