      '1102112233=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1102112234=  ELSE BEGIN'
      '1102112235=      PNT_ = '#39'020'#39';'
      '1102112236=      SELECT SP.G_TOCHKA,'
