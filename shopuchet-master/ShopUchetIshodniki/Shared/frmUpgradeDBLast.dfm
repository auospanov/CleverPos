        '110242292=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053#1054 +
        #1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '110242293=      IF (IS_VOZVRAT_ = 0) THEN'
      '110242294=        G_PRIHOD_RASHOD_ = 2;'
      '110242295=      ELSE'
      '110242296=        G_PRIHOD_RASHOD_ = 3;'
      '110242297='
      '110242298=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110242299=            PNT_ = '#39#39'09'#39#39';'
      '110242300=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110242301=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110242302=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110242303=            ELSE'
      
        '110242304=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110242305='
      '110242306=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110242307=                RETURNING_VALUES :KASSA_, :PAYMENT_DAT' +
        'E_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110242308='
      
        '110242309=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110242310=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THEN'
      
        '110242311=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110242312=                                              :G_PRIHO' +
