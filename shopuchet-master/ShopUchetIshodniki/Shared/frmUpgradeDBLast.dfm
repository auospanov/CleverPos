      '1101321384=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101321385=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '1101321386=      PNT_ = '#39'25'#39';'
      
        '1101321387=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
