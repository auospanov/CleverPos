      '1106017383=ALTER PROCEDURE G_READ_G_DISCONT_CARD_LIST('
      '1106017384=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '1106017385=RETURNS ('
      
        '1106017386=  G_DISCONT_CARD TYPE OF COLUMN G_DISCONT_CARD.G_DISC' +
        'ONT_CARD,'
      '1106017387=  BARCODE TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '1106017388=  N_PERCENT TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '1106017389=  SUMM TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '1106017390=  SUMM_ALL TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL)'
      '1106017391=AS'
      
        '1106017392=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_READ_G_DIS' +
        'CONT_CARD_LIST'#39';'
      '1106017393=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106017394=BEGIN'
      '1106017395=  FOR SELECT'
      '1106017396=    G_DISCONT_CARD,'
      '1106017397=    BARCODE,'
      '1106017398=    N_PERCENT,'
      '1106017399=    SUMM,'
      '1106017400=    SUMM_ALL'
      '1106017401=  FROM G_DISCONT_CARD'
      '1106017402=  WHERE G_CLIENT = :G_CLIENT_'
      '1106017403=  ORDER BY G_DISCONT_CARD'
      '1106017404=  INTO'
      '1106017405=    :G_DISCONT_CARD,'
      '1106017406=    :BARCODE,'
      '1106017407=    :N_PERCENT,'
      '1106017408=    :SUMM,'
      '1106017409=    :SUMM_ALL'
      '1106017410=  DO SUSPEND;'
      '1106017411=END'
