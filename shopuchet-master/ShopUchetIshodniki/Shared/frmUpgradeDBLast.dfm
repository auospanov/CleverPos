        '1101571226=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AI FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1101571227=        '#39'ACTIVE AFTER INSERT POSITION 32000 '#39'||CRLF||'
      '1101571228=        '#39'AS '#39'||CRLF||'
      '1101571229=        '#39'BEGIN '#39'||CRLF||'
      
        '1101571230=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1101571231=        '#39'  IF (NEW.'#39'||FN||'#39' IS NOT NULL) THEN'#39'||CRLF|' +
        '|'
      
        '1101571232=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1101571233=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1101571234=        '#39'END;'#39';'
      '1101571235=    EXECUTE STATEMENT :TRGI;'
      '1101571236='
      
        '1101571237=    TRGI='#39'RECREATE TRIGGER '#39'||TN||FN||'#39'_AU FOR '#39'||TN|' +
        '|'#39' '#39'||CRLF||'
      '1101571238=        '#39'ACTIVE AFTER UPDATE POSITION 32000 '#39'||CRLF||'
      '1101571239=        '#39'AS '#39'||CRLF||'
      '1101571240=        '#39'BEGIN '#39'||CRLF||'
      
        '1101571241=        '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39'||CRLF||'
      
        '1101571242=        '#39'  IF (NEW.'#39'||FN||'#39'<>OLD.'#39'||FN||'#39') THEN'#39'||CRL' +
        'F||'
      
        '1101571243=        '#39'       INSERT INTO LOGS(ID, USR, SQLSTMT, RR' +
        ', DAT)'#39'||CRLF||'
      
        '1101571244=        '#39'       VALUES (GEN_ID(GEN_LOGS,1), '#39#39'SYSDBA'#39 +
        #39', '#39#39#39'||TN||'#39'.'#39'||FN||'#39'.'#39'||ID_COLUMN||'#39#39#39', NEW.'#39'||ID_COLUMN||'#39', N' +
        'EW.'#39'||FN||'#39');'#39'||CRLF||'
      '1101571245=        '#39'END;'#39';'
      '1101571246=    EXECUTE STATEMENT :TRGI;'
      '1101571247='
      '1101571248=    TN_ALT = TN;'
      '1101571249=  END'
      '1101571250=  FOR SELECT DISTINCT R.RDB$RELATION_NAME'
      '1101571251=        FROM RDB$RELATIONS R'
      '1101571252=       WHERE R.RDB$SYSTEM_FLAG=0'
      '1101571253=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      '1101571254=       ORDER BY R.RDB$RELATION_NAME'
      '1101571255=        INTO :TN'
      '1101571256=  DO BEGIN'
      '1101571257=    TN=TRIM(TN);'
      '1101571258=    SQLSTMT='#39'GRANT ALL ON '#39'||tn||'#39' TO PUBLIC'#39';'
      '1101571259='
      '1101571260=    EXECUTE STATEMENT :SQLSTMT;'
      '1101571261=  END'
      '1101571262=END'
      '1101571263=;'
      '1101571264='
      '1101571265=ALTER PROCEDURE P_REP_AKT_SVERKI('
      '1101571266=  DATE_BEGIN_ DATE,'
      '1101571267=  DATE_END_ DATE,'
      '1101571268=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '1101571269=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101571270=  CLIENT_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101571271=  CLIENT_DIR_NAME_IN_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101571272=  FIRM_NAME_IN_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '1101571273=  G_OFFICIAL_NAME_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101571274=  CURRENCY_ INTEGER)'
      '1101571275=RETURNS ('
      '1101571276=  STR1_ VARCHAR(500),'
      '1101571277=  STR2_ VARCHAR(700),'
      '1101571278=  STR3_ VARCHAR(500),'
      '1101571279=  STR3_DOWN_ VARCHAR(500),'
      '1101571280=  STR4_ VARCHAR(500),'
      '1101571281=  STR5_ VARCHAR(500),'
      '1101571282=  STR_SALDO_IN_ VARCHAR(50),'
      '1101571283=  STR_SALDO_OUT_ VARCHAR(50),'
      '1101571284=  STR_OT1_ VARCHAR(500),'
      '1101571285=  STR_OT2_ VARCHAR(500),'
      '1101571286=  DEBET_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101571287=  DEBET_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101571288=  CREDIT_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101571289=  CREDIT_OUT_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101571290=  DEBET_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101571291=  CREDIT_CONTR_IN_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1101571292=  FIRM_NAME_OUT_ TYPE OF COLUMN G_FIRM_REKVIZIT.NAME,'
      '1101571293=  CLIENT_NAME_OUT_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101571294=  STR_TEXT VARCHAR(100),'
      '1101571295=  OPER_DATE TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '1101571296=  SUMM_DEBET TYPE OF COLUMN SKLAD.SUMM,'
      '1101571297=  SUMM_CREDIT TYPE OF COLUMN SKLAD.SUMM,'
      '1101571298=  SUMM_DEBET_CONTR TYPE OF COLUMN SKLAD.SUMM,'
      '1101571299=  SUMM_CREDIT_CONTR TYPE OF COLUMN SKLAD.SUMM)'
      '1101571300=AS'
      
        '1101571301=DECLARE VARIABLE IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT' +
        '.IS_SUPPLIER;'
      '1101571302=DECLARE VARIABLE ID TYPE OF COLUMN CUR_PARAMS.ID;'
      '1101571303=DECLARE VARIABLE ROW INTEGER;'
      '1101571304=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1101571305=DECLARE VARIABLE SUMM_IN_DEBET_ TYPE OF COLUMN SKLAD_' +
        'PARENT.SUMM;'
      
        '1101571306=DECLARE VARIABLE SUMM_IN_CREDIT_ TYPE OF COLUMN SKLAD' +
        '_PARENT.SUMM;'
      
        '1101571307=DECLARE VARIABLE SUMM_IN_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '1101571308=DECLARE VARIABLE SUMM_OUT_DEBET_ TYPE OF COLUMN SKLAD' +
        '_PARENT.SUMM;'
      
        '1101571309=DECLARE VARIABLE SUMM_OUT_CREDIT_ TYPE OF COLUMN SKLA' +
        'D_PARENT.SUMM;'
      
        '1101571310=DECLARE VARIABLE SUMM_OUT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.SUMM;'
      
        '1101571311=DECLARE VARIABLE SUMM_OUT_1 TYPE OF COLUMN SKLAD_PARE' +
        'NT.SUMM;'
      
        '1101571312=DECLARE VARIABLE SUMM_OUT_2 TYPE OF COLUMN SKLAD_PARE' +
        'NT.SUMM;'
      '1101571313=DECLARE VARIABLE CURR_STR_ VARCHAR(5);'
      '1101571314=DECLARE VARIABLE SORT_ROW DATE;'
      '1101571315=BEGIN'
      '1101571316=  CLRF = ascii_char( 10 );'
      '1101571317='
      '1101571318=  if (CURRENCY_ = 0) then'
      '1101571319=    CURR_STR_ = '#39' KZT'#39';'
      '1101571320=  else if (CURRENCY_ = 1) then'
      '1101571321=    CURR_STR_ = '#39' '#1088#1091#1073'.'#39';'
      '1101571322=  else if (CURRENCY_ = 2) then'
      '1101571323=    CURR_STR_ = '#39' '#1075#1088#1085'.'#39';'
      '1101571324=  else if (CURRENCY_ = 3) then'
      '1101571325=    CURR_STR_ = '#39' '#1089#1091#1084#39';'
      '1101571326=  else if (CURRENCY_ = 4) then'
      '1101571327=    CURR_STR_ = '#39' '#1089#1086#1084#39';'
      '1101571328=  else if (CURRENCY_ = 5) then'
      '1101571329=    CURR_STR_ = '#39' '#1076#1088#1072#1084#39';'
      '1101571330='
      '1101571331=  if (G_OFFICIAL_NAME_ IS NULL) then BEGIN'
      '1101571332=      SELECT J.FIO_DOC'
      '1101571333=        FROM G_OFFICIAL J'
      '1101571334=       WHERE J.IS_RUKOVODITEL = 1'
      '1101571335=        INTO G_OFFICIAL_NAME_;'
      '1101571336='
      '1101571337=      if (G_OFFICIAL_NAME_ IS NULL) then'
      '1101571338=        SELECT J.FIO_DOC'
      '1101571339=          FROM G_OFFICIAL J'
      
        '1101571340=         WHERE J.G_OFFICIAL = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 1)'
      '1101571341=         INTO G_OFFICIAL_NAME_;'
      '1101571342=  END'
      '1101571343='
      '1101571344=  CLIENT_NAME_OUT_  = CLIENT_NAME_IN_;'
      '1101571345=  FIRM_NAME_OUT_    = FIRM_NAME_IN_;'
      '1101571346='
      
        '1101571347=  if (TRIM(G_OFFICIAL_NAME_) IS NULL or TRIM(G_OFFICI' +
        'AL_NAME_) = '#39#39') then'
      '1101571348=    G_OFFICIAL_NAME_ = '#39'________________'#39';'
      '1101571349='
      
        '1101571350=  if (TRIM(CLIENT_DIR_NAME_IN_) IS NULL or TRIM(CLIEN' +
        'T_DIR_NAME_IN_) = '#39#39') then'
      '1101571351=    CLIENT_DIR_NAME_IN_ = '#39'________________'#39';'
      '1101571352='
      
        '1101571353=  STR1_ = '#39#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1079#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTR' +
        'ACT(DAY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM' +
        ' DATE_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'
      
        '1101571354=          '#39' '#1087#1086' '#39'||lpad(EXTRACT(DAY FROM DATE_END_), 2' +
        ', '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||E' +
        'XTRACT(YEAR FROM DATE_END_)||clrf||'
      '1101571355=          '#39' '#1084#1077#1078#1076#1091' '#39'||FIRM_NAME_OUT_||clrf||'
      '1101571356=          '#39' '#1080' '#39'||CLIENT_NAME_OUT_;'
      '1101571357='
      
        '1101571358=  STR2_ = '#39#1052#1099', '#1085#1080#1078#1077#1087#1086#1076#1087#1080#1089#1072#1074#1096#1080#1077#1089#1103', ________________ '#39'|' +
        '|FIRM_NAME_OUT_||'#39' '#39'||G_OFFICIAL_NAME_||'#39', '#1089' '#1086#1076#1085#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '1101571359=          '#39#1080' ________________ '#39'||CLIENT_NAME_OUT_||'#39' ' +
        #39'||CLIENT_DIR_NAME_IN_||'#39', '#1089' '#1076#1088#1091#1075#1086#1081' '#1089#1090#1086#1088#1086#1085#1099', '#39'||'
      
        '1101571360=          '#39#1089#1086#1089#1090#1072#1074#1080#1083#1080' '#1085#1072#1089#1090#1086#1103#1097#1080#1081' '#1072#1082#1090' '#1089#1074#1077#1088#1082#1080' '#1074' '#1090#1086#1084', '#1095#1090#1086' ' +
        #1089#1086#1089#1090#1086#1103#1085#1080#1077' '#1074#1079#1072#1080#1084#1085#1099#1093' '#1088#1072#1089#1095#1077#1090#1086#1074' '#1087#1086' '#1076#1072#1085#1085#1099#1084' '#1091#1095#1077#1090#1072' '#1089#1083#1077#1076#1091#1102#1097#1077#1077':'#39';'
      '1101571361='
      
        '1101571362=  STR3_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_||'#39','#39'||CURR_STR' +
        '_;'
      '1101571363=  STR3_DOWN_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||FIRM_NAME_OUT_;'
      
        '1101571364=  STR4_ = '#39#1055#1086' '#1076#1072#1085#1085#1099#1084' '#39'||CLIENT_NAME_OUT_||'#39','#39'||CURR_S' +
        'TR_;'
      '1101571365='
      
        '1101571366=  STR_SALDO_IN_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1085#1072#1095#1072#1083#1086' '#39'||lpad(EXTRACT(D' +
        'AY FROM DATE_BEGIN_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '1101571367=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(' +
        'EXTRACT(MONTH FROM :DATE_BEGIN_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DA' +
        'TE_BEGIN_)||'#39' '#1075'.'#39';'
      '1101571368='
      
        '1101571369=  STR_SALDO_OUT_ = '#39#1057#1072#1083#1100#1076#1086' '#1085#1072' '#1082#1086#1085#1077#1094' '#39'||lpad(EXTRACT(D' +
        'AY FROM DATE_END_), 2, '#39'0'#39')||'#39' '#39'||'
      
        '1101571370=           (SELECT MONTH_WORD FROM GET_RUSSIAN_MONTH(' +
        'EXTRACT(MONTH FROM :DATE_END_), 1))||'#39' '#39'||EXTRACT(YEAR FROM DATE' +
        '_END_)||'#39' '#1075'.'#39';'
      '1101571371='
      '1101571372=  STR_OT1_ = '#39#1054#1090' '#39'||FIRM_NAME_OUT_;'
      '1101571373=  STR_OT2_ = '#39#1054#1090' '#39'||CLIENT_NAME_OUT_;'
      '1101571374='
      '1101571375=  SELECT IS_SUPPLIER'
      '1101571376=    FROM G_CLIENT G'
      '1101571377=   WHERE G.G_CLIENT = :G_CLIENT_'
      '1101571378=    INTO :IS_SUPPLIER_;'
      '1101571379='
      '1101571380=  DEBET_IN_   = 0;'
      '1101571381=  DEBET_OUT_  = 0;'
      '1101571382=  CREDIT_IN_  = 0;'
      '1101571383=  CREDIT_OUT_ = 0;'
      '1101571384='
      
        '1101571385=  STR5_ = '#39#1085#1072' '#39'||LPAD(EXTRACT(DAY FROM CURRENT_DATE),' +
        ' 2, '#39'0'#39')||'#39'.'#39'||LPAD(EXTRACT(MONTH FROM CURRENT_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1101571386='
      
        '1101571387=  --*************************************************' +
        '******************'
      '1101571388=  -- '#1055#1054#1057#1058#1040#1042#1065#1048#1050
      
        '1101571389=  --*************************************************' +
        '******************'
      '1101571390=  IF (IS_SUPPLIER_ = 1) THEN BEGIN'
      '1101571391=    ----------------------'
      '1101571392=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1101571393=    SELECT SUM(S.SUMM)'
      '1101571394=      FROM SKLAD_PARENT S'
      '1101571395=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571396=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1101571397=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571398=    GROUP BY S.G_CLIENT'
      '1101571399=      INTO :SUMM_IN_DEBET_;'
      '1101571400='
      '1101571401=    SELECT SUM(K.SUMM)'
      '1101571402=      FROM SKLAD_PARENT S,'
      
        '1101571403=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571404=             from KASSA'
      
        '1101571405=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571406=              AND ZAKAZ IS NULL'
      '1101571407=           union all'
      
        '1101571408=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571409=             from kassa_beznal'
      
        '1101571410=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571411=              AND ZAKAZ IS NULL) K'
      '1101571412=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571413=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571414=       AND K.SKLAD = S.SKLAD'
      '1101571415=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1101571416=       AND K.G_PRIHOD_RASHOD = 2'
      '1101571417=    GROUP BY S.G_CLIENT'
      '1101571418=      INTO :SUMM_IN_CREDIT_;'
      '1101571419='
      
        '1101571420=    SELECT :SUMM_IN_DEBET_ + SUM(S.SUMM)             ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101571421=      FROM ZAKAZ S'
      '1101571422=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571423=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '1101571424=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571425=    GROUP BY S.G_CLIENT'
      '1101571426=      INTO :SUMM_IN_DEBET_;'
      '1101571427='
      
        '1101571428=    SELECT :SUMM_IN_CREDIT_ + SUM(K.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101571429=      FROM ZAKAZ S,'
      '1101571430=          (select ZAKAZ, SUMM, ACTION_DATE'
      '1101571431=             from KASSA'
      
        '1101571432=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571433=              AND SKLAD IS NULL'
      '1101571434=           union all'
      '1101571435=           select ZAKAZ, SUMM, ACTION_DATE'
      '1101571436=             from kassa_beznal'
      
        '1101571437=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571438=              AND SKLAD IS NULL) K'
      '1101571439=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571440=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571441=       AND K.zakaz = S.ZAKAZ'
      '1101571442=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1101571443=    GROUP BY S.G_CLIENT'
      '1101571444=      INTO :SUMM_IN_CREDIT_;'
      '1101571445='
      '1101571446=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '1101571447='
      '1101571448=    ----------------------'
      '1101571449=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1101571450=    SELECT SUM(S.SUMM)'
      '1101571451=      FROM SKLAD_PARENT S'
      '1101571452=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571453=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '1101571454=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571455=    GROUP BY S.G_CLIENT'
      '1101571456=      INTO :SUMM_OUT_DEBET_;'
      '1101571457='
      '1101571458=    SELECT SUM(K.SUMM)'
      '1101571459=      FROM SKLAD_PARENT S,'
      
        '1101571460=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571461=             from KASSA'
      
        '1101571462=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571463=              AND ZAKAZ IS NULL'
      '1101571464=           union all'
      
        '1101571465=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571466=             from kassa_beznal'
      
        '1101571467=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571468=              AND ZAKAZ IS NULL) K'
      '1101571469=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571470=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571471=       AND K.SKLAD = S.SKLAD'
      '1101571472=       AND K.ACTION_DATE <= :DATE_END_'
      '1101571473=       AND K.G_PRIHOD_RASHOD = 2'
      '1101571474=    GROUP BY S.G_CLIENT'
      '1101571475=      INTO :SUMM_OUT_CREDIT_;'
      '1101571476='
      
        '1101571477=    SELECT :SUMM_OUT_CREDIT_ +SUM(S.SUMM)            ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101571478=      FROM ZAKAZ S'
      '1101571479=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571480=       AND S.Z_DATE <= :DATE_END_'
      
        '1101571481=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571482=    GROUP BY S.G_CLIENT'
      '1101571483=      INTO :SUMM_OUT_CREDIT_;'
      '1101571484='
      
        '1101571485=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1101571486=      FROM ZAKAZ S,'
      '1101571487=          (select ZAKAZ, SUMM, ACTION_DATE'
      '1101571488=             from KASSA'
      
        '1101571489=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571490=              AND SKLAD IS NULL'
      '1101571491=           union all'
      '1101571492=           select ZAKAZ, SUMM, ACTION_DATE'
      '1101571493=             from kassa_beznal'
      
        '1101571494=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571495=              AND SKLAD IS NULL) K'
      '1101571496=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571497=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571498=       AND K.zakaz = S.ZAKAZ'
      '1101571499=       AND K.ACTION_DATE <= :DATE_END_'
      '1101571500=    GROUP BY S.G_CLIENT'
      '1101571501=      INTO :SUMM_OUT_DEBET_;'
      '1101571502='
      '1101571503=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '1101571504=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1101571505=    -------------------------'
      '1101571506='
      '1101571507=    if (COALESCE(SUMM_IN_, 0) < 0) then'
      '1101571508=      DEBET_IN_ = SUMM_IN_;'
      '1101571509=    ELSE'
      '1101571510=      CREDIT_IN_ = SUMM_IN_;'
      '1101571511='
      '1101571512=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '1101571513=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '1101571514='
      '1101571515=    if (COALESCE(SUMM_OUT_, 0) < 0) then'
      '1101571516=      DEBET_OUT_ = ABS(SUMM_OUT_);'
      '1101571517=    ELSE'
      '1101571518=      CREDIT_OUT_ = SUMM_OUT_;'
      '1101571519='
      '1101571520=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '1101571521=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '1101571522='
      '1101571523=        if (DEBET_OUT_ > 0) then'
      
        '1101571524=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE' +
        '(CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1101571525=        else'
      
        '1101571526=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLA' +
        'CE(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1101571527=    end else'
      '1101571528=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '1101571529='
      '1101571530=    FOR SELECT 1 ROW,'
      
        '1101571531=               '#39#1055#1086#1089#1090#1091#1087#1083#1077#1085#1080#1077' '#1058#1052#1047' '#39'||S.SKLAD||'#39' '#1086#1090' '#39'||S' +
        '.DATE_RECEIPT str,'
      '1101571532=               S.SKLAD ID,'
      '1101571533=               S.DATE_RECEIPT OPER_DATE,'
      '1101571534=               NULL SUMM_DEBET,'
      '1101571535=               S.SUMM SUMM_CREDIT,'
      '1101571536=               S.DATE_RECEIPT SORT_ROW'
      '1101571537=          FROM SKLAD_PARENT S'
      '1101571538=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571539=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1101571540=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOC' +
        'HKA||'#39'-'#39
      '1101571541=        UNION ALL'
      '1101571542=        SELECT 2 ROW,'
      
        '1101571543=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39' '#1086#1090' '#39'||S' +
        'PP.DATE_RECEIPT STR,'
      '1101571544=               K.SKLAD ID,'
      '1101571545=               K.ACTION_DATE OPER_DATE,'
      '1101571546=               K.SUMM SUMM_DEBET,'
      '1101571547=               NULL SUMM_CREDIT,'
      '1101571548=               K.ACTION_DATE SORT_ROW'
      
        '1101571549=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1101571550=                  from KASSA'
      
        '1101571551=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '1101571552=                union all'
      
        '1101571553=                select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1101571554=                  from kassa_beznal'
      
        '1101571555=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '1101571556=               SKLAD_PARENT SPP'
      '1101571557=         WHERE K.ZAKAZ IS NULL'
      '1101571558=           AND K.SKLAD = SPP.SKLAD'
      
        '1101571559=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1101571560=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '1101571561=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_T' +
        'OCHKA||'#39'-'#39
      '1101571562=           AND K.G_PRIHOD_RASHOD = 2'
      '1101571563=        UNION ALL'
      '1101571564=        SELECT 3 ROW,'
      
        '1101571565=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#39'||Z.ZAKAZ||'#39' ' +
        #1086#1090' '#39'||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRAC' +
        'T(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE' +
        ') str,'
      '1101571566=               Z.ZAKAZ ID,'
      '1101571567=               Z.Z_DATE OPER_DATE,'
      '1101571568=               Z.SUMM SUMM_DEBET,'
      '1101571569=               NULL SUMM_CREDIT,'
      '1101571570=               Z.Z_DATE SORT_ROW'
      '1101571571=          FROM ZAKAZ Z'
      '1101571572=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '1101571573=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101571574=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1101571575=        UNION ALL'
      '1101571576=        SELECT 4 ROW,'
      
        '1101571577=               '#39#1054#1087#1083#1072#1090#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090' ' +
        #39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(' +
        'MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DATE' +
        ') STR,'
      '1101571578=               K.ZAKAZ ID,'
      '1101571579=               K.ACTION_DATE OPER_DATE,'
      '1101571580=               NULL SUMM_DEBET,'
      '1101571581=               K.SUMM SUMM_CREDIT,'
      '1101571582=               K.ACTION_DATE SORT_ROW'
      
        '1101571583=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA'
      '1101571584=                  from KASSA'
      
        '1101571585=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39
      '1101571586=                union all'
      
        '1101571587=                select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA_BEZNAL KASSA'
      '1101571588=                  from kassa_beznal'
      
        '1101571589=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39') K,'
      '1101571590=               zakaz zz'
      '1101571591=         WHERE K.sklad IS NULL'
      '1101571592=           AND K.zakaz = zz.ZAKAZ'
      
        '1101571593=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1101571594=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '1101571595=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TO' +
        'CHKA||'#39'-'#39
      '1101571596=        UNION ALL'
      '1101571597=        SELECT 5 ROW,'
      '1101571598=               NULL STR,'
      '1101571599=               NULL ID,'
      '1101571600=               NULL OPER_DATE,'
      '1101571601=               NULL SUMM_DEBET,'
      '1101571602=               NULL SUMM_CREDIT,'
      
        '1101571603=               '#39'31.12.2199'#39' SORT_ROW    -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090 +
        #1072#1103' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '1101571604=          FROM RDB$DATABASE'
      '1101571605=        ORDER BY 7, 3, 1'
      '1101571606=        INTO :ROW,'
      '1101571607=             :STR_TEXT,'
      '1101571608=             :ID,'
      '1101571609=             :OPER_DATE,'
      '1101571610=             :SUMM_DEBET,'
      '1101571611=             :SUMM_CREDIT,'
      '1101571612=             :SORT_ROW'
      '1101571613=    DO BEGIN'
      '1101571614=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '1101571615=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '1101571616=      SUSPEND;'
      '1101571617=    END'
      '1101571618=  END'
      '1101571619='
      
        '1101571620=  --*************************************************' +
        '**************'
      '1101571621=  -- '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068
      
        '1101571622=  --*************************************************' +
        '**************'
      '1101571623=  ELSE BEGIN'
      '1101571624=    ----------------------'
      '1101571625=    -- '#1042#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1101571626=    SELECT SUM(S.SUMM)'
      '1101571627=      FROM ZAKAZ S'
      '1101571628=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571629=       AND S.Z_DATE < :DATE_BEGIN_'
      
        '1101571630=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571631=       AND S.is_spisanie <> 1'
      '1101571632=    GROUP BY S.G_CLIENT'
      '1101571633=      INTO :SUMM_IN_DEBET_;'
      '1101571634='
      '1101571635=    SELECT SUM(K.SUMM)'
      '1101571636=      FROM ZAKAZ S,'
      
        '1101571637=          (select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571638=             from KASSA'
      
        '1101571639=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571640=              AND SKLAD IS NULL'
      '1101571641=           union all'
      
        '1101571642=           select ZAKAZ, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571643=             from kassa_beznal'
      
        '1101571644=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571645=              AND SKLAD IS NULL'
      '1101571646=           union all'
      
        '1101571647=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_dat' +
        'e ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '1101571648=             from zakaz Z'
      
        '1101571649=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571650=              AND Z.summ_bonus > 0) K'
      '1101571651=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571652=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571653=       AND K.zakaz = S.ZAKAZ'
      '1101571654=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1101571655=       AND S.is_spisanie <> 1'
      '1101571656=       AND K.G_PRIHOD_RASHOD = 1'
      '1101571657=    GROUP BY S.G_CLIENT'
      '1101571658=      INTO :SUMM_IN_CREDIT_;'
      '1101571659='
      
        '1101571660=    SELECT :SUMM_IN_DEBET_ + SUM(K.SUMM)             ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1101571661=      FROM SKLAD_PARENT S,'
      
        '1101571662=          (select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571663=             from KASSA'
      
        '1101571664=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571665=              AND ZAKAZ IS NULL'
      '1101571666=           union all'
      
        '1101571667=           select SKLAD, SUMM, ACTION_DATE, G_PRIHOD_' +
        'RASHOD'
      '1101571668=             from kassa_beznal'
      
        '1101571669=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571670=              AND ZAKAZ IS NULL) K'
      '1101571671=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571672=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571673=       AND K.SKLAD = S.SKLAD'
      '1101571674=       AND K.ACTION_DATE < :DATE_BEGIN_'
      '1101571675=       AND K.G_PRIHOD_RASHOD = 3'
      '1101571676=    GROUP BY S.G_CLIENT'
      '1101571677=      INTO :SUMM_IN_DEBET_;'
      '1101571678='
      
        '1101571679=    SELECT :SUMM_IN_CREDIT_ + SUM(S.SUMM)            ' +
        ' -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1101571680=      FROM SKLAD_PARENT S'
      '1101571681=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571682=       AND S.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1101571683=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571684=    GROUP BY S.G_CLIENT'
      '1101571685=      INTO :SUMM_IN_CREDIT_;'
      '1101571686='
      '1101571687=    SUMM_IN_ = SUMM_IN_DEBET_ - SUMM_IN_CREDIT_;'
      '1101571688='
      '1101571689=    ----------------------'
      '1101571690=    -- '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1101571691=    SELECT SUM(S.SUMM)'
      '1101571692=      FROM ZAKAZ S'
      '1101571693=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571694=       AND S.Z_DATE <= :DATE_END_'
      
        '1101571695=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571696=       AND S.is_spisanie <> 1'
      '1101571697=    GROUP BY S.G_CLIENT'
      '1101571698=      INTO :SUMM_OUT_DEBET_;'
      '1101571699='
      '1101571700=    SELECT SUM(K.SUMM)'
      '1101571701=      FROM ZAKAZ S,'
      
        '1101571702=          (select ZAKAZ, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1101571703=             from KASSA'
      
        '1101571704=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571705=              AND SKLAD IS NULL'
      '1101571706=           union all'
      
        '1101571707=           select ZAKAZ, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1101571708=             from kassa_beznal'
      
        '1101571709=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571710=              AND SKLAD IS NULL'
      '1101571711=           union all'
      
        '1101571712=           select Z.ZAKAZ, Z.summ_bonus SUMM, Z.z_dat' +
        'e ACTION_DATE, 1 G_PRIHOD_RASHOD'
      '1101571713=             from zakaz Z'
      
        '1101571714=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571715=              AND Z.summ_bonus > 0) K'
      '1101571716=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571717=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571718=       AND K.zakaz = S.ZAKAZ'
      '1101571719=       AND K.ACTION_DATE <= :DATE_END_'
      '1101571720=       AND K.G_PRIHOD_RASHOD = 1'
      '1101571721=    GROUP BY S.G_CLIENT'
      '1101571722=      INTO :SUMM_OUT_CREDIT_;'
      '1101571723='
      
        '1101571724=    SELECT :SUMM_OUT_DEBET_ + SUM(K.SUMM)            ' +
        '   -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1101571725=      FROM SKLAD_PARENT S,'
      
        '1101571726=          (select SKLAD, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1101571727=             from KASSA'
      
        '1101571728=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571729=              AND ZAKAZ IS NULL'
      '1101571730=           union all'
      
        '1101571731=           select SKLAD, SUMM, ACTION_DATE, g_prihod_' +
        'rashod'
      '1101571732=             from kassa_beznal'
      
        '1101571733=            WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||G_TO' +
        'CHKA||'#39'-'#39
      '1101571734=              AND ZAKAZ IS NULL) K'
      '1101571735=     WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571736=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571737=       AND K.SKLAD = S.SKLAD'
      '1101571738=       AND K.ACTION_DATE <= :DATE_END_'
      '1101571739=       AND K.G_PRIHOD_RASHOD = 3'
      '1101571740=    GROUP BY S.G_CLIENT'
      '1101571741=      INTO :SUMM_OUT_DEBET_;'
      '1101571742='
      
        '1101571743=    SELECT :SUMM_OUT_CREDIT_ + SUM(S.SUMM)           ' +
        '  -- '#1042#1054#1047#1042#1056#1040#1058#1067' '#1050#1051#1048#1045#1053#1058#1040
      '1101571744=      FROM SKLAD_PARENT S'
      '1101571745=     WHERE S.G_CLIENT = :G_CLIENT_'
      '1101571746=       AND S.DATE_RECEIPT <= :DATE_END_'
      
        '1101571747=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA|' +
        '|'#39'-'#39
      '1101571748=    GROUP BY S.G_CLIENT'
      '1101571749=      INTO :SUMM_OUT_CREDIT_;'
      '1101571750='
      '1101571751=    SUMM_OUT_ = SUMM_OUT_DEBET_ - SUMM_OUT_CREDIT_;'
      '1101571752=    -- '#1050#1054#1053#1045#1062' '#1048#1057#1061#1054#1044#1071#1065#1040#1071' '#1057#1059#1052#1052#1040
      '1101571753=    -------------------------'
      '1101571754='
      '1101571755=    IF (COALESCE(SUMM_IN_, 0) > 0) then'
      '1101571756=      DEBET_IN_ = SUMM_IN_;'
      '1101571757=    ELSE'
      '1101571758=      CREDIT_IN_ = SUMM_IN_;'
      '1101571759='
      '1101571760=    DEBET_CONTR_IN_ = CREDIT_IN_;'
      '1101571761=    CREDIT_CONTR_IN_ = DEBET_IN_;'
      '1101571762='
      '1101571763=    if (COALESCE(SUMM_OUT_, 0) > 0) then'
      '1101571764=      DEBET_OUT_ = SUMM_OUT_;'
      '1101571765=    ELSE'
      '1101571766=      CREDIT_OUT_ = ABS(SUMM_OUT_);'
      '1101571767='
      '1101571768=    --------------------'
      '1101571769=    -- '#1047#1040#1044#1054#1051#1046#1045#1053#1053#1054#1057#1058#1068
      '1101571770=    if ((DEBET_OUT_ + CREDIT_OUT_) > 0) then begin'
      '1101571771=        STR5_ = STR5_ || '#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1100' '#1074' '#1087#1086#1083#1100#1079#1091' '#39';'
      '1101571772='
      '1101571773=        if (DEBET_OUT_ > 0) then'
      
        '1101571774=          STR5_ = STR5_||FIRM_NAME_OUT_||'#39' '#39'||REPLACE' +
        '(CAST(DEBET_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1101571775=        else'
      
        '1101571776=          STR5_ = STR5_||CLIENT_NAME_OUT_||'#39' '#39'||REPLA' +
        'CE(CAST(CREDIT_OUT_ AS VARCHAR(10)), '#39'.'#39', '#39','#39')||CURR_STR_;'
      '1101571777=    end else'
      '1101571778=        STR5_ = STR5_||'#39' '#1079#1072#1076#1086#1083#1078#1077#1085#1085#1086#1089#1090#1080' '#1085#1077#1090#39';'
      '1101571779='
      '1101571780=    FOR SELECT 1 ROW,'
      
        '1101571781=               '#39#1055#1088#1086#1076#1072#1078#1072', '#1085#1072#1082#1083#1072#1076#1085#1072#1103' '#39'||Z.ZAKAZ||'#39' '#1086#1090' '#39 +
        '||lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MO' +
        'NTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM Z.Z_DATE) st' +
        'r,'
      '1101571782=               Z.ZAKAZ ID,'
      '1101571783=               Z.Z_DATE OPER_DATE,'
      '1101571784=               Z.SUMM SUMM_DEBET,'
      '1101571785=               NULL SUMM_CREDIT,'
      '1101571786=               Z.Z_DATE SORT_ROW'
      '1101571787=          FROM ZAKAZ Z'
      '1101571788=         WHERE Z.G_CLIENT = :G_CLIENT_'
      
        '1101571789=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101571790=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1101571791=        UNION ALL'
      '1101571792=        SELECT 2 ROW,'
      
        '1101571793=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1085#1072#1082#1083#1072#1076#1085#1091#1102' '#39'||ZZ.ZAKAZ||'#39' '#1086#1090 +
        ' '#39'||lpad(EXTRACT(DAY FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT' +
        '(MONTH FROM ZZ.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FROM ZZ.Z_DAT' +
        'E) STR,'
      '1101571794=               K.ZAKAZ ID,'
      '1101571795=               K.ACTION_DATE OPER_DATE,'
      '1101571796=               NULL SUMM_DEBET,'
      '1101571797=               K.SUMM SUMM_CREDIT,'
      '1101571798=               K.ACTION_DATE SORT_ROW'
      
        '1101571799=          FROM (select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA, G_PRIHOD_RASHOD'
      '1101571800=                  from KASSA'
      
        '1101571801=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39
      '1101571802=                union all'
      
        '1101571803=                select ZAKAZ, SUMM, ACTION_DATE, SKLA' +
        'D, KASSA_BEZNAL KASSA, G_PRIHOD_RASHOD'
      '1101571804=                  from kassa_beznal'
      
        '1101571805=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39
      '1101571806=                union all'
      
        '1101571807=                select Z.ZAKAZ, Z.summ_bonus SUMM, Z.' +
        'z_date ACTION_DATE, NULL SKLAD, NULL KASSA, 1 G_PRIHOD_RASHOD'
      '1101571808=                  from zakaz Z'
      
        '1101571809=                  WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||G_TOCHKA||'#39'-'#39
      '1101571810=                   AND Z.summ_bonus > 0) K,'
      '1101571811=               zakaz zz'
      '1101571812=         WHERE K.sklad IS NULL'
      '1101571813=           AND K.zakaz = zz.ZAKAZ'
      
        '1101571814=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1101571815=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '1101571816=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TO' +
        'CHKA||'#39'-'#39
      '1101571817=           AND K.G_PRIHOD_RASHOD = 1'
      '1101571818=        UNION ALL'
      '1101571819=        SELECT 3 ROW,'
      
        '1101571820=               '#39#1042#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#1082#1083#1080#1077#1085#1090#1086#1084' '#39'||S.SKLAD||'#39' '#1086#1090 +
        ' '#39'||lpad(EXTRACT(DAY FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lpad(EX' +
        'TRACT(MONTH FROM S.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR FRO' +
        'M S.DATE_RECEIPT) str,'
      '1101571821=               S.SKLAD ID,'
      '1101571822=               S.DATE_RECEIPT OPER_DATE,'
      '1101571823=               NULL SUMM_DEBET,'
      '1101571824=               S.SUMM SUMM_CREDIT,'
      '1101571825=               S.DATE_RECEIPT SORT_ROW'
      '1101571826=          FROM SKLAD_PARENT S'
      '1101571827=         WHERE S.G_CLIENT = :G_CLIENT_'
      
        '1101571828=           AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1101571829=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOC' +
        'HKA||'#39'-'#39
      '1101571830=        UNION ALL'
      '1101571831=        SELECT 4 ROW,'
      
        '1101571832=               '#39#1054#1087#1083#1072#1090#1072' '#1079#1072' '#1074#1086#1079#1074#1088#1072#1090' '#1058#1052#1047' '#39'||SPP.SKLAD||'#39 +
        ' '#1086#1090' '#39'||lpad(EXTRACT(DAY FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||lp' +
        'ad(EXTRACT(MONTH FROM SPP.DATE_RECEIPT), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(Y' +
        'EAR FROM SPP.DATE_RECEIPT) STR,'
      '1101571833=               K.SKLAD ID,'
      '1101571834=               K.ACTION_DATE OPER_DATE,'
      '1101571835=               K.SUMM SUMM_DEBET,'
      '1101571836=               NULL SUMM_CREDIT,'
      '1101571837=               K.ACTION_DATE SORT_ROW'
      
        '1101571838=          FROM (select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1101571839=                  from KASSA'
      
        '1101571840=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39
      '1101571841=                union all'
      
        '1101571842=                select SKLAD, SUMM, ACTION_DATE, ZAKA' +
        'Z, G_PRIHOD_RASHOD'
      '1101571843=                  from kassa_beznal'
      
        '1101571844=                 WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'|' +
        '|G_TOCHKA||'#39'-'#39') K,'
      '1101571845=               SKLAD_PARENT SPP'
      '1101571846=         WHERE K.ZAKAZ IS NULL'
      '1101571847=           AND K.SKLAD = SPP.SKLAD'
      
        '1101571848=           AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '1101571849=           AND SPP.G_CLIENT = :G_CLIENT_'
      
        '1101571850=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SPP.G_T' +
        'OCHKA||'#39'-'#39
      '1101571851=           AND K.G_PRIHOD_RASHOD = 3'
      '1101571852=        UNION ALL'
      '1101571853=        SELECT 5 ROW,'
      '1101571854=               NULL STR,'
      '1101571855=               NULL ID,'
      '1101571856=               NULL OPER_DATE,'
      '1101571857=               NULL SUMM_DEBET,'
      '1101571858=               NULL SUMM_CREDIT,'
      
        '1101571859=               '#39'31.12.2199'#39' SORT_ROW  -- '#1095#1090#1086#1073#1099' '#1087#1091#1089#1090#1072#1103 +
        ' '#1089#1090#1088#1086#1082#1072' '#1073#1099#1083#1072' '#1074' '#1082#1086#1085#1094#1077
      '1101571860=          FROM RDB$DATABASE'
      '1101571861=        ORDER BY 7, 3, 1'
      '1101571862=        INTO :ROW,'
      '1101571863=             :STR_TEXT,'
      '1101571864=             :ID,'
      '1101571865=             :OPER_DATE,'
      '1101571866=             :SUMM_DEBET,'
      '1101571867=             :SUMM_CREDIT,'
      '1101571868=             :SORT_ROW'
      '1101571869=    DO BEGIN'
      '1101571870=      SUMM_DEBET_CONTR = SUMM_CREDIT;'
      '1101571871=      SUMM_CREDIT_CONTR = SUMM_DEBET;'
      '1101571872='
      '1101571873=      SUSPEND;'
      '1101571874=    END'
      '1101571875=  END'
      '1101571876='
      '1101571877=END'
      '1101571878=;'
      '1101571879='
      '1101571880=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '1101571881=RETURNS ('
      
        '1101571882=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '1101571883=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '1101571884=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '1101571885=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101571886=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101571887=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1101571888=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '1101571889=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '1101571890=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM,'
      '1101571891=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '1101571892=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '1101571893=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101571894=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101571895=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101571896=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101571897=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PR' +
        'ICE,'
      '1101571898=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1101571899=  IS_MARKED INTEGER,'
      
        '1101571900=  SUM_TO_CHARGE_BONUS TYPE OF COLUMN ZAKAZ_DETAILS_TM' +
        'P.SUMM,'
      
        '1101571901=  ORIGINAL_KIT_ID TYPE OF COLUMN ZAKAZ_DETAILS_TMP.OR' +
        'IGINAL_KIT_ID,'
      
        '1101571902=  ORIGINAL_KIT_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP' +
        '.ORIGINAL_KIT_PRICE)'
      '1101571903=AS'
      '1101571904=begin'
      '1101571905='
      '1101571906=  FOR'
      '1101571907=    SELECT T.ZAKAZ_DETAILS,'
      '1101571908=           T.ZAKAZ,'
      '1101571909=           T.G_PRODUCT,'
      '1101571910=           T.AMOUNT,'
      '1101571911=           T.PRICE,'
      '1101571912=           T.SUMM,'
      '1101571913=           T.DISCOUNT_PERC,'
      '1101571914=           T.DISCOUNT_TENGE,'
      '1101571915=           T.DISCOUNT_SUMM,'
      '1101571916=           T.NDS,'
      '1101571917=           T.NDS_SUMM,'
      '1101571918=           P.NAME PRODUCT_NAME'
      '1101571919=           ,P.BARCODE'
      '1101571920=           ,P.ARTICUL'
      '1101571921=           ,P.PRICE'
      '1101571922=           ,P.IS_KIT'
      
        '1101571923=           ,(SELECT SUM(TM.SUMM) FROM ZAKAZ_DETAILS_T' +
        'MP TM, G_PRODUCT GP'
      
        '1101571924=           WHERE TM.G_PRODUCT = GP.G_PRODUCT AND GP.D' +
        'O_NOT_CHARGE_BONUS = 0)'
      '1101571925=           ,T.COST_PRICE'
      '1101571926=           ,P.IS_MARKED'
      '1101571927=           ,T.ORIGINAL_KIT_ID'
      '1101571928=           ,T.ORIGINAL_KIT_PRICE'
      '1101571929=      FROM ZAKAZ_DETAILS_TMP T,'
      '1101571930=           G_PRODUCT P'
      '1101571931=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '1101571932=    ORDER BY t.ZAKAZ_DETAILS'
      '1101571933=    INTO :ZAKAZ_DETAILS,'
      '1101571934=          :ZAKAZ,'
      '1101571935=          :G_PRODUCT,'
      '1101571936=          :AMOUNT,'
      '1101571937=          :PRICE,'
      '1101571938=          :SUMM,'
      '1101571939=          :DISCOUNT_PERC,'
      '1101571940=          :DISCOUNT_TENGE,'
      '1101571941=          :DISCOUNT_SUMM,'
      '1101571942=          :NDS,'
      '1101571943=          :NDS_SUMM,'
      '1101571944=          :PRODUCT_NAME'
      '1101571945=          ,:BARCODE'
      '1101571946=          ,:ARTICUL'
      '1101571947=          ,:PRODUCT_PRICE'
      '1101571948=          ,:IS_KIT'
      '1101571949=          ,:SUM_TO_CHARGE_BONUS'
      '1101571950=          ,:COST_PRICE'
      '1101571951=          ,:IS_MARKED'
      '1101571952=          ,:ORIGINAL_KIT_ID'
      '1101571953=          ,:ORIGINAL_KIT_PRICE'
      '1101571954=  DO'
      '1101571955=    suspend;'
      '1101571956=end'
      '1101571957=;'
      '1101571958='
      '1101571959=ALTER PROCEDURE SMS_HISTORY_INS('
      '1101571960=  DATETIME_ TYPE OF COLUMN SMS_HISTORY.DATETIME,'
      '1101571961=  G_CLIENT_ TYPE OF COLUMN SMS_HISTORY.G_CLIENT,'
      
        '1101571962=  PHONE_NUMBER_ TYPE OF COLUMN SMS_HISTORY.PHONE_NUMB' +
        'ER,'
      '1101571963=  TEXT_ TYPE OF COLUMN SMS_HISTORY.TEXT,'
      
        '1101571964=  G_SMS_STATUS_ TYPE OF COLUMN SMS_HISTORY.G_SMS_STAT' +
        'US,'
      '1101571965=  SMS_ID_ TYPE OF COLUMN SMS_HISTORY.SMS_ID,'
      '1101571966=  ERROR_ TYPE OF COLUMN SMS_HISTORY.ERROR)'
      '1101571967=RETURNS ('
      
        '1101571968=  SMS_HISTORY_ TYPE OF COLUMN SMS_HISTORY.SMS_HISTORY' +
        ')'
      '1101571969=AS'
      '1101571970=begin'
      '1101571971=  insert into sms_history ('
      '1101571972=    sms_history,'
      '1101571973=    datetime,'
      '1101571974=    g_client,'
      '1101571975=    phone_number,'
      '1101571976=    text,'
      '1101571977=    g_sms_status'
      '1101571978=    ,SMS_ID'
      '1101571979=    ,ERROR'
      '1101571980=    )'
      '1101571981=  values ('
      '1101571982=    GEN_ID(gen_sms_history, 1),'
      '1101571983=    :datetime_,'
      '1101571984=    :g_client_,'
      '1101571985=    :phone_number_,'
      '1101571986=    :text_,'
      '1101571987=    :g_sms_status_'
      '1101571988=    ,:SMS_ID_'
      '1101571989=    ,:ERROR_'
      '1101571990=    )'
      '1101571991=  RETURNING'
      '1101571992=    sms_history'
      '1101571993=  INTO'
      '1101571994=    :sms_history_;'
      '1101571995=end'
      '1101571996=;'
      '1101571997='
      '1101571998=ALTER PROCEDURE SMS_RECIPIENTS_READ('
      '1101571999=  DATE_ DATE,'
      '1101572000=  SMS_HB_ENABLED_ INTEGER,'
      '1101572001=  SMS_HB_TEXT_ TYPE OF COLUMN SMS_HISTORY.TEXT,'
      '1101572002=  SMS_TRANSLIT_ INTEGER)'
      '1101572003=RETURNS ('
      '1101572004=  NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101572005=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '1101572006=  G_CLIENT TYPE OF COLUMN SMS_HISTORY.G_CLIENT,'
      '1101572007=  TEXT TYPE OF COLUMN SMS_HISTORY.TEXT,'
      '1101572008=  TIME_TO_SEND VARCHAR(20))'
      '1101572009=AS'
      '1101572010=/*'
      
        '1101572011='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1045#1058' '#1042#1057#1045' '#1047#1040#1055#1048#1057#1048' '#1050' '#1052#1040#1057#1058#1045#1056#1059' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071 +
        ' '#1048' '#1058#1045#1061' '#1059' '#1050#1054#1043#1054' '#1053#1040' '#1047#1040#1042#1058#1056#1040', '#1053#1054' '#1053#1040#1055#1054#1052#1053#1048#1058#1068' '#1053#1040#1044#1054' '#1047#1040' '#1044#1045#1053#1068', '#1058#1054' '#1045#1057#1058#1068' '#1057#1045#1043#1054 +
        #1044#1053#1071' ('#1058#1040#1050#1048#1052
      '1101572012='#1053#1040#1055#1054#1052#1048#1053#1040#1053#1048#1071' '#1041#1059#1044#1059' '#1042#1067#1057#1067#1051#1040#1058#1068' '#1042' 12-30)'
      
        '1101572013='#1042#1056#1054#1044#1045' '#1050#1040#1050' ID SCHEDULE '#1052#1053#1045' '#1058#1059#1058' '#1053#1045' '#1053#1059#1046#1045#1053'. '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1047#1040#1055#1048#1057#1048' '#1050' '#1052#1040#1057#1058#1045#1056#1059', '#1042#1057#1045' '#1057#1052#1057#1050#1048' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1041#1059#1044#1059#1058' '#1055#1040#1044#1040#1058#1068' '#1042' ' +
        #1046#1059#1056#1053#1040#1051
      
        '1101572014='#1047#1040' '#1057#1045#1043#1054#1044#1053#1071'. '#1040' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' '#1040#1042#1058#1054#1052#1040#1058#1048#1063#1045#1057#1050#1040#1071' '#1056#1040#1057#1057#1067#1051#1050#1040' '#1058#1054#1051#1068 +
        #1050#1054' '#1055#1056#1054#1048#1057#1061#1054#1044#1048#1058' 1 '#1056#1040#1047' '#1042' '#1044#1045#1053#1068
      '1101572015=*/'
      '1101572016=DECLARE VARIABLE CNT_ INTEGER;'
      '1101572017=BEGIN'
      '1101572018='
      
        '1101572019=  -- '#1045#1057#1051#1048' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' '#1059#1046#1045' '#1045#1057#1058#1068', '#1058#1054' '#1042#1067#1061#1054#1046#1059', '#1042#1044#1056#1059#1043' '#1055#1056#1048#1051#1054 +
        #1046#1045#1053#1048#1045' '#1047#1040#1055#1059#1057#1050#1040#1070#1058' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047' '#1047#1040' '#1044#1045#1053#1068
      '1101572020=  SELECT COUNT(*)'
      '1101572021=    FROM SMS_HISTORY H'
      '1101572022=   WHERE CAST(H.datetime AS DATE) = :DATE_'
      '1101572023=     AND COALESCE(H.error, 0) = 0'
      '1101572024=    INTO :CNT_;'
      '1101572025='
      '1101572026=  IF (CNT_ > 0) THEN'
      '1101572027=    EXIT;'
      '1101572028='
      '1101572029=  FOR SELECT TRIM(G.PHONE) PHONE,'
      '1101572030=             G.NAME,'
      
        '1101572031=             REPLACE(:sms_hb_text_, '#39'@name@'#39', G.NAME)' +
        ','
      
        '1101572032=             LPAD(EXTRACT(DAY FROM CURRENT_DATE), 2, ' +
        #39'0'#39')||LPAD(EXTRACT(MONTH FROM CURRENT_DATE), 2, '#39'0'#39')||'
      
        '1101572033=                SUBSTRING(EXTRACT(YEAR FROM CURRENT_D' +
        'ATE) FROM 3 FOR 2)||'#39'1200'#39' SEND_TIME,'
      '1101572034=             G.G_CLIENT'
      '1101572035=        FROM G_CLIENT G'
      
        '1101572036=       WHERE EXTRACT(DAY FROM G.dt) = EXTRACT(DAY FRO' +
        'M CURRENT_DATE)'
      
        '1101572037=         AND EXTRACT(MONTH FROM G.dt) = EXTRACT(MONTH' +
        ' FROM CURRENT_DATE)'
      '1101572038=         AND :sms_hb_enabled_ = 1'
      '1101572039=         AND char_length(G.phone) > 0'
      '1101572040=         AND G.notify_dr = 1'
      '1101572041=       ORDER BY 2, 5'
      '1101572042=        INTO :PHONE'
      '1101572043=             ,:NAME'
      '1101572044=             ,:TEXT'
      '1101572045=             ,:TIME_TO_SEND'
      '1101572046=             ,:G_CLIENT'
      '1101572047=  DO SUSPEND;'
      '1101572048=end'
      '1101572049=;'
      
