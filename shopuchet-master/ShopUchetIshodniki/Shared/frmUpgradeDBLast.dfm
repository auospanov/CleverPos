        '1101625624=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101625625=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625626=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101625627=                      EXIT;'
      '1101625628=                    END'
      '1101625629=                END'
      '1101625630=            END'
      
        '1101625631=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      
        '1101625632=            --=======================================' +
        '=========================='
      '1101625633='
      
        '1101625634=            --=======================================' +
        '=========================='
      '1101625635=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101625636=            --=======================================' +
        '=========================='
      '1101625637=            PNT_ = '#39'12'#39';'
      
        '1101625638=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1101625639=                KASSA_ZP_ID_ = NULL;'
      '1101625640='
      '1101625641=                SELECT S.S_VALUE'
      '1101625642=                  FROM SYSTEM_SETUP S'
      '1101625643=                 WHERE S.SYSTEM_SETUP = 4'
      '1101625644=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101625645='
      '1101625646=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101625647=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101625648=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101625649='
      
        '1101625650=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101625651=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1101625652=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1101625653='
      '1101625654=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101625655=                ELSE'
      
        '1101625656=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1101625657='
      '1101625658=                SELECT K.KASSA, K.SUMM'
      '1101625659=                FROM KASSA K'
      '1101625660=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1101625661=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101625662=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101625663=                 AND K.G_TOCHKA = :G_TOCHKA_'
      
        '1101625664=                 INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM' +
        '_ITER_;'
      '1101625665='
      
        '1101625666=                LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090 +
        ' "'#39' || EXTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month' +
        ' FROM ACTION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_' +
        ') || '#39'"'#39';'
      '1101625667='
      '1101625668=                IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1101625669=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101625670=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101625671=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101625672=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101625673=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1101625674=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1101625675=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1101625676=                                                  1,'
      
        '1101625677=                                                  :G_' +
        'TOCHKA_,'
      
        '1101625678=                                                  :G_' +
        'OFFICIAL_) RETURNING_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG)' +
        ';'
      '1101625679=                    LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101625680=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES' +
        '_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101625681='
      '1101625682=                END ELSE BEGIN'
      
        '1101625683=                    SALES_COMM_SUMM_ALL_ = SALES_COMM' +
        '_SUMM_ITER_ + SALES_COMM_SUMM_ALL_ - SALES_COMM_OLD_;'
      '1101625684=                    LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101625685=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' ' +
        '"'#39' || SALES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101625686=                    LOG_BODY_KASSA_ = LOG_BODY_KASSA_' +
        ' || '#39' '#1085#1072' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101625687='
      
        '1101625688=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_ZP_ID_,'
      
        '1101625689=                                                  1, ' +
        '    -- ACTION_'
      
        '1101625690=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101625691=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101625692=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101625693=                                                  :OF' +
        'FICIAL_NAME_,   --NOTE_'
      
        '1101625694=                                                  NUL' +
        'L,'
      
        '1101625695=                                                  NUL' +
        'L,'
      
        '1101625696=                                                  1, ' +
        '  --:PAYMENT_TYPE_,'
      
        '1101625697=                                                  :G_' +
        'OFFICIAL_'
      
        '1101625698=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101625699=                END'
      '1101625700=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625701=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101625702=                  EXIT;'
      '1101625703=                END'
      '1101625704=            END'
      
        '1101625705=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1101625706=            --=======================================' +
        '=========================='
      '1101625707='
      '1101625708=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1101625709='
      '1101625710=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101625711=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101625712=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101625713=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 2);'
      '1101625714=  END'
      '1101625715=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1101625716=  ---------------------------------------------------' +
        '------------'
      
        '1101625717=  --*************************************************' +
        '************'
      
        '1101625718=  ---------------------------------------------------' +
        '------------'
      '1101625719=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101625720=  ELSE BEGIN'
      '1101625721=      PNT_ = '#39'020'#39';'
      '1101625722=      SELECT SP.G_TOCHKA,'
      '1101625723=             SP.G_CLIENT,'
      '1101625724=             SP.IS_EXPECTED'
      '1101625725=        FROM SKLAD_PARENT SP'
      '1101625726=       WHERE SP.SKLAD = :ZAKAZ_'
      '1101625727=        INTO :G_TOCHKA_OLD_,'
      '1101625728=             :G_TOCHKA_,'
      '1101625729=             :IS_EXPECTED_OLD_;'
      '1101625730='
      
        '1101625731=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101625732=      PNT_ = '#39'021'#39';'
      '1101625733=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '1101625734=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101625735=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625736=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101625737=            EXIT;'
      '1101625738=          END'
      '1101625739='
      '1101625740=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101625741=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101625742=                FROM ZAKAZ_DETAILS_TMP Z'
      '1101625743=              INTO :G_PRODUCT_,'
      '1101625744=                  :Z_AMOUNT_,'
      '1101625745=                  :PRICE_,'
      '1101625746=                  :SUMMM_'
      '1101625747=          DO BEGIN'
      '1101625748=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101625749=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1101625750=            IS_THIS_LAST_ = 0;'
      '1101625751=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101625752=                FROM SKLAD SK'
      '1101625753=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101625754=                 AND SK.IS_LAST = 1'
      '1101625755=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1101625756=                INTO :DATE_LAST_;'
      '1101625757='
      
        '1101625758=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101625759=                UPDATE SKLAD SK'
      '1101625760=                   SET SK.IS_LAST = 0'
      '1101625761=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101625762=                   AND SK.IS_LAST = 1'
      '1101625763=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101625764='
      '1101625765=                IS_THIS_LAST_ = 1;'
      '1101625766=            END'
      '1101625767='
      '1101625768='
      '1101625769=            INSERT INTO SKLAD'
      '1101625770=            ('
      '1101625771=             SKLAD,'
      '1101625772=             SKLAD_PARENT,'
      '1101625773=             DATE_RECEIPT,'
      '1101625774=             G_CLIENT,'
      '1101625775=             G_PRODUCT,'
      '1101625776=             AMOUNT,'
      '1101625777=             PRICE,'
      '1101625778=             SUMM,'
      '1101625779=             G_PAYMENT_TYPE,'
      '1101625780=             OSNOVANIE,'
      '1101625781=             NOTE,'
      '1101625782=             NDS,'
      '1101625783=             NDS_SUMM,'
      '1101625784=             IS_LAST,'
      '1101625785=             IS_VOZVRAT,'
      '1101625786=             G_TOCHKA'
      '1101625787=            ) VALUES ('
      '1101625788=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101625789=             :ZAKAZ_,'
      '1101625790=             :Z_DATE_,'
      '1101625791=             :G_TOCHKA_,'
      '1101625792=             :G_PRODUCT_,'
      '1101625793=             :Z_AMOUNT_,'
      '1101625794=             :PRICE_,'
      '1101625795=             :SUMMM_,'
      '1101625796=             :G_PAYMENT_TYPE_,'
      '1101625797=             :OSNOVANIE_,'
      '1101625798=             :NOTE_,'
      '1101625799=             0,  --:RNDS_,'
      '1101625800=             0,  --:RNDS_SUMM_,'
      
        '1101625801=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1101625802=             3,  --:IS_VOZVRAT_,'
      '1101625803=             :G_CLIENT_'
      '1101625804=            );'
      '1101625805='
      
        '1101625806=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1101625807=            UPDATE LT_SKLAD_PRODUCT L'
      '1101625808=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '1101625809=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625810=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101625811='
      
        '1101625812=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101625813=            PNT_ = '#39'023'#39';'
      '1101625814=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101625815=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625816=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_'
      '1101625817=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625818=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1101625819='
      '1101625820=                IF (ROW_COUNT = 0) THEN'
      
        '1101625821=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_' +
        'SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101625822=            END'
      '1101625823=          END'
      '1101625824=      END'
      '1101625825=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1101625826=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1101625827=      ELSE BEGIN'
      
        '1101625828=          -------------------------------------------' +
        '------------------'
      
        '1101625829=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1101625830=          PNT_ = '#39'025'#39';'
      '1101625831=          FOR SELECT SKLAD,'
      '1101625832=                     AMOUNT,'
      '1101625833=                     G_PRODUCT'
      '1101625834=                FROM SKLAD S'
      '1101625835=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1101625836=                 AND NOT EXISTS (SELECT 1'
      
        '1101625837=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1101625838=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1101625839=          INTO :SKLAD_,'
      '1101625840=               :Z_AMOUNT_,'
      '1101625841=               :G_PRODUCT_'
      '1101625842=          DO BEGIN'
      
        '1101625843=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101625844=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101625845=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101625846=              EXIT;'
      '1101625847=            END'
      '1101625848=          END'
      '1101625849='
      '1101625850=          PNT_ = '#39'030'#39';'
      '1101625851=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1101625852=                     S.G_PRODUCT,'
      '1101625853=                     S.AMOUNT,'
      '1101625854=                     S.PRICE,'
      '1101625855=                     S.SUMM,'
      '1101625856=                     T.SKLAD,'
      '1101625857=                     T.AMOUNT,'
      '1101625858=                     T.IS_LAST,'
      '1101625859=                     T.DATE_RECEIPT'
      
        '1101625860=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1101625861=                INTO :ZAKAZ_DETAILS_,'
      '1101625862=                     :G_PRODUCT_,'
      '1101625863=                     :Z_AMOUNT_,'
      '1101625864=                     :PRICE_,'
      '1101625865=                     :SUMMM_,'
      '1101625866=                     :SKLAD_OLD_,'
      '1101625867=                     :AMOUNT_OLD_,'
      '1101625868=                     :IS_THIS_LAST_,'
      '1101625869=                     :DATE_RECEIPT_OLD_'
      '1101625870=          DO BEGIN'
      
        '1101625871=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101625872=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1101625873=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1101625874=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1101625875=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1101625876=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101625877=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1101625878=                       )'
      '1101625879=                RETURNING'
      '1101625880=                  SKLAD'
      '1101625881=                INTO'
      '1101625882=                  :SKLAD_;'
      '1101625883='
      
        '1101625884=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101625885=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625886=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_'
      '1101625887=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625888=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101625889='
      
        '1101625890=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101625891=                IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGI' +
        'N'
      '1101625892=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625893=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_'
      '1101625894=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625895=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101625896='
      '1101625897=                    IF (ROW_COUNT = 0) THEN'
      
        '1101625898=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN' +
        '_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101625899=                END'
      '1101625900='
      
        '1101625901=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101625902=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045 +
        #1053#1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042 +
        #1051#1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1101625903=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_S' +
        'KLAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1101625904=                /*SELECT MAX(SK.DATE_RECEIPT)'
      '1101625905=                  FROM SKLAD SK'
      '1101625906=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101625907=                   AND SK.IS_LAST = 1'
      '1101625908=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '1101625909=                  INTO :DATE_LAST_;'
      '1101625910='
      
        '1101625911=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ ' +
        '>= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101625912=                  UPDATE SKLAD SK'
      '1101625913=                     SET SK.IS_LAST = 0'
      '1101625914=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101625915=                     AND SK.IS_LAST = 1'
      '1101625916=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101625917='
      '1101625918=                  UPDATE SKLAD SK'
      '1101625919=                     SET SK.IS_LAST = 1'
      '1101625920=                   WHERE SK.SKLAD = :SKLAD_;'
      '1101625921=                END*/'
      '1101625922='
      
        '1101625923=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101625924=            END ELSE BEGIN'
      '1101625925=                UPDATE SKLAD S'
      '1101625926=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1101625927=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1101625928=                       S.PRICE    = :PRICE_,'
      '1101625929=                       S.SUMM     = :SUMMM_,'
      '1101625930=                       S.OSNOVANIE = :OSNOVANIE_,'
      '1101625931=                       S.NOTE      = :NOTE_'
      '1101625932=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1101625933='
      
        '1101625934=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101625935=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101625936=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625937=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_)'
      '1101625938=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625939=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1101625940=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1101625941=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625942=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_)'
      '1101625943=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625944=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101625945='
      
        '1101625946=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101625947=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101625948=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101625949=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625950=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_)'
      
        '1101625951=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101625952=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101625953='
      
        '1101625954=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1101625955=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625956=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_)'
      
        '1101625957=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101625958=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101625959='
      
        '1101625960=                -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' ' +
        #1057#1050#1051#1040#1044', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1101625961=                END ELSE IF (IS_EXPECTED_OLD_ = 1 AND' +
        ' NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101625962=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625963=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_'
      '1101625964=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625965=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101625966='
      '1101625967=                    IF (ROW_COUNT = 0) THEN'
      
        '1101625968=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101625969=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101625970=                END'
      
        '1101625971=                -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042 +
        #1040' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1101625972=                ELSE IF (IS_EXPECTED_OLD_ = 0 AND NOT' +
        '_MINUS_OSTATOK_ = 1) THEN BEGIN'
      '1101625973=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101625974=                       SET L.AMOUNT = L.AMOUNT - (:AM' +
        'OUNT_OLD_ - :Z_AMOUNT_) - :Z_AMOUNT_'
      '1101625975=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101625976=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101625977=                END'
      '1101625978='
      
        '1101625979=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1101625980=                /*IF ((Z_DATE_ > DATE_RECEIPT_OLD_) A' +
        'ND (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1101625981=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101625982=                      FROM SKLAD SK'
      '1101625983=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101625984=                       AND SK.IS_LAST = 1'
      '1101625985=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101625986=                      INTO :DATE_LAST_;'
      '1101625987='
      
        '1101625988=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101625989=                      UPDATE SKLAD SK'
      '1101625990=                         SET SK.IS_LAST = 0'
      
        '1101625991=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1101625992=                         AND SK.IS_LAST = 1'
      
        '1101625993=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1101625994='
      '1101625995=                      UPDATE SKLAD SK'
      '1101625996=                         SET SK.IS_LAST = 1'
      
        '1101625997=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101625998=                    END'
      '1101625999=                END'
      '1101626000='
      
        '1101626001=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1101626002=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1101626003=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101626004=                      FROM SKLAD SK'
      '1101626005=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101626006=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1101626007=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101626008=                       AND SK.is_vozvrat IN (0,3,4)'
      '1101626009=                      INTO :DATE_LAST_;'
      '1101626010='
      
        '1101626011=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101626012=                      UPDATE SKLAD SK'
      '1101626013=                         SET SK.IS_LAST = 0'
      
        '1101626014=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101626015='
      '1101626016=                       UPDATE SKLAD SK'
      '1101626017=                         SET SK.IS_LAST = 1'
      
        '1101626018=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1101626019=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1101626020=                                           FROM SKLAD' +
        ' SS'
      
        '1101626021=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1101626022=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1101626023=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1101626024=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1101626025=                    END'
      '1101626026=                END*/'
      '1101626027=            END'
      '1101626028=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1101626029=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1101626030='
      '1101626031=      UPDATE SKLAD_PARENT'
      '1101626032=      SET'
      
        '1101626033=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1101626034=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1101626035=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101626036=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101626037=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101626038=       SUMM      = :SUMM_,'
      '1101626039=       SUMM_FACT = :SUMM_FACT_,'
      '1101626040=       IS_EXPECTED = :NOT_MINUS_OSTATOK_'
      '1101626041=      WHERE SKLAD  = :ZAKAZ_;'
      '1101626042=  END'
      '1101626043='
      '1101626044=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101626045='
      '1101626046=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101626047=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 2, :SUMM_, :LOG_BODY_, 0);'
      '1101626048='
      '1101626049=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1101626050=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1101626051=END'
      '1101626052=;'
      '1101626053='
      '1101626054='
      
        '1101626055=/****************************************************' +
        '**************************/'
      
        '1101626056=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101626057=/****************************************************' +
        '**************************/'
      '1101626058=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1101626059=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101626060=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM,'
      '1101626061=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101626062=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101626063=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1101626064=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '1101626065=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE' +
        ','
      '1101626066=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101626067=  SELF_PRICE_ NUMERIC(15,2),'
      '1101626068=  AMOUNT_ MY_NUMERIC_5,'
      '1101626069=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1101626070=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1101626071=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1101626072=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1101626073=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '1101626074=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1101626075=  CATEGORY_NAME_ VARCHAR(1000),'
      '1101626076=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1101626077=  IS_THIS_LAST_ INTEGER,'
      '1101626078=  UPDATE_IF_EXIST_ INTEGER)'
      '1101626079=RETURNS ('
      '1101626080=  ERR_CODE INTEGER,'
      '1101626081=  ERR_MSG VARCHAR(1024))'
      '1101626082=AS'
      
        '1101626083=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_P' +
        'RODUCT'#39';'
      '1101626084=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101626085=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1101626086=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT_PAR;'
      
        '1101626087=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G' +
        '_PRODUCT.G_PRODUCT_PAR;'
      
        '1101626088=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT' +
        ';'
      
        '1101626089=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT = 0;'
      
        '1101626090=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRO' +
        'DUCT.NAME;'
      
        '1101626091=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD;'
      
        '1101626092=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1101626093=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM_CURRENCY;'
      '1101626094=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '1101626095=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101626096=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLA' +
        'D = 0;'
      
        '1101626097=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_P' +
        'RODUCT;'
      
        '1101626098=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT' +
        ' = 0;'
      '1101626099=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '1101626100=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '1101626101=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '1101626102=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '1101626103=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '1101626104=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101626105=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1101626106=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '1101626107=BEGIN'
      '1101626108=    ERR_MSG = '#39#39';'
      '1101626109=    PNT_ = '#39'00'#39';'
      '1101626110='
      
        '1101626111=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044 +
        #1045#1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '1101626112=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS889' +
        '88~98888~"'
      
        '1101626113=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' ' +
        #1053#1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '1101626114=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '1101626115=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39 +
        '~'#39');'
      '1101626116=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '1101626117=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '1101626118=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '1101626119=    END ELSE'
      '1101626120=        CROSSCODE_ = NULL;'
      '1101626121='
      '1101626122=    PNT_ = '#39'01'#39';'
      '1101626123=    SELECT ID'
      '1101626124=      FROM CUR_PARAMS'
      '1101626125=    WHERE CUR_PARAMS = 2'
      '1101626126=      INTO :G_TOCHKA_;'
      '1101626127='
      '1101626128=    SELECT G.G_UNIT'
      '1101626129=      FROM G_UNIT G'
      
        '1101626130=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAM' +
        'E_G_UNIT_))'
      '1101626131=      INTO :G_UNIT_;'
      '1101626132=    if (ROW_COUNT = 0) then'
      '1101626133=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '1101626134='
      '1101626135=    PNT_ = '#39'02'#39';'
      
        '1101626136=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101626137=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1101626138=        SELECT G.G_PRODUCT,'
      '1101626139=               G.NAME'
      '1101626140=          FROM G_PRODUCT G'
      
        '1101626141=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1101626142=           AND TRIM(G.ARTICUL) <> '#39#39
      '1101626143=           AND G.IS_ACTIVE = 1'
      '1101626144=          INTO :G_PRODUCT_,'
      '1101626145=               :G_PRODUCT_NAME_;'
      '1101626146='
      
        '1101626147=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101626148=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101626149=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101626150=              UPDATE G_PRODUCT G'
      '1101626151=                 SET G.NAME = :NAME_,'
      '1101626152=                     G.G_UNIT = :G_UNIT_,'
      '1101626153=                     G.PRICE  = :PRICE_,'
      '1101626154=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101626155=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101626156=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101626157=                     G.PLACE = :PLACE_,'
      
        '1101626158=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101626159=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101626160=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101626161=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101626162=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101626163=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101626164='
      
        '1101626165=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101626166=            END ELSE'
      
        '1101626167=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101626168=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAM' +
        'E_||'#39'.'#39';'
      '1101626169=        END'
      '1101626170=    END ELSE'
      
        '1101626171=      EXECUTE PROCEDURE get_free_articul RETURNING_VA' +
        'LUES (:ARTICUL_);'
      '1101626172='
      
        '1101626173=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '1101626174=    PNT_ = '#39'02a'#39';'
      
        '1101626175=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '1101626176=        SELECT G.G_PRODUCT,'
      '1101626177=               G.NAME'
      '1101626178=          FROM G_PRODUCT G'
      
        '1101626179=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_' +
        'NUM_)'
      '1101626180=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '1101626181=           AND G.IS_ACTIVE = 1'
      '1101626182=          INTO :G_PRODUCT_,'
      '1101626183=               :G_PRODUCT_NAME_;'
      '1101626184='
      
        '1101626185=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101626186=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101626187=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101626188=              UPDATE G_PRODUCT G'
      '1101626189=                 SET G.NAME = :NAME_,'
      '1101626190=                     G.G_UNIT = :G_UNIT_,'
      '1101626191=                     G.PRICE  = :PRICE_,'
      '1101626192=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101626193=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101626194=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101626195=                     G.PLACE = :PLACE_,'
      
        '1101626196=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101626197=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101626198=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101626199=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101626200=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101626201=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101626202='
      
        '1101626203=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1101626204=            END ELSE'
      
        '1101626205=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101626206=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1101626207=        END'
      '1101626208=    end'
      '1101626209='
      
        '1101626210=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1101626211=    PNT_ = '#39'02b'#39';'
      
        '1101626212=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1101626213=        SELECT G.G_PRODUCT,'
      '1101626214=               G.NAME'
      '1101626215=          FROM G_PRODUCT G'
      '1101626216=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1101626217=           AND TRIM(G.BARCODE) <> '#39#39
      '1101626218=           AND G.IS_ACTIVE = 1'
      '1101626219=          INTO :G_PRODUCT_,'
      '1101626220=               :G_PRODUCT_NAME_;'
      '1101626221='
      '1101626222=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1101626223=          SELECT G.G_PRODUCT,'
      '1101626224=                 G.NAME'
      '1101626225=            FROM G_PRODUCT G, LT_BARCODE L'
      '1101626226=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101626227=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1101626228=             AND TRIM(L.BARCODE) <> '#39#39
      '1101626229=            INTO :G_PRODUCT_,'
      '1101626230=                 :G_PRODUCT_NAME_;'
      '1101626231='
      
        '1101626232=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101626233=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101626234=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101626235=              UPDATE G_PRODUCT G'
      '1101626236=                 SET G.NAME = :NAME_,'
      '1101626237=                     G.G_UNIT = :G_UNIT_,'
      '1101626238=                     G.PRICE  = :PRICE_,'
      '1101626239=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101626240=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101626241=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101626242=                     G.PLACE = :PLACE_,'
      
        '1101626243=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101626244=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101626245=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101626246=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101626247=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101626248=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101626249='
      
        '1101626250=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101626251=            END ELSE'
      
        '1101626252=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101626253=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1101626254=        END'
      
        '1101626255=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1101626256=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1101626257='
      
        '1101626258=    --===============================================' +
        '=========='
      '1101626259=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '1101626260=    --===============================================' +
        '=========='
      '1101626261=    PNT_ = '#39'02b'#39';'
      '1101626262=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '1101626263='
      
        '1101626264=        ---------------------------------------------' +
        '---------------------'
      
        '1101626265=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048 +
        ' '#1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '1101626266=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082 +
        #1080'~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '1101626267=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '1101626268=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054',' +
        ' '#1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '1101626269=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BE' +
        'GIN'
      '1101626270=            G_PRODUCT_PAR_ = NULL;'
      
        '1101626271=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAM' +
        'E_);'
      '1101626272=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '1101626273=              STR_ = CATEGORY_NAME_;'
      '1101626274=              CATEGORY_NAME_ = '#39#39';'
      '1101626275=            END ELSE'
      
        '1101626276=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1101626277='
      '1101626278=            SELECT G_PRODUCT'
      '1101626279=              FROM G_PRODUCT G'
      '1101626280=             WHERE G.NAME = :STR_'
      '1101626281=               AND G.IS_CATEGORY = 1'
      
        '1101626282=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1101626283=                   OR'
      '1101626284=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '1101626285=              INTO G_PRODUCT_PAR_;'
      '1101626286=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1101626287=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1101626288=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1101626289=                RETURNING G_PRODUCT'
      '1101626290=                INTO :G_PRODUCT_PAR_;'
      '1101626291='
      '1101626292=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1101626293=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1101626294=        END'
      
        '1101626295=        ---------------------------------------------' +
        '---------------------'
      '1101626296='
      
        '1101626297=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1101626298=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '1101626299=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1101626300=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '1101626301=        RETURNING G_PRODUCT'
      '1101626302=        INTO :G_PRODUCT_;'
      '1101626303='
      
        '1101626304=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101626305=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_);'
      '1101626306=    end'
      '1101626307='
      
        '1101626308=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101626309=    PNT_ = '#39'03'#39';'
      '1101626310=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1101626311=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1101626312=                                       :AMOUNT_,'
      '1101626313=                                       :SELF_PRICE_,'
      
        '1101626314=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1101626315=                                       0, --nds_,'
      '1101626316=                                       0 --nds_summ_,'
      
        '1101626317=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1101626318=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1101626319=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1101626320=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1101626321=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1101626322=          EXIT;'
      '1101626323=        END'
      '1101626324=    END'
      '1101626325='
      
        '1101626326=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1101626327=    PNT_ = '#39'04'#39';'
      '1101626328=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1101626329=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1101626330=        FROM SKLAD_TMP T'
      '1101626331=        INTO :CNT_;'
      '1101626332='
      '1101626333=      if (CNT_ > 0) then BEGIN'
      '1101626334=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1101626335=          FROM SKLAD_TMP T'
      '1101626336=          INTO :SUMM_, :SUMM_UE_;'
      '1101626337='
      '1101626338=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101626339=                                DATE_RECEIPT,'
      '1101626340=                                TIME_RECEIPT,'
      '1101626341=                                G_CLIENT,'
      '1101626342=                                G_PAYMENT_TYPE,'
      '1101626343=                                OSNOVANIE,'
      '1101626344=                                NOTE,'
      '1101626345=                                SUMM,'
      '1101626346=                                SUMM_FACT,'
      '1101626347=                                SUMM_CURRENCY,'
      '1101626348=                                IS_PAYED_ALL,'
      '1101626349=                                IS_VOZVRAT,'
      '1101626350=                                G_TOCHKA)'
      '1101626351=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101626352=                CURRENT_DATE,'
      '1101626353=                CURRENT_TIME,'
      '1101626354=                :G_CLIENT_,'
      '1101626355=                1,'
      '1101626356=                NULL,  --:OSNOVANIE_,'
      '1101626357=                NULL,  -- :NOTE_,'
      '1101626358=                :SUMM_,'
      '1101626359=                :SUMM_,'
      '1101626360=                :SUMM_UE_,'
      
        '1101626361=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1101626362=                0,'
      '1101626363=                :G_TOCHKA_)'
      '1101626364=        RETURNING'
      '1101626365=          SKLAD'
      '1101626366=        INTO'
      '1101626367=          :SKLAD_PARENT_;'
      '1101626368='
      '1101626369=        PNT_ = '#39'05'#39';'
      '1101626370=        FOR SELECT SKLAD,'
      '1101626371=                   G_PRODUCT,'
      '1101626372=                   AMOUNT,'
      '1101626373=                   PRICE,'
      '1101626374=                   SUMM'
      '1101626375=                   ,PRICE_CURRENCY'
      '1101626376=                   ,SUMM_CURRENCY'
      '1101626377=              FROM SKLAD_TMP'
      '1101626378=             ORDER BY 1'
      '1101626379=              INTO :SKLAD_TMP_,'
      '1101626380=                   :RG_PRODUCT_,'
      '1101626381=                   :RAMOUNT_,'
      '1101626382=                   :RPRICE_,'
      '1101626383=                   :RSUMM_'
      '1101626384=                   ,:RPRICE_UE_'
      '1101626385=                   ,:RSUMM_UE_'
      '1101626386=        DO BEGIN'
      '1101626387='
      '1101626388=            UPDATE SKLAD SK'
      '1101626389=               SET SK.IS_LAST = 0'
      '1101626390=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101626391=               AND SK.IS_LAST = 1;'
      '1101626392='
      '1101626393=            INSERT INTO SKLAD'
      '1101626394=            ('
      '1101626395=             SKLAD,'
      '1101626396=             SKLAD_PARENT,'
      '1101626397=             DATE_RECEIPT,'
      '1101626398=             G_CLIENT,'
      '1101626399=             G_PRODUCT,'
      '1101626400=             AMOUNT,'
      '1101626401=             PRICE,'
      '1101626402=             SUMM,'
      '1101626403=             G_PAYMENT_TYPE,'
      '1101626404=             OSNOVANIE,'
      '1101626405=             NOTE,'
      '1101626406=             NDS,'
      '1101626407=             NDS_SUMM,'
      '1101626408=             IS_LAST,'
      '1101626409=             IS_VOZVRAT,'
      '1101626410=             G_TOCHKA'
      '1101626411=             ,PRICE_CURRENCY'
      '1101626412=             ,SUMM_CURRENCY'
      '1101626413=            ) VALUES ('
      '1101626414=             :SKLAD_TMP_,'
      '1101626415=             :SKLAD_PARENT_,'
      '1101626416=             CURRENT_DATE,'
      '1101626417=             :G_CLIENT_,'
      '1101626418=             :RG_PRODUCT_,'
      '1101626419=             :RAMOUNT_,'
      '1101626420=             :RPRICE_,'
      '1101626421=             :RSUMM_,'
      '1101626422=             1,       --:G_PAYMENT_TYPE_,'
      '1101626423=             NULL,    --:OSNOVANIE_,'
      '1101626424=             NULL,    --:NOTE_,'
      '1101626425=             0,       --:RNDS_,'
      '1101626426=             0,       --:RNDS_SUMM_,'
      '1101626427=             1,       --IS_LAST_'
      '1101626428=             0,        --:IS_VOZVRAT_'
      '1101626429=             :G_TOCHKA_'
      '1101626430=             ,:RPRICE_UE_'
      '1101626431=             ,:RSUMM_UE_'
      '1101626432=            );'
      '1101626433='
      
        '1101626434=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101626435=            PNT_ = '#39'06'#39';'
      '1101626436=            UPDATE LT_SKLAD_PRODUCT L'
      '1101626437=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1101626438=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101626439=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101626440='
      '1101626441=            PNT_ = '#39'06a'#39';'
      '1101626442=            IF (ROW_COUNT = 0) THEN'
      
        '1101626443=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101626444=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '1101626445=        END'
      '1101626446='
      '1101626447=        PNT_ = '#39'07'#39';'
      
        '1101626448=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101626449=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1101626450=                                :SUMM_,'
      '1101626451=                                CURRENT_DATE,'
      
        '1101626452=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1101626453=                                NULL,   --ZAKAZ_'
      '1101626454=                                :SKLAD_PARENT_,'
      '1101626455=                                1,'
      
        '1101626456=                                :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101626457=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101626458=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101626459=          EXIT;'
      '1101626460=        END'
      '1101626461='
      '1101626462=        DELETE FROM SKLAD_TMP;'
      '1101626463=      END'
      '1101626464=    END'
      '1101626465='
      
        '1101626466=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1101626467=    if (ERR_MSG_ IS NOT NULL) then'
      '1101626468=      ERR_MSG = ERR_MSG_;'
      '1101626469='
      '1101626470=WHEN ANY DO BEGIN'
      '1101626471=    Err_code = gdscode;'
      
        '1101626472=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1101626473=  END'
      '1101626474=END'
      '1101626475=;'
      '1101626476='
      '1101626477=ALTER PROCEDURE G_TOCHKA_DEL('
      '1101626478=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101626479=RETURNS ('
      '1101626480=  ERR_CODE INTEGER,'
      '1101626481=  ERR_MSG VARCHAR(1024))'
      '1101626482=AS'
      '1101626483=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '1101626484=BEGIN'
      '1101626485=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '1101626486=    ERR_CODE = -20500;'
      
        '1101626487=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091 +
        #1076#1072#1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1101626488=    EXIT;'
      '1101626489=  END'
      '1101626490='
      '1101626491=  DELETE FROM KASSA_STATE S'
      '1101626492=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1101626493='
      
        '1101626494=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040 +
        #1041#1051#1048#1062#1059' LOGS'
      
        '1101626495=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_' +
        'SETUP = 5) > 0) THEN'
      
        '1101626496=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFER' +
        'ED, SYSDATE, ERR_CODE)'
      
        '1101626497=      VALUES (GEN_ID(GEN_LOGS, 1), '#39'DELETE FROM KASSA' +
        '_STATE S WHERE S.G_TOCHKA = '#39'||:G_TOCHKA_||'#39';'#39', '#39'SYSDBA'#39', 0, CUR' +
        'RENT_TIMESTAMP, :ERR_CODE);'
      '1101626498='
      '1101626499=  DELETE FROM KASSA S'
      '1101626500=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1101626501='
      '1101626502=  FOR SELECT KASSA_BEZNAL'
      '1101626503=        FROM KASSA_BEZNAL'
      '1101626504=       WHERE G_TOCHKA = :G_TOCHKA_'
      '1101626505=        INTO :KASSA_'
      '1101626506=  DO BEGIN'
      
        '1101626507=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNI' +
        'NG_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101626508=    IF (:ERR_CODE <> 0) THEN'
      '1101626509=      EXIT;'
      '1101626510=  END'
      '1101626511='
      '1101626512=  UPDATE G_OFFICIAL O'
      '1101626513=     SET O.G_TOCHKA = NULL'
      '1101626514=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '1101626515='
      '1101626516=  DELETE FROM INVOICE I'
      '1101626517=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1101626518=                      FROM ZAKAZ'
      '1101626519=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101626520='
      '1101626521=  DELETE FROM INVOICE_PAY I'
      '1101626522=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1101626523=                      FROM ZAKAZ'
      '1101626524=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101626525='
      '1101626526=  DELETE FROM WAYBILL I'
      '1101626527=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1101626528=                      FROM ZAKAZ'
      '1101626529=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101626530='
      '1101626531=  DELETE FROM LT_ZAKAZ_REAL R'
      '1101626532=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '1101626533=                              FROM ZAKAZ Z, ZAKAZ_DET' +
        'AILS ZD'
      
        '1101626534=                             WHERE Z.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '1101626535=                               AND Z.ZAKAZ = ZD.ZAKAZ' +
        ');'
      '1101626536='
      '1101626537=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '1101626538=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1101626539=                                  FROM ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1101626540=                                 WHERE G_TOCHKA = :G_' +
        'TOCHKA_);'
      '1101626541='
      '1101626542=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '1101626543=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101626544='
      '1101626545=  DELETE FROM ZAKAZ_DETAILS D'
      '1101626546=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1101626547=                      FROM ZAKAZ'
      '1101626548=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101626549='
      '1101626550=  DELETE FROM ZAKAZ D'
      '1101626551=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101626552='
      '1101626553=  DELETE FROM SKLAD D'
      '1101626554=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101626555='
      '1101626556=  DELETE FROM SKLAD_PARENT D'
      '1101626557=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1101626558='
      '1101626559=  DELETE FROM ZAKAZ_DETAILS D'
      '1101626560=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1101626561=                      FROM ZAKAZ'
      '1101626562=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1101626563='
      '1101626564=  DELETE FROM LT_SKLAD_PRODUCT'
      '1101626565=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '1101626566='
      '1101626567=  DELETE FROM G_TOCHKA'
      '1101626568=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '1101626569=END'
      '1101626570=;'
      '1101626571='
      '1101626572=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1101626573=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101626574=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101626575=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101626576=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101626577=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101626578=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101626579=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101626580=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1101626581=RETURNS ('
      '1101626582=  ERR_CODE INTEGER,'
      '1101626583=  ERR_MSG VARCHAR(1024))'
      '1101626584=AS'
      '1101626585=/*'
      
        '1101626586='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1101626587='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1101626588='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1101626589=*/'
      
        '1101626590=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1101626591=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101626592=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1101626593=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1101626594=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1101626595=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1101626596=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1101626597=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1101626598=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1101626599=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101626600=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1101626601=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1101626602=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1101626603=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1101626604=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101626605=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101626606=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101626607=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101626608=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1101626609=BEGIN'
      '1101626610='
      '1101626611=  PNT_ = '#39'00'#39';'
      '1101626612=  CLRF = ascii_char( 10 );'
      '1101626613='
      '1101626614=  SELECT S.S_VALUE'
      '1101626615=    FROM SYSTEM_SETUP S'
      '1101626616=   WHERE S.SYSTEM_SETUP = 2'
      '1101626617=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1101626618='
      '1101626619=  PNT_ = '#39'01'#39';'
      '1101626620=  SELECT G.nds_value'
      '1101626621=    FROM G_FIRM_REKVIZIT G'
      '1101626622=   WHERE G.is_default = 1'
      '1101626623=    INTO :NDS_;'
      '1101626624='
      '1101626625=  PNT_ = '#39'02'#39';'
      
        '1101626626=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1101626627=        FROM IMPORT_TBL_TMP'
      
        '1101626628=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1101626629=  DO BEGIN'
      '1101626630=    SELECT G_PRODUCT,'
      '1101626631=           PRICE'
      '1101626632=      FROM ('
      '1101626633=            SELECT P.G_PRODUCT, P.price'
      '1101626634=              FROM G_PRODUCT P'
      
        '1101626635=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1101626636=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1101626637=            UNION'
      '1101626638=            SELECT LT.G_PRODUCT, P.PRICE'
      '1101626639=              FROM LT_BARCODE LT, g_product P'
      
        '1101626640=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1101626641=               AND LT.g_product = P.g_product'
      '1101626642=           )'
      '1101626643=      INTO :G_PRODUCT_,'
      '1101626644=           :PRICE_OUR_;'
      '1101626645='
      '1101626646=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1101626647=      ERR_CODE = -20500;'
      
        '1101626648=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1101626649=      Exit;'
      '1101626650=    END'
      '1101626651='
      '1101626652=    PNT_ = '#39'03'#39';'
      
        '1101626653=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1101626654=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1101626655=      RETURNING_VALUES :COST_PRICE_;'
      '1101626656='
      '1101626657=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1101626658=    IF (price_ IS NULL) THEN'
      '1101626659=      PRICE_ = PRICE_OUR_;'
      '1101626660='
      '1101626661=    PNT_ = '#39'04'#39';'
      
        '1101626662=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1101626663=                                              :AMOUNT' +
        '_,'
      
        '1101626664=                                              :PRICE_' +
        ','
      
        '1101626665=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1101626666=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1101626667=                                              :DISCOU' +
        'NT_,'
      
        '1101626668=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1101626669=                                              :NDS_,'
      
        '1101626670=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1101626671=                                              :COST_P' +
        'RICE_,'
      
        '1101626672=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1101626673=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1101626674=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1101626675=                                              0     -' +
        '-MODE_'
      
        '1101626676=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1101626677=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101626678=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101626679=      EXIT;'
      '1101626680=    END'
      '1101626681='
      '1101626682=    G_PRODUCT_ = NULL;'
      '1101626683=  END'
      '1101626684='
      '1101626685=  PNT_ = '#39'05'#39';'
      '1101626686=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1101626687=    SELECT SUM(T.summ)'
      '1101626688=      FROM ZAKAZ_DETAILS_TMP T'
      '1101626689=      INTO :SUMM_;'
      '1101626690=    SUMM_FACT_ = SUMM_;'
      '1101626691=  END'
      '1101626692='
      '1101626693=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1101626694=  if (G_PAYMENT_TYPE_ = 1) then'
      '1101626695=    SUMM_CASH_ = summ_fact_;'
      '1101626696=  ELSE'
      '1101626697=    SUMM_NONCASH_ = summ_fact_;'
      '1101626698='
      '1101626699=  PNT_ = '#39'06'#39';'
      '1101626700=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1101626701=    G_CLIENT_ = 10;'
      '1101626702='
      '1101626703=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101626704=                              :Z_DATE_,'
      '1101626705=                              :Z_TIME_,'
      '1101626706=                              :G_CLIENT_,'
      '1101626707=                              :G_PAYMENT_TYPE_,'
      '1101626708=                              '#39#39', --:OSNOVANIE_,'
      '1101626709=                              0,  -- IS_SPISANIE'
      
        '1101626710=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1101626711=                              :SUMM_,'
      '1101626712=                              :SUMM_FACT_,'
      '1101626713=                              :SUMM_CASH_,'
      '1101626714=                              :SUMM_NONCASH_,'
      
        '1101626715=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1101626716=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1101626717=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1101626718=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1101626719=                              0,    -- :BY_RECIPE__,'
      '1101626720=                              0,    -- IS_RESERVE__'
      '1101626721=                              NULL -- :PAYMENTS__'
      '1101626722=                              )'
      
        '1101626723=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101626724=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101626725=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1101626726=    EXIT;'
      '1101626727=  END'
      '1101626728='
      '1101626729=  DELETE FROM import_tbl_tmp;'
      '1101626730='
      '1101626731=WHEN ANY DO BEGIN'
      '1101626732=    ERR_CODE = gdscode;'
      
        '1101626733=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1101626734=  END'
      '1101626735=end'
      '1101626736=;'
      '1101626737='
      '1101626738=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '1101626739=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT,'
      '1101626740=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1101626741=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1101626742=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1101626743=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1101626744=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1101626745=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1101626746=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101626747=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101626748=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ','
      '1101626749=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1101626750=  IS_SPISANIE_ INTEGER,'
      '1101626751=  NEW_LINE_SALE_ INTEGER = 0,'
      '1101626752=  MODE_ INTEGER = 0,'
      '1101626753=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '1101626754=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '1101626755=  MARK_CODE_ VARCHAR(100) = '#39#39')'
      '1101626756=RETURNS ('
      
        '1101626757=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1101626758=  ERR_CODE INTEGER,'
      '1101626759=  ERR_MSG VARCHAR(1024))'
      '1101626760=AS'
      '1101626761=/*'
      
        '1101626762=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063 +
        #1048#1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '1101626763=*/'
      
        '1101626764=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39';'
      '1101626765=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '1101626766=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0;'
      
        '1101626767=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0;'
      
        '1101626768=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1101626769=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1101626770=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '1101626771=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      
        '1101626772=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.PRICE;'
      
        '1101626773=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.COST_PRICE;'
      
        '1101626774=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '1101626775=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1101626776=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040 +
        #1041#1051#1048#1062#1045' */'
      
        '1101626777=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058 +
        ' '#1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '1101626778=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101626779=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '1101626780=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '1101626781=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUM' +
        'N G_PRODUCT.G_PRODUCT;'
      '1101626782=BEGIN'
      '1101626783=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '1101626784='
      
        '1101626785=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071 +
        #1070#1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '1101626786=  SELECT T.ZAKAZ, T.Z_TYPE'
      '1101626787=    FROM ZAKAZ_DETAILS_TMP T'
      '1101626788=   WHERE T.ZAKAZ IS NOT NULL'
      
        '1101626789=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' ' +
        #1089#1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082 +
        #1072' MULTIPLE ROWS IN SINGLETON SELECT'
      '1101626790=    INTO :ZAKAZ_, :Z_TYPE_;'
      '1101626791='
      
        '1101626792=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045 +
        #1051#1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101626793=           ,G.IS_KIT'
      '1101626794=           ,K.AMOUNT * :AMOUNT_'
      '1101626795=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '1101626796=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PR' +
        'ICE)'
      '1101626797=           ,(CASE'
      
        '1101626798=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANI' +
        'E_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT *' +
        ' FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '1101626799=             ELSE K.PRICE'
      '1101626800=           END) COST_PRICE'
      
        '1101626801=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_' +
        'LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '1101626802=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE' +
        ' G_PRODUCT = :G_PRODUCT_) CNT'
      
        '1101626803=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT ' +
        'K ON G.G_PRODUCT = K.G_PRODUCT'
      '1101626804=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101626805=       AND G.IS_KIT = 1'
      '1101626806=    UNION'
      
        '1101626807=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056 +
        #1054#1044#1040#1046
      '1101626808=           ,G.IS_KIT'
      '1101626809=           ,:AMOUNT_'
      '1101626810=           ,:PRICE_'
      '1101626811=           ,0'
      '1101626812=           ,:COST_PRICE_'
      '1101626813=           ,0'
      '1101626814=      FROM G_PRODUCT G'
      '1101626815=     WHERE G_PRODUCT = :G_PRODUCT_'
      '1101626816=       AND G.IS_KIT <> 1'
      '1101626817=      INTO :G_PRODUCT_'
      '1101626818=           ,:IS_KIT_'
      '1101626819=           ,:AMOUNT_'
      '1101626820=           ,:PRICE__'
      '1101626821=           ,:SOSTAV_PRICE_'
      '1101626822=           ,:COST_PRICE__'
      '1101626823=           ,:SOSTAV_COUNT_'
      '1101626824=  DO BEGIN'
      '1101626825=      ZAKAZ_DTLS_TMP_ = NULL;'
      '1101626826='
      
        '1101626827=      --=============================================' +
        '=============='
      '1101626828=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101626829=      SELECT AMOUNT - AMOUNT_RESERVE'
      '1101626830=        FROM LT_SKLAD_PRODUCT L'
      '1101626831=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '1101626832=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101626833=       INTO :AMOUNT_CUR_;'
      '1101626834='
      
        '1101626835=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1101626836=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1101626837=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1101626838=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1101626839=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1101626840=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '1101626841=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1101626842=          SELECT SUM(AMOUNT)'
      '1101626843=            FROM ZAKAZ_DETAILS T'
      '1101626844=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101626845=             AND T.ZAKAZ = :ZAKAZ_'
      '1101626846=            INTO :AMOUNT_OLD_;'
      '1101626847=        ELSE'
      '1101626848=          SELECT SUM(AMOUNT)'
      '1101626849=            FROM SKLAD T'
      '1101626850=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101626851=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1101626852=            INTO :AMOUNT_OLD_;'
      '1101626853=      END'
      '1101626854='
      '1101626855=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1101626856=      SELECT SUM(AMOUNT)'
      '1101626857=        FROM ZAKAZ_DETAILS_TMP T'
      '1101626858=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1101626859=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1101626860='
      
        '1101626861=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_,' +
        ' 0) + :AMOUNT_;'
      '1101626862=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '1101626863='
      
        '1101626864=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042 +
        ' '#1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1101626865='
      
        '1101626866=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1101626867=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047 +
        #1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1101626868=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) ' +
        'THEN BEGIN'
      '1101626869=            PNT_ = '#39'01'#39';'
      
        '1101626870=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID F' +
        'ROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101626871=                                         CURRENT_DATE' +
        ','
      '1101626872=                                         :G_PRODUCT_,'
      
        '1101626873=                                         ABS(AMOUNT_C' +
        'UR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOU' +
        'NT_,'
      
        '1101626874=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074 +
        #1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1101626875=                                         )'
      
        '1101626876=                RETURNING_VALUES :SKLAD_, :COST_PRICE' +
        '__, :ERR_CODE, :ERR_MSG;'
      '1101626877=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101626878=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101626879=              EXIT;'
      '1101626880=            END'
      '1101626881=        END'
      
        '1101626882=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_P' +
        'RODUCT_ <> -2) THEN BEGIN'
      '1101626883=            SELECT NAME'
      '1101626884=            FROM G_PRODUCT'
      '1101626885=            WHERE G_PRODUCT = :G_PRODUCT_'
      '1101626886=            INTO :PRODUCT_NAME_;'
      '1101626887='
      '1101626888=            ERR_CODE = -20500;'
      
        '1101626889=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_' +
        'NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1101626890=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1101626891=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1101626892=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1101626893=            EXIT;'
      '1101626894=        END'
      '1101626895=      END'
      '1101626896=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1101626897=      --=============================================' +
        '=============='
      '1101626898='
      
        '1101626899=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077 +
        #1090#1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087 +
        #1083#1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '1101626900=      IF (IS_KIT_ = 1) THEN BEGIN'
      '1101626901='
      '1101626902=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '1101626903=        --    PRICE__ = SOSTAV_PRICE_;'
      '1101626904=        --END ELSE BEGIN'
      '1101626905=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '1101626906=              PRICE__ = COST_PRICE__;'
      '1101626907='
      
        '1101626908=            END ELSE IF (Discount_perc_ <> 0) THEN BE' +
        'GIN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '1101626909=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PE' +
        'RC_/100;'
      '1101626910='
      '1101626911='
      
        '1101626912=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THE' +
        'N BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '1101626913=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / S' +
        'OSTAV_PRICE_;'
      
        '1101626914=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE' +
        '_;'
      '1101626915=            END'
      '1101626916='
      
        '1101626917=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUN' +
        'T_;'
      
        '1101626918=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMO' +
        'UNT_;'
      '1101626919=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '1101626920=        --END'
      '1101626921=      END'
      '1101626922='
      
        '1101626923=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' ' +
        #1045#1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '1101626924=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041 +
        #1048#1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '1101626925=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_COD' +
        'E_) = 0) THEN'
      '1101626926=          SELECT ZD.zakaz_details'
      '1101626927=            FROM zakaz_details_tmp ZD'
      '1101626928=           WHERE ZD.G_PRODUCT = :g_product_'
      '1101626929=             AND ZD.PRICE = :PRICE__'
      '1101626930=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '1101626931=            INTO :ZAKAZ_DTLS_TMP_;'
      '1101626932='
      '1101626933='
      '1101626934=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '1101626935=        UPDATE ZAKAZ_DETAILS_TMP P'
      '1101626936=           SET P.amount = P.amount + :amount_'
      
        '1101626937=               ,P.summ = (P.price - P.discount_TENGE)' +
        ' * (P.amount + :AMOUNT_)'
      
        '1101626938=               ,P.discount_summ = P.discount_TENGE * ' +
        '(P.amount + :AMOUNT_)'
      '1101626939=               ,P.NDS = :NDS_'
      '1101626940=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '1101626941=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '1101626942='
      '1101626943=      ELSE BEGIN'
      
        '1101626944=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN' +
        ' BEGIN'
      
        '1101626945=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_' +
        ';'
      '1101626946=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '1101626947=          END'
      '1101626948='
      '1101626949=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '1101626950=          ('
      '1101626951=           ZAKAZ_DETAILS,'
      '1101626952=           ZAKAZ,'
      '1101626953=           G_PRODUCT,'
      '1101626954=           AMOUNT,'
      '1101626955=           PRICE,'
      '1101626956=           SUMM,'
      '1101626957=           DISCOUNT_PERC,'
      '1101626958=           DISCOUNT_TENGE,'
      '1101626959=           DISCOUNT_SUMM,'
      '1101626960=           NDS,'
      '1101626961=           NDS_SUMM,'
      '1101626962=           COST_PRICE,'
      '1101626963=           MARK_CODE,'
      '1101626964=           ORIGINAL_KIT_ID,'
      '1101626965=           ORIGINAL_KIT_PRICE'
      '1101626966=          ) VALUES ('
      '1101626967=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101626968=           :ZAKAZ_,'
      '1101626969=           :G_PRODUCT_,'
      '1101626970=           :AMOUNT_,'
      '1101626971=           :PRICE__,'
      '1101626972=           :SUMM_,'
      '1101626973=           :DISCOUNT_PERC_,'
      '1101626974=           :DISCOUNT_TENGE_,'
      '1101626975=           :DISCOUNT_SUMM_,'
      '1101626976=           :NDS_,'
      '1101626977=           :NDS_SUMM_,'
      '1101626978=           :COST_PRICE__,'
      '1101626979=           :MARK_CODE_,'
      '1101626980=           :ORIGINAL_KIT_ID_,'
      '1101626981=           :ORIGINAL_KIT_PRICE_'
      '1101626982=          )'
      '1101626983=          RETURNING'
      '1101626984=            ZAKAZ_DETAILS'
      '1101626985=          INTO'
      '1101626986=            :ZAKAZ_DETAILS_;'
      '1101626987=      END'
      '1101626988=  END'
      '1101626989=end'
      '1101626990=;'
      '1101626991='
      '1101626992=ALTER PROCEDURE P_REP_ZAYAVKA_POSTAVSHIK('
      '1101626993=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101626994=  BEGIN_DATE_ DATE,'
      '1101626995=  END_DATE_ DATE,'
      '1101626996=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101626997=  DO_SKLAD_ INTEGER,'
      '1101626998=  MODE_ INTEGER,'
      '1101626999=  MODE_VYBOR_ INTEGER,'
      '1101627000=  MODE_VAL_ INTEGER,'
      '1101627001=  NEW_VAL_ MY_NUMERIC_5,'
      '1101627002=  ROUND_MODE_ INTEGER)'
      '1101627003=RETURNS ('
      '1101627004=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101627005=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '1101627006=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101627007=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101627008=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101627009=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1101627010=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1101627011=  ERR_CODE INTEGER,'
      '1101627012=  ERR_MSG VARCHAR(1024))'
      '1101627013=AS'
      '1101627014=/*'
      
        '1101627015='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057 +
        #1056#1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '1101627016='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055 +
        #1054#1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '1101627017=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055 +
        #1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '1101627018=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 -' +
        ' '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '1101627019=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058 +
        #1054#1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045 +
        ' '#1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101627020=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '1101627021=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067 +
        #1042#1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      
        '1101627022=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' *' +
        '/'
      '1101627023=DECLARE VARIABLE ROUND_ INTEGER;'
      '1101627024=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '1101627025=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      
        '1101627026=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PA' +
        'RENT;'
      '1101627027=BEGIN'
      '1101627028=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101627029='
      '1101627030=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101627031=    SELECT ID'
      '1101627032=      FROM CUR_PARAMS'
      '1101627033=     WHERE CUR_PARAMS = 2'
      '1101627034=      INTO :G_TOCHKA_;'
      '1101627035='
      '1101627036=  IF (ROUND_MODE_ = 0) THEN'
      '1101627037=      ROUND_ = 0;'
      '1101627038=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '1101627039=      ROUND_ = -1;'
      '1101627040=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '1101627041=      ROUND_ = -2;'
      '1101627042=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '1101627043=      ROUND_ = -3;'
      '1101627044=  ELSE IF (ROUND_MODE_ = -1) THEN'
      '1101627045=      ROUND_ = 5;'
      '1101627046='
      
        '1101627047=  SQL_STR_ = '#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39';'
      '1101627048='
      
        '1101627049=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040 +
        ' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101627050=  IF (MODE_ = 0) THEN BEGIN'
      
        '1101627051=    SQL_STR_ = SQL_STR_ || '#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39';'
      '1101627052=    IF (MODE_VAL_ = 0) THEN'
      '1101627053=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1101627054=    ELSE'
      
        '1101627055=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1101627056='
      '1101627057=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1101627058=  END'
      '1101627059=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '1101627060=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '1101627061=    SQL_STR_ = SQL_STR_ || '#39'ROUND(ABS(LT.AMOUNT)'#39';'
      '1101627062=    IF (MODE_VAL_ = 0) THEN'
      '1101627063=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1101627064=    ELSE'
      
        '1101627065=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1101627066='
      '1101627067=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1101627068=  END'
      '1101627069='
      
        '1101627070=  SQL_STR_ = SQL_STR_ || '#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39'||'
      
        '1101627071=            '#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39';'
      '1101627072='
      '1101627073=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '1101627074=    SQL_STR_ = SQL_STR_ ||'#39'AND EXISTS (SELECT 1'#39'||'
      
        '1101627075=                                        '#39' FROM SKLAD ' +
        'S'#39'||'
      
        '1101627076=                                        '#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39'||'
      
        '1101627077=                                        '#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39'||'
      
        '1101627078=                                        '#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39';'
      '1101627079=    IF (MODE_VYBOR_ = 2) THEN'
      
        '1101627080=      SQL_STR_ = SQL_STR_ ||'#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39';'
      '1101627081=    ELSE'
      
        '1101627082=      SQL_STR_ = SQL_STR_ ||'#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053 +
        #1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042#1057 +
        #1045#1043#1044#1040
      '1101627083=    SQL_STR_ = SQL_STR_ ||'#39') '#39';'
      '1101627084=  END ELSE BEGIN'
      
        '1101627085=    SQL_STR_ = SQL_STR_ ||'#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39';  --' +
        ' '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '1101627086=  END'
      '1101627087='
      '1101627088=  IF (MODE_ = 0) THEN'
      
        '1101627089=    SQL_STR_ = SQL_STR_ || '#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39';'
      '1101627090=  ELSE IF (MODE_ = 1) THEN'
      '1101627091=    SQL_STR_ = SQL_STR_ || '#39' AND LT.AMOUNT < 0'#39';'
      
        '1101627092=  SQL_STR_ = SQL_STR_ || '#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39';'
      '1101627093='
      '1101627094=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '1101627095=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '1101627096=      FOR EXECUTE STATEMENT'
      
        '1101627097=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1101627098=          INTO :G_PRODUCT,'
      '1101627099=               :CATEGORY_NAME,'
      '1101627100=               :NAME,'
      '1101627101=               :ARTICUL,'
      '1101627102=               :AMOUNT_CUR,'
      '1101627103=               :MIN_AMOUNT,'
      '1101627104=               :AMOUNT_TO_ZAKAZ'
      '1101627105=        DO BEGIN'
      
        '1101627106=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_' +
        'PRODUCT, :G_TOCHKA_, 0)'
      '1101627107=              RETURNING_VALUES :COST_PRICE_;'
      '1101627108='
      
        '1101627109=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, ' +
        'AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101627110=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_' +
        'PRODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO' +
        '_ZAKAZ, 0, 0);'
      '1101627111=        END'
      '1101627112='
      '1101627113=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101627114=                                      CURRENT_DATE,'
      '1101627115=                                      CURRENT_TIME,'
      '1101627116=                                      :G_CLIENT_,'
      '1101627117=                                      1,'
      
        '1101627118=                                      NULL, --:OSNOVA' +
        'NIE__,'
      
        '1101627119=                                      NULL, --:NOTE__' +
        ','
      
        '1101627120=                                      0, --:IS_VOZVRA' +
        'T_,'
      
        '1101627121=                                      (SELECT SUM(S.S' +
        'UMM) FROM SKLAD_TMP S),'
      
        '1101627122=                                      0, -- :SUMM_FAC' +
        'T_'
      
        '1101627123=                                      0, --:G_PRIHOD_' +
        ','
      
        '1101627124=                                      0 --:SUMM_PRIHO' +
        'D_)'
      
        '1101627125=                                      ,NULL --PAYMENT' +
        'S'
      
        '1101627126=                                     )RETURNING_VALUE' +
        'S :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1101627127=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101627128=          ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39'||ERR_MSG;'
      '1101627129=          EXIT;'
      '1101627130=        END'
      '1101627131=  END'
      '1101627132=  ELSE BEGIN'
      '1101627133=      FOR EXECUTE STATEMENT'
      
        '1101627134=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1101627135=      INTO :G_PRODUCT,'
      '1101627136=           :CATEGORY_NAME,'
      '1101627137=           :NAME,'
      '1101627138=           :ARTICUL,'
      '1101627139=           :AMOUNT_CUR,'
      '1101627140=           :MIN_AMOUNT,'
      '1101627141=           :AMOUNT_TO_ZAKAZ'
      '1101627142=      DO SUSPEND;'
      '1101627143=  END'
      '1101627144=END'
      '1101627145=;'
      '1101627146='
      '1101627147=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1101627148=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101627149=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101627150=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101627151=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101627152=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101627153=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101627154=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101627155=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101627156=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101627157=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101627158=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101627159=RETURNS ('
      '1101627160=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101627161=  ERR_CODE INTEGER,'
      '1101627162=  ERR_MSG VARCHAR(1024))'
      '1101627163=AS'
      
        '1101627164=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1101627165=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1101627166=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1101627167=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1101627168='
      
        '1101627169=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101627170=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1101627171=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1101627172=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101627173=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101627174=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101627175=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1101627176=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1101627177=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1101627178=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1101627179=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101627180=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101627181=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1101627182=BEGIN'
      '1101627183='
      '1101627184=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101627185=    SELECT ID'
      '1101627186=      FROM CUR_PARAMS'
      '1101627187=     WHERE CUR_PARAMS = 2'
      '1101627188=      INTO :G_TOCHKA_;'
      '1101627189='
      
        '1101627190=  --*************************************************' +
        '*************************************************'
      
        '1101627191=  --*************************************************' +
        '*************************************************'
      '1101627192=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101627193=  --*************************************************' +
        '*************************************************'
      
        '1101627194=  --*************************************************' +
        '*************************************************'
      '1101627195=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1101627196=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1101627197=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1101627198=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101627199=            INTO :AMOUNT_,'
      '1101627200=                 :G_PRODUCT_'
      '1101627201=      DO BEGIN'
      '1101627202=          UPDATE LT_SKLAD_PRODUCT L'
      '1101627203=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101627204=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101627205=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101627206=      END'
      '1101627207='
      '1101627208=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1101627209=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1101627210=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1101627211=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1101627212=             NDS_SUMM, COST_PRICE'
      '1101627213=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101627214='
      '1101627215=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101627216=                                  :Z_DATE_,'
      '1101627217=                                  :Z_TIME_,'
      '1101627218=                                  :G_CLIENT_,'
      '1101627219=                                  :G_PAYMENT_TYPE_,'
      '1101627220=                                  :OSNOVANIE_,'
      
        '1101627221=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1101627222=                                  :NOTE_,'
      
        '1101627223=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1101627224=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1101627225=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1101627226=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1101627227=                                  0, --SUMM_BONUS_'
      
        '1101627228=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1101627229=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101627230=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1101627231=                                  0,    --BY_RECIPE'
      '1101627232=                                  0     --IS_RESERVE'
      '1101627233=                                  ,NULL  -- PAYMENTS_'
      '1101627234=                                  ,0     --IS_MEBEL_'
      
        '1101627235=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1101627236=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1101627237=                                  ,NULL  --ADDRESS_'
      '1101627238=                                  ,NULL  --PRICE_'
      '1101627239=                                  ,UPLOAD_TO_EXT_APP_'
      '1101627240=                                  )'
      '1101627241=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1101627242='
      '1101627243=      if (ERR_CODE <> 0) then BEGIN'
      '1101627244=        ERR_CODE = -20500;'
      '1101627245=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101627246=        Exit;'
      '1101627247=      END'
      '1101627248='
      
        '1101627249=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101627250=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1101627251=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1101627252=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1101627253=      UPDATE ZAKAZ'
      '1101627254=         SET IS_SPISANIE = 2'
      '1101627255=       WHERE ZAKAZ = :ZAKAZ_;'
      '1101627256='
      
        '1101627257=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101627258=      FOR SELECT T.AMOUNT,'
      '1101627259=                 T.SUMM,'
      '1101627260=                 T.G_PRODUCT,'
      '1101627261=                 T.ZAKAZ_NA_REAL,'
      '1101627262=                 T.ZAKAZ_DETAILS'
      '1101627263=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101627264=            INTO :AMOUNT_,'
      '1101627265=                 :Z_SUMM_,'
      '1101627266=                 :G_PRODUCT_,'
      '1101627267=                 :ZAKAZ_NA_REAL_,'
      '1101627268=                 :ZAKAZ_DETAILS_'
      '1101627269=      DO BEGIN'
      '1101627270=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101627271=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1101627272=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1101627273=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101627274=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101627275='
      
        '1101627276=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101627277=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1101627278=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1101627279=      END'
      '1101627280=  END'
      '1101627281=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101627282=  --*************************************************' +
        '*************************************************'
      
        '1101627283=  --*************************************************' +
        '*************************************************'
      '1101627284='
      
        '1101627285=  --*************************************************' +
        '*************************************************'
      
        '1101627286=  --*************************************************' +
        '*************************************************'
      '1101627287=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101627288=  --*************************************************' +
        '*************************************************'
      
        '1101627289=  --*************************************************' +
        '*************************************************'
      '1101627290=  ELSE BEGIN'
      '1101627291=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1101627292=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101627293=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101627294=      FOR SELECT T.AMOUNT,'
      '1101627295=                 T.SUMM,'
      '1101627296=                 T.G_PRODUCT,'
      '1101627297=                 T.ZAKAZ_NA_REAL,'
      '1101627298=                 T.ZAKAZ_DETAILS'
      '1101627299=                 ,T.PRICE'
      '1101627300=                 ,T.NDS'
      '1101627301=                 ,T.NDS_SUMM'
      '1101627302=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101627303=            INTO :AMOUNT_,'
      '1101627304=                 :Z_SUMM_,'
      '1101627305=                 :G_PRODUCT_,'
      '1101627306=                 :ZAKAZ_NA_REAL_,'
      '1101627307=                 :ZAKAZ_DETAILS_'
      '1101627308=                 ,:PRICE_'
      '1101627309=                 ,:NDS_'
      '1101627310=                 ,:NDS_SUMM_'
      '1101627311=      DO BEGIN'
      
        '1101627312=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101627313=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1101627314='
      
        '1101627315=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1101627316=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1101627317='
      '1101627318=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101627319=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1101627320=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1101627321=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101627322=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101627323=      END'
      '1101627324='
      '1101627325=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101627326=                                  :Z_DATE_,'
      '1101627327=                                  :Z_TIME_,'
      '1101627328=                                  :G_CLIENT_,'
      '1101627329=                                  :G_PAYMENT_TYPE_,'
      '1101627330=                                  :OSNOVANIE_,'
      '1101627331=                                  :NOTE_,'
      
        '1101627332=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1101627333=                                  :SUMM_,'
      '1101627334=                                  :SUMM_FACT_,'
      
        '1101627335=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1101627336=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1101627337=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1101627338=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1101627339='
      '1101627340=      if (ERR_CODE <> 0) then BEGIN'
      '1101627341=        ERR_CODE = -20500;'
      '1101627342=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101627343=        Exit;'
      '1101627344=      END'
      '1101627345=  END'
      '1101627346=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101627347=  --*************************************************' +
        '*************************************************'
      
        '1101627348=  --*************************************************' +
        '*************************************************'
      '1101627349='
      '1101627350=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101627351=END'
      '1101627352=;'
      '1101627353='
      '1101627354=ALTER PROCEDURE R_UNIFICATION('
      '1101627355=  MODE_ INTEGER)'
      '1101627356=RETURNS ('
      '1101627357=  COUNT_SPIS_ INTEGER,'
      '1101627358=  COUNT_PRIH_ INTEGER,'
      '1101627359=  ERR_CODE INTEGER,'
      '1101627360=  ERR_MSG VARCHAR(1024))'
      '1101627361=AS'
      
        '1101627362=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1101627363=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101627364=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1101627365=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1101627366=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1101627367=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1101627368=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1101627369=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101627370=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1101627371=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101627372=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101627373=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101627374=BEGIN'
      '1101627375='
      '1101627376=  COUNT_SPIS_ = 0;'
      '1101627377=  COUNT_PRIH_ = 0;'
      '1101627378='
      '1101627379=  SELECT ID'
      '1101627380=    FROM CUR_PARAMS'
      '1101627381=   WHERE CUR_PARAMS = 2'
      '1101627382=    INTO :G_TOCHKA_;'
      '1101627383='
      
        '1101627384=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1101627385=      FROM REVISION'
      '1101627386=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1101627387=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1101627388=  DO BEGIN'
      
        '1101627389=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1101627390=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1101627391=        RETURNING_VALUES :COST_PRICE_;'
      '1101627392='
      
        '1101627393=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1101627394=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1101627395=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1101627396='
      '1101627397=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1101627398=    END'
      '1101627399='
      
        '1101627400=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1101627401=      SELECT S.price'
      '1101627402=        FROM SKLAD S'
      '1101627403=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1101627404=         AND S.g_product = :G_PRODUCT_'
      '1101627405=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1101627406=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1101627407=                                 FROM SKLAD DD'
      
        '1101627408=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1101627409=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1101627410=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1101627411=                                )'
      '1101627412=        ORDER BY s.sklad DESC'
      '1101627413=        ROWS 1 TO 1'
      '1101627414=        INTO :PRICE_LAST_;'
      '1101627415='
      '1101627416=    /* SELECT S.PRICE'
      '1101627417=        FROM SKLAD S'
      '1101627418=       WHERE S.IS_LAST = 1'
      '1101627419=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1101627420=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1101627421=        INTO :PRICE_LAST_; */'
      '1101627422='
      
        '1101627423=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1101627424='
      
        '1101627425=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101627426=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1101627427='
      '1101627428=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1101627429=    END'
      '1101627430='
      '1101627431=    UPDATE REVISION R'
      '1101627432=       SET R.IS_UNIFIED = 1'
      '1101627433=     WHERE R.REVISION = :REVISION_;'
      '1101627434=  END'
      '1101627435='
      '1101627436=  PNT_ = '#39'01'#39';'
      '1101627437=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1101627438=    SELECT SUM(S.SUMM)'
      '1101627439=      FROM ZAKAZ_DETAILS_TMP S'
      '1101627440=      INTO :SUMM_;'
      '1101627441='
      '1101627442=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1101627443=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1101627444=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1101627445=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1101627446=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1101627447=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1101627448=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1101627449=                                NULL,           --:NO' +
        'TE_,'
      
        '1101627450=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1101627451=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1101627452=                                0,              --SUM' +
        'M_BONUS_'
      
        '1101627453=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1101627454=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1101627455=                                NULL,'
      
        '1101627456=                                0,        -- BY_RECIP' +
        'E'
      
        '1101627457=                                0         -- IS_RESER' +
        'VE'
      '1101627458=                                ,NULL  -- PAYMENTS_'
      '1101627459=                                ,0     -- SUMM_CASH'
      
        '1101627460=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1101627461=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1101627462=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101627463=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101627464=      EXIT;'
      '1101627465=    END'
      '1101627466=  END'
      '1101627467='
      '1101627468=  PNT_ = '#39'02'#39';'
      '1101627469=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1101627470=    SELECT SUM(S.SUMM)'
      '1101627471=      FROM SKLAD_TMP S'
      '1101627472=      INTO :SUMM_;'
      '1101627473='
      '1101627474=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1101627475=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1101627476=                                CURRENT_TIME,'
      
        '1101627477=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1101627478=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1101627479=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1101627480=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1101627481=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1101627482=                                :SUMM_,'
      '1101627483=                                :SUMM_,'
      
        '1101627484=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1101627485=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1101627486=                                ,NULL  --PAYMENTS'
      '1101627487=                                )'
      
        '1101627488=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1101627489=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101627490=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101627491=      EXIT;'
      '1101627492=    END'
      '1101627493=  END'
      '1101627494=END'
      '1101627495=;'
      '1101627496='
      '1101627497=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL_REAL('
      '1101627498=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101627499=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101627500=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101627501=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101627502=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101627503=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101627504=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101627505=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101627506=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101627507=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT)'
      '1101627508=RETURNS ('
      '1101627509=  ERR_CODE INTEGER,'
      '1101627510=  ERR_MSG VARCHAR(1024))'
      '1101627511=AS'
      '1101627512=/*'
      
        '1101627513='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'-'#1054#1055#1051#1040#1058#1059' '#1047 +
        #1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051
      '1101627514='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1060#1054#1056#1052#1045' TOplataTovaraRealNForm'
      '1101627515='
      
        '1101627516=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1040#1055#1044#1045#1049#1058' '#1042#1054#1047#1042#1056#1040#1058#1040' ' +
        #1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101627517=*/'
      
        '1101627518=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL_REAL'#39';'
      '1101627519=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101627520=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101627521=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101627522=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1101627523=DECLARE VARIABLE Z_G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.G_PRODUCT;'
      
        '1101627524=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1101627525=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '1101627526=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      '1101627527=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101627528=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101627529=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      
        '1101627530=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1101627531=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101627532=BEGIN'
      
        '1101627533=  --*************************************************' +
        '*************************************************'
      
        '1101627534=  --*************************************************' +
        '*************************************************'
      '1101627535=  --  '#1040#1055#1044#1045#1049#1058' '#1054#1041#1067#1063#1053#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1047#1040' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101627536=  --*************************************************' +
        '*************************************************'
      
        '1101627537=  --*************************************************' +
        '*************************************************'
      '1101627538=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101627539=      SELECT Z.G_PAYMENT_TYPE'
      '1101627540=        FROM ZAKAZ Z'
      '1101627541=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101627542=        INTO :G_PAYMENT_TYPE_OLD_;'
      '1101627543='
      '1101627544=      PNT_ = '#39'01a'#39';'
      '1101627545=      UPDATE zakaz'
      '1101627546=      SET'
      '1101627547=       Z_DATE = :Z_DATE_,'
      '1101627548=       Z_TIME = :Z_TIME_,'
      '1101627549=       G_CLIENT = :G_CLIENT_,'
      '1101627550=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101627551=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101627552=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1101627553=       SUMM = :SUMM_,'
      '1101627554=       SUMM_FACT = :SUMM_FACT_,'
      
        '1101627555=       SUMM_CASH = DECODE(:G_PAYMENT_TYPE_, 1, :SUMM_' +
        'FACT_, 0),'
      
        '1101627556=       SUMM_NONCASH = DECODE(:G_PAYMENT_TYPE_, 2, :SU' +
        'MM_FACT_, 0)'
      '1101627557=      WHERE'
      '1101627558=        zakaz = :zakaz_;'
      '1101627559='
      '1101627560=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101627561=      PNT_ = '#39'02a'#39';'
      
        '1101627562=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101627563=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101627564=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101627565=        EXIT;'
      '1101627566=      END'
      '1101627567='
      '1101627568=      PNT_ = '#39'03a'#39';'
      '1101627569=      DELETE from zakaz_DETAILS z'
      '1101627570=      WHERE z.zakaz = :zakaz_;'
      '1101627571=      FOR SELECT G_PRODUCT,'
      '1101627572=                 AMOUNT,'
      '1101627573=                 SUMM,'
      '1101627574=                 ZAKAZ_NA_REAL,'
      '1101627575=                 ZAKAZ_DETAILS'
      '1101627576=            FROM ZAKAZ_DETAILS_TMP_REAL'
      '1101627577=      INTO :Z_G_PRODUCT_,'
      '1101627578=           :Z_AMOUNT_,'
      '1101627579=           :Z_SUMM_,'
      '1101627580=           :ZAKAZ_NA_REAL_,'
      '1101627581=           :ZAKAZ_DETAILS_'
      '1101627582=      DO BEGIN'
      '1101627583=        PNT_ = '#39'04a'#39';'
      
        '1101627584=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E, DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '1101627585=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, ' +
        'NDS, NDS_SUMM, COST_PRICE'
      '1101627586=          FROM ZAKAZ_DETAILS_TMP_REAL Z'
      '1101627587=         WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      
        '1101627588=           AND Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;   -' +
        '-'#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1054#1043#1059#1058' '#1055#1054#1042#1058#1054#1056#1071#1058#1068#1057#1071' :ZAKAZ_NA_REAL_, '#1058#1054' '#1045#1057#1058#1068' '#1055#1054' '#1054#1044#1053#1054#1052#1059 +
        ' :ZAKAZ_NA_REAL_ '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' :ZAKAZ_DETAILS_'
      '1101627589='
      '1101627590=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101627591=        PNT_ = '#39'05a'#39';'
      '1101627592=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101627593=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :Z_A' +
        'MOUNT_,'
      
        '1101627594=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1101627595=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'ZR.AMOUNT_PAYED + :Z_AMOUNT_, 1, 0)'
      '1101627596=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101627597='
      
        '1101627598=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL, '#1053#1054' '#1058'.'#1050'. ZAKAZ_DETAILS '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1057 +
        ' ID ZAKAZ_REAL ('#1042#1067#1064#1045' '#1047#1040#1055#1054#1051#1053#1071#1045#1058#1057#1071' ZAKAZ_DETAILS_TMP),'
      
