        '11015352=  val_str1 = val_str;  -- '#1085#1091#1078#1085#1086' '#1076#1072#1083#1077#1077' '#1076#1083#1103' '#1089#1082#1083#1086#1085#1077#1085#1080#1103' '#1074#1072#1083 +
