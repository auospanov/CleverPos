        '110202293=    /*IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      '110202294=      SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE c '#39'||'
      
