      '110157328=          CURR_STR_KOP_ = '#39' '#1090#1080#1081#1080#1085#1072#39';'
      '110157329=        ELSE'
      '110157330=          CURR_STR_KOP_ = '#39' '#1090#1080#1081#1080#1085#1086#1074#39';'
      '110157331='
      '110157332=      end else if (currency = 4) then begin'
      '110157333=        if (i=1) then'
      '110157334=          CURR_STR_KOP_ = '#39' '#1090#1099#1081#1080#1085#39';'
      '110157335=        ELSE if ((i=2) or (I=3)) then'
      '110157336=          CURR_STR_KOP_ = '#39' '#1090#1099#1081#1080#1085#1072#39';'
      '110157337=        ELSE'
      '110157338=          CURR_STR_KOP_ = '#39' '#1090#1099#1081#1080#1085#1086#1074#39';'
      '110157339=      end else if (currency = 5) then begin'
      '110157340=        if (i=1) then'
      '110157341=          CURR_STR_KOP_ = '#39' '#1083#1091#1084#39';'
      '110157342=        ELSE if ((i=2) or (I=3)) then'
      '110157343=          CURR_STR_KOP_ = '#39' '#1083#1091#1084#1072#39';'
      '110157344=        ELSE'
      '110157345=          CURR_STR_KOP_ = '#39' '#1083#1091#1084#39';'
      '110157346=      end'
      '110157347='
      '110157348=    end else begin'
      '110157349=      CURR_STR_ = '#39' '#1090#1077#1085#1075#1077#39';'
      '110157350=      CURR_STR_KOP_ = '#39' '#1090#1080#1099#1085#39';'
      '110157351=    end'
      
        '110157352=      --**********************************************' +
        '**************'
      '110157353='
      
        '110157354=    curr_str = curr_str || CURR_STR_||'#39' '#39'|| cents ||CU' +
        'RR_STR_KOP_;'
      '110157355='
      
        '110157356=  end ELSE IF (Currency = -2) THEN begin   --'#1044#1051#1071' '#1044#1054#1042#1045#1056 +
        #1050#1048
      '110157357=    IF (cents = '#39'00'#39') THEN'
      '110157358=      cents = NULL;'
      '110157359=    IF (curr_str = '#39#39') THEN'
      '110157360=      curr_str = NULL;'
      '110157361=    IF (CURR_STR_ = '#39#39') THEN'
      '110157362=      CURR_STR_ = NULL;'
      '110157363='
      
        '110157364=    curr_str = COALESCE(curr_str, '#39#1085#1086#1083#1100#39') || COALESCE(' +
        'CURR_STR_, '#39#39')||COALESCE('#39' '#39'||cents, '#39#39');'
      '110157365=  end'
      '110157366='
      '110157367=  /* '#1044#1077#1083#1072#1077#1084' '#1087#1077#1088#1074#1091#1102' '#1073#1091#1082#1074#1091' '#1087#1088#1086#1087#1080#1089#1085#1086#1081' */'
      
        '110157368=  curr_str = UPPER(SUBSTRING(curr_str FROM 1 FOR 1)) |' +
        '| SUBSTRING(curr_str FROM 2);'
      '110157369='
      '110157370=  suspend;'
      '110157371=end'
      '110157372=;'
      '110157373='
      '110157374=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '110157375=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      '110157376=  IS_SUPPLIER_ INTEGER = NULL)'
      '110157377=RETURNS ('
      '110157378=  G_CLIENT TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110157379=  G_CLIENT_PARENT TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      
        '110157380=  G_CONTRAGENT TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGEN' +
        'T,'
      '110157381=  NAME VARCHAR(500),'
      '110157382=  RNN VARCHAR(12),'
      '110157383=  IDN VARCHAR(12),'
      '110157384=  KBE VARCHAR(5),'
      '110157385=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '110157386=  SKIDKA NUMERIC(15,2),'
      '110157387=  IS_SUPPLIER INTEGER,'
      '110157388=  BY_DEFAULT INTEGER,'
      '110157389=  IS_BEZNAL INTEGER,'
      '110157390=  IS_SUPPLIER_STR VARCHAR(50),'
      
        '110157391=  SUPPL_AGENT_NAME TYPE OF COLUMN G_CONTRAGENT.SHORT_N' +
        'AME,'
      
        '110157392=  G_DISCONT_CARD TYPE OF COLUMN G_DISCONT_CARD.G_DISCO' +
        'NT_CARD,'
      '110157393=  BARCODE TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110157394=  N_PERCENT TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110157395=  SUMM TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110157396=  SUMM_ALL TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110157397=  NOTE TYPE OF COLUMN G_CLIENT.NOTE,'
      '110157398=  SUMM_DOLG TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110157399=  NAME_WITH_DOLG VARCHAR(500),'
      '110157400=  G_PROMOTION_STR TYPE OF COLUMN G_PROMOTION.NAME,'
      
        '110157401=  MAX_BONUS_PAY_SUMM TYPE OF COLUMN G_CLIENT.MAX_BONUS' +
        '_PAY_SUMM)'
      '110157402=AS'
      '110157403=begin'
      '110157404=  FOR'
      '110157405=    SELECT T.g_client,'
      '110157406=           T.g_client_parent,'
      '110157407=           T.g_contragent,'
      '110157408=           T.name,'
      '110157409=           T.rnn,'
      '110157410=           T.idn,'
      '110157411=           T.KBE,'
      '110157412=           T.PHONE,'
      '110157413=           T.SKIDKA,'
      '110157414=           T.is_supplier,'
      '110157415=           T.BY_DEFAULT,'
      '110157416=           T.IS_BEZNAL,'
      '110157417=           CASE T.is_supplier'
      '110157418=             WHEN 0 THEN '#39#1050#1083#1080#1077#1085#1090#39
      '110157419=             WHEN 1 THEN '#39#1055#1086#1089#1090#1072#1074#1097#1080#1082#39
      '110157420=           END IS_SUPPLIER_STR,'
      '110157421=           GC.SHORT_NAME,'
      '110157422=           COALESCE(D.G_DISCONT_CARD, 0),'
      '110157423=           D.BARCODE,'
      '110157424=           D.N_PERCENT,'
      '110157425=           D.SUMM,'
      '110157426=           D.SUMM_ALL,'
      '110157427=           T.NOTE'
      '110157428=           ,COALESCE(Z.SUMM_DOLG, 0)'
      
        '110157429=           ,T.name || COALESCE('#39' ('#1044#1054#1051#1043' '#39' || Z.SUMM_DOL' +
        'G || '#39')'#39', '#39#39') NAME_WITH_DOLG'
      '110157430=           ,P.NAME NAME_PROMO'
      '110157431=           ,T.MAX_BONUS_PAY_SUMM'
      
        '110157432=    FROM g_client t LEFT OUTER JOIN G_DISCONT_CARD D O' +
        'N T.G_CLIENT = D.G_CLIENT'
      
        '110157433=                    LEFT OUTER JOIN (SELECT SUM(SUMM -' +
        ' SUMM_FACT - SUMM_BONUS) SUMM_DOLG ,G_CLIENT FROM ZAKAZ WHERE IS' +
        '_PAYED_ALL = 0 GROUP BY G_CLIENT) Z ON T.G_CLIENT = Z.G_CLIENT'
      
        '110157434=                    LEFT OUTER JOIN G_PROMOTION P ON T' +
        '.g_promotion = P.g_promotion'
      '110157435=         ,G_CONTRAGENT GC'
      
        '110157436=   WHERE T.G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT' +
        '_, T.G_CLIENT_PARENT)  -- '#1048#1053#1054#1043#1044#1040' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      '110157437=     AND T.IS_CATEGORY = 0'
      '110157438=     AND T.G_CONTRAGENT = GC.G_CONTRAGENT'
      
        '110157439=     AND T.is_supplier = COALESCE(:IS_SUPPLIER_, T.IS_' +
        'SUPPLIER)'
      
        '110157440=     AND COALESCE(:G_CLIENT_PARENT_, 0) <> -1000      ' +
        '         -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110157441=   UNION ALL'
      '110157442=    SELECT T.G_TOCHKA g_client,'
      '110157443=           0 g_client_parent,'
      '110157444=           0 g_contragent,'
      '110157445=           T.name,'
      '110157446=           '#39#39' rnn,'
      '110157447=           '#39#39' idn,'
      '110157448=           '#39#39' KBE,'
      '110157449=           '#39#39' PHONE,'
      '110157450=           0 SKIDKA,'
      '110157451=           0 is_supplier,'
      '110157452=           0 BY_DEFAULT,'
      '110157453=           0 IS_BEZNAL,'
      '110157454=           '#39#1057#1082#1083#1072#1076#39' IS_SUPPLIER_STR,'
      '110157455=           '#39#39' SHORT_NAME,'
      '110157456=           0,'
      '110157457=           '#39#39' BARCODE,'
      '110157458=           0 N_PERCENT,'
      '110157459=           0 SUMM,'
      '110157460=           0 SUMM_ALL,'
      '110157461=           '#39#39' NOTE'
      '110157462=           ,0 SUMM_DOLG'
      '110157463=           ,'#39#39' NAME_WITH_DOLG'
      '110157464=           ,'#39#39' NAME_PROMO'
      '110157465=           ,0 MAX_BONUS_PAY_SUMM'
      '110157466=    FROM G_TOCHKA T'
      
        '110157467=   WHERE T.G_TOCHKA <> (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      
        '110157468=     AND COALESCE(:G_CLIENT_PARENT_, 0) = -1000       ' +
        '        -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110157469=   ORDER BY 4'
      
        '110157470=    into :G_CLIENT, :G_CLIENT_PARENT, :G_CONTRAGENT, :' +
        'NAME, :RNN, :IDN, :KBE, :PHONE, :SKIDKA, :IS_SUPPLIER, :BY_DEFAU' +
        'LT,'
      
        '110157471=         :IS_BEZNAL, :IS_SUPPLIER_STR, :SUPPL_AGENT_NA' +
        'ME,'
      '110157472=         :G_DISCONT_CARD,'
      '110157473=         :BARCODE,'
      '110157474=         :N_PERCENT,'
      '110157475=         :SUMM,'
      '110157476=         :SUMM_ALL, :NOTE'
      '110157477=         ,:SUMM_DOLG'
      '110157478=         ,:NAME_WITH_DOLG'
      '110157479=         ,:G_PROMOTION_STR'
      '110157480=         ,:MAX_BONUS_PAY_SUMM'
      '110157481=  DO'
      '110157482=    suspend;'
      '110157483=end'
      '110157484=;'
      '110157485='
      '110157486=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110157487=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      
        '110157488=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110157489=  ARTICUL_ VARCHAR(30),'
      '110157490=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110157491=  BARCODE_ VARCHAR(30),'
      '110157492=  NAME_ VARCHAR(500),'
      '110157493=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110157494=  PRICE_ NUMERIC(15,2),'
      '110157495=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110157496=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110157497=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110157498=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110157499=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110157500=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110157501=  IS_CATEGORY_ INTEGER,'
      '110157502=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110157503=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110157504=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110157505=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110157506=  FAST_TOVAR_ TYPE OF COLUMN G_PRODUCT.FAST_TOVAR,'
      
        '110157507=  DO_NOT_CHARGE_BONUS_ TYPE OF COLUMN G_PRODUCT.DO_NOT' +
        '_CHARGE_BONUS,'
      '110157508=  IS_MARKED_ INTEGER)'
      '110157509=RETURNS ('
      '110157510=  ERR_CODE INTEGER,'
      '110157511=  ERR_MSG VARCHAR(1024))'
      '110157512=AS'
      
        '110157513=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODU' +
        'CT'#39';'
      
        '110157514=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLU' +
        'MN LT_SKLAD_PRODUCT.AMOUNT;'
      '110157515=begin'
      
        '110157516=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110157517=    IF (EXISTS(SELECT  FIRST 1 G_PRODUCT'
      '110157518=                  FROM G_PRODUCT G'
      
        '110157519=                 WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:' +
        'ARTICUL_))'
      '110157520=                   AND TRIM(G.ARTICUL) <> '#39#39
      '110157521=                   AND TRIM(:ARTICUL_) <> '#39#39
      '110157522=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110157523=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110157524=      ERR_CODE = -20500;'
      
        '110157525=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      '110157526=      EXIT;'
      '110157527=    END'
      '110157528='
      '110157529=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110157530=    IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110157531=                  FROM G_PRODUCT G'
      
        '110157532=                 WHERE UPPER(G.NOMENCLATUR_NUM) = UPPE' +
        'R(TRIM(:NOMENCLATUR_NUM_))'
      '110157533=                   AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '110157534=                   AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '110157535=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110157536=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110157537=      ERR_CODE = -20500;'
      
        '110157538=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086#1074#1072#1088' '#1089 +
        ' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATUR_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      '110157539=      EXIT;'
      '110157540=    END'
      '110157541='
      '110157542=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '110157543=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '110157544=        IF (EXISTS(SELECT FIRST 1 G_PRODUCT'
      '110157545=                  FROM G_PRODUCT G'
      
        '110157546=                 WHERE UPPER(G.BARCODE) = UPPER(TRIM(:' +
        'BARCODE_))'
      '110157547=                   AND TRIM(G.BARCODE) <> '#39#39
      '110157548=                   AND TRIM(:BARCODE_) <> '#39#39
      '110157549=                   AND G.G_PRODUCT <> :G_PRODUCT_'
      '110157550=                   AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110157551=          ERR_CODE = -20500;'
      
        '110157552=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110157553=          EXIT;'
      '110157554=        END'
      '110157555='
      '110157556=        IF (EXISTS(SELECT FIRST 1 L.G_PRODUCT'
      '110157557=                    FROM G_PRODUCT G, LT_BARCODE L'
      '110157558=                   WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110157559=                     AND L.BARCODE = TRIM(:BARCODE_)'
      '110157560=                     AND TRIM(L.BARCODE) <> '#39#39
      '110157561=                     AND G.IS_ACTIVE = 1)) THEN BEGIN'
      '110157562=          ERR_CODE = -20500;'
      
        '110157563=           EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1058#1086 +
        #1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '110157564=          EXIT;'
      '110157565=        END'
      '110157566=    END'
      '110157567='
      '110157568=    update G_PRODUCT'
      '110157569=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '110157570=        ARTICUL = :ARTICUL_,'
      '110157571=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '110157572=        BARCODE = :BARCODE_,'
      '110157573=        NAME = :NAME_,'
      '110157574=        G_UNIT = :G_UNIT_,'
      '110157575=        PRICE = :PRICE_,'
      '110157576=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '110157577=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '110157578=        MF_COUNTRY   = :MF_COUNTRY_,'
      '110157579=        NOTE         = :NOTE_,'
      '110157580=        CROSSCODE    = :CROSSCODE_,'
      '110157581=        IS_KIT       = :IS_KIT_,'
      '110157582=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '110157583=        PLACE        = :PLACE_,'
      '110157584=        SALES_COMM   = :SALES_COMM_,'
      '110157585=        KOD_TNVD     = :KOD_TNVD_,'
      '110157586=        FAST_TOVAR   = :FAST_TOVAR_,'
      '110157587=        DO_NOT_CHARGE_BONUS = :DO_NOT_CHARGE_BONUS_,'
      '110157588=        IS_MARKED    = :IS_MARKED_'
      '110157589=    where (G_PRODUCT = :G_PRODUCT_);'
      '110157590='
      '110157591=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '110157592=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PR' +
        'ODUCT_;'
      '110157593='
      '110157594=        INSERT INTO LT_BARCODE'
      
        '110157595=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM L' +
        'T_BARCODE_TMP;'
      '110157596='
      '110157597=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '110157598=        INSERT INTO G_PRODUCT_IMAGE'
      
        '110157599=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT ' +
        'EXISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.' +
        'G_PRODUCT_IMAGE);'
      '110157600='
      
        '110157601=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS' +
        ' (SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_' +
        'PRODUCT_IMAGE)'
      '110157602=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '110157603='
      '110157604=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '110157605=        IF (IS_KIT_ > 0) THEN BEGIN'
      '110157606=            /*INSERT INTO G_PRODUCT_KIT'
      
        '110157607=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KI' +
        'T_TMP T'
      
        '110157608=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_' +
        'KIT'
      
        '110157609=                               WHERE G_PRODUCT_ITEM = ' +
        'T.G_PRODUCT_ITEM'
      
        '110157610=                                 AND G_PRODUCT = T.g_p' +
        'roduct);'
      '110157611='
      
        '110157612=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIS' +
        'TS (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_P' +
        'RODUCT_ITEM)'
      '110157613=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '110157614='
      '110157615=            UPDATE G_PRODUCT_KIT G'
      
        '110157616=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PR' +
        'ODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '110157617=                   G.PRICE  = (SELECT PRICE FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '110157618=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT' +
        '_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AM' +
        'OUNT or PRICE <> G.PRICE))'
      '110157619=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '110157620='
      
        '110157621=            '#1088#1077#1096#1080#1083' '#1085#1077' '#1079#1072#1084#1086#1088#1072#1095#1080#1074#1072#1090#1100#1089#1103' '#1080' '#1090#1091#1087#1086' '#1091#1076#1072#1083#1103#1090#1100' '#1080' '#1074 +
        #1089#1090#1072#1074#1083#1103#1090#1100' '#1089#1085#1086#1074#1072', '#1082#1072#1082' '#1103' '#1076#1077#1083#1072#1102' '#1074' '#1079#1072#1082#1072#1079#1072#1093
      '110157622=            */'
      
        '110157623=            DELETE FROM G_PRODUCT_KIT T WHERE T.G_PROD' +
        'UCT = :G_PRODUCT_;'
      '110157624=            INSERT INTO G_PRODUCT_KIT'
      
        '110157625=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODU' +
        'CT_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3'
      '110157626=            FROM G_PRODUCT_KIT_TMP T;'
      '110157627='
      
        '110157628=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089 +
        #1090#1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '110157629=            if (is_kit_ = 1) then begin'
      
        '110157630=                SELECT MIN((L.AMOUNT - L.AMOUNT_RESERV' +
        'E)/K.amount)'
      '110157631=                  FROM G_PRODUCT_KIT K,'
      '110157632=                       LT_SKLAD_PRODUCT L'
      '110157633=                 WHERE K.g_product = :G_PRODUCT_'
      '110157634=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '110157635=                   AND L.G_TOCHKA = (SELECT ID FROM CU' +
        'R_PARAMS WHERE CUR_PARAMS = 2)'
      '110157636=                 GROUP BY K.G_PRODUCT'
      '110157637=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '110157638='
      '110157639=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110157640=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AM' +
        'OUNT_'
      '110157641=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '110157642=            end'
      '110157643=        END'
      '110157644=    END'
      '110157645=end'
      '110157646=;'
      '110157647='
      '110157648=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '110157649=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T,'
      '110157650=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110157651=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110157652=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '110157653=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '110157654=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '110157655=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '110157656=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110157657=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110157658=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '110157659=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110157660=  IS_SPISANIE_ INTEGER,'
      '110157661=  NEW_LINE_SALE_ INTEGER = 0,'
      '110157662=  MODE_ INTEGER = 0,'
      '110157663=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '110157664=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '110157665=  MARK_CODE_ VARCHAR(100) = '#39#39')'
      '110157666=RETURNS ('
      
        '110157667=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110157668=  ERR_CODE INTEGER,'
      '110157669=  ERR_MSG VARCHAR(1024))'
      '110157670=AS'
      '110157671=/*'
      
        '110157672=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048 +
        #1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '110157673=*/'
      
        '110157674=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DET' +
        'AILS_TMP'#39';'
      '110157675=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '110157676=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110157677=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      
        '110157678=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = 0' +
        '; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047 +
        #1040#1050#1040#1047' */'
      
        '110157679=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047 +
        #1045' */'
      
        '110157680=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '110157681=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      
        '110157682=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.PRICE;'
      
        '110157683=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.COST_PRICE;'
      
        '110157684=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '110157685=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      
        '110157686=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041 +
        #1051#1048#1062#1045' */'
      
        '110157687=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042 +
        #1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058' ' +
        #1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '110157688=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110157689=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '110157690=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '110157691=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUMN' +
        ' G_PRODUCT.G_PRODUCT;'
      '110157692=BEGIN'
      '110157693=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '110157694='
      
        '110157695=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070 +
        #1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '110157696=  SELECT T.ZAKAZ, T.Z_TYPE'
      '110157697=    FROM ZAKAZ_DETAILS_TMP T'
      '110157698=   WHERE T.ZAKAZ IS NOT NULL'
      
        '110157699=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089 +
        #1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072 +
        ' MULTIPLE ROWS IN SINGLETON SELECT'
      '110157700=    INTO :ZAKAZ_, :Z_TYPE_;'
      '110157701='
      
        '110157702=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051 +
        #1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110157703=           ,G.IS_KIT'
      '110157704=           ,K.AMOUNT * :AMOUNT_'
      '110157705=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '110157706=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRI' +
        'CE)'
      '110157707=           ,(CASE'
      
        '110157708=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANIE' +
        '_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT * ' +
        'FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '110157709=             ELSE K.PRICE'
      '110157710=           END) COST_PRICE'
      
        '110157711=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_L' +
        'AST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '110157712=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE ' +
        'G_PRODUCT = :G_PRODUCT_) CNT'
      
        '110157713=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K' +
        ' ON G.G_PRODUCT = K.G_PRODUCT'
      '110157714=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '110157715=       AND G.IS_KIT = 1'
      '110157716=    UNION'
      
        '110157717=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054 +
        #1044#1040#1046
      '110157718=           ,G.IS_KIT'
      '110157719=           ,:AMOUNT_'
      '110157720=           ,:PRICE_'
      '110157721=           ,0'
      '110157722=           ,:COST_PRICE_'
      '110157723=           ,0'
      '110157724=      FROM G_PRODUCT G'
      '110157725=     WHERE G_PRODUCT = :G_PRODUCT_'
      '110157726=       AND G.IS_KIT <> 1'
      '110157727=      INTO :G_PRODUCT_'
      '110157728=           ,:IS_KIT_'
      '110157729=           ,:AMOUNT_'
      '110157730=           ,:PRICE__'
      '110157731=           ,:SOSTAV_PRICE_'
      '110157732=           ,:COST_PRICE__'
      '110157733=           ,:SOSTAV_COUNT_'
      '110157734=  DO BEGIN'
      '110157735=      ZAKAZ_DTLS_TMP_ = NULL;'
      '110157736='
      
        '110157737=      --==============================================' +
        '============='
      '110157738=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110157739=      SELECT AMOUNT - AMOUNT_RESERVE'
      '110157740=        FROM LT_SKLAD_PRODUCT L'
      '110157741=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '110157742=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110157743=       INTO :AMOUNT_CUR_;'
      '110157744='
      
        '110157745=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058#1048 +
        #1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '110157746=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '110157747=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '110157748=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067#1051 +
        #1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051#1068 +
        #1050#1054
      
        '110157749=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058#1068 +
        ' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '110157750=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '110157751=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '110157752=          SELECT SUM(AMOUNT)'
      '110157753=            FROM ZAKAZ_DETAILS T'
      '110157754=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110157755=             AND T.ZAKAZ = :ZAKAZ_'
      '110157756=            INTO :AMOUNT_OLD_;'
      '110157757=        ELSE'
      '110157758=          SELECT SUM(AMOUNT)'
      '110157759=            FROM SKLAD T'
      '110157760=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110157761=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110157762=            INTO :AMOUNT_OLD_;'
      '110157763=      END'
      '110157764='
      '110157765=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '110157766=      SELECT SUM(AMOUNT)'
      '110157767=        FROM ZAKAZ_DETAILS_TMP T'
      '110157768=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110157769=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110157770='
      
        '110157771=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_, ' +
        '0) + :AMOUNT_;'
      '110157772=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '110157773='
      
        '110157774=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' ' +
        #1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '110157775='
      
        '110157776=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '110157777=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047#1042 +
        #1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '110157778=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) T' +
        'HEN BEGIN'
      '110157779=            PNT_ = '#39'01'#39';'
      
        '110157780=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID FR' +
        'OM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      '110157781=                                         CURRENT_DATE,'
      '110157782=                                         :G_PRODUCT_,'
      
        '110157783=                                         ABS(AMOUNT_CU' +
        'R_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOUN' +
        'T_,'
      
        '110157784=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074#1086 +
        ' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '110157785=                                         )'
      
        '110157786=                RETURNING_VALUES :SKLAD_, :COST_PRICE_' +
        '_, :ERR_CODE, :ERR_MSG;'
      '110157787=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110157788=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110157789=              EXIT;'
      '110157790=            END'
      '110157791=        END'
      
        '110157792=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_PR' +
        'ODUCT_ <> -2) THEN BEGIN'
      '110157793=            SELECT NAME'
      '110157794=            FROM G_PRODUCT'
      '110157795=            WHERE G_PRODUCT = :G_PRODUCT_'
      '110157796=            INTO :PRODUCT_NAME_;'
      '110157797='
      '110157798=            ERR_CODE = -20500;'
      
        '110157799=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_N' +
        'AME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '110157800=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082 +
        #1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '110157801=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110157802=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110157803=            EXIT;'
      '110157804=        END'
      '110157805=      END'
      '110157806=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110157807=      --==============================================' +
        '============='
      '110157808='
      
        '110157809=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090 +
        #1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083 +
        #1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '110157810=      IF (IS_KIT_ = 1) THEN BEGIN'
      '110157811='
      '110157812=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '110157813=        --    PRICE__ = SOSTAV_PRICE_;'
      '110157814=        --END ELSE BEGIN'
      '110157815=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '110157816=              PRICE__ = COST_PRICE__;'
      '110157817='
      
        '110157818=            END ELSE IF (Discount_perc_ <> 0) THEN BEG' +
        'IN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '110157819=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PER' +
        'C_/100;'
      '110157820='
      '110157821='
      
        '110157822=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN' +
        ' BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '110157823=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / SO' +
        'STAV_PRICE_;'
      
        '110157824=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_' +
        ';'
      '110157825=            END'
      '110157826='
      
        '110157827=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT' +
        '_;'
      
        '110157828=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOU' +
        'NT_;'
      '110157829=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '110157830=        --END'
      '110157831=      END'
      '110157832='
      
        '110157833=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045 +
        #1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '110157834=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041#1048 +
        #1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '110157835=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_CODE' +
        '_) = 0) THEN'
      '110157836=          SELECT ZD.zakaz_details'
      '110157837=            FROM zakaz_details_tmp ZD'
      '110157838=           WHERE ZD.G_PRODUCT = :g_product_'
      '110157839=             AND ZD.PRICE = :PRICE__'
      '110157840=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '110157841=            INTO :ZAKAZ_DTLS_TMP_;'
      '110157842='
      '110157843='
      '110157844=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '110157845=        UPDATE ZAKAZ_DETAILS_TMP P'
      '110157846=           SET P.amount = P.amount + :amount_'
      
        '110157847=               ,P.summ = (P.price - P.discount_TENGE) ' +
        '* (P.amount + :AMOUNT_)'
      
        '110157848=               ,P.discount_summ = P.discount_TENGE * (' +
        'P.amount + :AMOUNT_)'
      '110157849=               ,P.NDS = :NDS_'
      '110157850=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '110157851=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '110157852='
      '110157853=      ELSE BEGIN'
      
        '110157854=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN ' +
        'BEGIN'
      '110157855=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_;'
      '110157856=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '110157857=          END'
      '110157858='
      '110157859=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '110157860=          ('
      '110157861=           ZAKAZ_DETAILS,'
      '110157862=           ZAKAZ,'
      '110157863=           G_PRODUCT,'
      '110157864=           AMOUNT,'
      '110157865=           PRICE,'
      '110157866=           SUMM,'
      '110157867=           DISCOUNT_PERC,'
      '110157868=           DISCOUNT_TENGE,'
      '110157869=           DISCOUNT_SUMM,'
      '110157870=           NDS,'
      '110157871=           NDS_SUMM,'
      '110157872=           COST_PRICE,'
      '110157873=           MARK_CODE,'
      '110157874=           ORIGINAL_KIT_ID,'
      '110157875=           ORIGINAL_KIT_PRICE'
      '110157876=          ) VALUES ('
      '110157877=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '110157878=           :ZAKAZ_,'
      '110157879=           :G_PRODUCT_,'
      '110157880=           :AMOUNT_,'
      '110157881=           :PRICE__,'
      '110157882=           :SUMM_,'
      '110157883=           :DISCOUNT_PERC_,'
      '110157884=           :DISCOUNT_TENGE_,'
      '110157885=           :DISCOUNT_SUMM_,'
      '110157886=           :NDS_,'
      '110157887=           :NDS_SUMM_,'
      '110157888=           :COST_PRICE__,'
      '110157889=           :MARK_CODE_,'
      '110157890=           :ORIGINAL_KIT_ID_,'
      '110157891=           :ORIGINAL_KIT_PRICE_'
      '110157892=          )'
      '110157893=          RETURNING'
      '110157894=            ZAKAZ_DETAILS'
      '110157895=          INTO'
      '110157896=            :ZAKAZ_DETAILS_;'
      '110157897=      END'
      '110157898=  END'
      '110157899=end'
      '110157900=;'
      '110157901='
      '110157902=ALTER PROCEDURE LOG_INIT'
      '110157903=AS'
      '110157904=DECLARE VARIABLE TN VARCHAR(64);'
      '110157905=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110157906=DECLARE VARIABLE FN VARCHAR(64);'
      '110157907=DECLARE VARIABLE TP INTEGER;'
      
        '110157908=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110157909=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110157910=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110157911=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110157912=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110157913=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110157914=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110157915=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000) */'
      '110157916=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110157917=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110157918=DECLARE VARIABLE ANZ INTEGER;'
      '110157919=DECLARE VARIABLE L INTEGER;'
      '110157920=DECLARE VARIABLE P INTEGER;'
      '110157921=DECLARE VARIABLE S INTEGER;'
      '110157922=DECLARE VARIABLE FT CHAR(1);'
      '110157923=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110157924=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110157925=BEGIN'
      '110157926=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110157927='
      '110157928=  TN_ALT='#39#39';'
      '110157929=  TRGI='#39#39';'
      '110157930=  TRGU='#39#39';'
      '110157931=  TRGD='#39#39';'
      '110157932=  TRGIX='#39#39';'
      '110157933=  TRGUX='#39#39';'
      '110157934=  TRGDX='#39#39';'
      '110157935=  SQLF='#39#39';'
      '110157936=  SQLV='#39#39';'
      '110157937=  SQLU='#39#39';'
      '110157938=  FT='#39#39';'
      '110157939='
      '110157940=  FOR SELECT R.RDB$RELATION_NAME,'
      '110157941=            R.RDB$FIELD_NAME,'
      '110157942=            F.RDB$FIELD_TYPE,'
      '110157943=            F.RDB$FIELD_LENGTH,'
      '110157944=            F.RDB$FIELD_PRECISION,'
      '110157945=            F.RDB$FIELD_SCALE'
      '110157946=        FROM RDB$RELATION_FIELDS R,'
      '110157947=             RDB$FIELDS F'
      '110157948=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110157949=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110157950=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110157951=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110157952=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110157953=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110157954=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110157955=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110157956=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110157957=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110157958=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39')'
      '110157959=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110157960=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110157961=              OR'
      
        '110157962=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110157963=             )'
      
        '110157964=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110157965=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110157966=  DO BEGIN'
      '110157967=    TN=TRIM(TN);'
      '110157968=    FN=TRIM(FN);'
      '110157969=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110157970=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110157971=      EXECUTE STATEMENT TRGI;'
      '110157972=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110157973=      EXECUTE STATEMENT TRGU;'
      '110157974=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110157975=      EXECUTE STATEMENT TRGD;'
      '110157976='
      '110157977=      SQLF='#39#39';'
      '110157978=      SQLV='#39#39';'
      '110157979=      SQLU='#39#39';'
      '110157980=    END'
      '110157981=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110157982=      ID_COLUMN = FN;'
      '110157983='
      '110157984=    S=-S;'
      
        '110157985=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110157986=      ft='#39'N'#39';   --numerisch'
      '110157987=    else'
      '110157988=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110157989=        ft='#39'Z'#39';   --zeit'
      '110157990=      else'
      '110157991=        ft='#39'T'#39';'
      '110157992='
      '110157993=    IF (SQLF='#39#39') THEN'
      '110157994=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110157995=    ELSE'
      '110157996=      SQLF=SQLF||'#39','#39'||FN;'
      '110157997='
      '110157998=    if (ft='#39'N'#39') then begin'
      '110157999=      IF (SQLV='#39#39') THEN'
      
        '1101571000=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1101571001=      ELSE'
      
        '1101571002=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||' +
        'FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1101571003='
      '1101571004=      IF (SQLU='#39#39') THEN'
      
        '1101571005=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UP' +
        'DATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1101571006=      ELSE'
      
        '1101571007=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'|' +
        '|FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '1101571008=    end'
      '1101571009=    else'
      '1101571010=      if (ft='#39'Z'#39') then begin'
      '1101571011=        IF (SQLV='#39#39') THEN'
      
        '1101571012=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||r' +
        'eplace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1101571013=        ELSE'
      
        '1101571014=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||r' +
        'eplace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1101571015='
      '1101571016=        IF (SQLU='#39#39') THEN'
      
        '1101571017=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39 +
        'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRI' +
        'M(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39 +
        #39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1101571018=        ELSE'
      
        '1101571019=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THE' +
        'N SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39',' +
        #39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39 +
        #39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF' +
        ';'
      '1101571020=    end'
      '1101571021=    else begin'
      '1101571022=      IF (SQLV='#39#39') THEN'
      
        '1101571023=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||rep' +
        'lace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CR' +
        'LF;'
      '1101571024=      ELSE'
      
        '1101571025=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||rep' +
        'lace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CR' +
        'LF;'
      '1101571026='
      '1101571027=      IF (SQLU='#39#39') THEN'
      
        '1101571028=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UP' +
        'DATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39 +
        #39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1101571029=      ELSE'
      
        '1101571030=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN ' +
        'SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'|' +
        '|FN||'#39'='#39#39#39#39#39#39'||replace(TRIM(NEW.'#39'||FN||'#39'), '#39#39#39#39#39#39#39#39', '#39#39#39#39#39#39#39#39#39#39#39 +
        #39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '1101571031=    end'
      '1101571032=    SELECT COUNT(*)'
      '1101571033=      FROM RDB$TRIGGERS'
      '1101571034=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGI'#39
      '1101571035=      INTO :ANZ;'
      '1101571036='
      '1101571037=    IF (ANZ>0) THEN'
      '1101571038=      TRGIX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGI'#39';'
      '1101571039=    ELSE'
      '1101571040=      TRGIX='#39#39';'
      '1101571041='
      
        '1101571042=    TRGI='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGI FOR '#39'||TN||'#39' A' +
        'CTIVE AFTER INSERT POSITION 255 AS '#39'||CRLF||'
      
        '1101571043=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SE' +
        'GMENT SIZE 80;'#39'||CRLF||'
      '1101571044=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '1101571045=         '#39'BEGIN'#39'||CRLF||'
      
        '1101571046=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39 +
        'REPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39' ||CRLF;'
      '1101571047='
      '1101571048=    IF (TN = '#39'KASSA_STATE'#39') THEN BEGIN'
      '1101571049=      TRGI = TRGI||'
      
        '1101571050=         '#39'  SQLSTMT='#39#39#39'||'#39'MERGE INTO KASSA_STATE c '#39'|' +
        '|'
      
        '1101571051=                           '#39'USING (select CAST('#39#39#39#39#39#39 +
