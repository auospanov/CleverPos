      '1101322317='
      '1101322318=      INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1101322319=        (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, NAME, AMO' +
        'UNT_IN, AMOUNT_PRIHOD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOU' +
