        '110231845=        VALUES (18, 3, '#39#1054#1087#1083#1072#1095#1077#1085#1086' '#1085#1072#1083#39', (SELECT SUM(K.S' +
        'UMM)'
      '110231846=                                         FROM KASSA K,'
      '110231847=                                              ZAKAZ Z'
      
