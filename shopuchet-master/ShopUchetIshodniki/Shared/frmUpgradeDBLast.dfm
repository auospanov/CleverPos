        #1058#1054' '#1057#1056#1045#1044#1053#1045#1045' '#1040#1056#1048#1060#1052#1045#1058#1048#1063#1045#1057#1050#1054#1045' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1048#1052' 5 '#1055#1054#1057#1058#1040#1042#1050#1040#1052' '#1058#1054#1042#1040#1056#1040' '#1044#1054' '#1050#1054#1053 +
        #1045#1063#1053#1054#1049' '#1044#1040#1058#1067' '#1042#1067#1041#1056#1040#1053#1053#1054#1043#1054' '#1055#1045#1056#1048#1054#1044#1040
      '110237335='#1053#1040#1055#1056#1048#1052#1045#1056' '#1055#1045#1056#1048#1054#1044' '#1042#1067#1041#1056#1040#1051#1048' 01.01.2015 - 01.03.2015'
      '110237336='#1041#1045#1056#1059' 5 '#1055#1054#1057#1058#1040#1042#1054#1050' '#1057' '#1044#1040#1058#1040#1052#1048' '#1052#1045#1053#1068#1064#1045' 01.03.2015'
      '110237337='#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1067#1051#1048':'
      '110237338=02.01.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 100 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2000 '#1058#1043
      '110237339=10.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 300 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 1750 '#1058#1043
      '110237340=23.02.2015 '#1042' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1045' 50 '#1064#1058' '#1055#1054' '#1062#1045#1053#1045' 2100 '#1058#1043
      
        '110237341='#1058#1054#1043#1044#1040' '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048' '#1041#1059#1044#1045#1058' = (100*2000 + 300*175' +
        '0 + 50*2100)/(100+300+50) = 1844.44 '#1058#1043
      
        '110237342='#1040' '#1044#1040#1051#1068#1064#1045' '#1044#1045#1051#1054' '#1058#1045#1061#1053#1048#1050#1048' - '#1054#1058#1053#1048#1052#1040#1058#1068' '#1054#1058' '#1062#1045#1053#1067' '#1055#1056#1054#1044#1040#1046#1048' '#1062#1045#1053#1059' ' +
        #1047#1040#1050#1059#1055#1050#1048' '#1048' '#1055#1054#1051#1059#1063#1040#1058#1068' '#1055#1056#1048#1041#1067#1051#1068
      '110237343='
      '110237344='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = NULL, '#1058#1054' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '110237345='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = -100, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040 +
        #1057#1057#1059' '#1042#1054#1054#1041#1065#1045
      
        '110237346='#1045#1057#1051#1048' G_PRIHOD_RASHOD_ = ID, '#1058#1054' '#1053#1045' '#1057#1063#1048#1058#1040#1070' '#1050#1054#1053#1050#1056#1045#1058#1053#1059#1070' '#1057#1058 +
        #1040#1058#1068#1070' '#1055#1056#1048#1061#1054#1044#1040' '#1042' '#1050#1040#1057#1057#1059
      '110237347=*/'
      
        '110237348=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PROFIT'#39 +
        ';'
      '110237349=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110237350=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110237351=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110237352=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110237353=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110237354=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110237355=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110237356=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110237357=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110237358=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110237359=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110237360=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '110237361=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '110237362=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110237363=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052 +
        #1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110237364=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /*' +
        ' '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '110237365=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;' +
        ' /* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '110237366=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110237367=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      '110237368=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '110237369=DECLARE VARIABLE SUMM_CASH_RETURN_ NUMERIC(15,2);'
      '110237370=DECLARE VARIABLE SUMM_NONCASH_RETURN_ NUMERIC(15,2);'
      '110237371=BEGIN'
      
        '110237372=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110237373=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110237374='
      '110237375=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110237376=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110237377=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110237378='
      '110237379=  FOR SELECT SUM(ZD.SUMM)'
      '110237380=           ,TR.PATH'
      '110237381=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '110237382=           ,SUM(ZD.nds_summ)'
      '110237383=      FROM ZAKAZ Z,'
      '110237384=           ZAKAZ_DETAILS ZD,'
      '110237385=           G_PRODUCT GP,'
      '110237386=           P_REP_TREE TR'
      
        '110237387=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110237388=       AND Z.IS_SPISANIE = 0'
      '110237389=       AND Z.IS_RESERVE = 0'
      '110237390=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110237391=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110237392=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110237393=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110237394=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110237395=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110237396=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 0))  -- '#1055#1054#1051#1045' '#1057#1054#1058#1056#1059#1044#1053#1048#1050' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '110237397=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110237398=       AND ((EXISTS (SELECT 1'
      '110237399=                       FROM SKLAD S'
      '110237400=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110237401=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110237402=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110237403=              OR'
      '110237404=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110237405=     GROUP BY TR.PATH'
      '110237406=     ORDER BY TR.PATH'
      
        '110237407=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, N' +
        'DS_SUMM_'
      '110237408=  DO BEGIN'
      '110237409=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '110237410='
      '110237411=    insert into p_rep_profit_table'
      
        '110237412=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110237413=    values'
      '110237414=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110237415=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :SU' +
        'M_COST_, :PROFIT_, 0);'
      '110237416='
      '110237417=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110237418=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110237419=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110237420=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110237421=  END'
      '110237422='
      '110237423=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110237424=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110237425=      insert into p_rep_profit_table'
      
        '110237426=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110237427=      values'
      
        '110237428=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PRO' +
        'FIT_ALL_, 3);'
      '110237429='
      
        '110237430=  --**************************************************' +
        '***************************************'
      '110237431=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1040#1057#1061#1054#1044#1067', '#1045#1057#1051#1048' '#1054#1053#1048' '#1045#1057#1058#1068
      
        '110237432=  ----------------------------------------------------' +
        '---'
      '110237433=  IS_FIRST_ = 1;'
      '110237434=  SUM_COST_ = 0;'
      '110237435=  PROFIT_   = 0;'
      '110237436='
      '110237437=  FOR SELECT G.NAME,'
      '110237438=             SUM(K.SUMM)'
      
        '110237439=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRIH' +
        'OD_RASHOD, G_TOCHKA FROM KASSA'
      '110237440=              UNION ALL'
      
        '110237441=              SELECT ACTION_DATE, SUMM NAL, ACTION, G_' +
        'PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '110237442=             G_PRIHOD_RASHOD G'
      
        '110237443=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA' +
        '||'#39'-'#39
      '110237444=        AND K.ACTION = 1'
      
        '110237445=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110237446=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110237447=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110237448=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '110237449=        INTO :REC_TOVAR_NAME_'
      '110237450=             ,:SUMM_'
      '110237451=  DO BEGIN'
      '110237452=    IF (IS_FIRST_ = 1) then BEGIN'
      '110237453=      INSERT INTO P_REP_PROFIT_TABLE'
      '110237454=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110237455=      VALUES'
      
        '110237456=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1040#1057#1061#1054#1044#1067#39',' +
        ' 1);'
      '110237457='
      '110237458=      IS_FIRST_ = 0;'
      '110237459=    END'
      '110237460='
      '110237461=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110237462=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM,' +
        ' SUM_SELF, PROFIT, IS_HEAD)'
      '110237463=    VALUES'
      
        '110237464=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '110237465='
      '110237466=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110237467=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110237468=  END'
      '110237469='
      '110237470=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110237471=  IF (SUM_COST_ > 0) then BEGIN'
      '110237472=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110237473=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110237474=    insert into p_rep_profit_table'
      
        '110237475=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110237476=    values'
      
        '110237477=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110237478=  END'
      '110237479=  -- '#1050#1054#1053#1045#1062' '#1056#1040#1057#1061#1054#1044#1067
      
        '110237480=  --**************************************************' +
        '***************************************'
      '110237481='
      
        '110237482=  --**************************************************' +
        '***************************************'
      '110237483=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1058#1040#1058#1068#1048' '#1055#1056#1048#1061#1054#1044#1040
      
        '110237484=  ----------------------------------------------------' +
        '---'
      '110237485=  IS_FIRST_ = 1;'
      '110237486=  PROFIT_   = 0;'
      '110237487=  PRIHOD_ALL_  = 0;'
      '110237488=  PRIHOD_ALL_NAL_  = 0;'
      '110237489=  PRIHOD_ALL_BEZNAL_  = 0;'
      '110237490='
      '110237491=  FOR SELECT G.NAME,'
      '110237492=             SUM(K.NAL),'
      '110237493=             SUM(K.BEZNAL)'
      
        '110237494=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL, ' +
        'ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110237495=              UNION ALL'
      
        '110237496=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL, ' +
        'ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '110237497=             G_PRIHOD_RASHOD G'
      
        '110237498=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||K.G_TOCHKA' +
        '||'#39'-'#39
      '110237499=        AND K.ACTION = 0'
      
        '110237500=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110237501=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110237502=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053 +
        #1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110237503=        AND ((:G_PRIHOD_RASHOD_ IS NULL)'
      '110237504=             OR'
      
        '110237505=             (G.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_ AN' +
        'D :G_PRIHOD_RASHOD_ = -100)'
      '110237506=             OR'
      
        '110237507=             (G.G_PRIHOD_RASHOD <> :G_PRIHOD_RASHOD_ A' +
        'ND :G_PRIHOD_RASHOD_ <> -100)'
      '110237508=            )'
      '110237509=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '110237510=        INTO :REC_TOVAR_NAME_'
      '110237511=             ,:SUMM_NAL_'
      '110237512=             ,:SUMM_BEZNAL_'
      '110237513=  DO BEGIN'
      '110237514=    IF (IS_FIRST_ = 1) then BEGIN'
      '110237515=      INSERT INTO P_REP_PROFIT_TABLE'
      '110237516=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110237517=      VALUES'
      
        '110237518=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1055#1056#1048#1061#1054#1044#1067#39',' +
        ' 1);'
      '110237519='
      '110237520=      IS_FIRST_ = 0;'
      '110237521=    END'
      '110237522='
      '110237523=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110237524=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_S' +
        'UMM, SUMM, PROFIT, IS_HEAD)'
      '110237525=    VALUES'
      
        '110237526=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZNA' +
        'L_, 0);'
      '110237527='
      '110237528=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110237529=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BEZ' +
        'NAL_;'
      
        '110237530=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZNA' +
        'L_;'
      
        '110237531=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL_' +
        ';'
      '110237532=  END'
      '110237533='
      '110237534=  IF (PROFIT_ > 0) then BEGIN'
      '110237535=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110237536=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110237537=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '110237538=    insert into p_rep_profit_table'
      
        '110237539=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110237540=    values'
      
        '110237541=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110237542=  END'
      '110237543=  -- '#1050#1054#1053#1045#1062' '#1055#1056#1048#1061#1054#1044#1067
      
        '110237544=  --**************************************************' +
        '***************************************'
      '110237545='
      
        '110237546=  --**************************************************' +
        '***************************************'
      '110237547=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1057#1055#1048#1057#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '110237548=  --**************************************************' +
        '***************************************'
      '110237549=  IS_FIRST_ = 1;'
      '110237550=  SUM_COST_ = 0;'
      '110237551=  PROFIT_   = 0;'
      
        '110237552=  FOR SELECT SUM(ZD.SUMM)        -- '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1057#1055#1048#1057#1040#1053 +
        #1048#1071' '#1048#1058#1040#1050' '#1047#1040#1055#1048#1057#1067#1042#1040#1070#1058#1057#1071' '#1062#1045#1053#1067' '#1047#1040#1050#1059#1055#1040', '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1044#1040#1046#1045' '#1048#1057#1050#1040#1058#1068' '#1053#1045' '#1053#1040#1044 +
        #1054
      '110237553=           ,TR.PATH'
      '110237554=      FROM ZAKAZ Z,'
      '110237555=           ZAKAZ_DETAILS ZD,'
      '110237556=           G_PRODUCT GP,'
      '110237557=           P_REP_TREE TR'
      
        '110237558=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110237559=       AND Z.IS_SPISANIE = 1'
      '110237560=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110237561=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110237562=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110237563=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110237564=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110237565=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110237566=       AND COALESCE(Z.G_OFFICIAL, 0) = COALESCE(:G_OFF' +
