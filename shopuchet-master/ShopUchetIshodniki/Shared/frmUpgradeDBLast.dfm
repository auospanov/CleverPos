        '110206769=                -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071 +
        ' ('#1053#1040#1055#1056#1048#1052#1045#1056' '#1052#1054#1041#1048#1051#1040'), '#1058#1054' '#1053#1040' '#1052#1048#1053#1059#1057' '#1053#1045' '#1055#1056#1054#1042#1045#1056#1071#1070
      '110206770=                PNT_ = '#39'04'#39';'
      
        '110206771=                IF (ROW_COUNT = 0 AND ((SELECT S_VALUE' +
        ' FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) AND REC_ID_ IS N' +
        'ULL) then BEGIN'
      '110206772=                  Err_Code = -20500;'
      
        '110206773=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_CO' +
        'DE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_P' +
        'RODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084 +
        #1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110206774=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110206775=                  EXIT;'
      '110206776=                END ELSE if (ROW_COUNT = 0) then'
      
        '110206777=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110206778=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,' +
        ' 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);  --' +
        ' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067' '#1055#1056#1048#1061#1054#1044', '#1061#1054 +
        #1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '110206779=            END'
      '110206780='
