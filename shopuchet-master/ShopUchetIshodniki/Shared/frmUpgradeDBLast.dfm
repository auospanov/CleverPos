        '*************************/'
      '110208163=ALTER PROCEDURE P_REP_KASSIR('
      '110208164=  DATE_BEGIN_ DATE,'
      '110208165=  DATE_END_ DATE,'
      '110208166=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110208167=RETURNS ('
      '110208168=  PERIOD_ VARCHAR(40),'
      '110208169=  IN_SUMM_ TYPE OF MY_NUMERIC,'
      '110208170=  OUT_SUMM_ TYPE OF MY_NUMERIC,'
      '110208171=  ROWCOL INTEGER,'
      '110208172=  Z_DATE VARCHAR(40),'
      '110208173=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110208174=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110208175=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110208176=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110208177=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM)'
      '110208178=AS'
      '110208179=/*'
      
        '110208180='#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071',' +
        ' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '110208181=*/'
      '110208182=DECLARE VARIABLE SORT_COL INTEGER;'
      '110208183=DECLARE VARIABLE DATE_STR VARCHAR(10);'
      '110208184=DECLARE VARIABLE Z_DATE_LOC DATE;'
      '110208185=DECLARE VARIABLE FIRST_ITER INTEGER = 0;'
      
        '110208186=DECLARE VARIABLE SUMM_PRIHOD_ TYPE OF NUMERIC_NULL = 0' +
        ';'
      
        '110208187=DECLARE VARIABLE SUMM_RASHOD_ TYPE OF NUMERIC_NULL = 0' +
        ';'
      
        '110208188=DECLARE VARIABLE SUMM_PRIHOD_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      
        '110208189=DECLARE VARIABLE SUMM_RASHOD_ALL_ TYPE OF NUMERIC_NULL' +
        ' = 0;'
      '110208190=BEGIN'
      
        '110208191=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '110208192=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM DATE_END_);'
      '110208193='
      '110208194=  SELECT S."INPUT"'
      '110208195=    FROM kassa_state S'
      '110208196=   WHERE S.k_date = :DATE_BEGIN_'
      '110208197=     AND S.g_tochka = :G_TOCHKA_'
      '110208198=    INTO :IN_SUMM_;'
      '110208199='
      '110208200=  IF (ROW_COUNT = 0) THEN'
      '110208201=    SELECT S."OUTPUT"'
      '110208202=      FROM kassa_state S'
      '110208203=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '110208204=                         FROM KASSA_STATE ST'
      '110208205=                        WHERE ST.k_date < :DATE_BEGIN_'
