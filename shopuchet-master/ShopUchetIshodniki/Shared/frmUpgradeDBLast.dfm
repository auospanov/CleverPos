      '110173112='
      '110173113=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '110173114=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110173115=  INCLUDE_NOL_ INTEGER,'
      '110173116=  INCLUDE_FEW_ INTEGER,'
      '110173117=  SORT_BY_NAME_ INTEGER,'
      
