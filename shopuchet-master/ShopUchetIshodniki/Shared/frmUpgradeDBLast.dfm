      '1102015212=               )'
      
        '1102015213=          AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||G.G_PRODU' +
        'CT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1102015214=                 OR'
      '1102015215=                 (:G_PRODUCT_ IS NULL)'
      '1102015216=               )'
      '1102015217=          AND ((EXISTS (SELECT 1'
      '1102015218=                           FROM SKLAD S'
      
        '1102015219=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1102015220=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1102015221=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102015222=                            AND S.DATE_RECEIPT BETWEE' +
        'N :DATE_BEGIN_ AND :DATE_END_) AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102015223=                  OR'
