      '110197807=  */'
      '110197808='
      
        '110197809=  SELECT SUBSTRING((SELECT LIST('#39'"'#39'||g.name||'#39'"'#39', '#39', '#39 +
        ')'
      '110197810=                    FROM g_product_kit K, g_product g'
      
        '110197811=                   WHERE K.g_product_item = :G_PRODUCT' +
        '_'
      
        '110197812=                     and k.g_product = g.g_product) FR' +
        'OM 1 FOR 999)'
      '110197813=  FROM RDB$DATABASE'
      '110197814=   INTO :PROD_NAME_;'
      '110197815=  if (PROD_NAME_ IS NOT NULL) then BEGIN'
      '110197816=    ERR_CODE = -20500;'
      
