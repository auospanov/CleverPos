        '1102011297=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102011298=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102011299=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102011300=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1102011301=      --=============================================' +
        '===================='
      '1102011302=      /*PNT_ = '#39'03.1'#39';'
      
        '1102011303=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ' AND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '1102011304=            KASSA_ = NULL;'
      '1102011305='
      '1102011306=            SELECT S.S_VALUE'
      '1102011307=              FROM SYSTEM_SETUP S'
      '1102011308=             WHERE S.SYSTEM_SETUP = 4'
      '1102011309=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102011310='
      '1102011311=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102011312=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102011313=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102011314='
      
        '1102011315=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' ' +
        #1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1102011316=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THE' +
        'N'
      
        '1102011317=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - D' +
        'ECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY ' +
        'FROM CURRENT_DATE)));'
      '1102011318='
      '1102011319=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102011320=            ELSE'
      
        '1102011321=               ACTION_DATE_ZP_ = Current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date -' +
        ' EXTRACT(DAY FROM current_date) + 32);'
      '1102011322='
      '1102011323=            SELECT K.KASSA, K.SUMM'
      '1102011324=            FROM KASSA K'
      '1102011325=            WHERE K.G_PRIHOD_RASHOD = -1'
      '1102011326=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102011327=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102011328=             AND K.G_TOCHKA = :G_TOCHKA_'
      '1102011329=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1102011330='
      
        '1102011331=            LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' ' +
        '|| EXTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FRO' +
        'M ACTION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) ||' +
        ' '#39'"'#39';'
      '1102011332='
      '1102011333=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '1102011334=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102011335=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1102011336=                                              -:SALES' +
        '_COMM_OLD_,'
      
        '1102011337=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1102011338=                                              :OFFICI' +
        'AL_NAME_,'
      
        '1102011339=                                              NULL,  ' +
        '   --:ZAKAZ_,'
      
        '1102011340=                                              NULL,  ' +
        '   --:SKLAD_,'
      '1102011341=                                              1,'
      
        '1102011342=                                              (SELECT' +
        ' ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1102011343=                                              :UPLOAD' +
        '_TO_EXT_APP_,'
      
        '1102011344=                                              :G_OFFI' +
        'CIAL_'
      
        '1102011345=                                              ) RETUR' +
        'NING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102011346=                LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102011347=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COM' +
        'M_OLD_ || '#39'".'#39';'
      '1102011348='
      '1102011349=            END ELSE'
      
        '1102011350=                SALES_COMM_OLD_ = SALES_COMM_SUMM_ITE' +
        'R_ - SALES_COMM_OLD_;'
      '1102011351=                LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1102011352=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39', '#1047#1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' |' +
        '| SALES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1102011353=                LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || ' +
        #39' '#1085#1072' "'#39' || SALES_COMM_OLD_ || '#39'".'#39';'
      '1102011354='
      
        '1102011355=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_' +
        ','
      
        '1102011356=                                              1,     ' +
        '-- ACTION_'
      
        '1102011357=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1102011358=                                              :SALES_' +
        'COMM_OLD_,'
      
