      '110237313=  SUMM_ALL_ NUMERIC(15,2),'
      '110237314=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110237315=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110237316=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110237317=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110237318=  PROFIT_ALL_ NUMERIC(15,2),'
      '110237319=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110237320=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      
        '110237321=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110237322=  SUMM NUMERIC(15,2),'
      '110237323=  NDS_SUMM NUMERIC(15,2),'
      '110237324=  SUM_SELF NUMERIC(15,2),'
      '110237325=  PROFIT NUMERIC(15,2),'
      '110237326=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110237327=  ERR_CODE INTEGER,'
      '110237328=  ERR_MSG VARCHAR(1024))'
      '110237329=AS'
      '110237330=/*'
