      '110193591=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '110193592=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '110193593=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '110193594=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      '110193595=  IS_MADE_ TYPE OF COLUMN REVISION_PARENT.IS_MADE)'
      '110193596=AS'
      '110193597=BEGIN'
      '110193598=  UPDATE REVISION_PARENT'
