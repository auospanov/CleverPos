        '1106020150=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106020151=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106020152=  end'
      '1106020153=end'
      '1106020154=;'
      '1106020155='
      '1106020156=ALTER PROCEDURE INV_GET_INVOICE('
      '1106020157=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '1106020158=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ)'
      '1106020159=RETURNS ('
      '1106020160=  NUM_ TYPE OF COLUMN INVOICE.NUM,'
      '1106020161=  INIT_DATE_ TYPE OF COLUMN INVOICE.INIT_DATE,'
      '1106020162=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106020163=  POSTAVSHIK_ TYPE OF COLUMN INVOICE.POSTAVSHIK,'
      '1106020164=  IDN_ TYPE OF COLUMN INVOICE.IDN,'
      '1106020165=  ADDRESS_ TYPE OF COLUMN INVOICE.ADDRESS,'
      '1106020166=  IIK_ TYPE OF COLUMN INVOICE.IIK,'
      '1106020167=  AGREEMENT_ TYPE OF COLUMN INVOICE.AGREEMENT,'
      
        '1106020168=  G_PAYMENT_TYPE_ TYPE OF COLUMN INVOICE.G_PAYMENT_TY' +
        'PE,'
      
        '1106020169=  PUNKT_NAZNACHENIYA_ TYPE OF COLUMN INVOICE.PUNKT_NA' +
        'ZNACHENIYA,'
      '1106020170=  DOVERENNOST_ TYPE OF COLUMN INVOICE.DOVERENNOST,'
      
        '1106020171=  SPOSOB_OTPRAVKI_ TYPE OF COLUMN INVOICE.SPOSOB_OTPR' +
        'AVKI,'
      '1106020172=  NAKLADNAYA_ TYPE OF COLUMN INVOICE.NAKLADNAYA,'
      
        '1106020173=  GRUZOOTPRAVITEL_ TYPE OF COLUMN INVOICE.GRUZOOTPRAV' +
        'ITEL,'
      
        '1106020174=  GRUZOPOLUCHATEL_ TYPE OF COLUMN INVOICE.GRUZOPOLUCH' +
        'ATEL,'
      
        '1106020175=  ADDRESS_POLUCHATELYA_ TYPE OF COLUMN INVOICE.ADDRES' +
        'S_POLUCHATELYA,'
      '1106020176=  G_CLIENT_ TYPE OF COLUMN INVOICE.G_CLIENT,'
      '1106020177=  CLIENT_NAME_ TYPE OF COLUMN INVOICE.CLIENT_NAME,'
      '1106020178=  IDN_CLIENT_ TYPE OF COLUMN INVOICE.IDN_CLIENT,'
      
        '1106020179=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE.ADDRESS_P' +
        'OKUPATEL,'
      '1106020180=  IIK_CLIENT_ TYPE OF COLUMN INVOICE.IIK_CLIENT,'
      
        '1106020181=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN INVOICE.G_OFFICI' +
        'AL_RUKOVOD,'
      
        '1106020182=  G_OFFICIAL_GB_ TYPE OF COLUMN INVOICE.G_OFFICIAL_GB' +
        ','
      '1106020183=  G_OFFICIAL_ TYPE OF COLUMN INVOICE.G_OFFICIAL,'
      '1106020184=  ZAKAZ_SAVED_ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1106020185=  ERR_CODE INTEGER,'
      '1106020186=  ERR_MSG VARCHAR(1024))'
      '1106020187=AS'
      
        '1106020188=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INV_GET_INV' +
        'OICE'#39';'
      '1106020189=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106020190=BEGIN'
      '1106020191=  SELECT'
      '1106020192=    t.NUM,'
      '1106020193=    t.INIT_DATE,'
      '1106020194=    T.G_FIRM,'
      '1106020195=    t.POSTAVSHIK,'
      '1106020196=    t.IDN,'
      '1106020197=    t.ADDRESS,'
      '1106020198=    t.IIK,'
      '1106020199=    t.AGREEMENT,'
      '1106020200=    t.G_PAYMENT_TYPE,'
      '1106020201=    t.PUNKT_NAZNACHENIYA,'
      '1106020202=    t.DOVERENNOST,'
      '1106020203=    t.SPOSOB_OTPRAVKI,'
      '1106020204=    t.NAKLADNAYA,'
      '1106020205=    t.GRUZOOTPRAVITEL,'
      '1106020206=    t.GRUZOPOLUCHATEL,'
      '1106020207=    t.ADDRESS_POLUCHATELYA,'
      '1106020208=    t.G_CLIENT,'
      '1106020209=    T.CLIENT_NAME,'
      '1106020210=    t.IDN_CLIENT,'
      '1106020211=    t.ADDRESS_POKUPATEL,'
      '1106020212=    t.IIK_CLIENT,'
      '1106020213=    t.G_OFFICIAL_RUKOVOD,'
      '1106020214=    t.G_OFFICIAL_GB,'
      '1106020215=    t.G_OFFICIAL,'
      '1106020216=    t.ZAKAZ'
      '1106020217=  FROM invoice t'
      '1106020218=  WHERE'
      '1106020219=    t.invoice = :invoice_'
      '1106020220=  INTO'
      '1106020221=    :NUM_,'
      '1106020222=    :INIT_DATE_,'
      '1106020223=    :G_FIRM_,'
      '1106020224=    :POSTAVSHIK_,'
      '1106020225=    :IDN_,'
      '1106020226=    :ADDRESS_,'
      '1106020227=    :IIK_,'
      '1106020228=    :AGREEMENT_,'
      '1106020229=    :G_PAYMENT_TYPE_,'
      '1106020230=    :PUNKT_NAZNACHENIYA_,'
      '1106020231=    :DOVERENNOST_,'
      '1106020232=    :SPOSOB_OTPRAVKI_,'
      '1106020233=    :NAKLADNAYA_,'
      '1106020234=    :GRUZOOTPRAVITEL_,'
      '1106020235=    :GRUZOPOLUCHATEL_,'
      '1106020236=    :ADDRESS_POLUCHATELYA_,'
      '1106020237=    :G_CLIENT_,'
      '1106020238=    :CLIENT_NAME_,'
      '1106020239=    :IDN_CLIENT_,'
      '1106020240=    :ADDRESS_POKUPATEL_,'
      '1106020241=    :IIK_CLIENT_,'
      '1106020242=    :G_OFFICIAL_RUKOVOD_,'
      '1106020243=    :G_OFFICIAL_GB_,'
      '1106020244=    :G_OFFICIAL_,'
      '1106020245=    :ZAKAZ_SAVED_;'
      '1106020246='
      '1106020247=  IF (ROW_COUNT = 0) then BEGIN'
      
        '1106020248=    --***********************************************' +
        '***'
      
        '1106020249=    -- '#1047#1053#1040#1063#1048#1058' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1040' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045 +
        ' '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1106020250=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1106020251=    SELECT'
      '1106020252=      G.g_firm_rekvizIT,'
      
        '1106020253=      G.NAME, --DECODE(G.IP_OR_JUR, 0, '#39#1048#1085#1076#1080#1074#1080#1076#1091#1072#1083#1100#1085#1099 +
        #1081' '#1087#1088#1077#1076#1087#1088#1080#1085#1080#1084#1072#1090#1077#1083#1100' '#39', '#39#1058#1054#1054' '#39')||G.NAME,'
      '1106020254=      G.IDN,'
      '1106020255=      AD.G_ADDRESS,'
      '1106020256=      AC.G_ACCOUNT,'
      
        '1106020257=      DECODE(G.IP_OR_JUR, 0, '#39#1048#1048#1053#39', 1, '#39#1041#1048#1053#39')||'#39': '#39'||' +
        'G.IDN||'#39', '#39'||G.NAME||'#39', '#39'||AD.ADDRESS'
      '1106020258=    FROM G_FIRM_REKVIZIT g'
      '1106020259=           LEFT OUTER JOIN (SELECT *'
      '1106020260=                              FROM G_FIRM_ADDRESS F'
      
        '1106020261=                             WHERE F.IS_DEFAULT = 1) ' +
        'AD ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT'
      '1106020262=           LEFT OUTER JOIN (SELECT A.G_ACCOUNT,'
      '1106020263=                                   A.ACCOUNT,'
      '1106020264=                                   A.G_FIRM_REKVIZIT,'
      '1106020265=                                   A.G_BANK,'
      '1106020266=                                   B.BIK, B.NAME'
      '1106020267=                              FROM G_FIRM_ACCOUNT A,'
      '1106020268=                                   G_BANK B'
      
        '1106020269=                             WHERE A.G_BANK = B.G_BAN' +
        'K'
      
        '1106020270=                               AND A.IS_DEFAULT = 1) ' +
        'AC ON G.G_FIRM_REKVIZIT = AC.G_FIRM_REKVIZIT'
      '1106020271=    WHERE G.IS_DEFAULT = 1'
      '1106020272=    INTO'
      '1106020273=      :g_firm_,'
      '1106020274=      :POSTAVSHIK_,'
      '1106020275=      :IDN_,'
      '1106020276=      :ADDRESS_,'
      '1106020277=      :IIK_,'
      '1106020278=      :GRUZOOTPRAVITEL_;'
      '1106020279='
      '1106020280=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '1106020281=    SELECT'
      '1106020282=      Z.Z_DATE,'
      '1106020283=      C.G_CLIENT,'
      
        '1106020284=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')), ' +
        '0, C.NAME, c.name_FULL),'
      '1106020285=      C.IDN,'
      '1106020286=      AD.G_ADDRESS,'
      
        '1106020287=      DECODE(CHAR_LENGTH(COALESCE(Z.OSNOVANIE, '#39#39')), ' +
        '0, '#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39', Z.OSNOVANIE),'
      '1106020288=      Z.G_PAYMENT_TYPE,'
      '1106020289=      AD.ADDRESS,'
      '1106020290=      AD.ADDRESS,'
      '1106020291=      '#39#1041#1077#1079' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080#39','
      '1106020292=      '#39#1057#1072#1084#1086#1074#1099#1074#1086#1079#39','
      
        '1106020293=      DECODE(CHAR_LENGTH(TRIM(C.IDN)), 0, '#39#39', '#39#1048#1048#1053'/'#1041#1048 +
        #1053': '#39'||TRIM(C.IDN)||'#39', '#39')||DECODE(CHAR_LENGTH(TRIM(COALESCE(C.NAM' +
        'E_FULL, '#39#39'))), 0, C.NAME, TRIM(C.NAME_FULL))||COALESCE('#39', '#39'||AD.' +
        'ADDRESS, '#39#39'),'
      '1106020294=      COALESCE(AC.G_ACCOUNT, null)'
      '1106020295=    FROM ZAKAZ Z LEFT OUTER JOIN (SELECT *'
      '1106020296=                                    FROM G_ADDRESS G'
      
        '1106020297=                                   WHERE G.IS_DEFAULT' +
        ' = 1) AD ON Z.G_CLIENT = AD.G_CLIENT'
      '1106020298=                 LEFT OUTER JOIN (SELECT *'
      '1106020299=                                    FROM G_ACCOUNT G'
      
        '1106020300=                                   WHERE G.IS_DEFAULT' +
        ' = 1) AC ON Z.G_CLIENT = AC.G_CLIENT,'
      '1106020301=         G_CLIENT C'
      '1106020302=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106020303=      AND Z.G_CLIENT = C.G_CLIENT'
      '1106020304=    INTO'
      '1106020305=      :INIT_DATE_,'
      '1106020306=      :G_CLIENT_,'
      '1106020307=      :CLIENT_NAME_,'
      '1106020308=      :IDN_CLIENT_,'
      '1106020309=      :ADDRESS_POKUPATEL_,'
      '1106020310=      :AGREEMENT_,'
      '1106020311=      :G_PAYMENT_TYPE_,'
      '1106020312=      :PUNKT_NAZNACHENIYA_,'
      '1106020313=      :ADDRESS_POLUCHATELYA_,'
      '1106020314=      :DOVERENNOST_,'
      '1106020315=      :SPOSOB_OTPRAVKI_,'
      '1106020316=      :GRUZOPOLUCHATEL_,'
      '1106020317=      :IIK_CLIENT_;'
      '1106020318='
      
        '1106020319=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058 +
        #1054#1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '1106020320=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054 +
        ' '#1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '1106020321=    PNT_ = '#39'05'#39';'
      '1106020322=    SELECT C.id'
      '1106020323=      FROM cur_params C'
      '1106020324=     WHERE C.cur_params = 1'
      '1106020325=    INTO :G_OFFICIAL_;'
      '1106020326='
      '1106020327=    IF (ROW_COUNT = 0) then BEGIN'
      '1106020328=        SELECT MIN(O.G_OFFICIAL)'
      '1106020329=          FROM G_OFFICIAL O'
      '1106020330=          INTO :G_OFFICIAL_;'
      '1106020331=        IF (ROW_COUNT = 0) then BEGIN'
      '1106020332=            Err_Code = -20500;'
      
        '1106020333=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1057#1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '1106020334=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106020335=            EXIT;'
      '1106020336=        END'
      '1106020337=    END'
      '1106020338='
      '1106020339=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '1106020340=    SELECT O.G_OFFICIAL'
      '1106020341=    FROM G_OFFICIAL O'
      '1106020342=    WHERE O.IS_RUKOVODITEL = 1'
      '1106020343=    INTO :G_OFFICIAL_RUKOVOD_;'
      '1106020344='
      '1106020345=    --'#1048#1065#1059' '#1043#1051#1040#1042#1041#1059#1061#1040
      '1106020346=    SELECT O.G_OFFICIAL'
      '1106020347=    FROM G_OFFICIAL O'
      '1106020348=    WHERE O.IS_GLAVBUH = 1'
      '1106020349=    INTO :G_OFFICIAL_GB_;'
      '1106020350='
      
        '1106020351=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059', '#1057#1053#1040#1063#1040#1051#1040 +
        ' '#1057#1044#1045#1051#1040#1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '1106020352=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '1106020353=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VA' +
        'RCHAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '1106020354=      FROM INVOICE P'
      '1106020355=    INTO :NUM_;'
      '1106020356='
      
        '1106020357=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059 +
        ' '#1042#1054#1054#1041#1065#1045' '#1053#1045#1058
      '1106020358=      NUM_ = '#39'1'#39';'
      '1106020359=  END'
      '1106020360=END'
      '1106020361=;'
      '1106020362='
      '1106020363=ALTER PROCEDURE INV_GET_INVOICE_PAY('
      
        '1106020364=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY' +
        ','
      '1106020365=  ZAKAZ_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ)'
      '1106020366=RETURNS ('
      '1106020367=  INIT_DATE_ TYPE OF COLUMN INVOICE_PAY.INIT_DATE,'
      '1106020368=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106020369=  POSTAVSHIK_ TYPE OF COLUMN INVOICE_PAY.POSTAVSHIK,'
      '1106020370=  IDN_ TYPE OF COLUMN INVOICE_PAY.IDN,'
      '1106020371=  ADDRESS_ TYPE OF COLUMN INVOICE_PAY.ADDRESS,'
      '1106020372=  IIK_ TYPE OF COLUMN INVOICE_PAY.IIK,'
      '1106020373=  BANK_NAME_ TYPE OF COLUMN INVOICE_PAY.BANK_NAME,'
      '1106020374=  BIK_ TYPE OF COLUMN INVOICE_PAY.BIK,'
      '1106020375=  KBE_ TYPE OF COLUMN INVOICE_PAY.KBE,'
      '1106020376=  KNP_ TYPE OF COLUMN INVOICE_PAY.KNP,'
      '1106020377=  G_CLIENT_ID_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1106020378=  G_CLIENT_ TYPE OF COLUMN INVOICE_PAY.G_CLIENT,'
      '1106020379=  IDN_CLIENT_ TYPE OF COLUMN INVOICE_PAY.IDN_CLIENT,'
      
        '1106020380=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE_PAY.ADDRE' +
        'SS_POKUPATEL,'
      '1106020381=  AGREEMENT_ TYPE OF COLUMN INVOICE_PAY.AGREEMENT,'
      '1106020382=  G_OFFICIAL_ TYPE OF COLUMN INVOICE_PAY.G_OFFICIAL,'
      '1106020383=  NUM_ TYPE OF COLUMN INVOICE_PAY.NUM,'
      '1106020384=  ZAKAZ_SAVED_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ,'
      '1106020385=  ERR_CODE INTEGER,'
      '1106020386=  ERR_MSG VARCHAR(1024))'
      '1106020387=AS'
      
        '1106020388=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INV_GET_INV' +
        'OICE_PAY'#39';'
      '1106020389=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106020390=BEGIN'
      '1106020391=  SELECT'
      '1106020392=    t.INIT_DATE,'
      '1106020393=    T.G_FIRM,'
      '1106020394=    t.POSTAVSHIK,'
      '1106020395=    t.IDN,'
      '1106020396=    t.ADDRESS,'
      '1106020397=    t.IIK,'
      '1106020398=    t.BANK_NAME,'
      '1106020399=    t.BIK,'
      '1106020400=    t.KBE,'
      '1106020401=    t.KNP,'
      '1106020402=    t.G_CLIENT,'
      '1106020403=    t.IDN_CLIENT,'
      '1106020404=    t.ADDRESS_POKUPATEL,'
      '1106020405=    t.AGREEMENT,'
      '1106020406=    t.G_OFFICIAL,'
      '1106020407=    t.ZAKAZ,'
      '1106020408=    t.NUM,'
      '1106020409=    G.g_client'
      
        '1106020410=  FROM invoice_pay t LEFT OUTER JOIN g_address G ON T' +
        '.address_pokupatel = G.g_address'
      '1106020411=  WHERE t.invoice_pay = :invoice_pay_'
      '1106020412=  INTO'
      '1106020413=    INIT_DATE_,'
      '1106020414=    G_FIRM_,'
      '1106020415=    POSTAVSHIK_,'
      '1106020416=    IDN_,'
      '1106020417=    ADDRESS_,'
      '1106020418=    IIK_,'
      '1106020419=    BANK_NAME_,'
      '1106020420=    BIK_,'
      '1106020421=    KBE_,'
      '1106020422=    KNP_,'
      '1106020423=    G_CLIENT_,'
      '1106020424=    IDN_CLIENT_,'
      '1106020425=    ADDRESS_POKUPATEL_,'
      '1106020426=    AGREEMENT_,'
      '1106020427=    G_OFFICIAL_,'
      '1106020428=    ZAKAZ_SAVED_,'
      '1106020429=    NUM_,'
      '1106020430=    G_CLIENT_ID_;'
      '1106020431='
      '1106020432=  IF (ROW_COUNT = 0) then BEGIN'
      
        '1106020433=    --***********************************************' +
        '***'
      
        '1106020434=    -- '#1047#1053#1040#1063#1048#1058' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1040' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045 +
        ' '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1106020435=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1106020436=    SELECT'
      '1106020437=      G.g_firm_rekvizit,'
      '1106020438=      G.NAME,'
      '1106020439=      G.IDN,'
      '1106020440=      AD.G_ADDRESS,'
      '1106020441=      AC.G_ACCOUNT,'
      '1106020442=      AC.NAME,'
      '1106020443=      AC.BIK,'
      '1106020444=      G.KBE'
      '1106020445=    FROM G_FIRM_REKVIZIT g LEFT OUTER JOIN'
      '1106020446=         (SELECT A.G_ACCOUNT,'
      '1106020447=                 A.ACCOUNT,'
      '1106020448=                 A.G_FIRM_REKVIZIT,'
      '1106020449=                 A.G_BANK,'
      '1106020450=                 B.BIK, B.NAME'
      '1106020451=            FROM G_FIRM_ACCOUNT A,'
      '1106020452=                 G_BANK B'
      '1106020453=           WHERE A.G_BANK = B.G_BANK'
      
        '1106020454=             AND A.IS_DEFAULT = 1) AC ON G.G_FIRM_REK' +
        'VIZIT = AC.G_FIRM_REKVIZIT'
      '1106020455=         LEFT OUTER JOIN (SELECT *'
      '1106020456=                            FROM G_FIRM_ADDRESS F'
      
        '1106020457=                           WHERE F.IS_DEFAULT = 1) AD' +
        ' ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT'
      '1106020458=    WHERE G.IS_DEFAULT = 1'
      '1106020459=    INTO'
      '1106020460=      :g_firm_,'
      '1106020461=      :POSTAVSHIK_,'
      '1106020462=      :IDN_,'
      '1106020463=      :ADDRESS_,'
      '1106020464=      :IIK_,'
      '1106020465=      :BANK_NAME_,'
      '1106020466=      :BIK_,'
      '1106020467=      :KBE_;'
      '1106020468='
      '1106020469=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '1106020470=    SELECT'
      '1106020471=      Z.Z_DATE,'
      
        '1106020472=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')), ' +
        '0, C.NAME, c.name_FULL),'
      '1106020473=      C.IDN,'
      '1106020474=      C.g_client,'
      '1106020475=      C.name,'
      '1106020476=      AD.G_ADDRESS,'
      '1106020477=      Z.OSNOVANIE'
      '1106020478=    FROM ZAKAZ Z,'
      '1106020479=         G_CLIENT C LEFT OUTER JOIN'
      '1106020480=         (SELECT *'
      '1106020481=            FROM G_ADDRESS G'
      
        '1106020482=           WHERE G.IS_DEFAULT = 1) AD ON C.G_CLIENT =' +
        ' AD.G_CLIENT'
      '1106020483=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106020484=     AND Z.G_CLIENT = C.G_CLIENT'
      '1106020485=    INTO'
      '1106020486=      :INIT_DATE_,'
      '1106020487=      :G_CLIENT_,'
      '1106020488=      :IDN_CLIENT_,'
      '1106020489=      :G_CLIENT_ID_,'
      '1106020490=      :g_client_,'
      '1106020491=      :ADDRESS_POKUPATEL_,'
      '1106020492=      :AGREEMENT_;'
      '1106020493='
      
        '1106020494=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058 +
        #1054#1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '1106020495=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054 +
        ' '#1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '1106020496=    PNT_ = '#39'05'#39';'
      '1106020497=    SELECT C.id'
      '1106020498=      FROM cur_params C'
      '1106020499=     WHERE C.cur_params = 1'
      '1106020500=    INTO :G_OFFICIAL_;'
      '1106020501='
      '1106020502=    IF (ROW_COUNT = 0) then BEGIN'
      '1106020503=        SELECT MIN(O.G_OFFICIAL)'
      '1106020504=          FROM G_OFFICIAL O'
      '1106020505=          INTO :G_OFFICIAL_;'
      '1106020506=        IF (ROW_COUNT = 0) then BEGIN'
      '1106020507=            Err_Code = -20500;'
      
        '1106020508=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1057#1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '1106020509=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106020510=            EXIT;'
      '1106020511=        END'
      '1106020512=    END'
      '1106020513='
      
        '1106020514=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059', '#1057#1053#1040#1063#1040#1051#1040 +
        ' '#1057#1044#1045#1051#1040#1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '1106020515=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '1106020516=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VA' +
        'RCHAR(20)) -- NVL '#1055#1054#1057#1058#1040#1042#1048#1051
      '1106020517=      FROM INVOICE_PAY P'
      '1106020518=    INTO :NUM_;'
      '1106020519='
      
        '1106020520=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059 +
        ' '#1042#1054#1054#1041#1065#1045' '#1053#1045#1058
      '1106020521=      NUM_ = '#39'1'#39';'
      '1106020522=  END'
      '1106020523=END'
      '1106020524=;'
      '1106020525='
      '1106020526=ALTER PROCEDURE INV_INS_INVOICE('
      '1106020527=  NUM_ TYPE OF COLUMN INVOICE.NUM,'
      '1106020528=  INIT_DATE_ TYPE OF COLUMN INVOICE.INIT_DATE,'
      '1106020529=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106020530=  POSTAVSHIK_ TYPE OF COLUMN INVOICE.POSTAVSHIK,'
      '1106020531=  IDN_ TYPE OF COLUMN INVOICE.IDN,'
      '1106020532=  ADDRESS_ TYPE OF COLUMN INVOICE.ADDRESS,'
      '1106020533=  IIK_ TYPE OF COLUMN INVOICE.IIK,'
      '1106020534=  AGREEMENT_ TYPE OF COLUMN INVOICE.AGREEMENT,'
      
        '1106020535=  G_PAYMENT_TYPE_ TYPE OF COLUMN INVOICE.G_PAYMENT_TY' +
        'PE,'
      
        '1106020536=  PUNKT_NAZNACHENIYA_ TYPE OF COLUMN INVOICE.PUNKT_NA' +
        'ZNACHENIYA,'
      '1106020537=  DOVERENNOST_ TYPE OF COLUMN INVOICE.DOVERENNOST,'
      
        '1106020538=  SPOSOB_OTPRAVKI_ TYPE OF COLUMN INVOICE.SPOSOB_OTPR' +
        'AVKI,'
      '1106020539=  NAKLADNAYA_ TYPE OF COLUMN INVOICE.NAKLADNAYA,'
      
        '1106020540=  GRUZOOTPRAVITEL_ TYPE OF COLUMN INVOICE.GRUZOOTPRAV' +
        'ITEL,'
      
        '1106020541=  GRUZOPOLUCHATEL_ TYPE OF COLUMN INVOICE.GRUZOPOLUCH' +
        'ATEL,'
      
        '1106020542=  ADDRESS_POLUCHATELYA_ TYPE OF COLUMN INVOICE.ADDRES' +
        'S_POLUCHATELYA,'
      '1106020543=  G_CLIENT_ TYPE OF COLUMN INVOICE.G_CLIENT,'
      '1106020544=  CLIENT_NAME_ TYPE OF COLUMN INVOICE.CLIENT_NAME,'
      '1106020545=  IDN_CLIENT_ TYPE OF COLUMN INVOICE.IDN_CLIENT,'
      
        '1106020546=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE.ADDRESS_P' +
        'OKUPATEL,'
      '1106020547=  IIK_CLIENT_ TYPE OF COLUMN INVOICE.IIK_CLIENT,'
      
        '1106020548=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN INVOICE.G_OFFICI' +
        'AL_RUKOVOD,'
      
        '1106020549=  G_OFFICIAL_GB_ TYPE OF COLUMN INVOICE.G_OFFICIAL_GB' +
        ','
      '1106020550=  G_OFFICIAL_ TYPE OF COLUMN INVOICE.G_OFFICIAL,'
      '1106020551=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ)'
      '1106020552=RETURNS ('
      '1106020553=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '1106020554=  ERR_CODE INTEGER,'
      '1106020555=  ERR_MSG VARCHAR(1024))'
      '1106020556=AS'
      
        '1106020557=declare variable PROCNAME varchar(255) = '#39'INV_INS_INV' +
        'OICE'#39';'
      '1106020558=declare variable PNT_ varchar(5);'
      '1106020559=BEGIN'
      '1106020560=  INSERT INTO invoice'
      '1106020561=  ('
      '1106020562=   INVOICE,'
      '1106020563=   NUM,'
      '1106020564=   INIT_DATE,'
      '1106020565=   G_FIRM,'
      '1106020566=   POSTAVSHIK,'
      '1106020567=   IDN,'
      '1106020568=   ADDRESS,'
      '1106020569=   IIK,'
      '1106020570=   AGREEMENT,'
      '1106020571=   G_PAYMENT_TYPE,'
      '1106020572=   PUNKT_NAZNACHENIYA,'
      '1106020573=   DOVERENNOST,'
      '1106020574=   SPOSOB_OTPRAVKI,'
      '1106020575=   NAKLADNAYA,'
      '1106020576=   GRUZOOTPRAVITEL,'
      '1106020577=   GRUZOPOLUCHATEL,'
      '1106020578=   ADDRESS_POLUCHATELYA,'
      '1106020579=   G_CLIENT,'
      '1106020580=   CLIENT_NAME,'
      '1106020581=   IDN_CLIENT,'
      '1106020582=   ADDRESS_POKUPATEL,'
      '1106020583=   IIK_CLIENT,'
      '1106020584=   G_OFFICIAL_RUKOVOD,'
      '1106020585=   G_OFFICIAL_GB,'
      '1106020586=   G_OFFICIAL,'
      '1106020587=   ZAKAZ'
      '1106020588=  ) VALUES ('
      '1106020589=   GEN_ID(GEN_invoice, 1),'
      '1106020590=   :NUM_,'
      '1106020591=   :INIT_DATE_,'
      '1106020592=   :g_firm_,'
      '1106020593=   :POSTAVSHIK_,'
      '1106020594=   :IDN_,'
      '1106020595=   :ADDRESS_,'
      '1106020596=   :IIK_,'
      '1106020597=   :AGREEMENT_,'
      '1106020598=   :G_PAYMENT_TYPE_,'
      '1106020599=   :PUNKT_NAZNACHENIYA_,'
      '1106020600=   :DOVERENNOST_,'
      '1106020601=   :SPOSOB_OTPRAVKI_,'
      '1106020602=   :NAKLADNAYA_,'
      '1106020603=   :GRUZOOTPRAVITEL_,'
      '1106020604=   :GRUZOPOLUCHATEL_,'
      '1106020605=   :ADDRESS_POLUCHATELYA_,'
      '1106020606=   :G_CLIENT_,'
      '1106020607=   :CLIENT_NAME_,'
      '1106020608=   :IDN_CLIENT_,'
      '1106020609=   :ADDRESS_POKUPATEL_,'
      '1106020610=   :IIK_CLIENT_,'
      '1106020611=   :G_OFFICIAL_RUKOVOD_,'
      '1106020612=   :G_OFFICIAL_GB_,'
      '1106020613=   :G_OFFICIAL_,'
      '1106020614=   :ZAKAZ_'
      '1106020615=  )'
      '1106020616=  RETURNING'
      '1106020617=    invoice'
      '1106020618=  INTO'
      '1106020619=    :invoice_;'
      '1106020620=END'
      '1106020621=;'
      '1106020622='
      '1106020623=ALTER PROCEDURE INV_INS_INVOICE_PAY('
      '1106020624=  INIT_DATE_ TYPE OF COLUMN INVOICE_PAY.INIT_DATE,'
      '1106020625=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106020626=  POSTAVSHIK_ TYPE OF COLUMN INVOICE_PAY.POSTAVSHIK,'
      '1106020627=  IDN_ TYPE OF COLUMN INVOICE_PAY.IDN,'
      '1106020628=  ADDRESS_ TYPE OF COLUMN INVOICE_PAY.ADDRESS,'
      '1106020629=  IIK_ TYPE OF COLUMN INVOICE_PAY.IIK,'
      '1106020630=  BANK_NAME_ TYPE OF COLUMN INVOICE_PAY.BANK_NAME,'
      '1106020631=  BIK_ TYPE OF COLUMN INVOICE_PAY.BIK,'
      '1106020632=  KBE_ TYPE OF COLUMN INVOICE_PAY.KBE,'
      '1106020633=  KNP_ TYPE OF COLUMN INVOICE_PAY.KNP,'
      '1106020634=  G_CLIENT_ TYPE OF COLUMN INVOICE_PAY.G_CLIENT,'
      '1106020635=  IDN_CLIENT_ TYPE OF COLUMN INVOICE_PAY.IDN_CLIENT,'
      
        '1106020636=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE_PAY.ADDRE' +
        'SS_POKUPATEL,'
      '1106020637=  AGREEMENT_ TYPE OF COLUMN INVOICE_PAY.AGREEMENT,'
      '1106020638=  G_OFFICIAL_ TYPE OF COLUMN INVOICE_PAY.G_OFFICIAL,'
      '1106020639=  NUM_ TYPE OF COLUMN INVOICE_PAY.NUM,'
      '1106020640=  ZAKAZ_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ)'
      '1106020641=RETURNS ('
      
        '1106020642=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY' +
        ','
      '1106020643=  ERR_CODE INTEGER,'
      '1106020644=  ERR_MSG VARCHAR(1024))'
      '1106020645=AS'
      
        '1106020646=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INV_INS_INV' +
        'OICE_PAY'#39';'
      '1106020647=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106020648=BEGIN'
      '1106020649=  INSERT INTO invoice_pay'
      '1106020650=  ('
      '1106020651=   INIT_DATE,'
      '1106020652=   G_FIRM,'
      '1106020653=   POSTAVSHIK,'
      '1106020654=   IDN,'
      '1106020655=   ADDRESS,'
      '1106020656=   IIK,'
      '1106020657=   BANK_NAME,'
      '1106020658=   BIK,'
      '1106020659=   KBE,'
      '1106020660=   KNP,'
      '1106020661=   G_CLIENT,'
      '1106020662=   IDN_CLIENT,'
      '1106020663=   ADDRESS_POKUPATEL,'
      '1106020664=   AGREEMENT,'
      '1106020665=   G_OFFICIAL,'
      '1106020666=   ZAKAZ,'
      '1106020667=   INVOICE_PAY,'
      '1106020668=   NUM'
      '1106020669=  ) VALUES ('
      '1106020670=   :INIT_DATE_,'
      '1106020671=   :G_FIRM_,'
      '1106020672=   :POSTAVSHIK_,'
      '1106020673=   :IDN_,'
      '1106020674=   :ADDRESS_,'
      '1106020675=   :IIK_,'
      '1106020676=   :BANK_NAME_,'
      '1106020677=   :BIK_,'
      '1106020678=   :KBE_,'
      '1106020679=   :KNP_,'
      '1106020680=   :G_CLIENT_,'
      '1106020681=   :IDN_CLIENT_,'
      '1106020682=   :ADDRESS_POKUPATEL_,'
      '1106020683=   :AGREEMENT_,'
      '1106020684=   :G_OFFICIAL_,'
      '1106020685=   :ZAKAZ_,'
      '1106020686=   GEN_ID(GEN_Invoice_pay, 1),'
      '1106020687=   :NUM_'
      '1106020688=  )'
      '1106020689=  RETURNING'
      '1106020690=    invoice_pay'
      '1106020691=  INTO'
      '1106020692=    :invoice_pay_;'
      '1106020693=END'
      '1106020694=;'
      '1106020695='
      '1106020696=ALTER PROCEDURE INV_READ_INVOICE_LIST'
      '1106020697=RETURNS ('
      '1106020698=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '1106020699=  NUM TYPE OF COLUMN INVOICE.NUM,'
      '1106020700=  INIT_DATE TYPE OF COLUMN INVOICE.INIT_DATE,'
      '1106020701=  G_FIRM TYPE OF COLUMN INVOICE.G_FIRM,'
      '1106020702=  POSTAVSHIK TYPE OF COLUMN INVOICE.POSTAVSHIK,'
      '1106020703=  IDN TYPE OF COLUMN INVOICE.IDN,'
      '1106020704=  ADDRESS TYPE OF COLUMN INVOICE.ADDRESS,'
      '1106020705=  IIK TYPE OF COLUMN INVOICE.IIK,'
      '1106020706=  AGREEMENT TYPE OF COLUMN INVOICE.AGREEMENT,'
      
        '1106020707=  G_PAYMENT_TYPE TYPE OF COLUMN INVOICE.G_PAYMENT_TYP' +
        'E,'
      
        '1106020708=  PUNKT_NAZNACHENIYA TYPE OF COLUMN INVOICE.PUNKT_NAZ' +
        'NACHENIYA,'
      '1106020709=  DOVERENNOST TYPE OF COLUMN INVOICE.DOVERENNOST,'
      
        '1106020710=  SPOSOB_OTPRAVKI TYPE OF COLUMN INVOICE.SPOSOB_OTPRA' +
        'VKI,'
      '1106020711=  NAKLADNAYA TYPE OF COLUMN INVOICE.NAKLADNAYA,'
      
        '1106020712=  GRUZOOTPRAVITEL TYPE OF COLUMN INVOICE.GRUZOOTPRAVI' +
        'TEL,'
      
        '1106020713=  GRUZOPOLUCHATEL TYPE OF COLUMN INVOICE.GRUZOPOLUCHA' +
        'TEL,'
      
        '1106020714=  ADDRESS_POLUCHATELYA TYPE OF COLUMN INVOICE.ADDRESS' +
        '_POLUCHATELYA,'
      '1106020715=  G_CLIENT TYPE OF COLUMN INVOICE.G_CLIENT,'
      '1106020716=  CLIENT_NAME TYPE OF COLUMN INVOICE.CLIENT_NAME,'
      '1106020717=  IDN_CLIENT TYPE OF COLUMN INVOICE.IDN_CLIENT,'
      
        '1106020718=  ADDRESS_POKUPATEL TYPE OF COLUMN INVOICE.ADDRESS_PO' +
        'KUPATEL,'
      '1106020719=  IIK_CLIENT TYPE OF COLUMN INVOICE.IIK_CLIENT,'
      
        '1106020720=  G_OFFICIAL_RUKOVOD TYPE OF COLUMN INVOICE.G_OFFICIA' +
        'L_RUKOVOD,'
      '1106020721=  G_OFFICIAL_GB TYPE OF COLUMN INVOICE.G_OFFICIAL_GB,'
      '1106020722=  G_OFFICIAL TYPE OF COLUMN INVOICE.G_OFFICIAL,'
      '1106020723=  ZAKAZ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1106020724=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC)'
      '1106020725=AS'
      '1106020726=begin'
      '1106020727=  FOR SELECT t.*,'
      '1106020728=           G.fio_doc'
      '1106020729=      FROM invoice t,'
      '1106020730=           G_OFFICIAL G,'
      '1106020731=           ZAKAZ Z'
      '1106020732=     WHERE T.G_OFFICIAL = G.G_OFFICIAL'
      '1106020733=       AND T.ZAKAZ = Z.ZAKAZ'
      
        '1106020734=       AND Z.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1106020735=     ORDER BY T.INIT_DATE, T.INVOICE'
      '1106020736=  INTO :INVOICE,'
      '1106020737=    :NUM,'
      '1106020738=    :INIT_DATE,'
      '1106020739=    :POSTAVSHIK,'
      '1106020740=    :IDN,'
      '1106020741=    :ADDRESS,'
      '1106020742=    :IIK,'
      '1106020743=    :AGREEMENT,'
      '1106020744=    :G_PAYMENT_TYPE,'
      '1106020745=    :PUNKT_NAZNACHENIYA,'
      '1106020746=    :DOVERENNOST,'
      '1106020747=    :SPOSOB_OTPRAVKI,'
      '1106020748=    :NAKLADNAYA,'
      '1106020749=    :GRUZOOTPRAVITEL,'
      '1106020750=    :GRUZOPOLUCHATEL,'
      '1106020751=    :ADDRESS_POLUCHATELYA,'
      '1106020752=    :G_CLIENT,'
      '1106020753=    :CLIENT_NAME,'
      '1106020754=    :IDN_CLIENT,'
      '1106020755=    :ADDRESS_POKUPATEL,'
      '1106020756=    :IIK_CLIENT,'
      '1106020757=    :G_OFFICIAL_RUKOVOD,'
      '1106020758=    :G_OFFICIAL_GB,'
      '1106020759=    :G_OFFICIAL,'
      '1106020760=    :ZAKAZ,'
      '1106020761=    :G_FIRM,'
      '1106020762=    :FIO_DOC'
      '1106020763=  DO SUSPEND;'
      '1106020764=end'
      '1106020765=;'
      '1106020766='
      '1106020767=ALTER PROCEDURE INV_READ_INVOICE_PAY_LIST'
      '1106020768=RETURNS ('
      '1106020769=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '1106020770=  NUM TYPE OF COLUMN INVOICE_PAY.NUM,'
      '1106020771=  INIT_DATE TYPE OF COLUMN INVOICE_PAY.INIT_DATE,'
      '1106020772=  G_FIRM TYPE OF COLUMN INVOICE_PAY.G_FIRM,'
      '1106020773=  POSTAVSHIK TYPE OF COLUMN INVOICE_PAY.POSTAVSHIK,'
      '1106020774=  IDN TYPE OF COLUMN INVOICE_PAY.IDN,'
      '1106020775=  ADDRESS TYPE OF COLUMN INVOICE_PAY.ADDRESS,'
      '1106020776=  IIK TYPE OF COLUMN INVOICE_PAY.IIK,'
      '1106020777=  BANK_NAME TYPE OF COLUMN INVOICE_PAY.BANK_NAME,'
      '1106020778=  BIK TYPE OF COLUMN INVOICE_PAY.BIK,'
      '1106020779=  KBE TYPE OF COLUMN INVOICE_PAY.KBE,'
      '1106020780=  KNP TYPE OF COLUMN INVOICE_PAY.KNP,'
      '1106020781=  G_CLIENT TYPE OF COLUMN INVOICE_PAY.G_CLIENT,'
      '1106020782=  IDN_CLIENT TYPE OF COLUMN INVOICE_PAY.IDN_CLIENT,'
      
        '1106020783=  ADDRESS_POKUPATEL TYPE OF COLUMN INVOICE_PAY.ADDRES' +
        'S_POKUPATEL,'
      '1106020784=  AGREEMENT TYPE OF COLUMN INVOICE_PAY.AGREEMENT,'
      '1106020785=  G_OFFICIAL TYPE OF COLUMN INVOICE_PAY.G_OFFICIAL,'
      '1106020786=  ZAKAZ TYPE OF COLUMN INVOICE_PAY.ZAKAZ,'
      '1106020787=  ADDRESS_STR VARCHAR(1000),'
      '1106020788=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC)'
      '1106020789=AS'
      '1106020790=begin'
      '1106020791=  FOR SELECT T.*,'
      '1106020792=           CA.ADDRESS ADDRESS_STR,'
      '1106020793=           O.FIO_DOC'
      '1106020794=      FROM INVOICE_PAY T'
      
        '1106020795=             LEFT OUTER JOIN G_FIRM_ADDRESS AD ON T.A' +
        'DDRESS = AD.G_ADDRESS'
      
        '1106020796=             LEFT OUTER JOIN G_FIRM_ACCOUNT AC ON T.I' +
        'IK = AC.G_ACCOUNT'
      
        '1106020797=             LEFT OUTER JOIN G_ADDRESS CA ON T.ADDRES' +
        'S_POKUPATEL = CA.G_ADDRESS,'
      '1106020798=           G_OFFICIAL O,'
      '1106020799=           ZAKAZ Z'
      '1106020800=     WHERE T.G_OFFICIAL = O.G_OFFICIAL'
      '1106020801=       AND T.ZAKAZ = Z.ZAKAZ'
      
        '1106020802=       AND Z.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1106020803=    ORDER BY T.INIT_DATE, T.INVOICE_PAY'
      '1106020804=  INTO :INVOICE_PAY,'
      '1106020805=    :NUM,'
      '1106020806=    :INIT_DATE,'
      '1106020807=    :POSTAVSHIK,'
      '1106020808=    :IDN,'
      '1106020809=    :ADDRESS,'
      '1106020810=    :IIK,'
      '1106020811=    :BANK_NAME,'
      '1106020812=    :BIK,'
      '1106020813=    :KBE,'
      '1106020814=    :KNP,'
      '1106020815=    :G_CLIENT,'
      '1106020816=    :IDN_CLIENT,'
      '1106020817=    :ADDRESS_POKUPATEL,'
      '1106020818=    :AGREEMENT,'
      '1106020819=    :G_OFFICIAL,'
      '1106020820=    :ZAKAZ,'
      '1106020821=    :G_FIRM,'
      '1106020822=    :ADDRESS_STR,'
      '1106020823=    :FIO_DOC'
      '1106020824=  DO SUSPEND;'
      '1106020825=end'
      '1106020826=;'
      '1106020827='
      '1106020828=ALTER PROCEDURE INV_UPD_INVOICE('
      '1106020829=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '1106020830=  NUM_ TYPE OF COLUMN INVOICE.NUM,'
      '1106020831=  INIT_DATE_ TYPE OF COLUMN INVOICE.INIT_DATE,'
      '1106020832=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106020833=  POSTAVSHIK_ TYPE OF COLUMN INVOICE.POSTAVSHIK,'
      '1106020834=  IDN_ TYPE OF COLUMN INVOICE.IDN,'
      '1106020835=  ADDRESS_ TYPE OF COLUMN INVOICE.ADDRESS,'
      '1106020836=  IIK_ TYPE OF COLUMN INVOICE.IIK,'
      '1106020837=  AGREEMENT_ TYPE OF COLUMN INVOICE.AGREEMENT,'
      
        '1106020838=  G_PAYMENT_TYPE_ TYPE OF COLUMN INVOICE.G_PAYMENT_TY' +
        'PE,'
      
        '1106020839=  PUNKT_NAZNACHENIYA_ TYPE OF COLUMN INVOICE.PUNKT_NA' +
        'ZNACHENIYA,'
      '1106020840=  DOVERENNOST_ TYPE OF COLUMN INVOICE.DOVERENNOST,'
      
        '1106020841=  SPOSOB_OTPRAVKI_ TYPE OF COLUMN INVOICE.SPOSOB_OTPR' +
        'AVKI,'
      '1106020842=  NAKLADNAYA_ TYPE OF COLUMN INVOICE.NAKLADNAYA,'
      
        '1106020843=  GRUZOOTPRAVITEL_ TYPE OF COLUMN INVOICE.GRUZOOTPRAV' +
        'ITEL,'
      
        '1106020844=  GRUZOPOLUCHATEL_ TYPE OF COLUMN INVOICE.GRUZOPOLUCH' +
        'ATEL,'
      
        '1106020845=  ADDRESS_POLUCHATELYA_ TYPE OF COLUMN INVOICE.ADDRES' +
        'S_POLUCHATELYA,'
      '1106020846=  G_CLIENT_ TYPE OF COLUMN INVOICE.G_CLIENT,'
      '1106020847=  CLIENT_NAME_ TYPE OF COLUMN INVOICE.CLIENT_NAME,'
      '1106020848=  IDN_CLIENT_ TYPE OF COLUMN INVOICE.IDN_CLIENT,'
      
        '1106020849=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE.ADDRESS_P' +
        'OKUPATEL,'
      '1106020850=  IIK_CLIENT_ TYPE OF COLUMN INVOICE.IIK_CLIENT,'
      
        '1106020851=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN INVOICE.G_OFFICI' +
        'AL_RUKOVOD,'
      
        '1106020852=  G_OFFICIAL_GB_ TYPE OF COLUMN INVOICE.G_OFFICIAL_GB' +
        ','
      '1106020853=  G_OFFICIAL_ TYPE OF COLUMN INVOICE.G_OFFICIAL,'
      '1106020854=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ)'
      '1106020855=RETURNS ('
      '1106020856=  ERR_CODE INTEGER,'
      '1106020857=  ERR_MSG VARCHAR(1024))'
      '1106020858=AS'
      
        '1106020859=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INV_INS_INV' +
        'OICE'#39';'
      '1106020860=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106020861=BEGIN'
      '1106020862=  UPDATE invoice'
      '1106020863=  SET'
      '1106020864=   NUM         = :NUM_,'
      '1106020865=   INIT_DATE   = :INIT_DATE_,'
      '1106020866=   G_FIRM      = :G_FIRM_,'
      '1106020867=   POSTAVSHIK  = :POSTAVSHIK_,'
      '1106020868=   IDN         = :IDN_,'
      '1106020869=   ADDRESS     = :ADDRESS_,'
      '1106020870=   IIK         = :IIK_,'
      '1106020871=   AGREEMENT   = :AGREEMENT_,'
      '1106020872=   G_PAYMENT_TYPE     = :G_PAYMENT_TYPE_,'
      '1106020873=   PUNKT_NAZNACHENIYA = :PUNKT_NAZNACHENIYA_,'
      '1106020874=   DOVERENNOST        = :DOVERENNOST_,'
      '1106020875=   SPOSOB_OTPRAVKI = :SPOSOB_OTPRAVKI_,'
      '1106020876=   NAKLADNAYA = :NAKLADNAYA_,'
      '1106020877=   GRUZOOTPRAVITEL = :GRUZOOTPRAVITEL_,'
      '1106020878=   GRUZOPOLUCHATEL = :GRUZOPOLUCHATEL_,'
      '1106020879=   ADDRESS_POLUCHATELYA = :ADDRESS_POLUCHATELYA_,'
      '1106020880=   G_CLIENT = :G_CLIENT_,'
      '1106020881=   CLIENT_NAME = :CLIENT_NAME_,'
      '1106020882=   IDN_CLIENT = :IDN_CLIENT_,'
      '1106020883=   ADDRESS_POKUPATEL = :ADDRESS_POKUPATEL_,'
      '1106020884=   IIK_CLIENT = :IIK_CLIENT_,'
      '1106020885=   G_OFFICIAL_RUKOVOD = :G_OFFICIAL_RUKOVOD_,'
      '1106020886=   G_OFFICIAL_GB = :G_OFFICIAL_GB_,'
      '1106020887=   G_OFFICIAL = :G_OFFICIAL_,'
      '1106020888=   ZAKAZ = :ZAKAZ_'
      '1106020889=  WHERE'
      '1106020890=    invoice = :invoice_;'
      '1106020891=END'
      '1106020892=;'
      '1106020893='
      '1106020894=ALTER PROCEDURE INV_UPD_INVOICE_PAY('
      
        '1106020895=  INVOICE_PAY_ TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY' +
        ','
      '1106020896=  INIT_DATE_ TYPE OF COLUMN INVOICE_PAY.INIT_DATE,'
      '1106020897=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '1106020898=  POSTAVSHIK_ TYPE OF COLUMN INVOICE_PAY.POSTAVSHIK,'
      '1106020899=  IDN_ TYPE OF COLUMN INVOICE_PAY.IDN,'
      '1106020900=  ADDRESS_ TYPE OF COLUMN INVOICE_PAY.ADDRESS,'
      '1106020901=  IIK_ TYPE OF COLUMN INVOICE_PAY.IIK,'
      '1106020902=  BANK_NAME_ TYPE OF COLUMN INVOICE_PAY.BANK_NAME,'
      '1106020903=  BIK_ TYPE OF COLUMN INVOICE_PAY.BIK,'
      '1106020904=  KBE_ TYPE OF COLUMN INVOICE_PAY.KBE,'
      '1106020905=  KNP_ TYPE OF COLUMN INVOICE_PAY.KNP,'
      '1106020906=  G_CLIENT_ TYPE OF COLUMN INVOICE_PAY.G_CLIENT,'
      '1106020907=  IDN_CLIENT_ TYPE OF COLUMN INVOICE_PAY.IDN_CLIENT,'
      
        '1106020908=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE_PAY.ADDRE' +
        'SS_POKUPATEL,'
      '1106020909=  AGREEMENT_ TYPE OF COLUMN INVOICE_PAY.AGREEMENT,'
      '1106020910=  G_OFFICIAL_ TYPE OF COLUMN INVOICE_PAY.G_OFFICIAL,'
      '1106020911=  NUM_ TYPE OF COLUMN INVOICE_PAY.NUM,'
      '1106020912=  ZAKAZ_ TYPE OF COLUMN INVOICE_PAY.ZAKAZ)'
      '1106020913=RETURNS ('
      '1106020914=  ERR_CODE INTEGER,'
      '1106020915=  ERR_MSG VARCHAR(1024))'
      '1106020916=AS'
      
        '1106020917=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INV_INS_INV' +
        'OICE_PAY'#39';'
      '1106020918=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106020919=BEGIN'
      '1106020920=  UPDATE invoice_pay'
      '1106020921=  SET'
      '1106020922=   INIT_DATE = COALESCE(:INIT_DATE_, INIT_DATE),'
      '1106020923=   G_FIRM     = :G_FIRM_,'
      '1106020924=   POSTAVSHIK = COALESCE(:POSTAVSHIK_, POSTAVSHIK),'
      '1106020925=   IDN = COALESCE(:IDN_, IDN),'
      '1106020926=   ADDRESS = COALESCE(:ADDRESS_, ADDRESS),'
      '1106020927=   IIK = COALESCE(:IIK_, IIK),'
      '1106020928=   BANK_NAME = COALESCE(:BANK_NAME_, BANK_NAME),'
      '1106020929=   BIK = COALESCE(:BIK_, BIK),'
      '1106020930=   KBE = COALESCE(:KBE_, KBE),'
      '1106020931=   KNP = COALESCE(:KNP_, KNP),'
      '1106020932=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1106020933=   IDN_CLIENT = COALESCE(:IDN_CLIENT_, IDN_CLIENT),'
      
        '1106020934=   ADDRESS_POKUPATEL = COALESCE(:ADDRESS_POKUPATEL_, ' +
        'ADDRESS_POKUPATEL),'
      '1106020935=   AGREEMENT = COALESCE(:AGREEMENT_, AGREEMENT),'
      '1106020936=   G_OFFICIAL = COALESCE(:G_OFFICIAL_, G_OFFICIAL),'
      '1106020937=   ZAKAZ = COALESCE(:ZAKAZ_, ZAKAZ),'
      '1106020938=   NUM = COALESCE(:NUM_, NUM)'
      '1106020939=  WHERE'
      '1106020940=    invoice_pay = :invoice_pay_;'
      '1106020941=END'
      '1106020942=;'
      '1106020943='
      '1106020944=ALTER PROCEDURE K_DEL_KASSA('
      '1106020945=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      
        '1106020946=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ')'
      '1106020947=RETURNS ('
      '1106020948=  ERR_CODE INTEGER,'
      '1106020949=  ERR_MSG VARCHAR(1024))'
      '1106020950=AS'
      '1106020951=/*'
      
        '1106020952='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1106020953=*/'
      '1106020954=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1106020955=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106020956=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1106020957=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1106020958=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '1106020959=DECLARE VARIABLE ACTION_DATE_ DATE;'
      
        '1106020960=DECLARE VARIABLE ACTION_ TYPE OF COLUMN KASSA."ACTION' +
        '";'
      
        '1106020961=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106020962=BEGIN'
      '1106020963=  PROCNAME = '#39'K_DEL_KASSA'#39';'
      '1106020964='
      
        '1106020965=  ---------------------------------------------------' +
        '-------------------'
      '1106020966=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1106020967=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMEN' +
        'T_TYPE_ = 1)) THEN BEGIN'
      '1106020968=      SELECT K.SUMM,'
      '1106020969=             K.ACTION_DATE,'
      '1106020970=             K."ACTION",'
      '1106020971=             K.G_TOCHKA'
      '1106020972=        FROM KASSA K'
      '1106020973=       WHERE K.KASSA = :KASSA_'
      
        '1106020974=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA' +
        '_;'
      '1106020975='
      
        '1106020976=      --*********************************************' +
        '****'
      '1106020977=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '1106020978=      --*********************************************' +
        '****'
      '1106020979=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1106020980=      PNT_ = '#39'02'#39';'
      '1106020981=      IF (:ACTION_ = 0) THEN'
      '1106020982=        CREDIT_ = SUMM_;'
      '1106020983=      ELSE'
      '1106020984=        DEBET_ = SUMM_;'
      '1106020985='
      '1106020986=      UPDATE KASSA_STATE K'
      '1106020987=         SET K.DEBET = K.DEBET - :DEBET_,'
      '1106020988=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '1106020989=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_)' +
        ' + (K.CREDIT - :CREDIT_)'
      '1106020990=       WHERE K.K_DATE = :ACTION_DATE_'
      '1106020991=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '1106020992='
      
        '1106020993=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1106020994=      PNT_ = '#39'04'#39';'
      
        '1106020995=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_,' +
        ' :G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1106020996=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106020997=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106020998=        EXIT;'
      '1106020999=      END'
      '1106021000='
      '1106021001=      DELETE FROM KASSA'
      '1106021002=      WHERE KASSA = :KASSA_;'
      '1106021003=  END'
      
        '1106021004=  ---------------------------------------------------' +
        '-------------------'
      '1106021005=  --*************************************************'
      
        '1106021006=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021007=  ---------------------------------------------------' +
        '-------------------'
      '1106021008=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      '1106021009=  ELSE BEGIN'
      '1106021010=      SELECT K.SUMM,'
      '1106021011=             K.ACTION_DATE,'
      '1106021012=             K."ACTION",'
      '1106021013=             K.G_TOCHKA'
      '1106021014=        FROM KASSA_BEZNAL K'
      '1106021015=       WHERE K.KASSA_BEZNAL = :KASSA_'
      
        '1106021016=      INTO :SUMM_, :ACTION_DATE_, :ACTION_, :G_TOCHKA' +
        '_;'
      '1106021017='
      
        '1106021018=      --*********************************************' +
        '****'
      '1106021019=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1054#1057#1058#1040#1058#1050#1040
      
        '1106021020=      --*********************************************' +
        '****'
      '1106021021=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1106021022=      PNT_ = '#39'02'#39';'
      '1106021023=      IF (:ACTION_ = 0) THEN'
      '1106021024=        CREDIT_ = SUMM_;'
      '1106021025=      ELSE'
      '1106021026=        DEBET_ = SUMM_;'
      '1106021027='
      '1106021028=      UPDATE KASSA_BEZNAL_STATE K'
      '1106021029=         SET K.DEBET = K.DEBET - :DEBET_,'
      '1106021030=             K.CREDIT = K.CREDIT - :CREDIT_,'
      
        '1106021031=             K.OUTPUT = K.INPUT - (K.DEBET - :DEBET_)' +
        ' + (K.CREDIT - :CREDIT_)'
      '1106021032=       WHERE K.K_DATE = :ACTION_DATE_;'
      '1106021033='
      
        '1106021034=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1106021035=      PNT_ = '#39'04'#39';'
      
        '1106021036=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION' +
        '_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1106021037=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021038=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106021039=        EXIT;'
      '1106021040=      END'
      '1106021041='
      '1106021042=      DELETE FROM KASSA_BEZNAL'
      '1106021043=      WHERE KASSA_BEZNAL = :KASSA_;'
      '1106021044=  END'
      
        '1106021045=  ---------------------------------------------------' +
        '-------------------'
      '1106021046=  --*************************************************'
      '1106021047='
      '1106021048=when sqlcode -530 DO'
      '1106021049=  begin'
      '1106021050=    ERR_CODE = -20500;'
      
        '1106021051=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1106021052=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1106021053=  end'
      '1106021054=end'
      '1106021055=;'
      '1106021056='
      '1106021057=ALTER PROCEDURE K_GET_KASSA('
      '1106021058=  KASSA_ TYPE OF COLUMN KASSA.KASSA)'
      '1106021059=RETURNS ('
      '1106021060=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1106021061=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE,'
      
        '1106021062=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1106021063=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1106021064=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1106021065=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1106021066=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1106021067=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      '1106021068=  HAVERIGHT_TO_CHANGE_OLD_ INTEGER,'
      '1106021069=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106021070=  ERR_CODE INTEGER,'
      '1106021071=  ERR_MSG VARCHAR(1024))'
      '1106021072=AS'
      
        '1106021073=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFF' +
        'ICIAL.G_OFFICIAL;'
      '1106021074=BEGIN'
      '1106021075='
      
        '1106021076=  select "ACTION", G_PRIHOD_RASHOD, SUMM, ACTION_DATE' +
        ', NOTE, ZAKAZ, SKLAD, 1 PAYMENT_TYPE, G_OFFICIAL'
      '1106021077=    from KASSA'
      '1106021078=   WHERE KASSA = :KASSA_'
      '1106021079=  UNION ALL'
      
        '1106021080=  select "ACTION", G_PRIHOD_RASHOD, SUMM, ACTION_DATE' +
        ', NOTE, ZAKAZ, SKLAD, 2 PAYMENT_TYPE, G_OFFICIAL'
      '1106021081=    from KASSA_BEZNAL'
      '1106021082=   WHERE KASSA_BEZNAL = :KASSA_'
      
        '1106021083=    into :ACTION_, :G_PRIHOD_RASHOD_, :SUMM_, :ACTION' +
        '_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_PAYMENT_TYPE_, :G_OFFICIAL_' +
        ';'
      '1106021084='
      
        '1106021085=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1054#1055#1045#1056#1040#1062#1048#1048' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056 +
        #1071#1070' '#1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1060#1048#1053'.'#1054#1055#1045#1056#1040#1062#1048#1048' '#1047#1040' '#1055#1056 +
        #1054#1064#1051#1067#1045' '#1044#1040#1058#1067
      
        '1106021086=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059 +
        #1044#1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054 +
        #1053#1040' 0, '#1058#1054' '#1061#1045#1056
      '1106021087=  HAVERIGHT_TO_CHANGE_OLD_ = 1;'
      '1106021088=  IF (ACTION_DATE_ < CURRENT_DATE) THEN BEGIN'
      '1106021089=    SELECT ID'
      '1106021090=      FROM CUR_PARAMS'
      '1106021091=     WHERE CUR_PARAMS = 1'
      '1106021092=      INTO :G_OFFICIAL_CUR_;'
      '1106021093='
      
        '1106021094=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083 +
        #1080#1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086 +
        ' '#1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '1106021095=      HAVERIGHT_TO_CHANGE_OLD_ = 1;'
      '1106021096=    else'
      
        '1106021097=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFIC' +
        'IAL_CUR_, 102) RETURNING_VALUES(:HAVERIGHT_TO_CHANGE_OLD_);'
      '1106021098=  END'
      '1106021099=end'
      '1106021100=;'
      '1106021101='
      '1106021102=ALTER PROCEDURE K_GET_KASSA_SUMM('
      '1106021103=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106021104=  DATE_ DATE,'
      
        '1106021105=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAY' +
        'MENT_TYPE)'
      '1106021106=RETURNS ('
      '1106021107=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1106021108=  ERR_CODE INTEGER,'
      '1106021109=  ERR_MSG VARCHAR(1024))'
      '1106021110=AS'
      '1106021111=begin'
      '1106021112=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106021113=    SELECT ID'
      '1106021114=      FROM CUR_PARAMS'
      '1106021115=     WHERE CUR_PARAMS = 2'
      '1106021116=      INTO :G_TOCHKA_;'
      '1106021117='
      '1106021118=    if (G_PAYMENT_TYPE_ = 1) then'
      '1106021119=      SELECT'
      '1106021120=        T.OUTPUT'
      '1106021121=      FROM KASSA_STATE T'
      '1106021122=      WHERE T.K_DATE = (SELECT MAX(S.K_DATE)'
      '1106021123=                          FROM KASSA_STATE S'
      '1106021124=                         WHERE S.K_DATE <= :DATE_'
      
        '1106021125=                           AND S.G_TOCHKA = :G_TOCHKA' +
        '_)'
      '1106021126=        AND T.G_TOCHKA = :G_TOCHKA_'
      '1106021127=      INTO'
      '1106021128=        SUMM_;'
      '1106021129=    ELSE'
      '1106021130=      SELECT'
      '1106021131=        T.OUTPUT'
      '1106021132=      FROM KASSA_BEZNAL_STATE T'
      '1106021133=      WHERE T.K_DATE = (SELECT MAX(S.K_DATE)'
      '1106021134=                          FROM KASSA_BEZNAL_STATE S'
      '1106021135=                         WHERE S.K_DATE <= :DATE_)'
      '1106021136=      INTO'
      '1106021137=        SUMM_;'
      '1106021138=end'
      '1106021139=;'
      '1106021140='
      '1106021141=ALTER PROCEDURE K_INS_KASSA('
      '1106021142=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1106021143=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1106021144=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1106021145=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1106021146=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1106021147=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1106021148=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      
        '1106021149=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106021150=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106021151=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL)'
      '1106021152=RETURNS ('
      '1106021153=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1106021154=  ERR_CODE INTEGER,'
      '1106021155=  ERR_MSG VARCHAR(1024))'
      '1106021156=AS'
      '1106021157=/*'
      
        '1106021158='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1106021159=*/'
      '1106021160=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1106021161=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106021162=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1106021163=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1106021164=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '1106021165=begin'
      '1106021166=  PROCNAME = '#39'K_INS_KASSA'#39';'
      '1106021167='
      '1106021168=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106021169=    SELECT ID'
      '1106021170=      FROM CUR_PARAMS'
      '1106021171=     WHERE CUR_PARAMS = 2'
      '1106021172=      INTO :G_TOCHKA_;'
      '1106021173='
      
        '1106021174=  ---------------------------------------------------' +
        '-------------------'
      '1106021175=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1106021176=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMEN' +
        'T_TYPE_ = 1)) THEN BEGIN'
      
        '1106021177=      insert into KASSA (KASSA, "ACTION", G_PRIHOD_RA' +
        'SHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOCHKA, G_OFFICIA' +
        'L)'
      
        '1106021178=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIH' +
        'OD_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_' +
        'TOCHKA_, :G_OFFICIAL_)'
      '1106021179=      returning KASSA'
      '1106021180=      into :KASSA_;'
      '1106021181='
      '1106021182=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1106021183=      PNT_ = '#39'02'#39';'
      '1106021184=      IF (:ACTION_ = 0) THEN'
      '1106021185=        CREDIT_ = SUMM_;'
      '1106021186=      ELSE'
      '1106021187=        DEBET_ = SUMM_;'
      '1106021188='
      '1106021189=      UPDATE KASSA_STATE K'
      
        '1106021190=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESC' +
        'E(:DEBET_, 0),'
      
        '1106021191=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALE' +
        'SCE(:CREDIT_, 0),'
      
        '1106021192=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALE' +
        'SCE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0)' +
        ' + COALESCE(:CREDIT_, 0))'
      '1106021193=       WHERE K.K_DATE = :ACTION_DATE_'
      '1106021194=         AND K.G_TOCHKA = :G_TOCHKA_;'
      '1106021195='
      
        '1106021196=      IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044 +
        #1053#1071' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '1106021197=        -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '1106021198=        PNT_ = '#39'03'#39';'
      '1106021199=        BEGIN'
      '1106021200=            SELECT K.OUTPUT'
      '1106021201=              FROM KASSA_STATE K'
      '1106021202=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      '1106021203=                                 FROM KASSA_STATE S'
      
        '1106021204=                                WHERE S.K_DATE < :ACT' +
        'ION_DATE_'
      
        '1106021205=                                  AND S.G_TOCHKA = :G' +
        '_TOCHKA_)'
      '1106021206=               AND K.G_TOCHKA = :G_TOCHKA_'
      '1106021207=            INTO :INPUT_;'
      '1106021208='
      '1106021209=            if (ROW_COUNT = 0) then'
      
        '1106021210=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' ' +
        #1055#1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '1106021211=        WHEN ANY DO'
      '1106021212=          BEGIN'
      '1106021213=            Err_Code = -20500;'
      
        '1106021214=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MS' +
        'G);'
      
        '1106021215=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021216=            EXIT;'
      '1106021217=          END'
      '1106021218=        END'
      '1106021219='
      '1106021220=        INSERT INTO KASSA_STATE'
      
        '1106021221=          (KASSA_STATE, K_DATE, INPUT, DEBET, CREDIT,' +
        ' OUTPUT, G_TOCHKA)'
      '1106021222=        VALUES'
      
        '1106021223=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_,' +
        ' COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, ' +
        '0), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CRED' +
        'IT_,0), :G_TOCHKA_);'
      '1106021224=      END'
      '1106021225='
      
        '1106021226=      -----------------------------------------------' +
        '-----------------------'
      
        '1106021227=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1106021228=      PNT_ = '#39'04'#39';'
      
        '1106021229=      EXECUTE procedure K_RECALC_KASSA(:ACTION_DATE_,' +
        ' :G_TOCHKA_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1106021230=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021231=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106021232=        EXIT;'
      '1106021233=      END'
      '1106021234=  END'
      
        '1106021235=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021236=  ---------------------------------------------------' +
        '-------------------'
      '1106021237=  ----------'#1045#1057#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1106021238=  ---------- '#1042' KASSA_BEZNAL_STATE '#1053#1045' '#1044#1045#1051#1040#1070' '#1056#1040#1047#1044#1045#1051#1045#1053#1048#1045 +
        ' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052', '#1042#1045#1044#1068' '#1056#1040#1057#1063#1045#1058#1053#1067#1049' '#1057#1063#1045#1058' '#1054#1041#1065#1048#1049
      '1106021239=  ELSE BEGIN'
      
        '1106021240=      insert into KASSA_BEZNAL (KASSA_BEZNAL, "ACTION' +
        '", G_PRIHOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD, G_TOC' +
        'HKA, G_OFFICIAL)'
      
        '1106021241=      values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIH' +
        'OD_RASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_, :G_' +
        'TOCHKA_, :G_OFFICIAL_)'
      '1106021242=      returning KASSA_BEZNAL'
      '1106021243=      into :KASSA_;'
      '1106021244='
      '1106021245=      -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1106021246=      PNT_ = '#39'02A'#39';'
      '1106021247=      IF (:ACTION_ = 0) THEN'
      '1106021248=        CREDIT_ = SUMM_;'
      '1106021249=      ELSE'
      '1106021250=        DEBET_ = SUMM_;'
      '1106021251='
      '1106021252=      UPDATE KASSA_BEZNAL_STATE K'
      
        '1106021253=         SET K.DEBET = COALESCE(K.DEBET, 0) + COALESC' +
        'E(:DEBET_, 0),'
      
        '1106021254=             K.CREDIT = COALESCE(K.CREDIT, 0) + COALE' +
        'SCE(:CREDIT_, 0),'
      
        '1106021255=             K.OUTPUT = COALESCE(K.INPUT, 0) - (COALE' +
        'SCE(K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0)' +
        ' + COALESCE(:CREDIT_, 0))'
      '1106021256=       WHERE K.K_DATE = :ACTION_DATE_;'
      '1106021257='
      
        '1106021258=      IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044 +
        #1053#1071' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '1106021259=        -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '1106021260=        PNT_ = '#39'03A'#39';'
      '1106021261=        BEGIN'
      '1106021262=            SELECT K.OUTPUT'
      '1106021263=              FROM KASSA_BEZNAL_STATE K'
      '1106021264=             WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      
        '1106021265=                                 FROM KASSA_BEZNAL_ST' +
        'ATE S'
      
        '1106021266=                                WHERE S.K_DATE < :ACT' +
        'ION_DATE_)'
      '1106021267=            INTO :INPUT_;'
      '1106021268='
      '1106021269=            if (ROW_COUNT = 0) then'
      
        '1106021270=              INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' ' +
        #1055#1045#1056#1042#1040#1071' '#1047#1040#1055#1048#1057#1068
      '1106021271=        WHEN ANY DO'
      '1106021272=          BEGIN'
      '1106021273=            Err_Code = -20500;'
      
        '1106021274=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MS' +
        'G);'
      
        '1106021275=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021276=            EXIT;'
      '1106021277=          END'
      '1106021278=        END'
      '1106021279='
      '1106021280=        INSERT INTO KASSA_BEZNAL_STATE'
      
        '1106021281=          (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, ' +
        'CREDIT, OUTPUT)'
      '1106021282=        VALUES'
      
        '1106021283=          (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_,' +
        ' COALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, ' +
        '0), COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CRED' +
        'IT_,0));'
      '1106021284=      END'
      '1106021285='
      
        '1106021286=      -----------------------------------------------' +
        '-----------------------'
      
        '1106021287=      -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', ' +
        #1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1106021288=      PNT_ = '#39'04A'#39';'
      
        '1106021289=      EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION' +
        '_DATE_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1106021290=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021291=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106021292=        EXIT;'
      '1106021293=      END'
      '1106021294=  END'
      
        '1106021295=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021296=  ---------------------------------------------------' +
        '-------------------'
      '1106021297=end'
      '1106021298=;'
      '1106021299='
      '1106021300=ALTER PROCEDURE K_INS_KASSA_BEZNAL('
      '1106021301=  ACTION_ TYPE OF COLUMN KASSA_BEZNAL.ACTION,'
      
        '1106021302=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA_BEZNAL.G_PRIH' +
        'OD_RASHOD,'
      '1106021303=  SUMM_ TYPE OF COLUMN KASSA_BEZNAL.SUMM,'
      
        '1106021304=  ACTION_DATE_ TYPE OF COLUMN KASSA_BEZNAL.ACTION_DAT' +
        'E,'
      '1106021305=  NOTE_ TYPE OF COLUMN KASSA_BEZNAL.NOTE,'
      '1106021306=  ZAKAZ_ TYPE OF COLUMN KASSA_BEZNAL.ZAKAZ,'
      '1106021307=  SKLAD_ TYPE OF COLUMN KASSA_BEZNAL.SKLAD)'
      '1106021308=RETURNS ('
      
        '1106021309=  KASSA_BEZNAL_ TYPE OF COLUMN KASSA_BEZNAL.KASSA_BEZ' +
        'NAL,'
      '1106021310=  ERR_CODE INTEGER,'
      '1106021311=  ERR_MSG VARCHAR(1024))'
      '1106021312=AS'
      '1106021313=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1106021314=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106021315=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1106021316=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1106021317=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '1106021318=begin'
      '1106021319=  PROCNAME = '#39'K_INS_KASSA_BEZNAL'#39';'
      '1106021320='
      
        '1106021321=  insert into KASSA_BEZNAL (KASSA_BEZNAL, "ACTION", G' +
        '_PRIHOD_RASHOD, SUMM, ACTION_DATE, NOTE, ZAKAZ, SKLAD)'
      
        '1106021322=  values (GEN_ID(GEN_KASSA, 1), :ACTION_, :G_PRIHOD_R' +
        'ASHOD_, :SUMM_, :ACTION_DATE_, :NOTE_, :ZAKAZ_, :SKLAD_)'
      '1106021323=  returning KASSA_BEZNAL'
      '1106021324=  into :KASSA_BEZNAL_;'
      '1106021325='
      '1106021326=  -- '#1063#1058#1054' '#1055#1056#1048#1064#1051#1054' - '#1044#1045#1041#1045#1058' '#1048#1051#1048' '#1050#1056#1045#1044#1048#1058
      '1106021327=  PNT_ = '#39'02'#39';'
      '1106021328=  IF (:ACTION_ = 0) THEN'
      '1106021329=    CREDIT_ = SUMM_;'
      '1106021330=  ELSE'
      '1106021331=    DEBET_ = SUMM_;'
      '1106021332='
      '1106021333=  UPDATE KASSA_BEZNAL_STATE K'
      
        '1106021334=     SET K.DEBET = COALESCE(K.DEBET, 0) + COALESCE(:D' +
        'EBET_, 0),'
      
        '1106021335=         K.CREDIT = COALESCE(K.CREDIT, 0) + COALESCE(' +
        ':CREDIT_, 0),'
      
        '1106021336=         K.OUTPUT = COALESCE(K.INPUT, 0) - (COALESCE(' +
        'K.DEBET, 0) + COALESCE(:DEBET_, 0)) + (COALESCE(K.CREDIT, 0) + C' +
        'OALESCE(:CREDIT_, 0))'
      '1106021337=   WHERE K.K_DATE = :ACTION_DATE_;'
      '1106021338='
      
        '1106021339=  IF (ROW_COUNT = 0) THEN BEGIN -- '#1042#1044#1056#1059#1043' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071' '#1042 +
        #1054#1054#1041#1065#1045' '#1053#1045' '#1041#1067#1051#1054' '#1047#1040#1055#1048#1057#1045#1049
      '1106021340=    -- '#1048#1065#1059' '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      '1106021341=    PNT_ = '#39'03'#39';'
      '1106021342=    BEGIN'
      '1106021343=        SELECT K.OUTPUT'
      '1106021344=          FROM KASSA_BEZNAL_STATE K'
      '1106021345=         WHERE K.K_DATE = (SELECT MAX(S.K_DATE)'
      
        '1106021346=                             FROM KASSA_BEZNAL_STATE ' +
        'S'
      
        '1106021347=                            WHERE S.K_DATE < :ACTION_' +
        'DATE_)'
      '1106021348=        INTO :INPUT_;'
      '1106021349='
      '1106021350=        if (ROW_COUNT = 0) then'
      
        '1106021351=          INPUT_ = 0;  -- '#1042#1044#1056#1059#1043' '#1069#1058#1054' '#1042#1054#1054#1041#1065#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042 +
        #1040#1071' '#1047#1040#1055#1048#1057#1068
      '1106021352=    WHEN ANY DO'
      '1106021353=      BEGIN'
      '1106021354=        Err_Code = -20500;'
      
        '1106021355=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041 +
        #1050#1040' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106021356=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106021357=        EXIT;'
      '1106021358=      END'
      '1106021359=    END'
      '1106021360='
      '1106021361=    INSERT INTO KASSA_BEZNAL_STATE'
      
        '1106021362=      (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CRED' +
        'IT, OUTPUT)'
      '1106021363=    VALUES'
      
        '1106021364=      (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, COA' +
        'LESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0), ' +
        'COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDIT_,' +
        '0));'
      '1106021365=  END'
      '1106021366='
      
        '1106021367=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021368=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055 +
        #1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1106021369=  PNT_ = '#39'04'#39';'
      
        '1106021370=  EXECUTE procedure K_RECALC_KASSA_BEZNAL(:ACTION_DAT' +
        'E_) RETURNING_VALUES(:ERR_CODE, :ERR_MSG);'
      '1106021371=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021372=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106021373=    EXIT;'
      '1106021374=  END'
      
        '1106021375=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021376=  ---------------------------------------------------' +
        '-------------------'
      '1106021377=end'
      '1106021378=;'
      '1106021379='
      '1106021380=ALTER PROCEDURE K_RECALC_KASSA('
      '1106021381=  ACTION_DATE_ DATE,'
      '1106021382=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1106021383=RETURNS ('
      '1106021384=  ERR_CODE INTEGER,'
      '1106021385=  ERR_MSG VARCHAR(1024))'
      '1106021386=AS'
      '1106021387=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1106021388=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106021389=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '1106021390=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_STATE.K' +
        '_DATE;'
      '1106021391=begin'
      '1106021392='
      '1106021393=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106021394=    SELECT ID'
      '1106021395=      FROM CUR_PARAMS'
      '1106021396=     WHERE CUR_PARAMS = 2'
      '1106021397=      INTO :G_TOCHKA_;'
      
        '1106021398=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021399=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055 +
        #1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1106021400=  PNT_ = '#39'01'#39';'
      '1106021401=  SELECT K.OUTPUT'
      '1106021402=    FROM KASSA_STATE K'
      '1106021403=   WHERE K.K_DATE = :ACTION_DATE_'
      '1106021404=     AND K.G_TOCHKA = :G_TOCHKA_'
      '1106021405=    INTO :OUTPUT_;'
      '1106021406='
      '1106021407=  PNT_ = '#39'02'#39';'
      '1106021408=  FOR SELECT K.K_DATE'
      '1106021409=        FROM KASSA_STATE K'
      '1106021410=       WHERE K.K_DATE > :ACTION_DATE_'
      '1106021411=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1106021412=      ORDER BY K.K_DATE, K.KASSA_STATE'
      '1106021413=        INTO :K_DATE_'
      '1106021414=  DO BEGIN'
      '1106021415=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1106021416=    UPDATE KASSA_STATE K'
      '1106021417=       SET K.INPUT = :OUTPUT_,'
      
        '1106021418=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESC' +
        'E(K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '1106021419=     WHERE K.K_DATE = :K_DATE_'
      '1106021420=       AND K.G_TOCHKA = :G_TOCHKA_;'
      '1106021421='
      '1106021422=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1106021423=    SELECT K.OUTPUT'
      '1106021424=      FROM KASSA_STATE K'
      '1106021425=     WHERE K.K_DATE = :K_DATE_'
      '1106021426=       AND K.G_TOCHKA = :G_TOCHKA_'
      '1106021427=      INTO :OUTPUT_;'
      '1106021428=  END'
      '1106021429='
      '1106021430=WHEN ANY DO BEGIN'
      '1106021431=    Err_code = -20500;'
      
        '1106021432=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106021433=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106021434=  END'
      '1106021435=end'
      '1106021436=;'
      '1106021437='
      '1106021438=ALTER PROCEDURE K_RECALC_KASSA_BEZNAL('
      '1106021439=  ACTION_DATE_ DATE)'
      '1106021440=RETURNS ('
      '1106021441=  ERR_CODE INTEGER,'
      '1106021442=  ERR_MSG VARCHAR(1024))'
      '1106021443=AS'
      '1106021444=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1106021445=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106021446=DECLARE VARIABLE OUTPUT_ NUMERIC(15,2);'
      
        '1106021447=DECLARE VARIABLE K_DATE_ TYPE OF COLUMN KASSA_BEZNAL_' +
        'STATE.K_DATE;'
      '1106021448=begin'
      
        '1106021449=  ---------------------------------------------------' +
        '-------------------'
      
        '1106021450=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044'/'#1056#1040#1057#1061#1054#1044' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044#1040#1058#1067', '#1058#1054' '#1055 +
        #1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057#1063#1048#1058#1040#1058#1068' '#1042#1057#1045' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1047#1040#1055#1048#1057#1048
      '1106021451=  PNT_ = '#39'01'#39';'
      '1106021452=  SELECT K.OUTPUT'
      '1106021453=    FROM KASSA_BEZNAL_STATE K'
      '1106021454=   WHERE K.K_DATE = :ACTION_DATE_'
      '1106021455=    INTO :OUTPUT_;'
      '1106021456='
      '1106021457=  PNT_ = '#39'02'#39';'
      '1106021458=  FOR SELECT K.K_DATE'
      '1106021459=        FROM KASSA_BEZNAL_STATE K'
      '1106021460=       WHERE K.K_DATE > :ACTION_DATE_'
      '1106021461=      ORDER BY K.K_DATE, K.KASSA_BEZNAL_STATE'
      '1106021462=        INTO :K_DATE_'
      '1106021463=  DO BEGIN'
      '1106021464=    -- '#1055#1045#1056#1045#1041#1048#1042#1040#1070' '#1054#1057#1058#1040#1058#1050#1048' '#1044#1051#1071' '#1058#1045#1050#1059#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1106021465=    UPDATE KASSA_BEZNAL_STATE K'
      '1106021466=       SET K.INPUT = :OUTPUT_,'
      
        '1106021467=           K.OUTPUT = COALESCE(:OUTPUT_, 0) - COALESC' +
        'E(K.DEBET, 0) + COALESCE(K.CREDIT, 0)'
      '1106021468=     WHERE K.K_DATE = :K_DATE_;'
      '1106021469='
      '1106021470=    -- '#1057#1054#1061#1056#1040#1053#1071#1070' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1044#1051#1071' '#1057#1051#1045#1044#1059#1070#1065#1045#1049' '#1047#1040#1055#1048#1057#1048
      '1106021471=    SELECT K.OUTPUT'
      '1106021472=      FROM KASSA_BEZNAL_STATE K'
      '1106021473=     WHERE K.K_DATE = :K_DATE_'
      '1106021474=      INTO :OUTPUT_;'
      '1106021475=  END'
      '1106021476='
      '1106021477=WHEN ANY DO BEGIN'
      '1106021478=    Err_code = -20500;'
      
        '1106021479=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106021480=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106021481=  END'
      '1106021482=end'
      '1106021483=;'
      '1106021484='
      '1106021485=ALTER PROCEDURE K_UPD_KASSA('
      '1106021486=  KASSA_ TYPE OF COLUMN KASSA.KASSA,'
      '1106021487=  ACTION_ TYPE OF COLUMN KASSA.ACTION,'
      
        '1106021488=  G_PRIHOD_RASHOD_ TYPE OF COLUMN KASSA.G_PRIHOD_RASH' +
        'OD,'
      '1106021489=  SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      '1106021490=  ACTION_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1106021491=  NOTE_ TYPE OF COLUMN KASSA.NOTE,'
      '1106021492=  ZAKAZ_ TYPE OF COLUMN KASSA.ZAKAZ,'
      '1106021493=  SKLAD_ TYPE OF COLUMN KASSA.SKLAD,'
      
        '1106021494=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106021495=  G_OFFICIAL_ TYPE OF COLUMN KASSA.G_OFFICIAL = NULL)'
      '1106021496=RETURNS ('
      '1106021497=  ERR_CODE INTEGER,'
      '1106021498=  ERR_MSG VARCHAR(1024))'
      '1106021499=AS'
      '1106021500=/*'
      
        '1106021501='#1050#1054#1056#1054#1063#1045' '#1063#1058#1054#1041#1067' '#1053#1045' '#1055#1040#1056#1048#1058#1068#1057#1071' '#1057' '#1058#1071#1046#1045#1051#1067#1052' '#1040#1051#1043#1054#1056#1048#1058#1052#1054#1052' '#1048' '#1053#1040#1042#1054#1056 +
        #1040#1063#1048#1042#1040#1058#1068' '#1055#1056#1054#1062#1045#1044#1059#1056#1059', '#1056#1045#1064#1048#1051' '#1055#1056#1054#1057#1058#1054' '#1059#1044#1040#1051#1071#1058#1068' '#1050#1040#1057#1057#1059' '#1048' '#1047#1040#1053#1054#1042#1054' '#1057#1054#1047#1044#1040#1042#1040#1058#1068 +
        ' '#1045#1045', '#1045#1057#1051#1048
      
        '1106021502='#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040' '#1042' '#1047#1040#1055#1048#1057#1048' '#1050#1040#1057#1057#1067'. '#1042#1045#1044#1068' '#1058#1040#1052' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1055#1045#1056#1045#1057 +
        #1063#1048#1058#1067#1042#1040#1058#1068' '#1044#1045#1041#1045#1058' '#1048' '#1050#1056#1045#1044#1048#1058' '#1047#1040' '#1053#1054#1042#1059#1070' '#1044#1040#1058#1059' '#1048' '#1058#1044' '#1048' '#1058#1055'.'
      '1106021503='
      
        '1106021504='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1054#1044#1053#1040' '#1053#1040' 2 '#1057#1055#1054#1057#1054#1041#1040' '#1056#1040#1057#1063#1045#1058#1040' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048' '#1041#1045#1047#1053 +
        #1040#1051#1048#1063#1053#1067#1049', '#1055#1045#1056#1045#1053#1045#1057' '#1042#1057#1070' '#1051#1054#1043#1048#1050#1059' '#1057#1070#1044#1040', '#1063#1058#1054#1041#1067' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1045#1045' '#1042#1067#1047#1067#1042#1040#1070#1065 +
        #1059#1070' '#1053#1045' '#1055#1040#1056#1048#1058#1057#1071' '#1055#1054#1063#1045#1052' '#1047#1056#1071' '#1057' '#1051#1048#1064#1053#1048#1052#1048' IF G_PAYMENT_TYPE_ = ?'
      '1106021505=*/'
      
        '1106021506=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_UPD_KASSA'#39 +
        ';'
      '1106021507=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106021508=DECLARE VARIABLE DEBET_ NUMERIC(15,2) = 0;'
      '1106021509=DECLARE VARIABLE CREDIT_ NUMERIC(15,2) = 0;'
      '1106021510=DECLARE VARIABLE INPUT_ NUMERIC(15,2) = 0;'
      '1106021511=DECLARE VARIABLE SUMM_OLD_ NUMERIC(15,2) = 0;'
      
        '1106021512=DECLARE VARIABLE KASSA_NEW_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1106021513=DECLARE VARIABLE ACTION_DATE_OLD_ TYPE OF COLUMN KASS' +
        'A.ACTION_DATE;'
      
        '1106021514=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106021515=BEGIN'
      
        '1106021516=  ---------------------------------------------------' +
        '-------------------'
      '1106021517=  ----------'#1045#1057#1051#1048' '#1053#1040#1051#1048#1063#1053#1067#1049' '#1056#1040#1057#1063#1045#1058'------------'
      
        '1106021518=  IF ((COALESCE(G_PAYMENT_TYPE_, 0) = 0) or (G_PAYMEN' +
        'T_TYPE_ = 1)) THEN BEGIN'
      '1106021519=      PNT_ = '#39'01'#39';'
      
        '1106021520=      -- '#1045#1057#1051#1048' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1044#1040#1058#1040', '#1058#1054' '#1059#1044#1040#1051#1071#1070' '#1057#1058#1040#1056#1059#1070' '#1047#1040#1055#1048#1057 +
        #1068' '#1048' '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1047#1040' '#1053#1054#1042#1059#1070' '#1044#1040#1058#1059
      '1106021521=      SELECT L.ACTION_DATE,'
      '1106021522=             L.SUMM,'
      '1106021523=             L.G_TOCHKA'
      '1106021524=        FROM KASSA L'
      '1106021525=       WHERE L.KASSA = :KASSA_'
      '1106021526=        INTO :ACTION_DATE_OLD_,'
      '1106021527=             :SUMM_OLD_,'
      '1106021528=             :G_TOCHKA_;'
      '1106021529='
      
        '1106021530=      IF ((SUMM_OLD_ <> SUMM_) or (ACTION_DATE_OLD_ <' +
        '> ACTION_DATE_)) THEN BEGIN'
      
        '1106021531=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106021532=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106021533=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106021534=            EXIT;'
      '1106021535=          END'
      '1106021536='
      '1106021537=          PNT_ = '#39'02'#39';'
      '1106021538=          EXECUTE PROCEDURE K_INS_KASSA(:ACTION_,'
      
        '1106021539=                                        :G_PRIHOD_RAS' +
        'HOD_,'
      '1106021540=                                        :SUMM_,'
      
