      '110135273='
      '110135274=ALTER PROCEDURE G_GET_SYTEM_SETUP('
      
        '110135275=  SYSTEM_SETUP_ /* TYPE OF COLUMN SYSTEM_SETUP.SYSTEM_' +
        'SETUP */ INTEGER)'
      '110135276=RETURNS ('
      
        '110135277=  S_VALUE_ /* TYPE OF COLUMN SYSTEM_SETUP.S_VALUE */ N' +
        'UMERIC(15,2),'
      
        '110135278=  STR_VALUE_ /* TYPE OF COLUMN SYSTEM_SETUP.STR_VALUE ' +
        '*/ VARCHAR(100),'
