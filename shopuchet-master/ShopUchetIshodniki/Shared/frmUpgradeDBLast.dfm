      '110103274='
      '110103275='
      
        '110103276=/*****************************************************' +
        '*************************/'
      
        '110103277=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110103278=/*****************************************************' +
        '*************************/'
      '110103279=ALTER PROCEDURE GET_SKLAD('
      '110103280=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110103281=  MODE_ INTEGER)'
      '110103282=RETURNS ('
      '110103283=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '110103284=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110103285=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110103286=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '110103287=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '110103288=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110103289=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110103290=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110103291=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110103292=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY,'
      
        '110103293=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '110103294=  CNT_T_ INTEGER,'
      
        '110103295=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110103296=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110103297=  HAVERIGHT_ INTEGER,'
      '110103298=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110103299=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ','
      '110103300=  ERR_CODE INTEGER,'
      '110103301=  ERR_MSG VARCHAR(1024))'
      '110103302=AS'
      '110103303=/*'
      
        '110103304=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083 +
        #1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '110103305=*/'
      
        '110103306=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110103307=begin'
      
        '110103308=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080 +
        ' INS '#1080' '#1087#1088#1080' UPD'
      '110103309=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110103310=  CNT_T_ = 0;'
      '110103311=  SELECT COUNT(*)'
      '110103312=    FROM (SELECT S.SKLAD'
      '110103313=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '110103314=    INTO :CNT_T_;'
      '110103315='
      '110103316=  SELECT'
      '110103317=    T.DATE_RECEIPT,'
      '110103318=    T.TIME_RECEIPT,'
      '110103319=    T.G_CLIENT,'
      '110103320=    T.G_PAYMENT_TYPE,'
      '110103321=    T.OSNOVANIE,'
      '110103322=    T.NOTE,'
      '110103323=    T.SUMM,'
      '110103324=    T.SUMM_FACT,'
      '110103325=    T.IS_PAYED_ALL'
      '110103326=    ,T.SUMM_CURRENCY'
      '110103327=    ,T.is_expected'
      '110103328=  FROM SKLAD_PARENT T'
      '110103329=  WHERE T.SKLAD = :SKLAD_'
      '110103330=  INTO'
      '110103331=    :DATE_RECEIPT_,'
      '110103332=    :TIME_RECEIPT_,'
      '110103333=    :G_CLIENT_,'
      '110103334=    :G_PAYMENT_TYPE_,'
      '110103335=    :OSNOVANIE_,'
      '110103336=    :NOTE_,'
      '110103337=    :SUMM_,'
      '110103338=    :SUMM_FACT_,'
      '110103339=    :IS_PAYED_ALL_'
      '110103340=    ,:SUMM_CURRENCY_'
      '110103341=    ,:IS_EXPECTED_;'
      '110103342='
      '110103343=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110103344=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY,'
      
        '110103345=                        charge_ROZN_proc, PRICE_ROZN, ' +
        'charge_opt_proc, PRICE_OPT)'
      
        '110103346=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKL' +
        'AD_,'
      '110103347=         PRICE_CURRENCY, SUMM_CURRENCY,'
      '110103348=         ROUND((G.PRICE/S.PRICE - 1)*100, 2),'
      '110103349=                G.PRICE,'
      
        '110103350=                ROUND((G.volume_price/S.PRICE - 1)*100' +
        ', 2),'
      '110103351=                G.VOLUME_PRICE'
      '110103352=    FROM SKLAD S, G_PRODUCT G'
      '110103353=   WHERE SKLAD_PARENT = :SKLAD_'
      '110103354=     AND S.G_PRODUCT = G.G_PRODUCT'
      '110103355=   ORDER BY SKLAD;'
      '110103356='
      '110103357=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110103358=  SELECT K.G_PRIHOD_RASHOD,'
      '110103359=         K.SUMM'
      
        '110103360=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110103361=   WHERE K.SKLAD = :SKLAD_'
      '110103362=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110103363=    INTO :G_PRIHOD_,'
      '110103364=         :SUMM_PRIHOD_;'
      '110103365='
      
        '110103366=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110103367='
      
        '110103368=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110103369=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110103370=  HaveRight_ = 1;'
      '110103371=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110103372=    SELECT ID'
      '110103373=      FROM CUR_PARAMS'
      '110103374=     WHERE CUR_PARAMS = 1'
      '110103375=      INTO :G_OFFICIAL_CUR_;'
      '110103376='
      
        '110103377=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110103378=      HaveRight_ = 1;'
      '110103379=    else'
      
        '110103380=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110103381=  END'
      '110103382=end'
      '110103383=;'
      '110103384='
      '110103385=ALTER PROCEDURE INS_SKLAD('
      '110103386=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110103387=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110103388=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110103389=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110103390=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110103391=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110103392=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110103393=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110103394=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110103395=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110103396=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110103397=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110103398=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110103399=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110103400=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110103401=RETURNS ('
      '110103402=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110103403=  ERR_CODE INTEGER,'
      '110103404=  ERR_MSG VARCHAR(1024))'
      '110103405=AS'
      '110103406=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110103407=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110103408=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110103409=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110103410=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110103411=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110103412=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110103413=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110103414=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110103415=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110103416=--'
      
        '110103417=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110103418=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110103419=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110103420=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110103421=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110103422=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110103423=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110103424=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110103425=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110103426=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110103427=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110103428=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110103429=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110103430=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110103431=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110103432=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110103433=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110103434=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110103435=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110103436=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110103437=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110103438=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110103439=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110103440=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      
        '110103441=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110103442=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      '110103443=BEGIN'
      '110103444='
      '110103445=  PNT_ = '#39'00'#39';'
      '110103446=  IS_THIS_LAST_ = 0;'
      '110103447='
      '110103448=  IF (G_TOCHKA_ IS NULL) THEN'
      '110103449=    SELECT ID'
      '110103450=      FROM CUR_PARAMS'
      '110103451=     WHERE CUR_PARAMS = 2'
      '110103452=      INTO :G_TOCHKA_;'
      '110103453='
      '110103454=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110103455=  SELECT ID'
      '110103456=    FROM CUR_PARAMS'
      '110103457=   WHERE CUR_PARAMS = 1'
      '110103458=    INTO :G_OFFICIAL_;'
      '110103459='
      '110103460=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110103461=                            DATE_RECEIPT,'
      '110103462=                            TIME_RECEIPT,'
      '110103463=                            G_CLIENT,'
      '110103464=                            G_PAYMENT_TYPE,'
      '110103465=                            OSNOVANIE,'
      '110103466=                            NOTE,'
      '110103467=                            SUMM,'
      '110103468=                            SUMM_FACT,'
      '110103469=                            SUMM_CURRENCY,'
      '110103470=                            IS_PAYED_ALL,'
      '110103471=                            IS_VOZVRAT,'
      '110103472=                            G_TOCHKA'
      '110103473=                            ,G_OFFICIAL'
      '110103474=                            ,IS_EXPECTED)'
      '110103475=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110103476=          :DATE_RECEIPT_,'
      '110103477=          :TIME_RECEIPT_,'
      '110103478=          :G_CLIENT_,'
      '110103479=          :G_PAYMENT_TYPE_,'
      '110103480=          :OSNOVANIE_,'
      '110103481=          :NOTE_,'
      '110103482=          :SUMM_,'
      '110103483=          :SUMM_FACT_,'
      '110103484=          :SUMM_CURRENCY_,'
      
        '110103485=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PA' +
        'YED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "' +
        #1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110103486=          :IS_VOZVRAT_,'
      '110103487=          :G_TOCHKA_'
      '110103488=          ,:G_OFFICIAL_'
      '110103489=          ,:IS_EXPECTED_)'
      '110103490=  RETURNING'
      '110103491=    SKLAD'
      '110103492=  INTO'
      '110103493=    :SKLAD_;'
      '110103494='
      '110103495=  PNT_ = '#39'01'#39';'
      '110103496=  FOR SELECT SKLAD,'
      '110103497=             T.G_PRODUCT,'
      '110103498=             AMOUNT,'
      '110103499=             T.PRICE,'
      '110103500=             SUMM,'
      '110103501=             NDS,'
      '110103502=             NDS_SUMM'
      '110103503=             ,PRICE_CURRENCY'
      '110103504=             ,SUMM_CURRENCY'
      '110103505=             ,PRICE_ROZN'
      '110103506=             ,GG.PRICE'
      '110103507=        FROM SKLAD_TMP T,'
      '110103508=             G_PRODUCT GG'
      '110103509=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110103510=      ORDER BY 1'
      '110103511=      INTO :SKLAD_TMP_,'
      '110103512=           :RG_PRODUCT_,'
      '110103513=           :RAMOUNT_,'
      '110103514=           :RPRICE_,'
      '110103515=           :RSUMM_,'
      '110103516=           :RNDS_,'
      '110103517=           :RNDS_SUMM_'
      '110103518=           ,:PRICE_CURRENCY_'
      '110103519=           ,:SUMM_CURRENCY_TMP_'
      '110103520=           ,:SALE_PRICE_'
      '110103521=           ,:SALE_PRICE_CUR_'
      '110103522=  DO BEGIN'
      '110103523=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110103524=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110103525=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110103526=      IS_THIS_LAST_ = 0;'
      '110103527=      SELECT MAX(SK.DATE_RECEIPT)'
      '110103528=        FROM SKLAD SK'
      '110103529=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110103530=         AND SK.IS_LAST = 1'
      '110103531=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110103532=        INTO :DATE_LAST_;'
      '110103533='
      
        '110103534=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110103535=        UPDATE SKLAD SK'
      '110103536=           SET SK.IS_LAST = 0'
      '110103537=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110103538=           AND SK.IS_LAST = 1'
      '110103539=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110103540='
      '110103541=        IS_THIS_LAST_ = 1;'
      '110103542=      END'
      '110103543=    END'
      '110103544='
      '110103545=    INSERT INTO SKLAD'
      '110103546=    ('
      '110103547=     SKLAD,'
      '110103548=     SKLAD_PARENT,'
      '110103549=     DATE_RECEIPT,'
      '110103550=     G_CLIENT,'
      '110103551=     G_PRODUCT,'
      '110103552=     AMOUNT,'
      '110103553=     PRICE,'
      '110103554=     SUMM,'
      '110103555=     G_PAYMENT_TYPE,'
      '110103556=     OSNOVANIE,'
      '110103557=     NOTE,'
      '110103558=     NDS,'
      '110103559=     NDS_SUMM,'
      '110103560=     IS_LAST,'
      '110103561=     IS_VOZVRAT,'
      '110103562=     G_TOCHKA'
      '110103563=     ,PRICE_CURRENCY'
      '110103564=     ,SUMM_CURRENCY'
      '110103565=    ) VALUES ('
      '110103566=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110103567=     :SKLAD_,'
      '110103568=     :DATE_RECEIPT_,'
      '110103569=     :G_CLIENT_,'
      '110103570=     :RG_PRODUCT_,'
      '110103571=     :RAMOUNT_,'
      '110103572=     :RPRICE_,'
      '110103573=     :RSUMM_,'
      '110103574=     :G_PAYMENT_TYPE_,'
      '110103575=     :OSNOVANIE_,'
      '110103576=     :NOTE_,'
      '110103577=     :RNDS_,'
      '110103578=     :RNDS_SUMM_,'
      
        '110103579=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110103580=     :IS_VOZVRAT_,'
      '110103581=     :G_TOCHKA_'
      '110103582=     ,:PRICE_CURRENCY_'
      '110103583=     ,:SUMM_CURRENCY_TMP_'
      '110103584=    );'
      '110103585='
      
        '110103586=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110103587=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110103588=        PNT_ = '#39'02'#39';'
      '110103589=        UPDATE LT_SKLAD_PRODUCT L'
      '110103590=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110103591=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110103592=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110103593='
      '110103594=        IF (ROW_COUNT = 0) THEN'
      
        '110103595=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110103596=    END'
      '110103597='
      '110103598=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_) THEN'
      '110103599=      UPDATE G_PRODUCT G'
      '110103600=         SET G.PRICE = :SALE_PRICE_'
      '110103601=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110103602=  END'
      '110103603=  ----------------------------------------'
      '110103604='
      
        '110103605=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110103606=  PNT_ = '#39'05'#39';'
      
        '110103607=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110103608=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110103609=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110103610=      ELSE'
      '110103611=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110103612='
      
        '110103613=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110103614=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110103615=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110103616=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110103617=                                        :SUMM_FACT_,'
      
        '110103618=                                        :DATE_RECEIPT_' +
        ','
      
        '110103619=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110103620=                                        NULL,   --ZAKA' +
        'Z_'
      '110103621=                                        :SKLAD_,'
      
        '110103622=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110103623=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110103624=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110103625=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110103626=            EXIT;'
      '110103627=          END'
      '110103628=      END ELSE BEGIN'
      '110103629=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110103630=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110103631=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110103632=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110103633=            ELSE'
      
        '110103634=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110103635='
      '110103636=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110103637=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110103638='
      
        '110103639=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110103640='
      '110103641=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110103642=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110103643=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110103644=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110103645=                                              :PAYMENT' +
        '_DATE_,'
      
        '110103646=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110103647=                                              NULL,   ' +
        '--ZAKAZ_'
      '110103648=                                              :SKLAD_,'
      
        '110103649=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110103650=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110103651=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110103652=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110103653=                  EXIT;'
      '110103654=                END'
      '110103655=            END'
      '110103656=          END'
      '110103657=      END'
      '110103658=  END'
      '110103659='
      '110103660=  DELETE FROM SKLAD_TMP;'
      '110103661='
      
        '110103662=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110103663=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110103664=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110103665=                                  G_PRIHOD_,'
      '110103666=                                  :SUMM_PRIHOD_,'
      '110103667=                                  :DATE_RECEIPT_,'
      
        '110103668=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110103669=                                  NULL,   --:ZAKAZ_,'
      '110103670=                                  :SKLAD_,'
      '110103671=                                  :G_PAYMENT_TYPE_,'
      
        '110103672=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110103673=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110103674=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110103675=      EXIT;'
      '110103676=    END'
      '110103677=  END'
      '110103678=end'
      '110103679=;'
      '110103680='
      '110103681=ALTER PROCEDURE INS_SKLAD_TMP('
      '110103682=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110103683=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110103684=  PRICE_ NUMERIC(15,2),'
      '110103685=  SUMM_ NUMERIC(15,2),'
      '110103686=  NDS_ NUMERIC(15,2),'
      '110103687=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110103688=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110103689=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0,'
      
        '110103690=  CHARGE_ROZN_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_RO' +
        'ZN_PROC = 0,'
      '110103691=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN = 0,'
      
        '110103692=  CHARGE_OPT_PROC_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT' +
        '_PROC = 0,'
      '110103693=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT = 0)'
      '110103694=RETURNS ('
      '110103695=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110103696=  ERR_CODE INTEGER,'
      '110103697=  ERR_MSG VARCHAR(1024))'
      '110103698=AS'
      
        '110103699=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110103700=BEGIN'
      '110103701=  SELECT T.SKLAD'
      '110103702=    FROM SKLAD_TMP T'
      '110103703=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110103704=     AND T.PRICE = :PRICE_'
      '110103705=    INTO :SKLAD_;'
      '110103706='
      '110103707=  IF (SKLAD_ IS NOT NULL) THEN'
      '110103708=    UPDATE SKLAD_TMP T'
      '110103709=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110103710=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110103711=     WHERE T.SKLAD = :SKLAD_;'
      '110103712='
      '110103713=  ELSE'
      
        '110103714=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY,'
      '110103715=                            CHARGE_ROZN_PROC,'
      '110103716=                            PRICE_ROZN,'
      '110103717=                            CHARGE_OPT_PROC,'
      '110103718=                            PRICE_OPT)'
      
        '110103719=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110103720=        ,:PRICE_CURRENCY_'
      '110103721=        ,:SUMM_CURRENCY_'
      '110103722=        ,:CHARGE_ROZN_PROC_'
      '110103723=        ,:PRICE_ROZN_'
      '110103724=        ,:CHARGE_OPT_PROC_'
      '110103725=        ,:PRICE_OPT_)'
      '110103726=      RETURNING SKLAD'
      '110103727=      INTO :SKLAD_;'
      '110103728=end'
      '110103729=;'
      '110103730='
      '110103731=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '110103732=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110103733=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110103734=RETURNS ('
      '110103735=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110103736=  ERR_CODE INTEGER,'
      '110103737=  ERR_MSG VARCHAR(1024))'
      '110103738=AS'
      '110103739=/*'
      '110103740='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '110103741=*/'
      
        '110103742=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110103743=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110103744=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '110103745=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110103746=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '110103747=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT.' +
        'PRICE;'
      
        '110103748=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      '110103749=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110103750=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110103751=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110103752=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      '110103753=BEGIN'
      '110103754='
      '110103755=  PNT_ = '#39'01'#39';'
      
        '110103756=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCOD' +
        'E_, NULL, NULL, NULL, NULL)'
      
        '110103757=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGOR' +
        'Y_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :ERR_CODE, :ERR_MSG;'
      '110103758='
      '110103759=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110103760=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110103761=    EXIT;'
      '110103762=  END'
      '110103763='
      '110103764=  PNT_ = '#39'02'#39';'
      
        '110103765=  EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, :' +
        'G_TOCHKA_, 0)'
      '110103766=      RETURNING_VALUES :PRICE_;'
      '110103767='
      '110103768=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110103769=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110103770=    EXIT;'
      '110103771=  END'
      '110103772='
      '110103773=  AMOUNT_ = 1;'
      '110103774='
      '110103775=  SELECT T.SKLAD'
      '110103776=    FROM SKLAD_TMP T'
      '110103777=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110103778=     AND T.PRICE = :PRICE_'
      '110103779=    INTO :SKLAD_;'
      '110103780='
      '110103781=  IF (SKLAD_ IS NOT NULL) THEN'
      '110103782=    UPDATE SKLAD_TMP T'
      '110103783=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110103784=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110103785=     WHERE T.SKLAD = :SKLAD_;'
      '110103786='
      '110103787=  ELSE'
      
        '110103788=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PRI' +
        'CE_OPT)'
      
        '110103789=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_,'
      
        '110103790=             DECODE(:PRICE_, 0, 0, ROUND((:SALE_PRICE_' +
        '/:PRICE_ - 1)*100, 2)),'
      '110103791=             :SALE_PRICE_,'
      
        '110103792=             DECODE(:PRICE_, 0, 0, ROUND((:VOLUME_PRIC' +
        'E_/:PRICE_ - 1)*100, 2)),'
      '110103793=             :VOLUME_PRICE_)'
      '110103794=      RETURNING SKLAD'
      '110103795=      INTO :SKLAD_;'
      '110103796=end'
      '110103797=;'
      '110103798='
      '110103799=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110103800=RETURNS ('
      '110103801=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '110103802=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '110103803=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '110103804=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '110103805=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '110103806=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '110103807=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '110103808=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '110103809=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '110103810=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110103811=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110103812=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110103813=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZ' +
        'N_PROC,'
      '110103814=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '110103815=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_' +
        'PROC,'
      '110103816=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT)'
      '110103817=AS'
      '110103818=begin'
      '110103819=  FOR'
      
        '110103820=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.' +
        'SUMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL'
      '110103821=           ,PRICE_CURRENCY'
      '110103822=           ,SUMM_CURRENCY'
      '110103823=           ,CHARGE_ROZN_PROC'
      '110103824=           ,PRICE_ROZN'
      '110103825=           ,CHARGE_OPT_PROC'
      '110103826=           ,PRICE_OPT'
      '110103827=    FROM SKLAD_TMP T,'
      '110103828=         G_PRODUCT P'
      '110103829=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110103830=    ORDER BY T.sklad'
      
        '110103831=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :' +
        'NDS, :NDS_SUMM, :NAME, :BARCODE, :ARTICUL'
      '110103832=      ,:PRICE_CURRENCY'
      '110103833=      ,:SUMM_CURRENCY'
      '110103834=      ,:CHARGE_ROZN_PROC'
      '110103835=       ,:PRICE_ROZN'
      '110103836=       ,:CHARGE_OPT_PROC'
      '110103837=       ,:PRICE_OPT'
      '110103838=  DO'
      '110103839=    suspend;'
      '110103840=end'
      '110103841=;'
      '110103842='
      '110103843=ALTER PROCEDURE UPD_SKLAD_TMP1('
      '110103844=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110103845=  OLD_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110103846=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110103847=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110103848=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '110103849=  OLD_PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '110103850=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '110103851=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110103852=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110103853=  CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC,'
      
        '110103854=  OLD_CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHAR' +
        'GE_ROZN_PROC,'
      
        '110103855=  CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARGE_OP' +
        'T_PROC,'
      
        '110103856=  OLD_CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARG' +
        'E_OPT_PROC,'
      '110103857=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      '110103858=  OLD_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      '110103859=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      '110103860=  OLD_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '110103861=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110103862=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0)'
      '110103863=RETURNS ('
      '110103864=  ERR_CODE INTEGER,'
      '110103865=  ERR_MSG VARCHAR(1024))'
      '110103866=AS'
      '110103867=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '110103868=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110103869=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLAD' +
        '.PRICE;'
      '110103870=BEGIN'
      
        '110103871=  -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1048#1051#1057#1071' '#1058#1054#1042#1040#1056', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040#1049#1058#1048' '#1057#1053#1054#1042#1040' '#1045#1043#1054' '#1047#1040#1050 +
        #1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1062#1045#1053#1059' '#1054#1055#1058
      '110103872=  PNT_ = '#39'01'#39';'
      '110103873=  IF (G_PRODUCT_ <> OLD_G_PRODUCT_) THEN BEGIN'
      '110103874=      SELECT S.PRICE'
      '110103875=        FROM SKLAD S'
      
        '110103876=       WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110103877=         AND S.IS_LAST = 1'
      '110103878=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110103879=        INTO :LAST_SELF_PRICE_;'
      '110103880='
      '110103881=      PRICE_ = COALESCE(LAST_SELF_PRICE_, 0);'
      '110103882=  END'
      '110103883='
      
        '110103884=  -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1058#1054' '#1052#1045#1053#1071#1070' '#1062 +
        #1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048
      
        '110103885=  IF (CHARGE_PRICE_ROZN_ <> OLD_CHARGE_PRICE_ROZN_ OR ' +
        'PRICE_ <> OLD_PRICE_) THEN'
      
        '110103886=    PRICE_ROZN_ = PRICE_ * CHARGE_PRICE_ROZN_/100 + PR' +
        'ICE_;'
      
        '110103887=  -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058',' +
        ' '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '110103888=  ELSE IF (PRICE_ROZN_ <> OLD_PRICE_ROZN_) THEN'
      
        '110103889=    CHARGE_PRICE_ROZN_ = ROUND((PRICE_ROZN_/PRICE_ - 1' +
        ')*100, 2);'
      '110103890='
      
        '110103891=  -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040#1062#1045#1053#1050#1040' '#1054#1055#1058' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050 +
        #1048#1047' , '#1047#1053#1040#1063#1048#1058' '#1062#1045#1053#1040' '#1054#1055#1058#1040' '#1053#1045' '#1052#1045#1053#1071#1051#1040#1057#1068', '#1041#1059#1044#1059' '#1045#1045' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '110103892=  IF (CHARGE_PRICE_OPT_ <> OLD_CHARGE_PRICE_OPT_ OR PR' +
        'ICE_ <> OLD_PRICE_ ) THEN'
      
        '110103893=    PRICE_OPT_ = PRICE_ * CHARGE_PRICE_OPT_/100 + PRIC' +
        'E_;'
      '110103894='
      
        '110103895=  -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1054#1055#1058#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054 +
        #1062#1045#1053#1058' '#1054#1055#1058#1040', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '110103896=  ELSE IF (PRICE_OPT_ <> OLD_PRICE_OPT_) THEN'
      
        '110103897=    CHARGE_PRICE_OPT_ = ROUND((PRICE_OPT_/PRICE_ - 1)*' +
        '100, 2);'
      '110103898='
      '110103899=  UPDATE SKLAD_TMP T'
      '110103900=  SET'
      '110103901=    G_PRODUCT = :G_PRODUCT_,'
      '110103902=    AMOUNT = :AMOUNT_,'
      '110103903=    PRICE = :PRICE_,'
      '110103904=    SUMM = :AMOUNT_ * :PRICE_,'
      '110103905=    NDS = :NDS_,'
      '110103906=    NDS_SUMM = :NDS_SUMM_'
      '110103907=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110103908=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '110103909=    ,T.CHARGE_ROZN_PROC = :CHARGE_PRICE_ROZN_'
      '110103910=    ,T.PRICE_ROZN = :PRICE_ROZN_'
      '110103911=    ,T.CHARGE_OPT_PROC = :CHARGE_PRICE_OPT_'
      '110103912=    ,T.PRICE_OPT = :PRICE_OPT_'
      '110103913=  WHERE'
      '110103914=    SKLAD = :SKLAD_;'
      '110103915=END'
      '110103916=;'
      '110103917='
      '110103918='
      
        '110103919=/*****************************************************' +
        '*************************/'
      
        '110103920=/****                   Restoring deactivated procedur' +
        'es                   ****/'
      
        '110103921=/*****************************************************' +
        '*************************/'
      '110103922=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '110103923=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '110103924=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '110103925=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110103926=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '110103927=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '110103928=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '110103929=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '110103930=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110103931=  SELF_PRICE_ NUMERIC(15,2),'
      '110103932=  AMOUNT_ MY_NUMERIC_5,'
      '110103933=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110103934=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110103935=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110103936=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110103937=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '110103938=  KOD_TNVD_ TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '110103939=  CATEGORY_NAME_ VARCHAR(1000),'
      '110103940=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110103941=  IS_THIS_LAST_ INTEGER,'
      '110103942=  UPDATE_IF_EXIST_ INTEGER)'
      '110103943=RETURNS ('
      '110103944=  ERR_CODE INTEGER,'
      '110103945=  ERR_MSG VARCHAR(1024))'
      '110103946=AS'
      
        '110103947=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PR' +
        'ODUCT'#39';'
      '110103948=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110103949=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110103950=DECLARE VARIABLE G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR;'
      
        '110103951=DECLARE VARIABLE G_PRODUCT_PAR_PREV_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110103952=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '110103953=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT = 0;'
      
        '110103954=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110103955=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110103956=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110103957=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM_CURRENCY;'
      '110103958=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '110103959=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110103960=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      
        '110103961=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110103962=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110103963=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110103964=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '110103965=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110103966=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '110103967=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '110103968=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110103969=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110103970=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      '110103971=BEGIN'
      '110103972=    ERR_MSG = '#39#39';'
      '110103973=    PNT_ = '#39'00'#39';'
      '110103974='
      
        '110103975=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045 +
        #1058' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '110103976=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS8898' +
        '8~98888~"'
      
        '110103977=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053 +
        #1045#1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '110103978=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '110103979=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~' +
        #39');'
      '110103980=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '110103981=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '110103982=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '110103983=    END ELSE'
      '110103984=        CROSSCODE_ = NULL;'
      '110103985='
      '110103986=    PNT_ = '#39'01'#39';'
      '110103987=    SELECT ID'
      '110103988=      FROM CUR_PARAMS'
      '110103989=    WHERE CUR_PARAMS = 2'
      '110103990=      INTO :G_TOCHKA_;'
      '110103991='
      '110103992=    SELECT G.G_UNIT'
      '110103993=      FROM G_UNIT G'
      
        '110103994=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME' +
        '_G_UNIT_))'
      '110103995=      INTO :G_UNIT_;'
      '110103996=    if (ROW_COUNT = 0) then'
      '110103997=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110103998='
      '110103999=    PNT_ = '#39'02'#39';'
      
        '1101031000=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058 +
        #1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1101031001=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '1101031002=        SELECT G.G_PRODUCT,'
      '1101031003=               G.NAME'
      '1101031004=          FROM G_PRODUCT G'
      
        '1101031005=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL' +
        '_))'
      '1101031006=           AND TRIM(G.ARTICUL) <> '#39#39
      '1101031007=          INTO :G_PRODUCT_,'
      '1101031008=               :G_PRODUCT_NAME_;'
      '1101031009='
      
        '1101031010=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101031011=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101031012=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101031013=              UPDATE G_PRODUCT G'
      '1101031014=                 SET G.NAME = :NAME_,'
      '1101031015=                     G.G_UNIT = :G_UNIT_,'
      '1101031016=                     G.PRICE  = :PRICE_,'
      '1101031017=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101031018=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101031019=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101031020=                     G.PLACE = :PLACE_,'
      
        '1101031021=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101031022=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101031023=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101031024=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101031025=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101031026=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101031027='
      
        '1101031028=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101031029=            END ELSE'
      
        '1101031030=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101031031=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAM' +
        'E_||'#39'.'#39';'
      '1101031032=        END'
      '1101031033=    END ELSE'
      
        '1101031034=      EXECUTE PROCEDURE get_free_articul RETURNING_VA' +
        'LUES (:ARTICUL_);'
      '1101031035='
      
        '1101031036=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054 +
        #1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '1101031037=    PNT_ = '#39'02a'#39';'
      
        '1101031038=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '1101031039=        SELECT G.G_PRODUCT,'
      '1101031040=               G.NAME'
      '1101031041=          FROM G_PRODUCT G'
      
        '1101031042=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_' +
        'NUM_)'
      '1101031043=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '1101031044=          INTO :G_PRODUCT_,'
      '1101031045=               :G_PRODUCT_NAME_;'
      '1101031046='
      
        '1101031047=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101031048=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101031049=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101031050=              UPDATE G_PRODUCT G'
      '1101031051=                 SET G.NAME = :NAME_,'
      '1101031052=                     G.G_UNIT = :G_UNIT_,'
      '1101031053=                     G.PRICE  = :PRICE_,'
      '1101031054=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101031055=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101031056=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101031057=                     G.PLACE = :PLACE_,'
      
        '1101031058=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101031059=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101031060=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101031061=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101031062=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101031063=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101031064='
      
        '1101031065=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39 +
        ';'
      '1101031066=            END ELSE'
      
        '1101031067=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101031068=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085 +
        #1086#1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' -' +
        ' '#39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '1101031069=        END'
      '1101031070=    end'
      '1101031071='
      
        '1101031072=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042 +
        #1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' ' +
        #1053#1054#1052#1045#1056#1059
      '1101031073=    PNT_ = '#39'02b'#39';'
      
        '1101031074=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGT' +
        'H(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '1101031075=        SELECT G.G_PRODUCT,'
      '1101031076=               G.NAME'
      '1101031077=          FROM G_PRODUCT G'
      '1101031078=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '1101031079=           AND TRIM(G.BARCODE) <> '#39#39
      '1101031080=          INTO :G_PRODUCT_,'
      '1101031081=               :G_PRODUCT_NAME_;'
      '1101031082='
      '1101031083=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '1101031084=          SELECT G.G_PRODUCT,'
      '1101031085=                 G.NAME'
      '1101031086=            FROM G_PRODUCT G, LT_BARCODE L'
      '1101031087=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1101031088=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1101031089=             AND TRIM(L.BARCODE) <> '#39#39
      '1101031090=            INTO :G_PRODUCT_,'
      '1101031091=                 :G_PRODUCT_NAME_;'
      '1101031092='
      
        '1101031093=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045 +
        #1050#1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '1101031094=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '1101031095=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '1101031096=              UPDATE G_PRODUCT G'
      '1101031097=                 SET G.NAME = :NAME_,'
      '1101031098=                     G.G_UNIT = :G_UNIT_,'
      '1101031099=                     G.PRICE  = :PRICE_,'
      '1101031100=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '1101031101=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '1101031102=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '1101031103=                     G.PLACE = :PLACE_,'
      
        '1101031104=                     G.articul         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '1101031105=                     G.nomenclatur_num = DECODE(CHAR_' +
        'LENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencl' +
        'atur_num),'
      
        '1101031106=                     G.barcode         = DECODE(CHAR_' +
        'LENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '1101031107=                     G.KOD_TNVD        = DECODE(CHAR_' +
        'LENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '1101031108=                     ,G.CROSSCODE      = :CROSSCODE_'
      '1101031109=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1101031110='
      
        '1101031111=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '1101031112=            END ELSE'
      
        '1101031113=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_' +
        'CLIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    --' +
        ' '#1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '1101031114=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084 +
        ' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_' +
        'NAME_||'#39'.'#39';'
      '1101031115=        END'
      
        '1101031116=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) TH' +
        'EN'
      
        '1101031117=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RE' +
        'TURNING_VALUES (:BARCODE_);'
      '1101031118='
      
        '1101031119=    --===============================================' +
        '=========='
      '1101031120=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '1101031121=    --===============================================' +
        '=========='
      '1101031122=    PNT_ = '#39'02b'#39';'
      '1101031123=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '1101031124='
      
        '1101031125=        ---------------------------------------------' +
        '---------------------'
      
        '1101031126=        -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048 +
        ' '#1058#1040#1050#1054#1049' '#1053#1045#1058
      
        '1101031127=        -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082 +
        #1080'~'#1052#1103#1075#1082#1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '1101031128=        -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '1101031129=        -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054',' +
        ' '#1053#1054' '#1058#1040#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      
        '1101031130=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BE' +
        'GIN'
      '1101031131=            G_PRODUCT_PAR_ = NULL;'
      
        '1101031132=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAM' +
        'E_);'
      '1101031133=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '1101031134=              STR_ = CATEGORY_NAME_;'
      '1101031135=              CATEGORY_NAME_ = '#39#39';'
      '1101031136=            END ELSE'
      
        '1101031137=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 ' +
        'FOR POS_TILDA_ - 1);'
      '1101031138='
      '1101031139=            SELECT G_PRODUCT'
      '1101031140=              FROM G_PRODUCT G'
      '1101031141=             WHERE G.NAME = :STR_'
      '1101031142=               AND G.IS_CATEGORY = 1'
      
        '1101031143=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR' +
        '_PREV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '1101031144=                   OR'
      '1101031145=                   (:G_PRODUCT_PAR_PREV_ IS NULL))'
      '1101031146=              INTO G_PRODUCT_PAR_;'
      '1101031147=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '1101031148=                INSERT INTO G_PRODUCT (G_PRODUCT, G_P' +
        'RODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '1101031149=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_' +
        'PRODUCT_PAR_PREV_, :STR_, 1, 0)'
      '1101031150=                RETURNING G_PRODUCT'
      '1101031151=                INTO :G_PRODUCT_PAR_;'
      '1101031152='
      '1101031153=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '1101031154=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_' +
        'NAME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '1101031155=        END'
      
        '1101031156=        ---------------------------------------------' +
        '---------------------'
      '1101031157='
      
        '1101031158=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_P' +
        'AR, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLU' +
        'ME_PRICE,'
      
        '1101031159=                               IS_CATEGORY, PACK_AMOU' +
        'NT, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE)'
      
        '1101031160=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G' +
        '_PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NA' +
        'ME_, :G_UNIT_, :PRICE_,'
      
        '1101031161=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF' +
        '_COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_)'
      '1101031162=        RETURNING G_PRODUCT'
      '1101031163=        INTO :G_PRODUCT_;'
      '1101031164='
      
        '1101031165=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101031166=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_' +
        'PRODUCT_, 0, 0, :G_TOCHKA_);'
      '1101031167=    end'
      '1101031168='
      
        '1101031169=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' ' +
        #1058#1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044 +
        #1045#1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101031170=    PNT_ = '#39'03'#39';'
      '1101031171=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '1101031172=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '1101031173=                                       :AMOUNT_,'
      '1101031174=                                       :SELF_PRICE_,'
      
        '1101031175=                                       :AMOUNT_ * :SE' +
        'LF_PRICE_,'
      '1101031176=                                       0, --nds_,'
      '1101031177=                                       0 --nds_summ_,'
      
        '1101031178=                                       ,:SELF_PRICE_U' +
        'E_'
      
        '1101031179=                                       ,:AMOUNT_ * :S' +
        'ELF_PRICE_UE_'
      
        '1101031180=                                       ) RETURNING_VA' +
        'LUES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '1101031181=        IF (ERR_CODE <> 0) THEN BEGIN'
      '1101031182=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '1101031183=          EXIT;'
      '1101031184=        END'
      '1101031185=    END'
      '1101031186='
      
        '1101031187=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071 +
        #1071' '#1047#1040#1055#1048#1057#1068
      '1101031188=    PNT_ = '#39'04'#39';'
      '1101031189=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '1101031190=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048 +
        #1061#1054#1044
      '1101031191=        FROM SKLAD_TMP T'
      '1101031192=        INTO :CNT_;'
      '1101031193='
      '1101031194=      if (CNT_ > 0) then BEGIN'
      '1101031195=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '1101031196=          FROM SKLAD_TMP T'
      '1101031197=          INTO :SUMM_, :SUMM_UE_;'
      '1101031198='
      '1101031199=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '1101031200=                                DATE_RECEIPT,'
      '1101031201=                                TIME_RECEIPT,'
      '1101031202=                                G_CLIENT,'
      '1101031203=                                G_PAYMENT_TYPE,'
      '1101031204=                                OSNOVANIE,'
      '1101031205=                                NOTE,'
      '1101031206=                                SUMM,'
      '1101031207=                                SUMM_FACT,'
      '1101031208=                                SUMM_CURRENCY,'
      '1101031209=                                IS_PAYED_ALL,'
      '1101031210=                                IS_VOZVRAT,'
      '1101031211=                                G_TOCHKA)'
      '1101031212=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '1101031213=                CURRENT_DATE,'
      '1101031214=                CURRENT_TIME,'
      '1101031215=                :G_CLIENT_,'
      '1101031216=                1,'
      '1101031217=                NULL,  --:OSNOVANIE_,'
      '1101031218=                NULL,  -- :NOTE_,'
      '1101031219=                :SUMM_,'
      '1101031220=                :SUMM_,'
      '1101031221=                :SUMM_UE_,'
      
        '1101031222=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040 +
        #1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045 +
        ' 0'
      '1101031223=                0,'
      '1101031224=                :G_TOCHKA_)'
      '1101031225=        RETURNING'
      '1101031226=          SKLAD'
      '1101031227=        INTO'
      '1101031228=          :SKLAD_PARENT_;'
      '1101031229='
      '1101031230=        PNT_ = '#39'05'#39';'
      '1101031231=        FOR SELECT SKLAD,'
      '1101031232=                   G_PRODUCT,'
      '1101031233=                   AMOUNT,'
      '1101031234=                   PRICE,'
      '1101031235=                   SUMM'
      '1101031236=                   ,PRICE_CURRENCY'
      '1101031237=                   ,SUMM_CURRENCY'
      '1101031238=              FROM SKLAD_TMP'
      '1101031239=             ORDER BY 1'
      '1101031240=              INTO :SKLAD_TMP_,'
      '1101031241=                   :RG_PRODUCT_,'
      '1101031242=                   :RAMOUNT_,'
      '1101031243=                   :RPRICE_,'
      '1101031244=                   :RSUMM_'
      '1101031245=                   ,:RPRICE_UE_'
      '1101031246=                   ,:RSUMM_UE_'
      '1101031247=        DO BEGIN'
      '1101031248='
      '1101031249=            UPDATE SKLAD SK'
      '1101031250=               SET SK.IS_LAST = 0'
      '1101031251=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '1101031252=               AND SK.IS_LAST = 1;'
      '1101031253='
      '1101031254=            INSERT INTO SKLAD'
      '1101031255=            ('
      '1101031256=             SKLAD,'
      '1101031257=             SKLAD_PARENT,'
      '1101031258=             DATE_RECEIPT,'
      '1101031259=             G_CLIENT,'
      '1101031260=             G_PRODUCT,'
      '1101031261=             AMOUNT,'
      '1101031262=             PRICE,'
      '1101031263=             SUMM,'
      '1101031264=             G_PAYMENT_TYPE,'
      '1101031265=             OSNOVANIE,'
      '1101031266=             NOTE,'
      '1101031267=             NDS,'
      '1101031268=             NDS_SUMM,'
      '1101031269=             IS_LAST,'
      '1101031270=             IS_VOZVRAT,'
      '1101031271=             G_TOCHKA'
      '1101031272=             ,PRICE_CURRENCY'
      '1101031273=             ,SUMM_CURRENCY'
      '1101031274=            ) VALUES ('
      '1101031275=             :SKLAD_TMP_,'
      '1101031276=             :SKLAD_PARENT_,'
      '1101031277=             CURRENT_DATE,'
      '1101031278=             :G_CLIENT_,'
      '1101031279=             :RG_PRODUCT_,'
      '1101031280=             :RAMOUNT_,'
      '1101031281=             :RPRICE_,'
      '1101031282=             :RSUMM_,'
      '1101031283=             1,       --:G_PAYMENT_TYPE_,'
      '1101031284=             NULL,    --:OSNOVANIE_,'
      '1101031285=             NULL,    --:NOTE_,'
      '1101031286=             0,       --:RNDS_,'
      '1101031287=             0,       --:RNDS_SUMM_,'
      '1101031288=             1,       --IS_LAST_'
      '1101031289=             0,        --:IS_VOZVRAT_'
      '1101031290=             :G_TOCHKA_'
      '1101031291=             ,:RPRICE_UE_'
      '1101031292=             ,:RSUMM_UE_'
      '1101031293=            );'
      '1101031294='
      
        '1101031295=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101031296=            PNT_ = '#39'06'#39';'
      '1101031297=            UPDATE LT_SKLAD_PRODUCT L'
      '1101031298=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '1101031299=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '1101031300=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101031301='
      '1101031302=            PNT_ = '#39'06a'#39';'
      '1101031303=            IF (ROW_COUNT = 0) THEN'
      
        '1101031304=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '1101031305=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '1101031306=        END'
      '1101031307='
      '1101031308=        PNT_ = '#39'07'#39';'
      
        '1101031309=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTIO' +
        'N_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101031310=                                2,    --:G_PRIHOD_RAS' +
        'HOD_,'
      '1101031311=                                :SUMM_,'
      '1101031312=                                CURRENT_DATE,'
      
        '1101031313=                                NULL,   --NOTE_ => :N' +
        'OTE_,'
      '1101031314=                                NULL,   --ZAKAZ_'
      '1101031315=                                :SKLAD_PARENT_,'
      '1101031316=                                1,'
      
        '1101031317=                                :G_TOCHKA_) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101031318=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101031319=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101031320=          EXIT;'
      '1101031321=        END'
      '1101031322='
      '1101031323=        DELETE FROM SKLAD_TMP;'
      '1101031324=      END'
      '1101031325=    END'
      '1101031326='
      
        '1101031327=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1101031328=    if (ERR_MSG_ IS NOT NULL) then'
      '1101031329=      ERR_MSG = ERR_MSG_;'
      '1101031330='
      '1101031331=WHEN ANY DO BEGIN'
      '1101031332=    Err_code = gdscode;'
      
        '1101031333=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' ' +
        '--> PNT_ '#39'||PNT_;'
      '1101031334=  END'
      '1101031335=END'
      '1101031336=;'
      
        '1101031337=UPDATE SYSTEM_SETUP SET S_VALUE = 110103 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101031338=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101031339=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101040=ALTER PROCEDURE GET_SKLAD('
      '1101041=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101042=  MODE_ INTEGER)'
      '1101043=RETURNS ('
      '1101044=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '1101045=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT' +
        ','
      
        '1101046=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEIPT' +
        ','
      '1101047=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '1101048=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMENT_' +
        'TYPE,'
      '1101049=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '11010410=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '11010411=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '11010412=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '11010413=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURRE' +
        'NCY,'
      
        '11010414=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_AL' +
        'L,'
      '11010415=  CNT_T_ INTEGER,'
      
        '11010416=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RAS' +
        'HOD,'
      '11010417=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '11010418=  HAVERIGHT_ INTEGER,'
      '11010419=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '11010420=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED,'
      '11010421=  ERR_CODE INTEGER,'
      '11010422=  ERR_MSG VARCHAR(1024))'
      '11010423=AS'
      '11010424=/*'
      
        '11010425=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083#1077 +
        #1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '11010426=*/'
      
        '11010427=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFIC' +
        'IAL.G_OFFICIAL;'
      '11010428=begin'
      
        '11010429=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080' ' +
        'INS '#1080' '#1087#1088#1080' UPD'
      '11010430=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '11010431=  CNT_T_ = 0;'
      '11010432=  SELECT COUNT(*)'
      '11010433=    FROM (SELECT S.SKLAD'
      '11010434=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '11010435=    INTO :CNT_T_;'
      '11010436='
      '11010437=  SELECT'
      '11010438=    T.DATE_RECEIPT,'
      '11010439=    T.TIME_RECEIPT,'
      '11010440=    T.G_CLIENT,'
      '11010441=    T.G_PAYMENT_TYPE,'
      '11010442=    T.OSNOVANIE,'
      '11010443=    T.NOTE,'
      '11010444=    T.SUMM,'
      '11010445=    T.SUMM_FACT,'
      '11010446=    T.IS_PAYED_ALL'
      '11010447=    ,T.SUMM_CURRENCY'
      '11010448=    ,T.is_expected'
      '11010449=  FROM SKLAD_PARENT T'
      '11010450=  WHERE T.SKLAD = :SKLAD_'
      '11010451=  INTO'
      '11010452=    :DATE_RECEIPT_,'
      '11010453=    :TIME_RECEIPT_,'
      '11010454=    :G_CLIENT_,'
      '11010455=    :G_PAYMENT_TYPE_,'
      '11010456=    :OSNOVANIE_,'
      '11010457=    :NOTE_,'
      '11010458=    :SUMM_,'
      '11010459=    :SUMM_FACT_,'
      '11010460=    :IS_PAYED_ALL_'
      '11010461=    ,:SUMM_CURRENCY_'
      '11010462=    ,:IS_EXPECTED_;'
      '11010463='
      '11010464=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '11010465=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRIC' +
        'E, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURRE' +
        'NCY,'
      
        '11010466=                        charge_ROZN_proc, PRICE_ROZN, c' +
        'harge_opt_proc, PRICE_OPT)'
      
        '11010467=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_TM' +
        'P, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKLA' +
        'D_,'
      '11010468=         PRICE_CURRENCY, SUMM_CURRENCY,'
      
        '11010469=         DECODE(S.PRICE, 0, 0, ROUND((G.PRICE/S.PRICE -' +
        ' 1)*100, 2)),'
      '11010470=         G.PRICE,'
      
        '11010471=         DECODE(S.PRICE, 0, 0, ROUND((G.volume_price/S.' +
        'PRICE - 1)*100, 2)),'
      '11010472=         G.VOLUME_PRICE'
      '11010473=    FROM SKLAD S, G_PRODUCT G'
      '11010474=   WHERE SKLAD_PARENT = :SKLAD_'
      '11010475=     AND S.G_PRODUCT = G.G_PRODUCT'
      '11010476=   ORDER BY SKLAD;'
      '11010477='
      '11010478=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '11010479=  SELECT K.G_PRIHOD_RASHOD,'
      '11010480=         K.SUMM'
      
        '11010481=    FROM (select * from KASSA union all select * from k' +
        'assa_beznal) K'
      '11010482=   WHERE K.SKLAD = :SKLAD_'
      '11010483=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '11010484=    INTO :G_PRIHOD_,'
      '11010485=         :SUMM_PRIHOD_;'
      '11010486='
      
        '11010487=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNIN' +
        'G_VALUES :PAYMENTS_;'
      '11010488='
      
        '11010489=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' '#1045 +
        #1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' '#1044 +
        #1040#1058#1067
      
        '11010490=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044#1059 +
        ' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053#1040 +
        ' 0, '#1058#1054' '#1061#1045#1056
      '11010491=  HaveRight_ = 1;'
      '11010492=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '11010493=    SELECT ID'
      '11010494=      FROM CUR_PARAMS'
      '11010495=     WHERE CUR_PARAMS = 1'
      '11010496=      INTO :G_OFFICIAL_CUR_;'
      '11010497='
      
        '11010498=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080#1094 +
        #1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' '#1074 +
        #1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '11010499=      HaveRight_ = 1;'
      '110104100=    else'
      
        '110104101=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110104102=  END'
      '110104103=end'
      '110104104=;'
      '110104105='
      '110104106=ALTER PROCEDURE PROCEDURE_UPDATE1('
      '110104107=  ARR_ BLOB SUB_TYPE 1)'
      '110104108=AS'
      
        '110104109=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1056#1045#1044#1053#1040#1047#1053#1040#1063#1045#1053#1040' '#1044#1051#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1062#1045#1053' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044 +
        #1045' '#1058#1054#1042#1040#1056#1040'.'
      
        '110104110='#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1042#1067#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1056#1040#1057#1057#1063#1048#1058#1040#1058#1068' '#1053#1054#1042#1059#1070' '#1062#1045#1053#1059 +
        ' '#1055#1054' '#1058#1054#1042#1040#1056#1059'.'
      
        '110104111='#1057#1070#1044#1040' '#1052#1040#1057#1057#1048#1042' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042' '#1042#1048#1044#1045' '#1057#1058#1056#1054#1050#1048' 1-500+300~3-1000+' +
        '700~21-1500+1200, '#1069#1058#1054' '#1058#1054#1042#1040#1056'-'#1062#1045#1053#1040'+'#1054#1055#1058#1062#1045#1053#1040'~'#1058#1054#1042#1040#1056'-'#1062#1045#1053#1040'+'#1054#1055#1058#1062#1045#1053#1040'~*/'
      
        '110104112=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'UPDATE_GPRODU' +
        'CT_PRICE'#39';'
      '110104113=DECLARE VARIABLE STR_ VARCHAR(100);'
      '110104114=DECLARE VARIABLE STR1_ VARCHAR(100);'
      '110104115=DECLARE VARIABLE STR2_ VARCHAR(100);'
      '110104116=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110104117=DECLARE VARIABLE POS_TIRE_ INTEGER;'
      '110104118=DECLARE VARIABLE POS_PLUS_ INTEGER;'
      '110104119=DECLARE VARIABLE P_ INTEGER;'
      
        '110104120=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      '110104121=DECLARE VARIABLE PRICE_ MY_NUMERIC;'
      '110104122=DECLARE VARIABLE PRICE_OPT_ MY_NUMERIC;'
      '110104123=BEGIN'
      '110104124=  WHILE (CHAR_LENGTH(ARR_) > 0) DO BEGIN'
      '110104125=    PRICE_     = 0 ;'
      '110104126=    PRICE_OPT_ = 0 ;'
      '110104127='
      '110104128=    POS_TILDA_ = POSITION('#39'~'#39' IN ARR_);'
      '110104129=    if (CHAR_LENGTH(ARR_) <> POS_TILDA_) then'
      
        '110104130=      STR_ = SUBSTRING(ARR_ FROM 1 FOR POS_TILDA_ - 1)' +
        ';'
      '110104131=    ELSE'
      
        '110104132=      STR_ = SUBSTRING(ARR_ FROM 1 FOR CHAR_LENGTH(ARR' +
        '_) - 1);'
      '110104133='
      '110104134=    POS_TIRE_  = POSITION('#39'-'#39' IN STR_);'
      '110104135='
      
        '110104136=    G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 FOR POS_TI' +
        'RE_ - 1) AS DM_BIGINT);'
      '110104137='
      '110104138=    POS_PLUS_  = POSITION('#39'+'#39' IN STR_);'
      
        '110104139=    STR1_      = SUBSTRING(STR_ FROM (POS_TIRE_ + 1) F' +
        'OR POS_PLUS_ - POS_TIRE_ - 1);'
      '110104140=    if (STR1_ <> '#39#39' AND STR1_ IS NOT NULL) then'
      '110104141=      PRICE_    = CAST(STR1_ AS NUMERIC(15,2));'
      '110104142=    ELSE'
      '110104143=      PRICE_    = 0;'
      '110104144='
      
        '110104145=    STR2_      = SUBSTRING(STR_ FROM (POSITION('#39'+'#39' IN ' +
        'STR_) + 1));'
      '110104146=    if (STR2_ <> '#39#39' AND STR2_ IS NOT NULL) then'
      '110104147=      PRICE_OPT_ = CAST(STR2_ AS NUMERIC(15,2));'
      '110104148=    ELSE'
      '110104149=      PRICE_OPT_ = 0;'
      '110104150='
      '110104151=    UPDATE G_PRODUCT T'
      
        '110104152=       SET T.PRICE        = DECODE(:PRICE_, 0, T.PRICE' +
        ', :PRICE_),'
      
        '110104153=           T.VOLUME_PRICE = DECODE(:PRICE_OPT_, 0, T.V' +
        'OLUME_PRICE, :PRICE_OPT_)'
      '110104154=     WHERE T.G_PRODUCT = :G_PRODUCT_;'
      '110104155='
      
        '110104156=    ARR_       = SUBSTRING(ARR_ FROM (POSITION('#39'~'#39' IN ' +
        'ARR_) + 1));'
      '110104157=  END'
      '110104158=END'
      '110104159=;'
      
        '110104160=UPDATE SYSTEM_SETUP SET S_VALUE = 110104 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110104161=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110104162=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      
        '1101050=UPDATE SYSTEM_SETUP SET S_VALUE = 110104 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '1101051=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RDB' +
        '$DESCRIPTION=NULL;'
      '1101052=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101060=ALTER PROCEDURE P_REP_TOVAR_OSTATOK_ON_DATE('
      '1101061=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101062=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101063=  DATE_ DATE,'
      '1101064=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101065=RETURNS ('
      '1101066=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1101067=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '1101068=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1101069=  PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMERIC(15,' +
        '2),'
      
        '11010610=  AMOUNT /* TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT */ N' +
        'UMERIC(18,5),'
      '11010611=  SUMM /* MY_NUMERIC */ NUMERIC(15,2),'
      '11010612=  ERR_CODE INTEGER,'
      '11010613=  ERR_MSG VARCHAR(1024))'
      '11010614=AS'
      '11010615=BEGIN'
      '11010616=  SUSPEND;'
      '11010617=END'
      '11010618=;'
      '11010619='
      '11010620='
      
        '11010621=/******************************************************' +
        '************************/'
      
        '11010622=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11010623=/******************************************************' +
        '************************/'
      '11010624=ALTER PROCEDURE P_REP_TOVAR_OSTATOK_ON_DATE('
      '11010625=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11010626=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11010627=  DATE_ DATE,'
      '11010628=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11010629=RETURNS ('
      '11010630=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11010631=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11010632=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11010633=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11010634=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '11010635=  SUMM MY_NUMERIC,'
      '11010636=  ERR_CODE INTEGER,'
      '11010637=  ERR_MSG VARCHAR(1024))'
      '11010638=AS'
      
        '11010639=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_OS' +
        'TATOK_ON_DATE'#39';'
      '11010640=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11010641=DECLARE VARIABLE G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT_PAR;'
      '11010642=BEGIN'
      '11010643='
      '11010644=  FOR WITH OSTATOK_ARR AS (SELECT GP.NAME,'
      '11010645=                               GP.BARCODE,'
      '11010646=                               GP.ARTICUL,'
      '11010647=                               GP.PRICE,'
      '11010648=                               GP.G_PRODUCT,'
      '11010649=                               GP.G_PRODUCT_PAR,'
      
        '11010650=                               (select (select sum(amou' +
        'nt) from lt_sklad_product where g_product = GP.G_PRODUCT'
      
        '11010651=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||g_tochka||'#39'-'#39')'
      
        '11010652=                                        +  -- '#1090#1086#1074#1072#1088' '#1085#1072' ' +
        #1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '11010653=                                       (select COALESCE' +
        '(sum(zr.AMOUNT_ALL), 0) from zakaz_na_real zr, zakaz_real_parent' +
        ' zrp'
      
        '11010654=                                        where zr.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TOCH' +
        'KA||'#39'-'#39
      
        '11010655=                                        and zr.ZAKAZ_RE' +
        'AL_PARENT = zrp.ZAKAZ_REAL_PARENT'
      
        '11010656=                                        and zrp.ZAKAZ_D' +
        'ATE > :DATE_)'
      '11010657=                                       +'
      
        '11010658=                                       (select COALESCE' +
        '(sum(zd.amount), 0) from zakaz_details zd, zakaz z'
      
        '11010659=                                        where zd.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA' +
        '||'#39'-'#39
      
        '11010660=                                        and zd.zakaz = ' +
        'z.zakaz and z.z_date > :DATE_'
      
        '11010661=                                        and z.IS_SPISAN' +
        'IE <> 2)   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088 +
        ' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      '11010662=                                       +'
      
        '11010663=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and s.is_vozvrat = 3'
      
        '11010664=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt > :DATE_)'
      '11010665=                                       +'
      
        '11010666=                                       (select COALESCE' +
        '(sum(od.amount), 0) from other_details od, other o'
      
        '11010667=                                        where od.g_prod' +
        'uct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCHKA' +
        '||'#39'-'#39
      
        '11010668=                                        and od.other = ' +
        'o.other and o.op_date > :DATE_)'
      '11010669=                                       -'
      
        '11010670=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '11010671=                                        and s.is_vozvra' +
        't <> 3 and s.date_receipt > :DATE_)'
      '11010672=                                       -'
      
        '11010673=                                       (select COALESCE' +
        '(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODUCT' +
        ' and s.is_vozvrat = 3'
      
        '11010674=                                        and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt > :DATE_)'
      
        '11010675=                                  from rdb$database) AM' +
        'OUNT'
      '11010676=                          FROM G_PRODUCT GP'
      '11010677=                         WHERE GP.IS_ACTIVE = 1'
      '11010678=                           AND GP.IS_CATEGORY = 0'
      
        '11010679=                           AND ((:G_CATEGORY_ CONTAININ' +
        'G '#39'~'#39'||GP.G_PRODUCT_PAR||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11010680=                                 OR'
      '11010681=                                 (:G_CATEGORY_ IS NULL)'
      '11010682=                               )'
      
        '11010683=                           AND ((:G_PRODUCT_ CONTAINING' +
        ' '#39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11010684=                                 OR'
      '11010685=                                 (:G_PRODUCT_ IS NULL)'
      '11010686=                               )'
      '11010687=                           --AND GP.G_PRODUCT = 2874'
      '11010688=                               )'
      
        '11010689=    SELECT (SELECT NAME FROM G_PRODUCT GG WHERE GG.G_PR' +
        'ODUCT = A.G_PRODUCT_PAR)||'#39' / '#39'||A.NAME,'
      '11010690=           A.BARCODE,'
      '11010691=           A.ARTICUL,'
      '11010692=           COALESCE(A.AMOUNT, 0) * A.PRICE,'
      '11010693=           A.G_PRODUCT_PAR,'
      '11010694=           COALESCE(A.AMOUNT, 0) AMOUNT'
      
        '11010695=           ,COALESCE(CAST(A.AMOUNT AS NUMERIC), 0) * DE' +
        'CODE((SELECT S.S_VALUE'
      
        '11010696=                                             FROM SYSTE' +
        'M_SETUP S'
      
        '11010697=                                            WHERE S.SYS' +
        'TEM_SETUP = 1),'
      '11010698=                                           1,'
      
        '11010699=                                           (SELECT SS.P' +
        'RICE'
      
        '110106100=                                              FROM SKL' +
        'AD SS'
      
        '110106101=                                             WHERE SS.' +
        'DATE_RECEIPT = (SELECT MAX(DATE_RECEIPT)'
      
        '110106102=                                                      ' +
        '                  FROM SKLAD'
      
        '110106103=                                                      ' +
        '                 WHERE DATE_RECEIPT < :DATE_'
      
        '110106104=                                                      ' +
        '                   AND G_PRODUCT = A.G_PRODUCT'
      
        '110106105=                                                      ' +
        '                   AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||g_tochka||' +
        #39'-'#39
      
        '110106106=                                                      ' +
        '                   AND IS_VOZVRAT IN (0, 4))'
      
        '110106107=                                               AND SS.' +
        'G_PRODUCT = A.G_PRODUCT'
      
        '110106108=                                               AND :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||SS.g_tochka||'#39'-'#39
      
        '110106109=                                               AND SS.' +
        'IS_VOZVRAT IN (0, 4)'
      
        '110106110=                                            ORDER BY S' +
        'S.SKLAD DESC ROWS 1 TO 1),'
      
        '110106111=                                           (SELECT ROU' +
        'ND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110106112=                                            FROM (SELE' +
        'CT CAST(S.AMOUNT AS MY_NUMERIC) AMOUNT, S.PRICE'
      
        '110106113=                                                    FR' +
        'OM SKLAD S'
      
        '110106114=                                                   WHE' +
        'RE S.DATE_RECEIPT <= :DATE_'
      
        '110106115=                                                     A' +
        'ND S.G_PRODUCT = A.G_PRODUCT'
      
        '110106116=                                                     A' +
        'ND S.IS_VOZVRAT IN (0, 4)'
      
        '110106117=                                                     A' +
        'ND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39
      
        '110106118=                                                    OR' +
        'DER BY S.DATE_RECEIPT DESC ROWS 1 TO 5) T)'
      '110106119=                                         )'
      '110106120=      FROM OSTATOK_ARR A'
      '110106121=    ORDER BY NAME, G_PRODUCT_PAR'
      '110106122=    INTO :NAME,'
      '110106123=         :BARCODE,'
      '110106124=         :ARTICUL,'
      '110106125=         :PRICE,'
      '110106126=         :G_PRODUCT_PAR,'
      '110106127=         :AMOUNT,'
      '110106128=         :SUMM'
      '110106129=  DO'
      '110106130=    SUSPEND;'
      '110106131='
      '110106132=WHEN ANY DO BEGIN'
      '110106133=    Err_code = -20500;'
      
        '110106134=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110106135=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110106136=  END'
      '110106137=end'
      '110106138=;'
      
        '110106139=UPDATE SYSTEM_SETUP SET S_VALUE = 110106 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110106140=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110106141=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101070=CREATE OR ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '1101071=RETURNS ('
      '1101072=  SKLAD /* TYPE OF COLUMN SKLAD_TMP.SKLAD */ BIGINT,'
      
        '1101073=  G_PRODUCT /* TYPE OF COLUMN SKLAD_TMP.G_PRODUCT */ BIG' +
        'INT,'
      
        '1101074=  AMOUNT /* TYPE OF COLUMN SKLAD_TMP.AMOUNT */ NUMERIC(1' +
        '8,5),'
      
        '1101075=  PRICE /* TYPE OF COLUMN SKLAD_TMP.PRICE */ NUMERIC(15,' +
        '2),'
      
        '1101076=  SUMM /* TYPE OF COLUMN SKLAD_TMP.SUMM */ NUMERIC(15,2)' +
        ','
      
        '1101077=  PRICE_CURRENCY /* TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '*/ NUMERIC(15,2),'
      
        '1101078=  SUMM_CURRENCY /* TYPE OF COLUMN SKLAD.SUMM_CURRENCY */' +
        ' NUMERIC(15,2),'
      '1101079=  NDS /* TYPE OF COLUMN SKLAD_TMP.NDS */ NUMERIC(15,2),'
      
        '11010710=  NDS_SUMM /* TYPE OF COLUMN SKLAD_TMP.NDS_SUMM */ NUME' +
        'RIC(15,2),'
      
        '11010711=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250)' +
        ','
      
        '11010712=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11010713=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11010714=  SALE_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUMER' +
        'IC(15,2),'
      
        '11010715=  CHARGE_ROZN_PROC /* TYPE OF COLUMN SKLAD_TMP.CHARGE_R' +
        'OZN_PROC */ NUMERIC(15,2),'
      
        '11010716=  PRICE_ROZN /* TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN */ ' +
        'NUMERIC(15,2),'
      
        '11010717=  CHARGE_OPT_PROC /* TYPE OF COLUMN SKLAD_TMP.CHARGE_OP' +
        'T_PROC */ NUMERIC(15,2),'
      
        '11010718=  PRICE_OPT /* TYPE OF COLUMN SKLAD_TMP.PRICE_OPT */ NU' +
        'MERIC(15,2))'
      '11010719=AS'
      '11010720=BEGIN'
      '11010721=  SUSPEND;'
      '11010722=END'
      '11010723=;'
      '11010724='
      '11010725='
      
        '11010726=/******************************************************' +
        '************************/'
      
        '11010727=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11010728=/******************************************************' +
        '************************/'
      '11010729=ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '11010730=RETURNS ('
      '11010731=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '11010732=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '11010733=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '11010734=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '11010735=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '11010736=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '11010737=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '11010738=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '11010739=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '11010740=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11010741=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11010742=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11010743=  SALE_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '11010744=  CHARGE_ROZN_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_ROZN' +
        '_PROC,'
      '11010745=  PRICE_ROZN TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '11010746=  CHARGE_OPT_PROC TYPE OF COLUMN SKLAD_TMP.CHARGE_OPT_P' +
        'ROC,'
      '11010747=  PRICE_OPT TYPE OF COLUMN SKLAD_TMP.PRICE_OPT)'
      '11010748=AS'
      '11010749=begin'
      '11010750=  FOR'
      
        '11010751=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.S' +
        'UMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.ARTICUL, P.PRICE'
      '11010752=           ,PRICE_CURRENCY'
      '11010753=           ,SUMM_CURRENCY'
      '11010754=           ,CHARGE_ROZN_PROC'
      '11010755=           ,PRICE_ROZN'
      '11010756=           ,CHARGE_OPT_PROC'
      '11010757=           ,PRICE_OPT'
      '11010758=    FROM SKLAD_TMP T,'
      '11010759=         G_PRODUCT P'
      '11010760=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11010761=    ORDER BY T.sklad'
      
        '11010762=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :N' +
        'DS, :NDS_SUMM, :NAME, :BARCODE, :ARTICUL, :SALE_PRICE'
      '11010763=      ,:PRICE_CURRENCY'
      '11010764=      ,:SUMM_CURRENCY'
      '11010765=      ,:CHARGE_ROZN_PROC'
      '11010766=       ,:PRICE_ROZN'
      '11010767=       ,:CHARGE_OPT_PROC'
      '11010768=       ,:PRICE_OPT'
      '11010769=  DO'
      '11010770=    suspend;'
      '11010771=end'
      '11010772=;'
      
        '11010773=UPDATE SYSTEM_SETUP SET S_VALUE = 110107 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '11010774=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11010775=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101080=ALTER PROCEDURE P_REP_PRIHOD('
      '1101081=  DATE_BEGIN_ DATE,'
      '1101082=  DATE_END_ DATE,'
      '1101083=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '1101084=RETURNS ('
      '1101085=  PERIOD_ VARCHAR(40),'
      
        '1101086=  P_REP_PRIHOD_TABLE /* TYPE OF COLUMN P_REP_PRIHOD_TABL' +
        'E.P_REP_PRIHOD_TABLE */ INTEGER,'
      
        '1101087=  TOVAR_NAME /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.TOVAR_' +
        'NAME */ VARCHAR(250),'
      
        '1101088=  AMOUNT /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '1101089=  POSTAVSHIK /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.POSTAV' +
        'SHIK */ VARCHAR(250),'
      
        '11010810=  SELF_PRICE /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_' +
        'PRICE */ NUMERIC(15,2),'
      
        '11010811=  SELF_SUMM /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF_S' +
        'UMM */ NUMERIC(15,2),'
      
        '11010812=  SELF_PRICE_B /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.SEL' +
        'F_PRICE_B */ NUMERIC(15,2),'
      
        '11010813=  SELF_SUMM_B /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.SELF' +
        '_SUMM_B */ NUMERIC(15,2),'
      
        '11010814=  IS_HEAD /* TYPE OF COLUMN P_REP_PRIHOD_TABLE.IS_HEAD ' +
        '*/ INTEGER,'
      '11010815=  ERR_CODE INTEGER,'
      '11010816=  ERR_MSG VARCHAR(1024))'
      '11010817=AS'
      '11010818=BEGIN'
      '11010819=  SUSPEND;'
      '11010820=END'
      '11010821=;'
      '11010822='
      '11010823='
      
        '11010824=/******************************************************' +
