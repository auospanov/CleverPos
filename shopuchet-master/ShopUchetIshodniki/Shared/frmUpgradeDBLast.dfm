      '110221745=                   ,NULL G_TOCHKA'
      '110221746=                   ,NULL RTYPE'
      '110221747=                   ,NULL ITEM_ID'
      '110221748=                   ,NULL G_PRODUCT'
      '110221749=                   ,NULL COST_PRICE'
      '110221750=              FROM SYNC_EXT_APP S'
      '110221751=             WHERE S.IS_LOADING = 1'
      
        '110221752=               AND ((S.IS_LOADED = 0 AND :LOAD_TYPE_ =' +
        ' 0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221753=               AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221754=               AND S.OBJECT_TYPE = 3'
      
        '110221755=               AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048 +
        #1071
      '110221756=               AND (:OPER_ = 3 OR :OPER_ = 0)'
      '110221757='
      '110221758=            ORDER BY 1, 3, 4, 2, 10'
      '110221759=             INTO :OPER,'
      '110221760=                  :ZAKAZ,'
      '110221761=                  :Z_DATE,'
      '110221762=                  :Z_TIME,'
      '110221763=                  :CLIENT_ID,'
      '110221764=                  :IDN,'
