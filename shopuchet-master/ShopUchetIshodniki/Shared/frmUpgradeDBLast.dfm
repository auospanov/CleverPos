      '11049189='
      '11049190=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      
        '11049191=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR' +
        ','
      '11049192=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11049193=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '11049194=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11049195=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11049196=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '11049197=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11049198=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11049199=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11049200=  SELF_PRICE_ NUMERIC(15,2),'
      '11049201=  AMOUNT_ MY_NUMERIC_5,'
      '11049202=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11049203=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11049204=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11049205=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11049206=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11049207=  IS_THIS_LAST_ INTEGER,'
      '11049208=  UPDATE_IF_EXIST_ INTEGER)'
      '11049209=RETURNS ('
      '11049210=  ERR_CODE INTEGER,'
      '11049211=  ERR_MSG VARCHAR(1024))'
      '11049212=AS'
      
        '11049213=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'G_IMPORT_G_PR' +
        'ODUCT'#39#39';'
      '11049214=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11049215=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '11049216=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11049217=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11049218=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11049219=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11049220=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      '11049221=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11049222=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11049223=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11049224=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11049225=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11049226=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11049227=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11049228=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11049229=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11049230=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11049231=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11049232=BEGIN'
      '11049233=    ERR_MSG = '#39#39#39#39';'
      '11049234='
      '11049235=    SELECT ID'
      '11049236=      FROM CUR_PARAMS'
      '11049237=    WHERE CUR_PARAMS = 2'
      '11049238=      INTO :G_TOCHKA_;'
      '11049239='
      '11049240=    SELECT G.G_UNIT'
      '11049241=      FROM G_UNIT G'
      
        '11049242=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11049243=      INTO :G_UNIT_;'
      '11049244=    if (ROW_COUNT = 0) then'
      '11049245=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11049246='
      '11049247=    PNT_ = '#39#39'02'#39#39';'
      
        '11049248=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11049249=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11049250=        SELECT G.G_PRODUCT,'
      '11049251=               G.NAME'
      '11049252=          FROM G_PRODUCT G'
      
        '11049253=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11049254=           AND TRIM(G.ARTICUL) <> '#39#39#39#39
      '11049255=          INTO :G_PRODUCT_,'
      '11049256=               :G_PRODUCT_NAME_;'
      '11049257='
      
        '11049258=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11049259=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
