      '11015367=      if (substring(num from 2 for 1) = '#39'1'#39') then begin'
      '11015368=          /* '#1042#1089#1090#1072#1074#1083#1103#1077#1084' '#1085#1091#1078#1085#1091#1102' "'#1076#1077#1089#1103#1090#1085#1072#1076#1094#1072#1090#1100'" */'
      '11015369=          i = cast(substring(num from 2 for 2) as int);'
      
        '11015370=          buf1 = substring(ones from cast(substring(one' +
