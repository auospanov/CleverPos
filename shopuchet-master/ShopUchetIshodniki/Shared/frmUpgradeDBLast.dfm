        'YPE_,'
      
        '110242442=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110242443=      END'
      '110242444=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
