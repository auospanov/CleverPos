      '1102016995=            /*PNT_ = '#39'12'#39';'
      
        '1102016996=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1102016997=                KASSA_ZP_ID_ = NULL;'
      '1102016998='
      '1102016999=                SELECT S.S_VALUE'
      '1102017000=                  FROM SYSTEM_SETUP S'
      '1102017001=                 WHERE S.SYSTEM_SETUP = 4'
      '1102017002=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102017003='
      '1102017004=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102017005=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102017006=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102017007='
      
        '1102017008=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1102017009=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1102017010=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1102017011='
      '1102017012=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102017013=                ELSE'
      
        '1102017014=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1102017015='
      '1102017016=                SELECT K.KASSA, K.SUMM'
      '1102017017=                FROM KASSA K'
      '1102017018=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1102017019=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
