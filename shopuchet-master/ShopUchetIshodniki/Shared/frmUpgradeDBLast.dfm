      '11018223=  ERR_MSG VARCHAR(1024))'
      '11018224=AS'
      
        '11018225=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'W_GET_WAYBILL'#39 +
        ';'
      '11018226=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11018227=BEGIN'
      '11018228=  SELECT'
      '11018229=    NUM,'
      '11018230=    INIT_DATE,'
      '11018231=    G_FIRM,'
      '11018232=    POSTAVSHIK,'
      '11018233=    IDN,'
      '11018234=    GRUZOPOLUCHATEL,'
      '11018235=    OTVETST_ZA_POST,'
      '11018236=    TRANSP_ORG,'
      '11018237=    TRANSP_NAKLAD,'
      '11018238=    G_OFFICIAL_RUKOVOD,'
      '11018239=    G_OFFICIAL,'
      '11018240=    ZAKAZ,'
      '11018241=    GLAVBUH,'
      '11018242=    doverennost,'
      '11018243=    doverennost_FIO'
      '11018244=  FROM WAYBILL'
      '11018245=  WHERE WAYBILL = :WAYBILL_'
      '11018246=  INTO'
      '11018247=    :NUM_,'
      '11018248=    :INIT_DATE_,'
      '11018249=    :G_FIRM_,'
      '11018250=    :POSTAVSHIK_,'
      '11018251=    :IDN_,'
      '11018252=    :GRUZOPOLUCHATEL_,'
      '11018253=    :OTVETST_ZA_POST_,'
      '11018254=    :TRANSP_ORG_,'
      '11018255=    :TRANSP_NAKLAD_,'
      '11018256=    :G_OFFICIAL_RUKOVOD_,'
      '11018257=    :G_OFFICIAL_,'
      '11018258=    :ZAKAZ_SAVED_'
      '11018259=    ,:GLAVBUH_'
      '11018260=    ,:doverennost_'
      '11018261=    ,:doverennost_fio_;'
      '11018262='
      '11018263=  IF (ROW_COUNT = 0) then BEGIN'
      '11018264=  --**************************************************'
      
        '11018265=    -- '#1047#1053#1040#1063#1048#1058' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056#1045#1044 +
        #1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '11018266=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '11018267=    SELECT'
      '11018268=      G.G_FIRM_REKVIZIT,'
      '11018269=      G.NAME||DECODE(:CURRENCY_, 0, '#39#39','
      
        '11018270=                     '#39', '#1048#1053#1053#39'||COALESCE(G.IDN, '#39#39')||'#39', '#1050 +
        #1055#1055#39'||COALESCE(G.KPP, '#39#39')||'#39', '#39'||COALESCE(GF.ADDRESS,'#39#39')||'#39', '#1090#1077#1083'.' +
        #39'||COALESCE(GF.PHONE, '#39#39')||'
      
        '11018271=                     '#39', '#1088'/'#1089' '#39'||COALESCE(GB.ACCOUNT, '#39#39')' +
        '||'#39' '#1074' '#1073#1072#1085#1082#1077' '#39'||GB.BANK_NAME||'#39' '#1041#1048#1050' '#39'||GB.BIK||'#39' '#1082'/'#1089' '#39'),'
      '11018272=      G.IDN'
      '11018273=    FROM G_FIRM_REKVIZIT g'
      
        '11018274=           LEFT OUTER JOIN (SELECT * FROM G_FIRM_ADDRES' +
        'S WHERE IS_DEFAULT = 1) GF ON G.G_FIRM_REKVIZIT = GF.G_FIRM_REKV' +
        'IZIT'
      
        '11018275=           LEFT OUTER JOIN (SELECT B.BIK, B.NAME BANK_N' +
        'AME, A.ACCOUNT, A.G_FIRM_REKVIZIT'
      
        '11018276=                              FROM G_BANK B, G_FIRM_ACC' +
        'OUNT A'
      
        '11018277=                             WHERE A.G_BANK = B.G_BANK ' +
        'AND A.IS_DEFAULT = 1) GB ON G.G_FIRM_REKVIZIT = GB.G_FIRM_REKVIZ' +
        'IT'
      '11018278=    WHERE G.IS_DEFAULT = 1'
      '11018279=    INTO'
      '11018280=      :G_FIRM_,'
      '11018281=      :POSTAVSHIK_,'
      '11018282=      :IDN_;'
      '11018283='
      '11018284=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '11018285=    SELECT'
      
        '11018286=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')), 0,' +
        ' C.NAME, c.name_FULL)||COALESCE(DECODE(:CURRENCY_, 0, '#39#39','
      
        '11018287=                             '#39', '#1048#1053#1053#39'||COALESCE(C.IDN, '#39 +
        #39')||'#39', '#1050#1055#1055' , '#39'||COALESCE(GA.ADDRESS,'#39#39')||'#39', '#1090#1077#1083'.'#39'||COALESCE(GA.P' +
        'HONE, '#39#39')||'
      
        '11018288=                             '#39', '#1088'/'#1089' '#39'||COALESCE(GB.ACCO' +
        'UNT, '#39#39')||'#39' '#1074' '#1073#1072#1085#1082#1077' '#39'||GB.BANK_NAME||'#39' '#1041#1048#1050' '#39'||GB.BIK||'#39' '#1082'/'#1089' '#39'),'
      '11018289=                       '#39#39'),'
      '11018290=      z.Z_DATE'
      '11018291=    FROM ZAKAZ Z,'
      '11018292=         G_CLIENT C'
      
        '11018293=           LEFT OUTER JOIN (SELECT * FROM G_ADDRESS WHE' +
        'RE IS_DEFAULT = 1) GA ON C.G_CLIENT = GA.G_CLIENT'
      
        '11018294=           LEFT OUTER JOIN (SELECT B.BIK, B.NAME BANK_N' +
        'AME, A.ACCOUNT, A.G_CLIENT FROM G_BANK B, G_ACCOUNT A'
      
        '11018295=                            WHERE A.G_BANK = B.G_BANK A' +
        'ND A.IS_DEFAULT = 1) GB ON C.G_CLIENT = GB.G_CLIENT'
      '11018296=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '11018297=      AND Z.G_CLIENT = C.G_CLIENT'
      '11018298=      AND :MODE_ <> 3'
      '11018299=    UNION ALL'
      '110182100=    SELECT'
      '110182101=      c.name||COALESCE(DECODE(:CURRENCY_, 0, '#39#39','
      
        '110182102=                             '#39', '#1048#1053#1053#39'||COALESCE(R.IDN, ' +
        #39#39')||'#39', '#1050#1055#1055' , '#39'||COALESCE(AD.ADDRESS,'#39#39')||'
      
        '110182103=                             '#39', '#1088'/'#1089' '#39'||COALESCE(GF.ACC' +
        'OUNT, '#39#39')),'
      '110182104=                       '#39#39'),'
      '110182105=      S.DATE_RECEIPT Z_DATE'
      '110182106=    FROM SKLAD_PARENT S,'
      '110182107=         G_TOCHKA C,'
      
        '110182108=         G_FIRM_REKVIZIT R LEFT OUTER JOIN G_FIRM_ADDR' +
        'ESS AD ON AD.G_FIRM_REKVIZIT = R.G_FIRM_REKVIZIT AND AD.IS_DEFAU' +
        'LT = 1'
      
        '110182109=           LEFT OUTER JOIN G_FIRM_ACCOUNT GF ON GF.G_F' +
        'IRM_REKVIZIT = R.G_FIRM_REKVIZIT AND GF.IS_DEFAULT = 1'
      '110182110=    WHERE S.SKLAD = :ZAKAZ_'
      '110182111=      AND S.G_TOCHKA = C.G_TOCHKA'
      '110182112=      AND R.IS_DEFAULT = 1'
      '110182113=      AND :MODE_ = 3'
      '110182114=    INTO'
      '110182115=      :GRUZOPOLUCHATEL_,'
      '110182116=      :INIT_DATE_;'
      '110182117='
      
        '110182118=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054 +
        #1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '110182119=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054' ' +
        #1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '110182120=    PNT_ = '#39'05'#39';'
      '110182121=    SELECT C.id'
      '110182122=      FROM cur_params C'
      '110182123=     WHERE C.cur_params = 1'
      '110182124=    INTO :G_OFFICIAL_;'
      '110182125='
      '110182126=    IF (ROW_COUNT = 0) then BEGIN'
      '110182127=        SELECT MIN(O.G_OFFICIAL)'
      '110182128=          FROM G_OFFICIAL O'
      '110182129=          INTO :G_OFFICIAL_;'
      '110182130=        IF (ROW_COUNT = 0) then BEGIN'
      '110182131=            Err_Code = -20500;'
      
        '110182132=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057 +
        #1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      
        '110182133=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110182134=            EXIT;'
      '110182135=        END'
      '110182136=    END'
      '110182137='
      '110182138=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '110182139=    SELECT O.G_OFFICIAL'
      '110182140=    FROM G_OFFICIAL O'
      '110182141=    WHERE O.IS_RUKOVODITEL = 1'
      '110182142=    INTO :G_OFFICIAL_RUKOVOD_;'
      '110182143='
      '110182144=    --'#1048#1065#1059' '#1075#1083#1072#1074#1073#1091#1093#1072
