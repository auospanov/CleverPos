        'ENT_TYPE */ INTEGER,'
      
        '11040494=  OSNOVANIE_ /* TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE *' +
        '/ VARCHAR(150),'
      
        '11040495=  NOTE_ /* TYPE OF COLUMN SKLAD_PARENT.NOTE */ VARCHAR(' +
        '200),'
      
        '11040496=  SUMM_ /* TYPE OF COLUMN SKLAD_PARENT.SUMM */ NUMERIC(' +
        '15,2),'
      
