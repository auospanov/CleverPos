      '1102461963=              :DISCOUNT_TENGE,'
      '1102461964=              :DISCOUNT_SUMM,'
      '1102461965=              :NDS,'
      '1102461966=              :NDS_SUMM'
      '1102461967=      DO BEGIN'
      '1102461968=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102461969=          UPDATE LT_SKLAD_PRODUCT L'
