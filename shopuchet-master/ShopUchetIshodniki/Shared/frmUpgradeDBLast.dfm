      '1101462073=                       S.NOTE      = :NOTE_'
      '1101462074=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1101462075='
      
        '1101462076=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101462077=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101462078=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101462079=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_)'
