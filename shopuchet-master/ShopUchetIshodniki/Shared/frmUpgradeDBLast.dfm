      '1102503771=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
