      '11018218=  ZAKAZ_SAVED_ TYPE OF COLUMN WAYBILL.ZAKAZ,'
      '11018219=  GLAVBUH_ TYPE OF COLUMN WAYBILL.GLAVBUH,'
      '11018220=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
