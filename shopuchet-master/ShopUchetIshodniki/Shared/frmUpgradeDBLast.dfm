        'PISANO_;'
      
        '1101352299=      AMOUNT_VOZVRAT_ = AMOUNT_VOZVRAT_  + REC_AMOUNT' +
        '_VOZVRAT_;'
      
        '1101352300=      SUMM_VOZVRAT_      = SUMM_VOZVRAT_    + REC_SUM' +
        'M_VOZVRAT_;'
      
        '1101352301=      AMOUNT_PRIHOD_SKL_ = AMOUNT_PRIHOD_SKL_ + REC_A' +
        'MOUNT_PRIHOD_SKL_;'
      
        '1101352302=      SUMM_PRIHOD_SKL_   = SUMM_PRIHOD_SKL_ + REC_SUM' +
        'M_PRIHOD_SKL_;'
      
        '1101352303=      AMOUNT_UHOD_SKL_   = AMOUNT_UHOD_SKL_ + REC_AMO' +
        'UNT_UHOD_SKL_;'
      
        '1101352304=      SUMM_UHOD_SKL_     = SUMM_UHOD_SKL_ + REC_SUMM_' +
        'UHOD_SKL_;'
      '1101352305='
      '1101352306=      PATH_OLD_ = PATH_;'
      '1101352307=    END'
      '1101352308='
      '1101352309=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1101352310=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1101352311=      (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIH' +
        'OD, SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SP' +
        'ISANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT,'
      
        '1101352312=       AMOUNT_PRIHOD_SKL, SUMM_PRIHOD_SKL, AMOUNT_UHO' +
        'D_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1101352313=    VALUES'
      
        '1101352314=      (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :' +
        'AMOUNT_PRIHOD_, :SUMM_PRIHOD_, :AMOUNT_UHOD_, :SUMM_UHOD_, :AMOU' +
        'NT_SPISANO_, :SUMM_SPISANO_, :AMOUNT_VOZVRAT_, :SUMM_VOZVRAT_,'
      
        '1101352315=       :AMOUNT_PRIHOD_SKL_, :SUMM_PRIHOD_SKL_, :AMOUN' +
        'T_UHOD_SKL_, :SUMM_UHOD_SKL_, 2);'
      '1101352316='
      '1101352317=    -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      
        '1101352318=    AMOUNT_PRIHOD_ALL_ = AMOUNT_PRIHOD_ALL_ + AMOUNT_' +
        'PRIHOD_;'
      
        '1101352319=    SUMM_PRIHOD_ALL_   = SUMM_PRIHOD_ALL_ + SUMM_PRIH' +
        'OD_;'
      
        '1101352320=    AMOUNT_UHOD_ALL_   = AMOUNT_UHOD_ALL_ + AMOUNT_UH' +
        'OD_;'
      '1101352321=    SUMM_UHOD_ALL_     = SUMM_UHOD_ALL_ + SUMM_UHOD_;'
      
        '1101352322=    AMOUNT_SPISANO_ALL_ = AMOUNT_SPISANO_ALL_ + AMOUN' +
        'T_SPISANO_;'
      
        '1101352323=    SUMM_SPISANO_ALL_   = SUMM_SPISANO_ALL_ + SUMM_SP' +
        'ISANO_;'
      
        '1101352324=    AMOUNT_VOZVRAT_ALL_ = AMOUNT_VOZVRAT_ALL_ + AMOUN' +
        'T_VOZVRAT_;'
      
        '1101352325=    SUMM_VOZVRAT_ALL_   = SUMM_VOZVRAT_ALL_ + SUMM_VO' +
        'ZVRAT_;'
      
        '1101352326=    AMOUNT_PRIHOD_SKL_ALL_ = AMOUNT_PRIHOD_SKL_ALL_ +' +
        ' AMOUNT_PRIHOD_SKL_;'
      
        '1101352327=    SUMM_PRIHOD_SKL_ALL_   = SUMM_PRIHOD_SKL_ALL_ + S' +
        'UMM_PRIHOD_SKL_;'
      
        '1101352328=    AMOUNT_UHOD_SKL_ALL_   = AMOUNT_UHOD_SKL_ALL_ + A' +
        'MOUNT_UHOD_SKL_;'
      
        '1101352329=    SUMM_UHOD_SKL_ALL_     = SUMM_UHOD_SKL_ALL_ + SUM' +
        'M_UHOD_SKL_;'
      '1101352330='
      '1101352331=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      '1101352332=    INSERT INTO P_REP_TOVAR_MOVE_TABLE'
      
        '1101352333=    (P_REP_TOVAR_MOVE_TABLE, G_PRODUCT, AMOUNT_PRIHOD' +
        ', SUMM_PRIHOD, AMOUNT_UHOD, SUMM_UHOD, AMOUNT_SPISANO, SUMM_SPIS' +
        'ANO, AMOUNT_VOZVRAT, SUMM_VOZVRAT, AMOUNT_PRIHOD_SKL, SUMM_PRIHO' +
        'D_SKL, AMOUNT_UHOD_SKL, SUMM_UHOD_SKL, IS_HEAD)'
      '1101352334=    VALUES'
      
        '1101352335=    (GEN_ID(GEN_P_REP_TOVAR_MOVE_TABLE, 1), -100, :AM' +
        'OUNT_PRIHOD_ALL_, :SUMM_PRIHOD_ALL_, :AMOUNT_UHOD_ALL_, :SUMM_UH' +
        'OD_ALL_, :AMOUNT_SPISANO_ALL_, :SUMM_SPISANO_ALL_, :AMOUNT_VOZVR' +
        'AT_ALL_, :SUMM_VOZVRAT_ALL_, :AMOUNT_PRIHOD_SKL_ALL_, :SUMM_PRIH' +
        'OD_SKL_ALL_, :AMOUNT_UHOD_SKL_ALL_, :SUMM_UHOD_SKL_ALL_, 3);'
      '1101352336='
      
        '1101352337=    STR_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DATE' +
        '_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2,' +
        ' 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1101352338=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1101352339='
      '1101352340=  FOR'
      '1101352341=    SELECT T.P_REP_TOVAR_MOVE_TABLE,'
      '1101352342=           DECODE(T.IS_HEAD,'
      '1101352343=                  0, T.NAME,'
      '1101352344=                  1, T.NAME,'
      '1101352345=                  2, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39','
      '1101352346=                  3, '#39#1054#1073#1097#1080#1081' '#1080#1090#1086#1075#39'),'
      '1101352347=           G.ARTICUL,'
      '1101352348=           G.BARCODE,'
      '1101352349=           G.PRICE,'
      '1101352350=           T.AMOUNT_IN,'
      '1101352351=           T.AMOUNT_PRIHOD,'
      '1101352352=           T.SUMM_PRIHOD,'
      '1101352353=           T.AMOUNT_UHOD,'
      '1101352354=           T.SUMM_UHOD,'
      '1101352355=           T.AMOUNT_SPISANO,'
      '1101352356=           T.SUMM_SPISANO,'
      '1101352357=           T.AMOUNT_VOZVRAT,'
      '1101352358=           T.SUMM_VOZVRAT,'
      '1101352359=           T.AMOUNT_PRIHOD_SKL,'
      '1101352360=           T.SUMM_PRIHOD_SKL,'
      '1101352361=           T.AMOUNT_UHOD_SKL,'
      '1101352362=           T.SUMM_UHOD_SKL,'
      '1101352363=           T.AMOUNT_OUT,'
      '1101352364=           T.IS_HEAD'
      
        '1101352365=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1101352366=     ORDER BY 1'
      '1101352367=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1101352368=       :NAME,'
      '1101352369=       :ARTICUL,'
      '1101352370=       :BARCODE,'
      '1101352371=       :PRICE,'
      '1101352372=       :AMOUNT_IN,'
      '1101352373=       :AMOUNT_PRIHOD,'
      '1101352374=       :SUMM_PRIHOD,'
      '1101352375=       :AMOUNT_UHOD,'
      '1101352376=       :SUMM_UHOD,'
      '1101352377=       :AMOUNT_SPISANO,'
      '1101352378=       :SUMM_SPISANO,'
      '1101352379=       :AMOUNT_VOZVRAT,'
      '1101352380=       :SUMM_VOZVRAT,'
      '1101352381=       :AMOUNT_PRIHOD_SKL,'
      '1101352382=       :SUMM_PRIHOD_SKL,'
      '1101352383=       :AMOUNT_UHOD_SKL,'
      '1101352384=       :SUMM_UHOD_SKL,'
      '1101352385=       :AMOUNT_OUT,'
      '1101352386=       :IS_HEAD'
      '1101352387=  DO SUSPEND;'
      '1101352388='
      '1101352389=WHEN ANY DO BEGIN'
      '1101352390=    Err_code = -20500;'
      
        '1101352391=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101352392=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101352393=  END'
      '1101352394=end'
      '1101352395=;'
      '1101352396='
      '1101352397=ALTER PROCEDURE P_REP_TOVAR_OSTATOK_ON_DATE('
      '1101352398=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101352399=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1101352400=  DATE_ DATE,'
      '1101352401=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101352402=RETURNS ('
      '1101352403=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101352404=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101352405=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101352406=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1101352407=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101352408=  SUMM MY_NUMERIC,'
      '1101352409=  ERR_CODE INTEGER,'
      '1101352410=  ERR_MSG VARCHAR(1024))'
      '1101352411=AS'
      
        '1101352412=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_TOVAR_' +
        'OSTATOK_ON_DATE'#39';'
      '1101352413=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101352414=DECLARE VARIABLE G_PRODUCT_PAR TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT_PAR;'
      '1101352415=BEGIN'
      '1101352416='
      '1101352417=  FOR WITH OSTATOK_ARR AS (SELECT GP.NAME,'
      '1101352418=                               GP.BARCODE,'
      '1101352419=                               GP.ARTICUL,'
      '1101352420=                               GP.PRICE,'
      '1101352421=                               GP.G_PRODUCT,'
      '1101352422=                               GP.G_PRODUCT_PAR,'
      
        '1101352423=                               (select (select sum(am' +
        'ount) from lt_sklad_product where g_product = GP.G_PRODUCT'
      
        '1101352424=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||g_tochka||'#39'-'#39')'
      
        '1101352425=                                        +  -- '#1090#1086#1074#1072#1088' '#1085 +
        #1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
        '1101352426=                                       (select COALES' +
        'CE(sum(zr.AMOUNT_ALL), 0) from zakaz_na_real zr, zakaz_real_pare' +
        'nt zrp'
      
        '1101352427=                                        where zr.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Zrp.G_TO' +
        'CHKA||'#39'-'#39
      
        '1101352428=                                        and zr.ZAKAZ_' +
        'REAL_PARENT = zrp.ZAKAZ_REAL_PARENT'
      
        '1101352429=                                        and zrp.ZAKAZ' +
        '_DATE > :DATE_)'
      '1101352430=                                       +'
      
        '1101352431=                                       (select COALES' +
        'CE(sum(zd.amount), 0) from zakaz_details zd, zakaz z'
      
        '1101352432=                                        where zd.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCH' +
        'KA||'#39'-'#39
      
        '1101352433=                                        and zd.zakaz ' +
        '= z.zakaz and z.z_date > :DATE_'
      
        '1101352434=                                        and z.IS_SPIS' +
        'ANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072 +
        #1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '1101352435=                                        and not (z.IS' +
        '_SPISANIE = 0 and z.NOT_MINUS_OSTATOK = 1))'
      '1101352436=                                       +'
      
        '1101352437=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and s.is_vozvrat = 3'
      
        '1101352438=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||S.g_client||'#39'-'#39' and s.date_receipt > :DATE' +
        '_)'
      '1101352439=                                       +'
      
        '1101352440=                                       (select COALES' +
        'CE(sum(od.amount), 0) from other_details od, other o'
      
        '1101352441=                                        where od.g_pr' +
        'oduct = GP.G_PRODUCT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||o.G_TOCH' +
        'KA||'#39'-'#39
      
        '1101352442=                                        and od.other ' +
        '= o.other and o.op_date > :DATE_)'
      '1101352443=                                       -'
      
        '1101352444=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1101352445=                                        and s.is_vozv' +
        'rat <> 3 and s.date_receipt > :DATE_)'
      '1101352446=                                       -'
      
        '1101352447=                                       (select COALES' +
        'CE(sum(s.amount), 0) from sklad s where s.g_product = GP.G_PRODU' +
        'CT and s.is_vozvrat = 3'
      
        '1101352448=                                        and :G_TOCHKA' +
        '_ARR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39' and s.date_receipt > :DATE' +
        '_)'
      
        '1101352449=                                  from rdb$database) ' +
        'AMOUNT'
      '1101352450=                          FROM G_PRODUCT GP'
      '1101352451=                         WHERE GP.IS_ACTIVE = 1'
      '1101352452=                           AND GP.IS_CATEGORY = 0'
      
        '1101352453=                           AND ((:G_CATEGORY_ CONTAIN' +
        'ING '#39'~'#39'||GP.G_PRODUCT_PAR||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1101352454=                                 OR'
      
        '1101352455=                                 (:G_CATEGORY_ IS NUL' +
        'L)'
      '1101352456=                               )'
      
        '1101352457=                           AND ((:G_PRODUCT_ CONTAINI' +
        'NG '#39'~'#39'||GP.G_PRODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1101352458=                                 OR'
      
        '1101352459=                                 (:G_PRODUCT_ IS NULL' +
        ')'
      '1101352460=                               )'
      '1101352461=                           --AND GP.G_PRODUCT = 2874'
      '1101352462=                               )'
      
        '1101352463=    SELECT (SELECT NAME FROM G_PRODUCT GG WHERE GG.G_' +
        'PRODUCT = A.G_PRODUCT_PAR)||'#39' / '#39'||A.NAME,'
      '1101352464=           A.BARCODE,'
      '1101352465=           A.ARTICUL,'
      '1101352466=           COALESCE(A.AMOUNT, 0) * A.PRICE,'
      '1101352467=           A.G_PRODUCT_PAR,'
      '1101352468=           COALESCE(A.AMOUNT, 0) AMOUNT'
      
        '1101352469=           ,COALESCE(CAST(A.AMOUNT AS NUMERIC), 0) * ' +
        'DECODE((SELECT S.S_VALUE'
      
        '1101352470=                                             FROM SYS' +
        'TEM_SETUP S'
      
        '1101352471=                                            WHERE S.S' +
        'YSTEM_SETUP = 1),'
      '1101352472=                                           1,'
      
        '1101352473=                                           (SELECT SS' +
        '.PRICE'
      
        '1101352474=                                              FROM SK' +
        'LAD SS'
      
        '1101352475=                                             WHERE SS' +
        '.DATE_RECEIPT = (SELECT MAX(DATE_RECEIPT)'
      
        '1101352476=                                                     ' +
        '                   FROM SKLAD'
      
        '1101352477=                                                     ' +
        '                  WHERE DATE_RECEIPT < :DATE_'
      
        '1101352478=                                                     ' +
        '                    AND G_PRODUCT = A.G_PRODUCT'
      
        '1101352479=                                                     ' +
        '                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||g_tochka|' +
        '|'#39'-'#39
      
        '1101352480=                                                     ' +
        '                    AND IS_VOZVRAT IN (0, 4))'
      
        '1101352481=                                               AND SS' +
        '.G_PRODUCT = A.G_PRODUCT'
      
        '1101352482=                                               AND :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SS.g_tochka||'#39'-'#39
      
        '1101352483=                                               AND SS' +
        '.IS_VOZVRAT IN (0, 4)'
      
        '1101352484=                                            ORDER BY ' +
        'SS.SKLAD DESC ROWS 1 TO 1),'
      
        '1101352485=                                           (SELECT RO' +
        'UND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '1101352486=                                            FROM (SEL' +
        'ECT CAST(S.AMOUNT AS MY_NUMERIC) AMOUNT, S.PRICE'
      
        '1101352487=                                                    F' +
        'ROM SKLAD S'
      
        '1101352488=                                                   WH' +
        'ERE S.DATE_RECEIPT <= :DATE_'
      
        '1101352489=                                                     ' +
        'AND S.G_PRODUCT = A.G_PRODUCT'
      
        '1101352490=                                                     ' +
        'AND S.IS_VOZVRAT IN (0, 4)'
      
        '1101352491=                                                     ' +
        'AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.g_tochka||'#39'-'#39
      
        '1101352492=                                                    O' +
        'RDER BY S.DATE_RECEIPT DESC ROWS 1 TO 5) T)'
      '1101352493=                                         )'
      '1101352494=      FROM OSTATOK_ARR A'
      '1101352495=    ORDER BY NAME, G_PRODUCT_PAR'
      '1101352496=    INTO :NAME,'
      '1101352497=         :BARCODE,'
      '1101352498=         :ARTICUL,'
      '1101352499=         :PRICE,'
      '1101352500=         :G_PRODUCT_PAR,'
      '1101352501=         :AMOUNT,'
      '1101352502=         :SUMM'
      '1101352503=  DO'
      '1101352504=    SUSPEND;'
      '1101352505='
      '1101352506=WHEN ANY DO BEGIN'
      '1101352507=    Err_code = -20500;'
      
        '1101352508=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101352509=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101352510=  END'
      '1101352511=end'
      '1101352512=;'
      '1101352513='
      '1101352514=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1101352515=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101352516=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101352517=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101352518=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101352519=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101352520=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101352521=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101352522=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101352523=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101352524=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101352525=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101352526=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101352527=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101352528=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101352529=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101352530=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101352531=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101352532=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101352533=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101352534=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1101352535=  NOT_MINUS_OSTATOK_ INTEGER = 0)'
      '1101352536=RETURNS ('
      '1101352537=  ERR_CODE INTEGER,'
      '1101352538=  ERR_MSG VARCHAR(1024))'
      '1101352539=AS'
      '1101352540=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1101352541='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1101352542=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1101352543=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1101352544='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1101352545=*/'
      
        '1101352546=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1101352547=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101352548=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101352549=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1101352550=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101352551=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1101352552=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1101352553=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1101352554=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1101352555=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101352556=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      '1101352557=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101352558=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101352559=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101352560=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      
        '1101352561=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101352562=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101352563=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101352564=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;' +
        ' /* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '1101352565=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '1101352566=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '1101352567=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1101352568=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101352569=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101352570=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101352571=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101352572=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101352573=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101352574=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101352575=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1101352576=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1101352577=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101352578=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101352579=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101352580=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1101352581=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1101352582=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1101352583=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101352584=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1101352585=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101352586=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      '1101352587=BEGIN'
      '1101352588='
      '1101352589=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101352590=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101352591=      SELECT Z.G_PAYMENT_TYPE,'
      '1101352592=             Z.G_TOCHKA,'
      '1101352593=             Z.SUMM,'
      '1101352594=             Z.SUMM_BONUS,'
      '1101352595=             Z.SUMM_BONUS_GOT,'
      '1101352596=             z.g_client,'
      '1101352597=             Z.G_OFFICIAL,'
      '1101352598=             G.DO_NOT_SALES_COMM,'
      '1101352599=             G.FM||'#39' '#39'||G.NM'
      
        '1101352600=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101352601=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101352602=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1101352603=             :G_TOCHKA_,'
      '1101352604=             :SUMM_OLD_,'
      '1101352605=             :SUMM_BONUS_OLD_,'
      '1101352606=             :SUMM_BONUS_GOT_OLD_,'
      '1101352607=             :g_client_old_,'
      '1101352608=             :G_OFFICIAL_,'
      '1101352609=             :DO_NOT_SALES_COMM_,'
      '1101352610=             :OFFICIAL_NAME_;'
      '1101352611='
      
        '1101352612=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101352613=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1101352614=        SELECT SUM(ZD.SALES_COMM)'
      '1101352615=          FROM ZAKAZ_DETAILS ZD'
      '1101352616=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101352617=          INTO :SALES_COMM_OLD_;'
      '1101352618='
      '1101352619=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101352620=      PNT_ = '#39'02'#39';'
      
        '1101352621=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101352622=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101352623=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101352624=        EXIT;'
      '1101352625=      END'
      '1101352626='
      
        '1101352627=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101352628=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101352629=      ELSE'
      '1101352630=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101352631='
      '1101352632=      PNT_ = '#39'01'#39';'
      '1101352633=      UPDATE zakaz'
      '1101352634=      SET'
      '1101352635=       G_TOCHKA = :G_TOCHKA_,'
      '1101352636=       Z_DATE = :Z_DATE_,'
      '1101352637=       Z_TIME = :Z_TIME_,'
      '1101352638=       G_CLIENT = :G_CLIENT_,'
      '1101352639=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101352640=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101352641=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1101352642=       SUMM = :SUMM_,'
      '1101352643=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1101352644=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101352645=       ,BY_RECIPE = :BY_RECIPE_'
      '1101352646=       ,IS_RESERVE = :IS_RESERVE_'
      '1101352647=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1101352648=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1101352649=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1101352650=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1101352651=       ,NOT_MINUS_OSTATOK = :NOT_MINUS_OSTATOK_'
      '1101352652=      WHERE'
      '1101352653=        zakaz = :zakaz_;'
      '1101352654='
      
        '1101352655=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1101352656=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1101352657=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1101352658=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1101352659=          UPDATE G_DISCONT_CARD D'
      '1101352660=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1101352661=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1101352662=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1101352663='
      
        '1101352664=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1101352665=          SUMM_OLD_           = 0;'
      '1101352666=      END'
      '1101352667=      UPDATE G_DISCONT_CARD D'
      
        '1101352668=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1101352669=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1101352670=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1101352671='
      '1101352672=      PNT_ = '#39'03'#39';'
      '1101352673=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1101352674=                 T.G_PRODUCT,'
      '1101352675=                 T.AMOUNT,'
      '1101352676=                 T.SUMM,'
      '1101352677=                 G.SALES_COMM'
      '1101352678=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1101352679=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1101352680=      INTO :ZAKAZ_DETAILS_,'
      '1101352681=           :G_PRODUCT_,'
      '1101352682=           :Z_AMOUNT_,'
      '1101352683=           :DETAILS_SUMM_,'
      '1101352684=           :SALES_COMM_'
      '1101352685=      DO BEGIN'
      
        '1101352686=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101352687=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1101352688=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1101352689=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101352690=        END'
      '1101352691='
      
        '1101352692=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101352693=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1101352694=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101352695=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1101352696=          FROM ZAKAZ_DETAILS_TMP Z'
      '1101352697=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1101352698='
      
        '1101352699=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057 +
        #1050#1051#1040#1044#1040
      
        '1101352700=        IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK_ = ' +
        '0) THEN'
      '1101352701=            UPDATE LT_SKLAD_PRODUCT L'
      '1101352702=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '1101352703=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101352704=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101352705='
      '1101352706=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101352707=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101352708=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1101352709=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERV' +
        'E + :Z_AMOUNT_'
      '1101352710=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101352711=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101352712=      END'
      '1101352713='
      '1101352714=      ----------------------------------------'
      
        '1101352715=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101352716=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1101352717=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1101352718=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101352719=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101352720=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1101352721=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101352722=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101352723=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1101352724=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1101352725=                PNT_ = '#39'04'#39';'
      
        '1101352726=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101352727=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101352728=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101352729=                ELSE'
      
        '1101352730=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101352731='
      
        '1101352732=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101352733=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101352734='
      
        '1101352735=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101352736='
      '1101352737=                PNT_ = '#39'05'#39';'
      
        '1101352738=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN'
      
        '1101352739=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101352740=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101352741=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101352742=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101352743=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101352744=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1101352745=                                                  NUL' +
        'L,'
      
        '1101352746=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101352747=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101352748='
      
        '1101352749=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101352750=                ELSE BEGIN'
      
        '1101352751=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101352752=                    SELECT 1'
      '1101352753=                      FROM KASSA K'
      '1101352754=                     WHERE K.KASSA = :KASSA_'
      '1101352755=                    UNION ALL'
      '1101352756=                    SELECT 2'
      '1101352757=                      FROM KASSA_BEZNAL KB'
      '1101352758=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101352759=                     INTO :PAYMENT_TYPE_OLD_;'
      '1101352760='
      '1101352761=                    PNT_ = '#39'06'#39';'
      
        '1101352762=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
        'YPE_) THEN'
      
        '1101352763=                        EXECUTE PROCEDURE K_UPD_KASSA' +
        '(:KASSA_,'
      
        '1101352764=                                                     ' +
        ' 0,     -- ACTION_'
      
        '1101352765=                                                     ' +
        ' 1,     --:G_PRIHOD_RASHOD_,'
      
        '1101352766=                                                     ' +
        ' :PAYMENT_SUMM_,'
      
        '1101352767=                                                     ' +
        ' :PAYMENT_DATE_,'
      
        '1101352768=                                                     ' +
        ' NULL,   --NOTE_'
      
        '1101352769=                                                     ' +
        ' :ZAKAZ_,'
      
        '1101352770=                                                     ' +
        ' NULL,'
      
        '1101352771=                                                     ' +
        ' :PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '1101352772=                    -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' ' +
        #1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101352773=                    -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' ' +
        #1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101352774=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101352775=                        PNT_ = '#39'07'#39';'
      
        '1101352776=                        EXECUTE PROCEDURE K_DEL_KASSA' +
        '(:KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_' +
        'MSG);'
      
        '1101352777=                        IF (:ERR_CODE <> 0) THEN BEGI' +
        'N'
      
        '1101352778=                          ERR_MSG = PROCNAME||'#39' -> PN' +
        'T_ '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101352779=                          EXIT;'
      '1101352780=                        END'
      '1101352781='
      '1101352782=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '1101352783=                           EXECUTE PROCEDURE K_INS_KA' +
        'SSA(0,     -- ACTION_ => :ACTION_'
      
        '1101352784=                                                     ' +
        '     1,     -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101352785=                                                     ' +
        '     :PAYMENT_SUMM_,'
      
        '1101352786=                                                     ' +
        '     :PAYMENT_DATE_,'
      
        '1101352787=                                                     ' +
        '     NULL,   --NOTE_ => :NOTE_,'
      
        '1101352788=                                                     ' +
        '     :ZAKAZ_,   --ZAKAZ_'
      
        '1101352789=                                                     ' +
        '     NULL,'
      
        '1101352790=                                                     ' +
        '     :PAYMENT_TYPE_,'
      
        '1101352791=                                                     ' +
        '     :G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG)' +
        ';'
      '1101352792=                    END'
      '1101352793=                END'
      '1101352794=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101352795=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101352796=                  EXIT;'
      '1101352797=                END'
      '1101352798='
      
        '1101352799=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101352800=            END'
      '1101352801='
      
        '1101352802=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101352803=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101352804=                FROM KASSA K'
      '1101352805=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101352806=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
      '1101352807=                UNION'
      '1101352808=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1101352809=                  FROM KASSA K'
      '1101352810=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1101352811=                   AND K.SUMM = 0'
      '1101352812=                UNION'
      
        '1101352813=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101352814=                FROM KASSA_BEZNAL K'
      '1101352815=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101352816=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA_BEZNAL||'#39'~'#39
      '1101352817=                UNION'
      
        '1101352818=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101352819=                FROM KASSA_BEZNAL K'
      '1101352820=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101352821=                 AND K.SUMM = 0'
      '1101352822=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101352823=            DO BEGIN'
      '1101352824=                PNT_ = '#39'08'#39';'
      
        '1101352825=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_' +
        ', :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101352826=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101352827=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '1101352828=                    EXIT;'
      '1101352829=                END'
      '1101352830=            END'
      '1101352831='
      
        '1101352832=            --=======================================' +
        '=========================='
      '1101352833=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101352834=            --=======================================' +
        '=========================='
      
        '1101352835=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057 +
        #1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101352836=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040 +
        #1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '1101352837=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055 +
        #1054' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1101352838=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101352839=                SELECT K.KASSA'
      '1101352840=                FROM KASSA K'
      '1101352841=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101352842=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101352843=                 INTO :KASSA_POP_;'
      '1101352844=            ELSE'
      '1101352845=                SELECT K.KASSA_BEZNAL'
      '1101352846=                FROM KASSA_BEZNAL K'
      '1101352847=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101352848=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101352849=                 INTO :KASSA_POP_;'
      '1101352850='
      
        '1101352851=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101352852=              PNT_ = '#39'09'#39';'
      
        '1101352853=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' ' +
        #1054#1053#1040' '#1045#1057#1058#1068
      '1101352854=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '1101352855=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_POP_,'
      
        '1101352856=                                                  0, ' +
        '    -- ACTION_'
      
        '1101352857=                                                  :G_' +
        'PRIHOD_,'
      
        '1101352858=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101352859=                                                  :Z_' +
        'DATE_,'
      
        '1101352860=                                                  NUL' +
        'L,   --NOTE_'
      
        '1101352861=                                                  :ZA' +
        'KAZ_,'
      
        '1101352862=                                                  NUL' +
        'L,'
      
        '1101352863=                                                  :G_' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101352864=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101352865=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '1101352866=                    PNT_ = '#39'10'#39';'
      
        '1101352867=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101352868=                                                  :G_' +
        'PRIHOD_,'
      
        '1101352869=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101352870=                                                  :Z_' +
        'DATE_,'
      
        '1101352871=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101352872=                                                  :ZA' +
        'KAZ_,'
      
        '1101352873=                                                  NUL' +
        'L,'
      
        '1101352874=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1101352875=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101352876=              END'
      '1101352877='
      
        '1101352878=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101352879=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101352880=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101352881=                PNT_ = '#39'11'#39';'
      '1101352882=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101352883=                    EXECUTE PROCEDURE K_DEL_KASSA(:KA' +
        'SSA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1101352884=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101352885=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101352886=                      EXIT;'
      '1101352887=                    END'
      '1101352888='
      
        '1101352889=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101352890=                                                  :G_' +
        'PRIHOD_,'
      
        '1101352891=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101352892=                                                  :Z_' +
        'DATE_,'
      
        '1101352893=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101352894=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1101352895=                                                  NUL' +
        'L,'
      
        '1101352896=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1101352897=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101352898=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101352899=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101352900=                      EXIT;'
      '1101352901=                    END'
      '1101352902=                END'
      '1101352903=            END'
      
        '1101352904=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040 +
        #1058#1068#1048
      
        '1101352905=            --=======================================' +
        '=========================='
      '1101352906='
      
        '1101352907=            --=======================================' +
        '=========================='
      '1101352908=            -- '#1041#1051#1054#1050' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101352909=            --=======================================' +
        '=========================='
      '1101352910=            PNT_ = '#39'12'#39';'
      
        '1101352911=            IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SA' +
        'LES_COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0)' +
        ' THEN BEGIN'
      '1101352912=                KASSA_ = NULL;'
      '1101352913='
      '1101352914=                SELECT S.S_VALUE'
      '1101352915=                  FROM SYSTEM_SETUP S'
      '1101352916=                 WHERE S.SYSTEM_SETUP = 4'
      '1101352917=                  INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101352918='
      '1101352919=                -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101352920=                IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101352921=                  ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101352922='
      
        '1101352923=                -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057 +
        #1051#1071#1070' '#1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101352924=                ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1)' +
        ' THEN'
      
        '1101352925=                  ACTION_DATE_ZP_ = CURRENT_DATE + (7' +
        ' - DECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEK' +
        'DAY FROM CURRENT_DATE)));'
      '1101352926='
      '1101352927=                -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101352928=                ELSE'
      
        '1101352929=                   ACTION_DATE_ZP_ = Current_date - E' +
        'XTRACT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_da' +
        'te - EXTRACT(DAY FROM current_date) + 32);'
      '1101352930='
      '1101352931=                SELECT K.KASSA, K.SUMM'
      '1101352932=                FROM KASSA K'
      '1101352933=                WHERE K.G_PRIHOD_RASHOD = -1'
      '1101352934=                 AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101352935=                 AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101352936=                 AND K.G_TOCHKA = :G_TOCHKA_'
      
        '1101352937=                 INTO :KASSA_, :SALES_COMM_SUMM_ITER_' +
        ';'
      '1101352938='
      '1101352939=                IF (KASSA_ IS NULL) THEN'
      
        '1101352940=                    EXECUTE PROCEDURE K_INS_KASSA(1, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101352941=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101352942=                                                  :SA' +
        'LES_COMM_SUMM_ALL_,'
      
        '1101352943=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101352944=                                                  :OF' +
        'FICIAL_NAME_,'
      
        '1101352945=                                                  NUL' +
        'L,     --:ZAKAZ_,'
      
        '1101352946=                                                  NUL' +
        'L,     --:SKLAD_,'
      '1101352947=                                                  1,'
      
        '1101352948=                                                  :G_' +
        'TOCHKA_,'
      
        '1101352949=                                                  :G_' +
        'OFFICIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101352950=                ELSE BEGIN'
      
        '1101352951=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_,'
      
        '1101352952=                                                  1, ' +
        '    -- ACTION_'
      
        '1101352953=                                                  -1,' +
        '     --:G_PRIHOD_RASHOD_,'
      
        '1101352954=                                                  :SA' +
        'LES_COMM_SUMM_ITER_ + :SALES_COMM_SUMM_ALL_ - :SALES_COMM_OLD_,'
      
        '1101352955=                                                  :AC' +
        'TION_DATE_ZP_,'
      
        '1101352956=                                                  :OF' +
        'FICIAL_NAME_,   --NOTE_'
      
        '1101352957=                                                  NUL' +
        'L,'
      
        '1101352958=                                                  NUL' +
        'L,'
      
        '1101352959=                                                  1, ' +
        '  --:PAYMENT_TYPE_,'
      
        '1101352960=                                                  :G_' +
        'OFFICIAL_'
      
        '1101352961=                                                  ) R' +
        'ETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101352962=                END'
      '1101352963=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101352964=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101352965=                  EXIT;'
      '1101352966=                END'
      '1101352967=            END'
      
        '1101352968=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042 +
        #1062#1059
      
        '1101352969=            --=======================================' +
        '=========================='
      '1101352970='
      '1101352971=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '1101352972='
      '1101352973=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101352974=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101352975=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101352976=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 2);'
      '1101352977=  END'
      '1101352978=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '1101352979=  ---------------------------------------------------' +
        '------------'
      
        '1101352980=  --*************************************************' +
        '************'
      
        '1101352981=  ---------------------------------------------------' +
        '------------'
      '1101352982=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101352983=  ELSE BEGIN'
      '1101352984=      PNT_ = '#39'020'#39';'
      '1101352985=      SELECT SP.G_TOCHKA,'
      '1101352986=             SP.G_CLIENT,'
      '1101352987=             SP.IS_EXPECTED'
      '1101352988=        FROM SKLAD_PARENT SP'
      '1101352989=       WHERE SP.SKLAD = :ZAKAZ_'
      '1101352990=        INTO :G_TOCHKA_OLD_,'
      '1101352991=             :G_TOCHKA_,'
      '1101352992=             :IS_EXPECTED_OLD_;'
      '1101352993='
      
        '1101352994=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059 +
        #1063#1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040 +
        #1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101352995=      PNT_ = '#39'021'#39';'
      '1101352996=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '1101352997=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_,' +
        ' NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101352998=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101352999=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101353000=            EXIT;'
      '1101353001=          END'
      '1101353002='
      '1101353003=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101353004=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101353005=                FROM ZAKAZ_DETAILS_TMP Z'
      '1101353006=              INTO :G_PRODUCT_,'
      '1101353007=                  :Z_AMOUNT_,'
      '1101353008=                  :PRICE_,'
      '1101353009=                  :SUMMM_'
      '1101353010=          DO BEGIN'
      '1101353011=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101353012=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040 +
        #1042#1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '1101353013=            IS_THIS_LAST_ = 0;'
      '1101353014=            SELECT MAX(SK.DATE_RECEIPT)'
      '1101353015=                FROM SKLAD SK'
      '1101353016=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101353017=                 AND SK.IS_LAST = 1'
      '1101353018=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '1101353019=                INTO :DATE_LAST_;'
      '1101353020='
      
        '1101353021=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALES' +
        'CE(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101353022=                UPDATE SKLAD SK'
      '1101353023=                   SET SK.IS_LAST = 0'
      '1101353024=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101353025=                   AND SK.IS_LAST = 1'
      '1101353026=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101353027='
      '1101353028=                IS_THIS_LAST_ = 1;'
      '1101353029=            END'
      '1101353030='
      '1101353031='
      '1101353032=            INSERT INTO SKLAD'
      '1101353033=            ('
      '1101353034=             SKLAD,'
      '1101353035=             SKLAD_PARENT,'
      '1101353036=             DATE_RECEIPT,'
      '1101353037=             G_CLIENT,'
      '1101353038=             G_PRODUCT,'
      '1101353039=             AMOUNT,'
      '1101353040=             PRICE,'
      '1101353041=             SUMM,'
      '1101353042=             G_PAYMENT_TYPE,'
      '1101353043=             OSNOVANIE,'
      '1101353044=             NOTE,'
      '1101353045=             NDS,'
      '1101353046=             NDS_SUMM,'
      '1101353047=             IS_LAST,'
      '1101353048=             IS_VOZVRAT,'
      '1101353049=             G_TOCHKA'
      '1101353050=            ) VALUES ('
      '1101353051=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101353052=             :ZAKAZ_,'
      '1101353053=             :Z_DATE_,'
      '1101353054=             :G_TOCHKA_,'
      '1101353055=             :G_PRODUCT_,'
      '1101353056=             :Z_AMOUNT_,'
      '1101353057=             :PRICE_,'
      '1101353058=             :SUMMM_,'
      '1101353059=             :G_PAYMENT_TYPE_,'
      '1101353060=             :OSNOVANIE_,'
      '1101353061=             :NOTE_,'
      '1101353062=             0,  --:RNDS_,'
      '1101353063=             0,  --:RNDS_SUMM_,'
      
        '1101353064=             DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051 +
        #1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042 +
        #1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042 +
        #1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1101353065=             3,  --:IS_VOZVRAT_,'
      '1101353066=             :G_CLIENT_'
      '1101353067=            );'
      '1101353068='
      
        '1101353069=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1101353070=            UPDATE LT_SKLAD_PRODUCT L'
      '1101353071=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '1101353072=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353073=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101353074='
      
        '1101353075=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1101353076=            PNT_ = '#39'023'#39';'
      '1101353077=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101353078=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353079=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_'
      '1101353080=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353081=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1101353082='
      '1101353083=                IF (ROW_COUNT = 0) THEN'
      
        '1101353084=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_' +
        'SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101353085=            END'
      '1101353086=          END'
      '1101353087=      END'
      '1101353088=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1101353089=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1101353090=      ELSE BEGIN'
      
        '1101353091=          -------------------------------------------' +
        '------------------'
      
        '1101353092=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1101353093=          PNT_ = '#39'025'#39';'
      '1101353094=          FOR SELECT SKLAD,'
      '1101353095=                     AMOUNT,'
      '1101353096=                     G_PRODUCT'
      '1101353097=                FROM SKLAD S'
      '1101353098=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1101353099=                 AND NOT EXISTS (SELECT 1'
      
        '1101353100=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1101353101=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1101353102=          INTO :SKLAD_,'
      '1101353103=               :Z_AMOUNT_,'
      '1101353104=               :G_PRODUCT_'
      '1101353105=          DO BEGIN'
      
        '1101353106=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101353107=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101353108=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101353109=              EXIT;'
      '1101353110=            END'
      '1101353111=          END'
      '1101353112='
      '1101353113=          PNT_ = '#39'030'#39';'
      '1101353114=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1101353115=                     S.G_PRODUCT,'
      '1101353116=                     S.AMOUNT,'
      '1101353117=                     S.PRICE,'
      '1101353118=                     S.SUMM,'
      '1101353119=                     T.SKLAD,'
      '1101353120=                     T.AMOUNT,'
      '1101353121=                     T.IS_LAST,'
      '1101353122=                     T.DATE_RECEIPT'
      
        '1101353123=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1101353124=                INTO :ZAKAZ_DETAILS_,'
      '1101353125=                     :G_PRODUCT_,'
      '1101353126=                     :Z_AMOUNT_,'
      '1101353127=                     :PRICE_,'
      '1101353128=                     :SUMMM_,'
      '1101353129=                     :SKLAD_OLD_,'
      '1101353130=                     :AMOUNT_OLD_,'
      '1101353131=                     :IS_THIS_LAST_,'
      '1101353132=                     :DATE_RECEIPT_OLD_'
      '1101353133=          DO BEGIN'
      
        '1101353134=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101353135=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1101353136=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1101353137=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1101353138=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1101353139=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1101353140=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1101353141=                       )'
      '1101353142=                RETURNING'
      '1101353143=                  SKLAD'
      '1101353144=                INTO'
      '1101353145=                  :SKLAD_;'
      '1101353146='
      
        '1101353147=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101353148=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353149=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_'
      '1101353150=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353151=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101353152='
      
        '1101353153=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101353154=                IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGI' +
        'N'
      '1101353155=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353156=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_'
      '1101353157=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353158=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101353159='
      '1101353160=                    IF (ROW_COUNT = 0) THEN'
      
        '1101353161=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN' +
        '_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101353162=                END'
      '1101353163='
      
        '1101353164=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1101353165=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045 +
        #1053#1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042 +
        #1051#1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1101353166=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_S' +
        'KLAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1101353167=                /*SELECT MAX(SK.DATE_RECEIPT)'
      '1101353168=                  FROM SKLAD SK'
      '1101353169=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101353170=                   AND SK.IS_LAST = 1'
      '1101353171=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '1101353172=                  INTO :DATE_LAST_;'
      '1101353173='
      
        '1101353174=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ ' +
        '>= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101353175=                  UPDATE SKLAD SK'
      '1101353176=                     SET SK.IS_LAST = 0'
      '1101353177=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101353178=                     AND SK.IS_LAST = 1'
      '1101353179=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101353180='
      '1101353181=                  UPDATE SKLAD SK'
      '1101353182=                     SET SK.IS_LAST = 1'
      '1101353183=                   WHERE SK.SKLAD = :SKLAD_;'
      '1101353184=                END*/'
      '1101353185='
      
        '1101353186=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1101353187=            END ELSE BEGIN'
      '1101353188=                UPDATE SKLAD S'
      '1101353189=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1101353190=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1101353191=                       S.PRICE    = :PRICE_,'
      '1101353192=                       S.SUMM     = :SUMMM_,'
      '1101353193=                       S.OSNOVANIE = :OSNOVANIE_,'
      '1101353194=                       S.NOTE      = :NOTE_'
      '1101353195=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1101353196='
      
        '1101353197=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1101353198=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101353199=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353200=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_)'
      '1101353201=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353202=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1101353203=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1101353204=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353205=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_)'
      '1101353206=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353207=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101353208='
      
        '1101353209=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1101353210=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101353211=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1101353212=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353213=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_)'
      
        '1101353214=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101353215=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101353216='
      
        '1101353217=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1101353218=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353219=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_)'
      
        '1101353220=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1101353221=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1101353222='
      
        '1101353223=                -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' ' +
        #1057#1050#1051#1040#1044', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1101353224=                END ELSE IF (IS_EXPECTED_OLD_ = 1 AND' +
        ' NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101353225=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353226=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_'
      '1101353227=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353228=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101353229='
      '1101353230=                    IF (ROW_COUNT = 0) THEN'
      
        '1101353231=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '1101353232=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '1101353233=                END'
      
        '1101353234=                -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042 +
        #1040' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1101353235=                ELSE IF (IS_EXPECTED_OLD_ = 0 AND NOT' +
        '_MINUS_OSTATOK_ = 1) THEN BEGIN'
      '1101353236=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101353237=                       SET L.AMOUNT = L.AMOUNT - (:AM' +
        'OUNT_OLD_ - :Z_AMOUNT_) - :Z_AMOUNT_'
      '1101353238=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101353239=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1101353240=                END'
      '1101353241='
      
        '1101353242=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1101353243=                /*IF ((Z_DATE_ > DATE_RECEIPT_OLD_) A' +
        'ND (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1101353244=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101353245=                      FROM SKLAD SK'
      '1101353246=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101353247=                       AND SK.IS_LAST = 1'
      '1101353248=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101353249=                      INTO :DATE_LAST_;'
      '1101353250='
      
        '1101353251=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101353252=                      UPDATE SKLAD SK'
      '1101353253=                         SET SK.IS_LAST = 0'
      
        '1101353254=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1101353255=                         AND SK.IS_LAST = 1'
      
        '1101353256=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1101353257='
      '1101353258=                      UPDATE SKLAD SK'
      '1101353259=                         SET SK.IS_LAST = 1'
      
        '1101353260=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101353261=                    END'
      '1101353262=                END'
      '1101353263='
      
        '1101353264=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1101353265=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1101353266=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1101353267=                      FROM SKLAD SK'
      '1101353268=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1101353269=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1101353270=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1101353271=                       AND SK.is_vozvrat IN (0,3,4)'
      '1101353272=                      INTO :DATE_LAST_;'
      '1101353273='
      
        '1101353274=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101353275=                      UPDATE SKLAD SK'
      '1101353276=                         SET SK.IS_LAST = 0'
      
        '1101353277=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1101353278='
      '1101353279=                       UPDATE SKLAD SK'
      '1101353280=                         SET SK.IS_LAST = 1'
      
        '1101353281=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1101353282=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1101353283=                                           FROM SKLAD' +
        ' SS'
      
        '1101353284=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1101353285=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1101353286=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1101353287=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1101353288=                    END'
      '1101353289=                END*/'
      '1101353290=            END'
      '1101353291=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1101353292=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1101353293='
      '1101353294=      UPDATE SKLAD_PARENT'
      '1101353295=      SET'
      
        '1101353296=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1101353297=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1101353298=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1101353299=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101353300=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1101353301=       SUMM      = :SUMM_,'
