      '1101825562=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101825563=                 INTO :KASSA_POP_;'
      '1101825564='
      
        '1101825565=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101825566=              PNT_ = '#39'09'#39';'
      
        '1101825567=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' ' +
        #1054#1053#1040' '#1045#1057#1058#1068
      '1101825568=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '1101825569=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_POP_,'
      
        '1101825570=                                                  0, ' +
        '    -- ACTION_'
      
        '1101825571=                                                  :G_' +
        'PRIHOD_,'
      
        '1101825572=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101825573=                                                  :Z_' +
        'DATE_,'
      
        '1101825574=                                                  NUL' +
        'L,   --NOTE_'
      
        '1101825575=                                                  :ZA' +
        'KAZ_,'
      
        '1101825576=                                                  NUL' +
        'L,'
      
        '1101825577=                                                  :G_' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101825578=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101825579=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '1101825580=                    PNT_ = '#39'10'#39';'
      
        '1101825581=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101825582=                                                  :G_' +
        'PRIHOD_,'
      
        '1101825583=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101825584=                                                  :Z_' +
        'DATE_,'
      
        '1101825585=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101825586=                                                  :ZA' +
        'KAZ_,'
      
        '1101825587=                                                  NUL' +
        'L,'
      
        '1101825588=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1101825589=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101825590=              END'
      '1101825591='
      
        '1101825592=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101825593=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101825594=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101825595=                PNT_ = '#39'11'#39';'
      '1101825596=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101825597=                    EXECUTE PROCEDURE K_DEL_KASSA(:KA' +
        'SSA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1101825598=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101825599=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101825600=                      EXIT;'
      '1101825601=                    END'
      '1101825602='
      
        '1101825603=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101825604=                                                  :G_' +
        'PRIHOD_,'
      
        '1101825605=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101825606=                                                  :Z_' +
