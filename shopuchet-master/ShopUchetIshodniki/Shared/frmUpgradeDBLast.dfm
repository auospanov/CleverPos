      '110606377=  SKIDKA_ NUMERIC(15,2),'
      '110606378=  BY_DEFAULT_ INTEGER,'
      '110606379=  IS_BEZNAL_ INTEGER,'
      '110606380=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110606381=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110606382=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110606383=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110606384=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110606385=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110606386=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110606387=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '110606388=  NOTIFY_SKIDKA_ INTEGER,'
      '110606389=  NOTIFY_DR_ INTEGER,'
      '110606390=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '110606391=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110606392=  FM_PROMO_ VARCHAR(50),'
      '110606393=  ERR_CODE INTEGER,'
      '110606394=  ERR_MSG VARCHAR(1024))'
      '110606395=AS'
      '110606396=begin'
      '110606397=    SELECT'
      
        '110606398=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE,' +
        ' SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '110606399=      ,P.G_PROMOTION'
      '110606400=      ,P.NAME'
      '110606401=      ,notify_dr'
      '110606402=      ,notify_skidka'
      
        '110606403=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T' +
        '.g_promotion = P.g_promotion'
      '110606404=    WHERE T.G_CLIENT = :G_CLIENT_'
      '110606405=    INTO'
      
        '110606406=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_' +
        ', :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :D' +
        'T_, :NAME_FULL_'
      '110606407=      ,:G_PROMOTION_'
      '110606408=      ,:G_PROMOTION_STR_'
      '110606409=      ,:NOTIFY_DR_'
      '110606410=      ,:NOTIFY_SKIDKA_'
      '110606411=      ;'
      '110606412='
      '110606413=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '110606414=    FROM G_DISCONT_CARD'
      '110606415=    WHERE G_CLIENT = :G_CLIENT_'
      '110606416=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '110606417=end'
      '110606418=;'
      '110606419='
      '110606420=ALTER PROCEDURE G_GET_G_PRODUCT('
      '110606421=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '110606422=RETURNS ('
      
        '110606423=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PA' +
        'R,'
      '110606424=  ARTICUL_ VARCHAR(30),'
      '110606425=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110606426=  BARCODE_ VARCHAR(30),'
      '110606427=  NAME_ VARCHAR(500),'
      '110606428=  G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT,'
      '110606429=  PRICE_ NUMERIC(15,2),'
      '110606430=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110606431=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110606432=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '110606433=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '110606434=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '110606435=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '110606436=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '110606437=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '110606438=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM,'
      '110606439=  ERR_CODE INTEGER,'
      '110606440=  ERR_MSG VARCHAR(1024))'
      '110606441=AS'
      '110606442=begin'
      '110606443=    SELECT'
      '110606444=        G_PRODUCT_PAR,'
      '110606445=        ARTICUL,'
      '110606446=        NOMENCLATUR_NUM,'
      '110606447=        BARCODE,'
      '110606448=        NAME,'
      '110606449=        G_UNIT,'
      '110606450=        PRICE,'
      '110606451=        VOLUME_PRICE,'
      '110606452=        PACK_AMOUNT,'
      '110606453=        MF_COUNTRY,'
      '110606454=        NOTE,'
      '110606455=        CROSSCODE,'
      '110606456=        IS_KIT,'
      '110606457=        MIN_AMOUNT,'
      '110606458=        PLACE,'
      '110606459=        SALES_COMM'
      '110606460=    FROM G_PRODUCT T'
      '110606461=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110606462=    INTO'
      '110606463=        :G_PRODUCT_PAR_,'
      '110606464=        :ARTICUL_,'
      '110606465=        :NOMENCLATUR_NUM_,'
      '110606466=        :BARCODE_,'
      '110606467=        :NAME_,'
      '110606468=        :G_UNIT_,'
      '110606469=        :PRICE_,'
      '110606470=        :VOLUME_PRICE_,'
      '110606471=        :PACK_AMOUNT_,'
      '110606472=        :MF_COUNTRY_,'
      '110606473=        :NOTE_,'
      '110606474=        :CROSSCODE_,'
      '110606475=        :IS_KIT_,'
      '110606476=        :MIN_AMOUNT_,'
      '110606477=        :PLACE_,'
      '110606478=        :SALES_COMM_;'
      '110606479='
      '110606480=    INSERT INTO LT_BARCODE_TMP'
      
        '110606481=    SELECT LT_BARCODE, G_PRODUCT, BARCODE FROM LT_BARC' +
        'ODE WHERE G_PRODUCT = :G_PRODUCT_;'
      '110606482='
      '110606483=    INSERT INTO G_PRODUCT_IMAGE_TMP'
      
        '110606484=    SELECT * FROM G_PRODUCT_IMAGE WHERE G_PRODUCT = :G' +
        '_PRODUCT_;'
      '110606485='
      '110606486=    INSERT INTO G_PRODUCT_KIT_TMP'
      
        '110606487=    SELECT * FROM G_PRODUCT_KIT WHERE G_PRODUCT = :G_P' +
        'RODUCT_;'
      '110606488=end'
      '110606489=;'
      '110606490='
      '110606491=ALTER PROCEDURE G_GET_G_PRODUCT_SALEMODE('
      '110606492=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110606493=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '110606494=RETURNS ('
      '110606495=  NAME_ VARCHAR(500),'
      '110606496=  PRICE_ NUMERIC(15,2),'
      '110606497=  ROZN_PRICE_ NUMERIC(15,2),'
      '110606498=  VOLUME_PRICE_ NUMERIC(15,2),'
      '110606499=  AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110606500=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '110606501=  SKIDKA_PROC_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_PROC,'
      '110606502=  SKIDKA_SUMM_ TYPE OF COLUMN G_DISCOUNT.SKIDKA_SUM,'
      '110606503=  ERR_CODE INTEGER,'
      '110606504=  ERR_MSG VARCHAR(1024))'
      '110606505=AS'
      '110606506=BEGIN'
      '110606507=    SELECT'
      '110606508=        t.NAME,'
      '110606509=        t.PRICE,'
      '110606510=        T.price,'
      '110606511=        t.VOLUME_PRICE,'
      '110606512=        t.PACK_AMOUNT'
      
        '110606513=        ,COALESCE(P.AMOUNT, 0) - COALESCE(P.AMOUNT_RES' +
        'ERVE, 0) AMOUNT'
      '110606514=        ,COALESCE(PP.SKIDKA_PROC, 0)'
      '110606515=        ,COALESCE(PP.SKIDKA_SUM, 0)'
      '110606516=    FROM G_PRODUCT T'
      
        '110606517=         LEFT OUTER JOIN (SELECT G_PRODUCT, AMOUNT, AM' +
        'OUNT_RESERVE FROM LT_SKLAD_PRODUCT WHERE G_TOCHKA = :G_TOCHKA_) ' +
        ' P ON T.G_PRODUCT = P.G_PRODUCT'
      
        '110606518=         LEFT OUTER JOIN (SELECT G_PRODUCT, D.SKIDKA_P' +
        'ROC, D.SKIDKA_SUM'
      
        '110606519=                                        FROM G_DISCOUN' +
        'T D'
      
        '110606520=                                        WHERE (D.DATE_' +
        'BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110606521=                                                AND D.' +
        'DATE_END >= CURRENT_TIMESTAMP'
      
        '110606522=                                                AND D.' +
        'DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      '110606523=                                              )'
      '110606524=                                              OR'
      
        '110606525=                                              (D.DATE_' +
        'BEGIN IS NULL AND D.DATE_END IS NULL)'
      
        '110606526=                                        AND COALESCE(D' +
        '.G_TOCHKA, :G_TOCHKA_) = :G_TOCHKA_'
      
        '110606527=                                     ) PP ON T.G_PRODU' +
        'CT = PP.G_PRODUCT'
      '110606528=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110606529=    INTO'
      '110606530=        :NAME_,'
      '110606531=        :PRICE_,'
      '110606532=        :ROZN_PRICE_,'
      '110606533=        :VOLUME_PRICE_,'
      '110606534=        :PACK_AMOUNT_,'
      '110606535=        :AMOUNT_,'
      '110606536=        :SKIDKA_PROC_,'
      '110606537=        :SKIDKA_SUMM_;'
      '110606538=end'
      '110606539=;'
      '110606540='
      '110606541=ALTER PROCEDURE G_INS_G_ADDRESS_TYPE('
      '110606542=  NAME_ TYPE OF COLUMN G_ADDRESS_TYPE.NAME)'
      '110606543=RETURNS ('
      
        '110606544=  G_ADDRESS_TYPE_ TYPE OF COLUMN G_ADDRESS_TYPE.G_ADDR' +
        'ESS_TYPE,'
      '110606545=  ERR_CODE INTEGER,'
      '110606546=  ERR_MSG VARCHAR(1024))'
      '110606547=AS'
      '110606548=begin'
      '110606549=    insert into G_ADDRESS_TYPE (G_ADDRESS_TYPE, NAME)'
      '110606550=    values (GEN_ID(GEN_G_ADDRESS_TYPE, 1), :NAME_)'
      '110606551=    returning G_ADDRESS_TYPE'
      '110606552=    into :G_ADDRESS_TYPE_;'
      '110606553=end'
      '110606554=;'
      '110606555='
      '110606556=ALTER PROCEDURE G_INS_G_BANK('
      '110606557=  BIK_ TYPE OF COLUMN G_BANK.BIK,'
