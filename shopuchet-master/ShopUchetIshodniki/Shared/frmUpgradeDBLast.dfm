      '110215823=       ,:POS_PAY_METHOD_'
      '110215824=       ,:POS_PAY_TRANSACTION_ID_'
      '110215825=      )'
      '110215826=      RETURNING'
      '110215827=        ZAKAZ'
      '110215828=      INTO'
      '110215829=        :ZAKAZ_;'
      '110215830='
      '110215831=      PNT_ = '#39'02'#39';'
      
        '110215832=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110215833=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM, Z.MARK_CODE'
      '110215834=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110215835=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110215836=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110215837=              :G_PRODUCT,'
      '110215838=              :AMOUNT,'
      '110215839=              :PRICE,'
      '110215840=              :SUMM,'
      '110215841=              :DISCOUNT_PERC,'
      '110215842=              :DISCOUNT_TENGE,'
      '110215843=              :DISCOUNT_SUMM,'
      '110215844=              :NDS,'
      '110215845=              :NDS_SUMM,'
      '110215846=              :COST_PRICE,'
      '110215847=              :SALES_COMM_,'
      '110215848=              :MARK_CODE_'
      '110215849=      DO BEGIN'
      
        '110215850=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110215851=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '110215852=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/1' +
        '00;'
      
        '110215853=          --SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_AL' +
        'L_ + SALES_COMM_SUMM_ITER_;'
      '110215854=        END'
      '110215855='
      '110215856=        INSERT INTO ZAKAZ_DETAILS'
      '110215857=        VALUES('
      '110215858=          :ZAKAZ_DETAILS_TMP_,'
      '110215859=          :ZAKAZ_,'
      '110215860=          :G_PRODUCT,'
      '110215861=          :AMOUNT,'
      '110215862=          :PRICE,'
      '110215863=          :SUMM,'
      '110215864=          :DISCOUNT_PERC,'
      '110215865=          :DISCOUNT_TENGE,'
      '110215866=          :DISCOUNT_SUMM,'
      '110215867=          :NDS,'
      '110215868=          :NDS_SUMM,'
      '110215869=          :COST_PRICE,'
      '110215870=          :SALES_COMM_SUMM_ITER_,'
      '110215871=          :MARK_CODE_'
      '110215872=        );'
      '110215873='
      
        '110215874=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045 +
        ' 10%'
      '110215875=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '110215876=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK_' +
        ' = 0) THEN BEGIN'
      '110215877=                UPDATE LT_SKLAD_PRODUCT L'
      '110215878=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '110215879=                       L.NEED_TO_EXPORT = :UPLOAD_TO_E' +
        'XT_APP_  -- '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067 +
        ' '#1055#1056#1048#1061#1054#1044', '#1061#1054#1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '110215880=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '110215881=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110215882='
      '110215883=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110215884=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045 +
        #1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048 +
        #1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110215885=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051 +
        #1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '110215886=                -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071 +
        ' ('#1053#1040#1055#1056#1048#1052#1045#1056' '#1052#1054#1041#1048#1051#1040'), '#1058#1054' '#1053#1040' '#1052#1048#1053#1059#1057' '#1053#1045' '#1055#1056#1054#1042#1045#1056#1071#1070
      '110215887=                PNT_ = '#39'04'#39';'
      
        '110215888=                IF (ROW_COUNT = 0 AND ((SELECT S_VALUE' +
        ' FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0) AND REC_ID_ IS N' +
        'ULL) then BEGIN'
      '110215889=                  Err_Code = -20500;'
      
        '110215890=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_CO' +
        'DE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_P' +
        'RODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084 +
        #1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110215891=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110215892=                  EXIT;'
      '110215893=                END ELSE if (ROW_COUNT = 0) then'
      
        '110215894=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110215895=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,' +
        ' 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);  --' +
        ' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1055#1054' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1042#1067#1043#1056#1059#1046#1040#1070' '#1042#1057#1045#1043#1044#1040', '#1061#1054#1058#1068' '#1057' '#1052#1054#1041#1048#1051#1067' '#1055#1056#1048#1061#1054#1044', '#1061#1054 +
        #1058#1068' '#1053#1045' '#1057' '#1052#1054#1041#1048#1051#1067
      '110215896=            END'
      '110215897='
      '110215898=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110215899=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '110215900=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110215901=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RES' +
        'ERVE + :AMOUNT'
      '110215902=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '110215903=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110215904='
      '110215905='
      '110215906=        END'
      '110215907=      END'
      '110215908='
      '110215909=      ----------------------------------------'
      
        '110215910=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063 +
        #1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '110215911=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051#1068
      '110215912=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '110215913='
      
        '110215914=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048',' +
        ' '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044 +
        #1048#1053' '#1055#1051#1040#1058#1045#1046
      '110215915=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '110215916=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '110215917=                PNT_ = '#39'05'#39';'
      
        '110215918=                EXECUTE PROCEDURE K_INS_KASSA(0,     -' +
        '- ACTION_ => :ACTION_'
      
        '110215919=                                              1,     -' +
        '- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '110215920=                                              :SUMM_FA' +
        'CT_1_,'
      
        '110215921=                                              :Z_DATE_' +
        ','
      
        '110215922=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110215923=                                              ZAKAZ_, ' +
        '  --ZAKAZ_'
      '110215924=                                              NULL,'
      
        '110215925=                                              :G_PAYME' +
        'NT_TYPE_,'
      
        '110215926=                                              :G_TOCHK' +
        'A_,'
      
        '110215927=                                              :UPLOAD_' +
        'TO_EXT_APP_'
      
        '110215928=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110215929=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110215930=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110215931=                  EXIT;'
      '110215932=                END'
      '110215933=            END'
      '110215934='
      '110215935=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '110215936=        END ELSE BEGIN'
      '110215937=            PNT_ = '#39'06'#39';'
      
        '110215938=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      
        '110215939=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_' +
        ');'
      
        '110215940=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110215941=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110215942=                ELSE'
      
        '110215943=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110215944='
      
        '110215945=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110215946=                    RETURNING_VALUES :PAYMENT_ID_, :PA' +
        'YMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110215947='
      
        '110215948=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110215949='
      '110215950=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110215951=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110215952=                                                  1,  ' +
        '   --:G_PRIHOD_RASHOD_,'
      
        '110215953=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110215954=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110215955=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110215956=                                                  :ZAK' +
        'AZ_,'
      
        '110215957=                                                  NULL' +
        ',     --:SKLAD_,'
      
        '110215958=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110215959=                                                  :G_T' +
        'OCHKA_,'
      
        '110215960=                                                  :UPL' +
        'OAD_TO_EXT_APP_'
      
        '110215961=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110215962=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110215963=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110215964=                      EXIT;'
      '110215965=                    END'
      '110215966=                END'
      '110215967=            END'
      '110215968=        END'
      '110215969=      END'
      '110215970='
      
        '110215971=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '110215972=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041 +
        #1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '110215973=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052 +
        ' '#1057#1051#1059#1063#1040#1045
      
        '110215974=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054' ' +
        #1051#1048#1062#1040'"'
      '110215975=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '110215976=          UPDATE G_DISCONT_CARD D'
      
        '110215977=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_,' +
        ' 0) + :SUMM_BONUS_GOT_,'
      '110215978=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110215979=          WHERE D.G_CLIENT = :G_CLIENT_'
      '110215980=          RETURNING'
      '110215981=            D.SUMM_ALL'
      '110215982=          INTO'
      '110215983=            :CLIENT_SUMM_ALL_;'
      '110215984='
      '110215985=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '110215986=            FROM G_CLIENT_DISC_VAL_GRID G'
      '110215987=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '110215988=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '110215989=          ORDER BY G.SUMM_FROM'
      '110215990=          ROWS 1 TO 1'
      '110215991=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '110215992='
      '110215993=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '110215994=            UPDATE G_CLIENT G'
      '110215995=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '110215996=             WHERE G.G_CLIENT = :G_CLIENT_'
      '110215997=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '110215998='
      '110215999=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1102151000=            UPDATE G_DISCONT_CARD D'
      '1102151001=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1102151002=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1102151003=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1102151004=      END'
      '1102151005='
      
        '1102151006=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' ' +
        #1057' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', ' +
        #1050#1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '1102151007=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057 +
        #1051#1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102151008=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102151009=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102151010=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102151011=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1102151012=      PNT_ = '#39'07'#39';'
      
        '1102151013=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THE' +
        'N BEGIN'
      '1102151014=        SELECT S.S_VALUE'
      '1102151015=          FROM SYSTEM_SETUP S'
      '1102151016=         WHERE S.SYSTEM_SETUP = 4'
      '1102151017=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102151018='
      '1102151019=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102151020=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102151021=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102151022='
      
        '1102151023=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1102151024=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1102151025=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1102151026='
      '1102151027=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102151028=        ELSE'
      
        '1102151029=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1102151030='
      '1102151031=        KASSA_ZP_ID_ = NULL;'
      '1102151032=        SELECT K.KASSA, K.SUMM'
      '1102151033=        FROM KASSA K'
      '1102151034=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1102151035=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102151036=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102151037=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102151038=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1102151039='
      
        '1102151040=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1102151041='
      '1102151042=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102151043=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102151044=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102151045=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1102151046=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1102151047=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1102151048=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1102151049=                                          NULL,     -' +
        '-:SKLAD_,'
      '1102151050=                                          1,'
      '1102151051=                                          :G_TOCHKA_,'
      
        '1102151052=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102151053=                                          :G_OFFICIAL' +
        '_'
      
        '1102151054=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1102151055=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102151056=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1102151057='
      '1102151058=        END ELSE BEGIN'
      
        '1102151059=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1102151060=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1102151061=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1102151062=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1102151063='
      
        '1102151064=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1102151065=                                          1,     -- A' +
        'CTION_'
      
        '1102151066=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102151067=                                          :SALES_COMM' +
        '_SUMM_ALL_,   --SUMM_'
      
        '1102151068=                                          :ACTION_DAT' +
        'E_ZP_,  -- ACTION_DATE_'
      
        '1102151069=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      
        '1102151070=                                          NULL,      ' +
        '        -- ZAKAZ_'
      
        '1102151071=                                          NULL,      ' +
        '        -- SKLAD_'
      
        '1102151072=                                          1,         ' +
        '        --:PAYMENT_TYPE_,'
      
        '1102151073=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102151074=                                          :G_OFFICIAL' +
        '_'
      
        '1102151075=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102151076='
      '1102151077=        END'
      '1102151078=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102151079=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102151080=          EXIT;'
      '1102151081=        END'
      '1102151082=      END */'
      '1102151083='
      
        '1102151084=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOA' +
        'D_TO_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040 +
        #1058#1053#1054' '#1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102151085=      IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_SPISANIE_ = ' +
        '0) THEN'
      
        '1102151086=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER, IS_LOADED_MOB)'
      
        '1102151087=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1, (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END));  ' +
        ' -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' CASE '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' '#1054#1041#1053#1054#1042#1051#1045#1053 +
        #1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '1102151088=  END'
      '1102151089=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1102151090=  ----------------------------------------'
      '1102151091=  ----------------------------------------'
      '1102151092=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102151093=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1102151094=      PNT_ = '#39'25'#39';'
      
        '1102151095=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1102151096=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1102151097=      RETURNING ZAKAZ_REAL_PARENT'
      '1102151098=      INTO :ZAKAZ_REAL_PARENT_;'
      '1102151099='
      
        '1102151100=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1102151101=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102151102=          INTO :G_PRODUCT,'
      '1102151103=              :AMOUNT,'
      '1102151104=              :PRICE,'
      '1102151105=              :SUMM,'
      '1102151106=              :DISCOUNT_PERC,'
      '1102151107=              :DISCOUNT_TENGE,'
      '1102151108=              :DISCOUNT_SUMM,'
      '1102151109=              :NDS,'
      '1102151110=              :NDS_SUMM'
      '1102151111=      DO BEGIN'
      '1102151112=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102151113=          UPDATE LT_SKLAD_PRODUCT L'
      '1102151114=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1102151115=                 L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_AP' +
        'P_'
      '1102151116=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102151117=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102151118='
      
        '1102151119=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1102151120=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1102151121=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1102151122=            Err_Code = -20500;'
      
        '1102151123=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102151124=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1102151125=            EXIT;'
      '1102151126=          END ELSE if (ROW_COUNT = 0) then'
      
        '1102151127=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102151128=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102151129='
      
        '1102151130=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1102151131=                                     G_PRODUCT,'
      '1102151132=                                     PRICE,'
      
        '1102151133=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1102151134=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1102151135=                                     NDS_SUMM)'
      
        '1102151136=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_REAL_PARENT_,'
      '1102151137=                  :G_PRODUCT,'
      
        '1102151138=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1102151139=                  :AMOUNT, :SUMM,'
      '1102151140=                  0, --AMOUNT_PAYED,'
      '1102151141=                  0, --SUMM_PAYED,'
      '1102151142=                  0, --IS_PAYED_ALL,'
      '1102151143=                  :DISCOUNT_PERC,'
      '1102151144=                  :DISCOUNT_TENGE,'
      '1102151145=                  :DISCOUNT_SUMM,'
      '1102151146=                  :NDS,'
      '1102151147=                  :NDS_SUMM)'
      '1102151148=          RETURNING ZAKAZ_NA_REAL'
      '1102151149=          INTO :ZAKAZ_;'
      '1102151150=      END'
      '1102151151=  END'
      '1102151152=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102151153=  ----------------------------------------'
      '1102151154=  ----------------------------------------'
      '1102151155=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1102151156=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1102151157=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102151158=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1102151159=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1102151160=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1102151161=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1102151162=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1102151163=      RETURNING SKLAD'
      '1102151164=      INTO :ZAKAZ_;'
      '1102151165='
      '1102151166=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1102151167=            FROM ZAKAZ_DETAILS_TMP Z'
      '1102151168=          INTO :G_PRODUCT,'
      '1102151169=              :AMOUNT,'
      '1102151170=              :PRICE,'
      '1102151171=              :SUMM'
      '1102151172=      DO BEGIN'
      '1102151173=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1102151174=        UPDATE LT_SKLAD_PRODUCT L'
      '1102151175=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1102151176=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1102151177=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102151178=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102151179='
      '1102151180=        IF (ROW_COUNT = 0) THEN'
      
        '1102151181=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PROD' +
        'UCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102151182=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :G' +
        '_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1102151183='
      '1102151184=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1102151185=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1102151186=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1102151187=        SELECT MAX(SK.DATE_RECEIPT)'
      '1102151188=            FROM SKLAD SK'
      '1102151189=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102151190=             AND SK.IS_LAST = 1'
      '1102151191=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1102151192=            INTO :DATE_LAST_;'
      '1102151193='
      
        '1102151194=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102151195=            UPDATE SKLAD SK'
      '1102151196=               SET SK.IS_LAST = 0'
      '1102151197=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1102151198=               AND SK.IS_LAST = 1'
      '1102151199=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102151200='
      '1102151201=            IS_THIS_LAST_ = 1;'
      '1102151202=        END */'
      '1102151203='
      '1102151204='
      '1102151205=        INSERT INTO SKLAD'
      '1102151206=        ('
      '1102151207=         SKLAD,'
      '1102151208=         SKLAD_PARENT,'
      '1102151209=         DATE_RECEIPT,'
      '1102151210=         G_CLIENT,'
      '1102151211=         G_PRODUCT,'
      '1102151212=         AMOUNT,'
      '1102151213=         PRICE,'
      '1102151214=         SUMM,'
      '1102151215=         G_PAYMENT_TYPE,'
      '1102151216=         OSNOVANIE,'
      '1102151217=         NOTE,'
      '1102151218=         NDS,'
      '1102151219=         NDS_SUMM,'
      '1102151220=         IS_LAST,'
      '1102151221=         IS_VOZVRAT,'
      '1102151222=         G_TOCHKA'
      '1102151223=        ) VALUES ('
      '1102151224=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102151225=         :ZAKAZ_,'
      '1102151226=         :Z_DATE_,'
      '1102151227=         :G_TOCHKA_,'
      '1102151228=         :G_PRODUCT,'
      '1102151229=         :AMOUNT,'
      '1102151230=         :PRICE,'
      '1102151231=         :SUMM,'
      '1102151232=         :G_PAYMENT_TYPE_,'
      '1102151233=         :OSNOVANIE_,'
      '1102151234=         :NOTE_,'
      '1102151235=         0,  --:RNDS_,'
      '1102151236=         0,  --:RNDS_SUMM_,'
      
        '1102151237=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1102151238=         3,  --:IS_VOZVRAT_,'
      '1102151239=         :G_CLIENT_'
      '1102151240=        );'
      '1102151241='
      
        '1102151242=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1102151243=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1102151244=        PNT_ = '#39'02'#39';'
      '1102151245=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102151246=            UPDATE LT_SKLAD_PRODUCT L'
      '1102151247=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1102151248=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102151249=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1102151250=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1102151251='
      '1102151252=            IF (ROW_COUNT = 0) THEN'
      
        '1102151253=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102151254=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102151255=        END'
      '1102151256=      END'
      '1102151257=  END'
      '1102151258='
      '1102151259=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102151260='
      
        '1102151261=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1102151262=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102151263=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1102151264=                                  G_PRIHOD_,'
      '1102151265=                                  :SUMM_PRIHOD_,'
      '1102151266=                                  :Z_DATE_,'
      
        '1102151267=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1102151268=                                  :ZAKAZ_,'
      '1102151269=                                  NULL,'
      '1102151270=                                  :G_PAYMENT_TYPE_,'
      '1102151271=                                  :G_TOCHKA_,'
      '1102151272=                                  :UPLOAD_TO_EXT_APP_'
      
        '1102151273=                                  ) RETURNING_VALUES ' +
        '(:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102151274=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102151275=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102151276=      EXIT;'
      '1102151277=    END'
      '1102151278=  END'
      '1102151279='
      
        '1102151280=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1102151281=  IF (IS_MEBEL_ = 1) THEN'
      
        '1102151282=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1102151283=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1102151284='
      '1102151285=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102151286=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1102151287='
      '1102151288=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102151289=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102151290=end'
      '1102151291=;'
      '1102151292='
      '1102151293=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '1102151294=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT,'
      '1102151295=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1102151296=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1102151297=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '1102151298=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1102151299=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1102151300=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1102151301=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1102151302=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1102151303=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ','
      '1102151304=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1102151305=  IS_SPISANIE_ INTEGER,'
      '1102151306=  NEW_LINE_SALE_ INTEGER = 0,'
      '1102151307=  MODE_ INTEGER = 0,'
      '1102151308=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1,'
      '1102151309=  DO_PRODUCT_IN_SALE_ INTEGER = 0,'
      '1102151310=  MARK_CODE_ VARCHAR(100) = '#39#39','
      
        '1102151311=  VES_GRAMM_PRICE_ TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        '_PRICE = 0)'
      '1102151312=RETURNS ('
      
        '1102151313=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1102151314=  ERR_CODE INTEGER,'
      '1102151315=  ERR_MSG VARCHAR(1024))'
      '1102151316=AS'
      '1102151317=/*'
      
        '1102151318=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063 +
        #1048#1058#1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '1102151319=*/'
      
        '1102151320=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DE' +
        'TAILS_TMP'#39';'
      '1102151321=DECLARE VARIABLE PNT_ VARCHAR(2);'
      
        '1102151322=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0;'
      
        '1102151323=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0;'
      
        '1102151324=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1102151325=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1102151326=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '1102151327=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      
        '1102151328=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.PRICE;'
      
        '1102151329=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.COST_PRICE;'
      
        '1102151330=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '1102151331=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_' +
        'KIT;'
      
        '1102151332=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040 +
        #1041#1051#1048#1062#1045' */'
      
        '1102151333=DECLARE VARIABLE SOSTAV_COUNT_ INTEGER; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054 +
        #1042#1040#1056#1054#1042' '#1042#1061#1054#1044#1048#1058' '#1042' '#1057#1054#1057#1058#1040#1042' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040', '#1045#1057#1051#1048' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053', '#1058#1054' '#1056#1040#1057#1063#1045#1058 +
        ' '#1062#1045#1053#1067' '#1058#1040#1052' '#1041#1059#1044#1045#1058' '#1044#1056#1059#1043#1054#1049' */'
      
        '1102151334=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102151335=DECLARE VARIABLE ORIGINAL_KIT_ID_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.ORIGINAL_KIT_ID = 0;'
      
        '1102151336=DECLARE VARIABLE ORIGINAL_KIT_PRICE_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS_TMP.ORIGINAL_KIT_PRICE = 0;'
      
        '1102151337=DECLARE VARIABLE G_PRODUCT_IN_ORIGINAL_ TYPE OF COLUM' +
        'N G_PRODUCT.G_PRODUCT;'
      '1102151338=BEGIN'
      '1102151339=  G_PRODUCT_IN_ORIGINAL_ = G_PRODUCT_;'
      '1102151340='
      
        '1102151341=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071 +
        #1070#1058' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '1102151342=  SELECT T.ZAKAZ, T.Z_TYPE'
      '1102151343=    FROM ZAKAZ_DETAILS_TMP T'
      '1102151344=   WHERE T.ZAKAZ IS NOT NULL'
      
        '1102151345=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' ' +
        #1089#1090#1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082 +
        #1072' MULTIPLE ROWS IN SINGLETON SELECT'
      '1102151346=    INTO :ZAKAZ_, :Z_TYPE_;'
      '1102151347='
      
        '1102151348=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045 +
        #1051#1045#1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1102151349=           ,G.IS_KIT'
      '1102151350=           ,K.AMOUNT * :AMOUNT_'
      '1102151351=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '1102151352=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PR' +
        'ICE)'
      '1102151353=           ,(CASE'
      
        '1102151354=             WHEN (:IS_SPISANIE_ = 0) OR (:IS_SPISANI' +
        'E_ in (1,3) AND :USE_SELF_PRICE_ONTRANSFER_ = 0)  THEN (SELECT *' +
        ' FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))'
      '1102151355=             ELSE K.PRICE'
      '1102151356=           END) COST_PRICE'
      
        '1102151357=           --DECODE(, 1, K.PRICE, (SELECT * FROM GET_' +
        'LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, 1))) COST_PRICE'
      
        '1102151358=           ,(SELECT COUNT(*) FROM G_PRODUCT_KIT WHERE' +
        ' G_PRODUCT = :G_PRODUCT_) CNT'
      
        '1102151359=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT ' +
        'K ON G.G_PRODUCT = K.G_PRODUCT'
      '1102151360=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1102151361=       AND G.IS_KIT = 1'
      '1102151362=    UNION'
      
        '1102151363=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056 +
        #1054#1044#1040#1046
      '1102151364=           ,G.IS_KIT'
      '1102151365=           ,:AMOUNT_'
      '1102151366=           ,:PRICE_'
      '1102151367=           ,0'
      '1102151368=           ,:COST_PRICE_'
      '1102151369=           ,0'
      '1102151370=      FROM G_PRODUCT G'
      '1102151371=     WHERE G_PRODUCT = :G_PRODUCT_'
      '1102151372=       AND G.IS_KIT <> 1'
      '1102151373=      INTO :G_PRODUCT_'
      '1102151374=           ,:IS_KIT_'
      '1102151375=           ,:AMOUNT_'
      '1102151376=           ,:PRICE__'
      '1102151377=           ,:SOSTAV_PRICE_'
      '1102151378=           ,:COST_PRICE__'
      '1102151379=           ,:SOSTAV_COUNT_'
      '1102151380=  DO BEGIN'
      '1102151381=      ZAKAZ_DTLS_TMP_ = NULL;'
      '1102151382='
      
        '1102151383=      --=============================================' +
        '=============='
      '1102151384=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1102151385=      SELECT AMOUNT - AMOUNT_RESERVE'
      '1102151386=        FROM LT_SKLAD_PRODUCT L'
      '1102151387=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '1102151388=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1102151389=       INTO :AMOUNT_CUR_;'
      '1102151390='
      
        '1102151391=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1102151392=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1102151393=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1102151394=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
        '1102151395=      -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042#1040#1058 +
        #1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '1102151396=      IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '1102151397=        IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '1102151398=          SELECT SUM(AMOUNT)'
      '1102151399=            FROM ZAKAZ_DETAILS T'
      '1102151400=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102151401=             AND T.ZAKAZ = :ZAKAZ_'
      '1102151402=            INTO :AMOUNT_OLD_;'
      '1102151403=        ELSE'
      '1102151404=          SELECT SUM(AMOUNT)'
      '1102151405=            FROM SKLAD T'
      '1102151406=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102151407=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '1102151408=            INTO :AMOUNT_OLD_;'
      '1102151409=      END'
      '1102151410='
      '1102151411=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '1102151412=      SELECT SUM(AMOUNT)'
      '1102151413=        FROM ZAKAZ_DETAILS_TMP T'
      '1102151414=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1102151415=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '1102151416='
      
        '1102151417=      AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ_,' +
        ' 0) + :AMOUNT_;'
      '1102151418=      AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '1102151419='
      
        '1102151420=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042 +
        ' '#1048#1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1102151421='
      
        '1102151422=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALES' +
        'CE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      
        '1102151423=        -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1043#1054#1058#1054#1042#1067#1049' '#1055#1056#1054#1044#1059#1050#1058' '#1048' '#1056#1040#1047#1056#1045#1064#1045#1053#1054' '#1055#1056#1054#1048#1047 +
        #1042#1054#1044#1048#1058#1068' '#1058#1054#1042#1040#1056', '#1058#1054' '#1055#1056#1054#1048#1047#1042#1054#1046#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      
        '1102151424=        IF (IS_KIT_ = 2 AND DO_PRODUCT_IN_SALE_ = 1) ' +
        'THEN BEGIN'
      '1102151425=            PNT_ = '#39'01'#39';'
      
        '1102151426=            EXECUTE PROCEDURE DO_PRODUCT((SELECT ID F' +
        'ROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1102151427=                                         CURRENT_DATE' +
        ','
      '1102151428=                                         :G_PRODUCT_,'
      
        '1102151429=                                         ABS(AMOUNT_C' +
        'UR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESCE(:AMOUNT_OLD_, 0))), --:AMOU' +
        'NT_,'
      
        '1102151430=                                         '#39#1055#1088#1086#1080#1079#1074#1086#1076#1089#1090#1074 +
        #1086' '#1087#1088#1080' '#1087#1088#1086#1076#1072#1078#1077#39' --:NOTE_,'
      '1102151431=                                         )'
      
        '1102151432=                RETURNING_VALUES :SKLAD_, :COST_PRICE' +
        '__, :ERR_CODE, :ERR_MSG;'
      '1102151433=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102151434=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102151435=              EXIT;'
      '1102151436=            END'
      '1102151437=        END'
      
        '1102151438=        ELSE IF (ALLOW_SELL_ABSENT_GOODS_ = 0 AND G_P' +
        'RODUCT_ <> -2) THEN BEGIN'
      '1102151439=            SELECT NAME'
      '1102151440=            FROM G_PRODUCT'
      '1102151441=            WHERE G_PRODUCT = :G_PRODUCT_'
      '1102151442=            INTO :PRODUCT_NAME_;'
      '1102151443='
      '1102151444=            ERR_CODE = -20500;'
      
        '1102151445=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_' +
        'NAME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '1102151446=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090 +
        #1082#1086#1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '1102151447=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1102151448=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1102151449=            EXIT;'
      '1102151450=        END'
      '1102151451=      END'
      '1102151452=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1054#1057#1058#1040#1058#1050#1048' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '1102151453=      --=============================================' +
        '=============='
      '1102151454='
      
        '1102151455=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077 +
        #1090#1089#1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087 +
        #1083#1077#1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '1102151456=      IF (IS_KIT_ = 1) THEN BEGIN'
      '1102151457='
      '1102151458=        --IF (SOSTAV_COUNT_ = 1) THEN BEGIN'
      '1102151459=        --    PRICE__ = SOSTAV_PRICE_;'
      '1102151460=        --END ELSE BEGIN'
      '1102151461=            IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '1102151462=              PRICE__ = COST_PRICE__;'
      '1102151463='
      
        '1102151464=            END ELSE IF (Discount_perc_ <> 0) THEN BE' +
        'GIN      -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '1102151465=              DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PE' +
        'RC_/100;'
      '1102151466='
      '1102151467='
      
        '1102151468=            END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THE' +
        'N BEGIN   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '1102151469=              DISCOUNT_PERC_ = 100 - PRICE_ * 100 / S' +
        'OSTAV_PRICE_;'
      
        '1102151470=              DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE' +
        '_;'
      '1102151471=            END'
      '1102151472='
      
        '1102151473=            DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUN' +
        'T_;'
      
        '1102151474=            SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMO' +
        'UNT_;'
      '1102151475=            NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '1102151476=        --END'
      '1102151477=      END'
      '1102151478='
      
        '1102151479=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' ' +
        #1045#1057#1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      
        '1102151480=      -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053' - '#1058#1054' '#1050#1040#1046#1044#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1056#1054#1041 +
        #1048#1042#1040#1070' '#1054#1058#1044#1045#1051#1068#1053#1054
      
        '1102151481=      IF (NEW_LINE_SALE_ = 0 AND CHAR_LENGTH(MARK_COD' +
        'E_) = 0) THEN'
      '1102151482=          SELECT ZD.zakaz_details'
      '1102151483=            FROM zakaz_details_tmp ZD'
      '1102151484=           WHERE ZD.G_PRODUCT = :g_product_'
      '1102151485=             AND ZD.PRICE = :PRICE__'
      '1102151486=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '1102151487=            INTO :ZAKAZ_DTLS_TMP_;'
      '1102151488='
      '1102151489='
      '1102151490=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN BEGIN'
      '1102151491=        UPDATE ZAKAZ_DETAILS_TMP P'
      '1102151492=           SET P.amount = P.amount + :amount_'
      
        '1102151493=               ,P.summ = ROUND((P.price - P.discount_' +
        'TENGE) * (P.amount + :AMOUNT_), 2)  -- '#1086#1082#1088#1091#1075#1083#1103#1102' '#1076#1086' 2 '#1079#1085#1072#1082#1086#1074', '#1095#1090#1086 +
        #1073#1099' '#1087#1086#1090#1086#1084' '#1085#1077' '#1073#1099#1083#1086' '#1087#1088#1086#1073#1083#1077#1084' '#1087#1088#1080' '#1087#1077#1088#1077#1076#1072#1095#1077' '#1074' '#1060#1056
      
        '1102151494=               ,P.discount_summ = P.discount_TENGE * ' +
        '(P.amount + :AMOUNT_)'
      '1102151495=               ,P.NDS = :NDS_'
      '1102151496=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '1102151497=               ,P.VES_GRAMM_PRICE = :VES_GRAMM_PRICE_'
      '1102151498=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '1102151499=        ZAKAZ_DETAILS_ = :ZAKAZ_DTLS_TMP_;'
      '1102151500='
      '1102151501=      END ELSE BEGIN'
      
        '1102151502=          IF (IS_KIT_ = 1 AND SOSTAV_COUNT_ = 1) THEN' +
        ' BEGIN'
      
        '1102151503=            ORIGINAL_KIT_ID_ = G_PRODUCT_IN_ORIGINAL_' +
        ';'
      '1102151504=            ORIGINAL_KIT_PRICE_ = SOSTAV_PRICE_;'
      '1102151505=          END'
      '1102151506='
      '1102151507=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '1102151508=          ('
      '1102151509=           ZAKAZ_DETAILS,'
      '1102151510=           ZAKAZ,'
      '1102151511=           G_PRODUCT,'
      '1102151512=           AMOUNT,'
      '1102151513=           PRICE,'
      '1102151514=           SUMM,'
      '1102151515=           DISCOUNT_PERC,'
      '1102151516=           DISCOUNT_TENGE,'
      '1102151517=           DISCOUNT_SUMM,'
      '1102151518=           NDS,'
      '1102151519=           NDS_SUMM,'
      '1102151520=           COST_PRICE,'
      '1102151521=           MARK_CODE,'
      '1102151522=           ORIGINAL_KIT_ID,'
      '1102151523=           ORIGINAL_KIT_PRICE,'
      '1102151524=           VES_GRAMM_PRICE'
      '1102151525=          ) VALUES ('
      '1102151526=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '1102151527=           :ZAKAZ_,'
      '1102151528=           :G_PRODUCT_,'
      '1102151529=           :AMOUNT_,'
      '1102151530=           :PRICE__,'
      '1102151531=           :SUMM_,'
      '1102151532=           :DISCOUNT_PERC_,'
      '1102151533=           :DISCOUNT_TENGE_,'
      '1102151534=           :DISCOUNT_SUMM_,'
      '1102151535=           :NDS_,'
      '1102151536=           :NDS_SUMM_,'
      '1102151537=           :COST_PRICE__,'
      '1102151538=           :MARK_CODE_,'
      '1102151539=           :ORIGINAL_KIT_ID_,'
      '1102151540=           :ORIGINAL_KIT_PRICE_,'
      '1102151541=           :VES_GRAMM_PRICE_'
      '1102151542=          )'
      '1102151543=          RETURNING'
      '1102151544=            ZAKAZ_DETAILS'
      '1102151545=          INTO'
      '1102151546=            :ZAKAZ_DETAILS_;'
      '1102151547=      END'
      '1102151548=  END'
      '1102151549=end'
      '1102151550=;'
      '1102151551='
      '1102151552=ALTER PROCEDURE P_REP_OSTATOK_TOVAROV('
      '1102151553=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102151554=  INCLUDE_NOL_ INTEGER,'
      '1102151555=  INCLUDE_FEW_ INTEGER,'
      '1102151556=  SORT_BY_NAME_ INTEGER,'
      '1102151557=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102151558=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39','
      '1102151559=  IS_EXPORT_ INTEGER = 0)'
      '1102151560=RETURNS ('
      '1102151561=  PERIOD_ VARCHAR(40),'
      '1102151562=  ROW_NUM VARCHAR(15),'
      '1102151563=  ARTICUL VARCHAR(1000),'
      '1102151564=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102151565=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102151566=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102151567=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102151568=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102151569=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102151570=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1102151571=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      
        '1102151572=  AMOUNT_VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        ','
      '1102151573=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1102151574=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1102151575=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1102151576=  TOVAR_NAME VARCHAR(250),'
      '1102151577=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102151578=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102151579=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102151580=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102151581=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      
        '1102151582=  CATEGORY_NAME TYPE OF COLUMN P_REP_PRICE_LIST_TABLE' +
        '.CATEGORY_NAME,'
      '1102151583=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1102151584=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1102151585=  KOD_TNVD TYPE OF COLUMN G_PRODUCT.KOD_TNVD,'
      '1102151586=  ERR_CODE INTEGER,'
      '1102151587=  ERR_MSG VARCHAR(1024))'
      '1102151588=AS'
      
        '1102151589=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_OSTATO' +
        'K_TOVAROV'#39';'
      '1102151590=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102151591=DECLARE VARIABLE I INTEGER = 1;'
      '1102151592=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102151593=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102151594=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1102151595=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1102151596=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102151597=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1102151598=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1102151599=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1102151600=BEGIN'
      '1102151601='
      
        '1102151602=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1102151603=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102151604='
      '1102151605=  SELECT S.S_VALUE,'
      '1102151606=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1102151607=    FROM SYSTEM_SETUP S'
      '1102151608=   WHERE S.SYSTEM_SETUP = 1'
      '1102151609=    INTO :FORMULA_,'
      '1102151610=         :PRIHOD_CNT_;'
      '1102151611='
      '1102151612=  IF (IS_EXPORT_ = 1) THEN'
      
        '1102151613=    SELECT '#39'-'#39'||LIST(G_TOCHKA, '#39'-'#39')||'#39'-'#39' FROM G_TOCHK' +
        'A INTO :G_TOCHKA_ARR_;'
      '1102151614='
      '1102151615=  FOR SELECT GP.PATH,'
      '1102151616=             GP.G_PRODUCT'
      '1102151617=        FROM P_REP_TREE GP'
      '1102151618=       WHERE EXISTS (SELECT 1'
      '1102151619=                       FROM G_PRODUCT'
      '1102151620=                      WHERE IS_CATEGORY = 0'
      
        '1102151621=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1102151622=                    )'
      
        '1102151623=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102151624=              OR'
      '1102151625=              (:G_CATEGORY_ is NULL)'
      '1102151626=             )'
      '1102151627=       ORDER BY 1, 2'
      '1102151628=       INTO :PATH_NAME_,'
      '1102151629=            :G_PRODUCT_'
      '1102151630=  DO BEGIN'
      
        '1102151631=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1102151632=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1102151633=      SELECT COUNT(G.G_PRODUCT)'
      
        '1102151634=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102151635=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1102151636=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102151637=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102151638=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102151639=              OR'
      
        '1102151640=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1102151641=              or'
      
        '1102151642=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1102151643=             )'
      '1102151644=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102151645=         AND ((EXISTS (SELECT 1'
      '1102151646=                       FROM SKLAD S'
      '1102151647=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1102151648=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1102151649=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102151650=              OR'
      '1102151651=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1102151652=        INTO :CNT_;'
      '1102151653='
      '1102151654=      IF (CNT_ > 0) THEN BEGIN'
      '1102151655=          IF (IS_EXPORT_ = 0) THEN'
      
        '1102151656=            INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP' +
        '_PRICE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1102151657=            VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE' +
        ', 1), :PATH_NAME_, 1);'
      '1102151658='
      
        '1102151659=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1102151660=                                              ARTICUL' +
        ','
      
        '1102151661=                                              BARCODE' +
        ','
      
        '1102151662=                                              NOMENCL' +
        'ATUR_NUM,'
      '1102151663=                                              NAME,'
      
        '1102151664=                                              UNIT_NA' +
        'ME,'
      '1102151665=                                              PRICE,'
      
        '1102151666=                                              VOLUME_' +
        'PRICE,'
      '1102151667=                                              AMOUNT,'
      
        '1102151668=                                              AMOUNT_' +
        'RESERVE,'
      '1102151669=                                              SUMM,'
      
        '1102151670=                                              PRICE_S' +
        'ELF,'
      
        '1102151671=                                              SORT_CO' +
        'L,'
      
        '1102151672=                                              IS_CATE' +
        'GORY,'
      '1102151673=                                              NOTE,'
      
        '1102151674=                                              CROSSCO' +
        'DE_BLOB_TXT,'
      '1102151675=                                              PLACE,'
      '1102151676=                                              BRAND,'
      
        '1102151677=                                              CATEGOR' +
        'Y_NAME,'
      
        '1102151678=                                              PACK_AM' +
        'OUNT,'
      
        '1102151679=                                              MF_COUN' +
        'TRY,'
      
        '1102151680=                                              KOD_TNV' +
        'D,'
      
        '1102151681=                                              AMOUNT_' +
        'VES_GRAMM)'
      
        '1102151682=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1102151683=                 G.ARTICUL,'
      '1102151684=                 G.BARCODE,'
      '1102151685=                 G.NOMENCLATUR_NUM,'
      '1102151686=                 G.NAME,'
      '1102151687=                 U.SHORT_NAME,'
      '1102151688=                 G.PRICE,'
      '1102151689=                 G.VOLUME_PRICE,'
      '1102151690=                 COALESCE(S.AMOUNT, 0),'
      '1102151691=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1102151692=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1102151693=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1102151694=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1102151695=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1102151696=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      
        '1102151697=                  -- 2 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1051#1053#1048#1061' 2' +
        '00 '#1047#1040#1050#1059#1055#1054#1050
      '1102151698=                  DECODE(:FORMULA_,'
      '1102151699=                         1,'
      '1102151700=                         (SELECT S.price'
      '1102151701=                            FROM SKLAD S'
      
        '1102151702=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102151703=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1102151704=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1102151705=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1102151706=                                                     ' +
        'FROM SKLAD DD'
      
        '1102151707=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1102151708=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1102151709=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1102151710=                                                    )'
      '1102151711=                            ORDER BY 1 DESC'
      '1102151712=                            ROWS 1 TO 1'
      '1102151713=                         ),'
      
        '1102151714=                         (SELECT ROUND(SUM(T.AMOUNT *' +
        ' T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '1102151715=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1102151716=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1102151717=                                         SKLAD S'
      
        '1102151718=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1102151719=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1102151720=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1102151721=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1102151722=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1102151723=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO :PRIHOD_CNT_) T)'
      '1102151724=                         )), 0) spr,'
      
        '1102151725=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1102151726=                 0'
      '1102151727=                 ,G.NOTE'
      
        '1102151728=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      '1102151729=                 ,G.PLACE'
      '1102151730=                 ,G.BRAND'
      '1102151731=                 ,REPLACE(:PATH_NAME_, '#39' - '#39', '#39'~'#39')'
      '1102151732=                 ,G.PACK_AMOUNT'
      '1102151733=                 ,G.MF_COUNTRY'
      '1102151734=                 ,G.KOD_TNVD'
      '1102151735=                 ,COALESCE(S.AMOUNT, 0) * G.VES_GRAMM'
      
        '1102151736=            FROM G_PRODUCT G LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1102151737=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102151738=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1102151739=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102151740=             AND G.IS_CATEGORY = 0'
      '1102151741=             AND G.is_active = 1'
      '1102151742=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102151743=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102151744=                  OR'
      
        '1102151745=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1102151746=                  or'
      
        '1102151747=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1102151748=                 )'
      '1102151749=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102151750=             AND ((EXISTS (SELECT 1'
      '1102151751=                           FROM SKLAD S'
      
        '1102151752=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1102151753=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1102151754=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102151755=                  OR'
      '1102151756=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1102151757=           ORDER BY 13, G.NAME, G.G_PRODUCT;'
      '1102151758=      END'
      '1102151759=  END'
      '1102151760='
      
        '1102151761=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1102151762='
      
        '1102151763=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE_BLOB_TXT, PLACE, NAME, BRAND, NOTE, UNIT_NAME, PRICE, V' +
        'OLUME_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PR' +
        'ICE_SELF, IS_CATEGORY,'
      
        '1102151764=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL), C' +
        'ATEGORY_NAME, PACK_AMOUNT, MF_COUNTRY, KOD_TNVD, AMOUNT_VES_GRAM' +
        'M'
      '1102151765=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1102151766=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME, :PRIC' +
        'E, :VOLUME_PRICE,'
      
        '1102151767=        :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF,' +
        ' :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME, :CATEGORY_NAME, :PACK_AM' +
        'OUNT, :MF_COUNTRY, :KOD_TNVD, :AMOUNT_VES_GRAMM'
      '1102151768=  DO BEGIN'
      '1102151769=    I = I + 1;'
      '1102151770=    SUSPEND;'
      '1102151771=  END'
      '1102151772=WHEN ANY DO BEGIN'
      '1102151773=    Err_code = -20500;'
      
        '1102151774=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102151775=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102151776=  END'
      '1102151777=end'
      '1102151778=;'
      '1102151779='
      '1102151780=ALTER PROCEDURE P_REP_PRICE_LIST('
      '1102151781=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1102151782=  INCLUDE_NOL_ INTEGER,'
      '1102151783=  INCLUDE_FEW_ INTEGER,'
      '1102151784=  SORT_BY_NAME_ INTEGER,'
      '1102151785=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1102151786=  SCALE_PREFIX_ VARCHAR(2) = '#39#39','
      '1102151787=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1102151788=RETURNS ('
      '1102151789=  PERIOD_ VARCHAR(40),'
      '1102151790=  ROW_NUM VARCHAR(15),'
      '1102151791=  ARTICUL VARCHAR(1000),'
      '1102151792=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1102151793=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1102151794=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1102151795=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1102151796=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102151797=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102151798=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102151799=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1102151800=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT_RESERVE,'
      
        '1102151801=  AMOUNT_VES_GRAMM TYPE OF COLUMN G_PRODUCT.VES_GRAMM' +
        ','
      '1102151802=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1102151803=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '1102151804=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '1102151805=  TOVAR_NAME VARCHAR(250),'
      '1102151806=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1102151807=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1102151808=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '1102151809=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1102151810=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '1102151811=  ERR_CODE INTEGER,'
      '1102151812=  ERR_MSG VARCHAR(1024))'
      '1102151813=AS'
      '1102151814=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '1102151815=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_' +
        'LIST'#39';'
      '1102151816=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102151817=DECLARE VARIABLE I INTEGER = 1;'
      '1102151818=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102151819=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102151820=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME;' +
        ' /* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '1102151821=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '1102151822=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1102151823=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP' +
        '.S_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055 +
        #1050#1048', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '1102151824=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048 +
        #1044#1045#1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '1102151825=DECLARE VARIABLE PRIHOD_CNT_ INTEGER;'
      '1102151826=BEGIN'
      '1102151827='
      
        '1102151828=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRIC' +
        'E_LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '1102151829=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1102151830='
      '1102151831=  SELECT S.S_VALUE,'
      '1102151832=         DECODE(S.S_VALUE, 0, 5, 1, 0, 2, 200)'
      '1102151833=    FROM SYSTEM_SETUP S'
      '1102151834=   WHERE S.SYSTEM_SETUP = 1'
      '1102151835=    INTO :FORMULA_,'
      '1102151836=         :PRIHOD_CNT_;'
      '1102151837='
      '1102151838=  FOR SELECT GP.PATH,'
      '1102151839=             GP.G_PRODUCT'
      '1102151840=        FROM P_REP_TREE GP'
      '1102151841=       WHERE EXISTS (SELECT 1'
      '1102151842=                       FROM G_PRODUCT'
      '1102151843=                      WHERE IS_CATEGORY = 0'
      
        '1102151844=                        AND G_PRODUCT_PAR = GP.G_PROD' +
        'UCT'
      '1102151845=                    )'
      
        '1102151846=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PROD' +
        'UCT||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1102151847=              OR'
      '1102151848=              (:G_CATEGORY_ is NULL)'
      '1102151849=             )'
      '1102151850=       ORDER BY 1, 2'
      '1102151851=       INTO :PATH_NAME_,'
      '1102151852=            :G_PRODUCT_'
      '1102151853=  DO BEGIN'
      
        '1102151854=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067 +
        ' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048 +
        #1063#1045#1057#1058#1042#1054
      
        '1102151855=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040 +
        #1058#1068' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '1102151856=      SELECT COUNT(G.G_PRODUCT)'
      
        '1102151857=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(' +
        'LL.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102151858=                                          WHERE :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT' +
        ') L ON G.G_PRODUCT = L.G_PRODUCT'
      '1102151859=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102151860=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102151861=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (' +
        'COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102151862=              OR'
      
        '1102151863=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NO' +
        'L_, 0) = 1)'
      '1102151864=              or'
      
        '1102151865=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FE' +
        'W_, 0) = 1))'
      '1102151866=             )'
      '1102151867=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102151868=         AND ((EXISTS (SELECT 1'
      '1102151869=                       FROM SKLAD S'
      '1102151870=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '1102151871=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '1102151872=                        AND :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102151873=              OR'
      '1102151874=              COALESCE(:G_CLIENT_, 0) = 0)'
      '1102151875=        INTO :CNT_;'
      '1102151876='
      '1102151877=      IF (CNT_ > 0) THEN BEGIN'
      
        '1102151878=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '1102151879=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ', :PATH_NAME_, 1);'
      '1102151880='
      
        '1102151881=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_P' +
        'RICE_LIST_TABLE,'
      
        '1102151882=                                              ARTICUL' +
        ','
      
        '1102151883=                                              BARCODE' +
        ','
      
        '1102151884=                                              NOMENCL' +
        'ATUR_NUM,'
      '1102151885=                                              NAME,'
      
        '1102151886=                                              UNIT_NA' +
        'ME,'
      '1102151887=                                              PRICE,'
      
        '1102151888=                                              VOLUME_' +
        'PRICE,'
      
        '1102151889=                                              SKIDKA_' +
        'PRICE,'
      '1102151890=                                              AMOUNT,'
      
        '1102151891=                                              AMOUNT_' +
        'RESERVE,'
      '1102151892=                                              SUMM,'
      
        '1102151893=                                              PRICE_S' +
        'ELF,'
      
        '1102151894=                                              SORT_CO' +
        'L,'
      
        '1102151895=                                              IS_CATE' +
        'GORY,'
      '1102151896=                                              NOTE,'
      
        '1102151897=                                              CROSSCO' +
        'DE_BLOB_TXT,'
      '1102151898=                                              PLACE,'
      '1102151899=                                              BRAND,'
      
        '1102151900=                                              AMOUNT_' +
        'VES_GRAMM)'
      
        '1102151901=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1' +
        '),'
      '1102151902=                 G.ARTICUL,'
      '1102151903=                 G.BARCODE,'
      '1102151904=                 G.NOMENCLATUR_NUM,'
      '1102151905=                 G.NAME,'
      '1102151906=                 U.SHORT_NAME,'
      '1102151907=                 G.PRICE,'
      '1102151908=                 G.VOLUME_PRICE,'
      '1102151909=                 G.PRICE - GD.SKIDKA_SUM,'
      '1102151910=                 COALESCE(S.AMOUNT, 0),'
      '1102151911=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '1102151912=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUM' +
        'ERIC) * G.PRICE,'
      '1102151913=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '1102151914=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058 +
        ' '#1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '1102151915=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5' +
        ' '#1047#1040#1050#1059#1055#1054#1050
      '1102151916=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '1102151917=                  DECODE(:FORMULA_,'
      '1102151918=                         1,'
      
        '1102151919=                         (SELECT CAST(S.price AS MY_N' +
        'UMERIC)'
      '1102151920=                            FROM SKLAD S'
      
        '1102151921=                           WHERE :G_TOCHKA_ARR_ CONTA' +
        'INING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39
      
        '1102151922=                             AND S.g_product = G.G_PR' +
        'ODUCT'
      
        '1102151923=                             AND S.IS_VOZVRAT IN (0, ' +
        '3, 4)'
      
        '1102151924=                             AND S.date_receipt = (SE' +
        'LECT MAX(DD.DATE_RECEIPT)'
      
        '1102151925=                                                     ' +
        'FROM SKLAD DD'
      
        '1102151926=                                                    W' +
        'HERE DD.g_product = G.G_PRODUCT'
      
        '1102151927=                                                     ' +
        ' AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||DD.G_TOCHKA||'#39'-'#39
      
        '1102151928=                                                     ' +
        ' AND DD.IS_VOZVRAT IN (0, 3, 4)'
      '1102151929=                                                    )'
      '1102151930=                            ORDER BY 1 DESC'
      '1102151931=                            ROWS 1 TO 1'
      '1102151932=                         ),'
      
        '1102151933=                         (SELECT CAST(ROUND(SUM(T.AMO' +
        'UNT * T.PRICE)/SUM(T.AMOUNT), 2) AS MY_NUMERIC)'
      
        '1102151934=                            FROM (SELECT S.AMOUNT, S.' +
        'PRICE'
      
        '1102151935=                                    FROM SKLAD_PARENT' +
        ' SP,'
      '1102151936=                                         SKLAD S'
      
        '1102151937=                                   WHERE :G_TOCHKA_AR' +
        'R_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '1102151938=                                     AND SP.DATE_RECE' +
        'IPT <= CURRENT_DATE'
      
        '1102151939=                                     AND SP.SKLAD = S' +
        '.SKLAD_PARENT'
      
        '1102151940=                                     AND S.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1102151941=                                     AND SP.IS_VOZVRA' +
        'T IN (0, 3, 4)'
      
        '1102151942=                                    ORDER BY S.DATE_R' +
        'ECEIPT DESC, S.SKLAD DESC ROWS 1 TO 5) T)'
      '1102151943=                        )), 0) spr,'
      
        '1102151944=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL,' +
        ' 1, G.NAME),'
      '1102151945=                 0'
      '1102151946=                 ,G.NOTE'
      
        '1102151947=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROS' +
        'SCODE'
      '1102151948=                 ,G.PLACE'
      '1102151949=                 ,G.BRAND'
      '1102151950=                 ,COALESCE(S.AMOUNT, 0) * G.VES_GRAMM'
      
        '1102151951=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '1102151952=                                                FROM ' +
        'G_DISCOUNT D'
      
        '1102151953=                                                WHERE' +
        ' ((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '1102151954=                                                     ' +
        '   AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '1102151955=                                                     ' +
        '   AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '1102151956=                                                     ' +
        ' )'
      
        '1102151957=                                                     ' +
        ' OR'
      
        '1102151958=                                                     ' +
        ' (D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '1102151959=                                                 AND ' +
        '((:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '1102151960=                                                     ' +
        'OR'
      
        '1102151961=                                                     ' +
        '(D.G_TOCHKA IS NULL))'
      
        '1102151962=                                              ) GD ON' +
        ' G.G_PRODUCT = GD.G_PRODUCT'
      
        '1102151963=                             LEFT OUTER JOIN G_UNIT U' +
        ' ON G.G_UNIT = U.G_UNIT'
      
        '1102151964=                             LEFT OUTER JOIN (SELECT ' +
        'SUM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL' +
        '.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '1102151965=                                              WHERE :' +
        'G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRO' +
        'DUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '1102151966=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '1102151967=             AND G.IS_CATEGORY = 0'
      '1102151968=             AND G.is_active = 1'
      '1102151969=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102151970=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) A' +
        'ND (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '1102151971=                  OR'
      
        '1102151972=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUD' +
        'E_NOL_, 0) = 1)'
      '1102151973=                  or'
      
        '1102151974=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUD' +
        'E_FEW_, 0) = 1))'
      '1102151975=                 )'
      '1102151976=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102151977=             AND ((EXISTS (SELECT 1'
      '1102151978=                           FROM SKLAD S'
      
        '1102151979=                          WHERE S.G_CLIENT = :G_CLIEN' +
        'T_'
      
        '1102151980=                            AND S.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1102151981=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '1102151982=                  OR'
      '1102151983=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '1102151984=           ORDER BY 14, G.NAME, G.G_PRODUCT;'
      '1102151985=      END'
      '1102151986=  END'
      '1102151987='
      
        '1102151988=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, ' +
        '0)||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '1102151989='
      
        '1102151990=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, C' +
        'ROSSCODE_BLOB_TXT, PLACE, NAME, BRAND, NOTE, UNIT_NAME,'
      
        '1102151991=             PRICE, VOLUME_PRICE, SKIDKA_PRICE, AMOUN' +
        'T, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, IS_CATEG' +
        'ORY, AMOUNT_VES_GRAMM,'
      '1102151992=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '1102151993=      FROM P_REP_PRICE_LIST_TABLE'
      
        '1102151994=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR' +
        '_NUM, :CROSSCODE, :PLACE, :NAME, :BRAND, :NOTE, :UNIT_NAME,'
      
        '1102151995=           :PRICE, :VOLUME_PRICE, :SKIDKA_PRICE, :AMO' +
        'UNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SUMM_SELF, :IS_CATEGO' +
        'RY, AMOUNT_VES_GRAMM, :TOVAR_NAME'
      '1102151996=  DO BEGIN'
      '1102151997=    I = I + 1;'
      '1102151998=    SUSPEND;'
      '1102151999=  END'
      '1102152000='
      '1102152001=     /*'
      '1102152002=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '1102152003='
      '1102152004=     SELECT :I,'
      
        '1102152005=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045 +
        #1044#1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      
        '1102152006=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058 +
        #1054
      '1102152007=             U.SHORT_NAME UNIT_NAME,'
      '1102152008=             SS.PRICE,'
      '1102152009=             SS.VOLUME_PRICE,'
      '1102152010=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '1102152011=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE' +
        '(S.AMOUNT, 0)),'
      '1102152012=             SS.IS_CATEGORY'
      '1102152013=        FROM (WITH RECURSIVE TREE'
      '1102152014=              AS (SELECT T.G_PRODUCT,'
      '1102152015=                       T.NAME AS ARTICUL,'
      
        '1102152016=                       CAST(NULL AS VARCHAR(500)) NAM' +
        'E,'
      
        '1102152017=                       CAST(NULL AS NUMERIC(15,2)) PR' +
        'ICE,'
      
        '1102152018=                       CAST(NULL AS NUMERIC(15,2)) VO' +
        'LUME_PRICE,'
      '1102152019=                       T.IS_CATEGORY,'
      '1102152020=                       NULL G_UNIT'
      '1102152021=                  FROM G_PRODUCT T'
      '1102152022=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '1102152023=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T' +
        '.G_PRODUCT||'#39'~'#39
      '1102152024=                UNION ALL'
      '1102152025=                SELECT T.G_PRODUCT,'
      '1102152026=                       DECODE(T. T.ARTICUL,'
      '1102152027=                       T.NAME,'
      '1102152028=                       T.PRICE,'
      '1102152029=                       T.VOLUME_PRICE,'
      '1102152030=                       T.IS_CATEGORY,'
      '1102152031=                       T.G_UNIT'
      
        '1102152032=                  FROM G_PRODUCT T INNER JOIN TREE PR' +
        'IOR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '1102152033=                 WHERE T.IS_ACTIVE = 1'
      '1102152034=                )'
      '1102152035=             SELECT * FROM TREE) SS'
      
        '1102152036=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS' +
        '.G_PRODUCT = S.G_PRODUCT'
      
        '1102152037=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = ' +
        'U.G_UNIT'
      
        '1102152038=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PR' +
        'ODUCT = GD.G_PRODUCT'
      '1102152039=    INTO :ROW_NUM,'
      '1102152040=        :ARTICUL,'
      '1102152041=        :NAME,'
      '1102152042=        :UNIT_NAME,'
      '1102152043=        :PRICE,'
      '1102152044=        :VOLUME_PRICE,'
      '1102152045=        :SKIDKA_PRICE,'
      '1102152046=        :AMOUNT,'
      '1102152047=        :IS_CATEGORY'
      '1102152048=    DO BEGIN'
      '1102152049=      I = I + 1;'
      '1102152050=      SUSPEND;'
      '1102152051=    END  */'
      '1102152052=WHEN ANY DO BEGIN'
      '1102152053=    Err_code = -20500;'
      
        '1102152054=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102152055=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102152056=  END'
      '1102152057=end'
      '1102152058=;'
      '1102152059='
      '1102152060=ALTER PROCEDURE READ_SKLAD_PARENT_LIST('
      '1102152061=  DATE_BEGIN_ DATE,'
      '1102152062=  DATE_END_ DATE,'
      '1102152063=  IS_VOZVRAT_ INTEGER)'
      '1102152064=RETURNS ('
      '1102152065=  SKLAD TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      
        '1102152066=  DATE_RECEIPT TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '1102152067=  TIME_RECEIPT TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '1102152068=  G_CLIENT TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      '1102152069=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      
        '1102152070=  G_PAYMENT_TYPE TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '1102152071=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1102152072=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '1102152073=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '1102152074=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102152075=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1102152076=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '1102152077=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '1102152078=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102152079=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      
        '1102152080=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      
        '1102152081=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PA' +
        'Y_TYPE.NAME)'
      '1102152082=AS'
      '1102152083=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102152084=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102152085=BEGIN'
      '1102152086='
      '1102152087=  SELECT ID'
      '1102152088=    FROM CUR_PARAMS'
      '1102152089=   WHERE CUR_PARAMS = 2'
      '1102152090=    INTO :G_TOCHKA_;'
      '1102152091='
      '1102152092=  SELECT COUNT(*)'
      '1102152093=    FROM SKLAD_PARENT T'
      
        '1102152094=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102152095=     AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :IS_' +
        'VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '1102152096=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1102152097=     AND T.G_TOCHKA = :G_TOCHKA_'
      '1102152098=    INTO CNT_;'
      '1102152099='
      '1102152100=  if (CNT_ = 0) then'
      '1102152101=    SELECT MAX(T.DATE_RECEIPT)'
      '1102152102=      FROM SKLAD_PARENT T'
      '1102152103=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1102152104=       AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :I' +
        'S_VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '1102152105=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1102152106=       AND T.G_TOCHKA = :G_TOCHKA_'
      '1102152107=      INTO :DATE_BEGIN_;'
      '1102152108='
      '1102152109=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1102152110=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1102152111=      FOR'
      '1102152112=        SELECT T.SKLAD,'
      '1102152113=               T.DATE_RECEIPT,'
      '1102152114=               T.TIME_RECEIPT,'
      '1102152115=               T.G_CLIENT,'
      '1102152116=               GC.NAME,'
      '1102152117=               T.G_PAYMENT_TYPE,'
      '1102152118=               PT.NAME,'
      
        '1102152119=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1102152120=                            FROM SKLAD D, G_PRODUCT G'
      
        '1102152121=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1102152122=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1102152123=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR,*/'
      '1102152124=               T.OSNOVANIE,'
      '1102152125=               T.NOTE,'
      '1102152126=               T.SUMM,'
      '1102152127=               T.SUMM_FACT,'
      '1102152128=               T.IS_PAYED_ALL,'
      '1102152129=               T.IS_VOZVRAT,'
      '1102152130=               T.g_official,'
      
        '1102152131=               COALESCE(GO.fio_doc, GO.FM||'#39' '#39'||GO.nm' +
        ')'
      '1102152132=               ,GN.G_NONCASH_PAY_TYPE'
      '1102152133=               ,GN.NAME'
      '1102152134=          FROM SKLAD_PARENT T'
      
        '1102152135=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1102152136=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT' +
        ' ON T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '1102152137=                    LEFT OUTER JOIN G_OFFICIAL GO ON ' +
        'T.g_official = GO.G_OFFICIAL'
      
        '1102152138=                    LEFT OUTER JOIN G_NONCASH_PAY_TYP' +
        'E GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '1102152139=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVR' +
        'AT_ = 0)'
      
        '1102152140=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZV' +
        'RAT_ = 1))'
      '1102152141=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '1102152142=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1102152143=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '1102152144=        INTO :SKLAD,'
      '1102152145=             :DATE_RECEIPT,'
      '1102152146=             :TIME_RECEIPT,'
      '1102152147=             :G_CLIENT,'
      '1102152148=             :CLIENT_NAME,'
      '1102152149=             :G_PAYMENT_TYPE,'
      '1102152150=             :PAYMENT_NAME,'
      '1102152151=             --:DETAILS_STR,'
      '1102152152=             :OSNOVANIE,'
      '1102152153=             :NOTE,'
      '1102152154=             :SUMM,'
      '1102152155=             :SUMM_FACT,'
      '1102152156=             :IS_PAYED_ALL,'
      '1102152157=             :IS_VOZVRAT,'
      '1102152158=             :G_OFFICIAL,'
      '1102152159=             :G_OFFICIAL_FIO'
      '1102152160=             ,:G_NONCASH_PAY_TYPE'
      '1102152161=             ,:G_NONCASH_PAY_TYPE_NAME'
      '1102152162=      DO'
      '1102152163=        suspend;'
      '1102152164='
      
        '1102152165=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1047#1044#1045#1057#1068' '#1044#1040#1053#1053#1067#1049' '#1057#1050#1051#1040#1044' '#1057#1058#1054#1048#1058 +
        ' '#1050#1040#1050' '#1050#1051#1048#1045#1053#1058', '#1040' '#1042' G_TOCHKA '#1057#1058#1054#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '1102152166=  END ELSE BEGIN'
      '1102152167=      FOR'
      '1102152168=        SELECT T.SKLAD,'
      '1102152169=               T.DATE_RECEIPT,'
      '1102152170=               T.G_TOCHKA,'
      '1102152171=               G.NAME,'
      
        '1102152172=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1102152173=                            FROM SKLAD D, G_PRODUCT G'
      
        '1102152174=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1102152175=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1102152176=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR, */'
      '1102152177=               T.OSNOVANIE,'
      '1102152178=               T.NOTE,'
      '1102152179=               T.SUMM'
      
        '1102152180=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHK' +
        'A G ON T.G_CLIENT = G.G_TOCHKA'
      '1102152181=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '1102152182=           AND T.IS_VOZVRAT = 3'
      
        '1102152183=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1102152184=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '1102152185=        INTO :SKLAD,'
      '1102152186=             :DATE_RECEIPT,'
      '1102152187=             :G_CLIENT,'
      '1102152188=             :CLIENT_NAME,'
      '1102152189=             --:DETAILS_STR,'
      '1102152190=             :OSNOVANIE,'
      '1102152191=             :NOTE,'
      '1102152192=             :SUMM'
      '1102152193=      DO'
      '1102152194=        suspend;'
      '1102152195=  END'
      '1102152196=end'
      '1102152197=;'
      '1102152198='
      '1102152199='
      
        '1102152200=/****************************************************' +
        '**************************/'
      
        '1102152201=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1102152202=/****************************************************' +
        '**************************/'
      '1102152203=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '1102152204=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102152205=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102152206=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102152207=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102152208=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102152209=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102152210=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102152211=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102152212=RETURNS ('
      '1102152213=  ERR_CODE INTEGER,'
      '1102152214=  ERR_MSG VARCHAR(1024))'
      '1102152215=AS'
      '1102152216=/*'
      
        '1102152217='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059 +
        ' '#1044#1040#1053#1053#1067#1061
      
        '1102152218='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054 +
        ' '#1055#1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1102152219='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1102152220=*/'
      
        '1102152221=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNL' +
        'OAD'#39';'
      '1102152222=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102152223=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.BARCODE;'
      
        '1102152224=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.ARTICUL;'
      
        '1102152225=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.AMOUNT;'
      
        '1102152226=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.PRICE;'
      
        '1102152227=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL' +
        '_TMP.PRICE;'
      
        '1102152228=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_' +
        'TMP.DISCOUNT;'
      '1102152229=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1102152230=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102152231=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,' +
        '2);'
      
        '1102152232=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_PERC;'
      
        '1102152233=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.ND' +
        'S;'
      
        '1102152234=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP.ZAKAZ_DETAILS;'
      
        '1102152235=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102152236=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102152237=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1102152238=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1102152239=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NON' +
        'CASH;'
      '1102152240=BEGIN'
      '1102152241='
      '1102152242=  PNT_ = '#39'00'#39';'
      '1102152243=  CLRF = ascii_char( 10 );'
      '1102152244='
      '1102152245=  SELECT S.S_VALUE'
      '1102152246=    FROM SYSTEM_SETUP S'
      '1102152247=   WHERE S.SYSTEM_SETUP = 2'
      '1102152248=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1102152249='
      '1102152250=  PNT_ = '#39'01'#39';'
      '1102152251=  SELECT G.nds_value'
      '1102152252=    FROM G_FIRM_REKVIZIT G'
      '1102152253=   WHERE G.is_default = 1'
      '1102152254=    INTO :NDS_;'
      '1102152255='
      '1102152256=  PNT_ = '#39'02'#39';'
      
        '1102152257=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AM' +
        'OUNT, PRICE, DISCOUNT'
      '1102152258=        FROM IMPORT_TBL_TMP'
      
        '1102152259=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_'
      '1102152260=  DO BEGIN'
      '1102152261=    SELECT G_PRODUCT,'
      '1102152262=           PRICE'
      '1102152263=      FROM ('
      '1102152264=            SELECT P.G_PRODUCT, P.price'
      '1102152265=              FROM G_PRODUCT P'
      
        '1102152266=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(CO' +
        'ALESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '1102152267=                OR (P.ARTICUL = :ARTICUL_ and TRIM(CO' +
        'ALESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '1102152268=            UNION'
      '1102152269=            SELECT LT.G_PRODUCT, P.PRICE'
      '1102152270=              FROM LT_BARCODE LT, g_product P'
      
        '1102152271=             WHERE LT.BARCODE = :BARCODE_ and TRIM(CO' +
        'ALESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '1102152272=               AND LT.g_product = P.g_product'
      '1102152273=           )'
      '1102152274=      INTO :G_PRODUCT_,'
      '1102152275=           :PRICE_OUR_;'
      '1102152276='
      '1102152277=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1102152278=      ERR_CODE = -20500;'
      
        '1102152279=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39 +
        '||BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '1102152280=      Exit;'
      '1102152281=    END'
      '1102152282='
      '1102152283=    PNT_ = '#39'03'#39';'
      
        '1102152284=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / ' +
        'PRICE_;'
      
        '1102152285=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_' +
        ', :G_TOCHKA_, 1)'
      '1102152286=      RETURNING_VALUES :COST_PRICE_;'
      '1102152287='
      '1102152288=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1102152289=    IF (price_ IS NULL) THEN'
      '1102152290=      PRICE_ = PRICE_OUR_;'
      '1102152291='
      '1102152292=    PNT_ = '#39'04'#39';'
      
        '1102152293=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PROD' +
        'UCT_,'
      
        '1102152294=                                              :AMOUNT' +
        '_,'
      
        '1102152295=                                              :PRICE_' +
        ','
      
        '1102152296=                                              :AMOUNT' +
        '_ * (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1102152297=                                              :DISCOU' +
        'NT_PERC_,'
      
        '1102152298=                                              :DISCOU' +
        'NT_,'
      
        '1102152299=                                              :AMOUNT' +
        '_ * :DISCOUNT_,'
      '1102152300=                                              :NDS_,'
      
        '1102152301=                                              SUMM_ *' +
        ' NDS_ / (100 + NDS_),'
      
        '1102152302=                                              :COST_P' +
        'RICE_,'
      
        '1102152303=                                              :ALLOW_' +
        'SELL_ABSENT_GOODS_,'
      
        '1102152304=                                              0,     ' +
        '--IS_SPISANIE_'
      
        '1102152305=                                              1,     ' +
        '-- NEW_LINE_SALE_'
      
        '1102152306=                                              0     -' +
        '-MODE_'
      
        '1102152307=                                              ) RETUR' +
        'NING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '1102152308=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102152309=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE' +
        ' = '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR' +
        '_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102152310=      EXIT;'
      '1102152311=    END'
      '1102152312='
      '1102152313=    G_PRODUCT_ = NULL;'
      '1102152314=  END'
      '1102152315='
      '1102152316=  PNT_ = '#39'05'#39';'
      '1102152317=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '1102152318=    SELECT SUM(T.summ)'
      '1102152319=      FROM ZAKAZ_DETAILS_TMP T'
      '1102152320=      INTO :SUMM_;'
      '1102152321=    SUMM_FACT_ = SUMM_;'
      '1102152322=  END'
      '1102152323='
      '1102152324=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '1102152325=  if (G_PAYMENT_TYPE_ = 1) then'
      '1102152326=    SUMM_CASH_ = summ_fact_;'
      '1102152327=  ELSE'
      '1102152328=    SUMM_NONCASH_ = summ_fact_;'
      '1102152329='
      '1102152330=  PNT_ = '#39'06'#39';'
      '1102152331=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '1102152332=    G_CLIENT_ = 10;'
      '1102152333='
      '1102152334=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102152335=                              :Z_DATE_,'
      '1102152336=                              :Z_TIME_,'
      '1102152337=                              :G_CLIENT_,'
      '1102152338=                              :G_PAYMENT_TYPE_,'
      '1102152339=                              '#39#39', --:OSNOVANIE_,'
      '1102152340=                              0,  -- IS_SPISANIE'
      
        '1102152341=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOT' +
        'E_,'
      '1102152342=                              :SUMM_,'
      '1102152343=                              :SUMM_FACT_,'
      '1102152344=                              :SUMM_CASH_,'
      '1102152345=                              :SUMM_NONCASH_,'
      
        '1102152346=                              0,    --:SUMM_PAY_BONUS' +
        '__,'
      
        '1102152347=                              0,    --:SUMM_BONUS_GOT' +
        '__,'
      
        '1102152348=                              NULL,        --:G_PRIHO' +
        'D_,'
      
        '1102152349=                              NULL,        --:SUMM_PR' +
        'IHOD_'
      '1102152350=                              0,    -- :BY_RECIPE__,'
      '1102152351=                              0,    -- IS_RESERVE__'
      '1102152352=                              NULL -- :PAYMENTS__'
      '1102152353=                              )'
      
        '1102152354=                              RETURNING_VALUES :ZAKAZ' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1102152355=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102152356=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE ' +
        '= '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_' +
        'MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '1102152357=    EXIT;'
      '1102152358=  END'
      '1102152359='
      '1102152360=  DELETE FROM import_tbl_tmp;'
      '1102152361='
      '1102152362=WHEN ANY DO BEGIN'
      '1102152363=    ERR_CODE = gdscode;'
      
        '1102152364=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdsco' +
        'de;'
      '1102152365=  END'
      '1102152366=end'
      '1102152367=;'
      '1102152368='
      '1102152369=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1102152370=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102152371=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102152372=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102152373=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102152374=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102152375=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102152376=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102152377=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102152378=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102152379=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1102152380=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102152381=RETURNS ('
      '1102152382=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102152383=  ERR_CODE INTEGER,'
      '1102152384=  ERR_MSG VARCHAR(1024))'
      '1102152385=AS'
      
        '1102152386=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1102152387=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1102152388=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102152389=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1102152390='
      
        '1102152391=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1102152392=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1102152393=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1102152394=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102152395=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102152396=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1102152397=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1102152398=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1102152399=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1102152400=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1102152401=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102152402=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1102152403=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1102152404=BEGIN'
      '1102152405='
      '1102152406=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102152407=    SELECT ID'
      '1102152408=      FROM CUR_PARAMS'
      '1102152409=     WHERE CUR_PARAMS = 2'
      '1102152410=      INTO :G_TOCHKA_;'
      '1102152411='
      
        '1102152412=  --*************************************************' +
        '*************************************************'
      
        '1102152413=  --*************************************************' +
        '*************************************************'
      '1102152414=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102152415=  --*************************************************' +
        '*************************************************'
      
        '1102152416=  --*************************************************' +
        '*************************************************'
      '1102152417=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1102152418=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1102152419=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1102152420=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102152421=            INTO :AMOUNT_,'
      '1102152422=                 :G_PRODUCT_'
      '1102152423=      DO BEGIN'
      '1102152424=          UPDATE LT_SKLAD_PRODUCT L'
      
        '1102152425=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_      ' +
        '-- 03.03.2021 '#1057#1070#1044#1040' '#1053#1045' '#1057#1058#1040#1051' '#1057#1058#1040#1042#1048#1058#1068' NEED_TO_REPLACE '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1047#1040 +
        #1063#1045#1052
      '1102152426=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102152427=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102152428=      END'
      '1102152429='
      '1102152430=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1102152431=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1102152432=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1102152433=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1102152434=             NDS_SUMM, COST_PRICE'
      '1102152435=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102152436='
      '1102152437=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1102152438=                                  :Z_DATE_,'
      '1102152439=                                  :Z_TIME_,'
      '1102152440=                                  :G_CLIENT_,'
      '1102152441=                                  :G_PAYMENT_TYPE_,'
      '1102152442=                                  :OSNOVANIE_,'
      
        '1102152443=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1102152444=                                  :NOTE_,'
      
        '1102152445=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1102152446=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1102152447=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1102152448=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1102152449=                                  0, --SUMM_BONUS_'
      
        '1102152450=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1102152451=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1102152452=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1102152453=                                  0,    --BY_RECIPE'
      '1102152454=                                  0     --IS_RESERVE'
      '1102152455=                                  ,NULL  -- PAYMENTS_'
      '1102152456=                                  ,0     --IS_MEBEL_'
      
        '1102152457=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1102152458=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1102152459=                                  ,NULL  --ADDRESS_'
      '1102152460=                                  ,NULL  --PRICE_'
      
        '1102152461=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      '1102152462=                                  )'
      '1102152463=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102152464='
      '1102152465=      if (ERR_CODE <> 0) then BEGIN'
      '1102152466=        ERR_CODE = -20500;'
      '1102152467=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102152468=        Exit;'
      '1102152469=      END'
      '1102152470='
      
        '1102152471=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102152472=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1102152473=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1102152474=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1102152475=      UPDATE ZAKAZ'
      '1102152476=         SET IS_SPISANIE = 2'
      '1102152477=       WHERE ZAKAZ = :ZAKAZ_;'
      '1102152478='
      
        '1102152479=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102152480=      FOR SELECT T.AMOUNT,'
      '1102152481=                 T.SUMM,'
      '1102152482=                 T.G_PRODUCT,'
      '1102152483=                 T.ZAKAZ_NA_REAL,'
      '1102152484=                 T.ZAKAZ_DETAILS'
      '1102152485=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102152486=            INTO :AMOUNT_,'
      '1102152487=                 :Z_SUMM_,'
      '1102152488=                 :G_PRODUCT_,'
      '1102152489=                 :ZAKAZ_NA_REAL_,'
      '1102152490=                 :ZAKAZ_DETAILS_'
      '1102152491=      DO BEGIN'
      '1102152492=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102152493=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1102152494=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1102152495=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102152496=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102152497='
      
        '1102152498=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102152499=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1102152500=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1102152501=      END'
      '1102152502=  END'
      '1102152503=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102152504=  --*************************************************' +
        '*************************************************'
      
        '1102152505=  --*************************************************' +
        '*************************************************'
      '1102152506='
      
        '1102152507=  --*************************************************' +
        '*************************************************'
      
        '1102152508=  --*************************************************' +
        '*************************************************'
      '1102152509=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102152510=  --*************************************************' +
        '*************************************************'
      
        '1102152511=  --*************************************************' +
        '*************************************************'
      '1102152512=  ELSE BEGIN'
      '1102152513=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1102152514=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1102152515=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1102152516=      FOR SELECT T.AMOUNT,'
      '1102152517=                 T.SUMM,'
      '1102152518=                 T.G_PRODUCT,'
      '1102152519=                 T.ZAKAZ_NA_REAL,'
      '1102152520=                 T.ZAKAZ_DETAILS'
      '1102152521=                 ,T.PRICE'
      '1102152522=                 ,T.NDS'
      '1102152523=                 ,T.NDS_SUMM'
      '1102152524=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1102152525=            INTO :AMOUNT_,'
      '1102152526=                 :Z_SUMM_,'
      '1102152527=                 :G_PRODUCT_,'
      '1102152528=                 :ZAKAZ_NA_REAL_,'
      '1102152529=                 :ZAKAZ_DETAILS_'
      '1102152530=                 ,:PRICE_'
      '1102152531=                 ,:NDS_'
      '1102152532=                 ,:NDS_SUMM_'
      '1102152533=      DO BEGIN'
      
        '1102152534=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102152535=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1102152536='
      
        '1102152537=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1102152538=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1102152539='
      '1102152540=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1102152541=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1102152542=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1102152543=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1102152544=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1102152545=      END'
      '1102152546='
      '1102152547=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1102152548=                                  :Z_DATE_,'
      '1102152549=                                  :Z_TIME_,'
      '1102152550=                                  :G_CLIENT_,'
      '1102152551=                                  :G_PAYMENT_TYPE_,'
      '1102152552=                                  :OSNOVANIE_,'
      '1102152553=                                  :NOTE_,'
      
        '1102152554=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1102152555=                                  :SUMM_,'
      '1102152556=                                  :SUMM_FACT_,'
      
        '1102152557=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1102152558=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1102152559=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1102152560=                                  ,0        --SUMM_CU' +
        'RRENCY_'
      
        '1102152561=                                  ,0        --IS_EXPE' +
        'CTED_'
      
        '1102152562=                                  ,:UPLOAD_TO_EXT_APP' +
        '_'
      
        '1102152563=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1102152564='
      '1102152565=      if (ERR_CODE <> 0) then BEGIN'
      '1102152566=        ERR_CODE = -20500;'
      '1102152567=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1102152568=        Exit;'
      '1102152569=      END'
      '1102152570=  END'
      '1102152571=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102152572=  --*************************************************' +
        '*************************************************'
      
        '1102152573=  --*************************************************' +
        '*************************************************'
      '1102152574='
      '1102152575=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1102152576=END'
      '1102152577=;'
      '1102152578='
      '1102152579=ALTER PROCEDURE R_MADE_REVISION('
      
        '1102152580=  DATE_BEGIN_ TYPE OF COLUMN REVISION_PARENT.DATE_BEG' +
        'IN,'
      
        '1102152581=  TIME_BEGIN_ TYPE OF COLUMN REVISION_PARENT.TIME_BEG' +
        'IN,'
      '1102152582=  DATE_END_ TYPE OF COLUMN REVISION_PARENT.DATE_END,'
      '1102152583=  TIME_END_ TYPE OF COLUMN REVISION_PARENT.TIME_END,'
      '1102152584=  NOTE_ TYPE OF COLUMN REVISION_PARENT.NOTE,'
      '1102152585=  G_TOCHKA_ TYPE OF COLUMN REVISION_PARENT.G_TOCHKA,'
      
        '1102152586=  REVISION_PARENT_ TYPE OF COLUMN REVISION_PARENT.REV' +
        'ISION_PARENT)'
      '1102152587=RETURNS ('
      '1102152588=  COUNT_SPIS_ INTEGER,'
      '1102152589=  COUNT_PRIH_ INTEGER,'
      
        '1102152590=  REVISION_PARENT_OUT_ TYPE OF COLUMN REVISION_PARENT' +
        '.REVISION_PARENT,'
      '1102152591=  ERR_CODE INTEGER,'
      '1102152592=  ERR_MSG VARCHAR(1024))'
      '1102152593=AS'
      
        '1102152594=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_MADE_REVIS' +
        'ION'#39';'
      '1102152595=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102152596=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102152597=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102152598=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102152599=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102152600=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102152601=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102152602=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102152603=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102152604=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      
        '1102152605=DECLARE VARIABLE DATETIME_CREATED_ TYPE OF COLUMN REV' +
        'ISION.DATETIME_CREATED;'
      
        '1102152606=DECLARE VARIABLE AMOUNT_SALED_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.AMOUNT;'
      '1102152607=BEGIN'
      '1102152608='
      '1102152609=  COUNT_SPIS_ = 0;'
      '1102152610=  COUNT_PRIH_ = 0;'
      '1102152611='
      '1102152612=  PNT_ = '#39'00'#39';'
      '1102152613=  IF (REVISION_PARENT_ = 0) THEN BEGIN'
      
        '1102152614=     EXECUTE PROCEDURE REVISION_PARENT_INS(:DATE_BEGI' +
        'N_, :TIME_BEGIN_, :DATE_END_, :TIME_END_, :NOTE_, :G_TOCHKA_, 0)'
      
        '1102152615=     RETURNING_VALUES :REVISION_PARENT_, :ERR_CODE, :' +
        'ERR_MSG;'
      '1102152616='
      '1102152617=     IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1102152618=       ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '1102152619=       EXIT;'
      '1102152620=     END'
      '1102152621=  END'
      '1102152622='
      '1102152623=  PNT_ = '#39'01'#39';'
      
        '1102152624=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL, DATETIME_CREATED'
      '1102152625=      FROM REVISION_TMP'
      '1102152626=      --WHERE REVISION_PARENT = :REVISION_PARENT_'
      
        '1102152627=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_, :DATETIME_CREATED_'
      '1102152628=  DO BEGIN'
      '1102152629=    /*SELECT SUM(ZD.AMOUNT)'
      '1102152630=      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '1102152631=     WHERE Z.Z_DATE BETWEEN CAST(:DATETIME_CREATED_ A' +
        'S DATE) AND CURRENT_DATE'
      
        '1102152632=       AND Z.Z_TIME >= CAST(:DATETIME_CREATED_ AS TIM' +
        'E)'
      '1102152633=       AND Z.Z_TIME <= CURRENT_TIME'
      '1102152634=       AND Z.IS_SPISANIE IN (0, 1)'
      '1102152635=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102152636=      INTO :AMOUNT_SALED_;*/'
      '1102152637='
      '1102152638=    IF (AMOUNT_BD_ > AMOUNT_REAL_) THEN BEGIN'
      
        '1102152639=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102152640=        RETURNING_VALUES :COST_PRICE_;'
      '1102152641='
      
        '1102152642=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102152643=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102152644=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_*/, :COST_PRICE_' +
        ', :COST_PRICE_ * (:AMOUNT_BD_ - :AMOUNT_REAL_/* - :AMOUNT_SALED_' +
        '*/), 0, 0, 0, 0, 0);'
      '1102152645='
      '1102152646=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102152647=    END'
      '1102152648='
      '1102152649=    IF (AMOUNT_BD_ < AMOUNT_REAL_) THEN BEGIN'
      '1102152650=      SELECT S.price'
      '1102152651=        FROM SKLAD S'
      '1102152652=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102152653=         AND S.g_product = :G_PRODUCT_'
      '1102152654=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102152655=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102152656=                                 FROM SKLAD DD'
      
        '1102152657=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102152658=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102152659=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102152660=                                )'
      '1102152661=        ORDER BY s.sklad DESC'
      '1102152662=        ROWS 1 TO 1'
      '1102152663=        INTO :PRICE_LAST_;'
      '1102152664='
      
        '1102152665=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102152666='
      
        '1102152667=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102152668=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/, :PRICE_LAST_' +
        ', (:AMOUNT_REAL_ - :AMOUNT_BD_/* - :AMOUNT_SALED_*/) * :PRICE_LA' +
        'ST_, 0, 0);'
      '1102152669='
      '1102152670=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102152671=    END'
      '1102152672=  END'
      '1102152673='
      '1102152674=  PNT_ = '#39'01A'#39';'
      '1102152675=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102152676=    SELECT SUM(S.SUMM)'
      '1102152677=      FROM ZAKAZ_DETAILS_TMP S'
      '1102152678=      INTO :SUMM_;'
      '1102152679='
      '1102152680=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102152681=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102152682=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102152683=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102152684=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102152685=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102152686=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102152687=                                NULL,           --:NO' +
        'TE_,'
      
        '1102152688=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102152689=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102152690=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102152691=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102152692=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102152693=                                NULL,'
      
        '1102152694=                                0,        -- BY_RECIP' +
        'E'
      
        '1102152695=                                0         -- IS_RESER' +
        'VE'
      '1102152696=                                ,NULL  -- PAYMENTS_'
      '1102152697=                                ,0     -- SUMM_CASH'
      
        '1102152698=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102152699=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102152700=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102152701=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102152702=      EXIT;'
      '1102152703=    END'
      '1102152704=  END'
      '1102152705='
      '1102152706=  PNT_ = '#39'02'#39';'
      '1102152707=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102152708=    SELECT SUM(S.SUMM)'
      '1102152709=      FROM SKLAD_TMP S'
      '1102152710=      INTO :SUMM_;'
      '1102152711='
      '1102152712=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102152713=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102152714=                                CURRENT_TIME,'
      
        '1102152715=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102152716=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102152717=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102152718=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102152719=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102152720=                                :SUMM_,'
      '1102152721=                                :SUMM_,'
      
        '1102152722=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102152723=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102152724=                                ,NULL  --PAYMENTS'
      '1102152725=                                )'
      
        '1102152726=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102152727=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102152728=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102152729=      EXIT;'
      '1102152730=    END'
      '1102152731=  END'
      '1102152732='
      '1102152733=  UPDATE REVISION_PARENT RP'
      '1102152734=     SET RP.IS_MADE = 1,'
      '1102152735=         RP.DATE_END = :DATE_END_,'
      '1102152736=         RP.TIME_END = :TIME_END_'
      '1102152737=   WHERE RP.REVISION_PARENT = :REVISION_PARENT_;'
      '1102152738='
      '1102152739=  REVISION_PARENT_OUT_ = REVISION_PARENT_;'
      '1102152740=END'
      '1102152741=;'
      '1102152742='
      '1102152743=ALTER PROCEDURE R_UNIFICATION('
      '1102152744=  MODE_ INTEGER)'
      '1102152745=RETURNS ('
      '1102152746=  COUNT_SPIS_ INTEGER,'
      '1102152747=  COUNT_PRIH_ INTEGER,'
      '1102152748=  ERR_CODE INTEGER,'
      '1102152749=  ERR_MSG VARCHAR(1024))'
      '1102152750=AS'
      
        '1102152751=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1102152752=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102152753=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1102152754=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1102152755=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1102152756=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1102152757=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1102152758=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1102152759=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102152760=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1102152761=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102152762=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1102152763=BEGIN'
      '1102152764='
      '1102152765=  COUNT_SPIS_ = 0;'
      '1102152766=  COUNT_PRIH_ = 0;'
      '1102152767='
      '1102152768=  SELECT ID'
      '1102152769=    FROM CUR_PARAMS'
      '1102152770=   WHERE CUR_PARAMS = 2'
      '1102152771=    INTO :G_TOCHKA_;'
      '1102152772='
      
        '1102152773=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1102152774=      FROM REVISION'
      '1102152775=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1102152776=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1102152777=  DO BEGIN'
      
        '1102152778=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1102152779=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1102152780=        RETURNING_VALUES :COST_PRICE_;'
      '1102152781='
      
        '1102152782=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1102152783=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1102152784=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1102152785='
      '1102152786=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1102152787=    END'
      '1102152788='
      
        '1102152789=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1102152790=      SELECT S.price'
      '1102152791=        FROM SKLAD S'
      '1102152792=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1102152793=         AND S.g_product = :G_PRODUCT_'
      '1102152794=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1102152795=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1102152796=                                 FROM SKLAD DD'
      
        '1102152797=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1102152798=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1102152799=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1102152800=                                )'
      '1102152801=        ORDER BY s.sklad DESC'
      '1102152802=        ROWS 1 TO 1'
      '1102152803=        INTO :PRICE_LAST_;'
      '1102152804='
      '1102152805=    /* SELECT S.PRICE'
      '1102152806=        FROM SKLAD S'
      '1102152807=       WHERE S.IS_LAST = 1'
      '1102152808=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1102152809=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1102152810=        INTO :PRICE_LAST_; */'
      '1102152811='
      
        '1102152812=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1102152813='
      
        '1102152814=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1102152815=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1102152816='
      '1102152817=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1102152818=    END'
      '1102152819='
      '1102152820=    UPDATE REVISION R'
      '1102152821=       SET R.IS_UNIFIED = 1'
      '1102152822=     WHERE R.REVISION = :REVISION_;'
      '1102152823=  END'
      '1102152824='
      '1102152825=  PNT_ = '#39'01'#39';'
      '1102152826=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1102152827=    SELECT SUM(S.SUMM)'
      '1102152828=      FROM ZAKAZ_DETAILS_TMP S'
      '1102152829=      INTO :SUMM_;'
      '1102152830='
      '1102152831=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1102152832=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1102152833=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1102152834=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1102152835=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1102152836=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1102152837=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1102152838=                                NULL,           --:NO' +
        'TE_,'
      
        '1102152839=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1102152840=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1102152841=                                0,              --SUM' +
        'M_BONUS_'
      
        '1102152842=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1102152843=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1102152844=                                NULL,'
      
        '1102152845=                                0,        -- BY_RECIP' +
        'E'
      
        '1102152846=                                0         -- IS_RESER' +
        'VE'
      '1102152847=                                ,NULL  -- PAYMENTS_'
      '1102152848=                                ,0     -- SUMM_CASH'
      
        '1102152849=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1102152850=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1102152851=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102152852=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102152853=      EXIT;'
      '1102152854=    END'
      '1102152855=  END'
      '1102152856='
      '1102152857=  PNT_ = '#39'02'#39';'
      '1102152858=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1102152859=    SELECT SUM(S.SUMM)'
      '1102152860=      FROM SKLAD_TMP S'
      '1102152861=      INTO :SUMM_;'
      '1102152862='
      '1102152863=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1102152864=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1102152865=                                CURRENT_TIME,'
      
        '1102152866=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1102152867=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1102152868=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1102152869=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1102152870=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1102152871=                                :SUMM_,'
      '1102152872=                                :SUMM_,'
      
        '1102152873=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1102152874=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1102152875=                                ,NULL  --PAYMENTS'
      '1102152876=                                )'
      
        '1102152877=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102152878=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102152879=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102152880=      EXIT;'
      '1102152881=    END'
      '1102152882=  END'
      '1102152883=END'
      '1102152884=;'
      '1102152885='
      '1102152886=ALTER PROCEDURE UPSERT_ZAKAZ_EXT_LOAD('
      '1102152887=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102152888=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102152889=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102152890=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102152891=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102152892=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102152893=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102152894=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102152895=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102152896=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102152897=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102152898=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102152899=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102152900=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102152901=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102152902=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102152903=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102152904=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102152905=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102152906=  IS_MEBEL_ INTEGER = 0,'
      
        '1102152907=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NU' +
        'LL,'
      
        '1102152908=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DAT' +
        'E = NULL,'
      
        '1102152909=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      '1102152910=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '1102152911=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102152912=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = ' +
        'NULL,'
      '1102152913=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102152914=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102152915=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      '1102152916=  REC_ID_ TYPE OF COLUMN ZAKAZ.REC_ID = NULL)'
      '1102152917=RETURNS ('
      '1102152918=  ERR_CODE INTEGER,'
      '1102152919=  ERR_MSG VARCHAR(1024))'
      '1102152920=AS'
      '1102152921=/*'
      
        '1102152922=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1055#1056#1048#1061#1054#1044#1040' '#1048#1047' '#1042#1053#1045#1064#1053#1045#1043#1054' '#1055#1056#1048#1051#1054#1046#1045#1053#1048#1071' ' +
        '- '#1052#1054#1041#1048#1051#1050#1048' '#1048#1051#1048' '#1057#1040#1049#1058#1040
      
        '1102152923=-- '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1058#1040#1050#1054#1049' ID - '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1054' '#1054#1041#1053 +
        #1054#1042#1051#1071#1070', '#1053#1045#1058' - '#1058#1040#1050' '#1042#1057#1058#1040#1042#1051#1071#1070
      '1102152924=*/'
      
        '1102152925=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'UPSERT_ZAKAZ' +
        '_EXT_LOAD'#39';'
      '1102152926=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102152927=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        'NULL;'
      '1102152928=BEGIN'
      '1102152929='
      '1102152930=  PNT_ = '#39'00'#39';'
      '1102152931='
      '1102152932=  SELECT SP.ZAKAZ'
      '1102152933=    FROM ZAKAZ SP'
      '1102152934=   WHERE SP.REC_ID = :REC_ID_'
      '1102152935=    INTO :ZAKAZ_;'
      '1102152936='
      '1102152937=  IF (ZAKAZ_ IS NULL) THEN BEGIN'
      '1102152938='
      '1102152939=    PNT_ = '#39'01'#39';'
      
        '1102152940=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_, :Z_DATE_,' +
        ' :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :IS_SPISAN' +
        'IE_,'
      
        '1102152941=        :NOTE_, :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SU' +
        'MM_NONCASH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_P' +
        'RIHOD_,'
      
        '1102152942=        :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_, :IS_ME' +
        'BEL_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_,'
      
        '1102152943=        :UPLOAD_TO_EXT_APP_, :G_OFFICIAL_, :NOT_MINUS' +
        '_OSTATOK_, :USER_ID_, :LOG_BODY_, :REC_ID_)'
      
        '1102152944=        RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1102152945='
      '1102152946=  END'
      '1102152947=  ELSE BEGIN'
      '1102152948='
      '1102152949=    PNT_ = '#39'02'#39';'
      
        '1102152950=    EXECUTE PROCEDURE UPDATE_ZAKAZ_DETAIL(:ZAKAZ_, :Z' +
        '_DATE_, :Z_TIME_, :G_CLIENT_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NO' +
        'TE_,'
      
        '1102152951=        :SUMM_, :SUMM_FACT_, :SUMM_CASH_, :SUMM_NONCA' +
        'SH_, :SUMM_BONUS_, :SUMM_BONUS_GOT_, :G_PRIHOD_, :SUMM_PRIHOD_,'
      
        '1102152952=        :IS_SPISANIE_, :BY_RECIPE_, :IS_RESERVE_, :PA' +
        'YMENTS_, :UPLOAD_TO_EXT_APP_, :NOT_MINUS_OSTATOK_, :ADDRESS_,'
      '1102152953=        :USER_ID_, :LOG_BODY_)'
      '1102152954=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1102152955='
      '1102152956=  END'
      '1102152957='
      '1102152958=  IF (:ERR_CODE <> 0) THEN'
      
        '1102152959=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102152960='
      '1102152961=END'
      '1102152962=;'
      '1102152963='
      '1102152964='
      
        '1102152965=UPDATE SYSTEM_SETUP SET S_VALUE = 110215 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1102152966=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1102152967=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1102160='
