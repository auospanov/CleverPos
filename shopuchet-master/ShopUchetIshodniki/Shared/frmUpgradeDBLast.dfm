      '11042808=              :SUMM'
      '11042809=      DO BEGIN'
      '11042810=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '11042811=        UPDATE LT_SKLAD_PRODUCT L'
      '11042812=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '11042813=         WHERE L.G_PRODUCT = :G_PRODUCT'
