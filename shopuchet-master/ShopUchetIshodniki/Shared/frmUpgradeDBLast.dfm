      '1102121217='
      
        '1102121218=  --*************************************************' +
        '****************************************'
      '1102121219=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102121220=  -- '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1042#1057#1045' '#1058#1040#1050': '#1062#1045#1053#1040'. '#1047#1040' '#1050#1054#1058#1054#1056#1059#1070' '#1054#1058#1044#1040#1053#1054' '#1050#1051#1048 +
        #1045#1053#1058#1059' - '#1042' '#1050#1054#1051#1054#1053#1050#1059' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'"'
      
        '1102121221=  -- '#1040' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1054#1051#1054#1053#1050#1059' "'#1042#1067#1056#1059#1063#1045#1053 +
        #1054'", '#1048' '#1055#1056#1048#1041#1067#1051#1068' '#1041#1059#1044#1045#1058' '#1057#1050#1051#1040#1044#1067#1042#1040#1058#1068#1057#1071
      
        '1102121222=  -- '#1050#1040#1050' '#1056#1040#1047#1053#1048#1062#1040' "'#1042#1067#1056#1059#1063#1045#1053#1054'" - "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1053#1040' '#1042#1067#1061#1054#1044#1045' ' +
        #1055#1054#1051#1059#1063#1048#1058#1057#1071' '#1063#1048#1057#1051#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      '1102121223='
      
        '1102121224=  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068 +
        #1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000' +
        ', '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '1102121225=  -- '#1050' '#1055#1056#1048#1052#1045#1056#1059' '#1048#1047' '#1069#1058#1048#1061' 7000 '#1053#1040' '#1047#1040#1050#1059#1055' '#1041#1067#1051#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054' 4' +
        '500'
      
        '1102121226=  -- -4500 + 7000 = 2500 '#1055#1056#1048#1041#1067#1051#1068', '#1047#1040#1058#1045#1052' '#1055#1054#1050#1059#1055#1040#1058#1045#1051#1068' '#1055#1056 +
        #1048#1061#1054#1044#1048#1058' '#1048' '#1042#1054#1047#1042#1056#1040#1065#1040#1045#1058' '#1058#1054#1042#1040#1056' -7000, '#1055#1054#1051#1059#1063#1040#1045#1058#1057#1071', '#1063#1058#1054' +7000 '#1048' -7000 '#1057 +
        #1054#1050#1056#1040#1065#1040#1045#1058#1057#1071' '#1048' '#1054#1057#1058#1040#1045#1058#1057#1071' '#1059#1041#1067#1058#1054#1050' '#1053#1040' -4500'
      
        '1102121227=  -- '#1050#1054#1053#1045#1063#1053#1054', '#1045#1057#1051#1048' '#1055#1056#1054#1044#1040#1046#1040' '#1041#1067#1051#1040' '#1042' '#1055#1056#1054#1064#1051#1054#1052' '#1052#1045#1057#1071#1062#1045', '#1040' '#1070 +
        #1047#1045#1056' '#1057#1052#1054#1058#1056#1048#1058' '#1047#1040' '#1058#1045#1050#1059#1065#1048#1049', '#1058#1054' '#1055#1054#1050#1040#1046#1045#1058#1057#1071' '#1041#1059#1044#1058#1054' '#1056#1040#1057#1061#1054#1044#1054#1042' '#1041#1054#1051#1068#1064#1045', '#1053#1040#1044#1054 +
        ' '#1055#1056#1054#1057#1058#1054' '#1041#1056#1040#1058#1068' '#1047#1040' '#1041#1054#1051#1068#1064#1048#1049' '#1055#1045#1056#1048#1054#1044
      '1102121228='
      
        '1102121229=  -- 03.02.2020 '#1054#1044#1048#1053' '#1047#1040#1053#1054#1047#1053#1067#1049' '#1050#1051#1048#1045#1053#1058' '#1059#1043#1054#1042#1054#1056#1048#1051' '#1052#1045#1053#1071' '#1053#1045 +
        ' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1042' "'#1055#1054#1058#1056#1040#1063#1045#1053#1054'", '#1071' '#1056#1045#1064#1048#1051' '#1057#1058#1040#1042#1048#1058#1068' '#1045#1045' '#1042' "'#1042#1067#1056#1059 +
        #1063#1045#1053#1054'" '#1053#1054' '#1057' '#1052#1048#1053#1059#1057#1054#1052
      
        '1102121230=  -- '#1040' '#1042' '#1048#1058#1054#1043#1054#1042#1067#1061' '#1057#1058#1056#1054#1050#1040#1061' '#1057#1058#1040#1042#1048#1058#1068' = '#1057#1059#1052#1052#1040'_'#1055#1056#1054#1044#1040#1046'_'#1060#1040#1050#1058 +
        '. - '#1057#1059#1052#1052#1040'_'#1042#1054#1047#1042#1056#1040#1058#1054#1042'_'#1060#1040#1050#1058'.'
      
        '1102121231=  --*************************************************' +
        '****************************************'
      '1102121232=  SELECT COUNT(*)'
      '1102121233=    FROM SKLAD S'
      
        '1102121234=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      
        '1102121235=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1102121236=     AND S.IS_VOZVRAT IN (1,2)'
      
        '1102121237=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S' +
        '.G_CLIENT, 0))'
      
        '1102121238=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_' +
        ', COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1102121239=     AND ((EXISTS (SELECT 1'
      '1102121240=                   FROM SKLAD SS'
      '1102121241=                  WHERE SS.G_CLIENT = :G_SUPPLIER_'
      '1102121242=                    AND SS.G_PRODUCT = S.G_PRODUCT'
      
        '1102121243=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102121244=          OR'
      '1102121245=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102121246=  INTO :CNT_;'
      '1102121247='
      '1102121248=  IF (CNT_ > 0) THEN BEGIN'
      '1102121249=    SUM_ZAKAZ_ = 0;'
      '1102121250=    PROFIT_    = 0;'
      '1102121251=    SUM_COST_  = 0;'
      '1102121252=    NDS_SUMM_  = 0;'
      '1102121253='
      '1102121254=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121255=    insert into p_rep_profit_table'
      '1102121256=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102121257=    values'
      
        '1102121258=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054 +
        #1042#1040#1056#1040#39', 1);'
      '1102121259='
      '1102121260=    FOR SELECT S.DATE_RECEIPT,'
      '1102121261=               S.G_PRODUCT,'
      '1102121262=               G.NAME TOVAR_NAME,'
      '1102121263=               S.AMOUNT,'
      '1102121264=               -S.PRICE,'
      '1102121265=               -S.SUMM,'
      '1102121266=               SP.G_TOCHKA,'
      '1102121267=               S.COST_PRICE,'
      '1102121268=               S.NDS,'
      '1102121269=               S.NDS_SUMM'
      '1102121270=         FROM SKLAD_PARENT SP,'
      '1102121271=              SKLAD S,'
      '1102121272=              G_PRODUCT G'
      
        '1102121273=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_TOC' +
        'HKA||'#39'-'#39
      
        '1102121274=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1102121275=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '1102121276=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COAL' +
        'ESCE(S.G_CLIENT, 0))'
      
        '1102121277=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT' +
        '_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1102121278=          AND SP.SKLAD = S.SKLAD_PARENT'
      '1102121279=          AND S.G_PRODUCT = G.G_PRODUCT'
      '1102121280=          AND ((EXISTS (SELECT 1'
      '1102121281=                           FROM SKLAD SS'
      
        '1102121282=                          WHERE SS.G_CLIENT = :G_SUPP' +
        'LIER_'
      
        '1102121283=                            AND SS.G_PRODUCT = S.G_PR' +
        'ODUCT'
      
        '1102121284=                            AND :G_TOCHKA_ARR_ CONTAI' +
        'NING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102121285=                  OR'
      '1102121286=                  COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102121287=        ORDER BY 1'
      '1102121288=    INTO :V_DATE_RECEIPT_,'
      '1102121289=         :V_G_PRODUCT_,'
      '1102121290=         :V_TOVAR_NAME_,'
      '1102121291=         :V_AMOUNT_,'
      '1102121292=         :V_PRICE_,'
      '1102121293=         :V_SUMM_,'
      '1102121294=         :REC_G_TOCHKA_,'
      '1102121295=         :REC_PRICE_SELF_,'
      '1102121296=         :REC_NDS_,'
      '1102121297=         :REC_NDS_SUMM_'
      '1102121298=    DO BEGIN'
      '1102121299=      REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      
        '1102121300=      REC_profit_   = V_SUMM_ + REC_SUM_COST_ + REC_N' +
        'DS_SUMM_;'
      '1102121301='
      '1102121302=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '1102121303=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR' +
        '_NAME, AMOUNT, PRICE, SUMM,'
      '1102121304=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '1102121305=         NDS, NDS_SUMM, PROFIT, IS_HEAD, price_self, ' +
        'sum_self)'
      '1102121306=      VALUES'
      
        '1102121307=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_R' +
        'ECEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, :V_PRICE_, :' +
        'V_SUMM_,'
      
        '1102121308=         0, 0, :REC_NDS_, :REC_NDS_SUMM_, :REC_profit' +
        '_, 0, :REC_PRICE_SELF_, :REC_SUM_COST_);'
      '1102121309='
      '1102121310=      SUM_COST_  = SUM_COST_  + REC_SUM_COST_;'
      '1102121311=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      
        '1102121312=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1102121313=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0)' +
        ';'
      '1102121314=    END'
      '1102121315='
      '1102121316='
      '1102121317=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1102121318=    SUMM_COST_All_ = SUMM_COST_All_ - SUM_COST_;'
      '1102121319=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ - NDS_SUMM_;'
      '1102121320=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102121321='
      '1102121322=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121323=    insert into p_rep_profit_table'
      
        '1102121324=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102121325=    values'
      
        '1102121326=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1102121327='
      '1102121328=    SUM_COST_  = 0;'
      '1102121329=    SUM_ZAKAZ_ = 0;'
      '1102121330=    NDS_SUMM_  = 0;'
      '1102121331=    PROFIT_    = 0;'
      '1102121332=  END'
      '1102121333=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056
      
        '1102121334=  --*************************************************' +
        '****************************************'
      '1102121335='
      
        '1102121336=  --*************************************************' +
        '****************************************'
      
        '1102121337=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1045#1057#1051#1048' '#1048#1052#1045 +
        #1051#1054' '#1052#1045#1057#1058#1054
      '1102121338=  -- '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051', '#1063#1058#1054' '#1054#1053' '#1047#1044#1045#1057#1068' '#1053#1045' '#1053#1059#1046#1045#1053
      
        '1102121339=  --*************************************************' +
        '****************************************'
      '1102121340=  /*SELECT COUNT(*)'
      '1102121341=    FROM ZAKAZ Z'
      
        '1102121342=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1102121343=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '1102121344=     AND Z.IS_SPISANIE = 4'
      
        '1102121345=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))'
      
        '1102121346=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102121347=  INTO :CNT_;'
      '1102121348='
      '1102121349=  IF (CNT_ > 0) THEN BEGIN'
      '1102121350=      SUM_ZAKAZ_ = 0;'
      '1102121351=      SUM_COST_  = 0;'
      '1102121352=      PROFIT_    = 0;'
      '1102121353=      NDS_SUMM_  = 0;'
      '1102121354='
      '1102121355=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121356=      insert into p_rep_profit_table'
      '1102121357=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102121358=      values'
      
        '1102121359=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059#39', 1);'
      '1102121360='
      '1102121361=      FOR SELECT Z.ZAKAZ,'
      '1102121362=               Z.G_TOCHKA,'
      '1102121363=               Z.Z_DATE,'
      '1102121364=               Z.G_CLIENT,'
      '1102121365=               C.NAME CLIENT_NAME,'
      '1102121366=               Z.G_PAYMENT_TYPE,'
      '1102121367=               P.NAME PAYMENT_NAME,'
      '1102121368=               Z.OSNOVANIE,'
      '1102121369=               G.G_PRODUCT,'
      '1102121370=               G.G_PRODUCT_PAR,'
      '1102121371=               G.NAME TOVAR_NAME,'
      '1102121372=               ZD.AMOUNT,'
      '1102121373=               ZD.PRICE,'
      '1102121374=               ZD.SUMM,'
      '1102121375=               ZD.DISCOUNT_PERC,'
      '1102121376=               ZD.DISCOUNT_SUMM,'
      '1102121377=               ZD.NDS,'
      '1102121378=               ZD.NDS_SUMM,'
      '1102121379=               COALESCE(ZD.COST_PRICE, 0)'
      
        '1102121380=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON ' +
        'Z.G_CLIENT = C.G_CLIENT,'
      '1102121381=               ZAKAZ_DETAILS ZD,'
      '1102121382=               G_PRODUCT G,'
      '1102121383=               G_PAYMENT_TYPE P'
      
        '1102121384=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOC' +
        'HKA||'#39'-'#39
      '1102121385=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102121386=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1102121387=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '1102121388=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  --' +
        ' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1102121389=           AND Z.IS_SPISANIE = 4                   --' +
        ' '#1058#1054#1051#1068#1050#1054' '#1042#1054#1047#1042#1056#1040#1058#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '1102121390=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102121391=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102121392=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '1102121393=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '1102121394=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ' +
        'ZD.ZAKAZ_DETAILS, G.NAME'
      '1102121395=    INTO :REC_ZAKAZ_,'
      '1102121396=        :REC_G_TOCHKA_,'
      '1102121397=        :REC_Z_DATE_,'
      '1102121398=        :REC_G_CLIENT_,'
      '1102121399=        :REC_CLIENT_NAME_,'
      '1102121400=        :REC_G_PAYMENT_TYPE_,'
      '1102121401=        :REC_PAYMENT_NAME_,'
      '1102121402=        :REC_OSNOVANIE_,'
      '1102121403=        :REC_G_PRODUCT_,'
      '1102121404=        :REC_G_PRODUCT_PAR_,'
      '1102121405=        :REC_TOVAR_NAME_,'
      '1102121406=        :REC_AMOUNT_,'
      '1102121407=        :REC_PRICE_,'
      '1102121408=        :REC_SUMM_,'
      '1102121409=        :REC_DISCOUNT_PERC_,'
      '1102121410=        :REC_DISCOUNT_SUMM_,'
      '1102121411=        :REC_NDS_,'
      '1102121412=        :REC_NDS_SUMM_,'
      '1102121413=        :REC_PRICE_SELF_'
      '1102121414=    DO BEGIN'
      '1102121415=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      '1102121416=      REC_profit_   = REC_SUMM_ - REC_SUM_COST_;'
      '1102121417='
      '1102121418=      insert into p_rep_profit_table'
      
        '1102121419=        (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '1102121420=         osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '1102121421=         nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '1102121422=      values'
      '1102121423=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1102121424=        :REC_ZAKAZ_,'
      '1102121425=        :REC_g_tochka_,'
      
        '1102121426=        :REC_z_date_, :REC_g_client_, :REC_client_nam' +
        'e_, :REC_g_payment_type_, :REC_payment_name_,'
      '1102121427=         :REC_osnovanie_,'
      '1102121428=         :REC_g_product_,'
      '1102121429=         :REC_g_product_par_,'
      '1102121430=         :REC_tovar_name_,'
      '1102121431=         :REC_amount_,'
      '1102121432=         :REC_price_,'
      '1102121433=         :REC_summ_,'
      '1102121434=         :REC_discount_perc_,'
      '1102121435=         :REC_discount_summ_,'
      
        '1102121436=         :REC_nds_, :REC_nds_summ_, :REC_price_self_,' +
        ' :REC_SUM_COST_, :REC_profit_, 0);'
      '1102121437='
      
        '1102121438=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0' +
        ');'
      
        '1102121439=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_' +
        ', 0);'
      
        '1102121440=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_' +
        ', 0);'
      
        '1102121441=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0)' +
        ';'
      '1102121442=    END'
      '1102121443='
      '1102121444=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121445=    insert into p_rep_profit_table'
      
        '1102121446=      (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '1102121447=    values'
      
        '1102121448=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1102121449='
      '1102121450=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '1102121451=    SUM_COST_ALL_  = SUM_COST_ALL_ + SUM_COST_;'
      '1102121452=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '1102121453=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '1102121454='
      '1102121455=    SUM_ZAKAZ_ = 0;'
      '1102121456=    SUM_COST_  = 0;'
      '1102121457=    NDS_SUMM_  = 0;'
      '1102121458=    PROFIT_    = 0;'
      '1102121459=  END'
      '1102121460=  -- '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1065#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059' */'
      
        '1102121461=  --*************************************************' +
        '****************************************'
      '1102121462='
      
        '1102121463=  --*************************************************' +
        '****************************************'
      
        '1102121464=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1055#1051#1040#1063#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056', '#1054#1058#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062 +
        #1048#1070' '#1045#1057#1051#1048' '#1048#1052#1045#1051#1054' '#1052#1045#1057#1058#1054
      
        '1102121465=  -- '#1042#1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068' '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050 +
        #1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051#1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1102121466=  --*************************************************' +
        '****************************************'
      '1102121467=  SELECT COUNT(*)'
      '1102121468=    FROM ZAKAZ S'
      
        '1102121469=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39 +
        '-'#39
      '1102121470=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102121471=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102121472=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '1102121473=     AND S.IS_SPISANIE = 2'
      '1102121474=  INTO :CNT_;'
      '1102121475='
      '1102121476=  IF (CNT_ > 0) THEN BEGIN'
      '1102121477=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121478=      insert into p_rep_profit_table'
      '1102121479=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102121480=      values'
      
        '1102121481=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39', 1);'
      '1102121482='
      '1102121483=      SUM_ZAKAZ_ = 0;'
      '1102121484=      SUM_COST_  = 0;'
      '1102121485=      NDS_SUMM_  = 0;'
      '1102121486=      PROFIT_    = 0;'
      '1102121487=      FOR SELECT GP.NAME,'
      '1102121488=                 GP.G_PRODUCT'
      '1102121489=           FROM G_PRODUCT GP'
      '1102121490=          WHERE IS_CATEGORY = 1'
      '1102121491=            AND EXISTS (SELECT 1'
      
        '1102121492=                          FROM ZAKAZ Z, ZAKAZ_DETAILS' +
        ' ZD, G_PRODUCT G'
      
        '1102121493=                         WHERE :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||Z.G_TOCHKA||'#39'-'#39
      '1102121494=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '1102121495=                           AND ZD.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '1102121496=                           AND G.G_PRODUCT_PAR = GP.G' +
        '_PRODUCT'
      '1102121497=                           AND Z.IS_SPISANIE = 2'
      '1102121498=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102121499=                           AND Z.Z_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '1102121500=                           AND COALESCE(Z.G_CLIENT, 0' +
        ') = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053 +
        #1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102121501=                           AND COALESCE(Z.G_PAYMENT_T' +
        'YPE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, ' +
        '0))'
      '1102121502=                           AND ((EXISTS (SELECT 1'
      
        '1102121503=                                           FROM SKLAD' +
        ' S'
      
        '1102121504=                                          WHERE S.G_C' +
        'LIENT = :G_SUPPLIER_'
      
        '1102121505=                                            AND S.G_P' +
        'RODUCT = G.G_PRODUCT'
      
        '1102121506=                                            AND :G_TO' +
        'CHKA_ARR_ CONTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPL' +
        'IER_, 0) <> 0)'
      '1102121507=                                  OR'
      
        '1102121508=                                  COALESCE(:G_SUPPLIE' +
        'R_, 0) = 0)'
      '1102121509=                           )'
      '1102121510=          ORDER BY 1'
      '1102121511=      INTO :RECCAT_NAME_,'
      '1102121512=           :RECCAT_PRODUCT_'
      '1102121513=      DO BEGIN'
      '1102121514=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121515=        insert into p_rep_profit_table'
      '1102121516=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '1102121517=        values'
      
        '1102121518=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT' +
        '_NAME_, 1);'
      '1102121519='
      '1102121520=        FOR SELECT Z.ZAKAZ,'
      '1102121521=                   Z.G_TOCHKA,'
      '1102121522=                   Z.Z_DATE,'
      '1102121523=                   Z.G_CLIENT,'
      '1102121524=                   C.NAME CLIENT_NAME,'
      '1102121525=                   Z.G_PAYMENT_TYPE,'
      '1102121526=                   P.NAME PAYMENT_NAME,'
      '1102121527=                   Z.OSNOVANIE,'
      '1102121528=                   G.G_PRODUCT,'
      '1102121529=                   G.G_PRODUCT_PAR,'
      '1102121530=                   G.NAME TOVAR_NAME,'
      '1102121531=                   ZD.AMOUNT,'
      '1102121532=                   ZD.PRICE,'
      '1102121533=                   ZD.SUMM,'
      '1102121534=                   ZD.DISCOUNT_PERC,'
      '1102121535=                   ZD.DISCOUNT_SUMM,'
      '1102121536=                   ZD.NDS,'
      '1102121537=                   ZD.NDS_SUMM,'
      '1102121538=                   ZD.COST_PRICE'
      
        '1102121539=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C' +
        ' ON Z.G_CLIENT = C.G_CLIENT,'
      '1102121540=                   ZAKAZ_DETAILS ZD,'
      '1102121541=                   G_PRODUCT G,'
      '1102121542=                   G_PAYMENT_TYPE P'
      
        '1102121543=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G' +
        '_TOCHKA||'#39'-'#39
      '1102121544=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '1102121545=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1102121546=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYP' +
        'E'
      
        '1102121547=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_' +
        '  -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '1102121548=               AND Z.IS_SPISANIE = 2                 ' +
        '   -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '1102121549=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1102121550=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1102121551=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE' +
        '(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068 +
        ' '#1055#1059#1057#1058#1067#1052
      
        '1102121552=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = CO' +
        'ALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102121553=               AND ((EXISTS (SELECT 1'
      '1102121554=                               FROM SKLAD S'
      
        '1102121555=                              WHERE S.G_CLIENT = :G_S' +
        'UPPLIER_'
      
        '1102121556=                                AND S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '1102121557=                                AND :G_TOCHKA_ARR_ CO' +
        'NTAINING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> ' +
        '0)'
      '1102121558=                      OR'
      '1102121559=                      COALESCE(:G_SUPPLIER_, 0) = 0)'
      
        '1102121560=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAK' +
        'AZ, ZD.ZAKAZ_DETAILS, G.NAME'
      '1102121561=        INTO :REC_ZAKAZ_,'
      '1102121562=            :REC_G_TOCHKA_,'
      '1102121563=            :REC_Z_DATE_,'
      '1102121564=            :REC_G_CLIENT_,'
      '1102121565=            :REC_CLIENT_NAME_,'
      '1102121566=            :REC_G_PAYMENT_TYPE_,'
      '1102121567=            :REC_PAYMENT_NAME_,'
      '1102121568=            :REC_OSNOVANIE_,'
      '1102121569=            :REC_G_PRODUCT_,'
      '1102121570=            :REC_G_PRODUCT_PAR_,'
      '1102121571=            :REC_TOVAR_NAME_,'
      '1102121572=            :REC_AMOUNT_,'
      '1102121573=            :REC_PRICE_,'
      '1102121574=            :REC_SUMM_,'
      '1102121575=            :REC_DISCOUNT_PERC_,'
      '1102121576=            :REC_DISCOUNT_SUMM_,'
      '1102121577=            :REC_NDS_,'
      '1102121578=            :REC_NDS_SUMM_,'
      '1102121579=            :REC_PRICE_SELF_'
      '1102121580=        DO BEGIN'
      
        '1102121581=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SEL' +
        'F_;'
      
        '1102121582=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ -' +
        ' REC_NDS_SUMM_;'
      '1102121583='
      '1102121584=          insert into p_rep_profit_table'
      
        '1102121585=            (p_rep_profit_table, zakaz, g_tochka, z_d' +
        'ate, g_client, client_name, g_payment_type, payment_name,'
      
        '1102121586=             osnovanie, g_product, g_product_par, tov' +
        'ar_name, amount, price, summ, discount_perc, discount_summ,'
      
        '1102121587=             nds, nds_summ, price_self, sum_self, pro' +
        'fit, is_head)'
      '1102121588=          values'
      '1102121589=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '1102121590=            :REC_ZAKAZ_,'
      '1102121591=            :REC_g_tochka_,'
      
        '1102121592=            :REC_z_date_, :REC_g_client_, :REC_client' +
        '_name_, :REC_g_payment_type_, :REC_payment_name_,'
      '1102121593=             :REC_osnovanie_,'
      '1102121594=             :REC_g_product_,'
      '1102121595=             :REC_g_product_par_,'
      '1102121596=             :REC_tovar_name_,'
      '1102121597=             :REC_amount_,'
      '1102121598=             :REC_price_,'
      '1102121599=             :REC_summ_,'
      '1102121600=             :REC_discount_perc_,'
      '1102121601=             :REC_discount_summ_,'
      
        '1102121602=             :REC_nds_, :REC_nds_summ_, :REC_price_se' +
        'lf_, :REC_SUM_COST_, :REC_profit_, 0);'
      '1102121603='
      
        '1102121604=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM' +
        '_, 0);'
      
        '1102121605=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_C' +
        'OST_, 0);'
      
        '1102121606=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_S' +
        'UMM_, 0);'
      
        '1102121607=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_' +
        ', 0);'
      '1102121608=        END'
      '1102121609='
      '1102121610=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1102121611=        insert into p_rep_profit_table'
      
        '1102121612=          (p_rep_profit_table, tovar_name, summ, sum_' +
        'self, NDS_SUMM, profit, is_head)'
      '1102121613=        values'
      
        '1102121614=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1058#1054#1043#1054#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '1102121615='
      
        '1102121616=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ' +
        '_;'
      '1102121617=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '1102121618=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '1102121619=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '1102121620='
      '1102121621=        SUM_ZAKAZ_ = 0;'
      '1102121622=        SUM_COST_  = 0;'
      '1102121623=        NDS_SUMM_  = 0;'
      '1102121624=        PROFIT_    = 0;'
      '1102121625=      END'
      '1102121626='
      '1102121627=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '1102121628=      insert into p_rep_profit_table'
      
        '1102121629=        (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '1102121630=      values'
      
        '1102121631=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '1102121632='
      
        '1102121633=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REA' +
        'L_;'
      
        '1102121634=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REA' +
        'L_;'
      
        '1102121635=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_' +
        ';'
      '1102121636=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '1102121637=  END'
      '1102121638=  -- '#1050#1054#1053#1045#1062' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056', '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1102121639=  --*************************************************' +
        '****************************************'
      '1102121640=  --END  -- '#1050#1054#1053#1045#1062' '#1062#1048#1050#1051#1040' '#1055#1054' '#1057#1050#1051#1040#1044#1040#1052
      '1102121641='
      '1102121642=  -- '#1042#1057#1058#1040#1042#1051#1070' '#1055#1059#1057#1058#1059#1070' '#1057#1058#1056#1054#1050#1059
      '1102121643=  insert into p_rep_profit_table'
      '1102121644=    (p_rep_profit_table, is_head)'
      '1102121645=  values'
      '1102121646=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '1102121647='
      '1102121648=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '1102121649=  insert into p_rep_profit_table'
      
        '1102121650=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102121651=  values'
      
        '1102121652=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '1102121653='
      '1102121654=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '1102121655=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '1102121656=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '1102121657=         SUM(Z.SUMM_BONUS)'
      '1102121658=    FROM ZAKAZ Z'
      
        '1102121659=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      
        '1102121660=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' ' +
        #1089#1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '1102121661=     AND Z.IS_RESERVE = 0'
      '1102121662=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1102121663=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '1102121664=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '1102121665=     AND ((EXISTS (SELECT 1'
      '1102121666=                   FROM ZAKAZ_DETAILS ZD, SKLAD S'
      '1102121667=                  WHERE ZD.ZAKAZ = Z.ZAKAZ'
      '1102121668=                    AND S.G_CLIENT = :G_SUPPLIER_'
      '1102121669=                    AND S.G_PRODUCT = ZD.G_PRODUCT'
      
        '1102121670=                    AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39 +
        '||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '1102121671=          OR'
      '1102121672=          COALESCE(:G_SUPPLIER_, 0) = 0)'
      '1102121673=    INTO :SUMM_CASH_ALL_,'
      '1102121674=         :SUMM_NONCASH_ALL_,'
      '1102121675=         :SUMM_BONUS_ALL_;'
      '1102121676='
      '1102121677=  SELECT SUM(NAL),'
      '1102121678=         SUM(BEZNAL)'
      
        '1102121679=    FROM (SELECT (SELECT SUM(K.SUMM) FROM KASSA K WHE' +
        'RE K.SKLAD = SP.SKLAD) NAL,'
      
        '1102121680=               (SELECT SUM(KB.SUMM) FROM KASSA_BEZNAL' +
        ' KB WHERE KB.SKLAD = SP.SKLAD) BEZNAL'
      '1102121681=           FROM SKLAD_PARENT SP'
      
        '1102121682=          WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||SP.G_T' +
        'OCHKA||'#39'-'#39
      
        '1102121683=            AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1102121684=            AND SP.IS_VOZVRAT IN (1,2)'
      
        '1102121685=            AND SP.G_CLIENT = COALESCE(:G_CLIENT_, CO' +
        'ALESCE(SP.G_CLIENT, 0))'
      
        '1102121686=            AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYME' +
        'NT_TYPE_, COALESCE(SP.G_PAYMENT_TYPE, 0))'
      '1102121687=        )'
      '1102121688=  INTO :SUMM_VOZVRAT_NAL_,'
      '1102121689=       :SUMM_VOZVRAT_BEZNAL_;'
      '1102121690='
      
        '1102121691=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0) - COAL' +
        'ESCE(SUMM_VOZVRAT_NAL_, 0);'
      
        '1102121692=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0) ' +
        '- COALESCE(SUMM_VOZVRAT_BEZNAL_, 0);'
      '1102121693=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '1102121694='
      '1102121695=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '1102121696='
      
        '1102121697=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS ' +
        'VARCHAR(100)), '#39'.'#39', '#39','#39');'
      
        '1102121698=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds' +
        '_summ_all_;'
      '1102121699='
      '1102121700=/*  insert into p_rep_profit_table'
      
        '1102121701=    (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '1102121702=  values'
      
        '1102121703=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1056#1077#1072#1083#1100#1085#1086' '#1086#1087#1083#1072#1095 +
        #1077#1085#1086#39', :SUM_FACT_ALL_, :SUM_COST_ALL_, :NDS_SUMM_ALL_, :SUM_FACT_' +
        'ALL_-:SUM_COST_ALL_, 3);'
      '1102121704='
      '1102121705=  insert into p_rep_profit_table'
      '1102121706=    (p_rep_profit_table, tovar_name, summ, is_head)'
      '1102121707=  values'
      
        '1102121708=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#1041#1086#1085#1091#1089#1072#1084#1080' '#1086#1087#1083#1072 +
        #1095#1077#1085#1086#39', :SUM_PAY_BONUS_ALL_, 3);*/'
      '1102121709='
      '1102121710=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '1102121711=    SELECT G.NAME'
      '1102121712=      FROM G_CLIENT G'
      '1102121713=     WHERE G.G_CLIENT = :G_CLIENT_'
      '1102121714=    INTO :CLIENT_NAME_;'
      '1102121715=  ELSE'
      '1102121716=    CLIENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102121717='
      '1102121718=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '1102121719=    SELECT G.NAME'
      '1102121720=      FROM G_PAYMENT_TYPE G'
      '1102121721=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '1102121722=    INTO :PAYMENT_NAME_;'
      '1102121723=  ELSE'
      '1102121724=    PAYMENT_NAME_ = '#39#1042#1089#1077#39';'
      '1102121725='
      '1102121726=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '1102121727=        P.ZAKAZ,'
      '1102121728=        P.G_TOCHKA,'
      '1102121729=        P.Z_DATE,'
      '1102121730=        P.G_CLIENT,'
      '1102121731=        P.CLIENT_NAME,'
      '1102121732=        P.G_PAYMENT_TYPE,'
      '1102121733=        P.PAYMENT_NAME,'
      '1102121734=        P.OSNOVANIE,'
      '1102121735=        P.G_PRODUCT,'
      '1102121736=        P.G_PRODUCT_PAR,'
      '1102121737=        P.TOVAR_NAME,'
      '1102121738=        G.ARTICUL,'
      '1102121739=        G.NOMENCLATUR_NUM,'
      '1102121740=        G.BARCODE,'
      '1102121741=        P.AMOUNT,'
      
        '1102121742=        P.PRICE,--REPLACE(CAST(PRICE AS VARCHAR(100))' +
        ', '#39'.'#39', '#39','#39'),'
      
        '1102121743=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), ' +
        #39'.'#39', '#39','#39'),'
      
        '1102121744=        P.DISCOUNT_PERC,--REPLACE(CAST(DISCOUNT_PERC ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102121745=        P.DISCOUNT_SUMM,--REPLACE(CAST(DISCOUNT_SUMM ' +
        'AS VARCHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102121746=        P.NDS,--REPLACE(CAST(NDS AS VARCHAR(100)), '#39'.' +
        #39', '#39','#39'),'
      
        '1102121747=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102121748=        P.PRICE_SELF,--REPLACE(CAST(PRICE_SELF AS VAR' +
        'CHAR(100)), '#39'.'#39', '#39','#39'),'
      
        '1102121749=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR' +
        '(100)), '#39'.'#39', '#39','#39'),'
      
        '1102121750=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100' +
        ')), '#39'.'#39', '#39','#39'),'
      '1102121751=        P.IS_HEAD'
      
        '1102121752=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODU' +
        'CT G ON P.G_PRODUCT = G.G_PRODUCT'
      '1102121753=    ORDER BY 1'
      '1102121754=  INTO :P_REP_PROFIT_TABLE,'
      '1102121755=       :ZAKAZ,'
      '1102121756=       :G_TOCHKA,'
      '1102121757=       :Z_DATE,'
      '1102121758=       :G_CLIENT,'
      '1102121759=       :CLIENT_NAME,'
      '1102121760=       :G_PAYMENT_TYPE,'
      '1102121761=       :PAYMENT_NAME,'
      '1102121762=       :OSNOVANIE,'
      '1102121763=       :G_PRODUCT,'
      '1102121764=       :G_PRODUCT_PAR,'
      '1102121765=       :TOVAR_NAME,'
      '1102121766=       :ARTICUL,'
      '1102121767=       :NOMENCLATUR_NUM,'
      '1102121768=       :BARCODE,'
      '1102121769=       :AMOUNT,'
      '1102121770=       :PRICE,'
      '1102121771=       :SUMM,'
      '1102121772=       :DISCOUNT_PERC,'
      '1102121773=       :DISCOUNT_SUMM,'
      '1102121774=       :NDS,'
      '1102121775=       :NDS_SUMM,'
      '1102121776=       :PRICE_SELF,'
      '1102121777=       :SUM_SELF,'
      '1102121778=       :PROFIT,'
      '1102121779=       :IS_HEAD'
      '1102121780=  DO'
      '1102121781=    suspend;'
      '1102121782='
      '1102121783=WHEN ANY DO BEGIN'
      '1102121784=    Err_code = -20500;'
      
        '1102121785=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1102121786=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102121787=  END'
      '1102121788=end'
      '1102121789=;'
      '1102121790='
      '1102121791=ALTER PROCEDURE P_REP_Z('
      '1102121792=  DATE_ DATE,'
      '1102121793=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1102121794=RETURNS ('
      '1102121795=  STR VARCHAR(100),'
      '1102121796=  AMOUNT VARCHAR(100),'
      '1102121797=  SUMM VARCHAR(100))'
      '1102121798=AS'
      '1102121799=/*'
      
        '1102121800=Z-'#1054#1058#1063#1045#1058' '#1055#1054' '#1042#1057#1045#1052' '#1044#1042#1048#1046#1045#1053#1048#1071#1052' '#1047#1040' '#1055#1045#1056#1048#1054#1044' - '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053 +
        #1048#1071', '#1042#1054#1047#1042#1056#1040#1058#1067' '#1048' '#1058#1044', '#1042#1057#1045' '#1063#1058#1054' '#1050#1040#1057#1040#1045#1058#1057#1071' '#1050#1040#1057#1057#1067' '#1042' '#1054#1041#1065#1045#1052
      '1102121801='#1053#1054' '#1057#1054#1050#1056#1040#1065#1045#1053#1053#1054', '#1058#1048#1055#1040':'
      '1102121802='#1054#1057#1058#1040#1058#1054#1050' '#1053#1040' '#1053#1040#1063#1040#1051#1054' 5000'
      '1102121803='#1055#1056#1054#1044#1040#1046#1040'   *4    = 48990'
      '1102121804='#1042#1054#1047#1042#1056#1040#1058'   *0    = 0'
      '1102121805='#1042#1053#1045#1057#1045#1053#1048#1045'  *0    = 0'
      '1102121806='#1048#1047#1066#1071#1058#1048#1045'   *0    = 0'
      '1102121807='#1057#1059#1052#1052#1040' '#1042' '#1050#1040#1057#1057#1045'   = 538990'
      '1102121808=*/'
      '1102121809=DECLARE VARIABLE COL INTEGER;'
      '1102121810=DECLARE VARIABLE IN_SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1102121811=DECLARE VARIABLE PRODAZHI_CASH_SUMM_ TYPE OF COLUMN K' +
        'ASSA.SUMM;'
      
        '1102121812=DECLARE VARIABLE PRODAZHI_CASH_AMOUNT_ TYPE OF COLUMN' +
        ' KASSA.SUMM;'
      
        '1102121813=DECLARE VARIABLE PRODAZHI_NONCASH_SUMM_ TYPE OF COLUM' +
        'N KASSA.SUMM;'
      
        '1102121814=DECLARE VARIABLE PRODAZHI_NONCASH_AMOUNT_ TYPE OF COL' +
        'UMN KASSA.SUMM;'
      
        '1102121815=DECLARE VARIABLE VOZVRAT_CASH_SUMM_ TYPE OF COLUMN KA' +
        'SSA.SUMM;'
      
        '1102121816=DECLARE VARIABLE VOZVRAT_CASH_AMOUNT_ TYPE OF COLUMN ' +
        'KASSA.SUMM;'
      
        '1102121817=DECLARE VARIABLE VOZVRAT_NONCASH_SUMM_ TYPE OF COLUMN' +
        ' KASSA.SUMM;'
      
        '1102121818=DECLARE VARIABLE VOZVRAT_NONCASH_AMOUNT_ TYPE OF COLU' +
        'MN KASSA.SUMM;'
      
        '1102121819=DECLARE VARIABLE VNESENIE_AMOUNT_ TYPE OF COLUMN KASS' +
        'A.SUMM;'
      
        '1102121820=DECLARE VARIABLE VNESENIE_SUMM_ TYPE OF COLUMN KASSA.' +
        'SUMM;'
      
        '1102121821=DECLARE VARIABLE IZYATIE_AMOUNT_ TYPE OF COLUMN KASSA' +
        '.SUMM;'
      
        '1102121822=DECLARE VARIABLE IZYATIE_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      '1102121823=DECLARE VARIABLE OUT_SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '1102121824=BEGIN'
      '1102121825='
      '1102121826=  IF (DATE_ IS NULL) THEN'
      '1102121827=    DATE_ = CURRENT_DATE;'
      '1102121828='
      '1102121829=  IF (G_TOCHKA_ IS NULL) THEN'
      '1102121830=    SELECT ID'
      '1102121831=      FROM CUR_PARAMS'
      '1102121832=     WHERE CUR_PARAMS = 2'
      '1102121833=      INTO :G_TOCHKA_;'
      '1102121834='
      '1102121835=  SELECT S."INPUT"'
      '1102121836=    FROM kassa_state S'
      '1102121837=   WHERE S.k_date = :DATE_'
      '1102121838=     AND S.g_tochka = :G_TOCHKA_'
      '1102121839=    INTO :IN_SUMM_;'
      '1102121840='
      '1102121841=  IF (ROW_COUNT = 0) THEN'
      '1102121842=    SELECT S."OUTPUT"'
      '1102121843=      FROM kassa_state S'
      '1102121844=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102121845=                         FROM KASSA_STATE ST'
      '1102121846=                        WHERE ST.k_date < :DATE_'
      
        '1102121847=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1102121848=      AND S.g_tochka = :G_TOCHKA_'
      '1102121849=      INTO :IN_SUMM_;'
      '1102121850='
      '1102121851=  IN_SUMM_ = COALESCE(IN_SUMM_, 0);'
      '1102121852='
      '1102121853=  SELECT S."OUTPUT"'
      '1102121854=    FROM kassa_state S'
      '1102121855=   WHERE S.k_date = :DATE_'
      '1102121856=     AND S.g_tochka = :G_TOCHKA_'
      '1102121857=    INTO :OUT_SUMM_;'
      '1102121858='
      '1102121859=  IF (ROW_COUNT = 0) THEN'
      '1102121860=    SELECT S."OUTPUT"'
      '1102121861=      FROM kassa_state S'
      '1102121862=     WHERE S.k_date = (SELECT MAX(ST.k_date)'
      '1102121863=                         FROM KASSA_STATE ST'
      '1102121864=                        WHERE ST.k_date < :DATE_'
      
        '1102121865=                         AND ST.g_tochka = :G_TOCHKA_' +
        ')'
      '1102121866=      AND S.g_tochka = :G_TOCHKA_'
      '1102121867=      INTO :OUT_SUMM_;'
      '1102121868='
      '1102121869=  OUT_SUMM_ = COALESCE(OUT_SUMM_, 0);'
      '1102121870='
      '1102121871=  -- '#1055#1056#1054#1044#1040#1046#1040' '#1053#1040#1051
      '1102121872=  SELECT COUNT(Z.ZAKAZ),'
      '1102121873=         SUM(K.SUMM)'
      '1102121874=    FROM ZAKAZ Z,'
      '1102121875=         KASSA K'
      '1102121876=   WHERE Z.is_spisanie in (0, 2)'
      '1102121877=     AND Z.Z_DATE = :DATE_'
      '1102121878=     AND Z.G_TOCHKA = :G_TOCHKA_'
      '1102121879=     AND K.ZAKAZ = Z.ZAKAZ'
      '1102121880=    INTO :PRODAZHI_CASH_AMOUNT_,'
      '1102121881=         :PRODAZHI_CASH_SUMM_;'
      '1102121882='
      '1102121883=  -- '#1055#1056#1054#1044#1040#1046#1040' '#1041#1045#1047#1053#1040#1051
      '1102121884=  SELECT COUNT(Z.ZAKAZ),'
      '1102121885=         SUM(K.SUMM)'
      '1102121886=    FROM ZAKAZ Z,'
      '1102121887=         KASSA_BEZNAL K'
      '1102121888=   WHERE Z.is_spisanie in (0, 2)'
      '1102121889=     AND Z.Z_DATE = :DATE_'
      '1102121890=     AND Z.G_TOCHKA = :G_TOCHKA_'
      '1102121891=     AND K.ZAKAZ = Z.ZAKAZ'
      '1102121892=    INTO :PRODAZHI_NONCASH_AMOUNT_,'
      '1102121893=         :PRODAZHI_NONCASH_SUMM_;'
      '1102121894='
      '1102121895=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1053#1040#1051
      '1102121896=  SELECT COUNT(SP.SKLAD),'
      '1102121897=         SUM(K.SUMM)'
      '1102121898=    FROM SKLAD_PARENT SP,'
      '1102121899=         KASSA K'
      '1102121900=   WHERE SP.IS_VOZVRAT = 1'
      '1102121901=     AND SP.DATE_RECEIPT = :DATE_'
      '1102121902=     AND SP.G_TOCHKA = :G_TOCHKA_'
      '1102121903=     AND K.SKLAD = SP.SKLAD'
      '1102121904=    INTO :VOZVRAT_CASH_AMOUNT_,'
      '1102121905=         :VOZVRAT_CASH_SUMM_;'
      '1102121906='
      '1102121907=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1041#1045#1047#1053#1040#1051
      '1102121908=  SELECT COUNT(SP.SKLAD),'
      '1102121909=         SUM(K.SUMM)'
      '1102121910=    FROM SKLAD_PARENT SP,'
      '1102121911=         KASSA_BEZNAL K'
      '1102121912=   WHERE SP.IS_VOZVRAT = 1'
      '1102121913=     AND SP.DATE_RECEIPT = :DATE_'
      '1102121914=     AND SP.G_TOCHKA = :G_TOCHKA_'
      '1102121915=     AND K.SKLAD = SP.SKLAD'
      '1102121916=    INTO :VOZVRAT_NONCASH_AMOUNT_,'
      '1102121917=         :VOZVRAT_NONCASH_SUMM_;'
      '1102121918='
      '1102121919=  -- '#1042#1053#1045#1057#1045#1053#1048#1045
      '1102121920=  SELECT COUNT(S.KASSA),'
      '1102121921=         SUM(S.SUMM)'
      '1102121922=    FROM KASSA S,'
      '1102121923=         G_PRIHOD_RASHOD D'
      '1102121924=   WHERE S.ACTION_DATE = :DATE_'
      '1102121925=     AND S.G_PRIHOD_RASHOD = D.G_PRIHOD_RASHOD'
      '1102121926=     AND D.DO_ACTION = 0'
      '1102121927=     AND D.G_PRIHOD_RASHOD <> 1'
      '1102121928=    INTO :VNESENIE_AMOUNT_,'
      '1102121929=         :VNESENIE_SUMM_;'
      '1102121930='
      '1102121931=  -- '#1048#1047#1066#1071#1058#1048#1045
      '1102121932=  SELECT COUNT(S.KASSA),'
      '1102121933=         SUM(S.SUMM)'
      '1102121934=    FROM KASSA S,'
      '1102121935=         G_PRIHOD_RASHOD D'
      '1102121936=   WHERE S.ACTION_DATE = :DATE_'
      '1102121937=     AND S.G_PRIHOD_RASHOD = D.G_PRIHOD_RASHOD'
      '1102121938=     AND D.DO_ACTION = 1'
      
        '1102121939=     AND D.G_PRIHOD_RASHOD <> 3 -- NOT IN (2,3) 21.11' +
        '.2021 '#1057#1055#1056#1040#1042#1045#1044#1051#1048#1042#1054' '#1063#1058#1054' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1046#1045' '#1053#1040#1044#1054' '#1058#1059#1058' '#1059#1063#1048#1058#1067#1042#1040#1058#1068', '#1042#1045#1044#1068' '#1057' '#1050#1040#1057 +
        #1057#1067' '#1041#1045#1056#1045#1058#1057#1071' '#1056#1040#1057#1061#1054#1044' '#1053#1040' '#1047#1040#1050#1059#1055#1050#1059
      '1102121940=    INTO :IZYATIE_AMOUNT_,'
      '1102121941=         :IZYATIE_SUMM_;'
      '1102121942='
      '1102121943=  IN_SUMM_                  = COALESCE(IN_SUMM_, 0);'
      
        '1102121944=  PRODAZHI_CASH_SUMM_       = COALESCE(PRODAZHI_CASH_' +
        'SUMM_, 0);'
      
        '1102121945=  PRODAZHI_CASH_AMOUNT_     = COALESCE(PRODAZHI_CASH_' +
        'AMOUNT_, 0);'
      
        '1102121946=  PRODAZHI_NONCASH_SUMM_    = COALESCE(PRODAZHI_NONCA' +
        'SH_SUMM_, 0);'
      
        '1102121947=  PRODAZHI_NONCASH_AMOUNT_  = COALESCE(PRODAZHI_NONCA' +
        'SH_AMOUNT_, 0);'
      
        '1102121948=  VOZVRAT_CASH_SUMM_        = COALESCE(VOZVRAT_CASH_S' +
        'UMM_, 0);'
      
        '1102121949=  VOZVRAT_CASH_AMOUNT_      = COALESCE(VOZVRAT_CASH_A' +
        'MOUNT_, 0);'
      
        '1102121950=  VOZVRAT_NONCASH_SUMM_     = COALESCE(VOZVRAT_NONCAS' +
