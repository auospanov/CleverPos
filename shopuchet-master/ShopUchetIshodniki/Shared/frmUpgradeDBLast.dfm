      '1102491125='
      
        '1102491126=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1102491127=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1102491128=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1102491129=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1102491130=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1102491131=          UPDATE G_DISCONT_CARD D'
      
        '1102491132=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1102491133=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1102491134=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1102491135=          RETURNING'
      '1102491136=            D.SUMM_ALL'
      '1102491137=          INTO'
      '1102491138=            :CLIENT_SUMM_ALL_;'
      '1102491139='
      '1102491140=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1102491141=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1102491142=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1102491143=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1102491144=          ORDER BY G.SUMM_FROM'
      '1102491145=          ROWS 1 TO 1'
      '1102491146=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1102491147='
      '1102491148=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1102491149=            UPDATE G_CLIENT G'
      '1102491150=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1102491151=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1102491152=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1102491153='
      '1102491154=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1102491155=            UPDATE G_DISCONT_CARD D'
      '1102491156=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1102491157=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1102491158=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1102491159=      END'
      '1102491160='
      
        '1102491161=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' ' +
        #1057' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', ' +
        #1050#1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '1102491162=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057 +
        #1051#1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102491163=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102491164=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102491165=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102491166=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1102491167=      PNT_ = '#39'07'#39';'
      
        '1102491168=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THE' +
        'N BEGIN'
      '1102491169=        SELECT S.S_VALUE'
      '1102491170=          FROM SYSTEM_SETUP S'
      '1102491171=         WHERE S.SYSTEM_SETUP = 4'
      '1102491172=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102491173='
      '1102491174=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102491175=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102491176=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102491177='
      
        '1102491178=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1102491179=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1102491180=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1102491181='
      '1102491182=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102491183=        ELSE'
      
        '1102491184=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1102491185='
      '1102491186=        KASSA_ZP_ID_ = NULL;'
      '1102491187=        SELECT K.KASSA, K.SUMM'
      '1102491188=        FROM KASSA K'
      '1102491189=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1102491190=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102491191=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102491192=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102491193=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1102491194='
      
        '1102491195=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1102491196='
      '1102491197=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102491198=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102491199=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102491200=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1102491201=                                          :ACTION_DAT' +
        'E_ZP_,'
      
