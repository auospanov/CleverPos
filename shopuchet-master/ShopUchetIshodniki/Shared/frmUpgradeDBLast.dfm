      '110202957=/*'
      '110202958='#1060#1048#1053#1040#1051' 07.02.2019'
      '110202959=*/'
      
        '110202960=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_DOWNLOAD' +
        #39';'
      '110202961=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110202962=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '110202963=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
