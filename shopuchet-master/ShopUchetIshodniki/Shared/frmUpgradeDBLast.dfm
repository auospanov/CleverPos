      '110221689=                  ,0 SUMM_CASH'
      '110221690=                  ,0 SUMM_NONCASH'
      '110221691=                  ,0 SUMM_BONUS'
      '110221692=                  ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110221693=                  ,'#39#39' ARTICUL'
      '110221694=                  ,'#39#39' BARCODE'
      '110221695=                  ,'#39#39' NOMENCLATUR_NUM'
      '110221696=                  ,G.NAME'
      '110221697=                  ,0 AMOUNT'
      '110221698=                  ,0 PRICE'
      '110221699=                  ,0 SUMM'
      '110221700=                  ,S.SYNC_EXT_APP'
      '110221701=                  ,'#39#39' OSNOVANIE'
      '110221702=                  ,'#39#39' NOTE'
      '110221703=                  ,NULL PARENT_ID'
      '110221704=                  ,NULL IS_CATEGORY'
      '110221705=                  ,NULL G_TOCHKA'
      '110221706=                  ,NULL RTYPE'
      '110221707=                  ,NULL ITEM_ID'
      '110221708=                  ,NULL G_PRODUCT'
      '110221709=                  ,NULL COST_PRICE'
      '110221710=             FROM SYNC_EXT_APP S'
      '110221711=                  ,G_TOCHKA G'
      '110221712=            WHERE S.IS_LOADING = 1'
      
        '110221713=              AND ((S.IS_LOADED = 0 AND :LOAD_TYPE_ = ' +
        '0) OR (S.IS_LOADED_MOB = 0 AND :LOAD_TYPE_ = 1))'
      '110221714=              AND S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110221715=              AND S.OBJECT_TYPE = 3'
      '110221716=              AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110221717=              AND :OPER_ <> 3'
      '110221718=              AND S.ID = G.G_TOCHKA'
      '110221719=            UNION ALL'
      '110221720=            SELECT S.OPER'
      '110221721=                   ,S.ID'
      '110221722=                   ,NULL Z_DATE'
      '110221723=                   ,NULL Z_TIME'
      '110221724=                   ,NULL ID'
      '110221725=                   ,NULL IDN'
      '110221726=                   ,NULL CLIENT_NAME'
      '110221727=                   ,NULL SKLAD_NAME'
      '110221728=                   ,0 SUMM_ALL'
      '110221729=                   ,0 SUMM_CASH'
      '110221730=                   ,0 SUMM_NONCASH'
      '110221731=                   ,0 SUMM_BONUS'
      '110221732=                   ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110221733=                   ,NULL ARTICUL'
      '110221734=                   ,NULL BARCODE'
      '110221735=                   ,NULL NOMENCLATUR_NUM'
      '110221736=                   ,NULL'
      '110221737=                   ,0 AMOUNT'
      '110221738=                   ,0 PRICE'
      '110221739=                   ,0 SUMM'
