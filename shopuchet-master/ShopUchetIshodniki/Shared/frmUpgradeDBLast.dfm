        #1055#1056#1054#1044#1040#1046#1048'?'
      
        '110240780=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045' ' +
        #1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '110240781=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '110240782=      PNT_ = '#39'07'#39';'
      
        '110240783=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN' +
        ' BEGIN'
      '110240784=        SELECT S.S_VALUE'
      '110240785=          FROM SYSTEM_SETUP S'
      '110240786=         WHERE S.SYSTEM_SETUP = 4'
      '110240787=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '110240788='
      '110240789=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '110240790=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '110240791=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '110240792='
      
        '110240793=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059' ' +
        #1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '110240794=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '110240795=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECODE' +
        '(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM ' +
        'CURRENT_DATE)));'
      '110240796='
      '110240797=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '110240798=        ELSE'
      
