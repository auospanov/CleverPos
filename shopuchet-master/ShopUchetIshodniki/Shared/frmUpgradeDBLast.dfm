        '110751446=            INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRA' +
        'NSFERED, SYSDATE, ERR_CODE)'
      
        '110751447=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39 +
        'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751448=      END'
      '110751449=    END'
      '110751450=    ELSE BEGIN'
      
        '110751451=        -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048 +
        #1058#1068' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110751452=        IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SY' +
        'STEM_SETUP = 5) > 0) THEN BEGIN'
      
        '110751453=            SQL_STMT_ ='#39'UPDATE KASSA_BEZNAL_STATE K '#39'|' +
        '|'
      
        '110751454=                         '#39'SET K.DEBET = COALESCE(K.DEB' +
        'ET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39', '#39'||'
      
        '110751455=                            '#39'K.CREDIT = COALESCE(K.CRE' +
        'DIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39', '#39'||'
      
        '110751456=                            '#39'K.OUTPUT = COALESCE(K.INP' +
        'UT, 0) - (COALESCE(K.DEBET, 0) + '#39'||COALESCE(:DEBET_, 0)||'#39') + (' +
        'COALESCE(K.CREDIT, 0) + '#39'||COALESCE(:CREDIT_, 0)||'#39') '#39'||'
      
        '110751457=                       '#39'WHERE K.K_DATE = '#39#39#39'||:ACTION_' +
        'DATE_||'#39#39#39';'#39';'
      
        '110751458=            INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRA' +
        'NSFERED, SYSDATE, ERR_CODE)'
      
        '110751459=            VALUES (GEN_ID(GEN_LOGS, 1), :SQL_STMT_, '#39 +
        'SYSDBA'#39', 0, CURRENT_TIMESTAMP, :ERR_CODE);'
      '110751460=        END'
      '110751461=    END'
      '110751462=  END'
      '110751463=END'
      '110751464=;'
      '110751465='
      '110751466=ALTER PROCEDURE LOG_INIT'
      '110751467=AS'
      '110751468=DECLARE VARIABLE TN VARCHAR(64);'
      '110751469=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110751470=DECLARE VARIABLE FN VARCHAR(64);'
      '110751471=DECLARE VARIABLE TP INTEGER;'
      
        '110751472=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110751473=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110751474=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110751475=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110751476=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110751477=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110751478=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110751479=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000) */'
      '110751480=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110751481=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110751482=DECLARE VARIABLE ANZ INTEGER;'
      '110751483=DECLARE VARIABLE L INTEGER;'
      '110751484=DECLARE VARIABLE P INTEGER;'
      '110751485=DECLARE VARIABLE S INTEGER;'
      '110751486=DECLARE VARIABLE FT CHAR(1);'
      '110751487=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110751488=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110751489=BEGIN'
      '110751490=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110751491='
      '110751492=  TN_ALT='#39#39';'
      '110751493=  TRGI='#39#39';'
      '110751494=  TRGU='#39#39';'
      '110751495=  TRGD='#39#39';'
      '110751496=  TRGIX='#39#39';'
      '110751497=  TRGUX='#39#39';'
      '110751498=  TRGDX='#39#39';'
      '110751499=  SQLF='#39#39';'
      '110751500=  SQLV='#39#39';'
      '110751501=  SQLU='#39#39';'
      '110751502=  FT='#39#39';'
      '110751503='
      '110751504=  FOR SELECT R.RDB$RELATION_NAME,'
      '110751505=            R.RDB$FIELD_NAME,'
      '110751506=            F.RDB$FIELD_TYPE,'
      '110751507=            F.RDB$FIELD_LENGTH,'
      '110751508=            F.RDB$FIELD_PRECISION,'
      '110751509=            F.RDB$FIELD_SCALE'
      '110751510=        FROM RDB$RELATION_FIELDS R,'
      '110751511=             RDB$FIELDS F'
      '110751512=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110751513=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110751514=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110751515=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110751516=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110751517=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110751518=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110751519=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110751520=                                         '#39'REVISION'#39', '#39 +
        'RIGHTS_ITEM'#39', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110751521=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110751522=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39')'
      '110751523=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110751524=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110751525=              OR'
      
        '110751526=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110751527=             )'
      
        '110751528=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110751529=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110751530=  DO BEGIN'
      '110751531=    TN=TRIM(TN);'
      '110751532=    FN=TRIM(FN);'
      '110751533='
      '110751534=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110751535=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110751536=      EXECUTE STATEMENT TRGI;'
      '110751537=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110751538=      EXECUTE STATEMENT TRGU;'
      '110751539=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110751540=      EXECUTE STATEMENT TRGD;'
      '110751541='
      '110751542=      SQLF='#39#39';'
      '110751543=      SQLV='#39#39';'
      '110751544=      SQLU='#39#39';'
      '110751545=    END'
      '110751546='
      '110751547=    IF (TN_ALT <> TN OR TN_ALT = '#39#39') THEN'
      '110751548=      ID_COLUMN = FN;'
      '110751549='
      '110751550=    S=-S;'
      
        '110751551=    if ((tp=7) or (tp=8) or (tp=10) or (tp=16) or (tp=' +
        '27)) then'
      '110751552=      ft='#39'N'#39';   --numerisch'
      '110751553=    else'
      '110751554=      if ((tp=12) or (tp=13) or (tp=35)) then'
      '110751555=        ft='#39'Z'#39';   --zeit'
      '110751556=      else'
      '110751557=        ft='#39'T'#39';'
      '110751558='
      '110751559='
      '110751560=    IF (SQLF='#39#39') THEN'
      '110751561=      SQLF='#39'INSERT INTO '#39'||TN||'#39'('#39'||FN;'
      '110751562=    ELSE'
      '110751563=      SQLF=SQLF||'#39','#39'||FN;'
      '110751564='
      '110751565=    if (ft='#39'N'#39') then begin'
      '110751566=      IF (SQLV='#39#39') THEN'
      
        '110751567=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110751568=      ELSE'
      
        '110751569=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39'||NEW.'#39'||F' +
        'N||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110751570='
      '110751571=      IF (SQLU='#39#39') THEN'
      
        '110751572=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110751573=      ELSE'
      
        '110751574=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39'||NEW.'#39'||FN||'#39'||'#39#39#39#39';'#39'||CRLF;'
      '110751575=    end'
      '110751576=    else'
      '110751577=      if (ft='#39'Z'#39') then begin'
      '110751578=        IF (SQLV='#39#39') THEN'
      
        '110751579=          SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110751580=        ELSE'
      
        '110751581=          SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||re' +
        'place(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39 +
        #39#39#39#39';'#39'||CRLF;'
      '110751582='
      '110751583=        IF (SQLU='#39#39') THEN'
      
        '110751584=          SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'U' +
        'PDATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||' +
        'FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),'#39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110751585=        ELSE'
      
        '110751586=          SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN' +
        ' SQLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39 +
        '||FN||'#39'='#39#39#39#39#39#39'||replace(replace(TRIM(NEW.'#39'||FN||'#39'),'#39#39' '#39#39','#39#39'-'#39#39'),' +
        #39#39':'#39#39','#39#39'.'#39#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110751587=    end'
      '110751588=    else begin'
      '110751589=      IF (SQLV='#39#39') THEN'
      
        '110751590=        SQLV=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39' NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39' '#39#39#39#39#39#39'||TRIM' +
        '(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110751591=      ELSE'
      
        '110751592=        SQLV=SQLV||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39',NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39#39#39#39#39#39'||TRIM' +
        '(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110751593='
      '110751594=      IF (SQLU='#39#39') THEN'
      
        '110751595=        SQLU=      '#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT='#39#39'UPDATE '#39'||TN||'#39' SET '#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT='#39#39'UPD' +
        'ATE '#39'||TN||'#39' SET '#39'||FN||'#39'='#39#39#39#39#39#39'||TRIM(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39 +
        '||CRLF;'
      '110751596=      ELSE'
      
        '110751597=        SQLU=SQLU||'#39'  IF (NEW.'#39'||FN||'#39' IS NULL) THEN S' +
        'QLSTMT=SQLSTMT||'#39#39','#39'||FN||'#39'=NULL'#39#39';ELSE  SQLSTMT=SQLSTMT||'#39#39','#39'||' +
        'FN||'#39'='#39#39#39#39#39#39'||TRIM(NEW.'#39'||FN||'#39')||'#39#39#39#39#39#39#39#39';'#39'||CRLF;'
      '110751598=    end'
      '110751599='
      '110751600=    SELECT COUNT(*)'
      '110751601=      FROM RDB$TRIGGERS'
      '110751602=     WHERE RDB$TRIGGER_NAME=:TN||'#39'_LOGI'#39
      '110751603=      INTO :ANZ;'
      '110751604='
      '110751605=    IF (ANZ>0) THEN'
      '110751606=      TRGIX='#39'DROP TRIGGER '#39'||TN||'#39'_LOGI'#39';'
      '110751607=    ELSE'
      '110751608=      TRGIX='#39#39';'
      '110751609='
      
        '110751610=    TRGI='#39'CREATE TRIGGER '#39'||TN||'#39'_LOGI FOR '#39'||TN||'#39' AC' +
        'TIVE AFTER INSERT POSITION 255 AS '#39'||CRLF||'
      
        '110751611=         '#39'DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEG' +
        'MENT SIZE 80;'#39'||CRLF||'
      '110751612=         '#39'DECLARE VARIABLE ID BIGINT;'#39'||CRLF||'
      '110751613=         '#39'BEGIN'#39'||CRLF||'
      
        '110751614=         '#39'  IF (RDB$GET_CONTEXT ('#39#39'USER_SESSION'#39#39', '#39#39'R' +
        'EPLICAT'#39#39') IS NOT NULL) THEN EXIT;'#39' ||CRLF;'
      '110751615='
      '110751616=    IF (TN = '#39'KASSA_STATE'#39') THEN BEGIN'
      '110751617=      TRGI = TRGI||'
      '110751618=         '#39'  SQLSTMT='#39#39#39'||'#39'MERGE INTO KASSA_STATE c '#39'||'
      
        '110751619=                           '#39'USING (select CAST('#39#39#39#39#39#39'|' +
        '|NEW.K_DATE ||'#39#39#39#39#39#39' AS DATE) as K_DATE, '#39#39'||NEW.G_TOCHKA||'#39#39' AS' +
        ' G_TOCHKA '#39'||'
      '110751620=                           '#39' from RDB$DATABASE) cd '#39'||'
      
        '110751621=                           '#39'ON (c.K_DATE = cd.K_DATE A' +
        'ND C.G_TOCHKA = CD.G_TOCHKA) '#39'||'
      '110751622=                           '#39'WHEN MATCHED THEN '#39'||'
      '110751623=                           '#39' UPDATE SET '#39'||'
      
        '110751624=                           '#39'  C.INPUT  = COALESCE((SEL' +
        'ECT "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE)' +
        ' '#39'||'
      
        '110751625=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110751626=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751627=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0), '#39'||'
      
        '110751628=                           '#39'  C.DEBET  = C.DEBET + '#39#39'|' +
        '|NEW.DEBET||'#39#39', '#39'||'
      
        '110751629=                           '#39'  C.CREDIT = C.CREDIT + '#39#39 +
        '||NEW.CREDIT||'#39#39', '#39'||'
      
        '110751630=                           '#39'  C.OUTPUT = COALESCE((SEL' +
        'ECT "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE)' +
        ' '#39'||'
      
        '110751631=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110751632=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751633=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0) - (C.DEBET + '#39#39'||NEW.DEBET||'#39#39') + (C.CREDIT + '#39#39 +
        '||NEW.CREDIT||'#39#39') '#39'||'
      '110751634=                           '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110751635=                           '#39' INSERT (KASSA_STATE, K_DA' +
        'TE, "INPUT", DEBET, CREDIT, "OUTPUT", G_TOCHKA) '#39'||'
      
        '110751636=                           '#39' VALUES ('#39#39'||NEW.KASSA_STA' +
        'TE||'#39#39', '#39#39#39#39#39#39'||NEW.K_DATE||'#39#39#39#39#39#39', COALESCE((SELECT "OUTPUT" FR' +
        'OM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_DATE) '#39'||'
      
        '110751637=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110751638=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751639=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0), '#39#39'||NEW.DEBET||'#39#39', '#39#39'||NEW.CREDIT||'#39#39', COALESCE' +
        '((SELECT "OUTPUT" FROM KASSA_STATE WHERE K_DATE = (SELECT MAX(K_' +
        'DATE) '#39'||'
      
        '110751640=                                                      ' +
        '                                              '#39' FROM KASSA_STATE' +
        ' '#39'||'
      
        '110751641=                                                      ' +
        '                                              '#39' WHERE K_DATE < C' +
        'D.K_DATE AND G_TOCHKA = CD.G_TOCHKA) '#39'||'
      
        '110751642=                                                      ' +
        '                                              '#39' AND G_TOCHKA = C' +
        'D.G_TOCHKA), 0) - '#39#39'||NEW.DEBET||'#39#39' + '#39#39'||NEW.CREDIT||'#39#39', '#39#39'||NE' +
        'W.G_TOCHKA||'#39#39');'#39#39';'#39'||CRLF;'
      '110751643=    END ELSE IF (TN = '#39'KASSA_BEZNAL_STATE'#39') THEN BEGIN'
      '110751644=      TRGI = TRGI||'
      
        '110751645=         '#39'  SQLSTMT='#39#39#39'||'#39'MERGE INTO KASSA_BEZNAL_STAT' +
        'E c '#39'||'
      
        '110751646=                           '#39'USING (select CAST('#39#39#39#39#39#39'|' +
        '|NEW.K_DATE ||'#39#39#39#39#39#39' AS DATE) as K_DATE '#39'||'
      '110751647=                           '#39' from RDB$DATABASE) cd '#39'||'
      
