      '1101322798='
      
        '1101322799=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101322800=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053 +
        #1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101322801=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101322802=                      PNT_ = '#39'011'#39';'
      
        '1101322803=                      EXECUTE PROCEDURE K_DEL_KASSA(:' +
        'KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MS' +
        'G);'
      '1101322804=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322805=                        ERR_MSG = PROCNAME||'#39' -> PNT_' +
        ' '#39'||PNT_||'#39' '#39'||ERR_MSG;'
      '1101322806=                        EXIT;'
      '1101322807=                      END'
      '1101322808='
      
        '1101322809=                      EXECUTE PROCEDURE K_INS_KASSA(1' +
        ',     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101322810=                                                    :' +
        'G_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1101322811=                                                    :' +
        'PAYMENT_SUMM_,'
      
        '1101322812=                                                    :' +
        'PAYMENT_DATE_,'
      
        '1101322813=                                                    N' +
        'ULL,   --NOTE_ => :NOTE_,'
      
        '1101322814=                                                    N' +
        'ULL,   --ZAKAZ_'
      
        '1101322815=                                                    :' +
        'SKLAD_PARENT_,'
      
        '1101322816=                                                    :' +
        'PAYMENT_TYPE_,'
      
        '1101322817=                                                    :' +
        'G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101322818=                END'
      '1101322819=            END'
      '1101322820=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322821=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101322822=              EXIT;'
      '1101322823=            END'
      '1101322824='
      
        '1101322825=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101322826=      END'
      '1101322827='
      
        '1101322828=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101322829=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101322830=            FROM KASSA K'
      '1101322831=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101322832=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1101322833=           UNION'
      '1101322834=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1101322835=            FROM KASSA K'
      '1101322836=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101322837=             AND K.SUMM = 0'
      '1101322838=          UNION'
      '1101322839=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101322840=            FROM KASSA_BEZNAL K'
      '1101322841=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101322842=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1101322843=          UNION'
      '1101322844=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101322845=            FROM KASSA_BEZNAL K'
      '1101322846=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101322847=             AND K.SUMM = 0'
      '1101322848=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101322849=      DO BEGIN'
      '1101322850=        PNT_ = '#39'011A'#39';'
      
        '1101322851=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101322852=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322853=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101322854=          EXIT;'
      '1101322855=        END'
      '1101322856=      END'
      '1101322857=  END'
      '1101322858='
      
        '1101322859=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1101322860=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101322861=    SELECT K.KASSA'
      '1101322862=      FROM KASSA K'
      '1101322863=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101322864=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101322865=      INTO :KASSA_POP_;'
      '1101322866=  ELSE'
      '1101322867=    SELECT K.KASSA_BEZNAL'
      '1101322868=      FROM KASSA_BEZNAL K'
      '1101322869=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101322870=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101322871=       INTO :KASSA_POP_;'
      '1101322872='
      
        '1101322873=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1101322874=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1101322875=      PNT_ = '#39'012'#39';'
      '1101322876=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1101322877=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1101322878=                                          1,     -- A' +
        'CTION_'
      '1101322879=                                          :G_PRIHOD_,'
      
        '1101322880=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101322881=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101322882=                                          NULL,   --N' +
        'OTE_'
      '1101322883=                                          NULL,'
      
        '1101322884=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101322885=                                          :G_PAYMENT_' +
        'TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101322886=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101322887=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101322888=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1101322889=                                          :G_PRIHOD_,'
      
        '1101322890=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101322891=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101322892=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1101322893=                                          NULL,'
      
        '1101322894=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101322895=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101322896=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101322897=      END'
      '1101322898=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322899=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101322900=        EXIT;'
      '1101322901=      END'
      '1101322902='
      
        '1101322903=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101322904=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101322905=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101322906=        PNT_ = '#39'013'#39';'
      
        '1101322907=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101322908=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322909=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101322910=          EXIT;'
      '1101322911=        END'
      '1101322912=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101322913=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1101322914=                                          :G_PRIHOD_,'
      
        '1101322915=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101322916=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101322917=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1101322918=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1101322919=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101322920=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101322921=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101322922=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322923=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101322924=              EXIT;'
      '1101322925=            END'
      '1101322926=        END'
      '1101322927=  END'
      '1101322928='
      '1101322929=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101322930=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THE' +
        'N'
      
        '1101322931=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101322932=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PA' +
        'RENT_, 2);'
      '1101322933=end'
      '1101322934=;'
      '1101322935='
      '1101322936=ALTER PROCEDURE UPD_SKLAD_TMP1('
      '1101322937=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101322938=  OLD_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101322939=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1101322940=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101322941=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101322942=  OLD_PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1101322943=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101322944=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1101322945=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '1101322946=  CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHARGE_' +
        'ROZN_PROC,'
      
        '1101322947=  OLD_CHARGE_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.CHA' +
        'RGE_ROZN_PROC,'
      
        '1101322948=  CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHARGE_O' +
        'PT_PROC,'
      
        '1101322949=  OLD_CHARGE_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.CHAR' +
        'GE_OPT_PROC,'
      '1101322950=  PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN,'
      
        '1101322951=  OLD_PRICE_ROZN_ TYPE OF COLUMN SKLAD_TMP.PRICE_ROZN' +
        ','
      '1101322952=  PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      '1101322953=  OLD_PRICE_OPT_ TYPE OF COLUMN SKLAD_TMP.PRICE_OPT,'
      
        '1101322954=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1101322955=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0)'
      '1101322956=RETURNS ('
      '1101322957=  ERR_CODE INTEGER,'
      '1101322958=  ERR_MSG VARCHAR(1024))'
      '1101322959=AS'
      '1101322960=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1101322961=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101322962=DECLARE VARIABLE LAST_SELF_PRICE_ TYPE OF COLUMN SKLA' +
        'D.PRICE;'
      '1101322963=BEGIN'
      
        '1101322964=  -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1048#1051#1057#1071' '#1058#1054#1042#1040#1056', '#1058#1054' '#1053#1040#1044#1054' '#1053#1040#1049#1058#1048' '#1057#1053#1054#1042#1040' '#1045#1043#1054' '#1047#1040 +
        #1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048' '#1048' '#1062#1045#1053#1059' '#1054#1055#1058
      '1101322965=  PNT_ = '#39'01'#39';'
      '1101322966=  IF (G_PRODUCT_ <> OLD_G_PRODUCT_) THEN BEGIN'
      '1101322967=      /*SELECT S.PRICE'
      '1101322968=        FROM SKLAD S'
      
        '1101322969=       WHERE S.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101322970=         AND S.IS_LAST = 1'
      '1101322971=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1101322972=        INTO :LAST_SELF_PRICE_;'
      '1101322973='
      '1101322974=      PRICE_ = COALESCE(LAST_SELF_PRICE_, 0);*/'
      
        '1101322975=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, (SELECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2), 0)'
      '1101322976=          RETURNING_VALUES :PRICE_;'
      '1101322977='
      '1101322978=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101322979=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101322980=        EXIT;'
      '1101322981=      END'
      '1101322982=  END'
      '1101322983='
      '1101322984=  IF (PRICE_ = 0) THEN BEGIN'
      '1101322985=    CHARGE_PRICE_ROZN_ = 0;'
      '1101322986=    CHARGE_PRICE_OPT_ = 0;'
      '1101322987=  END'
      '1101322988=  ELSE BEGIN'
      
        '1101322989=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1062#1045#1053#1059' '#1055#1056#1054#1044#1040#1046#1048
      
        '1101322990=      IF (CHARGE_PRICE_ROZN_ <> OLD_CHARGE_PRICE_ROZN' +
        '_ OR PRICE_ <> OLD_PRICE_) THEN'
      
        '1101322991=        PRICE_ROZN_ = PRICE_ * CHARGE_PRICE_ROZN_/100' +
        ' + PRICE_;'
      
        '1101322992=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1055#1056#1054 +
        #1062#1045#1053#1058', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '1101322993=      ELSE IF (PRICE_ROZN_ <> OLD_PRICE_ROZN_) THEN'
      
        '1101322994=        CHARGE_PRICE_ROZN_ = ROUND((PRICE_ROZN_/PRICE' +
        '_ - 1)*100, 2);'
      '1101322995='
      
        '1101322996=      -- '#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040#1062#1045#1053#1050#1040' '#1054#1055#1058' '#1055#1056#1054#1062#1045#1053#1058' '#1048#1051#1048' '#1062#1045#1053#1040' '#1047 +
        #1040#1050#1059#1055#1050#1048#1047' , '#1047#1053#1040#1063#1048#1058' '#1062#1045#1053#1040' '#1054#1055#1058#1040' '#1053#1045' '#1052#1045#1053#1071#1051#1040#1057#1068', '#1041#1059#1044#1059' '#1045#1045' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      
        '1101322997=      IF (CHARGE_PRICE_OPT_ <> OLD_CHARGE_PRICE_OPT_ ' +
        'OR PRICE_ <> OLD_PRICE_ ) THEN'
      
        '1101322998=        PRICE_OPT_ = PRICE_ * CHARGE_PRICE_OPT_/100 +' +
        ' PRICE_;'
      '1101322999='
      
        '1101323000=      -- '#1045#1057#1051#1048' '#1046#1045' '#1052#1045#1053#1071#1051#1040#1057#1068' '#1062#1045#1053#1040' '#1054#1055#1058#1040', '#1047#1053#1040#1063#1048#1058' '#1053#1045' '#1052#1045#1053#1071#1051#1057 +
        #1071' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1055#1058#1040', '#1053#1040#1044#1054' '#1045#1043#1054' '#1042#1067#1063#1048#1057#1051#1071#1058#1068
      '1101323001=      ELSE IF (PRICE_OPT_ <> OLD_PRICE_OPT_) THEN'
      
        '1101323002=        CHARGE_PRICE_OPT_ = ROUND((PRICE_OPT_/PRICE_ ' +
        '- 1)*100, 2);'
      '1101323003=  END'
      '1101323004='
      '1101323005=  UPDATE SKLAD_TMP T'
      '1101323006=  SET'
      '1101323007=    G_PRODUCT = :G_PRODUCT_,'
      '1101323008=    AMOUNT = :AMOUNT_,'
      '1101323009=    PRICE = :PRICE_,'
      '1101323010=    SUMM = :AMOUNT_ * :PRICE_,'
      '1101323011=    NDS = :NDS_,'
      '1101323012=    NDS_SUMM = :NDS_SUMM_'
      '1101323013=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '1101323014=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '1101323015=    ,T.CHARGE_ROZN_PROC = :CHARGE_PRICE_ROZN_'
      '1101323016=    ,T.PRICE_ROZN = :PRICE_ROZN_'
      '1101323017=    ,T.CHARGE_OPT_PROC = :CHARGE_PRICE_OPT_'
      '1101323018=    ,T.PRICE_OPT = :PRICE_OPT_'
      '1101323019=  WHERE'
      '1101323020=    SKLAD = :SKLAD_;'
      '1101323021=END'
      '1101323022=;'
      '1101323023='
      '1101323024=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1101323025=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101323026=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101323027=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101323028=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101323029=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101323030=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101323031=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101323032=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101323033=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101323034=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101323035=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101323036=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101323037=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101323038=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101323039=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101323040=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101323041=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101323042=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101323043=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101323044=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1101323045=  NOT_MINUS_OSTATOK_ INTEGER = 0)'
      '1101323046=RETURNS ('
      '1101323047=  ERR_CODE INTEGER,'
      '1101323048=  ERR_MSG VARCHAR(1024))'
      '1101323049=AS'
      '1101323050=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1101323051='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1101323052=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1101323053=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1101323054='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1101323055=*/'
      
        '1101323056=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1101323057=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101323058=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101323059=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '1101323060=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1101323061=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1101323062=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1101323063=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1101323064=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1101323065=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101323066=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHK' +
        'A.G_TOCHKA;'
      '1101323067=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1101323068=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101323069=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1101323070=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      
        '1101323071=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1101323072=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1101323073=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1101323074=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM;' +
        ' /* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '1101323075=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '1101323076=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '1101323077=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_FACT;'
      
        '1101323078=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1101323079=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1101323080=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1101323081=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1101323082=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1101323083=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1101323084=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1101323085=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIEN' +
        'T.G_CLIENT;'
      
        '1101323086=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT' +
        '.SALES_COMM;'
      
        '1101323087=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101323088=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101323089=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101323090=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM = 0;'
      
        '1101323091=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '1101323092=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1101323093=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101323094=DECLARE VARIABLE DETAILS_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      
        '1101323095=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101323096=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      '1101323097=BEGIN'
      '1101323098='
      '1101323099=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101323100=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101323101=      SELECT Z.G_PAYMENT_TYPE,'
      '1101323102=             Z.G_TOCHKA,'
      '1101323103=             Z.SUMM,'
      '1101323104=             Z.SUMM_BONUS,'
      '1101323105=             Z.SUMM_BONUS_GOT,'
      '1101323106=             z.g_client,'
      '1101323107=             Z.G_OFFICIAL,'
      '1101323108=             G.DO_NOT_SALES_COMM,'
      '1101323109=             G.FM||'#39' '#39'||G.NM'
      
        '1101323110=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101323111=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101323112=        INTO :G_PAYMENT_TYPE_OLD_,'
      '1101323113=             :G_TOCHKA_,'
      '1101323114=             :SUMM_OLD_,'
      '1101323115=             :SUMM_BONUS_OLD_,'
      '1101323116=             :SUMM_BONUS_GOT_OLD_,'
      '1101323117=             :g_client_old_,'
      '1101323118=             :G_OFFICIAL_,'
      '1101323119=             :DO_NOT_SALES_COMM_,'
      '1101323120=             :OFFICIAL_NAME_;'
      '1101323121='
      
        '1101323122=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101323123=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0) THEN'
      '1101323124=        SELECT SUM(ZD.SALES_COMM)'
      '1101323125=          FROM ZAKAZ_DETAILS ZD'
      '1101323126=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101323127=          INTO :SALES_COMM_OLD_;'
      '1101323128='
      '1101323129=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1101323130=      PNT_ = '#39'02'#39';'
      
        '1101323131=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101323132=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101323133=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101323134=        EXIT;'
      '1101323135=      END'
      '1101323136='
      
        '1101323137=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN   ' +
        ' -- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059 +
        #1052#1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044 +
        #1040#1063#1048
      '1101323138=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '1101323139=      ELSE'
      '1101323140=        SUMM_FACT_1_ = SUMM_FACT_;'
      '1101323141='
      '1101323142=      PNT_ = '#39'01'#39';'
      '1101323143=      UPDATE zakaz'
      '1101323144=      SET'
      '1101323145=       G_TOCHKA = :G_TOCHKA_,'
      '1101323146=       Z_DATE = :Z_DATE_,'
      '1101323147=       Z_TIME = :Z_TIME_,'
      '1101323148=       G_CLIENT = :G_CLIENT_,'
      '1101323149=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1101323150=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1101323151=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1101323152=       SUMM = :SUMM_,'
      '1101323153=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '1101323154=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ +' +
        ' :SUMM_BONUS_), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040 +
        ' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1101323155=       ,BY_RECIPE = :BY_RECIPE_'
      '1101323156=       ,IS_RESERVE = :IS_RESERVE_'
      '1101323157=       ,SUMM_BONUS = :SUMM_BONUS_'
      '1101323158=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '1101323159=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '1101323160=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '1101323161=      WHERE'
      '1101323162=        zakaz = :zakaz_;'
      '1101323163='
      
        '1101323164=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059','
      '1101323165=      -- '#1057#1058#1040#1056#1067#1045' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1054#1058#1053#1048#1052#1040#1070', '#1053#1054#1042#1067#1045' '#1055#1056#1048#1041#1040#1042#1051#1071#1070
      
        '1101323166=      -- '#1053#1054', '#1045#1057#1051#1048' '#1057#1052#1045#1053#1048#1051#1057#1071' '#1050#1051#1048#1045#1053#1058' '#1053#1040' '#1044#1056#1059#1043#1054#1043#1054', '#1058#1054#1058' '#1058#1059#1058 +
        ' '#1053#1045#1052#1053#1054#1043#1054' '#1044#1056#1059#1043#1040#1071' '#1057#1048#1058#1059#1045#1042#1048#1053#1040', '#1057#1058#1040#1056#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1053#1040#1044#1054' '#1069#1058#1059' '#1057#1059#1052#1052#1059' '#1054#1058#1053#1048#1052 +
        #1040#1058#1068
      '1101323167=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '1101323168=          UPDATE G_DISCONT_CARD D'
      '1101323169=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '1101323170=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '1101323171=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '1101323172='
      
        '1101323173=          SUMM_BONUS_GOT_OLD_ = 0;  -- '#1053#1054#1042#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059 +
        ' '#1054#1053#1048' '#1053#1045' '#1053#1059#1046#1053#1067
      '1101323174=          SUMM_OLD_           = 0;'
      '1101323175=      END'
      '1101323176=      UPDATE G_DISCONT_CARD D'
      
        '1101323177=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM' +
        '_BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '1101323178=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :S' +
        'UMM_'
      '1101323179=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '1101323180='
      '1101323181=      PNT_ = '#39'03'#39';'
      '1101323182=      FOR SELECT T.ZAKAZ_DETAILS,'
      '1101323183=                 T.G_PRODUCT,'
      '1101323184=                 T.AMOUNT,'
      '1101323185=                 T.SUMM,'
      '1101323186=                 G.SALES_COMM'
      '1101323187=            FROM ZAKAZ_DETAILS_TMP T, G_PRODUCT G'
      '1101323188=           WHERE T.G_PRODUCT = G.G_PRODUCT'
      '1101323189=      INTO :ZAKAZ_DETAILS_,'
      '1101323190=           :G_PRODUCT_,'
      '1101323191=           :Z_AMOUNT_,'
      '1101323192=           :DETAILS_SUMM_,'
      '1101323193=           :SALES_COMM_'
      '1101323194=      DO BEGIN'
      
        '1101323195=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' ' +
        #1055#1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' ' +
        #1043#1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '1101323196=        IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN BEGIN'
      
        '1101323197=          SALES_COMM_SUMM_ITER_ = DETAILS_SUMM_ * SAL' +
        'ES_COMM_/100;'
      
        '1101323198=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL' +
        '_ + SALES_COMM_SUMM_ITER_;'
      '1101323199=        END'
      '1101323200='
      
        '1101323201=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101323202=                                   DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, SALES_COMM)'
      
        '1101323203=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '1101323204=               DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, ND' +
        'S_SUMM, COST_PRICE, :SALES_COMM_SUMM_ITER_'
      '1101323205=          FROM ZAKAZ_DETAILS_TMP Z'
      '1101323206=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '1101323207='
      
        '1101323208=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057 +
        #1050#1051#1040#1044#1040
      '1101323209=        IF (IS_RESERVE_ = 0) THEN'
      '1101323210=            UPDATE LT_SKLAD_PRODUCT L'
      '1101323211=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '1101323212=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323213=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101323214='
      '1101323215=        -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '1101323216=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '1101323217=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1101323218=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERV' +
        'E + :Z_AMOUNT_'
      '1101323219=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101323220=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101323221=      END'
      '1101323222='
      '1101323223=      ----------------------------------------'
      
        '1101323224=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1101323225=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1101323226=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1101323227=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1101323228=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1101323229=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1101323230=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101323231=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1101323232=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '1101323233=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      '1101323234=                PNT_ = '#39'04'#39';'
      
        '1101323235=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101323236=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101323237=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101323238=                ELSE'
      
        '1101323239=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101323240='
      
        '1101323241=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101323242=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101323243='
      
        '1101323244=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101323245='
      '1101323246=                PNT_ = '#39'05'#39';'
      
        '1101323247=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0)' +
        ' THEN'
      
        '1101323248=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101323249=                                                  1, ' +
        '    -- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101323250=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101323251=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101323252=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101323253=                                                  :ZA' +
        'KAZ_,   --ZAKAZ_'
      
        '1101323254=                                                  NUL' +
        'L,'
      
        '1101323255=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101323256=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101323257='
      
        '1101323258=                -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040 +
        #1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101323259=                ELSE BEGIN'
      
        '1101323260=                    -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063 +
        #1053#1067#1049' '#1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101323261=                    SELECT 1'
      '1101323262=                      FROM KASSA K'
      '1101323263=                     WHERE K.KASSA = :KASSA_'
      '1101323264=                    UNION ALL'
      '1101323265=                    SELECT 2'
      '1101323266=                      FROM KASSA_BEZNAL KB'
      '1101323267=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101323268=                     INTO :PAYMENT_TYPE_OLD_;'
      '1101323269='
      '1101323270=                    PNT_ = '#39'06'#39';'
      
        '1101323271=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
