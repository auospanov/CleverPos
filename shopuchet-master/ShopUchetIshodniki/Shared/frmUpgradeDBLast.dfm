      '110237178='
      '110237179=      -- '#1052#1045#1053#1071#1070#1058' '#1062#1045#1053#1059' '#1047#1040' '#1043#1056#1040#1052#1052
      '110237180=      ELSE BEGIN'
      '110237181=          -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' %'
      '110237182=          IF (MODE_ = 0) THEN'
      
        '110237183=            SQL_STR_ = SQL_STR_ ||'#39'P.VES_GRAMM_PRICE =' +
        ' ROUND(P.VES_GRAMM_PRICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND' +
        '_||'#39'),'#39'||'
      
        '110237184=                       '#39' P.PRICE = ROUND(P.VES_GRAMM_P' +
        'RICE * (1 + '#39'||:NEW_VAL_||'#39'/ 100), '#39'||:ROUND_||'#39') * P.VES_GRAMM'#39 +
        ';'
      '110237185='
      '110237186=          -- '#1059#1042#1045#1051#1048#1063#1048#1058#1068' '#1053#1040' '#1047#1053#1040#1063#1045#1053#1048#1045
      '110237187=          ELSE IF (MODE_ = 1) THEN'
      
