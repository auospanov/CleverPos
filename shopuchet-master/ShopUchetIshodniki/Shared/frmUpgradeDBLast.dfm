      '1101650='
      '1101651=ALTER PROCEDURE G_GET_G_CLIENT('
      
        '1101652=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T)'
      '1101653=RETURNS ('
      
        '1101654=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT */ BIGINT,'
      
        '1101655=  G_CONTRAGENT_ /* TYPE OF COLUMN G_CONTRAGENT.G_CONTRAG' +
        'ENT */ BIGINT,'
      '1101656=  NAME_ VARCHAR(500),'
      
        '1101657=  NAME_FULL_ /* TYPE OF COLUMN G_CLIENT.NAME_FULL */ VAR' +
        'CHAR(250),'
      '1101658=  IDN_ VARCHAR(12),'
      
        '1101659=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
        ','
      '11016510=  KBE_ VARCHAR(5),'
      '11016511=  SKIDKA_ NUMERIC(15,2),'
      '11016512=  BY_DEFAULT_ INTEGER,'
      '11016513=  IS_BEZNAL_ INTEGER,'
      
        '11016514=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ ' +
        'VARCHAR(13),'
      
        '11016515=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT' +
        ' */ NUMERIC(15,2),'
      
        '11016516=  SUMM_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM */ NUMERI' +
        'C(15,2),'
      
        '11016517=  SUMM_ALL_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL *' +
        '/ NUMERIC(15,2),'
      
        '11016518=  NOTE_ /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200)' +
        ','
      '11016519=  DT_ /* TYPE OF COLUMN G_CLIENT.DT */ DATE,'
      
        '11016520=  G_PROMOTION_ /* TYPE OF COLUMN G_PROMOTION.G_PROMOTIO' +
        'N */ BIGINT,'
      
        '11016521=  G_PROMOTION_STR_ /* TYPE OF COLUMN G_PROMOTION.NAME *' +
        '/ VARCHAR(150),'
      '11016522=  NOTIFY_SKIDKA_ INTEGER,'
      '11016523=  NOTIFY_DR_ INTEGER,'
      
        '11016524=  G_CLIENT_PROMO_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT *' +
        '/ BIGINT,'
      '11016525=  FM_PROMO_ VARCHAR(50),'
      
