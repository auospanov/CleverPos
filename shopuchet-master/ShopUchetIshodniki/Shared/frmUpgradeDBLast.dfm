        '1107046=ALTER TABLE P_REP_ZAKAZI_LIST_TABLE ALTER COLUMN ID POSI' +
        'TION 1;'
      '1107047='
      
        '1107048=ALTER TABLE P_REP_ZAKAZI_LIST_TABLE ALTER COLUMN "DATE" ' +
