        'AYMENT_TYPE_,'
      
        '110402690=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110402691=              END'
      '110402692='
      
        '110402693=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', ' +
        #1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110402694=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', ' +
        #1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110402695=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110402696=                PNT_ = '#39#39'11'#39#39';'
      '110402697=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110402698=                    EXECUTE PROCEDURE K_DEL_KASSA(:KAS' +
        'SA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR' +
        '_MSG);'
      '110402699=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402700=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110402701=                      EXIT;'
      '110402702=                    END'
      '110402703='
      
        '110402704=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110402705=                                                  :G_P' +
        'RIHOD_,'
      
        '110402706=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110402707=                                                  :Z_D' +
        'ATE_,'
      
