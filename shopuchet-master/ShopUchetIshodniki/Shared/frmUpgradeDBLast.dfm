      '110242391=            FROM KASSA_BEZNAL K'
      '110242392=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110242393=             AND K.SUMM = 0'
      '110242394=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110242395=      DO BEGIN'
