      '110401690='
      
        '110401691=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054' ' +
        #1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '110401692=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' '#1041 +
        #1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '110401693=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054#1052 +
        ' '#1057#1051#1059#1063#1040#1045
      '110401694=      UPDATE G_DISCONT_CARD D'
      
        '110401695=      SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_, 0) ' +
        '+ :SUMM_BONUS_GOT_,'
      '110401696=          D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '110401697=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110401698=  END'
      '110401699=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110401700=  ----------------------------------------'
      '110401701=  ----------------------------------------'
      '110401702=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110401703=  ELSE IF (IS_SPISANIE_ = 2) then BEGIN'
      '110401704=      PNT_ = '#39#39'25'#39#39';'
      
        '110401705=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PARENT' +
        ', G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCHK' +
        'A)'
      
        '110401706=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CLI' +
        'ENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHKA' +
        '_)'
      '110401707=      RETURNING ZAKAZ_REAL_PARENT'
      '110401708=      INTO :ZAKAZ_REAL_PARENT_;'
      '110401709='
      
        '110401710=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISCO' +
        'UNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '110401711=            FROM ZAKAZ_DETAILS_TMP Z'
      '110401712=          INTO :G_PRODUCT,'
      '110401713=              :AMOUNT,'
      '110401714=              :PRICE,'
      '110401715=              :SUMM,'
      '110401716=              :DISCOUNT_PERC,'
      '110401717=              :DISCOUNT_TENGE,'
      '110401718=              :DISCOUNT_SUMM,'
      '110401719=              :NDS,'
      '110401720=              :NDS_SUMM'
      '110401721=      DO BEGIN'
      '110401722=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '110401723=          UPDATE LT_SKLAD_PRODUCT L'
      '110401724=             SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110401725=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '110401726=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110401727='
      
        '110401728=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053#1054 +
        ' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045' ' +
        #1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110401729=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055#1048 +
        #1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '110401730=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FRO' +
        'M SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110401731=            Err_Code = -20500;'
      
        '110401732=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODU' +
        'CT = :G_PRODUCT)||'#39#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087 +
        #1088#1086#1075#1088#1072#1084#1084#1099'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110401733=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110401734=            EXIT;'
      '110401735=          END ELSE if (ROW_COUNT = 0) then'
      
        '110401736=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRO' +
        'DUCT, G_PRODUCT, AMOUNT, G_TOCHKA)'
      
        '110401737=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :' +
        'G_PRODUCT, -:AMOUNT, :G_TOCHKA_);'
      '110401738='
      
        '110401739=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, ZA' +
        'KAZ_REAL_PARENT,'
