        'T_TYPE_,'
      
        '1101322773=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101322774='
      
        '1101322775=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045 +
        #1058#1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '1101322776=            ELSE BEGIN'
      
        '1101322777=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' ' +
        #1048#1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '1101322778=                SELECT 1'
      '1101322779=                  FROM KASSA K'
      '1101322780=                 WHERE K.KASSA = :KASSA_'
      '1101322781=                UNION ALL'
      '1101322782=                SELECT 2'
      '1101322783=                  FROM KASSA_BEZNAL KB'
      '1101322784=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1101322785=                 INTO :PAYMENT_TYPE_OLD_;'
      '1101322786='
      
        '1101322787=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101322788=                      PNT_ = '#39'010'#39';'
      
        '1101322789=                      EXECUTE PROCEDURE K_UPD_KASSA(:' +
        'KASSA_,'
      
        '1101322790=                                                    1' +
        ',     -- ACTION_'
      
        '1101322791=                                                    :' +
        'G_PRIHOD_RASHOD_,'
      
        '1101322792=                                                    :' +
        'PAYMENT_SUMM_,'
      
