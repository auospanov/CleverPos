        '110241356=                        and s.is_vozvrat <> 3 and s.da' +
        'te_receipt > :DATE_END_)'
      '110241357=                       -'
      
        '110241358=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110241359=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '110241360=                  from rdb$database) PRICE,'
      '110241361=                 NULL,'
      '110241362=                 NULL,'
      '110241363=                 NULL,'
      '110241364=                 NULL,'
      '110241365=                 NULL'
      '110241366=            FROM G_PRODUCT G'
      '110241367=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '110241368=         ORDER BY 2, 1, 3'
      '110241369=            INTO :ROW,'
      '110241370=                 :DATE_SORT,'
      '110241371=                 :DATE_ACT,'
      '110241372=                 :OPER,'
      '110241373=                 :PRICE_PRIHOD,'
      '110241374=                 :AMOUNT_PRIHOD,'
      '110241375=                 :SUMM_PRIHOD,'
      '110241376=                 :PRICE_UHOD,'
      '110241377=                 :AMOUNT_UHOD,'
      '110241378=                 :SUMM_UHOD'
      '110241379=      DO BEGIN'
      '110241380=        IF (ROW not in (-2, -1, 11)) THEN BEGIN'
      '110241381=            PRICE_PRIHOD = COALESCE(PRICE_PRIHOD, 0);'
      
        '110241382=            AMOUNT_PRIHOD = COALESCE(AMOUNT_PRIHOD, 0)' +
        ';'
      '110241383=            SUMM_PRIHOD = COALESCE(SUMM_PRIHOD, 0);'
      '110241384=            PRICE_UHOD = COALESCE(PRICE_UHOD, 0);'
      '110241385=            AMOUNT_UHOD = COALESCE(AMOUNT_UHOD, 0);'
      '110241386=            SUMM_UHOD  = COALESCE(SUMM_UHOD, 0);'
      '110241387=        END'
      '110241388=        SUSPEND;'
      '110241389=      END'
      '110241390=  END'
      '110241391=WHEN ANY DO BEGIN'
      '110241392=    Err_code = -20500;'
      
        '110241393=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1048#1057#1058#1054#1056#1048#1048' '#1058#1054#1042#1040#1056#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110241394=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110241395=  END'
      '110241396=end'
      '110241397='#39';'
      '110241398='
      '110241399=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '110241400=  G_CATEGORY_ VARCHAR(1000),'
      '110241401=  G_PRODUCT_ VARCHAR(1000),'
      '110241402=  DATE_BEGIN_ DATE,'
      '110241403=  DATE_END_ DATE,'
      '110241404=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110241405=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110241406=RETURNS ('
      '110241407=  DATE_BEGIN_OUT_ DATE,'
      '110241408=  DATE_END_OUT_ DATE,'
      '110241409=  STR_ VARCHAR(500),'
      '110241410=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '110241411=  NAME VARCHAR(1000),'
      '110241412=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110241413=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110241414=  AMOUNT_IN NUMERIC(15,2),'
      
        '110241415=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        ','
      '110241416=  SUMM_PRIHOD NUMERIC(15,2),'
      '110241417=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '110241418=  SUMM_UHOD NUMERIC(15,2),'
      
        '110241419=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '110241420=  SUMM_SPISANO NUMERIC(15,2),'
      
        '110241421=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '110241422=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '110241423=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AM' +
        'OUNT,'
      '110241424=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '110241425=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '110241426=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '110241427=  AMOUNT_OUT NUMERIC(15,2),'
      '110241428=  IS_HEAD INTEGER,'
      '110241429=  ERR_CODE INTEGER,'
      '110241430=  ERR_MSG VARCHAR(1024))'
      '110241431=AS'
      
        '110241432=declare variable PROCNAME varchar(30) = '#39#39'P_REP_TOVAR_' +
        'MOVE'#39#39';'
      '110241433=declare variable PNT_ varchar(5);'
      
        '110241434=declare variable AMOUNT_PRIHOD_ type of column LT_SKLA' +
        'D_PRODUCT.AMOUNT = 0;'
      '110241435=declare variable SUMM_PRIHOD_ numeric(15,2) = 0;'
      
        '110241436=declare variable AMOUNT_UHOD_ type of column LT_SKLAD_' +
        'PRODUCT.AMOUNT = 0;'
      '110241437=declare variable SUMM_UHOD_ numeric(15,2) = 0;'
      
        '110241438=declare variable AMOUNT_SPISANO_ type of column LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '110241439=declare variable SUMM_SPISANO_ numeric(15,2) = 0;'
      
        '110241440=declare variable AMOUNT_VOZVRAT_ type of column LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '110241441=declare variable SUMM_VOZVRAT_ numeric(15,2) = 0;'
      
        '110241442=declare variable AMOUNT_PRIHOD_SKL_ type of column LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '110241443=declare variable SUMM_PRIHOD_SKL_ numeric(15,2) = 0;'
      
        '110241444=declare variable AMOUNT_UHOD_SKL_ type of column LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '110241445=declare variable SUMM_UHOD_SKL_ numeric(15,2) = 0;'
      
        '110241446=declare variable RECCAT_G_PRODUCT_ type of column G_PR' +
        'ODUCT.G_PRODUCT;'
      
        '110241447=declare variable REC_G_PRODUCT_ type of column G_PRODU' +
        'CT.G_PRODUCT;'
      
        '110241448=declare variable REC_AMOUNT_PRIHOD_ type of column LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '110241449=declare variable REC_SUMM_PRIHOD_ numeric(15,2) = 0;'
      
        '110241450=declare variable REC_AMOUNT_UHOD_ type of column LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '110241451=declare variable REC_SUMM_UHOD_ numeric(15,2) = 0;'
      
        '110241452=declare variable REC_AMOUNT_SPISANO_ type of column LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110241453=declare variable REC_SUMM_SPISANO_ numeric(15,2) = 0;'
      
        '110241454=declare variable REC_AMOUNT_VOZVRAT_ type of column LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110241455=declare variable REC_SUMM_VOZVRAT_ numeric(15,2) = 0;'
      
        '110241456=declare variable REC_AMOUNT_PRIHOD_SKL_ type of column' +
        ' LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '110241457=declare variable REC_SUMM_PRIHOD_SKL_ numeric(15,2) = ' +
        '0;'
      
        '110241458=declare variable REC_AMOUNT_UHOD_SKL_ type of column L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '110241459=declare variable REC_SUMM_UHOD_SKL_ numeric(15,2) = 0;'
      
        '110241460=declare variable AMOUNT_PRIHOD_ALL_ type of column LT_' +
        'SKLAD_PRODUCT.AMOUNT = 0;'
      '110241461=declare variable SUMM_PRIHOD_ALL_ numeric(15,2) = 0;'
      
        '110241462=declare variable AMOUNT_UHOD_ALL_ type of column LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '110241463=declare variable SUMM_UHOD_ALL_ numeric(15,2) = 0;'
      
        '110241464=declare variable AMOUNT_SPISANO_ALL_ type of column LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110241465=declare variable SUMM_SPISANO_ALL_ numeric(15,2) = 0;'
      
        '110241466=declare variable AMOUNT_VOZVRAT_ALL_ type of column LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '110241467=declare variable SUMM_VOZVRAT_ALL_ numeric(15,2) = 0;'
      
        '110241468=declare variable AMOUNT_PRIHOD_SKL_ALL_ type of column' +
        ' LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '110241469=declare variable SUMM_PRIHOD_SKL_ALL_ numeric(15,2) = ' +
        '0;'
      
        '110241470=declare variable AMOUNT_UHOD_SKL_ALL_ type of column L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '110241471=declare variable SUMM_UHOD_SKL_ALL_ numeric(15,2) = 0;'
      '110241472=declare variable PATH_ varchar(2000);'
      '110241473=declare variable PATH_OLD_ varchar(2000) = '#39#39#39#39';'
      '110241474=declare variable GNAME_ type of column G_PRODUCT.NAME;'
      '110241475=declare variable REC_AMOUNT_IN_ numeric(15,2) = 0;'
      '110241476=declare variable REC_AMOUNT_OUT_ numeric(15,2) = 0;'
      '110241477=BEGIN'
      '110241478='
      '110241479=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '110241480=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '110241481='
      '110241482=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '110241483=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '110241484=               (select (select amount from lt_sklad_pr' +
        'oduct where g_product = G.G_PRODUCT'
      
        '110241485=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '110241486=                       +'
      
        '110241487=                       (select COALESCE(sum(zd.amount)' +
        ', 0) from zakaz_details zd, zakaz z'
      
        '110241488=                        where zd.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110241489=                        and zd.zakaz = z.zakaz and z.z' +
        '_date >= :DATE_BEGIN_)'
      '110241490=                       +'
      
        '110241491=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110241492=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '110241493=                       +'
      
        '110241494=                       (select COALESCE(sum(od.amount)' +
        ', 0) from other_details od, other o'
      
        '110241495=                        where od.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '110241496=                        and od.other = o.other and o.o' +
        'p_date >= :DATE_BEGIN_)'
      '110241497=                       -'
      
        '110241498=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '110241499=                        and s.is_vozvrat <> 3 and s.da' +
        'te_receipt >= :DATE_BEGIN_)'
      '110241500=                       -'
      
        '110241501=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110241502=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '110241503=                  from rdb$database) AMOUNT_OUT,'
      '110241504=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110241505=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '110241506=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110241507=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110241508=                   AND S.IS_VOZVRAT = 0'
      
        '110241509=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD,'
      '110241510=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '110241511=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110241512=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110241513=                   AND S.IS_VOZVRAT = 0'
      
        '110241514=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD,'
      '110241515=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '110241516=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '110241517=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110241518=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110241519=                   AND Z.IS_SPISANIE IN (0, 2)'
      '110241520=                   AND Z.IS_RESERVE = 0'
      
        '110241521=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_UHOD,'
      '110241522=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '110241523=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110241524=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110241525=                   AND Z.IS_SPISANIE IN (0, 2)'
      '110241526=                   AND Z.IS_RESERVE = 0'
      
        '110241527=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_UHOD,'
      '110241528=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '110241529=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '110241530=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110241531=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110241532=                   AND Z.IS_SPISANIE = 1'
      
        '110241533=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_SPISANO,'
      '110241534=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '110241535=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHERE' +
        ' ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '110241536=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ A' +
        'ND :DATE_END_'
      '110241537=                   AND Z.IS_SPISANIE = 1'
      
        '110241538=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_SPISANO,'
      '110241539=               -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110241540=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '110241541=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110241542=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110241543=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '110241544=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_VOZVRAT,'
      '110241545=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '110241546=                  FROM SKLAD S WHERE S.G_PRODUCT = G.G' +
        '_PRODUCT'
      
        '110241547=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110241548=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '110241549=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_VOZVRAT,'
      
        '110241550=               -- '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043 +
        #1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1067#1056#1040#1042#1053#1048#1042#1040#1053#1048#1045' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1042' '#1056#1045#1047#1059#1051#1068 +
        #1058#1040#1058#1045' '#1056#1045#1042#1048#1047#1048#1048
      '110241551=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      '110241552=                  FROM SKLAD S'
      '110241553=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '110241554=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110241555=                   AND S.IS_VOZVRAT IN (3, 4, 5)'
      
        '110241556=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD_SKL,'
      '110241557=               (SELECT COALESCE(SUM(S.SUMM),0)'
      '110241558=                  FROM SKLAD S'
      '110241559=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '110241560=                   AND S.DATE_RECEIPT BETWEEN :DATE_BE' +
        'GIN_ AND :DATE_END_'
      '110241561=                   AND S.IS_VOZVRAT IN (3, 4)'
      
        '110241562=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39 +
        '||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD_SKL,'
      
        '110241563=               -- '#1059#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1059#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1044#1056'. '#1057#1050#1051 +
        #1040#1044' '#1048' '#1059#1061#1054#1044' '#1050#1054#1052#1055#1051#1045#1050#1058#1059#1070#1065#1048#1061' '#1055#1056#1048' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1045', '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040 +
        #1042#1065#1048#1050#1059
      '110241564=               (SELECT COALESCE(SUM(AMOUNT), 0)'
      
        '110241565=                  FROM (SELECT COALESCE(S.AMOUNT, 0) A' +
        'MOUNT'
      '110241566=                          FROM SKLAD S'
      
        '110241567=                         WHERE S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110241568=                           AND S.DATE_RECEIPT BETWEEN ' +
        ':DATE_BEGIN_ AND :DATE_END_'
      '110241569=                           AND S.IS_VOZVRAT = 3'
      
        '110241570=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||S.G_CLIENT||'#39#39'-'#39#39
      '110241571=                        UNION ALL'
      
        '110241572=                        SELECT COALESCE(D.AMOUNT, 0) A' +
        'MOUNT'
      
        '110241573=                          FROM OTHER O, OTHER_DETAILS ' +
        'D'
      '110241574=                         WHERE O.OTHER = D.OTHER'
      
        '110241575=                           AND O.OP_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '110241576=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||O.G_TOCHKA||'#39#39'-'#39#39
      
        '110241577=                           AND D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '110241578=                        UNION ALL'
      
        '110241579=                        SELECT COALESCE(D.AMOUNT, 0) A' +
        'MOUNT'
      
        '110241580=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'D'
      '110241581=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '110241582=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110241583=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110241584=                           AND D.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110241585=                           AND Z.IS_SPISANIE = 4)) AMO' +
        'UNT_UHOD_SKL,'
      '110241586=               (SELECT COALESCE(SUM(SUMM), 0)'
      
        '110241587=                  FROM (SELECT COALESCE(SUM(S.SUMM),0)' +
        ' SUMM'
      '110241588=                          FROM SKLAD S'
      
        '110241589=                         WHERE S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110241590=                           AND S.DATE_RECEIPT BETWEEN ' +
        ':DATE_BEGIN_ AND :DATE_END_'
      '110241591=                           AND S.IS_VOZVRAT = 3'
      
        '110241592=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||S.G_CLIENT||'#39#39'-'#39#39
      '110241593=                        UNION ALL'
      
        '110241594=                        SELECT D.AMOUNT * D.COST_PRICE' +
        ' SUMM'
      
        '110241595=                          FROM OTHER O, OTHER_DETAILS ' +
        'D'
      
        '110241596=                        WHERE O.OP_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110241597=                          AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||O.G_TOCHKA||'#39#39'-'#39#39
      '110241598=                          AND O.OTHER = D.OTHER'
      
        '110241599=                          AND D.G_PRODUCT = G.G_PRODUC' +
        'T'
      '110241600=                        UNION ALL'
      
        '110241601=                        SELECT COALESCE(D.SUMM, 0) AMO' +
        'UNT'
      
        '110241602=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'D'
      '110241603=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '110241604=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110241605=                           AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110241606=                           AND D.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110241607=                           AND Z.IS_SPISANIE = 4)) SUM' +
        'M_UHOD_SKL,'
      '110241608=               -- '#1048#1057#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '110241609=               (select (select amount from lt_sklad_pr' +
        'oduct where g_product = G.G_PRODUCT'
      
        '110241610=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '110241611=                       +'
      
        '110241612=                       (select COALESCE(sum(zd.amount)' +
        ', 0) from zakaz_details zd, zakaz z'
      
        '110241613=                        where zd.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '110241614=                        and zd.zakaz = z.zakaz and z.z' +
        '_date > :DATE_END_)'
      '110241615=                       +'
      
        '110241616=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110241617=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '110241618=                       +'
      
        '110241619=                       (select COALESCE(sum(od.amount)' +
        ', 0) from other_details od, other o'
      
        '110241620=                        where od.g_product = G.G_PRODU' +
        'CT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '110241621=                        and od.other = o.other and o.o' +
        'p_date > :DATE_END_)'
      '110241622=                       -'
      
        '110241623=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_A' +
        'RR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '110241624=                        and s.is_vozvrat <> 3 and s.da' +
        'te_receipt > :DATE_END_)'
      '110241625=                       -'
      
        '110241626=                       (select COALESCE(sum(s.amount),' +
        ' 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvra' +
        't = 3'
      
        '110241627=                        and :G_TOCHKA_ARR_ CONTAINING ' +
        #39#39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '110241628=                  from rdb$database) AMOUNT_OUT'
      '110241629=         FROM P_REP_TREE GP,'
      '110241630=              G_PRODUCT G'
      '110241631=         WHERE G.G_PRODUCT_PAR = GP.G_PRODUCT'
      '110241632=           AND EXISTS (SELECT 1'
      '110241633=                         FROM SKLAD SS'
      
        '110241634=                        WHERE SS.DATE_RECEIPT BETWEEN ' +
        ':DATE_BEGIN_ AND :DATE_END_'
      
        '110241635=                          AND SS.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110241636=                          AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||SS.G_TOCHKA||'#39#39'-'#39#39
      '110241637=                       UNION ALL'
      '110241638=                       SELECT 1'
      '110241639=                         FROM SKLAD SS'
      
        '110241640=                        WHERE SS.DATE_RECEIPT BETWEEN ' +
        ':DATE_BEGIN_ AND :DATE_END_'
      
        '110241641=                          AND SS.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '110241642=                          AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||SS.G_CLIENT||'#39#39'-'#39#39
      '110241643=                       UNION ALL'
      '110241644=                       SELECT 1'
      '110241645=                         FROM ZAKAZ ZZ,'
      '110241646=                              ZAKAZ_DETAILS ZZD'
      '110241647=                        WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
      '110241648=                          AND ZZ.is_reserve = 0'
      
        '110241649=                          AND ZZ.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110241650=                          AND ZZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110241651=                          AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||ZZ.G_TOCHKA||'#39#39'-'#39#39
      '110241652=                       UNION ALL'
      '110241653=                       SELECT 1'
      '110241654=                         FROM OTHER ZZ,'
      '110241655=                              OTHER_DETAILS ZZD'
      '110241656=                        WHERE ZZ.OTHER = ZZD.OTHER'
      
        '110241657=                          AND ZZ.OP_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '110241658=                          AND ZZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110241659=                          AND :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||ZZ.G_TOCHKA||'#39#39'-'#39#39
      '110241660=                       )'
      '110241661=           -- '#1060#1048#1051#1068#1058#1056
      
        '110241662=           AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||GP.G_P' +
        'RODUCT||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110241663=                 OR'
      '110241664=                 (:G_CATEGORY_ IS NULL)'
      '110241665=               )'
      
        '110241666=          AND ((:G_PRODUCT_ CONTAINING '#39#39'~'#39#39'||G.G_PROD' +
        'UCT||'#39#39'~'#39#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110241667=                 OR'
      '110241668=                 (:G_PRODUCT_ IS NULL)'
      '110241669=               )'
      '110241670=          AND ((EXISTS (SELECT 1'
      '110241671=                           FROM SKLAD S'
      
        '110241672=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110241673=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110241674=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '110241675=                            AND S.DATE_RECEIPT BETWEEN' +
        ' :DATE_BEGIN_ AND :DATE_END_) AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110241676=                  OR'
      '110241677=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110241678=       ORDER BY 2, 3, 1'
      '110241679=    INTO :REC_G_PRODUCT_,'
      '110241680=        :PATH_,'
      '110241681=        :GNAME_,'
      '110241682=        :REC_AMOUNT_IN_,'
      '110241683=        :REC_AMOUNT_PRIHOD_,'
