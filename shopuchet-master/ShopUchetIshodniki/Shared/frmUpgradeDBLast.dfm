        '1109488=                               T.NAME PATH,       --'#1076#1083#1103' ' +
        #1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '1109489=                               1 LVL'
      '1109490=                          FROM G_PRODUCT T'
      
        '1109491=                         WHERE (T.G_PRODUCT_PAR IS NULL ' +
        'or T.g_product = -1)'
      '1109492=                        UNION ALL'
      
        '1109493=                        SELECT DECODE(T.G_PRODUCT, -1, T' +
        '.G_PRODUCT, 0) SORTT,'
      '1109494=                               T.G_PRODUCT,'
      '1109495=                               T.G_PRODUCT_PAR,'
      '1109496=                               GG.LVL||T.NAME NAME,'
      
        '1109497=                               GG.PATH||'#39' - '#39'||T.NAME,  ' +
        '   --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '1109498=                               GG.LVL + 1 LVL'
      
        '1109499=                          FROM G_PRODUCT T INNER JOIN TR' +
        'EE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '11094100=                         WHERE T.IS_CATEGORY = 1'
      '11094101=                        )'
      '11094102=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '11094103=    */'
      '11094104=END'
      '11094105=;'
      
        '11094106=UPDATE SYSTEM_SETUP SET S_VALUE = 11094 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11094107=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11094108=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110950=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110951=  TYPE_ INTEGER = 0,'
      
        '110952=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR =' +
        ' NULL)'
      '110953=RETURNS ('
      '110954=  SORT_COL DM_BIGINT,'
      '110955=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110956=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '110957=  NAME VARCHAR(500))'
      '110958=AS'
      '110959=DECLARE VARIABLE LVL_ INTEGER;'
      '1109510=BEGIN'
      '1109511='
      '1109512=  IF (COALESCE(TYPE_, 0) = 0) THEN'
      '1109513=      FOR'
      '1109514=        SELECT'
      
        '1109515=            DECODE(T.G_PRODUCT, -1, 0, T.g_product) SORT' +
        '_COL,'
      '1109516=            T.G_PRODUCT,'
      '1109517=            T.G_PRODUCT_PAR,'
      '1109518=            T.NAME,'
      '1109519=            0'
      '1109520=        FROM G_PRODUCT T'
      '1109521=        WHERE T.IS_CATEGORY = 1'
      '1109522=        ORDER BY 1, T.NAME'
      '1109523=        INTO'
      '1109524=            :SORT_COL,'
      '1109525=            :G_PRODUCT,'
      '1109526=            :G_PRODUCT_PAR,'
      '1109527=            :NAME,'
      '1109528=            :LVL_'
      '1109529=      DO'
      '1109530=        suspend;'
      '1109531='
      
        '1109532=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059#1063#1040 +
        #1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '1109533=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054#1044#1048 +
        #1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
        '1109534=  -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1047#1040#1061#1054#1063#1045#1058' '#1044#1045#1058#1054#1050' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1056#1054 +
        #1044#1048#1058#1045#1051#1071#1052', '#1058'.'#1045'. '#1042' '#1058#1054#1052' '#1055#1054#1056#1071#1044#1050#1045', '#1042' '#1050#1040#1050#1054#1052' '#1057#1053#1040#1063#1040#1051#1040' '#1064#1051#1048' '#1056#1054#1044#1048#1058#1045#1051#1048','
      
        '1109535=  -- '#1058#1054' '#1053#1040#1044#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' PATH '#1048' '#1054#1058#1057#1054#1056#1058#1048#1056#1054#1042#1040#1058#1068' '#1055#1054' '#1053#1045#1052#1059', '#1053#1048#1046#1045 +
        ' '#1055#1056#1050#1056#1045#1055#1048#1051' '#1055#1056#1048#1052#1045#1056
      '1109536=  ELSE'
      '1109537=    FOR'
      '1109538=        SELECT'
      
        '1109539=            DECODE(T.G_PRODUCT, -1, 0, T.g_product) SORT' +
        '_COL,'
      '1109540=            T.G_PRODUCT,'
      '1109541=            T.G_PRODUCT_PAR,'
      '1109542=            T.NAME,'
      '1109543=            0'
      '1109544=        FROM G_PRODUCT T'
      '1109545=        WHERE T.IS_CATEGORY = 1'
      '1109546=        ORDER BY T.NAME'
      '1109547=        INTO'
      '1109548=            :SORT_COL,'
      '1109549=            :G_PRODUCT,'
      '1109550=            :G_PRODUCT_PAR,'
      '1109551=            :NAME,'
      '1109552=            :LVL_'
      '1109553=      DO'
      '1109554=        suspend;'
      '1109555=    /*FOR WITH RECURSIVE TREE AS ('
      
        '1109556=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109557=               T.G_PRODUCT,'
      '1109558=               T.G_PRODUCT_PAR,'
      '1109559=               T.NAME,'
      '1109560=               1 LVL'
      '1109561=          FROM G_PRODUCT T'
      
        '1109562=         WHERE ((T.G_PRODUCT_PAR IS NULL or T.g_product ' +
        '= -1) AND :G_PRODUCT_PAR_ IS NULL)'
      '1109563=               OR'
      '1109564=               (T.G_PRODUCT_PAR = :G_PRODUCT_PAR_)'
      '1109565=        UNION ALL'
      
        '1109566=        SELECT DECODE(T.G_PRODUCT, -1, T.G_PRODUCT, 0) S' +
        'ORTT,'
      '1109567=               T.G_PRODUCT,'
      '1109568=               T.G_PRODUCT_PAR,'
      '1109569=               T.NAME,'
      '1109570=               GG.LVL + 1 LVL'
      
        '1109571=          FROM G_PRODUCT T INNER JOIN TREE GG ON GG.G_PR' +
        'ODUCT = T.G_PRODUCT_PAR'
      '1109572=         WHERE T.IS_CATEGORY = 1'
      '1109573=        )'
      '1109574=        SELECT * FROM TREE ORDER BY 1, 5, 3'
      '1109575=        INTO :SORT_COL,'
      '1109576=            :G_PRODUCT,'
      '1109577=            :G_PRODUCT_PAR,'
      '1109578=            :NAME,'
      '1109579=            :LVL_'
      '1109580=    DO'
      '1109581=        suspend;*/'
      '1109582='
      '1109583=    /*'
      
        '1109584=    WITH RECURSIVE TREE AS (SELECT DECODE(T.G_PRODUCT, -' +
        '1, T.G_PRODUCT, 0) SORTT,'
      '1109585=                               T.G_PRODUCT,'
      '1109586=                               T.G_PRODUCT_PAR,'
      
        '1109587=                               DECODE(T.G_PRODUCT, -1, '#39 +
        #1041#1077#1079' '#1075#1088#1091#1087#1087#1099#39', T.NAME) NAME,'
      
        '1109588=                               T.NAME PATH,       --'#1076#1083#1103' ' +
        #1089#1086#1088#1090#1080#1088#1086#1074#1082#1080
      '1109589=                               1 LVL'
      '1109590=                          FROM G_PRODUCT T'
      
        '1109591=                         WHERE (T.G_PRODUCT_PAR IS NULL ' +
        'or T.g_product = -1)'
      '1109592=                        UNION ALL'
      
        '1109593=                        SELECT DECODE(T.G_PRODUCT, -1, T' +
        '.G_PRODUCT, 0) SORTT,'
      '1109594=                               T.G_PRODUCT,'
      '1109595=                               T.G_PRODUCT_PAR,'
      '1109596=                               GG.LVL||T.NAME NAME,'
      
        '1109597=                               GG.PATH||'#39' - '#39'||T.NAME,  ' +
        '   --'#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048
      '1109598=                               GG.LVL + 1 LVL'
      
        '1109599=                          FROM G_PRODUCT T INNER JOIN TR' +
        'EE GG ON GG.G_PRODUCT = T.G_PRODUCT_PAR'
      '11095100=                         WHERE T.IS_CATEGORY = 1'
      '11095101=                        )'
      '11095102=    SELECT * FROM TREE ORDER BY 1, 6, 5'
      '11095103=    */'
      '11095104=END'
      '11095105=;'
      '11095106='
      '11095107=ALTER PROCEDURE P_REP_BILL('
      '11095108=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11095109=  SUMM_DANO_ NUMERIC(15,2),'
      '11095110=  SUMM_SDACHA_ NUMERIC(15,2),'
      '11095111=  CURRENCY_ INTEGER,'
      '11095112=  MODE_ INTEGER,'
      '11095113=  PRINT_SLOGAN_ VARCHAR(80),'
      '11095114=  DECIMAL_ INTEGER)'
      '11095115=RETURNS ('
      '11095116=  FIRM_NAME_ VARCHAR(600),'
      '11095117=  IDN_STR_ VARCHAR(30),'
      '11095118=  FIRM_IDN_ VARCHAR(50),'
      '11095119=  FIRM_ADDRESS_ VARCHAR(550),'
      '11095120=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11095121=  DATE_ VARCHAR(100),'
      '11095122=  PAYMENT_TYPE_ VARCHAR(100),'
      '11095123=  G_CLIENT_NAME_ VARCHAR(300),'
      '11095124=  G_OFFICIAL_FM_ VARCHAR(300),'
      '11095125=  SUMM_VSEGO_ VARCHAR(50),'
      '11095126=  SUMM_VSEGO_N_ VARCHAR(50),'
      '11095127=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11095128=  ROW_NUM INTEGER,'
      '11095129=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11095130=  NAME_ART VARCHAR(1000),'
      '11095131=  AMOUNT VARCHAR(50),'
      '11095132=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11095133=  PRICE VARCHAR(50),'
      '11095134=  PRICE_N VARCHAR(50),'
      '11095135=  SUMM VARCHAR(50),'
      '11095136=  SUMM_N VARCHAR(50),'
      '11095137=  SUMM_POLUCH_ VARCHAR(50),'
      '11095138=  SUMM_SDACH_ VARCHAR(50),'
      '11095139=  SUMM_STR_ VARCHAR(200),'
      '11095140=  SLOGAN_ VARCHAR(80),'
      '11095141=  SUMM_SKIDKA_ VARCHAR(50),'
      '11095142=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11095143=  ERR_CODE NUMERIC(15,2),'
      '11095144=  ERR_MSG VARCHAR(1024))'
      '11095145=AS'
      '11095146=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '11095147=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '11095148=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11095149=DECLARE VARIABLE I INTEGER = 1;'
      
        '11095150=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11095151=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11095152=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.AMOUNT;'
      
        '11095153=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11095154=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      '11095155=BEGIN'
      '11095156=  SLOGAN_ = PRINT_SLOGAN_;'
      '11095157='
      '11095158=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '11095159=  SELECT z.ZAKAZ'
      '11095160=         ,P.NAME'
      
        '11095161=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39 +
        '||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR ' +
        'FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39')|' +
        '|'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '11095162=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '11095163=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COALE' +
        'SCE(O.NM, '#39#39')'
      '11095164=         ,Z.summ_noncash'
      '11095165=         ,Z.summ_cash'
      '11095166=         ,Z.NOTE'
      
        '11095167=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_OF' +
        'FICIAL = O.G_OFFICIAL,'
      '11095168=         G_CLIENT G,'
      '11095169=         G_PAYMENT_TYPE P'
      '11095170=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11095171=     AND Z.G_CLIENT = G.G_CLIENT'
      '11095172=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11095173=    INTO :NUM_'
      '11095174=        ,:PAYMENT_TYPE_'
      '11095175=        ,:DATE_'
      '11095176=        ,:G_CLIENT_NAME_'
      '11095177=        ,:G_OFFICIAL_FM_'
      '11095178=        ,:SUMM_NONCASH_'
      '11095179=        ,:SUMM_CASH_'
      '11095180=        ,:NOTE_'
      '11095181=        ;'
      '11095182='
      '11095183=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '11095184=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '11095185='
      '11095186=  SELECT R.G_FIRM_REKVIZIT,'
      '11095187=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '11095188=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088#1075 +
        '.: '#39'||COALESCE(R.IDN, '#39#39')'
      '11095189=    FROM G_FIRM_REKVIZIT R'
      '11095190=   WHERE R.is_default = 1'
      '11095191=    INTO :G_FIRM_REKVIZIT_,'
      '11095192=         :FIRM_NAME_,'
      '11095193=         :FIRM_IDN_;'
      '11095194='
      '11095195=  SELECT SUM(ZD.AMOUNT),'
      
        '11095196=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCHA' +
        'R(100)),'
      
        '11095197=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2)' +
        ' AS VARCHAR(100)),'
      '11095198=         CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '11095199=  FROM ZAKAZ_DETAILS ZD'
      '11095200=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '11095201=  INTO :AMOUNT_VSEGO_NUM_,'
      '11095202=       :SUMM_SKIDKA_,'
      '11095203=       :SUMM_VSEGO_,'
      '11095204=       :SUMM_VSEGO_N_;'
      '11095205='
      '11095206=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '11095207=    FROM G_FIRM_ADDRESS R'
      '11095208=   WHERE R.IS_DEFAULT = 1'
      '11095209=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '11095210=    INTO :FIRM_ADDRESS_;'
      '11095211='
      
        '11095212=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048#1053 +
        #1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '11095213=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39')' +
        ';'
      '11095214=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '11095215=    IF (CURRENCY_ = 0) THEN'
      '11095216=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '11095217=    ELSE'
      '11095218=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '11095219=  END'
      '11095220='
      '11095221=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '11095222='
      
        '11095223=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(1' +
        '00));'
      
        '11095224=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHAR' +
        '(100));'
      '11095225='
      '11095226=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '11095227=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '11095228=  INTO :SUMM_STR_;'
      '11095229='
      '11095230=  FOR'
      '11095231=    SELECT :I,'
      '11095232=           G.NAME,'
      
        '11095233=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39', '#39 +
        #39'),'
      '11095234=           ZD.AMOUNT,'
      '11095235=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '11095236=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) AS' +
        ' VARCHAR(100))'
      '11095237=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '11095238=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE,' +
        ' 0) AS VARCHAR(100))'
      '11095239=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '11095240=      FROM ZAKAZ Z,'
      '11095241=           ZAKAZ_DETAILS ZD,'
      '11095242=           G_PRODUCT G,'
      '11095243=           G_UNIT U'
      '11095244=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '11095245=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11095246=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11095247=       AND G.G_UNIT = U.G_UNIT'
      '11095248=     ORDER BY ZD.zakaz_details'
      '11095249=    INTO :ROW_NUM,'
      '11095250=        :NAME,'
      '11095251=        :NAME_ART,'
      '11095252=        :AMOUNT_NUM_,'
      '11095253=        :PRICE,'
      '11095254=        :SUMM'
      '11095255=        ,:SHORT_NAME'
      '11095256=        ,:PRICE_N'
      '11095257=        ,:SUMM_N'
      '11095258=  DO BEGIN'
      '11095259=    I = I + 1;'
      '11095260='
      
        '11095261=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' '#1055 +
        #1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '11095262=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '11095263=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FOR' +
        ' POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '11095264=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '11095265=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '11095266=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '11095267=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN PRICE)-1);'
      '11095268=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '11095269=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE_N)-1);'
      '11095270=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '11095271=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSITI' +
        'ON('#39'.00'#39' IN SUMM)-1);'
      '11095272=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '11095273=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM_N)-1);'
      '11095274=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '11095275=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '11095276=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '11095277=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FOR' +
        ' POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '11095278=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '11095279=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '11095280='
      '11095281=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '11095282=    IF (DECIMAL_ = 2) THEN BEGIN'
      '11095283=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '11095284=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,2));'
      '11095285=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '11095286=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '11095287=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,3));'
      '11095288=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '11095289=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '11095290=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,4));'
      '11095291=    END ELSE BEGIN'
      '11095292=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '11095293=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NUM' +
        'ERIC(18,5));'
      '11095294=    END'
      '11095295='
      
        '11095296=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT' +
        ') > 0) then'
      
        '11095297=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POSI' +
        'TION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '11095298='
      
        '11095299=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT' +
        '_VSEGO_) > 0) then'
      
        '11095300=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 F' +
        'OR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '11095301='
      '11095302=    SUSPEND;'
      '11095303=  END'
      '11095304=WHEN ANY DO BEGIN'
      '11095305=    Err_code = -20500;'
      
        '11095306=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11095307=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11095308=  END'
      '11095309=end'
      '11095310=;'
      
