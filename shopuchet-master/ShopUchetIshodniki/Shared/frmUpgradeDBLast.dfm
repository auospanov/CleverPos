        '110206844=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110206845=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110206846=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
