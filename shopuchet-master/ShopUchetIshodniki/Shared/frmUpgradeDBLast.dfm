        #1054#1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1102201345=      IF (IS_VOZVRAT_ = 0) THEN'
      '1102201346=        G_PRIHOD_RASHOD_ = 2;'
      '1102201347=      ELSE'
      '1102201348=        G_PRIHOD_RASHOD_ = 3;'
      '1102201349='
      '1102201350=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '1102201351=            PNT_ = '#39'09'#39';'
      '1102201352=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '1102201353=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_)' +
        ' THEN'
      
        '1102201354=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR P' +
        'OS_TILDA_ - 1);'
      '1102201355=            ELSE'
      
        '1102201356=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR C' +
        'HAR_LENGTH(PAYMENTS_) - 1);'
      '1102201357='
      '1102201358=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '1102201359=                RETURNING_VALUES :KASSA_, :PAYMENT_DA' +
        'TE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102201360='
      
        '1102201361=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (P' +
        'OSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      
        '1102201362=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THE' +
        'N'
      
        '1102201363=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102201364=                                              :G_PRIH' +
        'OD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1102201365=                                              :PAYMEN' +
