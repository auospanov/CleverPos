        '11019450=  G_PRODUCT /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PROD' +
        'UCT */ BIGINT,'
      
        '11019451=  G_PRODUCT_PAR /* TYPE OF COLUMN P_REP_PROFIT_TABLE.G_' +
        'PRODUCT_PAR */ BIGINT,'
      
        '11019452=  TOVAR_NAME /* TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR' +
        '_NAME */ VARCHAR(500),'
      
        '11019453=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11019454=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11019455=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(150),'
      '11019456=  AMOUNT /* MY_NUMERIC_5 */ NUMERIC(18,5),'
