      '110243592='
      '110243593=ALTER PROCEDURE G_NONCASH_PAY_TYPE_INS('
      '110243594=  NAME_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110243595=  IS_TIS_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_TI' +
        'S_TYPE = 0,'
      
        '110243596=  POS_TERMINAL_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.POS_TERMINAL_TYPE = 0)'
      '110243597=RETURNS ('
      
        '110243598=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE)'
      '110243599=AS'
      '110243600=BEGIN'
