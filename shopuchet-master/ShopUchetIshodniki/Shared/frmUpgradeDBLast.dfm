        'UCT)) SUMM_UHOD_SKL,'
      '1102015145=               -- '#1048#1057#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '1102015146=               (select (select COALESCE(sum(amount), ' +
        '0) from lt_sklad_product where g_product = G.G_PRODUCT'
      
        '1102015147=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||g_tochka||'#39'-'#39')'
      '1102015148=                        +  -- '#1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080
      
