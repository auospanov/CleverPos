        '110192411=        LOG_ = LOG_ || STR1_||'#39' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1082#1086#1084#1087#1083#1077#1082#1090#1086#1084' '#1076#1083 +
        #1103' '#1090#1086#1074#1072#1088#1072'(-'#1086#1074') '#39'||PROD_NAME_||'#39'.'#39'||CRLF;'
      '110192412=        FAIL_CNT_ = FAIL_CNT_ + 1;'
      '110192413=        UPDATE G_PRODUCT D'
