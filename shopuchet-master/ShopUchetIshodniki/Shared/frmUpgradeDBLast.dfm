        'SITION 17;'
      '1107079='
      '1107080='
      
        '1107081=/*******************************************************' +
        '***********************/'
      
        '1107082=/****            Altering stored procedures (with empty ' +
        'bodies)            ****/'
      
        '1107083=/*******************************************************' +
        '***********************/'
      '1107084='
      '1107085=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      
        '1107086=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      
        '1107087=  G_CLIENT_CAT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT */ BIGINT,'
      
        '1107088=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */' +
        ' BIGINT,'
      '1107089=  DATE_BEGIN_ DATE,'
      '1107090=  DATE_END_ DATE,'
      '1107091=  TIME_BEGIN_ TIME,'
      '1107092=  TIME_END_ TIME,'
      '1107093=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1107094=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1107095=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1107096=RETURNS ('
      
        '1107097=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUMER' +
        'IC(18,5),'
      
        '1107098=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERIC' +
        '(15,2),'
      
        '1107099=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(1' +
        '5,2),'
      
        '11070100=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOU' +
        'NT_TENGE */ NUMERIC(15,2),'
      
        '11070101=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_SUMM */ NUMERIC(15,2),'
      
        '11070102=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHA' +
        'R(250),'
      
        '11070103=  PAYMENT_NAME /* TYPE OF COLUMN G_PAYMENT_TYPE.NAME */' +
        ' VARCHAR(256),'
      
        '11070104=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      
        '11070105=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11070106=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11070107=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      '11070108=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      '11070109=  Z_DATE BLOB SUB_TYPE 1,'
      '11070110=  ROW INTEGER,'
      '11070111=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '11070112=  ERR_CODE INTEGER,'
      '11070113=  ERR_MSG VARCHAR(1024))'
      '11070114=AS'
      '11070115=BEGIN'
      '11070116=  SUSPEND;'
      '11070117=END'
      '11070118=;'
      '11070119='
      '11070120='
      
        '11070121=/******************************************************' +
        '************************/'
      
        '11070122=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11070123=/******************************************************' +
        '************************/'
      '11070124=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '11070125=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11070126=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARENT' +
        ','
      '11070127=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11070128=  DATE_BEGIN_ DATE,'
      '11070129=  DATE_END_ DATE,'
      '11070130=  TIME_BEGIN_ TIME,'
      '11070131=  TIME_END_ TIME,'
      '11070132=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11070133=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11070134=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11070135=RETURNS ('
      '11070136=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11070137=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11070138=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '11070139=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'TENGE,'
      
        '11070140=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_S' +
        'UMM,'
      '11070141=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11070142=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '11070143=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11070144=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11070145=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11070146=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11070147=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11070148=  Z_DATE BLOB SUB_TYPE 1,'
      '11070149=  ROW INTEGER,'
      '11070150=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '11070151=  ERR_CODE INTEGER,'
      '11070152=  ERR_MSG VARCHAR(1024))'
      '11070153=AS'
      
        '11070154=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_L' +
        'IST'#39';'
      '11070155=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11070156=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '11070157=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE 8' +
        '0;'
      
        '11070158=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTI' +
        'CUL;'
      
        '11070159=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BARC' +
        'ODE;'
      
        '11070160=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PROD' +
        'UCT.BARCODE;'
      
        '11070161=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '11070162=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11070163=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.NAME;'
      
        '11070164=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.N' +
        'AME;'
      
        '11070165=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '11070166=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M = 0;'
      
        '11070167=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11070168=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '11070169=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11070170=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM = 0;'
      
        '11070171=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11070172=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '11070173=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '11070174=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.P' +
        'ATH = '#39#39';'
      '11070175=DECLARE VARIABLE I INTEGER = 1;'
      '11070176=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      '11070177=BEGIN'
      '11070178=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '11070179=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '11070180='
      
        '11070181=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') || ' +
        #39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extrac' +
        't(year from Z.Z_DATE),'
      '11070182=             Z.Z_TIME,'
      '11070183=             GP.ARTICUL,'
      '11070184=             GP.BARCODE,'
      '11070185=             GP.NOMENCLATUR_NUM,'
      '11070186=             GP.NAME,'
      '11070187=             ZD.AMOUNT,'
      '11070188=             ZD.PRICE,'
      '11070189=             ZD.DISCOUNT_TENGE,'
      '11070190=             ZD.SUMM,'
      '11070191=             ZD.DISCOUNT_SUMM,'
      '11070192=             GC.NAME,'
      '11070193=             P.NAME,'
      '11070194=             TR.PATH,'
      '11070195=             Z.NOTE'
      '11070196=      FROM ZAKAZ Z,'
      '11070197=           ZAKAZ_DETAILS ZD,'
      '11070198=           G_CLIENT GC,'
      '11070199=           G_PAYMENT_TYPE P,'
      '11070200=           G_PRODUCT GP,'
      '11070201=           P_REP_TREE TR'
      
        '11070202=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '11070203=       AND Z.IS_SPISANIE IN (0,2)'
      '11070204=       AND Z.IS_RESERVE = 0'
      '11070205=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11070206=       AND Z.G_CLIENT = GC.G_CLIENT'
      '11070207=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11070208=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11070209=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '11070210=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11070211=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(Z' +
        '.G_CLIENT, 1))'
      
        '11070212=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT_' +
        ', GC.G_CLIENT_PARENT)'
      
        '11070213=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '11070214=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_ AND :TIME_BEGIN_ IS NULL)'
      '11070215=            OR'
      
        '11070216=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGIN' +
        '_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN_' +
        ' IS NOT NULL)'
      '11070217=           )/*'
      
        '11070218=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_EN' +
        'D_ AND :TIME_BEGIN_ IS NOT NULL)'
      '11070219=            OR'
      '11070220=            :TIME_BEGIN_ IS NULL)*/'
      
        '11070221=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11070222=             OR'
      '11070223=             (:G_CATEGORY_ IS NULL)'
      '11070224=           )'
      
        '11070225=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT||' +
        #39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11070226=             OR'
      '11070227=            (:G_PRODUCT_ IS NULL)'
      '11070228=           )'
      '11070229=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '11070230=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :NO' +
        'MENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '11070231=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, :C' +
        'LIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_'
      '11070232=  DO BEGIN'
      '11070233=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '11070234=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11070235=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11070236=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "D' +
        'ATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '11070237=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_,' +
        ' :DISCOUNT_SUMM_ROLL_, 1);'
      '11070238='
      '11070239=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11070240=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11070241=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + D' +
        'ISCOUNT_SUMM_ROLL_;'
      '11070242=            SUMM_ROLL_ = 0;'
      '11070243=            DISCOUNT_SUMM_ROLL_ = 0;'
      '11070244=            I = I + 1;'
      '11070245=        END'
      '11070246='
      '11070247=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11070248=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE"' +
        ', ROW)'
      '11070249=        VALUES (:I, :PATH_, 1);'
      '11070250=        I = I + 1;'
      '11070251=    END'
      '11070252='
      
        '11070253=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "T' +
        'IME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, DI' +
        'SCOUNT, SUMM,'
      
        '11070254=                                         DISCOUNT_SUMM,' +
        ' CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW)'
      
        '11070255=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE' +
        '_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT' +
        '_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      '11070256=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0);'
      '11070257='
      '11070258=    I = I + 1;'
      '11070259=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '11070260=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOUN' +
        'T_SUMM_;'
      '11070261=    LAST_PATH_ = PATH_;'
      '11070262=  END'
      '11070263='
      '11070264=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11070265=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11070266=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOUNT' +
        '_SUMM_ROLL_, 1);'
      '11070267='
      '11070268=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11070269=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11070270=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_SU' +
        'MM_ROLL_;'
      '11070271='
      
        '11070272=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11070273=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL_,' +
        ' 2);'
      '11070274='
      
        '11070275=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCLA' +
        'TUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CLI' +
        'ENT_NAME,'
      '11070276=             PAYMENT_TYPE, ROW, NOTE'
      '11070277=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '11070278=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOMEN' +
        'CLATUR_NUM, :TOVAR_NAME,'
      
        '11070279=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :DI' +
        'SCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      '11070280=           :NOTE'
      '11070281=  do suspend;'
      '11070282='
      '11070283=WHEN ANY DO BEGIN'
      '11070284=    Err_code = -20500;'
      
        '11070285=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11070286=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11070287=  END'
      '11070288=end'
      '11070289=;'
      
        '11070290=UPDATE SYSTEM_SETUP SET S_VALUE = 11070 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11070291=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11070292=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110710=ALTER PROCEDURE G_GET_G_CLIENT('
      
        '110711=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGINT' +
        ')'
      '110712=RETURNS ('
      
        '110713=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT */ BIGINT,'
      
        '110714=  G_CONTRAGENT_ /* TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT */ BIGINT,'
      '110715=  NAME_ VARCHAR(500),'
      
        '110716=  NAME_FULL_ /* TYPE OF COLUMN G_CLIENT.NAME_FULL */ VARC' +
        'HAR(250),'
      '110717=  IDN_ VARCHAR(12),'
      '110718=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50),'
      '110719=  KBE_ VARCHAR(5),'
      '1107110=  SKIDKA_ NUMERIC(15,2),'
      '1107111=  BY_DEFAULT_ INTEGER,'
      '1107112=  IS_BEZNAL_ INTEGER,'
      
        '1107113=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '1107114=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      
        '1107115=  SUMM_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM */ NUMERIC' +
        '(15,2),'
      
        '1107116=  SUMM_ALL_ /* TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL */' +
        ' NUMERIC(15,2),'
      '1107117=  NOTE_ /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200),'
      '1107118=  DT_ /* TYPE OF COLUMN G_CLIENT.DT */ DATE,'
      
        '1107119=  G_PROMOTION_ /* TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ' */ BIGINT,'
      
        '1107120=  G_PROMOTION_STR_ /* TYPE OF COLUMN G_PROMOTION.NAME */' +
        ' VARCHAR(150),'
      '1107121=  NOTIFY_SKIDKA_ INTEGER,'
      '1107122=  NOTIFY_DR_ INTEGER,'
      '1107123=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      
        '1107124=  G_CLIENT_PROMO_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */' +
        ' BIGINT,'
      '1107125=  FM_PROMO_ VARCHAR(50),'
      '1107126=  ERR_CODE INTEGER,'
      '1107127=  ERR_MSG VARCHAR(1024))'
      '1107128=AS'
      '1107129=BEGIN'
      '1107130=  SUSPEND;'
      '1107131=END'
      '1107132=;'
      '1107133='
      '1107134=ALTER PROCEDURE G_INS_G_CLIENT('
      
        '1107135=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT *' +
        '/ BIGINT,'
      
        '1107136=  G_CONTRAGENT_ /* TYPE OF COLUMN G_CONTRAGENT.G_CONTRAG' +
        'ENT */ BIGINT,'
      '1107137=  NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHAR(250),'
      
        '1107138=  NAME_FULL_ /* TYPE OF COLUMN G_CLIENT.NAME_FULL */ VAR' +
        'CHAR(250),'
      '1107139=  IDN_ VARCHAR(12),'
      '1107140=  KBE_ VARCHAR(5),'
      '1107141=  SKIDKA_ NUMERIC(15,2),'
      
        '1107142=  PHONE_ /* TYPE OF COLUMN G_CLIENT.PHONE */ VARCHAR(50)' +
        ','
      '1107143=  DT_ /* TYPE OF COLUMN G_CLIENT.DT */ DATE,'
      '1107144=  BY_DEFAULT_ INTEGER,'
      '1107145=  IS_SUPPLIER_ INTEGER,'
      '1107146=  IS_CATEGORY_ INTEGER,'
      '1107147=  IS_BEZNAL_ INTEGER,'
      
        '1107148=  BARCODE_ /* TYPE OF COLUMN G_DISCONT_CARD.BARCODE */ V' +
        'ARCHAR(13),'
      
        '1107149=  N_PERCENT_ /* TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT ' +
        '*/ NUMERIC(15,2),'
      '1107150=  NOTE_ /* TYPE OF COLUMN G_CLIENT.NOTE */ VARCHAR(200),'
      
        '1107151=  G_PROMOTION_ /* TYPE OF COLUMN G_PROMOTION.G_PROMOTION' +
        ' */ BIGINT,'
      '1107152=  NOTIFY_SKIDKA_ INTEGER,'
      '1107153=  NOTIFY_DR_ INTEGER,'
      '1107154=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      
        '1107155=  G_CLIENT_PROMO_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */' +
        ' BIGINT)'
      '1107156=RETURNS ('
      
        '1107157=  G_CLIENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      '1107158=  ERR_CODE INTEGER,'
      '1107159=  ERR_MSG VARCHAR(1024))'
      '1107160=AS'
      '1107161=BEGIN'
      '1107162=  SUSPEND;'
      '1107163=END'
      '1107164=;'
      '1107165='
      '1107166=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '1107167=  G_CLIENT_PARENT_ /* TYPE OF COLUMN G_CLIENT.G_CLIENT_P' +
        'ARENT */ BIGINT,'
      '1107168=  IS_SUPPLIER_ INTEGER = NULL)'
      '1107169=RETURNS ('
      
        '1107170=  G_CLIENT /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGINT' +
        ','
      
        '1107171=  G_CLIENT_PARENT /* TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT */ BIGINT,'
      
        '1107172=  G_CONTRAGENT /* TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGE' +
        'NT */ BIGINT,'
      '1107173=  NAME VARCHAR(500),'
