      '110491039=    END'
      '110491040='
      
        '110491041=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '110491042=      VALUES (22, 2, :DATE_STR, :z_date, :NAME, :SUMM)' +
        ';'
      '110491043='
      '110491044=    SUMM_PRIHOD_ = SUMM_PRIHOD_ + SUMM;'
      '110491045=  END'
      '110491046='
      '110491047=  IF (FIRST_ITER = 1) THEN'
      
        '110491048=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, SUMM)'
      
        '110491049=    VALUES (23, 3, '#39#39#1048#1090#1086#1075#1086' '#1087#1088#1080#1093#1086#1076' '#1076#1077#1085#1077#1075#39#39', :SUMM_PRIHO' +
        'D_);'
      '110491050=  SUMM_PRIHOD_ALL_ = SUMM_PRIHOD_ALL_ + SUMM_PRIHOD_;'
      '110491051='
      '110491052=  -- '#1056#1040#1057#1061#1054#1044' '#1044#1045#1053#1045#1043' '#1048#1047' '#1050#1040#1057#1057#1067
      '110491053=  FIRST_ITER = 0;'
      '110491054=  SUMM_RASHOD_ = 0;'
      
        '110491055=  FOR SELECT lpad(EXTRACT(DAY FROM K.action_date), 2, ' +
        #39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39#39'0'#39#39')' +
        '||'#39#39'.'#39#39'||EXTRACT(YEAR FROM K.action_date),'
      '110491056=             K.action_date,'
      
        '110491057=             G.name||DECODE(CHAR_LENGTH(K.NOTE), 0, '#39#39 +
        #39#39', '#39#39' ('#39#39'||K.NOTE||'#39#39')'#39#39')'
      '110491058=             ,SUM(K.summ)'
      '110491059=        FROM KASSA k, g_prihod_rashod G'
      
        '110491060=        WHERE K.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110491061=         AND K.ACTION = 1'
      
        '110491062=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '110491063=         AND K.g_prihod_rashod = G.g_prihod_rashod'
      '110491064=         AND K.g_tochka = :G_TOCHKA_'
      '110491065=        GROUP BY 2, 3'
      '110491066=        UNION ALL'
      
        '110491067=        SELECT lpad(EXTRACT(DAY FROM K.action_date), 2' +
        ', '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM K.action_date), 2, '#39#39'0'#39 +
        #39')||'#39#39'.'#39#39'||EXTRACT(YEAR FROM K.action_date),'
      '110491068=             K.action_date,'
      '110491069=             '#39#39#1054#1087#1083#1072#1090#1072' '#1076#1086#1083#1075#1072' '#1082#1083#1080#1077#1085#1090#1091'/'#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091#39#39' name'
      '110491070=             ,SUM(K.summ)'
      '110491071=        FROM KASSA k'
      '110491072=        WHERE K.G_PRIHOD_RASHOD in (2,3)'
      
        '110491073=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '110491074=         AND K.action_date <> (SELECT DATE_RECEIPT FRO' +
        'M SKLAD_PARENT WHERE SKLAD = K.sklad)'
      '110491075=         AND K.g_tochka = :G_TOCHKA_'
      '110491076=        GROUP BY 2, 3'
      '110491077=        INTO :date_str,'
      '110491078=           :Z_DATE,'
      '110491079=           :NAME,'
      '110491080=           :SUMM'
      '110491081=  DO BEGIN'
      '110491082=    IF (FIRST_ITER = 0) THEN BEGIN'
      
        '110491083=      INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_CO' +
        'L, Z_DATE_STR)'
      '110491084=      VALUES (24, 1, '#39#39#1056#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075' '#1080#1079' '#1082#1072#1089#1089#1099#39#39');'
      '110491085=      FIRST_ITER = 1;'
      '110491086=    END'
      '110491087='
      
        '110491088=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, Z_DATE, NAME, SUMM)'
      
        '110491089=      VALUES (25, 2, :DATE_STR, :z_date, :NAME, :SUMM)' +
        ';'
      '110491090='
      '110491091=    SUMM_RASHOD_ = SUMM_RASHOD_ + SUMM;'
      '110491092=  END'
      '110491093='
      '110491094=  IF (FIRST_ITER = 1) THEN'
      
        '110491095=    INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL,' +
        ' Z_DATE_STR, SUMM)'
      
        '110491096=    VALUES (26, 3, '#39#39#1048#1090#1086#1075#1086' '#1088#1072#1089#1093#1086#1076' '#1076#1077#1085#1077#1075#39#39', :SUMM_RASHO' +
        'D_);'
      '110491097=  SUMM_RASHOD_ALL_ = SUMM_RASHOD_ALL_ + SUMM_RASHOD_;'
      '110491098='
      '110491099=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL)'
      '110491100=  VALUES(27, 1);'
      '110491101='
      
        '110491102=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110491103=  VALUES (28, 1, '#39#39#1048#1090#1086#1075#1086' '#1087#1086#1089#1090#1091#1087#1083#1077#1085#1080#1081' '#1074' '#1082#1072#1089#1089#1091' '#1085#1072' '#1089#1091#1084#1084#1091#39 +
        #39', :SUMM_PRIHOD_ALL_);'
      '110491104='
      
        '110491105=  INSERT INTO P_REP_KASSIR_TABLE (SORT_COL, ROW_COL, Z' +
        '_DATE_STR, SUMM)'
      
        '110491106=  VALUES (29, 1, '#39#39#1048#1090#1086#1075#1086' '#1091#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1085#1072' '#1089#1091#1084#1084#1091#39#39', :SU' +
        'MM_RASHOD_ALL_);'
      '110491107='
      '110491108=  FOR SELECT SORT_COL'
      '110491109=            ,ROW_COL'
      '110491110=            ,Z_DATE'
      '110491111=            ,Z_DATE_STR'
      '110491112=            ,ARTICUL'
      '110491113=            ,BARCODE'
      '110491114=            ,NAME'
      '110491115=            ,AMOUNT'
      '110491116=            ,SUMM'
      '110491117=        FROM P_REP_KASSIR_TABLE'
      '110491118=    ORDER BY 1, 3, 7'
      '110491119=    INTO :SORT_COL,'
      '110491120=        :ROWCOL,'
      '110491121=        :Z_DATE_LOC,'
      '110491122=        :Z_DATE,'
      '110491123=        :ARTICUL,'
      '110491124=        :BARCODE,'
      '110491125=        :NAME,'
      '110491126=        :AMOUNT,'
      '110491127=        :SUMM'
      '110491128=  DO'
      '110491129=    suspend;'
      '110491130=end'
      '110491131='#39';'
      '110491132=END  --END_EXECUTE_BLOCK'
      '110491133=EXECUTE BLOCK AS BEGIN'
      '110491134='
      '110491135='
      '110491136=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_OFFICIAL('
      '110491137=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL)'
      '110491138=RETURNS ('
      '110491139=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110491140=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110491141=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110491142=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110491143=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110491144=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110491145=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110491146=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110491147=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110491148=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110491149=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110491150=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110491151=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110491152=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110491153=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110491154=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110491155=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110491156=  RIGHTS_ARR_ VARCHAR(1000),'
      '110491157=  ERR_CODE INTEGER,'
      '110491158=  ERR_MSG VARCHAR(1024))'
      '110491159=AS'
      
        '110491160=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      '110491161=begin'
      
        '110491162=    select FM, NM, FT, FIO_DOC, RNN, IDN, DT, G_ID_KIN' +
        'D, ID_NUM, ID_DATE, ID_ISSUER, G_APPOINTMENT,'
      
        '110491163=           IS_RUKOVODITEL, IS_GLAVBUH, IS_ISPOLNITEL, ' +
        'PASS, G_TOCHKA'
      '110491164=    from G_OFFICIAL'
      '110491165=    where G_OFFICIAL = :G_OFFICIAL_'
      
        '110491166=    into :FM_, :NM_, :FT_, :FIO_DOC_, :RNN_, :IDN_, :D' +
        'T_, :G_ID_KIND_, :ID_NUM_, :ID_DATE_, :ID_ISSUER_, :G_APPOINTMEN' +
        'T_,'
      
        '110491167=         :IS_RUKOVODITEL_, :IS_GLAVBUH_, :IS_ISPOLNITE' +
        'L_, :PASSWORD_, :G_TOCHKA_;'
      '110491168='
      '110491169=    -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1052#1040#1057#1057#1048#1042' '#1055#1056#1040#1042
      '110491170=    FOR SELECT RIGHTS_ITEM'
      '110491171=        FROM G_OFFICIAL_RIGHT'
      '110491172=       WHERE G_OFFICIAL = :G_OFFICIAL_'
      '110491173=        INTO :RIGHTS_ITEM_'
      '110491174=    DO BEGIN'
      '110491175=      if (RIGHTS_ARR_ IS NULL) then'
      
        '110491176=        RIGHTS_ARR_ = '#39#39'-'#39#39'||CAST(RIGHTS_ITEM_ AS VARC' +
        'HAR(5))||'#39#39'-'#39#39';'
      '110491177=      ELSE'
      
        '110491178=        RIGHTS_ARR_ = RIGHTS_ARR_||CAST(RIGHTS_ITEM_ A' +
        'S VARCHAR(5))||'#39#39'-'#39#39';'
      '110491179=    END'
      '110491180=end'
      '110491181='#39';'
      '110491182='
      '110491183=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_OFFICIAL('
      '110491184=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110491185=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110491186=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110491187=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110491188=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110491189=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110491190=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110491191=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110491192=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110491193=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110491194=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110491195=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110491196=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110491197=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110491198=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110491199=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110491200=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110491201=  RIGHTS_ARR_ VARCHAR(500))'
      '110491202=RETURNS ('
      '110491203=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110491204=  ERR_CODE INTEGER,'
      '110491205=  ERR_MSG VARCHAR(1024))'
      '110491206=AS'
      
        '110491207=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110491208=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110491209=begin'
      '110491210='
      
        '110491211=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110491212=      UPDATE G_OFFICIAL G'
      '110491213=         SET G.IS_ISPOLNITEL = 0;'
      '110491214='
      
        '110491215=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110491216=      UPDATE G_OFFICIAL G'
      '110491217=         SET G.IS_RUKOVODITEL = 0;'
      '110491218='
      
        '110491219=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110491220=      UPDATE G_OFFICIAL G'
      '110491221=         SET G.IS_GLAVBUH = 0;'
      '110491222='
      
        '110491223=    insert into G_OFFICIAL (G_OFFICIAL, FM, NM, FT, FI' +
        'O_DOC, RNN, IDN, DT, G_ID_KIND, ID_NUM, ID_DATE, ID_ISSUER,'
      
        '110491224=                            G_APPOINTMENT, IS_RUKOVODI' +
        'TEL, IS_GLAVBUH, IS_ISPOLNITEL, PASS, G_TOCHKA)'
      
        '110491225=    values (GEN_ID(GEN_G_OFFICIAL, 1), :FM_, :NM_, :FT' +
        '_, :FIO_DOC_, :RNN_, :IDN_, :DT_, :G_ID_KIND_, :ID_NUM_, :ID_DAT' +
        'E_, :ID_ISSUER_,'
      
        '110491226=            :G_APPOINTMENT_, :IS_RUKOVODITEL_, :IS_GLA' +
        'VBUH_, :IS_ISPOLNITEL_, :PASSWORD_, :G_TOCHKA_)'
      '110491227=    returning G_OFFICIAL'
      '110491228=    into :G_OFFICIAL_;'
      '110491229='
      '110491230=    FOR SELECT T.RIGHTS_ITEM'
      '110491231=        FROM RIGHTS_ITEM T'
      '110491232=       WHERE T.IS_CATEGORY = 0'
      
        '110491233=         AND :RIGHTS_ARR_ CONTAINING '#39#39'-'#39#39'||T.RIGHTS_I' +
        'TEM||'#39#39'-'#39#39
      '110491234=        INTO :RIGHTS_ITEM_'
      '110491235=    DO BEGIN'
      
        '110491236=      INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT, ' +
        'RIGHTS_ITEM, G_OFFICIAL)'
      
        '110491237=      VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGHTS' +
        '_ITEM_, :G_OFFICIAL_);'
      '110491238=    END'
      '110491239='
      
        '110491240=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110491241=    SELECT COUNT(G.G_OFFICIAL)'
      '110491242=      FROM G_OFFICIAL G'
      '110491243=     WHERE EXISTS (SELECT 1'
      '110491244=                     FROM G_OFFICIAL_RIGHT R'
      '110491245=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110491246=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110491247=    INTO :CNT_;'
      '110491248='
      '110491249=    IF (:CNT_ = 0) THEN BEGIN'
      '110491250=      ERR_CODE = -20500;'
      
        '110491251=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1086#1073#1093#1086 +
        #1076#1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087 +
        #1088#1072#1074#1072'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '110491252=      EXIT;'
      '110491253=    END'
      '110491254=end'
      '110491255='#39';'
      '110491256='
      '110491257=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_OFFICIAL('
      '110491258=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110491259=  FM_ TYPE OF COLUMN G_OFFICIAL.FM,'
      '110491260=  NM_ TYPE OF COLUMN G_OFFICIAL.NM,'
      '110491261=  FT_ TYPE OF COLUMN G_OFFICIAL.FT,'
      '110491262=  FIO_DOC_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110491263=  RNN_ TYPE OF COLUMN G_OFFICIAL.RNN,'
      '110491264=  IDN_ TYPE OF COLUMN G_OFFICIAL.IDN,'
      '110491265=  DT_ TYPE OF COLUMN G_OFFICIAL.DT,'
      '110491266=  G_ID_KIND_ TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '110491267=  ID_NUM_ TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '110491268=  ID_DATE_ TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '110491269=  ID_ISSUER_ TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '110491270=  G_APPOINTMENT_ TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '110491271=  IS_RUKOVODITEL_ TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '110491272=  IS_GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      
        '110491273=  IS_ISPOLNITEL_ TYPE OF COLUMN G_OFFICIAL.IS_ISPOLNIT' +
        'EL,'
      '110491274=  PASSWORD_ TYPE OF COLUMN G_OFFICIAL.PASS,'
      '110491275=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110491276=  RIGHTS_ARR_ VARCHAR(500))'
      '110491277=RETURNS ('
      '110491278=  ERR_CODE INTEGER,'
      '110491279=  ERR_MSG VARCHAR(1024))'
      '110491280=AS'
      
        '110491281=DECLARE VARIABLE RIGHTS_ITEM_ TYPE OF COLUMN RIGHTS_IT' +
        'EM.RIGHTS_ITEM;'
      
        '110491282=DECLARE VARIABLE CNT_ TYPE OF COLUMN RIGHTS_ITEM.RIGHT' +
        'S_ITEM;'
      '110491283=begin'
      
        '110491284=    IF (:IS_ISPOLNITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ' +
        '1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110491285=      UPDATE G_OFFICIAL G'
      '110491286=         SET G.IS_ISPOLNITEL = 0;'
      '110491287='
      
        '110491288=    IF (:IS_RUKOVODITEL_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071 +
        ' 1, '#1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1056#1059#1050#1054#1042#1054#1044#1048#1058#1045#1051#1068' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110491289=      UPDATE G_OFFICIAL G'
      '110491290=         SET G.IS_RUKOVODITEL = 0;'
      '110491291='
      
        '110491292=    IF (:IS_GLAVBUH_ = 1) THEN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' 1, ' +
        #1058#1054' '#1059' '#1042#1057#1045#1061' '#1059#1041#1048#1056#1040#1070', '#1058'.'#1050'. '#1043#1051#1040#1042#1041#1059#1061' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1054#1044#1048#1053
      '110491293=      UPDATE G_OFFICIAL G'
      '110491294=         SET G.IS_GLAVBUH = 0;'
      '110491295='
      '110491296=    update G_OFFICIAL'
      '110491297=    set FM = :FM_,'
      '110491298=        NM = :NM_,'
      '110491299=        FT = :FT_,'
      '110491300=        FIO_DOC = :FIO_DOC_,'
      '110491301=        RNN = :RNN_,'
      '110491302=        IDN = :IDN_,'
      '110491303=        DT = :DT_,'
      '110491304=        G_ID_KIND = :G_ID_KIND_,'
      '110491305=        ID_NUM = :ID_NUM_,'
      '110491306=        ID_DATE = :ID_DATE_,'
      '110491307=        ID_ISSUER = :ID_ISSUER_,'
      '110491308=        G_APPOINTMENT = :G_APPOINTMENT_,'
      '110491309=        IS_RUKOVODITEL = :IS_RUKOVODITEL_,'
      '110491310=        IS_GLAVBUH = :IS_GLAVBUH_,'
      '110491311=        IS_ISPOLNITEL = :IS_ISPOLNITEL_,'
      '110491312=        PASS = :PASSWORD_,'
      '110491313=        G_TOCHKA = :G_TOCHKA_'
      '110491314=    where (G_OFFICIAL = :G_OFFICIAL_);'
      '110491315='
      
        '110491316=    DELETE FROM G_OFFICIAL_RIGHT WHERE G_OFFICIAL = :G' +
        '_OFFICIAL_;'
      '110491317=    FOR SELECT T.RIGHTS_ITEM'
      '110491318=        FROM RIGHTS_ITEM T'
      '110491319=       WHERE T.IS_CATEGORY = 0'
      
        '110491320=         AND :RIGHTS_ARR_ CONTAINING '#39#39'-'#39#39'||T.RIGHTS_I' +
        'TEM||'#39#39'-'#39#39
      '110491321=        INTO :RIGHTS_ITEM_'
      '110491322=    DO BEGIN'
      
        '110491323=        INSERT INTO G_OFFICIAL_RIGHT (G_OFFICIAL_RIGHT' +
        ', RIGHTS_ITEM, G_OFFICIAL)'
      
        '110491324=        VALUES (GEN_ID(GEN_G_OFFICIAL_RIGHT, 1), :RIGH' +
        'TS_ITEM_, :G_OFFICIAL_);'
      '110491325=    END'
      '110491326='
      
        '110491327=    -- '#1045#1057#1058#1068' '#1051#1048' '#1061#1054#1058#1068' '#1054#1044#1048#1053' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1057#1054' '#1042#1057#1045#1052#1048' '#1055#1056#1040#1042#1040#1052#1048 +
        ', '#1048#1053#1040#1063#1045' '#1054#1053' '#1057#1040#1052' '#1055#1054#1058#1054#1052' '#1047#1040#1049#1058#1048' '#1053#1045' '#1057#1052#1054#1046#1045#1058' '#1048' '#1048#1057#1055#1056#1040#1042#1048#1058#1068
      '110491328=    SELECT COUNT(G.G_OFFICIAL)'
      '110491329=      FROM G_OFFICIAL G'
      '110491330=     WHERE EXISTS (SELECT 1'
      '110491331=                     FROM G_OFFICIAL_RIGHT R'
      '110491332=                    WHERE G.G_OFFICIAL = R.G_OFFICIAL'
      
        '110491333=                    HAVING COUNT(R.G_OFFICIAL_RIGHT) =' +
        ' (SELECT COUNT(*) FROM RIGHTS_ITEM WHERE IS_CATEGORY = 0))'
      '110491334=    INTO :CNT_;'
      '110491335='
      '110491336=    IF (:CNT_ = 0) THEN BEGIN'
      '110491337=      ERR_CODE = -20500;'
      
        '110491338=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1053#1077#1086#1073#1093#1086 +
        #1076#1080#1084' '#1093#1086#1090#1100' '#1086#1076#1080#1085' '#1089#1086#1090#1088#1091#1076#1085#1080#1082', '#1086#1073#1083#1072#1076#1072#1102#1097#1080#1081' '#1042#1057#1045#1052#1048' '#1087#1088#1072#1074#1072#1084#1080'! '#1059#1082#1072#1078#1080#1090#1077' '#1074#1089#1077' '#1087 +
        #1088#1072#1074#1072'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      '110491339=      EXIT;'
      '110491340=    END'
      '110491341=end'
      '110491342='#39';'
      
        '110491343=UPDATE SYSTEM_SETUP SET S_VALUE = 11049 WHERE SYSTEM_S' +
        'ETUP = 3;'
      '110491344=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110500=EXECUTE BLOCK AS BEGIN'
      '110501=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '110502=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110503=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110504=  MODE_ INTEGER)'
      '110505=RETURNS ('
      '110506=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '110507=AS'
      
        '110508=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S_V' +
        'ALUE;'
      '110509=BEGIN'
      '1105010=  IF (G_TOCHKA_ IS NULL) THEN'
      '1105011=    SELECT ID'
      '1105012=      FROM CUR_PARAMS'
      '1105013=     WHERE CUR_PARAMS = 2'
      '1105014=      INTO :G_TOCHKA_;'
      '1105015='
      '1105016=  if (COALESCE(MODE_, 0) = 0) then'
      '1105017=      SELECT S.PRICE'
      '1105018=        FROM SKLAD S'
      '1105019=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1105020=         AND S.IS_LAST = 1'
      '1105021=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1105022=        INTO :PRICE_;'
      '1105023='
      
        '1105024=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047#1040#1042 +
        #1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '1105025=  ELSE BEGIN'
      '1105026=    SELECT S.S_VALUE'
      '1105027=      FROM SYSTEM_SETUP S'
      '1105028=     WHERE S.SYSTEM_SETUP = 1'
      '1105029=      INTO :FORMULA_;'
      '1105030='
      '1105031=    IF (FORMULA_ = 1) THEN BEGIN'
      '1105032=      SELECT S.PRICE'
      '1105033=        FROM SKLAD S'
      '1105034=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '1105035=         AND S.IS_LAST = 1'
      '1105036=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1105037=        INTO :PRICE_;'
      '1105038='
      
        '1105039=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045#1058' ' +
        #1055#1054#1057#1051#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048'"' +
        ' '#1042' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '1105040=      IF (ROW_COUNT = 0) THEN'
      '1105041=        SELECT S.PRICE'
      '1105042=          FROM SKLAD S'
      '1105043=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1105044=                            FROM SKLAD SS'
      
        '1105045=                           WHERE /*SS.G_TOCHKA = :G_TOCH' +
        'KA_'
      
        '1105046=                             AND */SS.G_PRODUCT = :G_PRO' +
        'DUCT_'
      
        '1105047=                             AND SS.DATE_RECEIPT = (SELE' +
        'CT MAX(SSS.DATE_RECEIPT)'
      
        '1105048=                                                      FR' +
        'OM SKLAD SSS'
      
        '1105049=                                                     WHE' +
        'RE /*SSS.G_TOCHKA = :G_TOCHKA_'
      
        '1105050=                                                       A' +
        'ND */SSS.G_PRODUCT = :G_PRODUCT_'
      
        '1105051=                                                       A' +
        'ND SSS.IS_VOZVRAT IN (0, 4) --AND SSS.IS_VOZVRAT IN (0, 3, 4)'
      '1105052=                                                   )'
      
        '1105053=                             AND SS.IS_VOZVRAT IN (0, 4)' +
        ' --AND SS.IS_VOZVRAT IN (0, 3, 4)'
      '1105054=                         )'
      '1105055=          INTO :PRICE_;'
      '1105056=    END ELSE BEGIN'
      
        '1105057=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT)' +
        ', 2)'
      '1105058=        FROM (SELECT S.AMOUNT, S.PRICE'
      '1105059=                FROM SKLAD_PARENT SP,'
      '1105060=                     SKLAD S'
      '1105061=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '1105062=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '1105063=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '1105064=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '1105065=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.IS' +
        '_VOZVRAT IN (0, 3, 4)'
      
        '1105066=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO 5' +
        ') T'
      '1105067=        INTO :PRICE_;'
      '1105068='
      
        '1105069=      -- '#1045#1057#1051#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1042#1054#1045#1052#1059' '#1057#1050#1051#1040#1044#1059' - '#1055#1059#1057#1058#1068' '#1041#1045#1056#1045#1058' ' +
        #1057#1056#1045#1044#1053#1070#1070' '#1062#1045#1053#1059' '#1055#1054' '#1042#1057#1045#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1048#1055' "'#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048'" '#1042 +
        ' '#1056#1040#1057#1063#1045#1058' '#1053#1045' '#1041#1045#1056#1059
      '1105070=      IF (PRICE_ IS NULL) THEN'
      
        '1105071=        SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUN' +
        'T), 2)'
      '1105072=        FROM (SELECT S.AMOUNT, S.PRICE'
      '1105073=                FROM SKLAD_PARENT SP,'
      '1105074=                     SKLAD S'
      '1105075=               WHERE SP.DATE_RECEIPT <= CURRENT_DATE'
      '1105076=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '1105077=                 AND S.G_PRODUCT = :G_PRODUCT_'
      
        '1105078=                 AND SP.IS_VOZVRAT IN (0, 4) --AND SP.IS' +
        '_VOZVRAT IN (0, 3, 4)'
      
        '1105079=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO 5' +
        ') T'
      '1105080=          INTO :PRICE_;'
      '1105081=    END'
      '1105082=  END'
      '1105083='
      '1105084=  PRICE_ = COALESCE(:PRICE_, 0);'
      '1105085=  SUSPEND;'
      '1105086=END'
      '1105087='#39';'
      '1105088='
      '1105089=EXECUTE STATEMENT '#39'ALTER PROCEDURE RECALC_SELF_PRICES('
      '1105090=  DATE_ DATE)'
      '1105091=AS'
      '1105092=/*'
      
        '1105093='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048', '#1063#1058#1054#1041#1067' '#1055#1045#1056#1045#1057#1063#1048#1058 +
        #1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1067#1045' '#1062#1045#1053#1067' '#1055#1054' '#1040#1050#1058#1059#1040#1051#1068#1053#1067#1052' '#1047#1053#1040#1063#1045#1053#1048#1071#1052'.'
      
        '1105094='#1069#1058#1054' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1052#1040#1043#1040#1047#1048#1053#1054#1042', '#1050#1054#1058#1054#1056#1067#1045' '#1055#1056#1054#1044#1040#1070#1058' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1047#1040#1050#1040 +
        #1047'. '#1058#1054' '#1045#1057#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1054#1060#1054#1056#1052#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059', '#1040' '#1055#1054#1058#1054#1052' '#1050#1059#1055#1048#1051#1048' '#1058#1054#1042#1040#1056' '#1048' '#1054#1060#1054#1056 +
        #1052#1048#1051#1048' '#1055#1056#1048#1061#1054#1044','
      
        '1105095='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1046#1045' '#1054#1058' '#1069#1058#1054#1043#1054' '#1053#1045' '#1052#1045#1053#1071#1045#1058#1057#1071', ' +
        #1045#1045' '#1053#1040#1044#1054' '#1052#1045#1053#1071#1058#1068' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054'.'
      '1105096='#1055#1056#1048' '#1056#1040#1057#1063#1045#1058#1045' '#1041#1059#1044#1059' '#1054#1058#1058#1040#1051#1050#1048#1042#1040#1058#1068#1057#1071' '#1054#1058' '#1044#1040#1058#1067' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1105097=*/'
      
        '1105098=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S_' +
        'VALUE;'
      
        '1105099=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.G_PRODUCT;'
      
        '11050100=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      
        '11050101=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.CO' +
        'ST_PRICE;'
      '11050102=BEGIN'
      '11050103=  IF (G_TOCHKA_ IS NULL) THEN'
      '11050104=    SELECT ID'
      '11050105=      FROM CUR_PARAMS'
      '11050106=     WHERE CUR_PARAMS = 2'
      '11050107=      INTO :G_TOCHKA_;'
      '11050108='
      '11050109=  SELECT S.S_VALUE'
      '11050110=    FROM SYSTEM_SETUP S'
      '11050111=   WHERE S.SYSTEM_SETUP = 1'
      '11050112=    INTO :FORMULA_;'
      '11050113='
      '11050114=  FOR SELECT T.G_PRODUCT'
      '11050115=        FROM ZAKAZ_DETAILS_TMP T'
      '11050116=       GROUP BY T.G_PRODUCT'
      '11050117=        INTO :G_PRODUCT_'
      '11050118=  DO BEGIN'
      
        '11050119=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, ' +
        ':G_TOCHKA_, 1)'
      '11050120=        RETURNING_VALUES :PRICE_;'
      '11050121='
      '11050122=    UPDATE ZAKAZ_DETAILS_TMP M'
      '11050123=       SET M.COST_PRICE = :PRICE_'
      '11050124=     WHERE M.G_PRODUCT = :G_PRODUCT_;'
      '11050125=  END'
      '11050126=END'
      '11050127='#39';'
      
        '11050128=UPDATE SYSTEM_SETUP SET S_VALUE = 11050 WHERE SYSTEM_SE' +
        'TUP = 3;'
      '11050129=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110510=EXECUTE BLOCK AS BEGIN'
      '110511=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT('
      '110512=  DATE_BEGIN_ DATE,'
      '110513=  DATE_END_ DATE,'
      '110514=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110515=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYMENT' +
        '_TYPE,'
      '110516=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110517=RETURNS ('
      '110518=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110519=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1105110=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUMM,'
      '1105111=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1105112=  SUMM_ALL_ NUMERIC(15,2),'
      '1105113=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1105114=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1105115=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1105116=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1105117=  PROFIT_ALL_ NUMERIC(15,2),'
      '1105118=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1105119=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE.P' +
        '_REP_PROFIT_TABLE,'
      '1105120=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '1105121=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '1105122=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '1105123=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '1105124=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT_N' +
        'AME,'
      
        '1105125=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PAY' +
        'MENT_TYPE,'
      
        '1105126=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYMENT' +
        '_NAME,'
      '1105127=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANIE,'
      '1105128=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUCT,'
      
        '1105129=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PROD' +
        'UCT_PAR,'
      
        '1105130=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_NAM' +
        'E,'
      '1105131=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1105132=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_N' +
        'UM,'
      '1105133=  AMOUNT MY_NUMERIC_5,'
      '1105134=  PRICE NUMERIC(15,2),'
      '1105135=  SUMM NUMERIC(15,2),'
      '1105136=  DISCOUNT_PERC NUMERIC(15,2),'
      '1105137=  DISCOUNT_SUMM NUMERIC(15,2),'
      '1105138=  NDS NUMERIC(15,2),'
      '1105139=  NDS_SUMM NUMERIC(15,2),'
      '1105140=  PRICE_SELF NUMERIC(15,2),'
      '1105141=  SUM_SELF NUMERIC(15,2),'
      '1105142=  PROFIT NUMERIC(15,2),'
      '1105143=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1105144=  ERR_CODE INTEGER,'
      '1105145=  ERR_MSG VARCHAR(1024))'
      '1105146=AS'
      
        '1105147=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT'#39#39 +
        ';'
      '1105148=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1105149=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1105150=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1105151=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1105152=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1105153=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1105154=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '1105155=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '1105156=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '1105157=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '1105158=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1105159=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '1105160=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      '1105161=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1105162=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TO' +
        'CHKA;'
      
        '1105163=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE' +
        ';'
      
        '1105164=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CL' +
        'IENT;'
      
        '1105165=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLIEN' +
        'T.NAME;'
      
        '1105166=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKA' +
        'Z.G_PAYMENT_TYPE;'
      
        '1105167=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PAYM' +
        'ENT_TYPE.NAME;'
      
        '1105168=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSN' +
        'OVANIE;'
      
        '1105169=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT;'
      
        '1105170=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT_PAR;'
      
        '1105171=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '1105172=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '1105173=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.PRICE;'
      
        '1105174=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1105175=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_PERC;'
      
        '1105176=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_SUMM;'
      
        '1105177=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.N' +
        'DS;'
      
        '1105178=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.NDS_SUMM;'
      
        '1105179=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.PR' +
        'ICE;'
      
        '1105180=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '1105181=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '1105182=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACTIO' +
        'N_DATE;'
      
        '1105183=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_RA' +
        'SHOD.NAME;'
      '1105184=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1105185=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DA' +
        'TE_RECEIPT;'
      
        '1105186=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '1105187=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      '1105188=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '1105189=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1105190=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '1105191=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      '1105192=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0;'
      '1105193=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;'
      '1105194=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      '1105195=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUMM;'
      '1105196=BEGIN'
      
        '1105197=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TABL' +
        'E = P_REP_PROFIT_TABLE;'
      '1105198=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1105199='
      '11051100=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '11051101=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '11051102=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '11051103='
      '11051104=  FOR SELECT GP.PATH,'
      '11051105=             GP.G_PRODUCT'
      '11051106=       FROM P_REP_TREE GP'
      '11051107=      WHERE EXISTS (SELECT 1'
      
        '11051108=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G' +
        '_PRODUCT G'
      
        '11051109=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39 +
        '-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11051110=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11051111=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11051112=                       AND G.G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '11051113=                       AND Z.IS_SPISANIE = 0'
      '11051114=                       AND Z.is_reserve = 0'
      '11051115=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11051116=                       AND Z.Z_DATE BETWEEN :DATE_BEGIN' +
        '_ AND :DATE_END_'
      
        '11051117=                       AND COALESCE(Z.G_CLIENT, 0) = CO' +
        'ALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045 +
        #1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11051118=                       AND COALESCE(Z.G_PAYMENT_TYPE, 0' +
        ') = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11051119=                       )'
      '11051120=      ORDER BY 1, 2'
      '11051121=  INTO :RECCAT_NAME_,'
      '11051122=       :RECCAT_PRODUCT_'
      '11051123=  DO BEGIN'
      '11051124=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11051125=    insert into p_rep_profit_table'
      '11051126=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11051127=    values'
      
        '11051128=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME_' +
        ', 1);'
      '11051129='
      '11051130=    FOR SELECT Z.ZAKAZ,'
      '11051131=               Z.G_TOCHKA,'
      '11051132=               Z.Z_DATE,'
      '11051133=               Z.G_CLIENT,'
      '11051134=               C.NAME CLIENT_NAME,'
      '11051135=               Z.G_PAYMENT_TYPE,'
      '11051136=               P.NAME PAYMENT_NAME,'
      '11051137=               Z.OSNOVANIE,'
      '11051138=               G.G_PRODUCT,'
      '11051139=               G.G_PRODUCT_PAR,'
      '11051140=               G.NAME TOVAR_NAME,'
      '11051141=               ZD.AMOUNT,'
      '11051142=               ZD.PRICE,'
      '11051143=               ZD.SUMM,'
      '11051144=               ZD.DISCOUNT_PERC,'
      '11051145=               ZD.DISCOUNT_SUMM,'
      '11051146=               ZD.NDS,'
      '11051147=               ZD.NDS_SUMM,'
      '11051148=               COALESCE(ZD.COST_PRICE, 0)'
      
        '11051149=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z.' +
        'G_CLIENT = C.G_CLIENT,'
      '11051150=               ZAKAZ_DETAILS ZD,'
      '11051151=               G_PRODUCT G,'
      '11051152=               G_PAYMENT_TYPE P'
      
        '11051153=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOC' +
        'HKA||'#39#39'-'#39#39
      '11051154=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '11051155=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11051156=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11051157=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_'
      '11051158=           AND Z.IS_SPISANIE = 0'
      '11051159=           AND Z.IS_RESERVE = 0'
      
        '11051160=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11051161=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CL' +
        'IENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '11051162=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE' +
        '(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11051163=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ZD' +
        '.ZAKAZ_DETAILS, G.NAME'
      '11051164=    INTO :REC_ZAKAZ_,'
      '11051165=        :REC_G_TOCHKA_,'
      '11051166=        :REC_Z_DATE_,'
      '11051167=        :REC_G_CLIENT_,'
      '11051168=        :REC_CLIENT_NAME_,'
      '11051169=        :REC_G_PAYMENT_TYPE_,'
      '11051170=        :REC_PAYMENT_NAME_,'
      '11051171=        :REC_OSNOVANIE_,'
      '11051172=        :REC_G_PRODUCT_,'
      '11051173=        :REC_G_PRODUCT_PAR_,'
      '11051174=        :REC_TOVAR_NAME_,'
      '11051175=        :REC_AMOUNT_,'
      '11051176=        :REC_PRICE_,'
      '11051177=        :REC_SUMM_,'
      '11051178=        :REC_DISCOUNT_PERC_,'
      '11051179=        :REC_DISCOUNT_SUMM_,'
      '11051180=        :REC_NDS_,'
      '11051181=        :REC_NDS_SUMM_,'
      '11051182=        :REC_PRICE_SELF_'
      '11051183=    DO BEGIN'
      '11051184=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '11051185=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_SU' +
        'M_COST_;'
      '11051186='
      '11051187=      insert into p_rep_profit_table'
      
        '11051188=        (p_rep_profit_table, zakaz, g_tochka, z_date, g' +
        '_client, client_name, g_payment_type, payment_name,'
      
        '11051189=         osnovanie, g_product, g_product_par, tovar_nam' +
        'e, amount, price, summ, discount_perc, discount_summ,'
      
        '11051190=         nds, nds_summ, price_self, sum_self, profit, i' +
        's_head)'
      '11051191=      values'
      '11051192=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '11051193=        :REC_ZAKAZ_,'
      '11051194=        :REC_g_tochka_,'
      
        '11051195=        :REC_z_date_, :REC_g_client_, :REC_client_name_' +
        ', :REC_g_payment_type_, :REC_payment_name_,'
      '11051196=         :REC_osnovanie_,'
      '11051197=         :REC_g_product_,'
      '11051198=         :REC_g_product_par_,'
      '11051199=         :REC_tovar_name_,'
      '11051200=         :REC_amount_,'
      '11051201=         :REC_price_,'
      '11051202=         :REC_summ_,'
      '11051203=         :REC_discount_perc_,'
      '11051204=         :REC_discount_summ_,'
      
        '11051205=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, :' +
        'REC_SUM_COST_, :REC_profit_, 0);'
      '11051206='
      '11051207=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '11051208=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '11051209=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '11051210=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '11051211=    END'
      '11051212='
      '11051213=    insert into p_rep_profit_table'
      
        '11051214=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11051215=    values'
      
        '11051216=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '11051217='
      '11051218=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '11051219=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '11051220=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '11051221=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11051222='
      '11051223=    SUM_ZAKAZ_ = 0;'
      '11051224=    SUM_COST_  = 0;'
      '11051225=    NDS_SUMM_  = 0;'
      '11051226=    PROFIT_    = 0;'
      '11051227=  END'
      '11051228='
      
        '11051229=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_ ' +
        '+ PROFIT_ALL_) > 0) then'
      '11051230=      insert into p_rep_profit_table'
      
        '11051231=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11051232=      values'
      
        '11051233=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '11051234='
      '11051235=  SELECT COUNT(*)'
      
        '11051236=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11051237=          UNION ALL'
      
        '11051238=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11051239=         G_PRIHOD_RASHOD G'
      
        '11051240=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11051241=    AND K.ACTION = 1'
      
        '11051242=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11051243=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11051244=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '11051245=  INTO :CNT_;'
      '11051246='
      '11051247=  IF (CNT_ > 0) THEN BEGIN'
      '11051248=    SUM_COST_  = 0;'
      '11051249=    PROFIT_    = 0;'
      '11051250='
      '11051251=    INSERT INTO P_REP_PROFIT_TABLE'
      '11051252=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11051253=    VALUES'
      
        '11051254=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11051255='
      '11051256=    FOR SELECT K.ACTION_DATE,'
      '11051257=               K.SUMM,'
      '11051258=               G.NAME'
      
        '11051259=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      
        '11051260=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39
      '11051261=              UNION ALL'
      
        '11051262=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, S' +
        'UMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa_bezn' +
        'al'
      
        '11051263=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39') k,'
      '11051264=              G_PRIHOD_RASHOD G'
      '11051265=        WHERE K.ACTION = 1'
      
        '11051266=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11051267=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11051268=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '11051269=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11051270=    INTO :ACTION_DATE_,'
      '11051271=         :SUMM_,'
      '11051272=         :ACTION_NAME_'
      '11051273=    DO BEGIN'
      '11051274=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11051275=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11051276=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11051277=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11051278=        VALUES'
      
        '11051279=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, 0,'
      
        '11051280=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALESC' +
        'E(:SUMM_, 0), 0);'
      '11051281='
      '11051282=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '11051283=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '11051284=    END'
      '11051285='
      '11051286=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11051287=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11051288=    insert into p_rep_profit_table'
      
        '11051289=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11051290=    values'
      
        '11051291=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11051292=  END'
      '11051293='
      '11051294=  SELECT COUNT(*)'
      
        '11051295=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11051296=          UNION ALL'
      
        '11051297=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11051298=         G_PRIHOD_RASHOD G'
      
        '11051299=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11051300=    AND K.ACTION = 0'
      
        '11051301=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11051302=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11051303=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '11051304=  INTO :CNT_;'
      '11051305='
      '11051306=  IF (CNT_ > 0) THEN BEGIN'
      '11051307=    PRIHOD_ALL_  = 0;'
      '11051308=    PRIHOD_ALL_NAL_  = 0;'
      '11051309=    PRIHOD_ALL_BEZNAL_  = 0;'
      '11051310=    PROFIT_     = 0;'
      '11051311='
      '11051312=    INSERT INTO P_REP_PROFIT_TABLE'
      '11051313=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11051314=    VALUES'
      
        '11051315=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11051316='
      '11051317=    FOR SELECT K.ACTION_DATE,'
      '11051318=               K.NAL,'
      '11051319=               K.BEZNAL,'
      '11051320=               G.NAME'
      
        '11051321=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 B' +
        'EZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11051322=               UNION ALL'
      
        '11051323=               SELECT kassa_BEZNAL KASSA, ACTION_DATE, ' +
        '0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa' +
        '_beznal) K,'
      '11051324=              G_PRIHOD_RASHOD G'
      
        '11051325=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCH' +
        'KA||'#39#39'-'#39#39
      '11051326=          AND K.ACTION = 0'
      
        '11051327=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11051328=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11051329=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '11051330=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11051331=    INTO :ACTION_DATE_,'
      '11051332=         :SUMM_NAL_,'
      '11051333=         :SUMM_BEZNAL_,'
      '11051334=         :ACTION_NAME_'
      '11051335=    DO BEGIN'
      '11051336=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11051337=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11051338=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11051339=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11051340=        VALUES'
      
        '11051341=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '11051342=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_' +
        ', 0);'
      '11051343='
      '11051344=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '11051345=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_' +
        'BEZNAL_;'
      
        '11051346=        PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BE' +
        'ZNAL_;'
      
        '11051347=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      '11051348=    END'
      '11051349='
      '11051350=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '11051351=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11051352='
      '11051353=    insert into p_rep_profit_table'
      
        '11051354=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11051355=    values'
      
        '11051356=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '11051357=  END'
      '11051358='
      '11051359=  SELECT COUNT(*)'
      '11051360=    FROM ZAKAZ Z'
      
        '11051361=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11051362=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11051363=     AND Z.IS_SPISANIE = 1'
      
        '11051364=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(Z.G_CLIENT, 0))'
      
        '11051365=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11051366=  INTO :CNT_;'
      '11051367='
      '11051368=  IF (CNT_ > 0) THEN BEGIN'
      '11051369=      SUM_ZAKAZ_ = 0;'
      '11051370=      SUM_COST_  = 0;'
      '11051371=      PROFIT_    = 0;'
      '11051372='
      '11051373=      insert into p_rep_profit_table'
      '11051374=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11051375=      values'
      
        '11051376=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39#39', 1);'
      '11051377='
      '11051378=      FOR SELECT Z.ZAKAZ,'
      '11051379=                 Z.G_TOCHKA,'
      '11051380=                 Z.Z_DATE,'
      '11051381=                 Z.G_CLIENT,'
      '11051382=                 '#39#39#39#39' CLIENT_NAME,'
      '11051383=                 Z.G_PAYMENT_TYPE,'
      '11051384=                 '#39#39#39#39' PAYMENT_NAME,'
      '11051385=                 Z.OSNOVANIE,'
      '11051386=                 G.G_PRODUCT,'
      '11051387=                 G.G_PRODUCT_PAR,'
      '11051388=                 G.NAME TOVAR_NAME,'
      '11051389=                 ZD.AMOUNT,'
      '11051390=                 ZD.PRICE,'
      '11051391=                 ZD.SUMM,'
      '11051392=                 0 DISCOUNT_PERC,'
      '11051393=                 0 DISCOUNT_SUMM,'
      '11051394=                 0 NDS,'
      '11051395=                 0 NDS_SUMM'
      '11051396=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT G'
      
        '11051397=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_T' +
        'OCHKA||'#39#39'-'#39#39
      '11051398=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '11051399=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11051400=             AND Z.IS_SPISANIE = 1                    -' +
        '- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '11051401=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '11051402=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '11051403=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11051404=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ_' +
        'DETAILS'
      '11051405=      INTO :REC_ZAKAZ_,'
      '11051406=            :REC_G_TOCHKA_,'
      '11051407=            :REC_Z_DATE_,'
      '11051408=            :REC_G_CLIENT_,'
      '11051409=            :REC_CLIENT_NAME_,'
      '11051410=            :REC_G_PAYMENT_TYPE_,'
      '11051411=            :REC_PAYMENT_NAME_,'
      '11051412=            :REC_OSNOVANIE_,'
      '11051413=            :REC_G_PRODUCT_,'
      '11051414=            :REC_G_PRODUCT_PAR_,'
      '11051415=            :REC_TOVAR_NAME_,'
      '11051416=            :REC_AMOUNT_,'
      '11051417=            :REC_PRICE_,'
      '11051418=            :REC_SUMM_,'
      '11051419=            :REC_DISCOUNT_PERC_,'
      '11051420=            :REC_DISCOUNT_SUMM_,'
      '11051421=            :REC_NDS_,'
      '11051422=            :REC_NDS_SUMM_'
      '11051423=      DO BEGIN'
      '11051424=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '11051425=        REC_profit_   = -REC_SUMM_;'
      '11051426='
      '11051427=        insert into p_rep_profit_table'
      
        '11051428=          (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '11051429=           osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '11051430=           nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '11051431=        values'
      
        '11051432=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAKA' +
        'Z_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_na' +
        'me_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '11051433=         :REC_osnovanie_, :REC_g_product_, :REC_g_produ' +
        'ct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_per' +
        'c_, :REC_discount_summ_,'
      
        '11051434=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_S' +
        'UM_COST_, :REC_profit_, 0);'
      '11051435='
      
        '11051436=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST_' +
        ', 0);'
      
        '11051437=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, 0' +
        ');'
      '11051438=      END'
      '11051439='
      '11051440=      insert into p_rep_profit_table'
      
        '11051441=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11051442=      values'
      
        '11051443=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', ' +
        '0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11051444='
      '11051445=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11051446=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '11051447=  END'
      '11051448='
      '11051449=  SELECT COUNT(*)'
      '11051450=    FROM SKLAD S'
      
        '11051451=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39 +
        #39'-'#39#39
      
        '11051452=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '11051453=     AND S.IS_VOZVRAT IN (1,2)'
      
        '11051454=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.G' +
        '_CLIENT, 0))'
      
        '11051455=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, ' +
        'COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11051456=  INTO :CNT_;'
      '11051457='
      '11051458=  IF (CNT_ > 0) THEN BEGIN'
      '11051459=    SUM_ZAKAZ_ = 0;'
      '11051460=    PROFIT_    = 0;'
      '11051461=    SUM_COST_  = 0;'
      '11051462='
      '11051463=    insert into p_rep_profit_table'
      '11051464=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11051465=    values'
      
        '11051466=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39#39', 1);'
      '11051467='
      '11051468=    FOR SELECT S.DATE_RECEIPT,'
      '11051469=               S.G_PRODUCT,'
      '11051470=               G.NAME TOVAR_NAME,'
      '11051471=               S.AMOUNT,'
      '11051472=               S.PRICE,'
      '11051473=               S.SUMM,'
      '11051474=               SP.G_TOCHKA'
      '11051475=         FROM SKLAD_PARENT SP,'
      '11051476=              SKLAD S,'
      '11051477=              G_PRODUCT G'
      
        '11051478=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TOC' +
        'HKA||'#39#39'-'#39#39
      
        '11051479=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '11051480=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '11051481=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALES' +
        'CE(S.G_CLIENT, 0))'
      
        '11051482=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_T' +
        'YPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11051483=          AND SP.SKLAD = S.SKLAD_PARENT'
      '11051484=          AND S.G_PRODUCT = G.G_PRODUCT'
      '11051485=        ORDER BY 1'
      '11051486=    INTO :V_DATE_RECEIPT_,'
      '11051487=         :V_G_PRODUCT_,'
      '11051488=         :V_TOVAR_NAME_,'
      '11051489=         :V_AMOUNT_,'
      '11051490=         :V_PRICE_,'
      '11051491=         :V_SUMM_,'
      '11051492=         :REC_G_TOCHKA_'
      '11051493=    DO BEGIN'
      '11051494=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;'
      '11051495='
      '11051496='
      '11051497=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '11051498=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_N' +
        'AME, AMOUNT, PRICE, SUMM,'
      '11051499=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11051500=         NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT, I' +
        'S_HEAD)'
      '11051501=      VALUES'
      
        '11051502=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_REC' +
        'EIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, 0 /*:REC_PRICE' +
        '_SELF_*/, 0/*:REC_SUM_COST_*/,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' ' +
        #1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045 +
        #1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '11051503=         0, 0, 0, 0, :V_PRICE_, :V_SUMM_, :REC_profit_,' +
        ' 0);'
      '11051504='
      '11051505=      SUM_COST_ = 0;'
      '11051506=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '11051507=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '11051508=    END'
      '11051509='
      '11051510='
      '11051511=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_COST_;'
      '11051512=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '11051513=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '11051514='
      '11051515=    insert into p_rep_profit_table'
      
        '11051516=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11051517=    values'
      
        '11051518=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '11051519=  END'
      '11051520='
      '11051521=  SELECT COUNT(*)'
      '11051522=    FROM ZAKAZ S'
      
        '11051523=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11051524=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11051525=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(S.G_CLIENT, 0))'
      
        '11051526=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11051527=     AND S.IS_SPISANIE = 2'
      '11051528=  INTO :CNT_;'
      '11051529='
      '11051530=  IF (CNT_ > 0) THEN BEGIN'
      '11051531=      insert into p_rep_profit_table'
      '11051532=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11051533=      values'
      
        '11051534=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '11051535='
      '11051536=      SUM_ZAKAZ_ = 0;'
      '11051537=      SUM_COST_  = 0;'
      '11051538=      NDS_SUMM_  = 0;'
      '11051539=      PROFIT_    = 0;'
      '11051540=      FOR SELECT GP.NAME,'
      '11051541=                 GP.G_PRODUCT'
      '11051542=           FROM G_PRODUCT GP'
      '11051543=          WHERE IS_CATEGORY = 1'
      '11051544=            AND EXISTS (SELECT 1'
      
        '11051545=                          FROM ZAKAZ Z, ZAKAZ_DETAILS Z' +
        'D, G_PRODUCT G'
      
        '11051546=                         WHERE :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11051547=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '11051548=                           AND ZD.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11051549=                           AND G.G_PRODUCT_PAR = GP.G_P' +
        'RODUCT'
      '11051550=                           AND Z.IS_SPISANIE = 2'
      
        '11051551=                           AND Z.Z_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      
        '11051552=                           AND COALESCE(Z.G_CLIENT, 0) ' +
        '= COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '11051553=                           AND COALESCE(Z.G_PAYMENT_TYP' +
        'E, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0)' +
        ')'
      '11051554=                           )'
      '11051555=          ORDER BY 1'
      '11051556=      INTO :RECCAT_NAME_,'
      '11051557=           :RECCAT_PRODUCT_'
      '11051558=      DO BEGIN'
      '11051559=        insert into p_rep_profit_table'
      '11051560=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11051561=        values'
      
        '11051562=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_N' +
        'AME_, 1);'
      '11051563='
      '11051564=        FOR SELECT Z.ZAKAZ,'
      '11051565=                   Z.G_TOCHKA,'
      '11051566=                   Z.Z_DATE,'
      '11051567=                   Z.G_CLIENT,'
      '11051568=                   C.NAME CLIENT_NAME,'
      '11051569=                   Z.G_PAYMENT_TYPE,'
      '11051570=                   P.NAME PAYMENT_NAME,'
      '11051571=                   Z.OSNOVANIE,'
      '11051572=                   G.G_PRODUCT,'
      '11051573=                   G.G_PRODUCT_PAR,'
      '11051574=                   G.NAME TOVAR_NAME,'
      '11051575=                   ZD.AMOUNT,'
      '11051576=                   ZD.PRICE,'
      '11051577=                   ZD.SUMM,'
      '11051578=                   ZD.DISCOUNT_PERC,'
      '11051579=                   ZD.DISCOUNT_SUMM,'
      '11051580=                   ZD.NDS,'
      '11051581=                   ZD.NDS_SUMM,'
      '11051582=                   ZD.COST_PRICE'
      
        '11051583=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C O' +
        'N Z.G_CLIENT = C.G_CLIENT,'
      '11051584=                   ZAKAZ_DETAILS ZD,'
      '11051585=                   G_PRODUCT G,'
      '11051586=                   G_PAYMENT_TYPE P'
      
        '11051587=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G' +
        '_TOCHKA||'#39#39'-'#39#39
      '11051588=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '11051589=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11051590=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11051591=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_'
      '11051592=               AND Z.IS_SPISANIE = 2'
      
        '11051593=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '11051594=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:' +
        'G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '11051595=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COAL' +
        'ESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11051596=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ' +
        ', ZD.ZAKAZ_DETAILS, G.NAME'
      '11051597=        INTO :REC_ZAKAZ_,'
      '11051598=            :REC_G_TOCHKA_,'
      '11051599=            :REC_Z_DATE_,'
      '11051600=            :REC_G_CLIENT_,'
      '11051601=            :REC_CLIENT_NAME_,'
      '11051602=            :REC_G_PAYMENT_TYPE_,'
      '11051603=            :REC_PAYMENT_NAME_,'
      '11051604=            :REC_OSNOVANIE_,'
      '11051605=            :REC_G_PRODUCT_,'
      '11051606=            :REC_G_PRODUCT_PAR_,'
      '11051607=            :REC_TOVAR_NAME_,'
      '11051608=            :REC_AMOUNT_,'
      '11051609=            :REC_PRICE_,'
      '11051610=            :REC_SUMM_,'
      '11051611=            :REC_DISCOUNT_PERC_,'
      '11051612=            :REC_DISCOUNT_SUMM_,'
      '11051613=            :REC_NDS_,'
      '11051614=            :REC_NDS_SUMM_,'
      '11051615=            :REC_PRICE_SELF_'
      '11051616=        DO BEGIN'
      
        '11051617=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_' +
        ';'
      
        '11051618=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - R' +
        'EC_NDS_SUMM_;'
      '11051619='
      '11051620=          insert into p_rep_profit_table'
      
        '11051621=            (p_rep_profit_table, zakaz, g_tochka, z_dat' +
        'e, g_client, client_name, g_payment_type, payment_name,'
      
        '11051622=             osnovanie, g_product, g_product_par, tovar' +
        '_name, amount, price, summ, discount_perc, discount_summ,'
      
        '11051623=             nds, nds_summ, price_self, sum_self, profi' +
        't, is_head)'
      '11051624=          values'
      '11051625=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '11051626=            :REC_ZAKAZ_,'
      '11051627=            :REC_g_tochka_,'
      
        '11051628=            :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      '11051629=             :REC_osnovanie_,'
      '11051630=             :REC_g_product_,'
      '11051631=             :REC_g_product_par_,'
      '11051632=             :REC_tovar_name_,'
      '11051633=             :REC_amount_,'
      '11051634=             :REC_price_,'
      '11051635=             :REC_summ_,'
      '11051636=             :REC_discount_perc_,'
      '11051637=             :REC_discount_summ_,'
      
        '11051638=             :REC_nds_, :REC_nds_summ_, :REC_price_self' +
        '_, :REC_SUM_COST_, :REC_profit_, 0);'
      '11051639='
      
        '11051640=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_,' +
        ' 0);'
      
        '11051641=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COS' +
        'T_, 0);'
      
        '11051642=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUM' +
        'M_, 0);'
      
        '11051643=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, ' +
        '0);'
      '11051644=        END'
      '11051645='
      '11051646=        insert into p_rep_profit_table'
      
        '11051647=          (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '11051648=        values'
      
        '11051649=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '11051650='
      '11051651=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_;'
      '11051652=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '11051653=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '11051654=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '11051655='
      '11051656=        SUM_ZAKAZ_ = 0;'
      '11051657=        SUM_COST_  = 0;'
      '11051658=        NDS_SUMM_  = 0;'
      '11051659=        PROFIT_    = 0;'
      '11051660=      END'
      '11051661='
      '11051662=      insert into p_rep_profit_table'
      
        '11051663=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11051664=      values'
      
        '11051665=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '11051666='
      
        '11051667=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL_' +
        ';'
      
        '11051668=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL_' +
        ';'
      '11051669=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '11051670=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '11051671=  END'
      '11051672='
      '11051673=  insert into p_rep_profit_table'
      '11051674=    (p_rep_profit_table, is_head)'
      '11051675=  values'
      '11051676=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '11051677='
      '11051678=  insert into p_rep_profit_table'
      
        '11051679=    (p_rep_profit_table, tovar_name, summ, sum_self, ND' +
        'S_SUMM, profit, is_head)'
      '11051680=  values'
      
        '11051681=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072#1079 +
        #1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '11051682='
      '11051683=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '11051684=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '11051685=         SUM(Z.SUMM_BONUS)'
      '11051686=    FROM ZAKAZ Z'
      
        '11051687=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11051688=     AND Z.IS_SPISANIE not in (1, 4)'
      '11051689=     AND Z.IS_RESERVE = 0'
      '11051690=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11051691=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11051692=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11051693=    INTO :SUMM_CASH_ALL_,'
      '11051694=         :SUMM_NONCASH_ALL_,'
      '11051695=         :SUMM_BONUS_ALL_;'
      '11051696='
      '11051697=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '11051698=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '11051699=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '11051700='
      '11051701=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '11051702='
      
        '11051703=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS VA' +
        'RCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '11051704=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_s' +
        'umm_all_;'
      '11051705='
      '11051706=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '11051707=    SELECT G.NAME'
      '11051708=      FROM G_CLIENT G'
      '11051709=     WHERE G.G_CLIENT = :G_CLIENT_'
      '11051710=    INTO :CLIENT_NAME_;'
      '11051711=  ELSE'
      '11051712=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '11051713='
      '11051714=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '11051715=    SELECT G.NAME'
      '11051716=      FROM G_PAYMENT_TYPE G'
      '11051717=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '11051718=    INTO :PAYMENT_NAME_;'
      '11051719=  ELSE'
      '11051720=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '11051721='
      '11051722=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '11051723=        P.ZAKAZ,'
      '11051724=        P.G_TOCHKA,'
      '11051725=        P.Z_DATE,'
      '11051726=        P.G_CLIENT,'
      '11051727=        P.CLIENT_NAME,'
      '11051728=        P.G_PAYMENT_TYPE,'
      '11051729=        P.PAYMENT_NAME,'
      '11051730=        P.OSNOVANIE,'
      '11051731=        P.G_PRODUCT,'
      '11051732=        P.G_PRODUCT_PAR,'
      '11051733=        P.TOVAR_NAME,'
      '11051734=        G.ARTICUL,'
      '11051735=        G.NOMENCLATUR_NUM,'
      '11051736=        P.AMOUNT,'
      '11051737=        P.PRICE,'
      '11051738=        P.SUMM,'
      '11051739=        P.DISCOUNT_PERC,'
      '11051740=        P.DISCOUNT_SUMM,'
      '11051741=        P.NDS,'
      '11051742=        P.NDS_SUMM,'
      '11051743=        P.PRICE_SELF,'
      '11051744=        P.SUM_SELF,'
      '11051745=        P.PROFIT,'
      '11051746=        P.IS_HEAD'
      
        '11051747=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUCT' +
        ' G ON P.G_PRODUCT = G.G_PRODUCT'
      '11051748=    ORDER BY 1'
      '11051749=  INTO :P_REP_PROFIT_TABLE,'
      '11051750=       :ZAKAZ,'
      '11051751=       :G_TOCHKA,'
      '11051752=       :Z_DATE,'
      '11051753=       :G_CLIENT,'
      '11051754=       :CLIENT_NAME,'
      '11051755=       :G_PAYMENT_TYPE,'
      '11051756=       :PAYMENT_NAME,'
      '11051757=       :OSNOVANIE,'
      '11051758=       :G_PRODUCT,'
      '11051759=       :G_PRODUCT_PAR,'
      '11051760=       :TOVAR_NAME,'
      '11051761=       :ARTICUL,'
      '11051762=       :NOMENCLATUR_NUM,'
      '11051763=       :AMOUNT,'
      '11051764=       :PRICE,'
      '11051765=       :SUMM,'
      '11051766=       :DISCOUNT_PERC,'
      '11051767=       :DISCOUNT_SUMM,'
      '11051768=       :NDS,'
      '11051769=       :NDS_SUMM,'
      '11051770=       :PRICE_SELF,'
      '11051771=       :SUM_SELF,'
      '11051772=       :PROFIT,'
      '11051773=       :IS_HEAD'
      '11051774=  DO'
      '11051775=    suspend;'
      '11051776='
      '11051777=WHEN ANY DO BEGIN'
      '11051778=    Err_code = -20500;'
      
        '11051779=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11051780=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11051781=  END'
      '11051782=end'
      '11051783='#39';'
      '11051784='
      
        '11051785=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT_CATEGOR' +
        'Y('
      '11051786=  DATE_BEGIN_ DATE,'
      '11051787=  DATE_END_ DATE,'
      '11051788=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11051789=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYME' +
        'NT_TYPE,'
      '11051790=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '11051791=RETURNS ('
      '11051792=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11051793=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '11051794=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUMM' +
        ','
      '11051795=  SUMM_COST_ALL_STR VARCHAR(50),'
      '11051796=  SUMM_ALL_ NUMERIC(15,2),'
      '11051797=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '11051798=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '11051799=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '11051800=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '11051801=  PROFIT_ALL_ NUMERIC(15,2),'
      '11051802=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '11051803=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'P_REP_PROFIT_TABLE,'
      
        '11051804=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_NA' +
        'ME,'
      '11051805=  SUMM NUMERIC(15,2),'
      '11051806=  NDS_SUMM NUMERIC(15,2),'
      '11051807=  SUM_SELF NUMERIC(15,2),'
      '11051808=  PROFIT NUMERIC(15,2),'
      '11051809=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '11051810=  ERR_CODE INTEGER,'
      '11051811=  ERR_MSG VARCHAR(1024))'
      '11051812=AS'
      
        '11051813=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT'#39 +
        #39';'
      '11051814=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11051815=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '11051816=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '11051817=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '11051818=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '11051819=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '11051820=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '11051821=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11051822=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '11051823=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.NDS_SUMM;'
      
        '11051824=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '11051825=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '11051826=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '11051827=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '11051828=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052#1052 +
        #1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '11051829=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /* ' +
        #1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '11051830=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0; ' +
        '/* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '11051831=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '11051832=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUMM' +
        ';'
      '11051833=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '11051834=BEGIN'
      
        '11051835=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TAB' +
        'LE = P_REP_PROFIT_TABLE;'
      '11051836=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11051837='
      '11051838=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '11051839=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '11051840=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '11051841='
      '11051842=  FOR SELECT SUM(ZD.SUMM)'
      '11051843=           ,TR.PATH'
      '11051844=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '11051845=           ,SUM(ZD.nds_summ)'
      '11051846=      FROM ZAKAZ Z,'
      '11051847=           ZAKAZ_DETAILS ZD,'
      '11051848=           G_PRODUCT GP,'
      '11051849=           P_REP_TREE TR'
      
        '11051850=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA|' +
        '|'#39#39'-'#39#39
      '11051851=       AND Z.IS_SPISANIE = 0'
      '11051852=       AND Z.IS_RESERVE = 0'
      '11051853=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11051854=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11051855=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '11051856=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      '11051857=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11051858=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT' +
        '_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11051859=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_' +
        'PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11051860=     GROUP BY TR.PATH'
      '11051861=     ORDER BY TR.PATH'
      
        '11051862=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, ND' +
        'S_SUMM_'
      '11051863=  DO BEGIN'
      '11051864=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '11051865='
      '11051866=    insert into p_rep_profit_table'
      
        '11051867=        (p_rep_profit_table, tovar_name, summ, nds_summ' +
        ', sum_self, profit, is_head)'
      '11051868=    values'
      '11051869=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '11051870=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :SUM' +
        '_COST_, :PROFIT_, 0);'
      '11051871='
      '11051872=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '11051873=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '11051874=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '11051875=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11051876=  END'
      '11051877='
      '11051878=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '11051879=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_ ' +
        '+ PROFIT_ALL_) > 0) then'
      '11051880=      insert into p_rep_profit_table'
      
        '11051881=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11051882=      values'
      
        '11051883=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '11051884='
      '11051885=  IS_FIRST_ = 1;'
      '11051886=  SUM_COST_ = 0;'
      '11051887=  PROFIT_   = 0;'
      '11051888='
      '11051889=  FOR SELECT G.NAME,'
      '11051890=             SUM(K.SUMM)'
      
        '11051891=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRIHO' +
        'D_RASHOD, G_TOCHKA FROM KASSA'
      '11051892=              UNION ALL'
      
        '11051893=              SELECT ACTION_DATE, SUMM NAL, ACTION, G_P' +
        'RIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '11051894=             G_PRIHOD_RASHOD G'
      
        '11051895=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHK' +
        'A||'#39#39'-'#39#39
      '11051896=        AND K.ACTION = 1'
      
        '11051897=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '11051898=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11051899=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    --' +
        ' '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11051900=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '11051901=        INTO :REC_TOVAR_NAME_'
      '11051902=             ,:SUMM_'
      '11051903=  DO BEGIN'
      '11051904=    IF (IS_FIRST_ = 1) then BEGIN'
      '11051905=      INSERT INTO P_REP_PROFIT_TABLE'
      '11051906=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11051907=      VALUES'
      
        '11051908=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39#39 +
        ', 1);'
      '11051909='
      '11051910=      IS_FIRST_ = 0;'
      '11051911=    END'
      '11051912='
      '11051913=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '11051914=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM, ' +
        'SUM_SELF, PROFIT, IS_HEAD)'
      '11051915=    VALUES'
      
        '11051916=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_NA' +
        'ME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '11051917='
      '11051918=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '11051919=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '11051920=  END'
      '11051921='
      '11051922=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '11051923=  IF (SUM_COST_ > 0) then BEGIN'
      '11051924=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11051925=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11051926=    insert into p_rep_profit_table'
      
        '11051927=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11051928=    values'
      
        '11051929=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11051930=  END'
      '11051931='
      '11051932=  IS_FIRST_ = 1;'
      '11051933=  PROFIT_   = 0;'
      '11051934=  PRIHOD_ALL_  = 0;'
      '11051935=  PRIHOD_ALL_NAL_  = 0;'
      '11051936=  PRIHOD_ALL_BEZNAL_  = 0;'
      '11051937='
      '11051938=  FOR SELECT G.NAME,'
      '11051939=             SUM(K.NAL),'
      '11051940=             SUM(K.BEZNAL)'
      
        '11051941=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL, A' +
        'CTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11051942=              UNION ALL'
      
        '11051943=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL, A' +
        'CTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '11051944=             G_PRIHOD_RASHOD G'
      
        '11051945=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHK' +
        'A||'#39#39'-'#39#39
      '11051946=        AND K.ACTION = 0'
      
        '11051947=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '11051948=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11051949=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11051950=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '11051951=        INTO :REC_TOVAR_NAME_'
      '11051952=             ,:SUMM_NAL_'
      '11051953=             ,:SUMM_BEZNAL_'
      '11051954=  DO BEGIN'
      '11051955=    IF (IS_FIRST_ = 1) then BEGIN'
      '11051956=      INSERT INTO P_REP_PROFIT_TABLE'
      '11051957=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11051958=      VALUES'
      
        '11051959=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39#39 +
        ', 1);'
      '11051960='
      '11051961=      IS_FIRST_ = 0;'
      '11051962=    END'
      '11051963='
      '11051964=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '11051965=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_SU' +
        'MM, SUMM, PROFIT, IS_HEAD)'
      '11051966=    VALUES'
      
        '11051967=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_NA' +
        'ME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZNAL' +
        '_, 0);'
      '11051968='
      '11051969=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '11051970=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BEZN' +
        'AL_;'
      
        '11051971=    PRIHOD_ALL_ = PRIHOD_ALL_ + SUMM_NAL_ + SUMM_BEZNAL' +
        '_;'
      '11051972=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL_;'
      '11051973=  END'
      '11051974='
      '11051975=  IF (PROFIT_ > 0) then BEGIN'
      '11051976=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '11051977=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11051978=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '11051979=    insert into p_rep_profit_table'
      
        '11051980=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11051981=    values'
      
        '11051982=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '11051983=  END'
      '11051984='
      '11051985=  IS_FIRST_ = 1;'
      '11051986=  SUM_COST_ = 0;'
      '11051987=  PROFIT_   = 0;'
      '11051988=  FOR SELECT SUM(ZD.SUMM)'
      '11051989=           ,TR.PATH'
      '11051990=      FROM ZAKAZ Z,'
      '11051991=           ZAKAZ_DETAILS ZD,'
      '11051992=           G_PRODUCT GP,'
      '11051993=           P_REP_TREE TR'
      
        '11051994=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA|' +
        '|'#39#39'-'#39#39
      '11051995=       AND Z.IS_SPISANIE = 1'
      '11051996=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11051997=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11051998=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '11051999=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110511000=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110511001=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110511002=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110511003=     GROUP BY TR.PATH'
      '110511004=     ORDER BY TR.PATH'
      '110511005=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '110511006=  DO BEGIN'
      '110511007='
      '110511008=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '110511009=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110511010=      insert into p_rep_profit_table'
      '110511011=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110511012=      values'
      
        '110511013=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39#39', 1);'
      '110511014='
      '110511015=      IS_FIRST_ = 0;'
      '110511016=    END'
      '110511017='
      '110511018=    insert into p_rep_profit_table'
      
        '110511019=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110511020=    values'
      '110511021=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110511022=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZAK' +
        'AZ_, 0);'
      '110511023='
      '110511024=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '110511025=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '110511026=  END'
      '110511027='
      '110511028=  if (SUM_COST_ > 0) then BEGIN'
      '110511029=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110511030=    insert into p_rep_profit_table'
      
        '110511031=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110511032=    values'
      
        '110511033=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', 0' +
        ', :SUM_COST_, 0, :PROFIT_, 2);'
      '110511034='
      '110511035=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110511036=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110511037=  END'
      '110511038='
      '110511039=  IS_FIRST_  = 1;'
      '110511040=  SUM_ZAKAZ_ = 0;'
      '110511041=  PROFIT_    = 0;'
      '110511042=  FOR SELECT SUM(S.SUMM)'
      '110511043=             ,TR.PATH'
      '110511044=     FROM SKLAD_PARENT SP,'
      '110511045=          SKLAD S,'
      '110511046=          G_PRODUCT G,'
      '110511047=          P_REP_TREE TR'
      
        '110511048=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TOCHKA' +
        '||'#39#39'-'#39#39
      
        '110511049=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110511050=      AND SP.IS_VOZVRAT IN (1,2)'
      '110511051=      and G.g_product_PAR = TR.g_product'
      
        '110511052=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'S.G_CLIENT, 0))'
      
        '110511053=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE' +
        '_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110511054=      AND SP.SKLAD = S.SKLAD_PARENT'
      '110511055=      AND S.G_PRODUCT = G.G_PRODUCT'
      '110511056=     GROUP BY TR.PATH'
      '110511057=     ORDER BY TR.PATH'
      '110511058=     INTO :V_SUMM_,'
      '110511059=          :REC_TOVAR_NAME_'
      '110511060=  DO BEGIN'
      '110511061=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '110511062=      insert into p_rep_profit_table'
      '110511063=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110511064=      values'
      
        '110511065=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040#39#39', 1);'
      '110511066='
      '110511067=      IS_FIRST_ = 0;'
      '110511068=    END'
      '110511069='
      '110511070=    REC_profit_   = 0 - V_SUMM_;'
      '110511071=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110511072=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM,' +
        ' SUM_SELF, PROFIT, IS_HEAD)'
      '110511073=    VALUES'
      
        '110511074=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :V_SUMM_, :REC_profit_, 0);'
      '110511075='
      '110511076=    SUM_COST_ = 0;'
      '110511077=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '110511078=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110511079=  END'
      '110511080='
      '110511081=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '110511082=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '110511083=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110511084='
      '110511085=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110511086=    insert into p_rep_profit_table'
      
        '110511087=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110511088=    values'
      
        '110511089=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :' +
        'SUM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '110511090=  END'
      '110511091='
      '110511092=  IS_FIRST_  = 1;'
      '110511093=  SUM_ZAKAZ_ = 0;'
      '110511094=  SUM_COST_  = 0;'
      '110511095=  PROFIT_    = 0;'
      '110511096=  NDS_SUMM_  = 0;'
      '110511097=  FOR SELECT SUM(ZD.SUMM)'
      '110511098=           ,TR.PATH'
      '110511099=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '110511100=           ,SUM(ZD.nds_summ)'
      '110511101=      FROM ZAKAZ Z,'
      '110511102=           ZAKAZ_DETAILS ZD,'
      '110511103=           G_PRODUCT GP,'
      '110511104=           P_REP_TREE TR'
      
        '110511105=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA' +
        '||'#39#39'-'#39#39
      '110511106=       AND Z.IS_SPISANIE = 2'
      '110511107=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110511108=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110511109=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110511110=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110511111=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110511112=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110511113=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110511114=     GROUP BY TR.PATH'
      '110511115=     ORDER BY TR.PATH'
      
        '110511116=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST_' +
        ', REC_NDS_SUMM_'
      '110511117=  DO BEGIN'
      '110511118=    IF (IS_FIRST_ = 1) then BEGIN'
      '110511119=      insert into p_rep_profit_table'
      '110511120=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110511121=      values'
      
        '110511122=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '110511123='
      '110511124=      IS_FIRST_ = 0;'
      '110511125=    END'
      '110511126='
      
        '110511127=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS_' +
        'SUMM_;'
      '110511128='
      '110511129=    insert into p_rep_profit_table'
      
        '110511130=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110511131=    values'
      '110511132=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110511133=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_, ' +
        ':REC_SUM_COST_, :REC_PROFIT_, 0);'
      '110511134='
      '110511135=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '110511136=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, 0' +
        ');'
      
        '110511137=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, 0' +
        ');'
      '110511138=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110511139=  END'
      '110511140='
      '110511141=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '110511142=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110511143=    insert into p_rep_profit_table'
      
        '110511144=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110511145=    values'
      
        '110511146=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROF' +
        'IT_, 2);'
      '110511147='
      '110511148=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110511149=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110511150=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110511151=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '110511152=  END'
      '110511153='
      '110511154=  insert into p_rep_profit_table'
      '110511155=    (p_rep_profit_table, is_head)'
      '110511156=  values'
      '110511157=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110511158='
      '110511159=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '110511160=  insert into p_rep_profit_table'
      
        '110511161=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110511162=  values'
      
        '110511163=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFI' +
        'T_ALL_, 1);'
      '110511164='
      '110511165=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '110511166=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110511167=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110511168=         SUM(Z.SUMM_BONUS)'
      '110511169=    FROM ZAKAZ Z'
      
        '110511170=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      
        '110511171=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1089 +
        #1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '110511172=     AND Z.IS_RESERVE = 0'
      '110511173=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110511174=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110511175=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110511176=    INTO :SUMM_CASH_ALL_,'
      '110511177=         :SUMM_NONCASH_ALL_,'
      '110511178=         :SUMM_BONUS_ALL_;'
      '110511179='
      '110511180=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '110511181=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '110511182=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110511183='
      '110511184=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110511185='
      
        '110511186=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '110511187=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110511188='
      '110511189=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110511190=    SELECT G.NAME'
      '110511191=      FROM G_CLIENT G'
      '110511192=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110511193=    INTO :CLIENT_NAME_;'
      '110511194=  ELSE'
      '110511195=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110511196='
      '110511197=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110511198=    SELECT G.NAME'
      '110511199=      FROM G_PAYMENT_TYPE G'
      '110511200=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110511201=    INTO :PAYMENT_NAME_;'
      '110511202=  ELSE'
      '110511203=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110511204='
      '110511205=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110511206=        P.TOVAR_NAME,'
      
        '110511207=        P.SUMM,--REPLACE(CAST(SUMM AS VARCHAR(100)), '#39 +
        #39'.'#39#39', '#39#39','#39#39'),'
      
        '110511208=        P.NDS_SUMM,--REPLACE(CAST(NDS_SUMM AS VARCHAR(' +
        '100)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '110511209=        P.SUM_SELF,--REPLACE(CAST(SUM_SELF AS VARCHAR(' +
        '100)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '110511210=        P.PROFIT,--REPLACE(CAST(PROFIT AS VARCHAR(100)' +
        '), '#39#39'.'#39#39', '#39#39','#39#39'),'
      '110511211=        P.IS_HEAD'
      
        '110511212=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110511213=    ORDER BY 1'
      '110511214=  INTO :P_REP_PROFIT_TABLE,'
      '110511215=       :TOVAR_NAME,'
      '110511216=       :SUMM,'
      '110511217=       :NDS_SUMM,'
      '110511218=       :SUM_SELF,'
      '110511219=       :PROFIT,'
      '110511220=       :IS_HEAD'
      '110511221=  DO'
      '110511222=    suspend;'
      '110511223='
      '110511224=WHEN ANY DO BEGIN'
      '110511225=    Err_code = -20500;'
      
        '110511226=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110511227=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110511228=  END'
      '110511229=end'
      '110511230='#39';'
      '110511231=END  --END_EXECUTE_BLOCK'
      '110511232=EXECUTE BLOCK AS BEGIN'
      
        '110511233=UPDATE SYSTEM_SETUP SET S_VALUE = 11051 WHERE SYSTEM_S' +
        'ETUP = 3;'
      '110511234=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110520=EXECUTE BLOCK AS BEGIN'
