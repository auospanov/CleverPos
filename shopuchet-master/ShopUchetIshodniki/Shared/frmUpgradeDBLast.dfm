        '--> PNT_ '#39'||PNT_;'
      '1102011964=    END ELSE BEGIN'
      '1102011965=        Err_code = gdscode;'
      
        '1102011966=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode' +
        '||'#39' --> PNT_ '#39'||PNT_;'
