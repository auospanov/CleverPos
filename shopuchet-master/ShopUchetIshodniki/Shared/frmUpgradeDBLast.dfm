      '110228488=           AND G.IS_ACTIVE = 1'
      '110228489=          INTO :G_PRODUCT_,'
      '110228490=               :G_PRODUCT_NAME_;'
      '110228491='
      
        '110228492=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
