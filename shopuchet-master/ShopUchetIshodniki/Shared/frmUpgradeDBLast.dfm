      '1105858=;'
      '1105859='
      '1105860='
      
        '1105861=/*******************************************************' +
        '***********************/'
      
        '1105862=/****            Altering stored procedures (with empty ' +
        'bodies)            ****/'
      
        '1105863=/*******************************************************' +
        '***********************/'
      '1105864=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '1105865=  G_PRODUCT_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT */ INTEGER,'
      
        '1105866=  AMOUNT_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '1105867=  PRICE_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NU' +
        'MERIC(15,2),'
      
        '1105868=  SUMM_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUME' +
        'RIC(15,2),'
      '1105869=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '1105870=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '1105871=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '1105872=  NDS_ /* TYPE OF COLUMN SKLAD.NDS */ NUMERIC(15,2),'
      
        '1105873=  NDS_SUMM_ /* TYPE OF COLUMN SKLAD.NDS_SUMM */ NUMERIC(' +
        '15,2),'
      
        '1105874=  COST_PRICE_ /* TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE' +
        ' */ NUMERIC(15,2),'
      '1105875=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1105876=  IS_SPISANIE_ INTEGER,'
      '1105877=  NEW_LINE_SALE_ INTEGER = 0,'
      '1105878=  MODE_ INTEGER = 0,'
      '1105879=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1)'
      '1105880=RETURNS ('
      
        '1105881=  ZAKAZ_DETAILS_ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS */ INTEGER,'
      '1105882=  ERR_CODE INTEGER,'
      '1105883=  ERR_MSG VARCHAR(1024))'
      '1105884=AS'
      '1105885=BEGIN'
      '1105886=  SUSPEND;'
      '1105887=END'
      '1105888=;'
      '1105889='
      '1105890='
      
        '1105891=/*******************************************************' +
        '***********************/'
      
        '1105892=/****                      Altering stored procedures   ' +
        '                   ****/'
      
        '1105893=/*******************************************************' +
        '***********************/'
      '1105894=ALTER PROCEDURE G_IMPORT_G_PRODUCT('
      '1105895=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '1105896=  ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1105897=  NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '1105898=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1105899=  NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      '11058100=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '11058101=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11058102=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11058103=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11058104=  SELF_PRICE_ NUMERIC(15,2),'
      '11058105=  AMOUNT_ MY_NUMERIC_5,'
      '11058106=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '11058107=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '11058108=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11058109=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11058110=  SELF_PRICE_UE_ NUMERIC(15,2),'
      '11058111=  IS_THIS_LAST_ INTEGER,'
      '11058112=  UPDATE_IF_EXIST_ INTEGER)'
      '11058113=RETURNS ('
      '11058114=  ERR_CODE INTEGER,'
      '11058115=  ERR_MSG VARCHAR(1024))'
      '11058116=AS'
      
        '11058117=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_IMPORT_G_PRO' +
        'DUCT'#39';'
      '11058118=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11058119=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '11058120=DECLARE VARIABLE G_UNIT_ TYPE OF COLUMN G_UNIT.G_UNIT;'
      
        '11058121=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT = 0;'
      
        '11058122=DECLARE VARIABLE G_PRODUCT_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11058123=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.SKLAD;'
      
        '11058124=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11058125=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11058126=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11058127=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11058128=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11058129=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11058130=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11058131=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11058132=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11058133=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11058134=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11058135=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11058136=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11058137=BEGIN'
      '11058138=    ERR_MSG = '#39#39';'
      '11058139='
      '11058140=    SELECT ID'
      '11058141=      FROM CUR_PARAMS'
      '11058142=    WHERE CUR_PARAMS = 2'
      '11058143=      INTO :G_TOCHKA_;'
      '11058144='
      '11058145=    SELECT G.G_UNIT'
      '11058146=      FROM G_UNIT G'
      
        '11058147=    WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:NAME_' +
        'G_UNIT_))'
      '11058148=      INTO :G_UNIT_;'
      '11058149=    if (ROW_COUNT = 0) then'
      '11058150=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '11058151='
      '11058152=    PNT_ = '#39'02'#39';'
      
        '11058153=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056 +
        #1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '11058154=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '11058155=        SELECT G.G_PRODUCT,'
      '11058156=               G.NAME'
      '11058157=          FROM G_PRODUCT G'
      
        '11058158=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_)' +
        ')'
      '11058159=           AND TRIM(G.ARTICUL) <> '#39#39
      '11058160=          INTO :G_PRODUCT_,'
      '11058161=               :G_PRODUCT_NAME_;'
      '11058162='
      
        '11058163=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11058164=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11058165=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11058166=              UPDATE G_PRODUCT G'
      '11058167=                 SET G.NAME = :NAME_,'
      '11058168=                     G.G_UNIT = :G_UNIT_,'
      '11058169=                     G.PRICE  = :PRICE_,'
      '11058170=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11058171=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11058172=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11058173=                     G.PLACE = :PLACE_,'
      
        '11058174=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11058175=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11058176=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11058177=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11058178='
      
        '11058179=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11058180=            END ELSE'
      
        '11058181=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11058182=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||U' +
        'PPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME_' +
        '||'#39'.'#39';'
      '11058183=        END'
      '11058184=    END ELSE'
      
        '11058185=      EXECUTE PROCEDURE get_free_articul RETURNING_VALU' +
        'ES (:ARTICUL_);'
      '11058186='
      
        '11058187=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052',' +
        ' '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11058188=    PNT_ = '#39'02a'#39';'
      
        '11058189=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11058190=        SELECT G.G_PRODUCT,'
      '11058191=               G.NAME'
      '11058192=          FROM G_PRODUCT G'
      
        '11058193=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_NU' +
        'M_)'
      '11058194=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '11058195=          INTO :G_PRODUCT_,'
      '11058196=               :G_PRODUCT_NAME_;'
      '11058197='
      
        '11058198=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11058199=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11058200=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11058201=              UPDATE G_PRODUCT G'
      '11058202=                 SET G.NAME = :NAME_,'
      '11058203=                     G.G_UNIT = :G_UNIT_,'
      '11058204=                     G.PRICE  = :PRICE_,'
      '11058205=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11058206=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11058207=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11058208=                     G.PLACE = :PLACE_,'
      
        '11058209=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11058210=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11058211=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11058212=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11058213='
      
        '11058214=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077 +
        #1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11058215=            END ELSE'
      
        '11058216=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11058217=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39 +
        '||G_PRODUCT_NAME_||'#39'.'#39';'
      '11058218=        END'
      '11058219=    end'
      '11058220='
      
        '11058221=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048 +
        ' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053#1054 +
        #1052#1045#1056#1059
      '11058222=    PNT_ = '#39'02b'#39';'
      
        '11058223=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '11058224=        SELECT G.G_PRODUCT,'
      '11058225=               G.NAME'
      '11058226=          FROM G_PRODUCT G'
      '11058227=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '11058228=           AND TRIM(G.BARCODE) <> '#39#39
      '11058229=          INTO :G_PRODUCT_,'
      '11058230=               :G_PRODUCT_NAME_;'
      '11058231='
      '11058232=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '11058233=          SELECT G.G_PRODUCT,'
      '11058234=                 G.NAME'
      '11058235=            FROM G_PRODUCT G, LT_BARCODE L'
      '11058236=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '11058237=             AND L.BARCODE = TRIM(:BARCODE_)'
      '11058238=             AND TRIM(L.BARCODE) <> '#39#39
      '11058239=            INTO :G_PRODUCT_,'
      '11058240=                 :G_PRODUCT_NAME_;'
      '11058241='
      
        '11058242=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11058243=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11058244=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11058245=              UPDATE G_PRODUCT G'
      '11058246=                 SET G.NAME = :NAME_,'
      '11058247=                     G.G_UNIT = :G_UNIT_,'
      '11058248=                     G.PRICE  = :PRICE_,'
      '11058249=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '11058250=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '11058251=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '11058252=                     G.PLACE = :PLACE_,'
      
        '11058253=                     G.articul         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '11058254=                     G.nomenclatur_num = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomenclat' +
        'ur_num),'
      
        '11058255=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11058256=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11058257='
      
        '11058258=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'|' +
        '|UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '11058259=            END ELSE'
      
        '11058260=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11058261=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39 +
        '||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NA' +
        'ME_||'#39'.'#39';'
      '11058262=        END'
      '11058263=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THEN'
      
        '11058264=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RETU' +
        'RNING_VALUES (:BARCODE_);'
      '11058265='
      '11058266=    PNT_ = '#39'02b'#39';'
      '11058267=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN begin'
      
        '11058268=        insert into G_PRODUCT (G_PRODUCT, G_PRODUCT_PAR' +
        ', ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUME' +
        '_PRICE,'
      
        '11058269=                               IS_CATEGORY, PACK_AMOUNT' +
        ', MF_COUNTRY, NOTE, PLACE)'
      
        '11058270=        values (GEN_ID(GEN_G_PRODUCT, 1), :G_PRODUCT_PA' +
        'R_, :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAME_, :G_UNIT_, :' +
        'PRICE_,'
      
        '11058271=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_C' +
        'OUNTRY_, :NOTE_, :PLACE_)'
      '11058272=        returning G_PRODUCT'
      '11058273=        into :G_PRODUCT_;'
      '11058274='
      
        '11058275=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT,' +
        ' G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11058276=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_PR' +
        'ODUCT_, 0, 0, :G_TOCHKA_);'
      '11058277=    end'
      '11058278='
      
        '11058279=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058#1054 +
        #1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045#1051 +
        #1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '11058280=    PNT_ = '#39'03'#39';'
      '11058281=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '11058282=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '11058283=                                       :AMOUNT_,'
      '11058284=                                       :SELF_PRICE_,'
      
        '11058285=                                       :AMOUNT_ * :SELF' +
        '_PRICE_,'
      '11058286=                                       0, --nds_,'
      '11058287=                                       0 --nds_summ_,'
      '11058288=                                       ,:SELF_PRICE_UE_'
      
        '11058289=                                       ,:AMOUNT_ * :SEL' +
        'F_PRICE_UE_'
      
        '11058290=                                       ) RETURNING_VALU' +
        'ES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '11058291=        IF (ERR_CODE <> 0) THEN BEGIN'
      '11058292=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '11058293=          EXIT;'
      '11058294=        END'
      '11058295=    END'
      '11058296='
      
        '11058297=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' ' +
        #1047#1040#1055#1048#1057#1068
      '11058298=    PNT_ = '#39'04'#39';'
      '11058299=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '11058300=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061#1054 +
        #1044
      '11058301=        FROM SKLAD_TMP T'
      '11058302=        INTO :CNT_;'
      '11058303='
      '11058304=      if (CNT_ > 0) then BEGIN'
      '11058305=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '11058306=          FROM SKLAD_TMP T'
      '11058307=          INTO :SUMM_, :SUMM_UE_;'
      '11058308='
      '11058309=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '11058310=                                DATE_RECEIPT,'
      '11058311=                                TIME_RECEIPT,'
      '11058312=                                G_CLIENT,'
      '11058313=                                G_PAYMENT_TYPE,'
      '11058314=                                OSNOVANIE,'
      '11058315=                                NOTE,'
      '11058316=                                SUMM,'
      '11058317=                                SUMM_FACT,'
      '11058318=                                SUMM_CURRENCY,'
      '11058319=                                IS_PAYED_ALL,'
      '11058320=                                IS_VOZVRAT,'
      '11058321=                                G_TOCHKA)'
      '11058322=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '11058323=                CURRENT_DATE,'
      '11058324=                CURRENT_TIME,'
      '11058325=                :G_CLIENT_,'
      '11058326=                1,'
      '11058327=                NULL,  --:OSNOVANIE_,'
      '11058328=                NULL,  -- :NOTE_,'
      '11058329=                :SUMM_,'
      '11058330=                :SUMM_,'
      '11058331=                :SUMM_UE_,'
      
        '11058332=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040 +
        ' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '11058333=                0,'
      '11058334=                :G_TOCHKA_)'
      '11058335=        RETURNING'
      '11058336=          SKLAD'
      '11058337=        INTO'
      '11058338=          :SKLAD_PARENT_;'
      '11058339='
      '11058340=        PNT_ = '#39'05'#39';'
      '11058341=        FOR SELECT SKLAD,'
      '11058342=                   G_PRODUCT,'
      '11058343=                   AMOUNT,'
      '11058344=                   PRICE,'
      '11058345=                   SUMM'
      '11058346=                   ,PRICE_CURRENCY'
      '11058347=                   ,SUMM_CURRENCY'
      '11058348=              FROM SKLAD_TMP'
      '11058349=             ORDER BY 1'
      '11058350=              INTO :SKLAD_TMP_,'
      '11058351=                   :RG_PRODUCT_,'
      '11058352=                   :RAMOUNT_,'
      '11058353=                   :RPRICE_,'
      '11058354=                   :RSUMM_'
      '11058355=                   ,:RPRICE_UE_'
      '11058356=                   ,:RSUMM_UE_'
      '11058357=        DO BEGIN'
      '11058358='
      '11058359=            UPDATE SKLAD SK'
      '11058360=               SET SK.IS_LAST = 0'
      '11058361=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '11058362=               AND SK.IS_LAST = 1;'
      '11058363='
      '11058364=            INSERT INTO SKLAD'
      '11058365=            ('
      '11058366=             SKLAD,'
      '11058367=             SKLAD_PARENT,'
      '11058368=             DATE_RECEIPT,'
      '11058369=             G_CLIENT,'
      '11058370=             G_PRODUCT,'
      '11058371=             AMOUNT,'
      '11058372=             PRICE,'
      '11058373=             SUMM,'
      '11058374=             G_PAYMENT_TYPE,'
      '11058375=             OSNOVANIE,'
      '11058376=             NOTE,'
      '11058377=             NDS,'
      '11058378=             NDS_SUMM,'
      '11058379=             IS_LAST,'
      '11058380=             IS_VOZVRAT,'
      '11058381=             G_TOCHKA'
      '11058382=             ,PRICE_CURRENCY'
      '11058383=             ,SUMM_CURRENCY'
      '11058384=            ) VALUES ('
      '11058385=             :SKLAD_TMP_,'
      '11058386=             :SKLAD_PARENT_,'
      '11058387=             CURRENT_DATE,'
      '11058388=             :G_CLIENT_,'
      '11058389=             :RG_PRODUCT_,'
      '11058390=             :RAMOUNT_,'
      '11058391=             :RPRICE_,'
      '11058392=             :RSUMM_,'
      '11058393=             1,       --:G_PAYMENT_TYPE_,'
      '11058394=             NULL,    --:OSNOVANIE_,'
      '11058395=             NULL,    --:NOTE_,'
      '11058396=             0,       --:RNDS_,'
      '11058397=             0,       --:RNDS_SUMM_,'
      '11058398=             1,       --IS_LAST_'
      '11058399=             0,        --:IS_VOZVRAT_'
      '11058400=             :G_TOCHKA_'
      '11058401=             ,:RPRICE_UE_'
      '11058402=             ,:RSUMM_UE_'
      '11058403=            );'
      '11058404='
      
        '11058405=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053 +
        #1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050 +
        #1059
      '11058406=            PNT_ = '#39'06'#39';'
      '11058407=            UPDATE LT_SKLAD_PRODUCT L'
      '11058408=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '11058409=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '11058410=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '11058411='
      '11058412=            PNT_ = '#39'06a'#39';'
      '11058413=            IF (ROW_COUNT = 0) THEN'
      
        '11058414=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA)'
      
        '11058415=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_);'
      '11058416=        END'
      '11058417='
      '11058418=        PNT_ = '#39'07'#39';'
      
        '11058419=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_' +
        ' => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11058420=                                2,    --:G_PRIHOD_RASHO' +
        'D_,'
      '11058421=                                :SUMM_,'
      '11058422=                                CURRENT_DATE,'
      
        '11058423=                                NULL,   --NOTE_ => :NOT' +
        'E_,'
      '11058424=                                NULL,   --ZAKAZ_'
      '11058425=                                :SKLAD_PARENT_,'
      '11058426=                                1,'
      
        '11058427=                                :G_TOCHKA_) RETURNING_V' +
        'ALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11058428=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11058429=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '11058430=          EXIT;'
      '11058431=        END'
      '11058432='
      '11058433=        DELETE FROM SKLAD_TMP;'
      '11058434=      END'
      '11058435=    END'
      '11058436='
      
        '11058437=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054#1069 +
        #1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '11058438=    if (ERR_MSG_ IS NOT NULL) then'
      '11058439=      ERR_MSG = ERR_MSG_;'
      '11058440='
      '11058441=WHEN ANY DO BEGIN'
      '11058442=    Err_code = gdscode;'
      
        '11058443=    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode||'#39' --' +
        '> PNT_ '#39'||PNT_;'
      '11058444=  END'
      '11058445=END'
      '11058446=;'
      '11058447='
      '11058448=ALTER PROCEDURE INS_ZAKAZ_DETAILS_TMP('
      
        '11058449=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT' +
        ','
      '11058450=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11058451=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11058452=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      '11058453=  DISCOUNT_PERC_ NUMERIC(15,5),'
      '11058454=  DISCOUNT_TENGE_ NUMERIC(15,5),'
      '11058455=  DISCOUNT_SUMM_ NUMERIC(15,5),'
      '11058456=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '11058457=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '11058458=  COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.COST_PRICE,'
      '11058459=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '11058460=  IS_SPISANIE_ INTEGER,'
      '11058461=  NEW_LINE_SALE_ INTEGER = 0,'
      '11058462=  MODE_ INTEGER = 0,'
      '11058463=  USE_SELF_PRICE_ONTRANSFER_ INTEGER = 1)'
      '11058464=RETURNS ('
      
        '11058465=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '11058466=  ERR_CODE INTEGER,'
      '11058467=  ERR_MSG VARCHAR(1024))'
      '11058468=AS'
      '11058469=/*'
      
        '11058470=MODE_  - '#1056#1045#1046#1048#1052' 0 - '#1053#1045' '#1057#1063#1048#1058#1040#1058#1068' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059', 1 - '#1057#1063#1048#1058 +
        #1040#1058#1068', 2 - '#1057#1063#1048#1058#1040#1058#1068' '#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1054#1055#1058#1054#1042#1059#1070' '#1062#1045#1053#1059
      '11058471=*/'
      
        '11058472=DECLARE VARIABLE PROCNAME VARCHAR(50) = '#39'INS_ZAKAZ_DETA' +
        'ILS_TMP'#39';'
      
        '11058473=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0;'
      
        '11058474=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS_TMP.AMOUNT = 0;'
      
        '11058475=DECLARE VARIABLE ZAKAZ_ INTEGER = 0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID ' +
        #1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1047#1040#1050#1040#1047' */'
      
        '11058476=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045 +
        ' */'
      
        '11058477=DECLARE VARIABLE PRODUCT_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '11058478=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.Z_TYPE = 0;'
      
        '11058479=DECLARE VARIABLE PRICE__ TYPE OF COLUMN ZAKAZ_DETAILS_T' +
        'MP.PRICE;'
      
        '11058480=DECLARE VARIABLE COST_PRICE__ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.COST_PRICE;'
      
        '11058481=DECLARE VARIABLE SOSTAV_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.PRICE; /* '#1062#1045#1053#1040' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1045' */'
      
        '11058482=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KI' +
        'T;'
      
        '11058483=DECLARE VARIABLE ZAKAZ_DTLS_TMP_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP.ZAKAZ_DETAILS; /* '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1059#1046#1045' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051 +
        #1048#1062#1045' */'
      '11058484=BEGIN'
      '11058485='
      
        '11058486=  --ID '#1047#1040#1050#1040#1047#1040' '#1053#1059#1046#1053#1054', '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070#1058' '#1047#1040#1050#1040#1047' '#1048' '#1044#1054#1041#1040#1042#1051#1071#1070#1058 +
        ' '#1053#1054#1042#1059#1070' '#1057#1058#1056#1054#1050#1059', '#1047#1053#1040#1063#1048#1058' '#1053#1040#1044#1054' ID '#1058#1059#1044#1040' '#1042#1055#1048#1057#1040#1058#1068
      '11058487=  SELECT T.ZAKAZ, T.Z_TYPE'
      '11058488=    FROM ZAKAZ_DETAILS_TMP T'
      '11058489=   WHERE T.ZAKAZ IS NOT NULL'
      
        '11058490=    ROWS 1 TO 1               -- '#1074#1099#1073#1080#1088#1072#1102' '#1090#1086#1083#1100#1082#1086' '#1086#1076#1085#1091' '#1089#1090 +
        #1088#1086#1082#1091', '#1074#1089#1077' '#1088#1072#1074#1085#1086' Z.ZAKAZ '#1073#1091#1076#1077#1090' '#1091' '#1074#1089#1077#1093' '#1086#1076#1080#1085', '#1072' '#1080#1085#1072#1095#1077' '#1073#1091#1076#1077#1090' '#1086#1096#1080#1073#1082#1072' ' +
        'MULTIPLE ROWS IN SINGLETON SELECT'
      '11058491=    INTO :ZAKAZ_, :Z_TYPE_;'
      '11058492='
      
        '11058493=  FOR SELECT K.G_PRODUCT_ITEM G_PRODUCT    -- '#1069#1058#1054#1058' '#1057#1045#1051#1045 +
        #1050#1058' '#1044#1051#1071' '#1055#1056#1054#1044#1040#1046#1048' '#1057#1054#1057#1058#1040#1042#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11058494=           ,G.IS_KIT'
      '11058495=           ,K.AMOUNT * :AMOUNT_'
      '11058496=           ,DECODE(:MODE_, 1, K.PRICE, 2, K.PRICE1)'
      
        '11058497=           ,DECODE(:MODE_, 1, G.PRICE, 2, G.VOLUME_PRIC' +
        'E)'
      
        '11058498=           ,DECODE(:USE_SELF_PRICE_ONTRANSFER_, 1, K.PR' +
        'ICE, (SELECT * FROM GET_LAST_SELF_PRICE(K.G_PRODUCT_ITEM, NULL, ' +
        '1))) COST_PRICE'
      
        '11058499=      FROM G_PRODUCT G LEFT OUTER JOIN G_PRODUCT_KIT K ' +
        'ON G.G_PRODUCT = K.G_PRODUCT'
      '11058500=     WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11058501=       AND IS_KIT = 1'
      '11058502=    UNION'
      
        '11058503=    SELECT :G_PRODUCT_   --'#1069#1058#1054#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1067#1061' '#1055#1056#1054#1044 +
        #1040#1046
      '11058504=           ,G.IS_KIT'
      '11058505=           ,:AMOUNT_'
      '11058506=           ,:PRICE_'
      '11058507=           ,0'
      '11058508=           ,:COST_PRICE_'
      '11058509=      FROM G_PRODUCT G'
      '11058510=     WHERE G_PRODUCT = :G_PRODUCT_'
      '11058511=       AND IS_KIT <> 1'
      '11058512=      INTO :G_PRODUCT_'
      '11058513=           ,:IS_KIT_'
      '11058514=           ,:AMOUNT_'
      '11058515=           ,:PRICE__'
      '11058516=           ,:SOSTAV_PRICE_'
      '11058517=           ,:COST_PRICE__'
      '11058518=  DO BEGIN'
      
        '11058519=      -- '#1077#1089#1083#1080' '#1094#1077#1085#1072' '#1089#1086#1089#1090#1072#1074#1085#1086#1075#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1080' '#1101#1090#1086#1084' '#1086#1090#1083#1080#1095#1072#1077#1090#1089 +
        #1103' '#1086#1090' '#1094#1077#1085#1099', '#1091#1082#1072#1079#1072#1085#1085#1086#1081' '#1074' '#1089#1087#1088#1072#1074#1086#1095#1085#1080#1082#1077', '#1090#1086' '#1089#1095#1080#1090#1072#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077' '#1082#1086#1084#1087#1083#1077 +
        #1082#1090#1072' '#1080' '#1087#1086#1090#1086#1084' '#1074#1099#1089#1090#1072#1074#1083#1103#1102' '#1089#1086#1086#1090#1085#1086#1096#1077#1085#1080#1077
      '11058520=      IF (IS_KIT_ = 1) THEN BEGIN'
      '11058521=        IF (IS_SPISANIE_ IN (1, 3)) THEN BEGIN'
      '11058522=          PRICE__ = COST_PRICE__;'
      '11058523='
      
        '11058524=        END ELSE IF (Discount_perc_ <> 0) THEN BEGIN   ' +
        '   -- '#1045#1057#1051#1048' '#1059#1050#1040#1047#1040#1053#1040' '#1057#1050#1048#1044#1050#1040
      
        '11058525=          DISCOUNT_TENGE_ = PRICE__ * DISCOUNT_PERC_/10' +
        '0;'
      '11058526='
      '11058527='
      
        '11058528=        END ELSE IF (PRICE_ <> SOSTAV_PRICE_) THEN BEGI' +
        'N   -- '#1045#1057#1051#1048' '#1062#1045#1053#1059' '#1055#1056#1054#1057#1058#1054' '#1055#1054#1052#1045#1053#1071#1051#1048', '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1071' '#1055#1054#1051#1045' '#1057#1050#1048#1044#1050#1040
      
        '11058529=          DISCOUNT_PERC_ = PRICE_ * 100 / SOSTAV_PRICE_' +
        ';'
      '11058530=          DISCOUNT_TENGE_ = SOSTAV_PRICE_ - PRICE_;'
      '11058531=        END'
      '11058532='
      '11058533=        DISCOUNT_SUMM_  = DISCOUNT_TENGE_ * AMOUNT_;'
      '11058534=        SUMM_ = (PRICE__ - DISCOUNT_TENGE_) * AMOUNT_;'
      '11058535=        NDS_SUMM_ = SUMM_ * NDS_/(100 + NDS_);'
      '11058536=      END'
      '11058537='
      
        '11058538=      -- '#1053#1045#1058' '#1051#1048' '#1059#1046#1045' '#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1047#1040#1050#1040#1047#1045', '#1045#1057#1051#1048' '#1054#1053' '#1045#1057 +
        #1058#1068' '#1048' NEW_LINE_SALE_ <> 1, '#1053#1045' '#1042#1057#1045#1052' '#1059#1044#1054#1041#1053#1054' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1047#1040#1050#1040#1047#1067
      '11058539=      IF (NEW_LINE_SALE_ = 0) THEN'
      '11058540=          SELECT ZD.zakaz_details'
      '11058541=            FROM zakaz_details_tmp ZD'
      '11058542=           WHERE ZD.G_PRODUCT = :g_product_'
      '11058543=             AND ZD.PRICE = :PRICE__'
      '11058544=             AND ZD.discount_tenge = :DISCOUNT_TENGE_'
      '11058545=            INTO :ZAKAZ_DTLS_TMP_;'
      '11058546='
      '11058547='
      '11058548=      IF (ZAKAZ_DTLS_TMP_ IS NOT NULL) THEN'
      '11058549=        UPDATE ZAKAZ_DETAILS_TMP P'
      '11058550=           SET P.amount = P.amount + :amount_'
      
        '11058551=               ,P.summ = (P.price - P.discount_TENGE) *' +
        ' (P.amount + :AMOUNT_)'
      
        '11058552=               ,P.discount_summ = P.discount_TENGE * (P' +
        '.amount + :AMOUNT_)'
      '11058553=               ,P.NDS = :NDS_'
      '11058554=               ,P.NDS_SUMM = P.NDS_SUMM + :NDS_SUMM_'
      '11058555=         WHERE P.zakaz_details = :ZAKAZ_DTLS_TMP_;'
      '11058556='
      '11058557=      ELSE BEGIN'
      '11058558=          INSERT INTO ZAKAZ_DETAILS_TMP'
      '11058559=          ('
      '11058560=           ZAKAZ_DETAILS,'
      '11058561=           ZAKAZ,'
      '11058562=           G_PRODUCT,'
      '11058563=           AMOUNT,'
      '11058564=           PRICE,'
      '11058565=           SUMM,'
      '11058566=           DISCOUNT_PERC,'
      '11058567=           DISCOUNT_TENGE,'
      '11058568=           DISCOUNT_SUMM,'
      '11058569=           NDS,'
      '11058570=           NDS_SUMM,'
      '11058571=           COST_PRICE'
      '11058572=          ) VALUES ('
      '11058573=           GEN_ID(GEN_DETAILS_TMP, 1),'
      '11058574=           :ZAKAZ_,'
      '11058575=           :G_PRODUCT_,'
      '11058576=           :AMOUNT_,'
      '11058577=           :PRICE__,'
      '11058578=           :SUMM_,'
      '11058579=           :DISCOUNT_PERC_,'
      '11058580=           :DISCOUNT_TENGE_,'
      '11058581=           :DISCOUNT_SUMM_,'
      '11058582=           :NDS_,'
      '11058583=           :NDS_SUMM_,'
      '11058584=           :COST_PRICE__'
      '11058585=          )'
      '11058586=          RETURNING'
      '11058587=            ZAKAZ_DETAILS'
      '11058588=          INTO'
      '11058589=            :ZAKAZ_DETAILS_;'
      '11058590=      END'
      '11058591='
      '11058592=      -- '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '11058593=      SELECT AMOUNT - AMOUNT_RESERVE'
      '11058594=        FROM LT_SKLAD_PRODUCT L'
      '11058595=       WHERE L.G_PRODUCT = :G_PRODUCT_'
      
        '11058596=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11058597=       INTO :AMOUNT_CUR_;'
      '11058598='
      
        '11058599=      -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048 +
        #1058#1054#1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '11058600=      if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      
        '11058601=          -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040 +
        #1050#1058#1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '11058602=          -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056 +
        #1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '11058603=          -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '11058604=          -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' ' +
        #1041#1067#1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050 +
        #1054#1051#1068#1050#1054
      
        '11058605=          -- '#1041#1067#1051#1054' '#1048#1047#1052#1045#1053#1045#1053#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054', '#1044#1040#1041#1067' '#1053#1045' '#1044#1059#1041#1051#1048#1056#1054#1042 +
        #1040#1058#1068' '#1055#1056#1048#1041#1040#1042#1051#1045#1053#1048#1045' '#1059#1046#1045' '#1055#1056#1054#1044#1040#1053#1053#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      '11058606=          IF (ZAKAZ_ IS NOT NULL) THEN BEGIN'
      '11058607=            IF (COALESCE(Z_TYPE_, 0) <> 3) THEN'
      '11058608=              SELECT SUM(AMOUNT)'
      '11058609=                FROM ZAKAZ_DETAILS T'
      '11058610=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11058611=                 AND T.ZAKAZ = :ZAKAZ_'
      '11058612=                INTO :AMOUNT_OLD_;'
      '11058613=            ELSE'
      '11058614=              SELECT SUM(AMOUNT)'
      '11058615=                FROM SKLAD T'
      '11058616=               WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11058617=                 AND T.SKLAD_PARENT = :ZAKAZ_'
      '11058618=                INTO :AMOUNT_OLD_;'
      '11058619=          END'
      '11058620='
      '11058621=          -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1047#1040#1050#1040#1047#1045
      '11058622=          SELECT SUM(AMOUNT)'
      '11058623=            FROM ZAKAZ_DETAILS_TMP T'
      '11058624=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11058625=           INTO :AMOUNT_CUR_ZAKAZ_;'
      '11058626='
      
        '11058627=          AMOUNT_CUR_ZAKAZ_ = COALESCE(AMOUNT_CUR_ZAKAZ' +
        '_, 0);'
      '11058628=          AMOUNT_OLD_       = COALESCE(AMOUNT_OLD_, 0);'
      '11058629='
      
        '11058630=          IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COAL' +
        'ESCE(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '11058631=            SELECT NAME'
      '11058632=            FROM G_PRODUCT'
      '11058633=            WHERE G_PRODUCT = :G_PRODUCT_'
      '11058634=            INTO :PRODUCT_NAME_;'
      '11058635='
      '11058636=            ERR_CODE = -20500;'
      
        '11058637=            ERR_MSG = '#39#1050#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' "'#39'||PRODUCT_NA' +
        'ME_||'#39'" '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39'||ASCII_CHAR(10)||'
      
        '11058638=                      '#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082#1086 +
        #1084' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39';'
      
        '11058639=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR' +
        '_MSG) RETURNING_VALUES (:ERR_MSG);'
      '11058640=            ERR_MSG = PROCNAME||ERR_MSG;'
      '11058641=            EXIT;'
      '11058642=          END'
      '11058643=      END'
      '11058644=  END'
      '11058645=end'
      '11058646=;'
      '11058647='
      '11058648='
      
        '11058649=/******************************************************' +
        '************************/'
      
        '11058650=/****                   Restoring deactivated procedure' +
        's                   ****/'
      
        '11058651=/******************************************************' +
        '************************/'
      '11058652=ALTER PROCEDURE IMPORT_DOWNLOAD('
      '11058653=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11058654=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11058655=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11058656=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '11058657=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '11058658=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11058659=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11058660=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '11058661=RETURNS ('
      '11058662=  ERR_CODE INTEGER,'
      '11058663=  ERR_MSG VARCHAR(1024))'
      '11058664=AS'
      '11058665=/*'
      
        '11058666='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059' '#1044 +
        #1040#1053#1053#1067#1061
      
        '11058667='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054' '#1055 +
        #1054' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '11058668='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '11058669=*/'
      
        '11058670=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'IMPORT_DOWNLOA' +
        'D'#39';'
      '11058671=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11058672=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.BARCODE;'
      
        '11058673=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.ARTICUL;'
      
        '11058674=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TMP.' +
        'AMOUNT;'
      
        '11058675=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP.P' +
        'RICE;'
      
        '11058676=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL_T' +
        'MP.PRICE;'
      
        '11058677=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.DISCOUNT;'
      '11058678=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '11058679=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11058680=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2)' +
        ';'
      
        '11058681=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      '11058682=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '11058683=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS_TMP.ZAKAZ_DETAILS;'
      
        '11058684=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      '11058685=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11058686=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_C' +
        'ASH;'
      
        '11058687=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_NONCASH;'
      
        '11058688=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NONCA' +
        'SH;'
      '11058689=BEGIN'
      '11058690='
      '11058691=  PNT_ = '#39'00'#39';'
      '11058692=  CLRF = ascii_char( 10 );'
      '11058693='
      '11058694=  SELECT S.S_VALUE'
      '11058695=    FROM SYSTEM_SETUP S'
      '11058696=   WHERE S.SYSTEM_SETUP = 2'
      '11058697=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '11058698='
      '11058699=  PNT_ = '#39'01'#39';'
      '11058700=  SELECT G.nds_value'
      '11058701=    FROM G_FIRM_REKVIZIT G'
      '11058702=   WHERE G.is_default = 1'
      '11058703=    INTO :NDS_;'
      '11058704='
      '11058705=  PNT_ = '#39'02'#39';'
      
        '11058706=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39')), ARTICUL, AMOU' +
        'NT, PRICE, DISCOUNT'
      '11058707=        FROM IMPORT_TBL_TMP'
      
        '11058708=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_, :' +
        'DISCOUNT_'
      '11058709=  DO BEGIN'
      '11058710=    SELECT G_PRODUCT,'
      '11058711=           PRICE'
      '11058712=      FROM ('
      '11058713=            SELECT P.G_PRODUCT, P.price'
      '11058714=              FROM G_PRODUCT P'
      
        '11058715=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(COAL' +
        'ESCE(P.BARCODE, '#39#39')) <> '#39#39')'
      
        '11058716=                OR (P.ARTICUL = :ARTICUL_ and TRIM(COAL' +
        'ESCE(P.ARTICUL, '#39#39')) <> '#39#39')'
      '11058717=            UNION'
      '11058718=            SELECT LT.G_PRODUCT, P.PRICE'
      '11058719=              FROM LT_BARCODE LT, g_product P'
      
        '11058720=             WHERE LT.BARCODE = :BARCODE_ and TRIM(COAL' +
        'ESCE(LT.BARCODE, '#39#39')) <> '#39#39
      '11058721=               AND LT.g_product = P.g_product'
      '11058722=           )'
      '11058723=      INTO :G_PRODUCT_,'
      '11058724=           :PRICE_OUR_;'
      '11058725='
      '11058726=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '11058727=      ERR_CODE = -20500;'
      
        '11058728=      ERR_MSG = '#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39'||' +
        'BARCODE_||'#39', '#1072#1088#1090#1080#1082#1091#1083' '#39'||ARTICUL_;'
      '11058729=      Exit;'
      '11058730=    END'
      '11058731='
      '11058732=    PNT_ = '#39'03'#39';'
      
        '11058733=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / PR' +
        'ICE_;'
      
        '11058734=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, ' +
        ':G_TOCHKA_, 1)'
      '11058735=      RETURNING_VALUES :COST_PRICE_;'
      '11058736='
      '11058737=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '11058738=    IF (price_ IS NULL) THEN'
      '11058739=      PRICE_ = PRICE_OUR_;'
      '11058740='
      '11058741=    PNT_ = '#39'04'#39';'
      
        '11058742=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PRODUC' +
        'T_,'
      '11058743=                                              :AMOUNT_,'
      '11058744=                                              :PRICE_,'
      
        '11058745=                                              :AMOUNT_ ' +
        '* (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '11058746=                                              :DISCOUNT' +
        '_PERC_,'
      
        '11058747=                                              :DISCOUNT' +
        '_,'
      
        '11058748=                                              :AMOUNT_ ' +
        '* :DISCOUNT_,'
      '11058749=                                              :NDS_,'
      
        '11058750=                                              SUMM_ * N' +
        'DS_ / (100 + NDS_),'
      
        '11058751=                                              :COST_PRI' +
        'CE_,'
      
        '11058752=                                              :ALLOW_SE' +
        'LL_ABSENT_GOODS_,'
      
        '11058753=                                              0,     --' +
        'IS_SPISANIE_'
      
        '11058754=                                              1,     --' +
        ' NEW_LINE_SALE_'
      
        '11058755=                                              0     --M' +
        'ODE_'
      
        '11058756=                                              ) RETURNI' +
        'NG_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '11058757=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11058758=      ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE =' +
        ' '#39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_M' +
        'SG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11058759=      EXIT;'
      '11058760=    END'
      '11058761='
      '11058762=    G_PRODUCT_ = NULL;'
      '11058763=  END'
      '11058764='
      '11058765=  PNT_ = '#39'05'#39';'
      '11058766=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '11058767=    SELECT SUM(T.summ)'
      '11058768=      FROM ZAKAZ_DETAILS_TMP T'
      '11058769=      INTO :SUMM_;'
      '11058770=    SUMM_FACT_ = SUMM_;'
      '11058771=  END'
      '11058772='
      '11058773=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '11058774=  if (G_PAYMENT_TYPE_ = 1) then'
      '11058775=    SUMM_CASH_ = summ_fact_;'
      '11058776=  ELSE'
      '11058777=    SUMM_NONCASH_ = summ_fact_;'
      '11058778='
      '11058779=  PNT_ = '#39'06'#39';'
      '11058780=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '11058781=    G_CLIENT_ = 10;'
      '11058782='
      '11058783=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '11058784=                              :Z_DATE_,'
      '11058785=                              :Z_TIME_,'
      '11058786=                              :G_CLIENT_,'
      '11058787=                              :G_PAYMENT_TYPE_,'
      '11058788=                              '#39#39', --:OSNOVANIE_,'
      '11058789=                              0,  -- IS_SPISANIE'
      
        '11058790=                              '#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39'||:NOTE_' +
        ','
      '11058791=                              :SUMM_,'
      '11058792=                              :SUMM_FACT_,'
      '11058793=                              :SUMM_CASH_,'
      '11058794=                              :SUMM_NONCASH_,'
      
        '11058795=                              0,    --:SUMM_PAY_BONUS__' +
        ','
      
        '11058796=                              0,    --:SUMM_BONUS_GOT__' +
        ','
      
        '11058797=                              NULL,        --:G_PRIHOD_' +
        ','
      
        '11058798=                              NULL,        --:SUMM_PRIH' +
        'OD_'
      '11058799=                              0,    -- :BY_RECIPE__,'
      '11058800=                              0,    -- IS_RESERVE__'
      '11058801=                              NULL -- :PAYMENTS__'
      '11058802=                              )'
      
        '11058803=                              RETURNING_VALUES :ZAKAZ_,' +
        ' :ERR_CODE, :ERR_MSG;'
      '11058804=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11058805=    ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE = ' +
        #39'||ERR_CODE||'#39'. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_MS' +
        'G) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11058806=    EXIT;'
      '11058807=  END'
      '11058808='
      '11058809=  DELETE FROM import_tbl_tmp;'
      '11058810='
      '11058811=WHEN ANY DO BEGIN'
      '11058812=    ERR_CODE = gdscode;'
      
        '11058813=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||gdscode' +
        ';'
      '11058814=  END'
      '11058815=end'
      '11058816=;'
      '11058817='
      '11058818=ALTER PROCEDURE SYNC_DOWNLOAD('
      '11058819=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '11058820=  UPLOAD_TABLE_TMP TYPE OF COLUMN UPLOAD_TABLE_TMP.UPLO' +
        'AD_TABLE_TMP,'
      '11058821=  MODE TYPE OF COLUMN UPLOAD_TABLE_TMP.MODE,'
      '11058822=  PARENT TYPE OF COLUMN UPLOAD_TABLE_TMP.PARENT,'
      '11058823=  DATE_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.DATE_OPER,'
      '11058824=  TIME_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.TIME_OPER,'
      '11058825=  G_CLIENT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_CLIENT,'
      
        '11058826=  G_PAYMENT_TYPE TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PAYM' +
        'ENT_TYPE,'
      '11058827=  SUMM_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_ALL,'
      
        '11058828=  SUMM_FACT_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_FA' +
        'CT_ALL,'
      
        '11058829=  SUMM_PAY_BONUS TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_P' +
        'AY_BONUS,'
      
        '11058830=  SUMM_BONUS_GOT TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_B' +
        'ONUS_GOT,'
      '11058831=  OSNOVANIE TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE,'
      '11058832=  NOTE TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE,'
      
        '11058833=  G_OFFICIAL TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICIAL' +
        ','
      '11058834=  G_PRODUCT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT,'
      '11058835=  AMOUNT TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT,'
      '11058836=  PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE,'
      '11058837=  SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM,'
      
        '11058838=  DISCOUNT_PERC TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOUN' +
        'T_PERC,'
      
        '11058839=  DISCOUNT_TENGE TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_TENGE,'
      
        '11058840=  DISCOUNT_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOUN' +
        'T_SUMM,'
      '11058841=  NDS TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS,'
      '11058842=  NDS_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM,'
      
        '11058843=  COST_PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRICE' +
        ','
      '11058844=  BY_RECIPE TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE,'
      
        '11058845=  IS_RESERVE TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESERVE' +
        ','
      '11058846=  PAYMENTS BLOB SUB_TYPE 1,'
      '11058847=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11058848=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11058849=  IS_LOAD_ INTEGER)'
      '11058850=RETURNS ('
      '11058851=  ERR_CODE INTEGER,'
      '11058852=  ERR_MSG VARCHAR(1024))'
      '11058853=AS'
      '11058854=/*'
      '11058855='#1050#1040#1050' '#1056#1040#1041#1054#1058#1040#1045#1058' '#1055#1056#1054#1062#1045#1044#1059#1056#1040'.'
      
        '11058856='#1048#1044#1059' '#1055#1054' '#1042#1057#1045#1052' '#1055#1054#1054#1063#1045#1056#1045#1044#1053#1054', '#1055#1045#1056#1045#1044' '#1050#1040#1046#1044#1067#1052' '#1058#1048#1055#1054#1052' '#1055#1056#1054#1062#1045#1057#1057#1040' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '11058857='#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1062#1048#1050#1051#1054#1052' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070 +
        ' '#1058#1040#1041#1051#1048#1062#1059
      '11058858=*/'
      
        '11058859=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_DOWNLOAD'#39 +
        ';'
      '11058860=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11058861=DECLARE VARIABLE MODE_ TYPE OF COLUMN UPLOAD_TABLE_TMP.' +
        'MODE;'
      
        '11058862=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PROD' +
        'UCT;'
      '11058863=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '11058864=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '11058865=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '11058866=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '11058867=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUM' +
        'M;'
      
        '11058868=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '11058869=DECLARE VARIABLE BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_REC' +
        'IPE;'
      
        '11058870=DECLARE VARIABLE BY_RECIPE__ TYPE OF COLUMN ZAKAZ.BY_RE' +
        'CIPE;'
      
        '11058871=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RE' +
        'SERVE;'
      
        '11058872=DECLARE VARIABLE IS_RESERVE__ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '11058873=DECLARE VARIABLE PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '11058874=DECLARE VARIABLE PAYMENTS__ BLOB SUB_TYPE 1 SEGMENT SIZ' +
        'E 80;'
      
        '11058875=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.' +
        'G_CLIENT;'
      
        '11058876=DECLARE VARIABLE G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.G_PAYMENT_TYPE;'
      
        '11058877=DECLARE VARIABLE OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT' +
        '.OSNOVANIE;'
      
        '11058878=DECLARE VARIABLE NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE' +
        ';'
      
        '11058879=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN SKLAD_PARENT.' +
        'SUMM;'
      
        '11058880=DECLARE VARIABLE SUMM_FACT_ALL_ TYPE OF COLUMN SKLAD_PA' +
        'RENT.SUMM_FACT;'
      
        '11058881=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS;'
      
        '11058882=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_BONUS_GOT;'
      
        '11058883=DECLARE VARIABLE PARENT_ TYPE OF COLUMN UPLOAD_TABLE_TM' +
        'P.PARENT;'
      
        '11058884=DECLARE VARIABLE PARENT_OLD_ TYPE OF COLUMN UPLOAD_TABL' +
        'E_TMP.PARENT;'
      '11058885=DECLARE VARIABLE MODE_OLD_ INTEGER;'
      '11058886=DECLARE VARIABLE DATE_OPER__ DATE;'
      '11058887=DECLARE VARIABLE TIME_OPER__ TIME;'
      
        '11058888=DECLARE VARIABLE G_CLIENT__ TYPE OF COLUMN G_CLIENT.G_C' +
        'LIENT;'
      
        '11058889=DECLARE VARIABLE G_PAYMENT_TYPE__ TYPE OF COLUMN G_PAYM' +
        'ENT_TYPE.G_PAYMENT_TYPE;'
      
        '11058890=DECLARE VARIABLE OSNOVANIE__ TYPE OF COLUMN ZAKAZ.OSNOV' +
        'ANIE;'
      '11058891=DECLARE VARIABLE NOTE__ TYPE OF COLUMN ZAKAZ.NOTE;'
      '11058892=DECLARE VARIABLE SUMM__ NUMERIC(15,2);'
      '11058893=DECLARE VARIABLE SUMM_FACT__ NUMERIC(15,2);'
      
        '11058894=DECLARE VARIABLE SUMM_CASH__ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      
        '11058895=DECLARE VARIABLE SUMM_NONCASH__ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '11058896=DECLARE VARIABLE SUMM_PAY_BONUS__ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '11058897=DECLARE VARIABLE SUMM_BONUS_GOT__ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '11058898=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      
        '11058899=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2)' +
        ';'
      
        '11058900=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.ZAKAZ_DETAILS;'
      '11058901=DECLARE VARIABLE DATE_OPER_ DATE;'
      '11058902=DECLARE VARIABLE TIME_OPER_ TIME;'
      
        '11058903=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '11058904=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11058905=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      
        '11058906=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN ZAKAZ.G_OFF' +
        'ICIAL;'
      
        '11058907=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PARE' +
        'NT;'
      '11058908=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11058909=DECLARE VARIABLE IS_FIRST_TIME_ INTEGER = 0; /* '#1054#1041#1056#1040#1041#1040#1058 +
        #1067#1042#1040#1045#1058#1057#1071' '#1055#1045#1056#1042#1040#1071' '#1057#1058#1056#1054#1050#1040' 0, '#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1057#1058#1056#1054#1050#1048' = 1 */'
      '11058910=BEGIN'
      '11058911=  PNT_ = '#39'00'#39';'
      '11058912=  IF (IS_LOAD_ = 0) THEN BEGIN'
      '11058913=      SELECT 1'
      '11058914=        FROM G_PRODUCT G'
      '11058915=       WHERE G.G_PRODUCT = :G_PRODUCT'
      '11058916=       INTO :G_PRODUCT_;'
      '11058917='
      '11058918=      IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '11058919=        ERR_CODE = -20500;'
      
        '11058920=        ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072': '#1090#1086#1074#1072#1088' '#1089' '#1080#1076#1077#1085#1090#1080#1092#1080#1082#1072#1090#1086#1088#1086#1084' '#39'||' +
        'G_PRODUCT||'#39' '#1086#1090#1089#1091#1090#1089#1090#1074#1091#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'.'#39';'
      '11058921=        Exit;'
      '11058922=      END'
      '11058923='
      
        '11058924=      INSERT INTO UPLOAD_TABLE_TMP (UPLOAD_TABLE_TMP, M' +
        'ODE, PARENT, DATE_OPER, TIME_OPER, G_CLIENT, G_PAYMENT_TYPE,'
      
        '11058925=                                    SUMM_ALL, SUMM_FACT' +
        '_ALL, SUMM_PAY_BONUS, SUMM_BONUS_GOT, OSNOVANIE, NOTE, G_OFFICIA' +
        'L, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '11058926=                                    DISCOUNT_TENGE, DIS' +
        'COUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RESERVE, PA' +
        'YMENTS)'
      
        '11058927=      VALUES (:UPLOAD_TABLE_TMP, :MODE, :PARENT, :DATE_' +
        'OPER, :TIME_OPER, DECODE(:G_CLIENT, 0, NULL, :G_CLIENT), :G_PAYM' +
        'ENT_TYPE,'
      
        '11058928=              :SUMM_ALL, :SUMM_FACT_ALL, :SUMM_PAY_BONU' +
        'S, :SUMM_BONUS_GOT, :OSNOVANIE, :NOTE, :G_OFFICIAL, :G_PRODUCT, ' +
        ':AMOUNT, :PRICE, :SUMM, :DISCOUNT_PERC,'
      
        '11058929=              :DISCOUNT_TENGE, :DISCOUNT_SUMM, :NDS, :N' +
        'DS_SUMM, :COST_PRICE, :BY_RECIPE, :IS_RESERVE, :PAYMENTS);'
      '11058930='
      '11058931=  END ELSE BEGIN'
      '11058932=      PNT_ = '#39'01'#39';'
      '11058933=      IF (G_TOCHKA_ IS NULL) THEN'
      '11058934=        SELECT ID'
      '11058935=          FROM CUR_PARAMS'
      '11058936=         WHERE CUR_PARAMS = 2'
      '11058937=          INTO :G_TOCHKA_;'
      '11058938='
      
        '11058939=      FOR SELECT MODE, PARENT, DATE_OPER, TIME_OPER, G_' +
        'CLIENT, G_PAYMENT_TYPE, SUMM_ALL, SUMM_FACT_ALL, SUMM_PAY_BONUS,' +
        ' SUMM_BONUS_GOT, OSNOVANIE,'
      
        '11058940=                 NOTE, G_OFFICIAL, G_PRODUCT, AMOUNT, P' +
        'RICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      
        '11058941=                 NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RE' +
        'SERVE, PAYMENTS'
      '11058942=          FROM UPLOAD_TABLE_TMP'
      
        '11058943=          WHERE MODE <> 6        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040 +
        ' '#1041#1059#1044#1059' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1054#1058#1044#1045#1051#1068#1053#1054', '#1058#1040#1052' '#1044#1056#1059#1043#1054#1049' '#1055#1056#1048#1053#1062#1048#1055
      '11058944=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '11058945=          INTO :MODE_, :PARENT_, :DATE_OPER_, :TIME_OPE' +
        'R_, :G_CLIENT_, :G_PAYMENT_TYPE_, :SUMM_ALL_, :SUMM_FACT_ALL_,  ' +
        ':SUMM_PAY_BONUS_, :SUMM_BONUS_GOT_,'
      
        '11058946=               :OSNOVANIE_, :NOTE_, :G_OFFICIAL_, :G_PR' +
        'ODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_PERC_, :DISCOUNT_TE' +
        'NGE_,'
      
        '11058947=               :DISCOUNT_SUMM_, :NDS_, :NDS_SUMM_, :COS' +
        'T_PRICE_, :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_'
      '11058948=      DO BEGIN'
      '11058949=          -- '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '11058950=          PNT_ = '#39'02'#39';'
      
        '11058951=          IF (PARENT_ <> PARENT_OLD_ AND IS_FIRST_TIME_' +
        ' = 1) THEN BEGIN'
      '11058952=            IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '11058953=              PNT_ = '#39'02a'#39';'
      '11058954=              EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '11058955=                                          :DATE_OPER__,'
      '11058956=                                          :TIME_OPER__,'
      '11058957=                                          :G_CLIENT__,'
      
        '11058958=                                          :G_PAYMENT_TY' +
        'PE__,'
      '11058959=                                          :OSNOVANIE__,'
      '11058960=                                          :NOTE__,'
      
        '11058961=                                          DECODE(:MODE_' +
        'OLD_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '11058962=                                          :SUMM__,'
      '11058963=                                          :SUMM_FACT__,'
      
        '11058964=                                          0, --:G_PRIHO' +
        'D_,'
      
        '11058965=                                          0 --:SUMM_PRI' +
        'HOD_)'
      
        '11058966=                                          ,:PAYMENTS__ ' +
        ' -- PAYMENTS'
      
        '11058967=                                         )RETURNING_VAL' +
        'UES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '11058968=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11058969=                ERR_MSG  = '#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074 +
        #1072#1088#1072' (01).'#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_MSG) + 3 ' +
        'FOR CHAR_LENGTH(ERR_MSG));'
      '11058970=                EXIT;'
      '11058971=              END'
      '11058972=            END'
      '11058973=            ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '11058974=              PNT_ = '#39'03'#39';'
      '11058975=              EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '11058976=                                          :DATE_OPER__,'
      '11058977=                                          :TIME_OPER__,'
      '11058978=                                          :G_CLIENT__,'
      
        '11058979=                                          :G_PAYMENT_TY' +
        'PE__,'
      '11058980=                                          :OSNOVANIE__,'
      
        '11058981=                                          DECODE(MODE_O' +
        'LD_,'
      
        '11058982=                                                 2, 0, ' +
        '  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '11058983=                                                 3, 1, ' +
        '  -- '#1057#1055#1048#1057#1040#1053#1048#1045
      
        '11058984=                                                 5, 3),' +
        '  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11058985=                                          :NOTE__,'
      '11058986=                                          :SUMM__,'
      '11058987=                                          :SUMM_FACT__,'
      '11058988=                                          :SUMM_CASH__,'
      
        '11058989=                                          :SUMM_NONCASH' +
        '__,'
      
        '11058990=                                          :SUMM_PAY_BON' +
        'US__,'
      
        '11058991=                                          :SUMM_BONUS_G' +
        'OT__,'
      
        '11058992=                                          NULL,        ' +
        '--:G_PRIHOD_,'
      
        '11058993=                                          NULL,        ' +
        '--:SUMM_PRIHOD_'
      '11058994=                                          :BY_RECIPE__,'
      '11058995=                                          :IS_RESERVE__'
      '11058996=                                          ,:PAYMENTS__'
      '11058997=                                          )'
      
        '11058998=                                          RETURNING_VAL' +
        'UES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '11058999=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110581000=                ERR_MSG  = '#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' ' +
        '(02). '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_MSG) + 3 FOR' +
        ' CHAR_LENGTH(ERR_MSG));'
      '110581001=                EXIT;'
      '110581002=              END'
      '110581003='
      '110581004=              PNT_ = '#39'03a'#39';'
      '110581005=              UPDATE ZAKAZ Z'
      
        '110581006=              SET Z.G_OFFICIAL = DECODE(:G_OFFICIAL__,' +
        ' 0, NULL, NULL, NULL)'
      '110581007=              WHERE Z.ZAKAZ = :ZAKAZ_;'
      '110581008=            END'
      '110581009=          END'
      
        '110581010=          -- '#1050#1054#1053#1045#1062' '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055 +
        #1056#1048#1061#1054#1044#1040
      
        '110581011=          -- '#1053#1040#1063#1040#1051#1054' '#1042#1057#1058#1040#1042#1050#1048' '#1044#1045#1058#1040#1051#1045#1049' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1059' '#1048#1051#1048' '#1047#1040#1050 +
        #1040#1047#1059' '#1058#1054#1042#1040#1056#1040
      '110581012='
      '110581013=          PNT_ = '#39'03b'#39';'
      '110581014=          IF (MODE_ IN (0,1,4)) THEN'
      
        '110581015=              INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT,' +
        ' AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110581016=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_);'
      '110581017='
      '110581018=          ELSE IF (MODE_ IN (2,3,5)) THEN BEGIN'
      '110581019=              PNT_ = '#39'04'#39';'
      '110581020=              SELECT S.S_VALUE'
      '110581021=              FROM SYSTEM_SETUP S'
      '110581022=              WHERE S.SYSTEM_SETUP = 2'
      '110581023=              INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110581024='
      
        '110581025=              EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(' +
        ':G_PRODUCT_,'
      
        '110581026=                                                      ' +
        ':AMOUNT_,'
      
        '110581027=                                                      ' +
        ':PRICE_,'
      
        '110581028=                                                      ' +
        ':SUMM_,'
      
        '110581029=                                                      ' +
        ':DISCOUNT_PERC_,'
      
        '110581030=                                                      ' +
        ':DISCOUNT_TENGE_,'
      
        '110581031=                                                      ' +
        ':DISCOUNT_SUMM_,'
      
        '110581032=                                                      ' +
        ':NDS_,'
      
        '110581033=                                                      ' +
        ':NDS_SUMM_,'
      
        '110581034=                                                      ' +
        ':COST_PRICE_,'
      
        '110581035=                                                      ' +
        ':ALLOW_SELL_ABSENT_GOODS_,'
      
        '110581036=                                                      ' +
        '0,     --IS_SPISANIE_'
      
        '110581037=                                                      ' +
        '1,     -- NEW_LINE_SALE_'
      
        '110581038=                                                      ' +
        '0     --MODE_'
      
        '110581039=                                                      ' +
        ') RETURNING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '110581040=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110581041=                ERR_MSG  = '#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' ' +
        '(03). '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_MSG) + 3 FOR' +
        ' CHAR_LENGTH(ERR_MSG));'
      '110581042=                EXIT;'
      '110581043=              END'
      '110581044=          END'
      '110581045='
      '110581046=          PARENT_OLD_ = PARENT_;'
      '110581047=          DATE_OPER__ = DATE_OPER_;'
      '110581048=          TIME_OPER__ = TIME_OPER_;'
      '110581049=          G_CLIENT__  = G_CLIENT_;'
      '110581050=          G_PAYMENT_TYPE__ = G_PAYMENT_TYPE_;'
      '110581051=          OSNOVANIE__      = OSNOVANIE_;'
      '110581052=          NOTE__           = NOTE_;'
      '110581053=          SUMM__           = SUMM_ALL_;'
      '110581054=          SUMM_FACT__      = SUMM_FACT_ALL_;'
      '110581055=          SUMM_PAY_BONUS__ = SUMM_PAY_BONUS_;'
      '110581056=          SUMM_BONUS_GOT__ = SUMM_BONUS_GOT_;'
      '110581057=          G_OFFICIAL__     = G_OFFICIAL_;'
      '110581058=          BY_RECIPE__      = BY_RECIPE_;'
      '110581059=          IS_RESERVE__     = COALESCE(IS_RESERVE_, 0);'
      '110581060=          IS_FIRST_TIME_   = 1;'
      '110581061=          PAYMENTS__       = PAYMENTS_;'
      '110581062=          MODE_OLD_        = MODE_;'
      '110581063=      END'
      '110581064='
      
        '110581065=      -- '#1055#1054#1057#1051#1045' '#1054#1050#1054#1053#1063#1040#1053#1048#1071' '#1055#1056#1054#1061#1054#1044#1040' '#1055#1054' '#1042#1057#1045#1052' '#1047#1040#1055#1048#1057#1071#1052' '#1053#1045#1054#1041#1061 +
        #1054#1044#1048#1052#1054' '#1055#1056#1054#1042#1045#1057#1058#1048' '#1042#1057#1058#1040#1042#1050#1059' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110581066=      IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '110581067=          PNT_ = '#39'05'#39';'
      '110581068=          EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110581069=                                      :DATE_OPER__,'
      '110581070=                                      :TIME_OPER__,'
      '110581071=                                      :G_CLIENT__,'
      
        '110581072=                                      :G_PAYMENT_TYPE_' +
        '_,'
      '110581073=                                      :OSNOVANIE__,'
      '110581074=                                      :NOTE__,'
      
        '110581075=                                      DECODE(:MODE_OLD' +
        '_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '110581076=                                      :SUMM__,'
      '110581077=                                      :SUMM_FACT__,'
      '110581078=                                      0, --:G_PRIHOD_,'
      
        '110581079=                                      0 --:SUMM_PRIHOD' +
        '_)'
      '110581080=                                     ,:PAYMENTS__'
      
        '110581081=                                     )RETURNING_VALUES' +
        ' :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110581082=          IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110581083=            ERR_MSG  =  '#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088 +
        #1072' (04).'#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_MSG) + 3 FO' +
        'R CHAR_LENGTH(ERR_MSG));'
      '110581084=            EXIT;'
      '110581085=          END'
      '110581086=      END'
      '110581087=      ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '110581088=          PNT_ = '#39'06'#39';'
      '110581089=          EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110581090=                                      :DATE_OPER__,'
      '110581091=                                      :TIME_OPER__,'
      '110581092=                                      :G_CLIENT__,'
      
        '110581093=                                      :G_PAYMENT_TYPE_' +
        '_,'
      '110581094=                                      :OSNOVANIE__,'
      
        '110581095=                                      DECODE(MODE_OLD_' +
        ', 2, 0, 3, 1),  --:IS_SPISANIE_,'
      '110581096=                                      :NOTE__,'
      '110581097=                                      :SUMM__,'
      '110581098=                                      :SUMM_FACT__,'
      '110581099=                                      :SUMM_CASH__,'
      '110581100=                                      :SUMM_NONCASH__,'
      
        '110581101=                                      :SUMM_PAY_BONUS_' +
        '_,'
      
        '110581102=                                      :SUMM_BONUS_GOT_' +
        '_,'
      
        '110581103=                                      NULL,        --:' +
        'G_PRIHOD_,'
      
        '110581104=                                      NULL,        --:' +
        'SUMM_PRIHOD_'
      '110581105=                                      :BY_RECIPE__,'
      '110581106=                                      :IS_RESERVE__'
      '110581107=                                      ,:PAYMENTS__'
      '110581108=                                      )'
      
        '110581109=                                      RETURNING_VALUES' +
        ' :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110581110=          IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110581111=            ERR_MSG  = '#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' (05)' +
        '. '#39'||SUBSTRING(ERR_MSG FROM POSITION('#39'/R\'#39', ERR_MSG) + 3 FOR CHA' +
        'R_LENGTH(ERR_MSG));'
      '110581112=            EXIT;'
      '110581113=          END'
      '110581114='
      '110581115=          UPDATE ZAKAZ Z'
      
        '110581116=          SET Z.G_OFFICIAL = DECODE(:G_OFFICIAL__, 0, ' +
        'NULL, NULL, NULL)'
      '110581117=          WHERE Z.ZAKAZ = :ZAKAZ_;'
      '110581118=      END'
      '110581119='
      '110581120=      -- '#1058#1045#1055#1045#1056#1068' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1070#1058' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110581121=      FOR SELECT DATE_OPER, NOTE, G_PRODUCT, AMOUNT'
      '110581122=          FROM UPLOAD_TABLE_TMP'
      '110581123=          WHERE MODE = 6'
      '110581124=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110581125=          INTO :DATE_OPER_, :NOTE_, :G_PRODUCT_, :AMOU' +
        'NT_'
      '110581126=      DO BEGIN'
      '110581127=        EXECUTE PROCEDURE DO_PRODUCT(:G_TOCHKA_,'
      '110581128=                                   :DATE_OPER_,'
      '110581129=                                   :G_PRODUCT_,'
      '110581130=                                   :AMOUNT_,'
      '110581131=                                   :NOTE_)'
      
        '110581132=                                   RETURNING_VALUES :S' +
        'KLAD_, :ERR_CODE, :ERR_MSG;'
      '110581133=      END'
      '110581134='
      
        '110581135=      DELETE FROM UPLOAD_TABLE_TMP WHERE UPLOAD_TABLE_' +
        'TMP = UPLOAD_TABLE_TMP;'
      '110581136=  END'
      '110581137='
      '110581138=WHEN ANY DO BEGIN'
      '110581139=    Err_code = -20500;'
      
        '110581140=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110581141=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110581142=  END'
      '110581143=end'
      '110581144=;'
      '110581145=ALTER PROCEDURE INS_SKLAD_TMP('
      '110581146=  G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '110581147=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110581148=  PRICE_ NUMERIC(15,2),'
      '110581149=  SUMM_ NUMERIC(15,2),'
      '110581150=  NDS_ NUMERIC(15,2),'
      '110581151=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      
        '110581152=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110581153=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0)'
      '110581154=RETURNS ('
      '110581155=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110581156=  ERR_CODE INTEGER,'
      '110581157=  ERR_MSG VARCHAR(1024))'
      '110581158=AS'
      
        '110581159=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110581160=BEGIN'
      '110581161=  SELECT T.SKLAD'
      '110581162=    FROM SKLAD_TMP T'
      '110581163=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110581164=     AND T.PRICE = :PRICE_'
      '110581165=    INTO :SKLAD_;'
      '110581166='
      '110581167=  IF (SKLAD_ IS NOT NULL) THEN'
      '110581168=    UPDATE SKLAD_TMP T'
      '110581169=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110581170=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110581171=     WHERE T.SKLAD = :SKLAD_;'
      '110581172='
      '110581173=  ELSE'
      
        '110581174=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM, PRICE_CURRENCY, SUMM_CURRENCY)'
      
        '110581175=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_'
      '110581176=        ,:PRICE_CURRENCY_'
      '110581177=        ,:SUMM_CURRENCY_)'
      '110581178=      RETURNING SKLAD'
      '110581179=      INTO :SKLAD_;'
      '110581180=end'
      '110581181=;'
      
        '110581182=UPDATE SYSTEM_SETUP SET S_VALUE = 11058 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '110581183=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110581184=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110590=ALTER PROCEDURE G_UPD_G_PRODUCT('
      '110591=  G_PRODUCT_ INTEGER,'
      '110592=  G_PRODUCT_PAR_ INTEGER,'
      '110593=  ARTICUL_ VARCHAR(30),'
      '110594=  NOMENCLATUR_NUM_ VARCHAR(30),'
      '110595=  BARCODE_ VARCHAR(30),'
      '110596=  NAME_ VARCHAR(500),'
      '110597=  G_UNIT_ INTEGER,'
      '110598=  PRICE_ NUMERIC(15,2),'
      '110599=  VOLUME_PRICE_ NUMERIC(15,2),'
      '1105910=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1105911=  MF_COUNTRY_ TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1105912=  NOTE_ TYPE OF COLUMN G_PRODUCT.NOTE,'
      '1105913=  CROSSCODE_ TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '1105914=  IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_KIT,'
      '1105915=  IS_CATEGORY_ INTEGER,'
      '1105916=  MIN_AMOUNT_ TYPE OF COLUMN G_PRODUCT.MIN_AMOUNT,'
      '1105917=  PLACE_ TYPE OF COLUMN G_PRODUCT.PLACE,'
      '1105918=  SALES_COMM_ TYPE OF COLUMN G_PRODUCT.SALES_COMM)'
      '1105919=RETURNS ('
      '1105920=  ERR_CODE INTEGER,'
      '1105921=  ERR_MSG VARCHAR(1024))'
      '1105922=AS'
      
        '1105923=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'G_UPD_G_PRODUCT' +
        #39';'
      '1105924=DECLARE VARIABLE N_CURR_ INTEGER;'
      '1105925=DECLARE VARIABLE N INTEGER;'
      '1105926=DECLARE VARIABLE CNT_ INTEGER;'
      
        '1105927=DECLARE VARIABLE G_PRODUCT_SOSTAV_AMOUNT_ TYPE OF COLUMN' +
        ' LT_SKLAD_PRODUCT.AMOUNT;'
      '1105928=begin'
      
        '1105929=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053 +
        #1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1105930=    SELECT COUNT(*)'
      '1105931=      FROM G_PRODUCT G'
      '1105932=     WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_))'
      '1105933=       AND TRIM(G.ARTICUL) <> '#39#39
      '1105934=       AND TRIM(:ARTICUL_) <> '#39#39
      '1105935=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '1105936=      INTO :CNT_;'
      '1105937='
      '1105938=    IF (CNT_ > 0) THEN BEGIN'
      '1105939=      ERR_CODE = -20500;'
      
        '1105940=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||ARTICUL_||'#39' '#1091#1078#1077' '#1077 +
        #1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '1105941=      EXIT;'
      '1105942=    END'
      '1105943='
      '1105944=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '1105945=    SELECT COUNT(*)'
      '1105946=      FROM G_PRODUCT G'
      
        '1105947=     WHERE UPPER(G.NOMENCLATUR_NUM) = UPPER(TRIM(:NOMENC' +
        'LATUR_NUM_))'
      '1105948=       AND TRIM(G.NOMENCLATUR_NUM) <> '#39#39
      '1105949=       AND TRIM(:NOMENCLATUR_NUM_) <> '#39#39
      '1105950=       AND G.G_PRODUCT <> :G_PRODUCT_'
      '1105951=    INTO :CNT_;'
      '1105952=    IF (CNT_ > 0) THEN BEGIN'
      '1105953=      ERR_CODE = -20500;'
      
        '1105954=      ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084#1077#1088#1086#1084' '#39'||NOMENCLATU' +
        'R_NUM_||'#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '1105955=      EXIT;'
      '1105956=    END'
      '1105957='
      '1105958=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052
      '1105959=    if (CHAR_LENGTH(TRIM(:BARCODE_)) > 0) then begin'
      '1105960=        SELECT COUNT(*)'
      '1105961=          FROM G_PRODUCT G'
      '1105962=         WHERE UPPER(G.BARCODE) = UPPER(TRIM(:BARCODE_))'
      '1105963=           AND TRIM(G.BARCODE) <> '#39#39
      '1105964=           AND TRIM(:BARCODE_) <> '#39#39
      '1105965=           AND G.G_PRODUCT <> :G_PRODUCT_'
      '1105966=          INTO :CNT_;'
      '1105967='
      '1105968=        IF (CNT_ = 0) then'
      '1105969=          SELECT COUNT(*)'
      '1105970=            FROM G_PRODUCT G, LT_BARCODE L'
      '1105971=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '1105972=             AND L.BARCODE = TRIM(:BARCODE_)'
      '1105973=             AND TRIM(L.BARCODE) <> '#39#39
      '1105974=            INTO :CNT_;'
      '1105975='
      '1105976=        IF (CNT_ > 0) THEN BEGIN'
      '1105977=          ERR_CODE = -20500;'
      
        '1105978=          ERR_MSG  = '#39#1058#1086#1074#1072#1088' '#1089#1086' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' '#39'||:BARCODE_||' +
        #39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39';'
      '1105979=          EXIT;'
      '1105980=        END'
      '1105981=    END'
      '1105982='
      '1105983=    update G_PRODUCT'
      '1105984=    set G_PRODUCT_PAR = :G_PRODUCT_PAR_,'
      '1105985=        ARTICUL = :ARTICUL_,'
      '1105986=        NOMENCLATUR_NUM = :NOMENCLATUR_NUM_,'
      '1105987=        BARCODE = :BARCODE_,'
      '1105988=        NAME = :NAME_,'
      '1105989=        G_UNIT = :G_UNIT_,'
      '1105990=        PRICE = :PRICE_,'
      '1105991=        VOLUME_PRICE = :VOLUME_PRICE_,'
      '1105992=        PACK_AMOUNT  = :PACK_AMOUNT_,'
      '1105993=        MF_COUNTRY   = :MF_COUNTRY_,'
      '1105994=        NOTE         = :NOTE_,'
      '1105995=        CROSSCODE    = :CROSSCODE_,'
      '1105996=        IS_KIT       = :IS_KIT_,'
      '1105997=        MIN_AMOUNT   = :MIN_AMOUNT_,'
      '1105998=        PLACE        = :PLACE_,'
      '1105999=        SALES_COMM   = :SALES_COMM_'
      '11059100=    where (G_PRODUCT = :G_PRODUCT_);'
      '11059101='
      '11059102=    if (IS_CATEGORY_ = 0) then BEGIN'
      
        '11059103=        DELETE FROM LT_BARCODE WHERE G_PRODUCT = :G_PRO' +
        'DUCT_;'
      '11059104='
      '11059105=        INSERT INTO LT_BARCODE'
      
        '11059106=        SELECT LT_BARCODE, :G_PRODUCT_, BARCODE FROM LT' +
        '_BARCODE_TMP;'
      '11059107='
      '11059108=        --'#1054#1041#1053#1054#1042#1051#1071#1070' '#1060#1054#1058#1054#1043#1056#1040#1060#1048#1048' '#1058#1054#1042#1040#1056#1040
      '11059109=        INSERT INTO G_PRODUCT_IMAGE'
      
        '11059110=        SELECT * FROM G_PRODUCT_IMAGE_TMP T WHERE NOT E' +
        'XISTS (SELECT 1 FROM G_PRODUCT_IMAGE WHERE G_PRODUCT_IMAGE = T.G' +
        '_PRODUCT_IMAGE);'
      '11059111='
      
        '11059112=        DELETE FROM G_PRODUCT_IMAGE I WHERE NOT EXISTS ' +
        '(SELECT 1 FROM G_PRODUCT_IMAGE_TMP WHERE G_PRODUCT_IMAGE = I.G_P' +
        'RODUCT_IMAGE)'
      '11059113=          AND I.G_PRODUCT = :G_PRODUCT_;'
      '11059114='
      '11059115=        -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1057#1058#1040#1042' '#1058#1054#1042#1040#1056#1040' '#1048' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054
      '11059116=        IF (IS_KIT_ > 0) THEN BEGIN'
      '11059117=            INSERT INTO G_PRODUCT_KIT'
      
        '11059118=            SELECT G_PRODUCT_KIT, :G_PRODUCT_, G_PRODUC' +
        'T_ITEM, AMOUNT, PRICE, PRICE1, PRICE2, PRICE3 from G_PRODUCT_KIT' +
        '_TMP T'
      
        '11059119=            WHERE NOT EXISTS (SELECT 1 FROM G_PRODUCT_K' +
        'IT'
      
        '11059120=                               WHERE G_PRODUCT_ITEM = T' +
        '.G_PRODUCT_ITEM'
      
        '11059121=                                 AND G_PRODUCT = T.g_pr' +
        'oduct);'
      '11059122='
      
        '11059123=            DELETE FROM G_PRODUCT_KIT I WHERE NOT EXIST' +
        'S (SELECT 1 FROM G_PRODUCT_KIT_TMP WHERE G_PRODUCT_ITEM = I.G_PR' +
        'ODUCT_ITEM)'
      '11059124=              AND I.G_PRODUCT = :G_PRODUCT_;'
      '11059125='
      '11059126=            UPDATE G_PRODUCT_KIT G'
      
        '11059127=               SET G.AMOUNT = (SELECT AMOUNT FROM G_PRO' +
        'DUCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM),'
      
        '11059128=                   G.PRICE  = (SELECT PRICE FROM G_PROD' +
        'UCT_KIT_TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM)'
      
        '11059129=             WHERE EXISTS (SELECT 1 FROM G_PRODUCT_KIT_' +
        'TMP WHERE G_PRODUCT_ITEM = G.G_PRODUCT_ITEM AND (AMOUNT <> G.AMO' +
        'UNT or PRICE <> G.PRICE))'
      '11059130=               AND G.G_PRODUCT = :G_PRODUCT_;'
      '11059131='
      
        '11059132=            -- '#1086#1073#1085#1086#1074#1083#1103#1102' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086#1083#1100#1082#1086' '#1077#1089#1083#1080' '#1101#1090#1086' '#1089#1086#1089#1090 +
        #1072#1074#1085#1086#1081' '#1090#1086#1074#1072#1088
      '11059133=            if (is_kit_ = 1) then begin'
      '11059134=                SELECT MIN(L.AMOUNT)'
      '11059135=                  FROM G_PRODUCT_KIT K,'
      '11059136=                       LT_SKLAD_PRODUCT L'
      '11059137=                 WHERE K.g_product = :G_PRODUCT_'
      '11059138=                   AND K.G_PRODUCT_ITEM = L.G_PRODUCT'
      
        '11059139=                   AND L.G_TOCHKA = (SELECT ID FROM CUR' +
        '_PARAMS WHERE CUR_PARAMS = 2)'
      '11059140=                 GROUP BY K.G_PRODUCT'
      '11059141=                  INTO :G_PRODUCT_SOSTAV_AMOUNT_;'
      '11059142='
      '11059143=                UPDATE LT_SKLAD_PRODUCT L'
      
        '11059144=                   SET L.AMOUNT = :G_PRODUCT_SOSTAV_AMO' +
        'UNT_'
      '11059145=                 WHERE L.G_PRODUCT = :G_PRODUCT_;'
      '11059146=            end'
      '11059147=        END'
      '11059148=    END'
      '11059149=end'
      '11059150=;'
      
        '11059151=UPDATE SYSTEM_SETUP SET S_VALUE = 11059 WHERE SYSTEM_SE' +
        'TUP = 3;'
      
        '11059152=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, RD' +
        'B$DESCRIPTION=NULL;'
      '11059153=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
