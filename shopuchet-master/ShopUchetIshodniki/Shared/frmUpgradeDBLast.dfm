        #1087#1086' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080': '#39'||I.DOVERENNOST,'
      '110682079=         '#39#1057#1087#1086#1089#1086#1073' '#1086#1090#1087#1088#1072#1074#1083#1077#1085#1080#1103': '#39'||I.SPOSOB_OTPRAVKI,'
      
        '110682080=         '#39#1058#1086#1074#1072#1088#1085#1086'-'#1090#1088#1072#1085#1089#1087#1086#1088#1090#1085#1072#1103' '#1085#1072#1082#1083#1072#1076#1085#1072#1103': '#39'||I.NAKLADN' +
        'AYA,'
      
