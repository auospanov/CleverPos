        '(POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '11042699='
      '11042700=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '11042701=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
