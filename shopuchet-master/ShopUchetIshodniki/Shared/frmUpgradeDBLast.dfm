        '11043306=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11043307=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11043308=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11043309=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11043310=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11043311=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11043312=BEGIN'
      '11043313='
      
        '11043314=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11043315=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11043316='
      '11043317=  SELECT S.S_VALUE'
      '11043318=    FROM SYSTEM_SETUP S'
      '11043319=   WHERE S.SYSTEM_SETUP = 1'
      '11043320=    INTO :FORMULA_;'
      '11043321='
      '11043322=  FOR SELECT GP.PATH,'
      '11043323=             GP.G_PRODUCT'
      '11043324=        FROM P_REP_TREE GP'
      '11043325=       WHERE EXISTS (SELECT 1'
      '11043326=                       FROM G_PRODUCT'
      '11043327=                      WHERE IS_CATEGORY = 0'
      
        '11043328=                        AND G_PRODUCT_PAR = GP.G_PRODUC' +
        'T'
      '11043329=                    )'
      
        '11043330=         AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||GP.G_PROD' +
        'UCT||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11043331=              OR'
      '11043332=              (:G_CATEGORY_ is NULL)'
      '11043333=             )'
      '11043334=       ORDER BY 1, 2'
      '11043335=       INTO :PATH_NAME_,'
      '11043336=            :G_PRODUCT_'
      '11043337=  DO BEGIN'
      
        '11043338=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057 +
        ' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054
      
        '11043339=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068 +
        ' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '11043340=      SELECT COUNT(G.G_PRODUCT)'
      
        '11043341=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL' +
        '.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11043342=                                          WHERE :G_TOCH' +
        'KA_ARR_ CONTAINING '#39#39'-'#39#39'||LL.G_TOCHKA||'#39#39'-'#39#39' GROUP BY LL.G_PRODU' +
        'CT) L ON G.G_PRODUCT = L.G_PRODUCT'
      '11043343=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11043344=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11043345=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (CO' +
        'ALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11043346=              OR'
      
        '11043347=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_' +
        ', 0) = 1)'
      '11043348=              or'
      
        '11043349=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_' +
        ', 0) = 1))'
      '11043350=             )'
      '11043351=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11043352=         AND ((EXISTS (SELECT 1'
      '11043353=                       FROM SKLAD S'
      '11043354=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '11043355=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '11043356=                        AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11043357=              OR'
      '11043358=              COALESCE(:G_CLIENT_, 0) = 0)'
      '11043359=        INTO :CNT_;'
      '11043360='
      '11043361=      IF (CNT_ > 0) THEN BEGIN'
      
        '11043362=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE' +
        '_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '11043363=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), ' +
        ':PATH_NAME_, 1);'
      '11043364='
      
        '11043365=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE,'
      '11043366=                                              ARTICUL,'
      '11043367=                                              BARCODE,'
      
        '11043368=                                              NOMENCLAT' +
        'UR_NUM,'
      '11043369=                                              NAME,'
      
        '11043370=                                              UNIT_NAME' +
        ','
      '11043371=                                              PRICE,'
      
        '11043372=                                              VOLUME_PR' +
        'ICE,'
      
        '11043373=                                              SKIDKA_PR' +
        'ICE,'
      '11043374=                                              AMOUNT,'
      
        '11043375=                                              AMOUNT_RE' +
        'SERVE,'
      '11043376=                                              SUMM,'
      
        '11043377=                                              PRICE_SEL' +
        'F,'
      '11043378=                                              SORT_COL,'
      
        '11043379=                                              IS_CATEGO' +
        'RY,'
      '11043380=                                              NOTE,'
      
        '11043381=                                              CROSSCODE' +
        ')'
      '11043382=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1),'
      '11043383=                 G.ARTICUL,'
      '11043384=                 G.BARCODE,'
      '11043385=                 G.NOMENCLATUR_NUM,'
      '11043386=                 G.NAME,'
      '11043387=                 U.SHORT_NAME,'
      '11043388=                 G.PRICE,'
      '11043389=                 G.VOLUME_PRICE,'
      '11043390=                 G.PRICE - GD.SKIDKA_SUM,'
      '11043391=                 COALESCE(S.AMOUNT, 0),'
      '11043392=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      '11043393=                 COALESCE(S.AMOUNT, 0) * G.PRICE,'
      '11043394=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '11043395=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1053 +
        #1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '11043396=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 '#1047 +
        #1040#1050#1059#1055#1054#1050
      '11043397=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '11043398=                  DECODE(:FORMULA_,'
      '11043399=                         0,'
      
        '11043400=                         (SELECT ROUND(SUM(T.AMOUNT * T' +
        '.PRICE)/SUM(T.AMOUNT), 2)'
      
        '11043401=                            FROM (SELECT S.AMOUNT, S.PR' +
        'ICE'
      
        '11043402=                                    FROM SKLAD_PARENT S' +
        'P,'
      '11043403=                                         SKLAD S'
      
        '11043404=                                   WHERE :G_TOCHKA_ARR_' +
        ' CONTAINING '#39#39'-'#39#39'||SP.G_TOCHKA||'#39#39'-'#39#39
      
        '11043405=                                     AND SP.DATE_RECEIP' +
        'T <= CURRENT_DATE'
      
        '11043406=                                     AND SP.SKLAD = S.S' +
        'KLAD_PARENT'
      
        '11043407=                                     AND S.G_PRODUCT = ' +
        'G.G_PRODUCT'
      
        '11043408=                                     AND SP.IS_VOZVRAT ' +
        'IN (0, 3, 4)'
      
        '11043409=                                    ORDER BY S.DATE_REC' +
        'EIPT DESC ROWS 1 TO 5) T),'
      '11043410=                         1,'
      '11043411=                         (SELECT S.PRICE'
      '11043412=                            FROM SKLAD S'
      
        '11043413=                           WHERE S.SKLAD = (SELECT MAX(' +
        'SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058#1054 +
        ' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST ' +
        '= 1'
      
        '11043414=                                              FROM SKLA' +
        'D SS'
      
        '11043415=                                             WHERE :G_T' +
        'OCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SS.G_TOCHKA||'#39#39'-'#39#39
      
        '11043416=                                               AND SS.G' +
        '_PRODUCT = G.G_PRODUCT'
      
        '11043417=                                               AND SS.I' +
        'S_LAST = 1)'
      '11043418=                         ))), 0) spr,'
      
        '11043419=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, 1' +
        ', G.NAME),'
      '11043420=                 0'
      '11043421=                 ,G.NOTE'
      
        '11043422=                 ,REPLACE(G.CROSSCODE, '#39#39'~'#39#39', '#39#39','#39#39') CR' +
        'OSSCODE'
      
        '11043423=            FROM G_PRODUCT G LEFT OUTER JOIN G_DISCOUNT' +
        ' GD ON G.G_PRODUCT = GD.G_PRODUCT'
      
        '11043424=                             LEFT OUTER JOIN G_UNIT U O' +
        'N G.G_UNIT = U.G_UNIT'
      
        '11043425=                             LEFT OUTER JOIN (SELECT SU' +
        'M(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.G' +
        '_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11043426=                                              WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||LL.G_TOCHKA||'#39#39'-'#39#39' GROUP BY LL.G_P' +
        'RODUCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '11043427=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11043428=             AND G.IS_CATEGORY = 0'
      '11043429=             AND G.is_active = 1'
      '11043430=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11043431=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND' +
        ' (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11043432=                  OR'
      
        '11043433=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE_' +
        'NOL_, 0) = 1)'
      '11043434=                  or'
      
        '11043435=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE_' +
        'FEW_, 0) = 1))'
      '11043436=                 )'
      '11043437=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11043438=             AND ((EXISTS (SELECT 1'
      '11043439=                           FROM SKLAD S'
      '11043440=                          WHERE S.G_CLIENT = :G_CLIENT_'
      
        '11043441=                            AND S.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11043442=                            AND :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11043443=                  OR'
      '11043444=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '11043445=           ORDER BY 14;'
      '11043446=      END'
      '11043447=  END'
      '11043448='
      
        '11043449=  PERIOD_ = '#39#39#1053#1072' '#1076#1072#1090#1091' '#39#39'||lpad(EXTRACT(DAY FROM CURRENT' +
        '_DATE), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE),' +
        ' 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '11043450='
      
        '11043451=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CRO' +
        'SSCODE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKIDKA_PRICE' +
        ', AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE_SELF, I' +
        'S_CATEGORY,'
      '11043452=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '11043453=      FROM P_REP_PRICE_LIST_TABLE'
      
        '11043454=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_N' +
        'UM, CROSSCODE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLUME_PRICE, ' +
        ':SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE_SELF, :SU' +
        'MM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '11043455=  DO BEGIN'
      '11043456=    I = I + 1;'
      '11043457=    SUSPEND;'
      '11043458=  END'
      '11043459='
      '11043460=     /*'
      '11043461=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '11043462='
      '11043463=     SELECT :I,'
      
        '11043464=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044#1059 +
        ' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '11043465=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '11043466=             U.SHORT_NAME UNIT_NAME,'
      '11043467=             SS.PRICE,'
      '11043468=             SS.VOLUME_PRICE,'
      '11043469=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '11043470=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(S' +
        '.AMOUNT, 0)),'
      '11043471=             SS.IS_CATEGORY'
      '11043472=        FROM (WITH RECURSIVE TREE'
      '11043473=              AS (SELECT T.G_PRODUCT,'
      '11043474=                       T.NAME AS ARTICUL,'
      '11043475=                       CAST(NULL AS VARCHAR(500)) NAME,'
      
        '11043476=                       CAST(NULL AS NUMERIC(15,2)) PRIC' +
        'E,'
      
        '11043477=                       CAST(NULL AS NUMERIC(15,2)) VOLU' +
        'ME_PRICE,'
      '11043478=                       T.IS_CATEGORY,'
      '11043479=                       NULL G_UNIT'
      '11043480=                  FROM G_PRODUCT T'
      '11043481=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '11043482=                   AND :G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||T' +
        '.G_PRODUCT||'#39#39'~'#39#39
      '11043483=                UNION ALL'
      '11043484=                SELECT T.G_PRODUCT,'
      '11043485=                       DECODE(T. T.ARTICUL,'
      '11043486=                       T.NAME,'
      '11043487=                       T.PRICE,'
      '11043488=                       T.VOLUME_PRICE,'
      '11043489=                       T.IS_CATEGORY,'
      '11043490=                       T.G_UNIT'
      
        '11043491=                  FROM G_PRODUCT T INNER JOIN TREE PRIO' +
        'R ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '11043492=                 WHERE T.IS_ACTIVE = 1'
      '11043493=                )'
      '11043494=             SELECT * FROM TREE) SS'
      
        '11043495=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.G' +
        '_PRODUCT = S.G_PRODUCT'
      
        '11043496=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U.' +
        'G_UNIT'
      
        '11043497=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PROD' +
        'UCT = GD.G_PRODUCT'
      '11043498=    INTO :ROW_NUM,'
      '11043499=        :ARTICUL,'
      '11043500=        :NAME,'
      '11043501=        :UNIT_NAME,'
      '11043502=        :PRICE,'
      '11043503=        :VOLUME_PRICE,'
      '11043504=        :SKIDKA_PRICE,'
      '11043505=        :AMOUNT,'
      '11043506=        :IS_CATEGORY'
      '11043507=    DO BEGIN'
      '11043508=      I = I + 1;'
      '11043509=      SUSPEND;'
      '11043510=    END  */'
      '11043511=WHEN ANY DO BEGIN'
      '11043512=    Err_code = -20500;'
      
        '11043513=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11043514=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11043515=  END'
      '11043516=end'
      '11043517='#39';'
      '11043518='
      '11043519=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT('
      '11043520=  DATE_BEGIN_ DATE,'
      '11043521=  DATE_END_ DATE,'
      '11043522=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11043523=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYME' +
        'NT_TYPE,'
      '11043524=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '11043525=RETURNS ('
      '11043526=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11043527=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '11043528=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUMM' +
        ','
      '11043529=  SUMM_COST_ALL_STR VARCHAR(50),'
      '11043530=  SUMM_ALL_ NUMERIC(15,2),'
      '11043531=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '11043532=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '11043533=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '11043534=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '11043535=  PROFIT_ALL_ NUMERIC(15,2),'
      '11043536=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '11043537=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'P_REP_PROFIT_TABLE,'
      '11043538=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '11043539=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '11043540=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '11043541=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '11043542=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT_' +
        'NAME,'
      
        '11043543=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PA' +
        'YMENT_TYPE,'
      
        '11043544=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYMEN' +
        'T_NAME,'
      
        '11043545=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANIE' +
        ','
      
        '11043546=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUCT' +
        ','
      
        '11043547=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRO' +
        'DUCT_PAR,'
      
        '11043548=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_NA' +
        'ME,'
      '11043549=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '11043550=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11043551=  AMOUNT NUMERIC(15,2),'
      '11043552=  PRICE NUMERIC(15,2),'
      '11043553=  SUMM NUMERIC(15,2),'
      '11043554=  DISCOUNT_PERC NUMERIC(15,2),'
      '11043555=  DISCOUNT_SUMM NUMERIC(15,2),'
      '11043556=  NDS NUMERIC(15,2),'
      '11043557=  NDS_SUMM NUMERIC(15,2),'
      '11043558=  PRICE_SELF NUMERIC(15,2),'
      '11043559=  SUM_SELF NUMERIC(15,2),'
      '11043560=  PROFIT NUMERIC(15,2),'
      '11043561=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '11043562=  ERR_CODE INTEGER,'
      '11043563=  ERR_MSG VARCHAR(1024))'
      '11043564=AS'
      
        '11043580=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT'#39 +
        #39';'
      '11043581=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11043582=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '11043583=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '11043584=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '11043585=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '11043586=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '11043587=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '11043588=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '11043589=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '11043590=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '11043591=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '11043592=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '11043593=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      '11043594=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11043595=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_T' +
        'OCHKA;'
      
        '11043596=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DAT' +
        'E;'
      
        '11043597=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_C' +
        'LIENT;'
      
        '11043598=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLIE' +
        'NT.NAME;'
      
        '11043599=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZAK' +
        'AZ.G_PAYMENT_TYPE;'
      
        '11043600=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.NAME;'
      
        '11043601=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OS' +
        'NOVANIE;'
      
        '11043602=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      
        '11043603=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT_PAR;'
      
        '11043604=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11043605=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11043606=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.PRICE;'
      
        '11043607=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '11043608=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_PERC;'
      
        '11043609=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM;'
      
        '11043610=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS;'
      
        '11043611=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.NDS_SUMM;'
      
        '11043612=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.P' +
        'RICE;'
      
        '11043613=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '11043614=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '11043615=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACTI' +
        'ON_DATE;'
      
        '11043616=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_R' +
        'ASHOD.NAME;'
      '11043617=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '11043618=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.D' +
        'ATE_RECEIPT;'
      
        '11043619=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '11043620=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      '11043621=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '11043622=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '11043623=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '11043624=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      '11043625=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0;'
      '11043626=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;'
      '11043627=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '11043628=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUMM' +
        ';'
      '11043629=BEGIN'
      
        '11043630=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TAB' +
        'LE = P_REP_PROFIT_TABLE;'
      '11043631=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11043632='
      '11043633=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '11043634=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '11043635=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '11043636='
      '11043637=  FOR SELECT GP.PATH,'
      '11043638=             GP.G_PRODUCT'
      '11043639=       FROM P_REP_TREE GP'
      '11043640=      WHERE EXISTS (SELECT 1'
      
        '11043641=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G' +
        '_PRODUCT G'
      
        '11043642=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39 +
        '-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11043643=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11043644=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11043645=                       AND G.G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '11043646=                       AND Z.IS_SPISANIE = 0'
      '11043647=                       AND Z.is_reserve = 0'
      '11043648=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11043649=                       AND Z.Z_DATE BETWEEN :DATE_BEGIN' +
        '_ AND :DATE_END_'
      
        '11043650=                       AND COALESCE(Z.G_CLIENT, 0) = CO' +
        'ALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))'
      
        '11043651=                       AND COALESCE(Z.G_PAYMENT_TYPE, 0' +
        ') = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11043652=                       )'
      '11043653=      ORDER BY 1, 2'
      '11043654=  INTO :RECCAT_NAME_,'
      '11043655=       :RECCAT_PRODUCT_'
      '11043656=  DO BEGIN'
      '11043658=    insert into p_rep_profit_table'
      '11043659=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11043660=    values'
      
        '11043661=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME_' +
        ', 1);'
      '11043662='
      '11043663=    FOR SELECT Z.ZAKAZ,'
      '11043664=               Z.G_TOCHKA,'
      '11043665=               Z.Z_DATE,'
      '11043666=               Z.G_CLIENT,'
      '11043667=               C.NAME CLIENT_NAME,'
      '11043668=               Z.G_PAYMENT_TYPE,'
      '11043669=               P.NAME PAYMENT_NAME,'
      '11043670=               Z.OSNOVANIE,'
      '11043671=               G.G_PRODUCT,'
      '11043672=               G.G_PRODUCT_PAR,'
      '11043673=               G.NAME TOVAR_NAME,'
      '11043674=               ZD.AMOUNT,'
      '11043675=               ZD.PRICE,'
      '11043676=               ZD.SUMM,'
      '11043677=               ZD.DISCOUNT_PERC,'
      '11043678=               ZD.DISCOUNT_SUMM,'
      '11043679=               ZD.NDS,'
      '11043680=               ZD.NDS_SUMM,'
      '11043681=               COALESCE(ZD.COST_PRICE, 0)'
      
        '11043682=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z.' +
        'G_CLIENT = C.G_CLIENT,'
      '11043683=               ZAKAZ_DETAILS ZD,'
      '11043684=               G_PRODUCT G,'
      '11043685=               G_PAYMENT_TYPE P'
      
        '11043686=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOC' +
        'HKA||'#39#39'-'#39#39
      '11043687=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '11043688=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11043689=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11043690=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_'
      '11043691=           AND Z.IS_SPISANIE = 0'
      '11043692=           AND Z.IS_RESERVE = 0'
      
        '11043694=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11043695=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CL' +
        'IENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067 +
        #1052
      
        '11043696=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE' +
        '(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11043697=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ZD' +
        '.ZAKAZ_DETAILS, G.NAME'
      '11043698=    INTO :REC_ZAKAZ_,'
      '11043699=        :REC_G_TOCHKA_,'
      '11043700=        :REC_Z_DATE_,'
      '11043701=        :REC_G_CLIENT_,'
      '11043702=        :REC_CLIENT_NAME_,'
      '11043703=        :REC_G_PAYMENT_TYPE_,'
      '11043704=        :REC_PAYMENT_NAME_,'
      '11043705=        :REC_OSNOVANIE_,'
      '11043706=        :REC_G_PRODUCT_,'
      '11043707=        :REC_G_PRODUCT_PAR_,'
      '11043708=        :REC_TOVAR_NAME_,'
      '11043709=        :REC_AMOUNT_,'
      '11043710=        :REC_PRICE_,'
      '11043711=        :REC_SUMM_,'
      '11043712=        :REC_DISCOUNT_PERC_,'
      '11043713=        :REC_DISCOUNT_SUMM_,'
      '11043714=        :REC_NDS_,'
      '11043715=        :REC_NDS_SUMM_,'
      '11043716=        :REC_PRICE_SELF_'
      '11043717=    DO BEGIN'
      '11043718=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '11043719=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_SU' +
        'M_COST_;'
      '11043720='
      '11043721=      insert into p_rep_profit_table'
      
        '11043722=        (p_rep_profit_table, zakaz, g_tochka, z_date, g' +
        '_client, client_name, g_payment_type, payment_name,'
      
        '11043723=         osnovanie, g_product, g_product_par, tovar_nam' +
        'e, amount, price, summ, discount_perc, discount_summ,'
      
        '11043724=         nds, nds_summ, price_self, sum_self, profit, i' +
        's_head)'
      '11043725=      values'
      '11043726=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '11043727=        :REC_ZAKAZ_,'
      '11043728=        :REC_g_tochka_,'
      
        '11043729=        :REC_z_date_, :REC_g_client_, :REC_client_name_' +
        ', :REC_g_payment_type_, :REC_payment_name_,'
      '11043730=         :REC_osnovanie_,'
      '11043731=         :REC_g_product_,'
      '11043732=         :REC_g_product_par_,'
      '11043733=         :REC_tovar_name_,'
      '11043734=         :REC_amount_,'
      '11043735=         :REC_price_,'
      '11043736=         :REC_summ_,'
      '11043737=         :REC_discount_perc_,'
      '11043738=         :REC_discount_summ_,'
      
        '11043739=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, :' +
        'REC_SUM_COST_, :REC_profit_, 0);'
      '11043740='
      '11043741=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '11043742=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '11043743=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '11043744=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '11043745=    END'
      '11043746='
      '11043748=    insert into p_rep_profit_table'
      
        '11043749=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11043750=    values'
      
        '11043751=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '11043752='
      '11043753=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '11043754=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '11043755=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '11043756=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11043757='
      '11043758=    SUM_ZAKAZ_ = 0;'
      '11043759=    SUM_COST_  = 0;'
      '11043760=    NDS_SUMM_  = 0;'
      '11043761=    PROFIT_    = 0;'
      '11043762=  END'
      '11043763='
      
        '11043765=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_ ' +
        '+ PROFIT_ALL_) > 0) then'
      '11043766=      insert into p_rep_profit_table'
      
        '11043767=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11043768=      values'
      
        '11043769=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '11043770='
      '11043774=  SELECT COUNT(*)'
      
        '11043775=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11043776=          UNION ALL'
      
        '11043777=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11043778=         G_PRIHOD_RASHOD G'
      
        '11043779=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11043780=    AND K.ACTION = 1'
      
        '11043781=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11043782=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11043783=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '11043784=  INTO :CNT_;'
      '11043785='
      '11043786=  IF (CNT_ > 0) THEN BEGIN'
      '11043787=    SUM_COST_  = 0;'
      '11043788=    PROFIT_    = 0;'
      '11043789='
      '11043791=    INSERT INTO P_REP_PROFIT_TABLE'
      '11043792=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11043793=    VALUES'
      
        '11043794=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11043795='
      '11043796=    FOR SELECT K.ACTION_DATE,'
      '11043797=               K.SUMM,'
      '11043798=               G.NAME'
      
        '11043799=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      
        '11043800=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39
      '11043801=              UNION ALL'
      
        '11043802=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, S' +
        'UMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa_bezn' +
        'al'
      
        '11043803=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39') k,'
      '11043804=              G_PRIHOD_RASHOD G'
      '11043805=        WHERE K.ACTION = 1'
      
        '11043806=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11043807=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11043808=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '11043809=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11043810=    INTO :ACTION_DATE_,'
      '11043811=         :SUMM_,'
      '11043812=         :ACTION_NAME_'
      '11043813=    DO BEGIN'
      '11043814=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11043815=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11043816=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11043817=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11043818=        VALUES'
      
        '11043819=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, 0,'
      
        '11043820=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALESC' +
        'E(:SUMM_, 0), 0);'
      '11043821='
      '11043822=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '11043823=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '11043824=    END'
      '11043825='
      '11043826=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11043827=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11043829=    insert into p_rep_profit_table'
      
        '11043830=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11043831=    values'
      
        '11043832=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11043833=  END'
      '11043841=  SELECT COUNT(*)'
      
        '11043842=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11043843=          UNION ALL'
      
        '11043844=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11043845=         G_PRIHOD_RASHOD G'
      
        '11043846=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11043847=    AND K.ACTION = 0'
      
        '11043848=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11043849=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11043850=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '11043851=  INTO :CNT_;'
      '11043852='
      '11043853=  IF (CNT_ > 0) THEN BEGIN'
      '11043854=    PRIHOD_ALL_  = 0;'
      '11043855=    PRIHOD_ALL_NAL_  = 0;'
      '11043856=    PRIHOD_ALL_BEZNAL_  = 0;'
      '11043857=    PROFIT_     = 0;'
      '11043858='
      '11043860=    INSERT INTO P_REP_PROFIT_TABLE'
      '11043861=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11043862=    VALUES'
      
        '11043863=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11043864='
      '11043865=    FOR SELECT K.ACTION_DATE,'
      '11043866=               K.NAL,'
      '11043867=               K.BEZNAL,'
      '11043868=               G.NAME'
      
        '11043869=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 B' +
        'EZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11043870=               UNION ALL'
      
        '11043871=               SELECT kassa_BEZNAL KASSA, ACTION_DATE, ' +
        '0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa' +
        '_beznal) K,'
      '11043872=              G_PRIHOD_RASHOD G'
      
        '11043873=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCH' +
        'KA||'#39#39'-'#39#39
      '11043874=          AND K.ACTION = 0'
      
        '11043875=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11043876=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11043877=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)'
      '11043878=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11043879=    INTO :ACTION_DATE_,'
      '11043880=         :SUMM_NAL_,'
      '11043881=         :SUMM_BEZNAL_,'
      '11043882=         :ACTION_NAME_'
      '11043883=    DO BEGIN'
      '11043884=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11043885=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11043886=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11043887=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11043888=        VALUES'
      
        '11043889=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '11043890=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_' +
        ', 0);'
      '11043891='
      '11043892=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '11043893=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_' +
        'BEZNAL_;'
      
        '11043894=        PRIHOD_ALL_ = PRIHOD_ALL_ + PRIHOD_ALL_NAL_ + P' +
        'RIHOD_ALL_BEZNAL_;'
      
        '11043895=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      '11043896=    END'
      '11043897='
      '11043898=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '11043899=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11043901=    insert into p_rep_profit_table'
      
        '11043902=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11043903=    values'
      
        '11043904=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '11043905=  END'
      '11043906='
      '11043913=  SELECT COUNT(*)'
      '11043914=    FROM ZAKAZ Z'
      
        '11043915=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11043916=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11043917=     AND Z.IS_SPISANIE = 1'
      
        '11043918=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(Z.G_CLIENT, 0))'
      
        '11043919=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11043920=  INTO :CNT_;'
      '11043921='
      '11043922=  IF (CNT_ > 0) THEN BEGIN'
      '11043923=      SUM_ZAKAZ_ = 0;'
      '11043924=      SUM_COST_  = 0;'
      '11043925=      PROFIT_    = 0;'
      '11043926='
      '11043928=      insert into p_rep_profit_table'
      '11043929=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11043930=      values'
      
        '11043931=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39#39', 1);'
      '11043932='
      '11043933=      FOR SELECT Z.ZAKAZ,'
      '11043934=                 Z.G_TOCHKA,'
      '11043935=                 Z.Z_DATE,'
      '11043936=                 Z.G_CLIENT,'
      '11043937=                 '#39#39#39#39' CLIENT_NAME,'
      '11043938=                 Z.G_PAYMENT_TYPE,'
      '11043939=                 '#39#39#39#39' PAYMENT_NAME,'
      '11043940=                 Z.OSNOVANIE,'
      '11043941=                 G.G_PRODUCT,'
      '11043942=                 G.G_PRODUCT_PAR,'
      '11043943=                 G.NAME TOVAR_NAME,'
      '11043944=                 ZD.AMOUNT,'
      '11043945=                 ZD.PRICE,'
      '11043946=                 ZD.SUMM,'
      '11043947=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '11043948=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '11043949=                 0 NDS, --ZD.NDS,'
      '11043950=                 0 NDS_SUMM'
      '11043951=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT G'
      
        '11043952=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_T' +
        'OCHKA||'#39#39'-'#39#39
      '11043953=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '11043954=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11043955=             AND Z.IS_SPISANIE = 1                    -' +
        '- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '11043956=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11043957=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '11043958=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '11043959=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11043960=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ_' +
        'DETAILS'
      '11043961=      INTO :REC_ZAKAZ_,'
      '11043962=            :REC_G_TOCHKA_,'
      '11043963=            :REC_Z_DATE_,'
      '11043964=            :REC_G_CLIENT_,'
      '11043965=            :REC_CLIENT_NAME_,'
      '11043966=            :REC_G_PAYMENT_TYPE_,'
      '11043967=            :REC_PAYMENT_NAME_,'
      '11043968=            :REC_OSNOVANIE_,'
      '11043969=            :REC_G_PRODUCT_,'
      '11043970=            :REC_G_PRODUCT_PAR_,'
      '11043971=            :REC_TOVAR_NAME_,'
      '11043972=            :REC_AMOUNT_,'
      '11043973=            :REC_PRICE_,'
      '11043974=            :REC_SUMM_,'
      '11043975=            :REC_DISCOUNT_PERC_,'
      '11043976=            :REC_DISCOUNT_SUMM_,'
      '11043977=            :REC_NDS_,'
      '11043978=            :REC_NDS_SUMM_'
      '11043979=      DO BEGIN'
      '11043982=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '11043983=        REC_profit_   = -REC_SUMM_;'
      '11043984='
      '11043985=        insert into p_rep_profit_table'
      
        '11043986=          (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '11043987=           osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '11043988=           nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '11043989=        values'
      
        '11043990=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAKA' +
        'Z_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_na' +
        'me_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '11043991=         :REC_osnovanie_, :REC_g_product_, :REC_g_produ' +
        'ct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_per' +
        'c_, :REC_discount_summ_,'
      
        '11043992=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_S' +
        'UM_COST_, :REC_profit_, 0);'
      '11043993='
      
        '11043994=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST_' +
        ', 0);'
      
        '11043995=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, 0' +
        ');'
      '11043996=      END'
      '11043997='
      '11043999=      insert into p_rep_profit_table'
      
        '110431000=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110431001=      values'
      
        '110431002=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39',' +
        ' 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110431003='
      '110431004=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110431005=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110431006=  END'
      '110431021=  SELECT COUNT(*)'
      '110431022=    FROM SKLAD S'
      
        '110431023=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      
        '110431024=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110431025=     AND S.IS_VOZVRAT IN (1,2)'
      
        '110431026=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.' +
        'G_CLIENT, 0))'
      
        '110431027=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_,' +
        ' COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110431028=  INTO :CNT_;'
      '110431029='
      '110431030=  IF (CNT_ > 0) THEN BEGIN'
      '110431031=    SUM_ZAKAZ_ = 0;'
      '110431032=    PROFIT_    = 0;'
      '110431033=    SUM_COST_  = 0;'
      '110431034='
      '110431036=    insert into p_rep_profit_table'
      '110431037=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110431038=    values'
      
        '110431039=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054 +
        #1042#1040#1056#1040#39#39', 1);'
      '110431040='
      '110431041=    FOR SELECT S.DATE_RECEIPT,'
      '110431042=               S.G_PRODUCT,'
      '110431043=               G.NAME TOVAR_NAME,'
      '110431044=               S.AMOUNT,'
      '110431045=               S.PRICE,'
      '110431046=               S.SUMM,'
      '110431047=               SP.G_TOCHKA'
      '110431048=         FROM SKLAD_PARENT SP,'
      '110431049=              SKLAD S,'
      '110431050=              G_PRODUCT G'
      
        '110431051=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TO' +
        'CHKA||'#39#39'-'#39#39
      
        '110431052=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      '110431053=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '110431054=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALE' +
        'SCE(S.G_CLIENT, 0))'
      
        '110431055=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_' +
        'TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110431056=          AND SP.SKLAD = S.SKLAD_PARENT'
      '110431057=          AND S.G_PRODUCT = G.G_PRODUCT'
      '110431058=        ORDER BY 1'
      '110431059=    INTO :V_DATE_RECEIPT_,'
      '110431060=         :V_G_PRODUCT_,'
      '110431061=         :V_TOVAR_NAME_,'
      '110431062=         :V_AMOUNT_,'
      '110431063=         :V_PRICE_,'
      '110431064=         :V_SUMM_,'
      '110431065=         :REC_G_TOCHKA_'
      '110431066=    DO BEGIN'
      '110431068=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;'
      '110431069='
      '110431070='
      '110431071=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '110431072=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_' +
        'NAME, AMOUNT, PRICE, SUMM,'
      '110431073=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '110431074=         NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT, ' +
        'IS_HEAD)'
      '110431075=      VALUES'
      
        '110431076=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_RE' +
        'CEIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, 0 /*:REC_PRIC' +
        'E_SELF_*/, 0/*:REC_SUM_COST_*/,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045 +
        ' '#1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042 +
        #1045#1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '110431077=         0, 0, 0, 0, :V_PRICE_, :V_SUMM_, :REC_profit_' +
        ', 0);'
      '110431078='
      '110431080=      SUM_COST_ = 0;'
      '110431081=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '110431082=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110431083=    END'
      '110431084='
      '110431085='
      '110431086=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_COST_;'
      '110431087=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '110431088=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110431089='
      '110431090=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110431091=    insert into p_rep_profit_table'
      
        '110431092=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110431093=    values'
      
        '110431094=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :' +
        'SUM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '110431095=  END'
      '110431098='
      '110431230=  SELECT COUNT(*)'
      '110431231=    FROM ZAKAZ S'
      
        '110431232=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||' +
        #39#39'-'#39#39
      '110431233=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110431234=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110431235=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110431236=     AND S.IS_SPISANIE = 2'
      '110431237=  INTO :CNT_;'
      '110431238='
      '110431239=  IF (CNT_ > 0) THEN BEGIN'
      '110431240=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110431241=      insert into p_rep_profit_table'
      '110431242=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110431243=      values'
      
        '110431244=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '110431245='
      '110431246=      SUM_ZAKAZ_ = 0;'
      '110431247=      SUM_COST_  = 0;'
      '110431248=      NDS_SUMM_  = 0;'
      '110431249=      PROFIT_    = 0;'
      '110431250=      FOR SELECT GP.NAME,'
      '110431251=                 GP.G_PRODUCT'
      '110431252=           FROM G_PRODUCT GP'
      '110431253=          WHERE IS_CATEGORY = 1'
      '110431254=            AND EXISTS (SELECT 1'
      
        '110431255=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'ZD, G_PRODUCT G'
      
        '110431256=                         WHERE :G_TOCHKA_ARR_ CONTAINI' +
        'NG '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '110431257=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '110431258=                           AND ZD.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110431259=                           AND G.G_PRODUCT_PAR = GP.G_' +
        'PRODUCT'
      '110431260=                           AND Z.IS_SPISANIE = 2'
      '110431261=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110431262=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110431263=                           AND COALESCE(Z.G_CLIENT, 0)' +
        ' = COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058 +
        ' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110431264=                           AND COALESCE(Z.G_PAYMENT_TY' +
        'PE, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0' +
        '))'
      '110431265=                           )'
      '110431266=          ORDER BY 1'
      '110431267=      INTO :RECCAT_NAME_,'
      '110431268=           :RECCAT_PRODUCT_'
      '110431269=      DO BEGIN'
      '110431270=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110431271=        insert into p_rep_profit_table'
      '110431272=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110431273=        values'
      
        '110431274=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_' +
        'NAME_, 1);'
      '110431275='
      '110431276=        FOR SELECT Z.ZAKAZ,'
      '110431277=                   Z.G_TOCHKA,'
      '110431278=                   Z.Z_DATE,'
      '110431279=                   Z.G_CLIENT,'
      '110431280=                   C.NAME CLIENT_NAME,'
      '110431281=                   Z.G_PAYMENT_TYPE,'
      '110431282=                   P.NAME PAYMENT_NAME,'
      '110431283=                   Z.OSNOVANIE,'
      '110431284=                   G.G_PRODUCT,'
      '110431285=                   G.G_PRODUCT_PAR,'
      '110431286=                   G.NAME TOVAR_NAME,'
      '110431287=                   ZD.AMOUNT,'
      '110431288=                   ZD.PRICE,'
      '110431289=                   ZD.SUMM,'
      '110431290=                   ZD.DISCOUNT_PERC,'
      '110431291=                   ZD.DISCOUNT_SUMM,'
      '110431292=                   ZD.NDS,'
      '110431293=                   ZD.NDS_SUMM,'
      '110431294=                   ZD.COST_PRICE'
      
        '110431295=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ' +
        'ON Z.G_CLIENT = C.G_CLIENT,'
      '110431296=                   ZAKAZ_DETAILS ZD,'
      '110431297=                   G_PRODUCT G,'
      '110431298=                   G_PAYMENT_TYPE P'
      
        '110431299=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.' +
        'G_TOCHKA||'#39#39'-'#39#39
      '110431300=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '110431301=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110431302=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '110431303=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_ ' +
        ' -- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '110431304=               AND Z.IS_SPISANIE = 2                  ' +
        '  -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '110431305=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110431306=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110431307=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(' +
        ':G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' ' +
        #1055#1059#1057#1058#1067#1052
      
        '110431308=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COA' +
        'LESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '110431309=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKA' +
        'Z, ZD.ZAKAZ_DETAILS, G.NAME'
      '110431310=        INTO :REC_ZAKAZ_,'
      '110431311=            :REC_G_TOCHKA_,'
      '110431312=            :REC_Z_DATE_,'
      '110431313=            :REC_G_CLIENT_,'
      '110431314=            :REC_CLIENT_NAME_,'
      '110431315=            :REC_G_PAYMENT_TYPE_,'
      '110431316=            :REC_PAYMENT_NAME_,'
      '110431317=            :REC_OSNOVANIE_,'
      '110431318=            :REC_G_PRODUCT_,'
      '110431319=            :REC_G_PRODUCT_PAR_,'
      '110431320=            :REC_TOVAR_NAME_,'
      '110431321=            :REC_AMOUNT_,'
      '110431322=            :REC_PRICE_,'
      '110431323=            :REC_SUMM_,'
      '110431324=            :REC_DISCOUNT_PERC_,'
      '110431325=            :REC_DISCOUNT_SUMM_,'
      '110431326=            :REC_NDS_,'
      '110431327=            :REC_NDS_SUMM_,'
      '110431328=            :REC_PRICE_SELF_'
      '110431329=        DO BEGIN'
      
        '110431330=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF' +
        '_;'
      
        '110431331=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - ' +
        'REC_NDS_SUMM_;'
      '110431332='
      '110431333=          insert into p_rep_profit_table'
      
        '110431334=            (p_rep_profit_table, zakaz, g_tochka, z_da' +
        'te, g_client, client_name, g_payment_type, payment_name,'
      
        '110431335=             osnovanie, g_product, g_product_par, tova' +
        'r_name, amount, price, summ, discount_perc, discount_summ,'
      
        '110431336=             nds, nds_summ, price_self, sum_self, prof' +
        'it, is_head)'
      '110431337=          values'
      '110431338=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '110431339=            :REC_ZAKAZ_,'
      '110431340=            :REC_g_tochka_,'
      
        '110431341=            :REC_z_date_, :REC_g_client_, :REC_client_' +
        'name_, :REC_g_payment_type_, :REC_payment_name_,'
      '110431342=             :REC_osnovanie_,'
      '110431343=             :REC_g_product_,'
      '110431344=             :REC_g_product_par_,'
      '110431345=             :REC_tovar_name_,'
      '110431346=             :REC_amount_,'
      '110431347=             :REC_price_,'
      '110431348=             :REC_summ_,'
      '110431349=             :REC_discount_perc_,'
      '110431350=             :REC_discount_summ_,'
      
        '110431351=             :REC_nds_, :REC_nds_summ_, :REC_price_sel' +
        'f_, :REC_SUM_COST_, :REC_profit_, 0);'
      '110431352='
      
        '110431353=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_' +
        ', 0);'
      
        '110431354=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_CO' +
        'ST_, 0);'
      
        '110431355=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SU' +
        'MM_, 0);'
      
        '110431356=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_,' +
        ' 0);'
      '110431357=        END'
      '110431358='
      '110431359=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110431360=        insert into p_rep_profit_table'
      
        '110431361=          (p_rep_profit_table, tovar_name, summ, sum_s' +
        'elf, NDS_SUMM, profit, is_head)'
      '110431362=        values'
      
        '110431363=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39 +
        #39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110431364='
      
        '110431365=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_' +
        ';'
      '110431366=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '110431367=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '110431368=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '110431369='
      '110431370=        SUM_ZAKAZ_ = 0;'
      '110431371=        SUM_COST_  = 0;'
      '110431372=        NDS_SUMM_  = 0;'
      '110431373=        PROFIT_    = 0;'
      '110431374=      END'
      '110431375='
      '110431377=      insert into p_rep_profit_table'
      
        '110431378=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110431379=      values'
      
        '110431380=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_S' +
        'UMM_REAL_, :PROFIT_REAL_, 2);'
      '110431381='
      
        '110431382=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL' +
        '_;'
      
        '110431383=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL' +
        '_;'
      '110431384=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '110431385=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '110431386=  END'
      '110431392=  insert into p_rep_profit_table'
      '110431393=    (p_rep_profit_table, is_head)'
      '110431394=  values'
      '110431395=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110431396='
      '110431398=  insert into p_rep_profit_table'
      
        '110431399=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110431400=  values'
      
        '110431401=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFI' +
        'T_ALL_, 1);'
      '110431402='
      '110431404=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110431405=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110431406=         SUM(Z.SUMM_BONUS)'
      '110431407=    FROM ZAKAZ Z'
      
        '110431408=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      '110431409=     AND Z.IS_SPISANIE not in (1, 4)'
      '110431410=     AND Z.IS_RESERVE = 0'
      '110431411=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110431412=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110431413=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110431414=    INTO :SUMM_CASH_ALL_,'
      '110431415=         :SUMM_NONCASH_ALL_,'
      '110431416=         :SUMM_BONUS_ALL_;'
      '110431417='
      '110431418=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '110431419=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '110431420=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110431421='
      '110431422=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110431423='
      
        '110431424=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '110431425=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110431426='
      '110431437=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110431438=    SELECT G.NAME'
      '110431439=      FROM G_CLIENT G'
      '110431440=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110431441=    INTO :CLIENT_NAME_;'
      '110431442=  ELSE'
      '110431443=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110431444='
      '110431445=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110431446=    SELECT G.NAME'
      '110431447=      FROM G_PAYMENT_TYPE G'
      '110431448=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110431449=    INTO :PAYMENT_NAME_;'
      '110431450=  ELSE'
      '110431451=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110431452='
      '110431453=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110431454=        P.ZAKAZ,'
      '110431455=        P.G_TOCHKA,'
      '110431456=        P.Z_DATE,'
      '110431457=        P.G_CLIENT,'
      '110431458=        P.CLIENT_NAME,'
      '110431459=        P.G_PAYMENT_TYPE,'
      '110431460=        P.PAYMENT_NAME,'
      '110431461=        P.OSNOVANIE,'
      '110431462=        P.G_PRODUCT,'
      '110431463=        P.G_PRODUCT_PAR,'
      '110431464=        P.TOVAR_NAME,'
      '110431465=        G.ARTICUL,'
      '110431466=        G.NOMENCLATUR_NUM,'
      '110431467=        P.AMOUNT,'
      '110431468=        P.PRICE,'
      '110431469=        P.SUMM,'
      '110431470=        P.DISCOUNT_PERC,'
      '110431471=        P.DISCOUNT_SUMM,'
      '110431472=        P.NDS,'
      '110431473=        P.NDS_SUMM,'
      '110431474=        P.PRICE_SELF,'
      '110431475=        P.SUM_SELF,'
      '110431476=        P.PROFIT,'
      '110431477=        P.IS_HEAD'
      
        '110431478=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110431479=    ORDER BY 1'
      '110431480=  INTO :P_REP_PROFIT_TABLE,'
      '110431481=       :ZAKAZ,'
      '110431482=       :G_TOCHKA,'
      '110431483=       :Z_DATE,'
      '110431484=       :G_CLIENT,'
      '110431485=       :CLIENT_NAME,'
      '110431486=       :G_PAYMENT_TYPE,'
      '110431487=       :PAYMENT_NAME,'
      '110431488=       :OSNOVANIE,'
      '110431489=       :G_PRODUCT,'
      '110431490=       :G_PRODUCT_PAR,'
      '110431491=       :TOVAR_NAME,'
      '110431492=       :ARTICUL,'
      '110431493=       :NOMENCLATUR_NUM,'
      '110431494=       :AMOUNT,'
      '110431495=       :PRICE,'
      '110431496=       :SUMM,'
      '110431497=       :DISCOUNT_PERC,'
      '110431498=       :DISCOUNT_SUMM,'
      '110431499=       :NDS,'
      '110431500=       :NDS_SUMM,'
      '110431501=       :PRICE_SELF,'
      '110431502=       :SUM_SELF,'
      '110431503=       :PROFIT,'
      '110431504=       :IS_HEAD'
      '110431505=  DO'
      '110431506=    suspend;'
      '110431507='
      '110431508=WHEN ANY DO BEGIN'
      '110431509=    Err_code = -20500;'
      
        '110431510=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110431511=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110431512=  END'
      '110431513=end'
      '110431514='#39';'
      '110431515=END  --END_EXECUTE_BLOCK'
      '110431516=EXECUTE BLOCK AS BEGIN'
      '110431517='
      '110431518=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '110431519=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110431520=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110431521=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110431522=  DATE_BEGIN_ DATE,'
      '110431523=  DATE_END_ DATE,'
      '110431524=  TIME_BEGIN_ TIME,'
      '110431525=  TIME_END_ TIME,'
      '110431526=  G_CATEGORY_ VARCHAR(1000),'
      '110431527=  G_PRODUCT_ VARCHAR(1000),'
      '110431528=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110431529=RETURNS ('
      '110431530=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110431531=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110431532=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110431533=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_TENGE,'
      
        '110431534=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110431535=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110431536=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '110431537=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110431538=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110431539=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110431540=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110431541=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110431542=  Z_DATE BLOB SUB_TYPE 1,'
      '110431543=  ROW INTEGER,'
      '110431544=  ERR_CODE INTEGER,'
      '110431545=  ERR_MSG VARCHAR(1024))'
      '110431546=AS'
      
        '110431547=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_ZAKAZI' +
        '_LIST'#39#39';'
      '110431548=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110431549=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '110431550=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80;'
      
        '110431551=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ART' +
        'ICUL;'
      
        '110431552=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BAR' +
        'CODE;'
      
        '110431553=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRO' +
        'DUCT.BARCODE;'
      
        '110431554=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110431555=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110431556=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.NAME;'
      
        '110431557=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      
        '110431558=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110431559=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM = 0;'
      
        '110431560=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110431561=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '110431562=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110431563=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM = 0;'
      
        '110431564=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110431565=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '110431566=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '110431567=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.' +
        'PATH = '#39#39#39#39';'
      '110431568=DECLARE VARIABLE I INTEGER = 1;'
      '110431569=BEGIN'
      '110431570=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '110431571=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '110431572='
      
        '110431573=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39#39'0'#39#39') ' +
        '|| '#39#39'.'#39#39' || lpad(extract(month from Z.Z_DATE),2,'#39#39'0'#39#39') || '#39#39'.'#39#39' ' +
        '|| extract(year from Z.Z_DATE),'
      '110431574=             Z.Z_TIME,'
      '110431575=             GP.ARTICUL,'
      '110431576=             GP.BARCODE,'
      '110431577=             GP.NOMENCLATUR_NUM,'
      '110431578=             GP.NAME,'
      '110431579=             ZD.AMOUNT,'
      '110431580=             ZD.PRICE,'
      '110431581=             ZD.DISCOUNT_TENGE,'
      '110431582=             ZD.SUMM,'
      '110431583=             ZD.DISCOUNT_SUMM,'
      '110431584=             GC.NAME,'
      '110431585=             P.NAME,'
      '110431586=             TR.PATH'
      '110431587=      FROM ZAKAZ Z,'
      '110431588=           ZAKAZ_DETAILS ZD,'
      '110431589=           G_CLIENT GC,'
      '110431590=           G_PAYMENT_TYPE P,'
      '110431591=           G_PRODUCT GP,'
      '110431592=           P_REP_TREE TR'
      
        '110431593=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA' +
        '||'#39#39'-'#39#39
      '110431594=       AND Z.IS_SPISANIE IN (0,2)'
      '110431595=       AND Z.IS_RESERVE = 0'
      '110431596=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110431597=       AND Z.G_CLIENT = GC.G_CLIENT'
      '110431598=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110431599=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110431600=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110431601=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110431602=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'Z.G_CLIENT, 1))'
      
        '110431603=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, GC.G_CLIENT_PARENT)'
      
        '110431604=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '110431605=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_ AND :TIME_BEGIN_ IS NULL)'
      '110431606=            OR'
      
        '110431607=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGI' +
        'N_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN' +
        '_ IS NOT NULL)'
      '110431608=           )/*'
      
        '110431609=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_E' +
        'ND_ AND :TIME_BEGIN_ IS NOT NULL)'
      '110431610=            OR'
      '110431611=            :TIME_BEGIN_ IS NULL)*/'
      
        '110431612=       AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||TR.G_PRODU' +
        'CT||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110431613=             OR'
      '110431614=             (:G_CATEGORY_ IS NULL)'
      '110431615=           )'
      
        '110431616=       AND ((:G_PRODUCT_ CONTAINING '#39#39'~'#39#39'||GP.G_PRODUC' +
        'T||'#39#39'~'#39#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110431617=             OR'
      '110431618=            (:G_PRODUCT_ IS NULL)'
      '110431619=           )'
      '110431620=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '110431621=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :N' +
        'OMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT_TENG' +
        'E_, :SUMM_, :DISCOUNT_SUMM_, :CLIENT_NAME_, :PAYMENT_NAME_, :PAT' +
        'H_'
      '110431622=  DO BEGIN'
      '110431623=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '110431624=        IF (LAST_PATH_ <> '#39#39#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069 +
        #1058#1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110431625=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110431626=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "' +
        'DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '110431627=            VALUES (:I, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39', :SUMM_ROL' +
        'L_, :DISCOUNT_SUMM_ROLL_, 1);'
      '110431628='
      '110431629=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110431630=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110431631=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + ' +
        'DISCOUNT_SUMM_ROLL_;'
      '110431632=            SUMM_ROLL_ = 0;'
      '110431633=            DISCOUNT_SUMM_ROLL_ = 0;'
      '110431634=            I = I + 1;'
      '110431635=        END'
      '110431636='
      '110431637=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110431638=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE' +
        '", ROW)'
      '110431639=        VALUES (:I, :PATH_, 1);'
      '110431640=        I = I + 1;'
      '110431641=    END'
      '110431642='
      
        '110431643=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "' +
        'TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, D' +
        'ISCOUNT, SUMM,'
      
        '110431644=                                         DISCOUNT_SUMM' +
        ', CLIENT_NAME, PAYMENT_TYPE, ROW)'
      
        '110431645=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCOD' +
        'E_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUN' +
        'T_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      '110431646=            :CLIENT_NAME_, :PAYMENT_NAME_, 0);'
      '110431647='
      '110431648=    I = I + 1;'
      '110431649=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '110431650=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOU' +
        'NT_SUMM_;'
      '110431651=    LAST_PATH_ = PATH_;'
      '110431652=  END'
      '110431653='
      '110431654=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110431655=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUM' +
        'M, DISCOUNT_SUMM, ROW)'
      
        '110431656=  VALUES (:I, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39', :SUMM_ROLL_, :DISCO' +
        'UNT_SUMM_ROLL_, 1);'
      '110431657='
      '110431658=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110431659=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110431660=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_S' +
        'UMM_ROLL_;'
      '110431661='
      
        '110431662=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUM' +
        'M, DISCOUNT_SUMM, ROW)'
      
        '110431663=  VALUES (:I, '#39#39#1048#1090#1086#1075#1086#39#39', :SUMM_ALL_, :DISCOUNT_SUMM_AL' +
        'L_, 2);'
      '110431664='
      
        '110431665=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCL' +
        'ATUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CL' +
        'IENT_NAME,'
      '110431666=             PAYMENT_TYPE, ROW'
      '110431667=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '110431668=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOME' +
        'NCLATUR_NUM, :TOVAR_NAME, :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUM' +
        'M, :DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW'
      '110431669=  do suspend;'
      '110431670='
      '110431671=WHEN ANY DO BEGIN'
      '110431672=    Err_code = -20500;'
      
        '110431673=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      
        '110431674=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110431675=  END'
      '110431676=end'
      '110431677='#39';'
      
        '110431678=UPDATE SYSTEM_SETUP SET S_VALUE = 11043 WHERE SYSTEM_S' +
        'ETUP = 3;'
      '110431679=END  --END_EXECUTE_BLOCK_PREV_VERSION'
      '110440=EXECUTE BLOCK AS BEGIN'
      '110441=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_CLIENT('
