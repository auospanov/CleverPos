      '110237305=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0,'
      
        '110237306=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      
        '110237307=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PR' +
        'IHOD_RASHOD = NULL)'
      '110237308=RETURNS ('
