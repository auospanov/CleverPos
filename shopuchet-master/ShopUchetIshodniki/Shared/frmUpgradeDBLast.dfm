      '1106012388=           T.AMOUNT_IN,'
      '1106012389=           T.AMOUNT_PRIHOD,'
      '1106012390=           T.SUMM_PRIHOD,'
      '1106012391=           T.AMOUNT_UHOD,'
      '1106012392=           T.SUMM_UHOD,'
      '1106012393=           T.AMOUNT_SPISANO,'
      '1106012394=           T.SUMM_SPISANO,'
      '1106012395=           T.AMOUNT_VOZVRAT,'
      '1106012396=           T.SUMM_VOZVRAT,'
      '1106012397=           T.AMOUNT_PRIHOD_SKL,'
      '1106012398=           T.SUMM_PRIHOD_SKL,'
      '1106012399=           T.AMOUNT_UHOD_SKL,'
      '1106012400=           T.SUMM_UHOD_SKL,'
      '1106012401=           T.AMOUNT_OUT,'
      '1106012402=           T.IS_HEAD'
      
        '1106012403=      FROM P_REP_TOVAR_MOVE_TABLE T LEFT OUTER JOIN G' +
        '_PRODUCT G ON T.G_PRODUCT = G.G_PRODUCT'
      '1106012404=     ORDER BY 1'
      '1106012405=  INTO :P_REP_TOVAR_MOVE_TABLE,'
      '1106012406=       :NAME,'
      '1106012407=       :ARTICUL,'
      '1106012408=       :BARCODE,'
      '1106012409=       :PRICE,'
      '1106012410=       :AMOUNT_IN,'
      '1106012411=       :AMOUNT_PRIHOD,'
      '1106012412=       :SUMM_PRIHOD,'
      '1106012413=       :AMOUNT_UHOD,'
      '1106012414=       :SUMM_UHOD,'
      '1106012415=       :AMOUNT_SPISANO,'
      '1106012416=       :SUMM_SPISANO,'
      '1106012417=       :AMOUNT_VOZVRAT,'
      '1106012418=       :SUMM_VOZVRAT,'
      '1106012419=       :AMOUNT_PRIHOD_SKL,'
      '1106012420=       :SUMM_PRIHOD_SKL,'
      '1106012421=       :AMOUNT_UHOD_SKL,'
      '1106012422=       :SUMM_UHOD_SKL,'
      '1106012423=       :AMOUNT_OUT,'
      '1106012424=       :IS_HEAD'
      '1106012425=  DO SUSPEND;'
      '1106012426='
      '1106012427=WHEN ANY DO BEGIN'
      '1106012428=    Err_code = -20500;'
      
        '1106012429=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106012430=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106012431=  END'
      '1106012432=end'
      '1106012433=;'
      '1106012434='
      '1106012435=ALTER PROCEDURE P_REP_WAYBILL('
      '1106012436=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1106012437=  CURRENCY_ INTEGER,'
      '1106012438=  MODE_ INTEGER)'
      '1106012439=RETURNS ('
      '1106012440=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '1106012441=  DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1106012442=  OTPRAVITEL_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '1106012443=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '1106012444=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCH' +
        'ATEL,'
      '1106012445=  OTVETST_ZA_POST_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106012446=  TRANSP_ORG_ TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      
        '1106012447=  TRANSP_NAKLAD_ TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD' +
        ','
      
        '1106012448=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN G_OFFICIAL.FIO_D' +
        'OC,'
      '1106012449=  APPOINTMENT_ TYPE OF COLUMN G_APPOINTMENT.NAME,'
      '1106012450=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106012451=  GLAVBUH_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106012452=  SUMM_VSEGO_ VARCHAR(50),'
      '1106012453=  SUMM_NDS_VSEGO_ VARCHAR(50),'
      '1106012454=  COUNT_VSEGO_ VARCHAR(500),'
      '1106012455=  STR_VSEGO_ VARCHAR(500),'
      '1106012456=  ROW_NUM INTEGER,'
      '1106012457=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '1106012458=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1106012459=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106012460=  SHORT_NAME TYPE OF COLUMN G_UNIT.SHORT_NAME,'
      '1106012461=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106012462=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1106012463=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1106012464=  SUMM_NDS VARCHAR(50),'
      '1106012465=  NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS,'
      '1106012466=  SUMM_WO_NDS TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1106012467=  NDS_HEADER_ VARCHAR(50),'
      '1106012468=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
        '1106012469=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST' +
        '_FIO,'
      '1106012470=  ERR_CODE INTEGER,'
      '1106012471=  ERR_MSG VARCHAR(1024))'
      '1106012472=AS'
      
        '1106012473=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_WAYBIL' +
        'L'#39';'
      '1106012474=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106012475=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1106012476=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NOL_VMESTO_BEZ;'
      
        '1106012477=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REK' +
        'VIZIT.NDS_VALUE;'
      '1106012478=DECLARE VARIABLE I INTEGER;'
      
        '1106012479=DECLARE VARIABLE DETAILS TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.ZAKAZ_DETAILS;'
      '1106012480=BEGIN'
      '1106012481='
      '1106012482=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106012483=  SELECT W.NUM,'
      '1106012484=         W.INIT_DATE,'
      '1106012485=         W.POSTAVSHIK,'
      '1106012486=         W.IDN,'
      '1106012487=         W.GRUZOPOLUCHATEL,'
      
        '1106012488=         DECODE(CHAR_LENGTH(G.FIO_DOC), 0, G.FM||'#39' '#39'|' +
        '|G.NM||'#39' '#39'||G.FT, G.FIO_DOC) OTVETST_ZA_POST,'
      '1106012489=         W.TRANSP_ORG,'
      '1106012490=         W.TRANSP_NAKLAD,'
      
        '1106012491=         DECODE(CHAR_LENGTH(GG.FIO_DOC), 0, GG.FIO, G' +
        'G.FIO_DOC) G_OFFICIAL_RUKOVOD,'
      '1106012492=         GG.APPOINT,'
      
        '1106012493=         DECODE(CHAR_LENGTH(G2.FIO_DOC), 0, G2.FM||'#39' ' +
        #39'||G2.NM||'#39' '#39'||G2.FT, G2.FIO_DOC) G_OFFICIAL,'
      '1106012494=         W.ZAKAZ,'
      '1106012495=         GF.NOL_VMESTO_BEZ,'
      '1106012496=         GF.NDS_VALUE,'
      '1106012497=         COALESCE(GO.FIO_DOC, '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39'),'
      '1106012498=         W.doverennost,'
      '1106012499=         W.doverennost_FIO'
      
        '1106012500=    FROM WAYBILL W LEFT OUTER JOIN G_OFFICIAL G ON W.' +
        'OTVETST_ZA_POST = G.G_OFFICIAL'
      
        '1106012501=                   LEFT OUTER JOIN (SELECT G1.G_OFFIC' +
        'IAL, G1.FIO_DOC, G1.FM||'#39' '#39'||G1.NM||'#39' '#39'||G1.FT FIO, A.NAME APPOI' +
        'NT'
      
        '1106012502=                                      FROM G_OFFICIAL' +
        ' G1 LEFT OUTER JOIN G_APPOINTMENT A ON G1.G_APPOINTMENT = A.G_AP' +
        'POINTMENT) GG ON W.G_OFFICIAL_RUKOVOD = GG.G_OFFICIAL'
      
        '1106012503=                   LEFT OUTER JOIN G_OFFICIAL G2 ON W' +
        '.G_OFFICIAL = G2.G_OFFICIAL'
      
        '1106012504=                   LEFT OUTER JOIN G_OFFICIAL GO ON W' +
        '.GLAVBUH = GO.G_OFFICIAL,'
      '1106012505='
      '1106012506=         G_FIRM_REKVIZIT GF'
      '1106012507=   WHERE W.WAYBILL = :WAYBILL_'
      
        '1106012508=     AND ((W.g_firm = GF.g_firm_rekvizit AND W.g_firm' +
        ' IS NOT NULL) OR (GF.is_default = 1 AND W.g_firm IS NULL))  -- '#1044 +
        #1054' 02.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '1106012509=    INTO :NUM_,'
      '1106012510=        :DATE_,'
      '1106012511=        :OTPRAVITEL_,'
      '1106012512=        :IDN_,'
      '1106012513=        :GRUZOPOLUCHATEL_,'
      '1106012514=        :OTVETST_ZA_POST_,'
      '1106012515=        :TRANSP_ORG_,'
      '1106012516=        :TRANSP_NAKLAD_,'
      '1106012517=        :G_OFFICIAL_RUKOVOD_,'
      '1106012518=        :APPOINTMENT_,'
      '1106012519=        :G_OFFICIAL_,'
      '1106012520=        :ZAKAZ_,'
      '1106012521=        :BEZ_NDS_,'
      '1106012522=        :NDS_VALUE_,'
      '1106012523=        :GLAVBUH_,'
      '1106012524=        :doverennost_,'
      '1106012525=        :doverennost_fio_;'
      '1106012526='
      '1106012527=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '1106012528=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' (' +
        #1088#1072#1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080#1079#1072#1094 +
        #1080#1080'"'
      
        '1106012529=  -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052#1059' '#1063 +
        #1058#1054' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048#1058#1040#1045 +
        #1058#1057#1071
      '1106012530=  IF (MODE_ <> 3) THEN'
      
        '1106012531=      SELECT REPLACE(CAST(MAX(Z.SUMM) AS VARCHAR(10))' +
        ', '#39'.'#39', '#39','#39'),'
      '1106012532=             DECODE(:NDS_VALUE_,'
      
        '1106012533=                     0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048 +
        ' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1106012534=                               0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1106012535=                               '#39'0,00'#39'),'
      
        '1106012536=                     REPLACE(CAST(MAX(Z.SUMM) - CAST(' +
        'ROUND(MAX(Z.SUMM)/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      '1106012537=                    ),'
      
        '1106012538=             (SELECT CURR_STR from CURRENCYSTR(SUM(ZD' +
        '.AMOUNT), -1)),'
      
        '1106012539=             (SELECT CURR_STR from CURRENCYSTR(MAX(Z.' +
        'SUMM), :CURRENCY_)),'
      
        '1106012540=             DECODE(:NDS_VALUE_, 0, '#39#1057#1091#1084#1084#1072' '#1073#1077#1079' '#1053#1044#1057', '#1074 +
        ' KZT'#39', '#39#1057#1091#1084#1084#1072' '#1089' '#1053#1044#1057', '#1074' KZT'#39')'
      '1106012541=        FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      '1106012542=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106012543=         AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106012544=        INTO :SUMM_VSEGO_,'
      '1106012545=             :SUMM_NDS_VSEGO_,'
      '1106012546=             :COUNT_VSEGO_,'
      '1106012547=             :STR_VSEGO_,'
      '1106012548=             :NDS_HEADER_;'
      '1106012549=  ELSE'
      
        '1106012550=      SELECT REPLACE(CAST(MAX(SP.SUMM) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39'),'
      '1106012551=             DECODE(:NDS_VALUE_,'
      
        '1106012552=                     0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048 +
        ' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1106012553=                               0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1106012554=                               '#39'0,00'#39'),'
      
        '1106012555=                     REPLACE(CAST(MAX(SP.SUMM) - CAST' +
        '(ROUND(MAX(SP.SUMM)/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      '1106012556=                    ),'
      
        '1106012557=             (SELECT CURR_STR from CURRENCYSTR(SUM(S.' +
        'AMOUNT), -1)),'
      
        '1106012558=             (SELECT CURR_STR from CURRENCYSTR(MAX(SP' +
        '.SUMM), :CURRENCY_)),'
      
        '1106012559=             DECODE(:NDS_VALUE_, 0, '#39#1057#1091#1084#1084#1072' '#1073#1077#1079' '#1053#1044#1057', '#1074 +
        ' KZT'#39', '#39#1057#1091#1084#1084#1072' '#1089' '#1053#1044#1057', '#1074' KZT'#39')'
      '1106012560=        FROM SKLAD_PARENT SP, SKLAD S'
      '1106012561=       WHERE SP.SKLAD = :ZAKAZ_'
      '1106012562=         AND SP.SKLAD = S.SKLAD_PARENT'
      '1106012563=        INTO :SUMM_VSEGO_,'
      '1106012564=             :SUMM_NDS_VSEGO_,'
      '1106012565=             :COUNT_VSEGO_,'
      '1106012566=             :STR_VSEGO_,'
      '1106012567=             :NDS_HEADER_;'
      '1106012568='
      '1106012569=  ROW_NUM = 0;'
      '1106012570=  FOR'
      '1106012571=    SELECT --:I,'
      '1106012572=           G.NAME,'
      '1106012573=           G.NOMENCLATUR_NUM,'
      '1106012574=           G.articul,'
      '1106012575=           U.SHORT_NAME,'
      '1106012576=           ZD.AMOUNT,'
      '1106012577=           ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE, 0),'
      '1106012578=           ZD.SUMM,'
      '1106012579=           DECODE(:NDS_VALUE_,'
      
        '1106012580=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1106012581=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1106012582=                             '#39'0,00'#39'),'
      
        '1106012583=                   REPLACE(CAST(ZD.SUMM - CAST(ROUND(' +
        'ZD.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS VARCHAR(1' +
        '0)), '#39'.'#39', '#39','#39')'
      '1106012584=                   ),'
      '1106012585=           :NDS_VALUE_,'
      '1106012586=          ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2),'
      '1106012587=          ZD.ZAKAZ_DETAILS'
      '1106012588=      FROM ZAKAZ Z,'
      '1106012589=           ZAKAZ_DETAILS ZD,'
      '1106012590=           G_PRODUCT G,'
      '1106012591=           G_UNIT U'
      '1106012592=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106012593=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106012594=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1106012595=       AND G.G_UNIT = U.G_UNIT'
      '1106012596=       AND :MODE_ <> 3'
      '1106012597=    UNION ALL'
      '1106012598=    SELECT --:I,'
      '1106012599=           G.NAME,'
      '1106012600=           G.NOMENCLATUR_NUM,'
      '1106012601=           G.articul,'
      '1106012602=           U.SHORT_NAME,'
      '1106012603=           S.AMOUNT,'
      '1106012604=           S.PRICE,'
      '1106012605=           S.SUMM,'
      '1106012606=           DECODE(:NDS_VALUE_,'
      
        '1106012607=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053 +
        #1045' '#1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '1106012608=                             0, '#39#1041#1077#1079' '#1053#1044#1057#39','
      '1106012609=                             '#39'0,00'#39'),'
      
        '1106012610=                   REPLACE(CAST(S.SUMM - CAST(ROUND(S' +
        '.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2)) AS VARCHAR(10)' +
        '), '#39'.'#39', '#39','#39')'
      '1106012611=                   ),'
      '1106012612=           :NDS_VALUE_,'
      '1106012613=          ROUND(S.SUMM/(1 + :NDS_VALUE_/100), 2),'
      '1106012614=          S.SKLAD ZAKAZ_DETAILS'
      '1106012615=      FROM SKLAD_PARENT SP,'
      '1106012616=           SKLAD S,'
      '1106012617=           G_PRODUCT G,'
      '1106012618=           G_UNIT U'
      '1106012619=     WHERE SP.SKLAD = :ZAKAZ_'
      '1106012620=       AND SP.SKLAD = S.SKLAD_PARENT'
      '1106012621=       AND S.G_PRODUCT = G.G_PRODUCT'
      '1106012622=       AND G.G_UNIT = U.G_UNIT'
      '1106012623=       AND :MODE_ = 3'
      '1106012624=     ORDER BY 1'
      '1106012625=    INTO --:ROW_NUM,'
      '1106012626=        :NAME,'
      '1106012627=        :NOMENCLATUR_NUM,'
      '1106012628=        :ARTICUL,'
      '1106012629=        :SHORT_NAME,'
      '1106012630=        :AMOUNT,'
      '1106012631=        :PRICE,'
      '1106012632=        :SUMM,'
      '1106012633=        :SUMM_NDS,'
      '1106012634=        :NDS,'
      '1106012635=        :SUMM_WO_NDS,'
      '1106012636=        :DETAILS'
      '1106012637=  DO BEGIN'
      '1106012638=    ROW_NUM = ROW_NUM + 1;'
      '1106012639=    SUSPEND;'
      '1106012640=  END'
      '1106012641='
      '1106012642=WHEN ANY DO BEGIN'
      '1106012643=    Err_code = -20500;'
      
        '1106012644=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106012645=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106012646=  END'
      '1106012647=end'
      '1106012648=;'
      '1106012649='
      '1106012650=ALTER PROCEDURE P_REP_ZAKAZ_NA_REAL('
      '1106012651=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1106012652=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1106012653=  DATE_BEGIN_ DATE,'
      '1106012654=  DATE_END_ DATE,'
      '1106012655=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1106012656=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1106012657=  MODE_ INTEGER,'
      '1106012658=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106012659=RETURNS ('
      
        '1106012660=  ZAKAZ_DATE TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE' +
        '.ZAKAZ_DATE,'
      '1106012661=  NAME TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.NAME,'
      
        '1106012662=  ARTICUL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.AR' +
        'TICUL,'
      
        '1106012663=  PRICE TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.PRIC' +
        'E,'
      
        '1106012664=  AMOUNT_ALL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE' +
        '.AMOUNT_ALL,'
      
        '1106012665=  SUMM_ALL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.S' +
        'UMM_ALL,'
      
        '1106012666=  AMOUNT_PAYED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TAB' +
        'LE.AMOUNT_PAYED,'
      
        '1106012667=  SUMM_PAYED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE' +
        '.SUMM_PAYED,'
      
        '1106012668=  AMOUNT_RETURNED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_' +
        'TABLE.AMOUNT_RETURNED,'
      
        '1106012669=  SUMM_RETURNED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TA' +
        'BLE.SUMM_RETURNED,'
      
        '1106012670=  AMOUNT_LEFT TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABL' +
        'E.AMOUNT_LEFT,'
      
        '1106012671=  SUMM_LEFT TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.' +
        'SUMM_LEFT,'
      
        '1106012672=  IS_HEAD TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.IS' +
        '_HEAD)'
      '1106012673=AS'
      
        '1106012674=DECLARE VARIABLE G_CLIENT_NAME_ TYPE OF COLUMN G_CLIE' +
        'NT.NAME;'
      
        '1106012675=DECLARE VARIABLE G_CLIENT_NAME_OLD_ TYPE OF COLUMN G_' +
        'CLIENT.NAME;'
      '1106012676=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '1106012677=DECLARE VARIABLE SUMM_IT_ NUMERIC(15,2) = 0;'
      '1106012678=DECLARE VARIABLE SUMM_ALL_ NUMERIC(15,2) = 0;'
      '1106012679=DECLARE VARIABLE SUMM_PAYED_ NUMERIC(15,2) = 0;'
      '1106012680=DECLARE VARIABLE SUMM_PAYED_IT_ NUMERIC(15,2) = 0;'
      '1106012681=DECLARE VARIABLE SUMM_PAYED_ALL_ NUMERIC(15,2) = 0;'
      '1106012682=DECLARE VARIABLE SUMM_RETURNED_ NUMERIC(15,2) = 0;'
      '1106012683=DECLARE VARIABLE SUMM_RETURNED_IT_ NUMERIC(15,2) = 0;'
      
        '1106012684=DECLARE VARIABLE SUMM_RETURNED_ALL_ NUMERIC(15,2) = 0' +
        ';'
      '1106012685=DECLARE VARIABLE SUMM_LEFT_ NUMERIC(15,2) = 0;'
      '1106012686=DECLARE VARIABLE SUMM_LEFT_IT_ NUMERIC(15,2) = 0;'
      '1106012687=DECLARE VARIABLE SUMM_LEFT_ALL_ NUMERIC(15,2) = 0;'
      
        '1106012688=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN P_REP_ZAKAZ_N' +
        'A_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012689=DECLARE VARIABLE AMOUNT_IT_ TYPE OF COLUMN P_REP_ZAKA' +
        'Z_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012690=DECLARE VARIABLE AMOUNT_ALL_ TYPE OF COLUMN P_REP_ZAK' +
        'AZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012691=DECLARE VARIABLE AMOUNT_PAYED_ TYPE OF COLUMN P_REP_Z' +
        'AKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012692=DECLARE VARIABLE AMOUNT_PAYED_IT_ TYPE OF COLUMN P_RE' +
        'P_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012693=DECLARE VARIABLE AMOUNT_PAYED_ALL_ TYPE OF COLUMN P_R' +
        'EP_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012694=DECLARE VARIABLE AMOUNT_RETURNED_ TYPE OF COLUMN P_RE' +
        'P_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012695=DECLARE VARIABLE AMOUNT_RETURNED_IT_ TYPE OF COLUMN P' +
        '_REP_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012696=DECLARE VARIABLE AMOUNT_RETURNED_ALL_ TYPE OF COLUMN ' +
        'P_REP_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012697=DECLARE VARIABLE AMOUNT_LEFT_ TYPE OF COLUMN P_REP_ZA' +
        'KAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012698=DECLARE VARIABLE AMOUNT_LEFT_IT_ TYPE OF COLUMN P_REP' +
        '_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012699=DECLARE VARIABLE AMOUNT_LEFT_ALL_ TYPE OF COLUMN P_RE' +
        'P_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '1106012700=DECLARE VARIABLE ZAKAZ_DATE_ TYPE OF COLUMN ZAKAZ_REA' +
        'L_PARENT.ZAKAZ_DATE;'
      '1106012701=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1106012702=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1106012703=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'PRICE;'
      '1106012704=BEGIN'
      '1106012705=  DELETE FROM P_REP_ZAKAZ_NA_REAL_TABLE;'
      '1106012706=  G_CLIENT_NAME_OLD_ = '#39#39';'
      '1106012707='
      '1106012708=  FOR SELECT TRIM(G.NAME),'
      '1106012709=             ZP.ZAKAZ_DATE,'
      '1106012710=             P.NAME,'
      '1106012711=             P.ARTICUL,'
      '1106012712=             Z.PRICE,'
      '1106012713=             Z.AMOUNT_ALL,'
      '1106012714=             Z.SUMM_ALL,'
      '1106012715=             Z.AMOUNT_PAYED,'
      '1106012716=             Z.SUMM_PAYED,'
      '1106012717=             COALESCE(Z.AMOUNT_RETURNED, 0),'
      '1106012718=             COALESCE(Z.SUMM_RETURNED, 0),'
      
        '1106012719=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE' +
        '(Z.AMOUNT_RETURNED, 0),'
      
        '1106012720=             Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.S' +
        'UMM_RETURNED, 0)'
      '1106012721=        FROM ZAKAZ_REAL_PARENT ZP,'
      '1106012722=             ZAKAZ_NA_REAL Z,'
      '1106012723=             G_CLIENT G,'
      '1106012724=             G_PRODUCT P'
      
        '1106012725=       WHERE ZP.ZAKAZ_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1106012726=         AND ZP.G_CLIENT = G.G_CLIENT'
      
        '1106012727=         AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PARE' +
        'NT'
      '1106012728=         AND Z.G_PRODUCT = P.G_PRODUCT'
      
        '1106012729=         AND ZP.G_CLIENT = COALESCE(:G_CLIENT_, ZP.G_' +
        'CLIENT)'
      
        '1106012730=         AND G.G_CLIENT_PARENT = COALESCE(:G_CLIENT_C' +
        'AT_, G.G_CLIENT_PARENT)'
      
        '1106012731=         AND (((Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALE' +
        'SCE(Z.AMOUNT_RETURNED, 0)) > 0 AND :MODE_ = 0)'
      '1106012732=              OR'
      '1106012733=              (Z.AMOUNT_PAYED > 0 AND :MODE_ = 1)'
      '1106012734=              OR'
      
        '1106012735=              (COALESCE(Z.AMOUNT_RETURNED, 0) > 0 AND' +
        ' :MODE_ = 2)'
      '1106012736=              OR'
      '1106012737=              :MODE_ = 3)'
      
        '1106012738=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||P.G_PRODU' +
        'CT_PAR||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL) or :G_CATEGORY_ IS NUL' +
        'L)'
      
        '1106012739=         AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||P.G_PRODUC' +
        'T||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL) or :G_PRODUCT_ IS NULL)'
      
        '1106012740=         AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZP.G_TOCH' +
        'KA||'#39'-'#39
      '1106012741=       ORDER BY G.NAME, ZP.ZAKAZ_DATE, P.NAME'
      
        '1106012742=        INTO :G_CLIENT_NAME_, :ZAKAZ_DATE_, :NAME_, :' +
        'ARTICUL_, :PRICE_, :AMOUNT_, :SUMM_, :AMOUNT_PAYED_, :SUMM_PAYED' +
        '_, :AMOUNT_RETURNED_, :SUMM_RETURNED_, :AMOUNT_LEFT_, :SUMM_LEFT' +
        '_'
      '1106012743=  DO BEGIN'
      '1106012744=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050
      
        '1106012745=      IF (G_CLIENT_NAME_ <> G_CLIENT_NAME_OLD_) THEN ' +
        'BEGIN'
      
        '1106012746=          -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1055 +
        #1045#1056#1042#1067#1049' '#1050#1051#1048#1045#1053#1058
      '1106012747=          IF (G_CLIENT_NAME_OLD_ <> '#39#39') THEN BEGIN'
      
        '1106012748=              INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (' +
        'P_REP_ZAKAZ_NA_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PA' +
        'YED, SUMM_PAYED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNE' +
        'D, SUMM_RETURNED)'
      
        '1106012749=              VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL,' +
        ' 1), '#39#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059#39', :AMOUNT_IT_, :SUMM_IT_, :AMOUNT_PAYED_I' +
        'T_, :SUMM_PAYED_IT_, :AMOUNT_LEFT_IT_, :SUMM_LEFT_IT_, 2, :AMOUN' +
        'T_RETURNED_IT_, :SUMM_RETURNED_IT_);'
      '1106012750='
      '1106012751=              SUMM_ALL_ = SUMM_ALL_ + SUMM_IT_;'
      
        '1106012752=              SUMM_PAYED_ALL_  = SUMM_PAYED_ALL_ + SU' +
        'MM_PAYED_IT_;'
      
        '1106012753=              SUMM_RETURNED_ALL_  = SUMM_RETURNED_ALL' +
        '_ + SUMM_RETURNED_IT_;'
      
        '1106012754=              SUMM_LEFT_ALL_   = SUMM_LEFT_ALL_ + SUM' +
        'M_LEFT_IT_;'
      
        '1106012755=              AMOUNT_ALL_      = AMOUNT_ALL_ + AMOUNT' +
        '_IT_;'
      
        '1106012756=              AMOUNT_PAYED_ALL_ = AMOUNT_PAYED_ALL_ +' +
        ' AMOUNT_PAYED_IT_;'
      
        '1106012757=              AMOUNT_RETURNED_ALL_ = AMOUNT_RETURNED_' +
        'ALL_ + AMOUNT_RETURNED_IT_;'
      
        '1106012758=              AMOUNT_LEFT_ALL_  = AMOUNT_LEFT_ALL_ + ' +
        'AMOUNT_LEFT_IT_;'
      '1106012759='
      '1106012760=              SUMM_IT_ = 0;'
      '1106012761=              SUMM_PAYED_IT_  = 0;'
      '1106012762=              SUMM_RETURNED_IT_ = 0;'
      '1106012763=              SUMM_LEFT_IT_   = 0;'
      '1106012764=              AMOUNT_IT_      = 0;'
      '1106012765=              AMOUNT_PAYED_IT_ = 0;'
      '1106012766=              AMOUNT_RETURNED_IT_ = 0;'
      '1106012767=              AMOUNT_LEFT_IT_  = 0;'
      '1106012768=          END'
      '1106012769='
      
        '1106012770=          INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_RE' +
        'P_ZAKAZ_NA_REAL_TABLE, NAME, IS_HEAD)'
      
        '1106012771=          VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1),' +
        ' :G_CLIENT_NAME_, 1);'
      '1106012772='
      '1106012773=          G_CLIENT_NAME_OLD_ = G_CLIENT_NAME_;'
      '1106012774=      END'
      '1106012775='
      
        '1106012776=      INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZA' +
        'KAZ_NA_REAL_TABLE, ZAKAZ_DATE, NAME, ARTICUL, PRICE, AMOUNT_ALL,' +
        ' SUMM_ALL, AMOUNT_PAYED,'
      
        '1106012777=                                       SUMM_PAYED, AM' +
        'OUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_RETURNED)'
      
        '1106012778=      VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), :ZA' +
        'KAZ_DATE_, :NAME_, :ARTICUL_, :PRICE_, :AMOUNT_, :SUMM_, :AMOUNT' +
        '_PAYED_, :SUMM_PAYED_, :AMOUNT_LEFT_, :SUMM_LEFT_, 0, :AMOUNT_RE' +
        'TURNED_, :SUMM_RETURNED_);'
      '1106012779='
      '1106012780=      SUMM_IT_ = SUMM_IT_ + SUMM_;'
      '1106012781=      SUMM_PAYED_IT_  = SUMM_PAYED_IT_ + SUMM_PAYED_;'
      
        '1106012782=      SUMM_RETURNED_IT_  = SUMM_RETURNED_IT_ + SUMM_R' +
        'ETURNED_;'
      '1106012783=      SUMM_LEFT_IT_   = SUMM_LEFT_IT_ + SUMM_LEFT_;'
      '1106012784=      AMOUNT_IT_      = AMOUNT_IT_ + AMOUNT_;'
      
        '1106012785=      AMOUNT_PAYED_IT_ = AMOUNT_PAYED_IT_ + AMOUNT_PA' +
        'YED_;'
      
        '1106012786=      AMOUNT_RETURNED_IT_ = AMOUNT_RETURNED_IT_ + AMO' +
        'UNT_RETURNED_;'
      
        '1106012787=      AMOUNT_LEFT_IT_  = AMOUNT_LEFT_IT_ + AMOUNT_LEF' +
        'T_;'
      '1106012788=  END'
      '1106012789='
      '1106012790=  SUMM_ALL_ = SUMM_ALL_ + SUMM_IT_;'
      
        '1106012791=  SUMM_PAYED_ALL_  = SUMM_PAYED_ALL_ + SUMM_PAYED_IT_' +
        ';'
      
        '1106012792=  SUMM_RETURNED_ALL_  = SUMM_RETURNED_ALL_ + SUMM_RET' +
        'URNED_IT_;'
      '1106012793=  SUMM_LEFT_ALL_   = SUMM_LEFT_ALL_ + SUMM_LEFT_IT_;'
      '1106012794=  AMOUNT_ALL_      = AMOUNT_ALL_ + AMOUNT_IT_;'
      
        '1106012795=  AMOUNT_PAYED_ALL_ = AMOUNT_PAYED_ALL_ + AMOUNT_PAYE' +
        'D_IT_;'
      
        '1106012796=  AMOUNT_RETURNED_ALL_ = AMOUNT_RETURNED_ALL_ + AMOUN' +
        'T_RETURNED_IT_;'
      
        '1106012797=  AMOUNT_LEFT_ALL_  = AMOUNT_LEFT_ALL_ + AMOUNT_LEFT_' +
        'IT_;'
      '1106012798='
      
        '1106012799=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1045#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051 +
        #1048' '#1054#1058#1063#1045#1058' '#1053#1045' '#1055#1054' '#1050#1054#1053#1050#1056#1045#1058#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1058'.'#1050'. '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1048#1058#1054#1043#1054' '#1055#1054' '#1050 +
        #1051#1048#1045#1053#1058#1059' '#1048' '#1057#1051#1045#1044' '#1057#1058#1056#1054#1063#1050#1040' '#1048#1058#1054#1043#1054' '#1041#1059#1044#1059#1058' '#1056#1040#1042#1053#1067
      '1106012800=  IF (G_CLIENT_ IS NULL) THEN'
      
        '1106012801=      INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZA' +
        'KAZ_NA_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAYED, SUM' +
        'M_PAYED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_' +
        'RETURNED)'
      
        '1106012802=      VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), '#39#1048#1058 +
        #1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059#39', :AMOUNT_IT_, :SUMM_IT_, :AMOUNT_PAYED_IT_, :SUM' +
        'M_PAYED_IT_, :AMOUNT_LEFT_IT_, :SUMM_LEFT_IT_, 2, :AMOUNT_RETURN' +
        'ED_IT_, :SUMM_RETURNED_IT_);'
      '1106012803='
      '1106012804=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '1106012805=  INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZAKAZ_' +
        'NA_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAYED, SUMM_PA' +
        'YED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_RETU' +
        'RNED)'
      
        '1106012806=  VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), '#39#1048#1058#1054#1043#1054#39 +
        ', :AMOUNT_ALL_, :SUMM_ALL_, :AMOUNT_PAYED_ALL_, :SUMM_PAYED_ALL_' +
        ', :AMOUNT_LEFT_ALL_, :SUMM_LEFT_ALL_, 1, :AMOUNT_RETURNED_ALL_, ' +
        ':SUMM_RETURNED_ALL_);'
      '1106012807='
      '1106012808=  FOR SELECT ZAKAZ_DATE,'
      '1106012809=             NAME,'
      '1106012810=             ARTICUL,'
      '1106012811=             PRICE,'
      '1106012812=             AMOUNT_ALL,'
      '1106012813=             SUMM_ALL,'
      '1106012814=             AMOUNT_PAYED,'
      '1106012815=             SUMM_PAYED,'
      '1106012816=             AMOUNT_RETURNED,'
      '1106012817=             SUMM_RETURNED,'
      '1106012818=             AMOUNT_LEFT,'
      '1106012819=             SUMM_LEFT,'
      '1106012820=             IS_HEAD'
      '1106012821=      FROM P_REP_ZAKAZ_NA_REAL_TABLE'
      '1106012822=      ORDER BY P_REP_ZAKAZ_NA_REAL_TABLE'
      
        '1106012823=      INTO :ZAKAZ_DATE, :NAME, :ARTICUL, :PRICE, :AMO' +
        'UNT_ALL, :SUMM_ALL, :AMOUNT_PAYED, :SUMM_PAYED, :AMOUNT_RETURNED' +
        ', :SUMM_RETURNED,'
      '1106012824=           :AMOUNT_LEFT, :SUMM_LEFT, :IS_HEAD'
      '1106012825=  DO'
      '1106012826=    SUSPEND;'
      '1106012827=end'
      '1106012828=;'
      '1106012829='
      '1106012830=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '1106012831=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1106012832=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1106012833=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106012834=  DATE_BEGIN_ DATE,'
      '1106012835=  DATE_END_ DATE,'
      '1106012836=  TIME_BEGIN_ TIME,'
      '1106012837=  TIME_END_ TIME,'
      '1106012838=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1106012839=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1106012840=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106012841=RETURNS ('
      '1106012842=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106012843=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1106012844=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1106012845=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1106012846=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1106012847=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106012848=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1106012849=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106012850=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106012851=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1106012852=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1106012853=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106012854=  Z_DATE BLOB SUB_TYPE 1,'
      '1106012855=  ROW INTEGER,'
      '1106012856=  ERR_CODE INTEGER,'
      '1106012857=  ERR_MSG VARCHAR(1024))'
      '1106012858=AS'
      
        '1106012859=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST'#39';'
      '1106012860=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106012861=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1106012862=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '1106012863=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1106012864=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BA' +
        'RCODE;'
      
        '1106012865=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PR' +
        'ODUCT.BARCODE;'
      
        '1106012866=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1106012867=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1106012868=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.NAME;'
      
        '1106012869=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '1106012870=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1106012871=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM = 0;'
      
        '1106012872=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1106012873=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1106012874=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1106012875=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_SUMM = 0;'
      
        '1106012876=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1106012877=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1106012878=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1106012879=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1106012880=DECLARE VARIABLE I INTEGER = 1;'
      '1106012881=BEGIN'
      '1106012882=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1106012883=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1106012884='
      
        '1106012885=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') |' +
        '| '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extr' +
        'act(year from Z.Z_DATE),'
      '1106012886=             Z.Z_TIME,'
      '1106012887=             GP.ARTICUL,'
      '1106012888=             GP.BARCODE,'
      '1106012889=             GP.NOMENCLATUR_NUM,'
      '1106012890=             GP.NAME,'
      '1106012891=             ZD.AMOUNT,'
      '1106012892=             ZD.PRICE,'
      '1106012893=             ZD.DISCOUNT_TENGE,'
      '1106012894=             ZD.SUMM,'
      '1106012895=             ZD.DISCOUNT_SUMM,'
      '1106012896=             GC.NAME,'
      '1106012897=             P.NAME,'
      '1106012898=             TR.PATH'
      '1106012899=      FROM ZAKAZ Z,'
      '1106012900=           ZAKAZ_DETAILS ZD,'
      '1106012901=           G_CLIENT GC,'
      '1106012902=           G_PAYMENT_TYPE P,'
      '1106012903=           G_PRODUCT GP,'
      '1106012904=           P_REP_TREE TR'
      
        '1106012905=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1106012906=       AND Z.IS_SPISANIE IN (0,2)'
      '1106012907=       AND Z.IS_RESERVE = 0'
      '1106012908=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106012909=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1106012910=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1106012911=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1106012912=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106012913=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106012914=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1106012915=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1106012916=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1106012917=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1106012918=            OR'
      
        '1106012919=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1106012920=           )/*'
      
        '1106012921=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_' +
        'END_ AND :TIME_BEGIN_ IS NOT NULL)'
      '1106012922=            OR'
      '1106012923=            :TIME_BEGIN_ IS NULL)*/'
      
        '1106012924=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1106012925=             OR'
      '1106012926=             (:G_CATEGORY_ IS NULL)'
      '1106012927=           )'
      
        '1106012928=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1106012929=             OR'
      '1106012930=            (:G_PRODUCT_ IS NULL)'
      '1106012931=           )'
      '1106012932=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '1106012933=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :' +
        'NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT_TEN' +
        'GE_, :SUMM_, :DISCOUNT_SUMM_, :CLIENT_NAME_, :PAYMENT_NAME_, :PA' +
        'TH_'
      '1106012934=  DO BEGIN'
      '1106012935=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1106012936=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106012937=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106012938=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, ' +
        '"DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '1106012939=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL' +
        '_, :DISCOUNT_SUMM_ROLL_, 1);'
      '1106012940='
      '1106012941=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1106012942=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1106012943=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ +' +
        ' DISCOUNT_SUMM_ROLL_;'
      '1106012944=            SUMM_ROLL_ = 0;'
      '1106012945=            DISCOUNT_SUMM_ROLL_ = 0;'
      '1106012946=            I = I + 1;'
      '1106012947=        END'
      '1106012948='
      '1106012949=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106012950=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DAT' +
        'E", ROW)'
      '1106012951=        VALUES (:I, :PATH_, 1);'
      '1106012952=        I = I + 1;'
      '1106012953=    END'
      '1106012954='
      
        '1106012955=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", ' +
        '"TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, ' +
        'DISCOUNT, SUMM,'
      
        '1106012956=                                         DISCOUNT_SUM' +
        'M, CLIENT_NAME, PAYMENT_TYPE, ROW)'
      
        '1106012957=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCO' +
        'DE_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOU' +
        'NT_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      '1106012958=            :CLIENT_NAME_, :PAYMENT_NAME_, 0);'
      '1106012959='
      '1106012960=    I = I + 1;'
      '1106012961=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '1106012962=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCO' +
        'UNT_SUMM_;'
      '1106012963=    LAST_PATH_ = PATH_;'
      '1106012964=  END'
      '1106012965='
      '1106012966=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106012967=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1106012968=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOU' +
        'NT_SUMM_ROLL_, 1);'
      '1106012969='
      '1106012970=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1106012971=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1106012972=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_' +
        'SUMM_ROLL_;'
      '1106012973='
      
        '1106012974=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1106012975=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1106012976='
      
        '1106012977=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENC' +
        'LATUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, C' +
        'LIENT_NAME,'
      '1106012978=             PAYMENT_TYPE, ROW'
      '1106012979=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1106012980=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOM' +
        'ENCLATUR_NUM, :TOVAR_NAME, :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SU' +
        'MM, :DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW'
      '1106012981=  do suspend;'
      '1106012982='
      '1106012983=WHEN ANY DO BEGIN'
      '1106012984=    Err_code = -20500;'
      
        '1106012985=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1106012986=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106012987=  END'
      '1106012988=end'
      '1106012989=;'
      '1106012990='
      '1106012991=ALTER PROCEDURE P_REP_ZAKAZI_LIST_CATEGORY('
      '1106012992=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1106012993=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1106012994=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106012995=  DATE_BEGIN_ DATE,'
      '1106012996=  DATE_END_ DATE,'
      '1106012997=  TIME_BEGIN_ TIME,'
      '1106012998=  TIME_END_ TIME,'
      '1106012999=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1106013000=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106013001=RETURNS ('
      '1106013002=  PERIOD_ VARCHAR(40),'
      '1106013003=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1106013004=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1106013005=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106013006=  ERR_CODE INTEGER,'
      '1106013007=  ERR_MSG VARCHAR(1024))'
      '1106013008=AS'
      
        '1106013009=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST'#39';'
      '1106013010=BEGIN'
      '1106013011=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1106013012=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1106013013='
      
        '1106013014=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1106013015=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1106013016='
      '1106013017=  FOR SELECT SUM(ZD.SUMM)'
      '1106013018=           ,SUM(ZD.DISCOUNT_SUMM)'
      '1106013019=           ,TR.PATH'
      '1106013020=      FROM ZAKAZ Z,'
      '1106013021=           ZAKAZ_DETAILS ZD,'
      '1106013022=           G_PRODUCT GP,'
      '1106013023=           P_REP_TREE TR,'
      '1106013024=           G_CLIENT GC'
      
        '1106013025=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1106013026=       AND Z.IS_SPISANIE IN (0,2)'
      '1106013027=       AND Z.IS_RESERVE = 0'
      '1106013028=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106013029=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1106013030=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106013031=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1106013032=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106013033=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1106013034=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1106013035=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1106013036=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1106013037=            OR'
      
        '1106013038=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1106013039=           )'
      
        '1106013040=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1106013041=             OR'
      '1106013042=             (:G_CATEGORY_ IS NULL)'
      '1106013043=           )'
      '1106013044=     GROUP BY TR.PATH'
      '1106013045=     ORDER BY TR.PATH'
      '1106013046=     INTO :SUMM, :DISCOUNT_SUMM, :TOVAR_NAME'
      '1106013047=  DO suspend;'
      '1106013048='
      '1106013049=WHEN ANY DO BEGIN'
      '1106013050=    Err_code = -20500;'
      
        '1106013051=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      '1106013052=  END'
      '1106013053=end'
      '1106013054=;'
      '1106013055='
      '1106013056=ALTER PROCEDURE P_REP_ZAKAZI_LIST_NAKL('
      '1106013057=  DATE_BEGIN_ DATE,'
      '1106013058=  DATE_END_ DATE,'
      '1106013059=  TIME_BEGIN_ TIME,'
      '1106013060=  TIME_END_ TIME,'
      '1106013061=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106013062=RETURNS ('
      '1106013063=  PERIOD_ VARCHAR(40),'
      '1106013064=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106013065=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106013066=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1106013067=  TOVAR_NAME VARCHAR(1500),'
      '1106013068=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1106013069=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1106013070=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1106013071=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1106013072=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS)'
      '1106013073=AS'
      '1106013074=/*'
      '1106013075='#1054#1058#1063#1045#1058' '#1055#1056#1054#1044#1040#1046' '#1047#1040' '#1055#1045#1056#1048#1054#1044' '#1042' '#1056#1040#1047#1056#1045#1047#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061
      '1106013076=*/'
      '1106013077=BEGIN'
      
        '1106013078=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1106013079=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1106013080='
      '1106013081=  FOR'
      '1106013082=    SELECT T.Z_DATE'
      
        '1106013083=           ,(SELECT * FROM GET_TOVS_BY_date(T.z_date)' +
        ')--GET_TOVS_BY_ZAKAZ(T.ZAKAZ))'
      '1106013084=           ,SUM(T.SUMM)'
      '1106013085=           ,SUM(T.SUMM_FACT)'
      '1106013086=           ,SUM(T.SUMM_CASH)'
      '1106013087=           ,SUM(T.SUMM_NONCASH)'
      '1106013088=           ,SUM(T.summ_bonus)'
      '1106013089=      FROM ZAKAZ T'
      '1106013090=     WHERE T.is_spisanie in (0,2)'
      '1106013091=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106013092=       AND ((T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1106013093=            OR'
      
        '1106013094=            ((T.Z_DATE + T.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1106013095=           )'
      
        '1106013096=       AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||T.G_TOCHKA|' +
        '|'#39'-'#39
      '1106013097=     GROUP BY T.z_date'
      '1106013098=    ORDER BY 1, 3'
      '1106013099=    INTO :Z_DATE'
      '1106013100=         ,:TOVAR_NAME'
      '1106013101=         ,:SUMM'
      '1106013102=         ,:SUM_FACT'
      '1106013103=         ,:summ_cash'
      '1106013104=         ,:SUMM_NONCASH'
      '1106013105=         ,:SUMM_PAY_BONUS'
      '1106013106=  DO'
      '1106013107=    suspend;'
      '1106013108=end'
      '1106013109=;'
      '1106013110='
      '1106013111=ALTER PROCEDURE P_REP_ZAKAZI_LIST_TOVARY('
      '1106013112=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '1106013113=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARE' +
        'NT,'
      '1106013114=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106013115=  DATE_BEGIN_ DATE,'
      '1106013116=  DATE_END_ DATE,'
      '1106013117=  TIME_BEGIN_ TIME,'
      '1106013118=  TIME_END_ TIME,'
      '1106013119=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1106013120=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1106013121=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106013122=RETURNS ('
      '1106013123=  PERIOD_ VARCHAR(40),'
      '1106013124=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1106013125=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1106013126=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1106013127=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1106013128=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1106013129=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106013130=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1106013131=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106013132=  PATH BLOB SUB_TYPE 1,'
      '1106013133=  ROW INTEGER,'
      '1106013134=  ERR_CODE INTEGER,'
      '1106013135=  ERR_MSG VARCHAR(1024))'
      '1106013136=AS'
      
        '1106013137=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI' +
        '_LIST_TOVARY'#39';'
      '1106013138=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106013139=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '1106013140=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE' +
        ' 80;'
      
        '1106013141=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.AR' +
        'TICUL;'
      
        '1106013142=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BA' +
        'RCODE;'
      
        '1106013143=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      
        '1106013144=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      
        '1106013145=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.NAME;'
      
        '1106013146=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT' +
        '.NAME;'
      
        '1106013147=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'PRICE;'
      
        '1106013148=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM = 0;'
      
        '1106013149=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1106013150=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1106013151=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1106013152=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_SUMM = 0;'
      
        '1106013153=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN Z' +
        'AKAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '1106013154=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '1106013155=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH' +
        ';'
      
        '1106013156=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE' +
        '.PATH = '#39#39';'
      '1106013157=DECLARE VARIABLE I INTEGER = 1;'
      '1106013158=BEGIN'
      '1106013159=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '1106013160=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '1106013161='
      
        '1106013162=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1106013163=         lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YE' +
        'AR FROM DATE_END_);'
      '1106013164='
      '1106013165=  FOR SELECT GP.ARTICUL'
      '1106013166=             ,GP.BARCODE'
      '1106013167=             ,GP.NAME'
      '1106013168=             ,SUM(ZD.AMOUNT)'
      '1106013169=             ,MIN(ZD.PRICE)'
      '1106013170=             ,SUM(ZD.SUMM)'
      '1106013171=             ,SUM(ZD.DISCOUNT_SUMM)'
      '1106013172=             ,MIN(TR.PATH)'
      '1106013173=      FROM ZAKAZ Z'
      '1106013174=           ,ZAKAZ_DETAILS ZD'
      '1106013175=           ,G_PRODUCT GP'
      '1106013176=           ,P_REP_TREE TR'
      '1106013177=           ,G_CLIENT GC'
      
        '1106013178=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA|' +
        '|'#39'-'#39
      '1106013179=       AND Z.IS_SPISANIE IN (0,2)'
      '1106013180=       AND Z.IS_RESERVE = 0'
      '1106013181=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1106013182=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '1106013183=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '1106013184=       AND Z.G_CLIENT = GC.G_CLIENT'
      '1106013185=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '1106013186=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE' +
        '(Z.G_CLIENT, 1))'
      
        '1106013187=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, GC.G_CLIENT_PARENT)'
      
        '1106013188=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OF' +
        'FICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '1106013189=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_ AND :TIME_BEGIN_ IS NULL)'
      '1106013190=            OR'
      
        '1106013191=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEG' +
        'IN_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGI' +
        'N_ IS NOT NULL)'
      '1106013192=           )'
      
        '1106013193=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '1106013194=             OR'
      '1106013195=             (:G_CATEGORY_ IS NULL)'
      '1106013196=           )'
      
        '1106013197=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT' +
        '||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1106013198=             OR'
      '1106013199=            (:G_PRODUCT_ IS NULL)'
      '1106013200=           )'
      '1106013201=     GROUP BY GP.articul, GP.barcode, GP.NAME'
      '1106013202=     ORDER BY MIN(TR.PATH), GP.NAME'
      
        '1106013203=     INTO :ARTICUL, :BARCODE, :TOVAR_NAME, :AMOUNT, :' +
        'PRICE, :SUMM, :DISCOUNT_SUMM, :PATH'
      '1106013204=  DO /*BEGIN'
      '1106013205=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '1106013206=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '1106013207=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106013208=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, ' +
        '"DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '1106013209=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL' +
        '_, :DISCOUNT_SUMM_ROLL_, 1);'
      '1106013210='
      '1106013211=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1106013212=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1106013213=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ +' +
        ' DISCOUNT_SUMM_ROLL_;'
      '1106013214=            SUMM_ROLL_ = 0;'
      '1106013215=            DISCOUNT_SUMM_ROLL_ = 0;'
      '1106013216=            I = I + 1;'
      '1106013217=        END'
      '1106013218='
      '1106013219=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106013220=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DAT' +
        'E", ROW)'
      '1106013221=        VALUES (:I, :PATH_, 1);'
      '1106013222=        I = I + 1;'
      '1106013223=    END'
      '1106013224='
      
        '1106013225=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", ' +
        'ARTICUL, BARCODE, NAME, AMOUNT, PRICE, SUMM,'
      
        '1106013226=                                         DISCOUNT_SUM' +
        'M, ROW)'
      
        '1106013227=    VALUES (:I, :Z_DATE_, :ARTICUL_, :BARCODE_, :TOVA' +
        'R_NAME_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_SUMM_,'
      '1106013228=            0);'
      '1106013229='
      '1106013230=    I = I + 1;'
      '1106013231=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '1106013232=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCO' +
        'UNT_SUMM_;'
      '1106013233=    LAST_PATH_ = PATH_;'
      '1106013234=  END'
      '1106013235='
      '1106013236=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '1106013237=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1106013238=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOU' +
        'NT_SUMM_ROLL_, 1);'
      '1106013239='
      '1106013240=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '1106013241=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '1106013242=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_' +
        'SUMM_ROLL_;'
      '1106013243='
      
        '1106013244=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1106013245=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1106013246='
      
        '1106013247=  FOR SELECT "DATE", ARTICUL, BARCODE, NAME, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_SUMM, ROW'
      '1106013248=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1106013249=      INTO :Z_DATE, :ARTICUL, :BARCODE, :TOVAR_NAME, ' +
        ':AMOUNT, :PRICE, :SUMM, :DISCOUNT_SUMM, :ROW'
      '1106013250=  do */suspend;'
      '1106013251='
      '1106013252=WHEN ANY DO BEGIN'
      '1106013253=    Err_code = -20500;'
      
        '1106013254=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1106013255=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106013256=  END'
      '1106013257=end'
      '1106013258=;'
      '1106013259='
      '1106013260=ALTER PROCEDURE P_REP_ZATRATY('
      '1106013261=  DATE_BEGIN_ DATE,'
      '1106013262=  DATE_END_ DATE,'
      '1106013263=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1106013264=RETURNS ('
      '1106013265=  PERIOD_ VARCHAR(40),'
      '1106013266=  NAME TYPE OF COLUMN G_PRIHOD_RASHOD.NAME,'
      '1106013267=  SUMM TYPE OF COLUMN KASSA.SUMM,'
      '1106013268=  NOTE TYPE OF COLUMN KASSA.NOTE,'
      '1106013269=  ACTION_DATE TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1106013270=  KASSA TYPE OF COLUMN KASSA.KASSA,'
      '1106013271=  ERR_CODE INTEGER,'
      '1106013272=  ERR_MSG VARCHAR(1024))'
      '1106013273=AS'
      
        '1106013274=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZATRAT' +
        'Y'#39';'
      '1106013275=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106013276=BEGIN'
      '1106013277='
      
        '1106013278=  PERIOD_ = '#39#1047#1072' '#1087#1077#1088#1080#1086#1076' '#1089' '#39'||lpad(EXTRACT(DAY FROM DAT' +
        'E_BEGIN_), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_BEGIN_), 2' +
        ', 0)||'#39'.'#39'||EXTRACT(YEAR FROM DATE_BEGIN_)||'#39' '#1087#1086' '#39'||'
      
        '1106013279=               lpad(EXTRACT(DAY FROM DATE_END_), 2, '#39 +
        '0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM DATE_END_), 2, '#39'0'#39')||'#39'.'#39'||EXTR' +
        'ACT(YEAR FROM DATE_END_);'
      
        '1106013280=  FOR SELECT G.NAME, K.SUMM, K.NOTE, K.ACTION_DATE, K' +
        '.KASSA'
      '1106013281=        FROM KASSA K,'
      '1106013282=             G_PRIHOD_RASHOD G'
      
        '1106013283=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||k.G_TOCH' +
        'KA||'#39'-'#39
      
        '1106013284=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1106013285=         AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '1106013286=         AND K."ACTION" = 1'
      '1106013287=         AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1106013288=        UNION ALL'
      
        '1106013289=      SELECT G.NAME, K.SUMM, K.NOTE, K.ACTION_DATE, K' +
        '.KASSA_BEZNAL KASSA'
      '1106013290=        FROM KASSA_BEZNAL K,'
      '1106013291=             G_PRIHOD_RASHOD G'
      
        '1106013292=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||k.G_TOCH' +
        'KA||'#39'-'#39
      
        '1106013293=         AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      '1106013294=         AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '1106013295=         AND K."ACTION" = 1'
      '1106013296=         AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1106013297=        ORDER BY 4, 1, 5'
      '1106013298=    INTO :NAME, :SUMM, :NOTE, :ACTION_DATE, :KASSA'
      '1106013299=  DO'
      '1106013300=    SUSPEND;'
      '1106013301='
      '1106013302=WHEN ANY DO BEGIN'
      '1106013303=    Err_code = -20500;'
      
        '1106013304=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1106013305=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1106013306=  END'
      '1106013307=end'
      '1106013308=;'
      '1106013309='
      '1106013310=ALTER PROCEDURE PARSE_FROM_ARRAY('
      '1106013311=  STR_ VARCHAR(500))'
      '1106013312=RETURNS ('
      '1106013313=  PAYMENT_ID_ TYPE OF COLUMN KASSA.KASSA,'
      '1106013314=  PAYMENT_DATE_ TYPE OF COLUMN KASSA.ACTION_DATE,'
      '1106013315=  PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SUMM,'
      
        '1106013316=  PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYME' +
        'NT_TYPE)'
      '1106013317=AS'
      '1106013318=DECLARE VARIABLE STR1_ VARCHAR(50);'
      '1106013319=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1106013320=DECLARE VARIABLE POS_TIRE_ INTEGER;'
      '1106013321=BEGIN'
      '1106013322=    POS_TIRE_  = POSITION('#39'-'#39' IN STR_);'
      
        '1106013323=    STR1_      = SUBSTRING(STR_ FROM 1 FOR POS_TIRE_ ' +
        '- 1);'
      '1106013324=    if (STR1_ <> '#39#39' AND STR1_ IS NOT NULL) then'
      '1106013325=      PAYMENT_ID_    = CAST(STR1_ AS BIGINT);'
      '1106013326=    ELSE'
      '1106013327=      PAYMENT_ID_    = 0;'
      '1106013328='
      
        '1106013329=    STR_ = SUBSTRING(STR_ FROM POS_TIRE_ + 1 FOR CHAR' +
        '_LENGTH(STR_));'
      '1106013330=    POS_TIRE_  = POSITION('#39'-'#39' IN STR_);'
      
        '1106013331=    STR1_      = SUBSTRING(STR_ FROM 1 FOR POS_TIRE_ ' +
        '- 1);'
      '1106013332=    if (STR1_ <> '#39#39' AND STR1_ IS NOT NULL) then'
      '1106013333=      PAYMENT_DATE_    = CAST(STR1_ AS DATE);'
      '1106013334=    ELSE'
      '1106013335=      PAYMENT_DATE_    = NULL;'
      '1106013336='
      
        '1106013337=    STR_ = SUBSTRING(STR_ FROM POS_TIRE_ + 1 FOR CHAR' +
        '_LENGTH(STR_));'
      '1106013338=    POS_TIRE_  = POSITION('#39'-'#39' IN STR_);'
      
        '1106013339=    STR1_      = SUBSTRING(STR_ FROM 1 FOR POS_TIRE_ ' +
        '- 1);'
      '1106013340=    if (STR1_ <> '#39#39' AND STR1_ IS NOT NULL) then'
      
        '1106013341=      PAYMENT_SUMM_    = CAST(STR1_ AS NUMERIC(15,2))' +
        ';'
      '1106013342=    ELSE'
      '1106013343=      PAYMENT_SUMM_    = NULL;'
      '1106013344='
      
        '1106013345=    STR_ = SUBSTRING(STR_ FROM POS_TIRE_ + 1 FOR CHAR' +
        '_LENGTH(STR_) - 1);     -- '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1050#1054#1051#1054#1053#1050#1040', '#1053#1045#1058' '#1053#1059#1046#1044#1067' '#1058#1059#1058' ' +
        #1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1055#1054#1047#1048#1062#1048#1070' '#1058#1048#1056#1045
      '1106013346=    if (STR_ <> '#39#39' AND STR_ IS NOT NULL) then'
      '1106013347=      PAYMENT_TYPE_    = CAST(STR_ AS BIGINT);'
      '1106013348=    ELSE'
      '1106013349=      PAYMENT_TYPE_    = NULL;'
      '1106013350=END'
      '1106013351=;'
      '1106013352='
      '1106013353=ALTER PROCEDURE PARSE_TO_ARRAY('
      '1106013354=  ID_ DM_BIGINT,'
      '1106013355=  SKLAD_OR_ZAKAZ_ INTEGER)'
      '1106013356=RETURNS ('
      '1106013357=  STR_ BLOB SUB_TYPE 1)'
      '1106013358=AS'
      '1106013359=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '1106013360=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1106013361=DECLARE VARIABLE DATE_ TYPE OF COLUMN KASSA.ACTION_DA' +
        'TE;'
      
        '1106013362=DECLARE VARIABLE PAYMENT_ TYPE OF COLUMN G_PAYMENT_TY' +
        'PE.G_PAYMENT_TYPE;'
      '1106013363=BEGIN'
      '1106013364=    STR_ = '#39#39';'
      '1106013365=    FOR SELECT K.KASSA,'
      '1106013366=               K.SUMM,'
      '1106013367=               K.ACTION_DATE,'
      '1106013368=               1              -- '#1058#1048#1055' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1040#1051#1048#1063#1053#1067#1049
      '1106013369=          FROM KASSA K'
      
        '1106013370=         WHERE ((K.SKLAD = :ID_ AND :SKLAD_OR_ZAKAZ_ ' +
        '= 0) OR (K.ZAKAZ = :ID_ AND :SKLAD_OR_ZAKAZ_ = 1))'
      '1106013371=           AND K.g_prihod_rashod IN (1,2,3)'
      '1106013372=         UNION ALL'
      '1106013373=        SELECT K.KASSA_BEZNAL KASSA,'
      '1106013374=               K.SUMM,'
      '1106013375=               K.ACTION_DATE,'
      
        '1106013376=               2              -- '#1058#1048#1055' '#1056#1040#1057#1063#1045#1058#1040' '#1041#1045#1047#1051#1048#1063#1053#1067 +
        #1049
      '1106013377=          FROM KASSA_BEZNAL K'
      
        '1106013378=         WHERE ((K.SKLAD = :ID_ AND :SKLAD_OR_ZAKAZ_ ' +
        '= 0) OR (K.ZAKAZ = :ID_ AND :SKLAD_OR_ZAKAZ_ = 1))'
      '1106013379=           AND K.g_prihod_rashod IN (1,2,3)'
      '1106013380=         ORDER BY 3'
      '1106013381=          INTO :KASSA_,'
      '1106013382=               :SUMM_,'
      '1106013383=               :DATE_,'
      '1106013384=               :PAYMENT_'
      '1106013385=    DO BEGIN'
      
        '1106013386=        STR_ = STR_ || KASSA_ || '#39'-'#39' || LPAD(CAST(EXT' +
        'RACT(DAY FROM DATE_) AS VARCHAR(10)), 2, '#39'0'#39') ||'#39'.'#39'||'
      
        '1106013387=                LPAD(CAST(EXTRACT(MONTH FROM DATE_) A' +
        'S VARCHAR(10)), 2, '#39'0'#39') ||'#39'.'#39'|| EXTRACT(YEAR FROM DATE_) ||'
      
        '1106013388=                '#39'-'#39' || REPLACE(CAST(SUMM_ AS VARCHAR(' +
        '50)), '#39','#39', '#39'.'#39') || '#39'-'#39' || PAYMENT_ || '#39'~'#39';'
      '1106013389=    END'
      '1106013390=END'
      '1106013391=;'
      '1106013392='
      '1106013393=ALTER PROCEDURE PROCEDURE_UPDATE1('
      '1106013394=  ARR_ BLOB SUB_TYPE 1)'
      '1106013395=AS'
      
        '1106013396=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1056#1045#1044#1053#1040#1047#1053#1040#1063#1045#1053#1040' '#1044#1051#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' '#1062#1045#1053' '#1055#1056#1048' '#1055#1056#1048#1061#1054 +
        #1044#1045' '#1058#1054#1042#1040#1056#1040'.'
      
        '1106013397='#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1042#1067#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1054#1063#1050#1059' '#1048' '#1056#1040#1057#1057#1063#1048#1058#1040#1058#1068' '#1053#1054#1042#1059#1070' '#1062#1045#1053 +
        #1059' '#1055#1054' '#1058#1054#1042#1040#1056#1059'.'
      
        '1106013398='#1057#1070#1044#1040' '#1052#1040#1057#1057#1048#1042' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042' '#1042#1048#1044#1045' '#1057#1058#1056#1054#1050#1048' 1-500+300~3-1000' +
        '+700~21-1500+1200, '#1069#1058#1054' '#1058#1054#1042#1040#1056'-'#1062#1045#1053#1040'+'#1054#1055#1058#1062#1045#1053#1040'~'#1058#1054#1042#1040#1056'-'#1062#1045#1053#1040'+'#1054#1055#1058#1062#1045#1053#1040'~*/'
      
        '1106013399=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'UPDATE_GPROD' +
        'UCT_PRICE'#39';'
      '1106013400=DECLARE VARIABLE STR_ VARCHAR(100);'
      '1106013401=DECLARE VARIABLE STR1_ VARCHAR(100);'
      '1106013402=DECLARE VARIABLE STR2_ VARCHAR(100);'
      '1106013403=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '1106013404=DECLARE VARIABLE POS_TIRE_ INTEGER;'
      '1106013405=DECLARE VARIABLE POS_PLUS_ INTEGER;'
      '1106013406=DECLARE VARIABLE P_ INTEGER;'
      
        '1106013407=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      '1106013408=DECLARE VARIABLE PRICE_ MY_NUMERIC;'
      '1106013409=DECLARE VARIABLE PRICE_OPT_ MY_NUMERIC;'
      '1106013410=BEGIN'
      '1106013411=  WHILE (CHAR_LENGTH(ARR_) > 0) DO BEGIN'
      '1106013412=    PRICE_     = 0 ;'
      '1106013413=    PRICE_OPT_ = 0 ;'
      '1106013414='
      '1106013415=    POS_TILDA_ = POSITION('#39'~'#39' IN ARR_);'
      '1106013416=    if (CHAR_LENGTH(ARR_) <> POS_TILDA_) then'
      
        '1106013417=      STR_ = SUBSTRING(ARR_ FROM 1 FOR POS_TILDA_ - 1' +
        ');'
      '1106013418=    ELSE'
      
        '1106013419=      STR_ = SUBSTRING(ARR_ FROM 1 FOR CHAR_LENGTH(AR' +
        'R_) - 1);'
      '1106013420='
      '1106013421=    POS_TIRE_  = POSITION('#39'-'#39' IN STR_);'
      '1106013422='
      
        '1106013423=    G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 FOR POS_T' +
        'IRE_ - 1) AS INTEGER);'
      '1106013424='
      '1106013425=    POS_PLUS_  = POSITION('#39'+'#39' IN STR_);'
      
        '1106013426=    STR1_      = SUBSTRING(STR_ FROM (POS_TIRE_ + 1) ' +
        'FOR POS_PLUS_ - POS_TIRE_ - 1);'
      '1106013427=    if (STR1_ <> '#39#39' AND STR1_ IS NOT NULL) then'
      '1106013428=      PRICE_    = CAST(STR1_ AS NUMERIC(15,2));'
      '1106013429=    ELSE'
      '1106013430=      PRICE_    = 0;'
      '1106013431='
      
        '1106013432=    STR2_      = SUBSTRING(STR_ FROM (POSITION('#39'+'#39' IN' +
        ' STR_) + 1));'
      '1106013433=    if (STR2_ <> '#39#39' AND STR2_ IS NOT NULL) then'
      '1106013434=      PRICE_OPT_ = CAST(STR2_ AS NUMERIC(15,2));'
      '1106013435=    ELSE'
      '1106013436=      PRICE_OPT_ = 0;'
      '1106013437='
      '1106013438=    UPDATE G_PRODUCT T'
      
        '1106013439=       SET T.PRICE        = DECODE(:PRICE_, 0, T.PRIC' +
        'E, :PRICE_),'
      
        '1106013440=           T.VOLUME_PRICE = DECODE(:PRICE_OPT_, 0, T.' +
        'VOLUME_PRICE, :PRICE_OPT_)'
      '1106013441=     WHERE T.G_PRODUCT = :G_PRODUCT_;'
      '1106013442='
      
        '1106013443=    ARR_       = SUBSTRING(ARR_ FROM (POSITION('#39'~'#39' IN' +
        ' ARR_) + 1));'
      '1106013444=  END'
      '1106013445=END'
      '1106013446=;'
      '1106013447='
      '1106013448=ALTER PROCEDURE R_FILL_REVISION('
      '1106013449=  G_PRODUCT_PAR_ BLOB SUB_TYPE 1,'
      '1106013450=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '1106013451=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1106013452=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1106013453=  TYPE_ INTEGER)'
      '1106013454=RETURNS ('
      '1106013455=  ERR_CODE INTEGER,'
      '1106013456=  ERR_MSG VARCHAR(1024))'
      '1106013457=AS'
      
        '1106013458=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT;'
      
        '1106013459=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN LT_SKLAD_' +
        'PRODUCT.G_PRODUCT;'
      '1106013460=DECLARE VARIABLE I INTEGER = 1;'
      '1106013461=BEGIN'
      '1106013462='
      '1106013463=  DELETE FROM REVISION WHERE REVISION = REVISION;'
      '1106013464='
      '1106013465=  IF (G_TOCHKA_ IS NULL) THEN'
      '1106013466=    SELECT ID'
      '1106013467=      FROM CUR_PARAMS'
      '1106013468=     WHERE CUR_PARAMS = 2'
      '1106013469=      INTO :G_TOCHKA_;'
      '1106013470='
      '1106013471=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1041#1044
      '1106013472=  IF (COALESCE(SKLAD_, 0) = 0) THEN BEGIN'
      '1106013473=      FOR SELECT G.G_PRODUCT,'
      '1106013474=                 COALESCE(LT.AMOUNT, 0)'
      
        '1106013475=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT ' +
        'G_PRODUCT, AMOUNT'
      
        '1106013476=                                                FROM ' +
        'LT_SKLAD_PRODUCT'
      
        '1106013477=                                               WHERE ' +
        'G_TOCHKA = :G_TOCHKA_) LT ON G.g_product = LT.g_product'
      '1106013478=           WHERE G.IS_ACTIVE = 1'
      '1106013479=             AND G.IS_KIT <> 1'
      
        '1106013480=             AND ((:G_PRODUCT_PAR_ CONTAINING '#39'~'#39'||G.' +
        'G_PRODUCT_PAR||'#39'~'#39' AND :G_PRODUCT_PAR_ IS NOT NULL)'
      '1106013481=                  OR'
      '1106013482=                  (:G_PRODUCT_PAR_ IS NULL)'
      '1106013483=                 )'
      
        '1106013484=             AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||G.G_PR' +
        'ODUCT||'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '1106013485=                  OR'
      '1106013486=                  (:G_PRODUCT_ IS NULL)'
      '1106013487=                 )'
      '1106013488=             AND G.IS_CATEGORY = 0'
      '1106013489=          /*UNION ALL'
      '1106013490=          SELECT G.G_PRODUCT,'
      '1106013491=                 COALESCE(LT.AMOUNT, 0)'
      '1106013492=            FROM G_PRODUCT G,'
      '1106013493=                 LT_SKLAD_PRODUCT LT'
      '1106013494=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      
        '1106013495=             AND G.G_PRODUCT_PAR IN (SELECT GG.G_PROD' +
        'UCT'
      
        '1106013496=                                      FROM G_PRODUCT ' +
        'GG'
      
        '1106013497=                                     WHERE :G_PRODUCT' +
        '_PAR_ CONTAINING '#39'~'#39'||GG.G_PRODUCT_PAR||'#39'~'#39
      
        '1106013498=                                       AND GG.IS_CATE' +
        'GORY = 1'
      
        '1106013499=                                       and gg.G_PRODU' +
        'CT_PAR is not null)'
      '1106013500=             AND G.IS_CATEGORY = 0'
      '1106013501=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) > 0'
      '1106013502=             AND LT.G_TOCHKA = :G_TOCHKA_'
      '1106013503=          UNION ALL'
      '1106013504=          SELECT G.G_PRODUCT,'
      '1106013505=                 COALESCE(LT.AMOUNT, 0)'
      '1106013506=            FROM G_PRODUCT G,'
      '1106013507=                 LT_SKLAD_PRODUCT LT'
      '1106013508=           WHERE G.G_PRODUCT = LT.G_PRODUCT'
      '1106013509=             AND G.IS_CATEGORY = 0'
      '1106013510=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0'
      '1106013511=             AND LT.G_TOCHKA = :G_TOCHKA_'
      
        '1106013512=          /*UNION ALL              '#1061#1059#1049' '#1047#1053#1040#1045#1058' '#1047#1040#1063#1045#1052' '#1041#1067 +
        #1051#1054' '#1053#1059#1046#1053#1054'  11.02.2016'
      '1106013513=          SELECT G.G_PRODUCT,'
      '1106013514=                 COALESCE(LT.AMOUNT, 0)'
      
        '1106013515=            FROM G_PRODUCT G LEFT OUTER JOIN LT_SKLAD' +
        '_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT'
      
        '1106013516=           WHERE G.G_PRODUCT_PAR IN (SELECT GG.G_PROD' +
        'UCT'
      
        '1106013517=                                      FROM G_PRODUCT ' +
        'GG'
      
        '1106013518=                                     WHERE GG.IS_CATE' +
        'GORY = 1'
      
        '1106013519=                                       and gg.G_PRODU' +
        'CT_PAR is not null)'
      '1106013520=             AND G.IS_CATEGORY = 0'
      '1106013521=             AND CHAR_LENGTH(:G_PRODUCT_PAR_) = 0 */'
      '1106013522=          ORDER BY 1'
      '1106013523=          INTO :G_PRODUCT__,'
      '1106013524=               :AMOUNT_BD_'
      '1106013525=      DO BEGIN'
      '1106013526='
      
        '1106013527=        INSERT INTO REVISION (REVISION, SKLAD, G_PROD' +
        'UCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1106013528=        VALUES (:I, NULL, :G_PRODUCT__, :AMOUNT_BD_, ' +
        '0, 0, :G_TOCHKA_);'
      '1106013529='
      '1106013530=        I = I + 1;'
      '1106013531=      END'
      '1106013532='
      '1106013533=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106013534=  END ELSE BEGIN'
      '1106013535=      FOR SELECT SS.G_PRODUCT,'
      '1106013536=                 SS.AMOUNT'
      '1106013537=            FROM SKLAD_PARENT S, SKLAD SS'
      '1106013538=           WHERE S.SKLAD = :SKLAD_'
      '1106013539=             AND S.SKLAD = SS.SKLAD_PARENT'
      
        '1106013540=             AND S.G_TOCHKA = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 2)'
      '1106013541=          ORDER BY 1'
      '1106013542=          INTO :G_PRODUCT__,'
      '1106013543=               :AMOUNT_BD_'
      '1106013544=      DO BEGIN'
      '1106013545='
      
        '1106013546=        INSERT INTO REVISION (REVISION, SKLAD, G_PROD' +
        'UCT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '1106013547=        VALUES (:I, NULL, :G_PRODUCT__, :AMOUNT_BD_, ' +
        '0, 0, :G_TOCHKA_);'
      '1106013548='
      '1106013549=        I = I + 1;'
      '1106013550=      END'
      '1106013551=  END'
      '1106013552=END'
      '1106013553=;'
      '1106013554='
      '1106013555=ALTER PROCEDURE READ_PRODCAT_FOR_REAL_LIST('
      '1106013556=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '1106013557=RETURNS ('
      '1106013558=  SORT_COL INTEGER,'
      '1106013559=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1106013560=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1106013561=  ARTICUL VARCHAR(30),'
      '1106013562=  NOMENCLATUR_NUM VARCHAR(30),'
      '1106013563=  BARCODE VARCHAR(30),'
      '1106013564=  NAME VARCHAR(500),'
      '1106013565=  G_UNIT TYPE OF COLUMN G_UNIT.G_UNIT,'
      '1106013566=  PRICE NUMERIC(15,2),'
      '1106013567=  VOLUME_PRICE NUMERIC(15,2),'
      '1106013568=  IS_CATEGORY INTEGER)'
      '1106013569=AS'
      '1106013570=begin'
      '1106013571=    FOR'
      '1106013572=    SELECT'
      '1106013573=        1 SORT_COL,'
      '1106013574=        T.G_PRODUCT,'
      '1106013575=        T.G_PRODUCT_PAR,'
      '1106013576=        T.ARTICUL,'
      '1106013577=        T.NOMENCLATUR_NUM,'
      '1106013578=        T.BARCODE,'
      '1106013579=        T.NAME,'
      '1106013580=        T.G_UNIT,'
      '1106013581=        T.PRICE,'
      '1106013582=        T.VOLUME_PRICE,'
      '1106013583=        T.IS_CATEGORY'
      '1106013584=    FROM G_PRODUCT T'
      '1106013585=    WHERE T.IS_CATEGORY = 1'
      '1106013586=      AND EXISTS (SELECT 1'
      '1106013587=                    FROM ZAKAZ_REAL_PARENT ZP,'
      '1106013588=                         ZAKAZ_NA_REAL Z,'
      '1106013589=                         G_PRODUCT G'
      
        '1106013590=                   WHERE ZP.G_TOCHKA = (SELECT ID FRO' +
        'M CUR_PARAMS WHERE CUR_PARAMS = 2)'
      '1106013591=                     AND Z.G_PRODUCT = G.G_PRODUCT'
      
        '1106013592=                     AND G.G_PRODUCT_PAR = T.G_PRODUC' +
        'T'
      
        '1106013593=                     AND Z.ZAKAZ_REAL_PARENT = ZP.ZAK' +
        'AZ_REAL_PARENT'
      '1106013594=                     AND ZP.G_CLIENT = :G_CLIENT_'
      
        '1106013595=                     AND Z.IS_PAYED_ALL = 0)   -- '#1058#1054#1051 +
        #1068#1050#1054' '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1045
      '1106013596=    UNION ALL'
      '1106013597=    SELECT'
      '1106013598=        0 SORT_COL,'
      '1106013599=        -1 G_PRODUCT,'
      '1106013600=        NULL G_PRODUCT_PAR,'
      '1106013601=        NULL ARTICUL,'
      '1106013602=        NULL NOMENCLATUR_NUM,'
      '1106013603=        NULL BARCODE,'
      '1106013604=        '#39#1042#1089#1077' '#1090#1086#1074#1072#1088#1099#39' NAME,'
      '1106013605=        NULL G_UNIT,'
      '1106013606=        NULL PRICE,'
      '1106013607=        NULL VOLUME_PRICE,'
      '1106013608=        1 IS_CATEGORY'
      '1106013609=    FROM RDB$DATABASE'
      '1106013610=    ORDER BY 1, 7, 2'
      '1106013611=    INTO'
      '1106013612=        :SORT_COL,'
      '1106013613=        :G_PRODUCT,'
      '1106013614=        :G_PRODUCT_PAR,'
      '1106013615=        :ARTICUL,'
      '1106013616=        :NOMENCLATUR_NUM,'
      '1106013617=        :BARCODE,'
      '1106013618=        :NAME,'
      '1106013619=        :G_UNIT,'
      '1106013620=        :PRICE,'
      '1106013621=        :VOLUME_PRICE,'
      '1106013622=        :IS_CATEGORY'
      '1106013623=  DO'
      '1106013624=    suspend;'
      '1106013625=end'
      '1106013626=;'
      '1106013627='
      '1106013628=ALTER PROCEDURE READ_PRODUCT_FOR_REAL_LIST('
      
        '1106013629=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_P' +
        'AR,'
      '1106013630=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '1106013631=RETURNS ('
      '1106013632=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1106013633=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1106013634=  ARTICUL VARCHAR(30),'
      '1106013635=  NOMENCLATUR_NUM VARCHAR(30),'
      '1106013636=  BARCODE VARCHAR(30),'
      '1106013637=  NAME VARCHAR(500),'
      '1106013638=  G_UNIT VARCHAR(150),'
      '1106013639=  PRICE NUMERIC(15,2),'
      '1106013640=  VOLUME_PRICE NUMERIC(15,2),'
      '1106013641=  PACK_AMOUNT TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
      '1106013642=  MF_COUNTRY TYPE OF COLUMN G_PRODUCT.MF_COUNTRY,'
      '1106013643=  IS_CATEGORY INTEGER,'
      '1106013644=  IS_ACTIVE INTEGER,'
      '1106013645=  AMOUNT TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '1106013646=  SKIDKA_PROC NUMERIC(15,2),'
      '1106013647=  SKIDKA_SUM NUMERIC(15,2),'
      
        '1106013648=  ZAKAZ_NA_REAL TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL,'
      
        '1106013649=  OSNOVANIE TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVANI' +
        'E)'
      '1106013650=AS'
      '1106013651=/*'
      
        '1106013652='#1054#1058#1056#1040#1046#1040#1045#1058' '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1056#1040#1047#1056#1045#1047#1045' '#1050#1040#1058#1045#1043#1054#1056#1048#1048', '#1042' '#1060#1054#1056#1052#1045' ' +
        #1055#1056#1048' '#1054#1055#1051#1040#1058#1045' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' (frmProdazhaTovara)'
      '1106013653=*/'
      '1106013654=BEGIN'
      '1106013655='
      '1106013656=  FOR SELECT'
      '1106013657=        T.G_PRODUCT,'
      '1106013658=        T.G_PRODUCT_PAR,'
      '1106013659=        T.ARTICUL,'
      '1106013660=        T.NOMENCLATUR_NUM,'
      '1106013661=        T.BARCODE,'
      '1106013662=        T.NAME,'
      '1106013663=        GU.NAME AS G_UNIT,'
      
        '1106013664=        T.PRICE, --Z.PRICE + Z.DISCOUNT_TENGE,  -- '#1061#1047 +
        ' '#1047#1040#1063#1045#1052' '#1058#1040#1050' '#1057#1044#1045#1051#1040#1051', 23.05.2016'
      '1106013665=        T.VOLUME_PRICE,'
      '1106013666=        T.PACK_AMOUNT,'
      '1106013667=        T.MF_COUNTRY,'
      '1106013668=        T.IS_CATEGORY,'
      '1106013669=        T.IS_ACTIVE,'
      
        '1106013670=        (Z.AMOUNT_ALL - COALESCE(Z.AMOUNT_PAYED, 0) -' +
        ' COALESCE(Z.AMOUNT_RETURNED, 0)) AMOUNT,'
      '1106013671=        Z.DISCOUNT_PERC,'
      '1106013672=        Z.DISCOUNT_TENGE,'
      '1106013673=        Z.ZAKAZ_NA_REAL,'
      '1106013674=        ZP.OSNOVANIE'
      '1106013675=    FROM G_PRODUCT T,'
      '1106013676=         ZAKAZ_REAL_PARENT ZP,'
      '1106013677=         ZAKAZ_NA_REAL Z,'
      '1106013678=         G_UNIT GU'
      
        '1106013679=    WHERE T.G_PRODUCT_PAR = DECODE(:G_PRODUCT_PAR_, -' +
        '1, T.G_PRODUCT_PAR, :G_PRODUCT_PAR_)  -- '#1042#1067#1058#1040#1057#1050#1048#1042#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067' ' +
        #1048#1051#1048' '#1057#1058#1056#1054#1043#1054' '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      '1106013680=    AND T.IS_CATEGORY = 0'
      '1106013681=    AND T.G_PRODUCT = Z.G_PRODUCT'
      '1106013682=    AND Z.IS_PAYED_ALL = 0   -- '#1058#1054#1051#1068#1050#1054' '#1053#1045#1054#1055#1051#1040#1063#1045#1053#1053#1067#1045
      '1106013683=    AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PARENT'
      '1106013684=    AND ZP.G_CLIENT = :G_CLIENT_'
      
        '1106013685=    AND ZP.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      '1106013686=    AND T.G_UNIT = GU.G_UNIT'
      '1106013687=    ORDER BY T.NAME'
      '1106013688=    INTO'
      '1106013689=        :G_PRODUCT,'
      '1106013690=        :G_PRODUCT_PAR,'
      '1106013691=        :ARTICUL,'
      '1106013692=        :NOMENCLATUR_NUM,'
      '1106013693=        :BARCODE,'
      '1106013694=        :NAME,'
      '1106013695=        :G_UNIT,'
      '1106013696=        :PRICE,'
      '1106013697=        :VOLUME_PRICE,'
      '1106013698=        :PACK_AMOUNT,'
      '1106013699=        :MF_COUNTRY,'
      '1106013700=        :IS_CATEGORY,'
      '1106013701=        :IS_ACTIVE,'
      '1106013702=        :AMOUNT,'
      '1106013703=        :SKIDKA_PROC,'
      '1106013704=        :SKIDKA_SUM,'
      '1106013705=        :ZAKAZ_NA_REAL,'
      '1106013706=        :OSNOVANIE'
      '1106013707=  DO'
      '1106013708=    suspend;'
      '1106013709=end'
      '1106013710=;'
      '1106013711='
      '1106013712=ALTER PROCEDURE READ_UNIVERS_LIST('
      '1106013713=  POPUP_CODE_ VARCHAR(20),'
      '1106013714=  PARAM1_ VARCHAR(20),'
      '1106013715=  PARAM2_ VARCHAR(20))'
      '1106013716=RETURNS ('
      '1106013717=  ID DM_BIGINT,'
      '1106013718=  NAME VARCHAR(250),'
      '1106013719=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1106013720=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE)'
      '1106013721=AS'
      '1106013722=begin'
      '1106013723=  IF (POPUP_CODE_ = '#39'peTovar'#39') THEN'
      '1106013724=    FOR SELECT G_PRODUCT,'
      '1106013725=               NAME,'
      '1106013726=               ARTICUL,'
      '1106013727=               BARCODE'
      '1106013728=          FROM G_PRODUCT G'
      
        '1106013729=         WHERE G.G_PRODUCT_PAR = CAST(:PARAM1_ AS INT' +
        'EGER)'
      '1106013730=           AND G.IS_ACTIVE = 1'
      '1106013731=          INTO :ID,'
      '1106013732=               :NAME,'
      '1106013733=               :ARTICUL,'
      '1106013734=               :BARCODE'
      '1106013735=    DO'
      '1106013736=      SUSPEND;'
      '1106013737=end'
      '1106013738=;'
      '1106013739='
      '1106013740=ALTER PROCEDURE SYNC_DOWNLOAD'
      '1106013741=RETURNS ('
      '1106013742=  ERR_CODE INTEGER,'
      '1106013743=  ERR_MSG VARCHAR(1024),'
      '1106013744=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '1106013745=AS'
      '1106013746=/*'
      '1106013747=*/'
      
        '1106013748=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_DOWNLOA' +
        'D'#39';'
      '1106013749=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106013750=DECLARE VARIABLE SQL_ VARCHAR(30000);'
      '1106013751=DECLARE VARIABLE SQL_UPD_ VARCHAR(30000);'
      '1106013752=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '1106013753=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '1106013754=DECLARE VARIABLE POS_ INTEGER;'
      '1106013755=DECLARE VARIABLE POS1_ INTEGER;'
      '1106013756=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      
        '1106013757=DECLARE VARIABLE CUR_COMP_ID_ TYPE OF COLUMN SYSTEM_S' +
        'ETUP.S_VALUE;'
      
        '1106013758=DECLARE VARIABLE MAIN_COMP_ID_ TYPE OF COLUMN SYSTEM_' +
        'SETUP.S_VALUE;'
      
        '1106013759=DECLARE VARIABLE SYNC_COMPS_ID_ TYPE OF COLUMN SYNC_C' +
        'OMPS.SYNC_COMPS;'
      
        '1106013760=DECLARE VARIABLE SYNC_COMPS_ TYPE OF COLUMN SYNC_COMP' +
        'S.SYNC_COMPS;'
      '1106013761=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      '1106013762=BEGIN'
      '1106013763=  PNT_ = '#39'00'#39';'
      '1106013764=  ERR_MSG = '#39#39';'
      '1106013765=  ERR_BODY = '#39#39';'
      '1106013766='
      '1106013767=  SELECT S_VALUE'
      '1106013768=    FROM SYSTEM_SETUP S'
      '1106013769=   WHERE S.SYSTEM_SETUP = 4'
      '1106013770=    INTO :CUR_COMP_ID_;'
      '1106013771='
      '1106013772=  SELECT S_VALUE'
      '1106013773=    FROM SYSTEM_SETUP S'
      '1106013774=   WHERE S.SYSTEM_SETUP = 5'
      '1106013775=    INTO :MAIN_COMP_ID_;'
      '1106013776='
      '1106013777=  FOR SELECT L.ID,'
      '1106013778=             L.SQLSTMT'
      '1106013779=        FROM LOGS L'
      '1106013780=       WHERE L.USR = '#39'REPLICAT'#39
      '1106013781=         AND L.DAT IS NULL'
      '1106013782=         AND L.IS_TRANSFERED = 0'
      '1106013783=        ORDER BY L.ID'
      '1106013784=        INTO :LOGS_ID_,'
      '1106013785=             :SQL_'
      '1106013786=  DO BEGIN'
      '1106013787=    BEGIN'
      '1106013788=        SQLCODE_ = 0;'
      '1106013789=        EXECUTE STATEMENT SQL_;'
      '1106013790=    WHEN ANY DO'
      '1106013791=        BEGIN'
      '1106013792=            SQLCODE_ = GDSCODE;'
      '1106013793=            IF (ERR_BODY = '#39#39') THEN'
      
        '1106013794=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085 +
        #1080#1081'.'#39';'
      '1106013795=            ERR_BODY = ERR_BODY ||'#39
      '1106013796='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1106013797=        END'
      '1106013798=    END'
      '1106013799='
      
        '1106013800=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1106013801=    UPDATE LOGS L'
      
        '1106013802=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1106013803=           L.ERR_CODE = :SQLCODE_'
      '1106013804=     WHERE L.ID = :LOGS_ID_;'
      '1106013805=  END'
      '1106013806='
      '1106013807=  FOR SELECT L.ID,'
      '1106013808=             L.SQLSTMT,'
      '1106013809=             L.DAT,'
      '1106013810=             L.RR'
      '1106013811=        FROM LOGS L'
      '1106013812=       WHERE L.USR = '#39'REPLICAT'#39
      '1106013813=         AND L.DAT IS NOT NULL'
      '1106013814=         AND L.IS_TRANSFERED = 0'
      '1106013815=        ORDER BY L.ID'
      '1106013816=        INTO :LOGS_ID_,'
      '1106013817=             :SQL_,'
      '1106013818=             :DAT_,'
      '1106013819=             :IDX_'
      '1106013820=  DO BEGIN'
      '1106013821=    POS_ = POSITION('#39'.'#39', SQL_);'
      '1106013822=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '1106013823=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR P' +
        'OS_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_' +
        ' - 1)||'#39' = :DAT_'#39'||'
      
        '1106013824=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ +' +
        ' 1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '1106013825='
      '1106013826=    BEGIN'
      '1106013827=        SQLCODE_ = 0;'
      '1106013828=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '1106013829=    WHEN ANY DO'
      '1106013830=        BEGIN'
      '1106013831=            SQLCODE_ = GDSCODE;'
      '1106013832=            ERR_BODY = ERR_BODY ||'#39
      '1106013833='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '1106013834=        END'
      '1106013835=    END'
      '1106013836='
      
        '1106013837=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045 +
        ' '#1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051 +
        #1054#1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '1106013838='
      '1106013839=    UPDATE LOGS L'
      
        '1106013840=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, ' +
        '-1),'
      '1106013841=           L.ERR_CODE = :SQLCODE_'
      '1106013842=     WHERE L.ID = :LOGS_ID_;'
      '1106013843=  END'
      '1106013844=end'
      '1106013845=;'
      '1106013846='
      '1106013847=ALTER PROCEDURE SYNC_UPLOAD('
      '1106013848=  SYNC_COMPS_ TYPE OF COLUMN SYNC_COMPS.SYNC_COMPS)'
      '1106013849=RETURNS ('
      '1106013850=  ID TYPE OF COLUMN LOGS.ID,'
      '1106013851=  SQLSTMT TYPE OF COLUMN LOGS.SQLSTMT,'
      '1106013852=  USR TYPE OF COLUMN LOGS.USR,'
      '1106013853=  RR TYPE OF COLUMN LOGS.RR,'
      '1106013854=  DAT TYPE OF COLUMN LOGS.DAT)'
      '1106013855=AS'
      '1106013856=/*'
      '1106013857=*/'
      
        '1106013858=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_UPLOAD'#39 +
        ';'
      '1106013859=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106013860=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '1106013861=BEGIN'
      '1106013862=  FOR SELECT ID, SQLSTMT, USR, RR, DAT'
      '1106013863=      FROM LOGS'
      '1106013864=      WHERE IS_TRANSFERED = 0'
      '1106013865=        AND USR <> '#39'REPLICAT'#39
      '1106013866=      INTO :ID, :SQLSTMT, :USR, :RR, :DAT'
      '1106013867=  DO BEGIN'
      '1106013868=    UPDATE LOGS L'
      '1106013869=       SET L.IS_TRANSFERED = 1'
      '1106013870=     WHERE L.ID = :ID;'
      '1106013871='
      '1106013872=    SUSPEND;'
      '1106013873=  END'
      '1106013874=end'
      '1106013875=;'
      '1106013876='
      '1106013877=ALTER PROCEDURE UPD_SKLAD_TMP('
      '1106013878=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1106013879=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '1106013880=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '1106013881=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '1106013882=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1106013883=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1106013884=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '1106013885=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY' +
        ' = 0,'
      
        '1106013886=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY =' +
        ' 0)'
      '1106013887=RETURNS ('
      '1106013888=  ERR_CODE INTEGER,'
      '1106013889=  ERR_MSG VARCHAR(1024))'
      '1106013890=AS'
      '1106013891=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1106013892=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106013893=DECLARE VARIABLE G_PRODUCT_  TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT;'
      
        '1106013894=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1106013895=DECLARE VARIABLE AMOUNT_CUR_SKLAD_ TYPE OF COLUMN SKL' +
        'AD.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' *' +
        '/'
      
        '1106013896=DECLARE VARIABLE SKLAD_PARENT_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SKLAD; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1055#1056#1048#1061#1054#1044#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045 +
        ' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044' */'
      
        '1106013897=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045' */'
      '1106013898=begin'
      '1106013899=  PNT_ = '#39'01'#39';'
      '1106013900=  UPDATE sklad_TMP'
      '1106013901=  SET'
      '1106013902=    AMOUNT = :AMOUNT_,'
      '1106013903=    PRICE = :PRICE_,'
      '1106013904=    SUMM = :SUMM_,'
      '1106013905=    NDS = :NDS_,'
      '1106013906=    NDS_SUMM = :NDS_SUMM_'
      '1106013907=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '1106013908=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '1106013909=  WHERE'
      '1106013910=    sklad = :sklad_'
      '1106013911=  RETURNING'
      '1106013912=    SKLAD_PARENT'
      '1106013913=  INTO'
      '1106013914=    SKLAD_PARENT_;'
      '1106013915='
      
        '1106013916=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054 +
        #1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1053#1054' '#1069#1058#1040' '#1055#1056#1054#1042#1045#1056#1050#1040' '#1053#1059#1046#1053#1040' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058#1057#1071' '#1059 +
        #1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1055#1056#1048#1061#1054#1044', '#1054' '#1063#1045#1052' '#1057#1042#1048#1044#1045#1058#1045#1051#1068#1057#1058#1042#1059#1045#1058' '#1047#1040#1055#1054#1051#1053#1045#1053#1053#1067#1049' SKLAD_P' +
        'ARENT_'
      
        '1106013917=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SK' +
        'LAD_PARENT_, 0) <> 0)) then BEGIN'
      '1106013918=      SELECT L.G_PRODUCT,'
      '1106013919=             L.AMOUNT'
      '1106013920=        FROM SKLAD S,'
      '1106013921=             LT_SKLAD_PRODUCT L'
      '1106013922=       WHERE S.SKLAD = :SKLAD_'
      '1106013923=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '1106013924=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1106013925=        INTO :G_PRODUCT_,'
      '1106013926=             :AMOUNT_CUR_;'
      '1106013927='
      
        '1106013928=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1055#1056#1048#1061#1054#1044', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1106013929=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1055#1056#1048#1061#1054#1044', '#1056#1045 +
        #1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 40, '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068', '#1063#1043#1054#1041#1067' '#1053#1045' '#1059#1064#1051#1054' ' +
        #1042' '#1052#1048#1053#1059#1057
      
        '1106013930=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1045#1057#1051#1048' '#1057#1058#1040#1056#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1041#1054#1051#1068#1064#1045' '#1053#1054#1042#1054#1043#1054' - '#1047#1053#1040#1063#1048#1058' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042 +
        #1040#1056#1040' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1054#1057#1068','
      '1106013931=      -- '#1053#1040#1044#1054' '#1057#1044#1045#1051#1040#1058#1068' '#1063#1058#1054#1041#1067' '#1059#1052#1045#1053#1068#1064#1048#1051#1054#1057#1068' '#1053#1045' '#1042' '#1052#1048#1053#1059#1057
      '1106013932=      SELECT SUM(AMOUNT)'
      '1106013933=        FROM SKLAD T'
      '1106013934=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1106013935=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '1106013936=        INTO :AMOUNT_OLD_;'
      '1106013937='
      '1106013938=      -- '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1054#1041#1065#1045#1052' '#1042' '#1044#1040#1053#1053#1054#1052' '#1055#1056#1048#1061#1054#1044#1045
      '1106013939=      SELECT SUM(AMOUNT)'
      '1106013940=        FROM SKLAD_TMP T'
      '1106013941=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '1106013942=       INTO :AMOUNT_CUR_SKLAD_;'
      '1106013943='
      
        '1106013944=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD' +
        '_) THEN BEGIN'
      
        '1106013945=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_C' +
        'UR_SKLAD_)) < 0) THEN BEGIN'
      '1106013946=            ERR_CODE = -20500;'
      
        '1106013947=            ERR_MSG = '#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086 +
        #1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39'||ASCII_CHAR(10)||'
      
        '1106013948=                      '#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'.'#39';'
      
        '1106013949=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, E' +
        'RR_MSG) RETURNING_VALUES (:ERR_MSG);'
      '1106013950=            ERR_MSG = PROCNAME||ERR_MSG;'
      '1106013951=            EXIT;'
      '1106013952=          END'
      '1106013953=      END'
      '1106013954=  END'
      '1106013955=end'
      '1106013956=;'
      '1106013957='
      '1106013958=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL_REAL('
      '1106013959=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1106013960=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1106013961=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1106013962=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1106013963=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1106013964=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1106013965=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1106013966=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1106013967=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1106013968=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT)'
      '1106013969=RETURNS ('
      '1106013970=  ERR_CODE INTEGER,'
      '1106013971=  ERR_MSG VARCHAR(1024))'
      '1106013972=AS'
      '1106013973=/*'
      
        '1106013974='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'-'#1054#1055#1051#1040#1058#1059' '#1047 +
        #1040' '#1058#1054#1042#1040#1056' '#1053#1040' '#1056#1045#1040#1051
      '1106013975='#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042' '#1060#1054#1056#1052#1045' TOplataTovaraRealNForm'
      '1106013976='
      
        '1106013977=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1040#1055#1044#1045#1049#1058' '#1042#1054#1047#1042#1056#1040#1058#1040' ' +
        #1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1106013978=*/'
      
        '1106013979=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL_REAL'#39';'
      '1106013980=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1106013981=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1106013982=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN Z' +
        'AKAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1106013983=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.ZAKAZ_DETAILS;'
      
        '1106013984=DECLARE VARIABLE Z_G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.G_PRODUCT;'
      
        '1106013985=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '1106013986=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '1106013987=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      '1106013988=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1106013989=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1106013990=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      
        '1106013991=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_TENGE;'
      
        '1106013992=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1106013993=BEGIN'
      
        '1106013994=  --*************************************************' +
        '*************************************************'
      
        '1106013995=  --*************************************************' +
        '*************************************************'
      '1106013996=  --  '#1040#1055#1044#1045#1049#1058' '#1054#1041#1067#1063#1053#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1047#1040' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106013997=  --*************************************************' +
        '*************************************************'
      
        '1106013998=  --*************************************************' +
        '*************************************************'
      '1106013999=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1106014000=      SELECT Z.G_PAYMENT_TYPE'
      '1106014001=        FROM ZAKAZ Z'
      '1106014002=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1106014003=        INTO :G_PAYMENT_TYPE_OLD_;'
      '1106014004='
      '1106014005=      PNT_ = '#39'01a'#39';'
      '1106014006=      UPDATE zakaz'
      '1106014007=      SET'
      '1106014008=       Z_DATE = :Z_DATE_,'
      '1106014009=       Z_TIME = :Z_TIME_,'
      '1106014010=       G_CLIENT = :G_CLIENT_,'
      '1106014011=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1106014012=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1106014013=       NOTE = COALESCE(:NOTE_, NOTE),'
      '1106014014=       SUMM = :SUMM_,'
      '1106014015=       SUMM_FACT = :SUMM_FACT_,'
      
        '1106014016=       SUMM_CASH = DECODE(:G_PAYMENT_TYPE_, 1, :SUMM_' +
        'FACT_, 0),'
      
        '1106014017=       SUMM_NONCASH = DECODE(:G_PAYMENT_TYPE_, 2, :SU' +
        'MM_FACT_, 0)'
      '1106014018=      WHERE'
      '1106014019=        zakaz = :zakaz_;'
      '1106014020='
      '1106014021=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1106014022=      PNT_ = '#39'02a'#39';'
      
        '1106014023=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014024=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014025=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106014026=        EXIT;'
      '1106014027=      END'
      '1106014028='
      '1106014029=      PNT_ = '#39'03a'#39';'
      '1106014030=      DELETE from zakaz_DETAILS z'
      '1106014031=      WHERE z.zakaz = :zakaz_;'
      '1106014032=      FOR SELECT G_PRODUCT,'
      '1106014033=                 AMOUNT,'
      '1106014034=                 SUMM,'
      '1106014035=                 ZAKAZ_NA_REAL,'
      '1106014036=                 ZAKAZ_DETAILS'
      '1106014037=            FROM ZAKAZ_DETAILS_TMP_REAL'
      '1106014038=      INTO :Z_G_PRODUCT_,'
      '1106014039=           :Z_AMOUNT_,'
      '1106014040=           :Z_SUMM_,'
      '1106014041=           :ZAKAZ_NA_REAL_,'
      '1106014042=           :ZAKAZ_DETAILS_'
      '1106014043=      DO BEGIN'
      '1106014044=        PNT_ = '#39'04a'#39';'
      
        '1106014045=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E, DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '1106014046=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMO' +
        'UNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, ' +
        'NDS, NDS_SUMM, COST_PRICE'
      '1106014047=          FROM ZAKAZ_DETAILS_TMP_REAL Z'
      '1106014048=         WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      
        '1106014049=           AND Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;   -' +
        '-'#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1052#1054#1043#1059#1058' '#1055#1054#1042#1058#1054#1056#1071#1058#1068#1057#1071' :ZAKAZ_NA_REAL_, '#1058#1054' '#1045#1057#1058#1068' '#1055#1054' '#1054#1044#1053#1054#1052#1059 +
        ' :ZAKAZ_NA_REAL_ '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' :ZAKAZ_DETAILS_'
      '1106014050='
      '1106014051=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1106014052=        PNT_ = '#39'05a'#39';'
      '1106014053=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1106014054=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :Z_A' +
        'MOUNT_,'
      
        '1106014055=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1106014056=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'ZR.AMOUNT_PAYED + :Z_AMOUNT_, 1, 0)'
      '1106014057=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106014058='
      
        '1106014059=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL, '#1053#1054' '#1058'.'#1050'. ZAKAZ_DETAILS '#1042#1057#1058#1040#1042#1051#1071#1045#1058#1057#1071' '#1057 +
        ' ID ZAKAZ_REAL ('#1042#1067#1064#1045' '#1047#1040#1055#1054#1051#1053#1071#1045#1058#1057#1071' ZAKAZ_DETAILS_TMP),'
      
        '1106014060=        -- '#1058#1054' '#1058#1059#1058' '#1054#1041#1045' '#1050#1054#1051#1054#1053#1050#1048' '#1041#1059#1044#1059#1058' '#1055#1054#1061#1054#1046#1048' '#1044#1056#1059#1043' '#1053#1040' '#1044#1056 +
        #1059#1043#1040
      '1106014061=        PNT_ = '#39'06a'#39';'
      
        '1106014062=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1106014063=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1106014064=      END'
      '1106014065='
      '1106014066=      ----------------------------------------'
      
        '1106014067=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1047#1040#1050#1040#1047#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1106014068=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052
      
        '1106014069=      -- '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055 +
        #1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      '1106014070=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1106014071=      -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048 +
        #1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057 +
        #1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058#1042#1045#1053#1053#1054')'
      
        '1106014072=      -- 2) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1042' '#1050#1040#1057#1057#1045' '#1041#1059#1044#1059#1058' '#1048#1047#1052#1045#1053#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054#1057#1068' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1045#1057#1058#1045#1057#1058 +
        #1042#1045#1053#1053#1054')'
      
        '1106014073=      -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106014074=      -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' ' +
        #1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      '1106014075=      if (G_PAYMENT_TYPE_OLD_ = 1) then'
      '1106014076=          SELECT S.KASSA,'
      '1106014077=                 S.G_TOCHKA'
      '1106014078=            FROM KASSA S'
      '1106014079=           WHERE S.ZAKAZ = :ZAKAZ_'
      
        '1106014080=             AND S.G_PRIHOD_RASHOD = 1     -- '#1055#1056#1054#1044#1040#1046#1040 +
        ' '#1058#1054#1042#1040#1056#1040
      '1106014081=            INTO :KASSA_,'
      '1106014082=                 :G_TOCHKA_;'
      '1106014083=      ELSE'
      '1106014084=          SELECT S.KASSA_BEZNAL,'
      '1106014085=                 S.G_TOCHKA'
      '1106014086=            FROM KASSA_BEZNAL S'
      '1106014087=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1106014088=             AND S.G_PRIHOD_RASHOD = 1'
      '1106014089=            INTO :KASSA_,'
      '1106014090=                 :G_TOCHKA_;'
      '1106014091='
      
        '1106014092=        -- 1) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045 +
        ' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1106014093=        IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) TH' +
        'EN BEGIN'
      '1106014094=          PNT_ = '#39'05'#39';'
      '1106014095=          EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '1106014096=                                        0,     -- ACT' +
        'ION_'
      
        '1106014097=                                        1,     --:G_P' +
        'RIHOD_RASHOD_,'
      '1106014098=                                        :SUMM_FACT_,'
      '1106014099=                                        :Z_DATE_,'
      
        '1106014100=                                        NULL,   --NOT' +
        'E_'
      '1106014101=                                        :ZAKAZ_,'
      '1106014102=                                        NULL,'
      
        '1106014103=                                        :G_PAYMENT_TY' +
        'PE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1106014104=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014105=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1106014106=            EXIT;'
      '1106014107=          END'
      '1106014108='
      
        '1106014109=        -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044 +
        #1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1106014110=        -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044 +
        #1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1106014111=        END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT' +
        '_TYPE_) THEN BEGIN'
      '1106014112=            PNT_ = '#39'07'#39';'
      
        '1106014113=            EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G' +
        '_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014114=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014115=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106014116=              EXIT;'
      '1106014117=            END'
      '1106014118='
      
        '1106014119=            EXECUTE PROCEDURE K_INS_KASSA(0,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1106014120=                                          1,     -- G' +
        '_PRIHOD_RASHOD_'
      
        '1106014121=                                          :SUMM_FACT_' +
        ','
      '1106014122=                                          :Z_DATE_,'
      
        '1106014123=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1106014124=                                          :ZAKAZ_,   ' +
        '--ZAKAZ_'
      '1106014125=                                          NULL,'
      
        '1106014126=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1106014127=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1106014128=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014129=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1106014130=              EXIT;'
      '1106014131=            END'
      '1106014132=        END'
      '1106014133=      ----------------------------------------'
      '1106014134=  END'
      '1106014135=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106014136=  --*************************************************' +
        '*************************************************'
      
        '1106014137=  --*************************************************' +
        '*************************************************'
      '1106014138='
      
        '1106014139=  --*************************************************' +
        '*************************************************'
      
        '1106014140=  --*************************************************' +
        '*************************************************'
      '1106014141=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106014142=  --*************************************************' +
        '*************************************************'
      
        '1106014143=  --*************************************************' +
        '*************************************************'
      '1106014144=  ELSE BEGIN'
      '1106014145=      UPDATE SKLAD_PARENT'
      '1106014146=      SET'
      
        '1106014147=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1106014148=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1106014149=       G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_' +
        'PAYMENT_TYPE),'
      '1106014150=       G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1106014151=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1106014152=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1106014153=       SUMM = :SUMM_,'
      '1106014154=       SUMM_FACT = :SUMM_FACT_'
      '1106014155=      WHERE SKLAD  = :ZAKAZ_'
      '1106014156=      RETURNING G_TOCHKA'
      '1106014157=      INTO :G_TOCHKA_;'
      '1106014158='
      '1106014159=      -- '#1059#1044#1040#1051#1071#1045#1052' '#1042#1057#1045', '#1063#1058#1054' '#1057#1042#1071#1047#1040#1053#1054' '#1057' '#1055#1056#1045#1046#1053#1048#1052#1048' '#1044#1045#1058#1040#1051#1071#1052#1048
      '1106014160=      PNT_ = '#39'02'#39';'
      
        '1106014161=      EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, NUL' +
        'L) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106014162=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1106014163=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1106014164=        EXIT;'
      '1106014165=      END'
      '1106014166='
      '1106014167=      PNT_ = '#39'03'#39';'
      '1106014168=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1106014169=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1106014170=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1106014171=      FOR SELECT T.AMOUNT,'
      '1106014172=                 T.SUMM,'
      '1106014173=                 T.G_PRODUCT,'
      '1106014174=                 T.ZAKAZ_NA_REAL,'
      '1106014175=                 T.ZAKAZ_DETAILS'
      '1106014176=                 ,T.PRICE'
      '1106014177=                 ,T.NDS'
      '1106014178=                 ,T.NDS_SUMM'
      '1106014179=                 ,T.DISCOUNT_TENGE'
      '1106014180=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1106014181=            INTO :Z_AMOUNT_,'
      '1106014182=                 :Z_SUMM_,'
      '1106014183=                 :Z_G_PRODUCT_,'
      '1106014184=                 :ZAKAZ_NA_REAL_,'
      '1106014185=                 :ZAKAZ_DETAILS_'
      '1106014186=                 ,:PRICE_'
      '1106014187=                 ,:NDS_'
      '1106014188=                 ,:NDS_SUMM_'
      '1106014189=                 ,:DISCOUNT_TENGE_'
      '1106014190=      DO BEGIN'
      
        '1106014191=        INSERT INTO SKLAD(SKLAD, G_PRODUCT, DATE_RECE' +
        'IPT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, IS_VOZVRA' +
        'T'
      
        '1106014192=                         ,G_CLIENT, G_PAYMENT_TYPE, O' +
        'SNOVANIE, NOTE, G_TOCHKA)'
      
        '1106014193=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :Z_G_PRODU' +
        'CT_, :Z_DATE_, :Z_AMOUNT_, :PRICE_ - :DISCOUNT_TENGE_, :Z_SUMM_,' +
        ' :NDS_, :NDS_SUMM_, :ZAKAZ_, 2'
      
        '1106014194=                         ,:G_CLIENT_, :G_PAYMENT_TYPE' +
        '_, :OSNOVANIE_, :NOTE_, :G_TOCHKA_);'
      '1106014195='
      
        '1106014196=        UPDATE LT_SKLAD_PRODUCT L       -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1050 +
        #1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1106014197=           SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '1106014198=         WHERE L.G_PRODUCT = :Z_G_PRODUCT_'
      '1106014199=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1106014200='
      
        '1106014201=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1106014202=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1106014203='
      '1106014204=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1106014205=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :Z_AMOUNT_,'
      
        '1106014206=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1106014207=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :Z_AMOUNT_, 1, 0)'
      '1106014208=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1106014209=      END'
      '1106014210=  END'
      '1106014211=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1106014212=  --*************************************************' +
        '*************************************************'
      
        '1106014213=  --*************************************************' +
        '*************************************************'
      '1106014214='
      '1106014215=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1106014216=END'
      '1106014217=;'
      '1106014218='
      '1106014219=ALTER PROCEDURE UPDATE_ZAKAZ_DETAILS_TMP('
      
        '1106014220=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS,'
      '1106014221=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '1106014222=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '1106014223=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '1106014224=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC,'
      
        '1106014225=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE,'
      
        '1106014226=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC,'
      '1106014227=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '1106014228=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1106014229=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '1106014230=RETURNS ('
      '1106014231=  ERR_CODE INTEGER,'
      '1106014232=  ERR_MSG VARCHAR(1024))'
      '1106014233=AS'
      '1106014234=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '1106014235=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL_TMP'#39';'
      '1106014236=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1106014237=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1106014238=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1042' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1106014239=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1050#1054#1058#1054#1056#1054#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1044#1040#1053#1053 +
        #1054#1052' '#1047#1040#1050#1040#1047#1045' */'
      
        '1106014240=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = ' +
        '0; /* '#1063#1058#1054#1041#1067' '#1053#1040#1049#1058#1048' ID '#1047#1040#1050#1040#1047#1040' '#1045#1057#1051#1048' '#1070#1047#1045#1056' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1054#1047#1044#1040#1053#1053#1067#1049' ' +
        #1047#1040#1050#1040#1047' */'
      
        '1106014241=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.AMOUNT = 0; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1046#1045' '#1042' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1054#1052' '#1047#1040#1050#1040 +
        #1047#1045' */'
      
        '1106014242=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '_TMP.Z_TYPE = 0;'
      '1106014243=BEGIN'
      '1106014244='
      
        '1106014245=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1054#1058#1056#1045#1044#1040#1050#1058#1048#1056#1059#1070', '#1040' '#1047#1040#1058#1045#1052' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1040#1053#1040 +
        #1051#1048#1047' '#1055#1054' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1045#1053#1053#1054#1052#1059' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059','
      
        '1106014246=  -- '#1048' '#1057#1056#1040#1042#1053#1048#1042#1040#1058#1068' '#1045#1043#1054' '#1057' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045'. '#1045#1057#1051#1048' '#1063#1058#1054',' +
        ' '#1055#1056#1048' '#1043#1045#1053#1045#1056#1040#1062#1048#1048' '#1054#1064#1048#1041#1050#1048', '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1041#1059#1044#1045#1058' ROLLBACK'
      '1106014247=  PNT_ = '#39'01'#39';'
      '1106014248=  UPDATE ZAKAZ_DETAILS_TMP t'
      '1106014249=     SET t.AMOUNT = :AMOUNT_,'
      '1106014250=        t.PRICE = :PRICE_,'
      '1106014251=        t.SUMM = :SUMM_,'
      '1106014252=        t.DISCOUNT_PERC = :DISCOUNT_PERC_,'
      '1106014253=        t.DISCOUNT_TENGE = :DISCOUNT_TENGE_,'
      '1106014254=        T.DISCOUNT_SUMM = :DISCOUNT_SUMM_,'
      '1106014255=        T.NDS = :NDS_,'
      '1106014256=        T.NDS_SUMM = :NDS_SUMM_'
      '1106014257=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1106014258=  RETURNING'
      '1106014259=    ZAKAZ, Z_TYPE'
      '1106014260=  INTO'
      '1106014261=    :ZAKAZ_, :Z_TYPE_;'
      '1106014262='
      
        '1106014263=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1063#1058#1054#1041#1067' '#1042' '#1048#1058#1054 +
        #1043#1045' '#1042#1057#1045' '#1041#1048#1051#1054#1057#1068', '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1057#1050#1051#1040#1044#1045' >= '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1059' '#1042' '#1047#1040#1050#1040#1047#1045
      '1106014264=  PNT_ = '#39'02'#39';'
      '1106014265=  if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '1106014266=      SELECT L.G_PRODUCT,'
      '1106014267=             L.AMOUNT - L.AMOUNT_RESERVE'
      '1106014268=        FROM ZAKAZ_DETAILS_TMP S,'
      '1106014269=             LT_SKLAD_PRODUCT L'
      '1106014270=       WHERE S.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '1106014271=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '1106014272=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1106014273=        INTO :G_PRODUCT_,'
      '1106014274=             :AMOUNT_CUR_;'
      '1106014275='
      
        '1106014276=      -- '#1042#1054#1047#1053#1048#1050#1051#1040' '#1058#1040#1050#1040#1071' '#1057#1048#1058#1059#1040#1062#1048#1071'. '#1070#1047#1045#1056' '#1061#1054#1063#1045#1058' '#1054#1058#1056#1045#1044#1040#1050#1058 +
        #1048#1056#1054#1042#1040#1058#1068' '#1059#1046#1045' '#1057#1054#1061#1056#1040#1053#1045#1053#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1042' '#1050#1054#1058#1054#1056#1054#1052' '#1041#1067#1051#1054' 150 '#1064#1058' '#1058#1054#1042#1040#1056#1040'.'
      
        '1106014277=      -- '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1065#1040#1057' 90 '#1064#1058'. '#1054#1053' '#1047#1040#1061#1054#1044#1048#1058' '#1042' '#1047#1040#1050#1040#1047', '#1056#1045#1044 +
        #1040#1050#1058#1048#1056#1059#1045#1058' '#1047#1040#1055#1048#1057#1068' '#1057#1054' 150 '#1064#1058' '#1053#1040' 220'
      
        '1106014278=      -- '#1040' '#1055#1054#1058#1054#1052' '#1055#1067#1058#1040#1045#1058#1057#1071' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1053#1054#1042#1059#1070' '#1047#1040#1055#1048#1057#1068' '#1057' '#1050#1054#1051 +
        #1048#1063#1045#1057#1058#1042#1054#1052' 30 '#1064#1058'. '#1042#1057#1045' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1042#1067#1064#1045' '#1053#1045' '#1054#1058#1051#1054#1042#1071#1058', '#1055#1056#1048#1044#1045#1058#1057#1071' '#1047#1044#1045#1057#1068
      
        '1106014279=      -- '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1057#1053#1040#1063#1040#1051#1040' '#1057#1050#1054#1051#1068#1050#1054' '#1042' '#1057#1058#1040#1056#1054#1052' '#1047#1040#1050#1040#1047#1045' '#1041#1067 +
        #1051#1054', '#1047#1040#1058#1045#1052' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1053#1054#1042#1054#1045' '#1047#1053#1040#1063#1045#1053#1048#1045', '#1063#1058#1054#1041#1067' '#1059#1047#1053#1040#1058#1068' '#1042' '#1048#1058#1054#1043#1045', '#1053#1040' '#1057#1050#1054#1051 +
        #1068#1050#1054
      
