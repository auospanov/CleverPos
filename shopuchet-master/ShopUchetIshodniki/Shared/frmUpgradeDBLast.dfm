        'KA)'
      
        '1101321388=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1101321389=      RETURNING ZAKAZ_REAL_PARENT'
      '1101321390=      INTO :ZAKAZ_REAL_PARENT_;'
      '1101321391='
      
        '1101321392=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1101321393=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101321394=          INTO :G_PRODUCT,'
