      '110233610=    SUMM_COST_All_ = SUMM_COST_All_ - SUM_COST_;'
      '110233611=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110233612='
      '110233613=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110233614=    insert into p_rep_profit_table'
      
