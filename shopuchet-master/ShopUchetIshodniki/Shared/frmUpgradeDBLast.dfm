      '1102251841=           AND ZZ.G_CLIENT = :G_CLIENT_'
      
        '1102251842=           AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TO' +
        'CHKA||'#39'-'#39
      '1102251843=           AND K.G_PRIHOD_RASHOD in (1, -5)'
      '1102251844=           AND ZZ.ZAKAZ = I.ZAKAZ'
      
        '1102251845=           AND I.G_FIRM = DECODE(:G_FIRM_IN_, NULL, I' +
