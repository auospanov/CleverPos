      '110185435=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '110185436=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT' +
        ','
      
        '110185437=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TY' +
        'PE */ BIGINT,'
      
        '110185438=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARC' +
        'HAR(150),'
      '110185439=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '110185440=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '110185441=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUME' +
        'RIC(15,2),'
      
        '110185442=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUME' +
        'RIC(15,2),'
      
        '110185443=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH *' +
        '/ NUMERIC(15,2),'
      
        '110185444=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NU' +
        'MERIC(15,2),'
      
        '110185445=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_G' +
        'OT */ NUMERIC(15,2),'
      
        '110185446=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD' +
        '_RASHOD */ BIGINT,'
      
        '110185447=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC' +
        '(15,2),'
      
        '110185448=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ ' +
        'INTEGER,'
      
        '110185449=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTE' +
        'GER,'
      
        '110185450=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ IN' +
        'TEGER,'
      '110185451=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110185452=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '110185453=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110185454=  ADDRESS_ /* TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS */' +
        ' VARCHAR(500) = NULL,'
      
        '110185455=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT = NULL,'
      
        '110185456=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SU' +
        'B_TYPE 1 SEGMENT SIZE 16384 = NULL)'
      '110185457=RETURNS ('
      '110185458=  ERR_CODE INTEGER,'
      '110185459=  ERR_MSG VARCHAR(1024))'
      '110185460=AS'
      '110185461=BEGIN'
      '110185462=  SUSPEND;'
      '110185463=END'
      '110185464=;'
      '110185465='
      '110185466='
      
        '110185467=/*****************************************************' +
        '*************************/'
      
        '110185468=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110185469=/*****************************************************' +
        '*************************/'
      '110185470=ALTER PROCEDURE G_READ_G_CLIENT_LIST('
      
        '110185471=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PA' +
        'RENT,'
      '110185472=  IS_SUPPLIER_ INTEGER = NULL)'
      '110185473=RETURNS ('
      '110185474=  G_CLIENT TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110185475=  G_CLIENT_PARENT TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      
        '110185476=  G_CONTRAGENT TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGEN' +
        'T,'
      '110185477=  NAME VARCHAR(500),'
      '110185478=  RNN VARCHAR(12),'
      '110185479=  IDN VARCHAR(12),'
      '110185480=  KBE VARCHAR(5),'
      '110185481=  PHONE TYPE OF COLUMN G_CLIENT.PHONE,'
      '110185482=  SKIDKA NUMERIC(15,2),'
      '110185483=  IS_SUPPLIER INTEGER,'
      '110185484=  BY_DEFAULT INTEGER,'
      '110185485=  IS_BEZNAL INTEGER,'
      '110185486=  IS_SUPPLIER_STR VARCHAR(50),'
      
        '110185487=  SUPPL_AGENT_NAME TYPE OF COLUMN G_CONTRAGENT.SHORT_N' +
        'AME,'
      
        '110185488=  G_DISCONT_CARD TYPE OF COLUMN G_DISCONT_CARD.G_DISCO' +
        'NT_CARD,'
      '110185489=  BARCODE TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110185490=  N_PERCENT TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110185491=  SUMM TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110185492=  SUMM_ALL TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110185493=  NOTE TYPE OF COLUMN G_CLIENT.NOTE,'
      '110185494=  SUMM_DOLG TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110185495=  NAME_WITH_DOLG VARCHAR(500),'
      '110185496=  G_PROMOTION_STR TYPE OF COLUMN G_PROMOTION.NAME,'
      
        '110185497=  MAX_BONUS_PAY_SUMM TYPE OF COLUMN G_CLIENT.MAX_BONUS' +
        '_PAY_SUMM,'
      '110185498=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS)'
      '110185499=AS'
      '110185500=begin'
      '110185501=  FOR'
      '110185502=    SELECT T.g_client,'
      '110185503=           T.g_client_parent,'
      '110185504=           T.g_contragent,'
      '110185505=           T.name,'
      '110185506=           T.rnn,'
      '110185507=           T.idn,'
      '110185508=           T.KBE,'
      '110185509=           T.PHONE,'
      '110185510=           T.SKIDKA,'
      '110185511=           T.is_supplier,'
      '110185512=           T.BY_DEFAULT,'
      '110185513=           T.IS_BEZNAL,'
      '110185514=           CASE T.is_supplier'
      '110185515=             WHEN 0 THEN '#39#1050#1083#1080#1077#1085#1090#39
      '110185516=             WHEN 1 THEN '#39#1055#1086#1089#1090#1072#1074#1097#1080#1082#39
      '110185517=           END IS_SUPPLIER_STR,'
      '110185518=           GC.SHORT_NAME,'
      '110185519=           COALESCE(D.G_DISCONT_CARD, 0),'
      '110185520=           D.BARCODE,'
      '110185521=           D.N_PERCENT,'
      '110185522=           D.SUMM,'
      '110185523=           D.SUMM_ALL,'
      '110185524=           T.NOTE'
      '110185525=           ,COALESCE(Z.SUMM_DOLG, 0)'
      
        '110185526=           ,T.name || COALESCE('#39' ('#1044#1054#1051#1043' '#39' || Z.SUMM_DOL' +
        'G || '#39')'#39', '#39#39') NAME_WITH_DOLG'
      '110185527=           ,P.NAME NAME_PROMO'
      '110185528=           ,T.MAX_BONUS_PAY_SUMM'
      '110185529=           ,GA.ADDRESS'
      
        '110185530=    FROM g_client t LEFT OUTER JOIN G_DISCONT_CARD D O' +
        'N T.G_CLIENT = D.G_CLIENT'
      
        '110185531=                    LEFT OUTER JOIN (SELECT SUM(SUMM -' +
        ' SUMM_FACT - SUMM_BONUS) SUMM_DOLG ,G_CLIENT FROM ZAKAZ WHERE IS' +
        '_PAYED_ALL = 0 GROUP BY G_CLIENT) Z ON T.G_CLIENT = Z.G_CLIENT'
      
        '110185532=                    LEFT OUTER JOIN G_PROMOTION P ON T' +
        '.g_promotion = P.g_promotion'
      
        '110185533=                    LEFT OUTER JOIN G_ADDRESS GA ON T.' +
        'G_CLIENT = GA.G_CLIENT AND GA.IS_DEFAULT = 1'
      '110185534=         ,G_CONTRAGENT GC'
      
        '110185535=    WHERE T.G_CLIENT_PARENT = COALESCE(:G_CLIENT_PAREN' +
        'T_, T.G_CLIENT_PARENT)  -- '#1048#1053#1054#1043#1044#1040' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      '110185536=     AND T.IS_CATEGORY = 0'
      '110185537=     AND T.G_CONTRAGENT = GC.G_CONTRAGENT'
      
        '110185538=     AND T.is_supplier = COALESCE(:IS_SUPPLIER_, T.IS_' +
        'SUPPLIER)'
      
        '110185539=     AND COALESCE(:G_CLIENT_PARENT_, 0) <> -1000      ' +
        '         -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110185540=   UNION ALL'
      '110185541=    SELECT T.G_TOCHKA g_client,'
      '110185542=           0 g_client_parent,'
      '110185543=           0 g_contragent,'
      '110185544=           T.name,'
      '110185545=           '#39#39' rnn,'
      '110185546=           '#39#39' idn,'
      '110185547=           '#39#39' KBE,'
      '110185548=           '#39#39' PHONE,'
      '110185549=           0 SKIDKA,'
      '110185550=           0 is_supplier,'
      '110185551=           0 BY_DEFAULT,'
      '110185552=           0 IS_BEZNAL,'
      '110185553=           '#39#1057#1082#1083#1072#1076#39' IS_SUPPLIER_STR,'
      '110185554=           '#39#39' SHORT_NAME,'
      '110185555=           0,'
      '110185556=           '#39#39' BARCODE,'
      '110185557=           0 N_PERCENT,'
      '110185558=           0 SUMM,'
      '110185559=           0 SUMM_ALL,'
      '110185560=           '#39#39' NOTE'
      '110185561=           ,0 SUMM_DOLG'
      '110185562=           ,'#39#39' NAME_WITH_DOLG'
      '110185563=           ,'#39#39' NAME_PROMO'
      '110185564=           ,0 MAX_BONUS_PAY_SUMM'
      '110185565=           ,'#39#39' ADDRESS'
      '110185566=    FROM G_TOCHKA T'
      
        '110185567=   WHERE T.G_TOCHKA <> (SELECT ID FROM CUR_PARAMS WHER' +
        'E CUR_PARAMS = 2)'
      
        '110185568=     AND COALESCE(:G_CLIENT_PARENT_, 0) = -1000       ' +
        '        -- '#1069#1058#1054' '#1057#1055#1045#1062#1048#1040#1051#1068#1053#1054' '#1044#1051#1071' '#1056#1045#1046#1048#1052#1040' "'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040'"'
      '110185569=   ORDER BY 4'
      
        '110185570=    into :G_CLIENT, :G_CLIENT_PARENT, :G_CONTRAGENT, :' +
        'NAME, :RNN, :IDN, :KBE, :PHONE, :SKIDKA, :IS_SUPPLIER, :BY_DEFAU' +
        'LT,'
      
        '110185571=         :IS_BEZNAL, :IS_SUPPLIER_STR, :SUPPL_AGENT_NA' +
        'ME,'
      '110185572=         :G_DISCONT_CARD,'
      '110185573=         :BARCODE,'
      '110185574=         :N_PERCENT,'
      '110185575=         :SUMM,'
      '110185576=         :SUMM_ALL, :NOTE'
      '110185577=         ,:SUMM_DOLG'
      '110185578=         ,:NAME_WITH_DOLG'
      '110185579=         ,:G_PROMOTION_STR'
      '110185580=         ,:MAX_BONUS_PAY_SUMM'
      '110185581=         ,:ADDRESS'
      '110185582=  DO'
      '110185583=    suspend;'
      '110185584=end'
      '110185585=;'
      '110185586='
      '110185587=ALTER PROCEDURE GET_ZAKAZ_DETAILS('
      '110185588=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110185589=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0)'
      '110185590=RETURNS ('
      '110185591=  G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110185592=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110185593=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110185594=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110185595=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110185596=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110185597=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110185598=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS,'
      '110185599=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110185600=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110185601=  SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110185602=  SUMM_GOT_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110185603=  IS_PAYED_ALL_ TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110185604=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110185605=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110185606=  CNT_Z_ INTEGER,'
      
        '110185607=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110185608=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110185609=  HAVERIGHT_ INTEGER,'
      '110185610=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110185611=  NOT_MINUS_OSTATOK_ TYPE OF COLUMN SKLAD_PARENT.IS_EX' +
        'PECTED,'
      '110185612=  ERR_CODE INTEGER,'
      '110185613=  ERR_MSG VARCHAR(1024))'
      '110185614=AS'
      '110185615=/*'#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1044#1051#1071' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1059#1046#1045' '#1043#1054#1058#1054#1042#1054#1043#1054' '#1047#1040#1050#1040#1047#1040'*/'
      
        '110185616=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      '110185617=begin'
      '110185618='
      '110185619=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1086#1076#1072#1078', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110185620=  /*CNT_Z_ = 0;'
      '110185621=  SELECT COUNT(*)'
      '110185622=    FROM (SELECT Z.ZAKAZ'
      '110185623=            FROM ZAKAZ Z ROWS 1 TO 100)'
      '110185624=    INTO :CNT_Z_;*/'
      '110185625='
      
        '110185626=  --**************************************************' +
        '**************'
      '110185627=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '110185628=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110185629=      IF (COALESCE(ZAKAZ_,0) <> 0) THEN BEGIN'
      '110185630=          SELECT'
      '110185631=            T.G_TOCHKA,'
      '110185632=            T.Z_DATE,'
      '110185633=            T.Z_TIME,'
      '110185634=            T.G_CLIENT,'
      '110185635=            T.G_PAYMENT_TYPE,'
      '110185636=            T.OSNOVANIE,'
      '110185637=            T.NOTE,'
      '110185638=            T.SUMM,'
      '110185639=            T.SUMM_FACT,'
      '110185640=            T.SUMM_BONUS,'
      '110185641=            T.summ_bonus_got,'
      '110185642=            T.IS_PAYED_ALL,'
      '110185643=            COALESCE(T.BY_RECIPE, 0)'
      '110185644=            ,IS_RESERVE'
      '110185645=            ,NOT_MINUS_OSTATOK'
      '110185646=            ,DELIVERY_ADDRESS'
      '110185647=          FROM ZAKAZ T'
      '110185648=          WHERE T.ZAKAZ = :ZAKAZ_'
      '110185649=          INTO'
      '110185650=            :G_TOCHKA_,'
      '110185651=            :Z_DATE_,'
      '110185652=            :Z_TIME_,'
      '110185653=            :G_CLIENT_,'
      '110185654=            :G_PAYMENT_TYPE_,'
      '110185655=            :OSNOVANIE_,'
      '110185656=            :NOTE_,'
      '110185657=            :SUMM_,'
      '110185658=            :SUMM_FACT_,'
      '110185659=            :SUMM_PAY_BONUS_,'
      '110185660=            :SUMM_GOT_BONUS_,'
      '110185661=            :IS_PAYED_ALL_,'
      '110185662=            :BY_RECIPE_,'
      '110185663=            :IS_RESERVE_,'
      '110185664=            :NOT_MINUS_OSTATOK_,'
      '110185665=            :ADDRESS_;'
      '110185666='
      '110185667=          -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059
      
        '110185668=          INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS,' +
        ' ZAKAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_' +
        'TENGE,'
      
        '110185669=                                        DISCOUNT_SUMM,' +
        ' NDS, NDS_SUMM, COST_PRICE)'
      
        '110185670=            SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AM' +
        'OUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110185671=                   DISCOUNT_SUMM, NDS, NDS_SUMM, COST_' +
        'PRICE'
      '110185672=              FROM ZAKAZ_DETAILS'
      '110185673=             WHERE ZAKAZ = :ZAKAZ_'
      '110185674=             ORDER BY 1;'
      '110185675='
      '110185676=          -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110185677=          SELECT K.G_PRIHOD_RASHOD,'
      '110185678=                 K.SUMM'
      
        '110185679=            FROM (SELECT * FROM KASSA UNION SELECT * F' +
        'ROM KASSA_BEZNAL) K'
      '110185680=           WHERE K.ZAKAZ = :ZAKAZ_'
      '110185681=             AND K.G_PRIHOD_RASHOD NOT IN (1, -5)'
      '110185682=            INTO :G_PRIHOD_,'
      '110185683=                 :SUMM_PRIHOD_;'
      '110185684=      END'
      '110185685='
      
        '110185686=      EXECUTE PROCEDURE PARSE_TO_ARRAY(:ZAKAZ_, 1) RET' +
        'URNING_VALUES :PAYMENTS_;'
      '110185687=  END'
      '110185688=  -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110185689=  --*************************************************'
      '110185690=  --*************************************************'
      '110185691=  -- '#1055#1056#1054#1057#1052#1054#1058#1056' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110185692=  ELSE BEGIN'
      '110185693=    SELECT'
      '110185694=        T.G_CLIENT,'
      '110185695=        T.DATE_RECEIPT,'
      '110185696=        T.TIME_RECEIPT,'
      '110185697=        T.G_TOCHKA,'
      '110185698=        T.G_PAYMENT_TYPE,'
      '110185699=        T.OSNOVANIE,'
      '110185700=        T.NOTE,'
      '110185701=        T.SUMM,'
      '110185702=        T.SUMM_FACT,'
      '110185703=        0,'
      '110185704=        0,'
      '110185705=        0,'
      '110185706=        T.IS_EXPECTED'
      '110185707=      FROM SKLAD_PARENT T'
      '110185708=      WHERE T.SKLAD = :ZAKAZ_'
      '110185709=      INTO'
      '110185710=        :G_TOCHKA_,'
      '110185711=        :Z_DATE_,'
      '110185712=        :Z_TIME_,'
      '110185713=        :G_CLIENT_,'
      '110185714=        :G_PAYMENT_TYPE_,'
      '110185715=        :OSNOVANIE_,'
      '110185716=        :NOTE_,'
      '110185717=        :SUMM_,'
      '110185718=        :SUMM_FACT_,'
      '110185719=        :SUMM_PAY_BONUS_,'
      '110185720=        :IS_PAYED_ALL_,'
      '110185721=        :BY_RECIPE_,'
      '110185722=        :NOT_MINUS_OSTATOK_;'
      '110185723='
      '110185724=      -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110185725=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '110185726=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE, Z_TYPE)'
      
        '110185727=      SELECT SKLAD, :ZAKAZ_, G_PRODUCT, AMOUNT, PRICE,' +
        ' SUMM, 0, 0, 0, NDS, NDS_SUMM, PRICE, 3    -- '#1069#1058#1054' '#1047#1053#1040#1063#1048#1058', '#1063#1058#1054' '#1047#1040 +
        #1055#1054#1051#1053#1045#1053#1040' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1058#1056#1040#1053#1057#1060#1045#1056#1040' '#1058#1054#1042#1040#1056#1054#1042
      '110185728=        FROM SKLAD'
      '110185729=       WHERE SKLAD_PARENT = :ZAKAZ_'
      '110185730=      ORDER BY 1;'
      '110185731=  END'
      '110185732='
      
        '110185733=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110185734=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110185735=  HaveRight_ = 1;'
      '110185736=  IF (Z_DATE_ < CURRENT_DATE) THEN BEGIN'
      '110185737=    SELECT ID'
      '110185738=      FROM CUR_PARAMS'
      '110185739=     WHERE CUR_PARAMS = 1'
      '110185740=      INTO :G_OFFICIAL_CUR_;'
      '110185741='
      
        '110185742=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110185743=      HaveRight_ = 1;'
      '110185744=    else'
      
        '110185745=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110185746='
      '110185747=    /* '#1040#1053#1040#1051#1048#1047' '#1041#1059#1044#1059' '#1055#1056#1054#1042#1054#1044#1048#1058#1068' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045
      '110185748=    if (HaveRight_ = 0) then begin'
      
        '110185749=      ERR_CODE = -20500; // '#1053#1077' '#1076#1086#1089#1090#1072#1090#1086#1095#1085#1086' '#1087#1088#1072#1074' '#1076#1083#1103' '#1074#1099#1087 +
        #1086#1083#1085#1077#1085#1080#1103' '#1086#1087#1077#1088#1072#1094#1080#1080
      
        '110185750=      EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' '#1085#1077' '#1086 +
        #1073#1083#1072#1076#1072#1077#1090#1077' '#1087#1088#1072#1074#1086#1084' '#1076#1083#1103' '#1088#1077#1076#1072#1082#1090#1080#1088#1086#1074#1072#1085#1080#1103' '#1085#1072#1082#1083#1072#1076#1085#1099#1093#39'||ascii_char(10)||'#39 +
        #1079#1072' '#1087#1088#1086#1096#1083#1099#1077' '#1076#1072#1090#1099'.'#39') RETURNING_VALUES(:ERR_MSG);'
      '110185751=      EXIT;'
      '110185752=    end*/'
      '110185753=  END'
      '110185754=end'
      '110185755=;'
      '110185756='
      '110185757=ALTER PROCEDURE INS_ZAKAZ('
      '110185758=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110185759=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110185760=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110185761=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110185762=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110185763=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110185764=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110185765=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110185766=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110185767=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110185768=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110185769=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110185770=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110185771=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110185772=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110185773=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110185774=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110185775=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110185776=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110185777=  IS_MEBEL_ INTEGER = 0,'
      
        '110185778=  DOSTAVSHIK_ TYPE OF COLUMN DELIVERY.DOSTAVSHIK = NUL' +
        'L,'
      
        '110185779=  DELIVERY_DATE_ TYPE OF COLUMN DELIVERY.DELIVERY_DATE' +
        ' = NULL,'
      
        '110185780=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NUL' +
        'L,'
      '110185781=  PRICE_ TYPE OF COLUMN DELIVERY.PRICE = NULL,'
      '110185782=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110185783=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110185784=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110185785=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110185786=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '110185787=RETURNS ('
      '110185788=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110185789=  ERR_CODE INTEGER,'
      '110185790=  ERR_MSG VARCHAR(1024))'
      '110185791=AS'
      '110185792=/*'
      '110185793=IS_SPISANIE_'
      '110185794=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110185795=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110185796=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110185797=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110185798='
      '110185799='
      
        '110185800=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059 +
        ', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057
      '110185801=*/'
      '110185802=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'INS_ZAKAZ'#39';'
      '110185803=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110185804=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110185805=DECLARE VARIABLE G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '110185806=DECLARE VARIABLE AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '110185807=DECLARE VARIABLE PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '110185808=DECLARE VARIABLE SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M;'
      
        '110185809=DECLARE VARIABLE DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_PERC;'
      
        '110185810=DECLARE VARIABLE DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '110185811=DECLARE VARIABLE DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM;'
      '110185812=DECLARE VARIABLE NDS TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '110185813=DECLARE VARIABLE NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.NDS_SUMM;'
      
        '110185814=DECLARE VARIABLE COST_PRICE TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.COST_PRICE;'
      
        '110185815=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110185816=DECLARE VARIABLE ZAKAZ_DETAILS_TMP_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS_TMP.ZAKAZ_DETAILS;'
      '110185817=DECLARE VARIABLE CNT_ INTEGER;'
      '110185818=DECLARE VARIABLE IS_THIS_LAST_ INTEGER = 0;'
      
        '110185819=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110185820=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110185821=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110185822=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110185823=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110185824=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110185825=DECLARE VARIABLE SALES_COMM_ TYPE OF COLUMN G_PRODUCT.' +
        'SALES_COMM;'
      
        '110185826=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_O' +
        'FFICIAL.DO_NOT_SALES_COMM;'
      
        '110185827=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FM;'
      
        '110185828=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLUM' +
        'N SYSTEM_SETUP.S_VALUE;'
      
        '110185829=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN ' +
        'G_PRODUCT.SALES_COMM = 0;'
      
        '110185830=DECLARE VARIABLE SALES_COMM_SUMM_ALL_ TYPE OF COLUMN G' +
        '_PRODUCT.SALES_COMM = 0;'
      
        '110185831=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA.' +
        'ACTION_DATE;'
      
        '110185832=DECLARE VARIABLE NEW_SKIDKA_VAL_ TYPE OF COLUMN G_CLIE' +
        'NT.SKIDKA;'
      
        '110185833=DECLARE VARIABLE NEW_BONUS_VAL_ TYPE OF COLUMN G_DISCO' +
        'NT_CARD.N_PERCENT;'
      
        '110185834=DECLARE VARIABLE CLIENT_SUMM_ALL_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM_ALL;'
      
        '110185835=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.MARK_CODE;'
      '110185836=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '110185837=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN L' +
        'OG_OPER.OPERATION;'
      
        '110185838=DECLARE VARIABLE KASSA_ZP_ID_ TYPE OF COLUMN KASSA.KAS' +
        'SA;'
      '110185839=BEGIN'
      '110185840='
      
        '110185841=  -- '#1058#1040#1041#1051#1048#1062#1040' ZAKAZ_DETAILS_TMP '#1059' '#1052#1045#1053#1071' '#1054#1044#1053#1040' '#1053#1040' '#1042#1057#1070' '#1057#1045#1057#1057 +
        #1048#1070', '#1048' '#1055#1054#1058#1054#1052#1059', '#1042#1044#1056#1059#1043', '#1045#1057#1051#1048' '#1042' SALEMODE '#1041#1067#1051#1048' '#1047#1040#1055#1054#1051#1053#1045#1053#1067#1045' '#1044#1040#1053#1053#1067#1045', '#1040' '#1055 +
        #1054#1058#1054#1052' '#1042' '#1044#1056#1059#1043#1054#1052' '#1056#1045#1046#1048#1052#1045' '#1058#1040#1041#1051#1048#1062#1040' '#1055#1054#1063#1048#1057#1058#1048#1051#1040#1057#1068', '#1058#1054
      
        '110185842=  -- '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' SALEMODE '#1069#1058#1048#1061' '#1044#1040#1053#1053#1067#1061' '#1059#1046#1045' '#1053#1045' '#1041#1059#1044#1045 +
        #1058', '#1048' '#1047#1040#1055#1048#1064#1045#1058#1057#1071' '#1055#1059#1057#1058#1054#1049' '#1047#1040#1050#1040#1047', '#1041#1059#1044#1059' '#1042#1067#1044#1040#1042#1040#1058#1068' '#1054#1064#1048#1041#1050#1059
      '110185843=  SELECT COUNT(*) FROM ZAKAZ_DETAILS_TMP INTO :CNT_ ;'
      '110185844=  IF (CNT_ = 0) THEN BEGIN'
      '110185845=    ERR_CODE = -20500;'
      
        '110185846=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1090' '#1090#1086#1074#1072#1088 +
        #1086#1074' '#1074' '#1085#1072#1082#1083#1072#1076#1085#1086#1081'! '#1057#1082#1086#1088#1077#1077' '#1074#1089#1077#1075#1086' '#1042#1099' '#1074#1099#1093#1086#1076#1080#1083#1080' '#1074' '#1076#1088#1091#1075#1086#1081' '#1088#1077#1078#1080#1084'. '#1044#1086#1073#1072#1074#1100#1090 +
        #1077' '#1090#1086#1074#1072#1088#1099' '#1079#1072#1085#1086#1074#1086'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110185847=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110185848=    EXIT;'
      '110185849=  END'
      '110185850='
      '110185851=  IF (G_TOCHKA_ IS NULL) THEN'
      '110185852=    SELECT ID'
      '110185853=      FROM CUR_PARAMS'
      '110185854=     WHERE CUR_PARAMS = 2'
      '110185855=      INTO :G_TOCHKA_;'
      '110185856='
      '110185857=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '110185858=  IF (IS_SPISANIE_ IN (0, 1, 4)) THEN BEGIN'
      '110185859=      PNT_ = '#39'01'#39';'
      
        '110185860=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN    ' +
        '-- '#1069#1058#1054' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058' '#1050#1054#1043#1044#1040' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040' '#1055#1056#1048#1061#1054#1044#1048#1058' '#1057#1059#1052#1052#1040' '#1041#1054#1051#1068#1064#1045' '#1057#1059#1052 +
        #1052#1067' '#1047#1040#1050#1040#1047#1040', '#1058#1048#1055#1040' '#1047#1040#1050#1040#1047' '#1053#1040' 17 '#1058#1067#1057#1071#1063', '#1040' '#1050#1051#1048#1045#1053#1058#1040' '#1044#1040#1051' 20 '#1048' '#1046#1044#1045#1058' 3 '#1057#1044#1040 +
        #1063#1048
      '110185861=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110185862=      ELSE'
      '110185863=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110185864='
      '110185865=      --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110185866=      SELECT G.G_OFFICIAL,'
      '110185867=             G.DO_NOT_SALES_COMM,'
      '110185868=             G.FM||'#39' '#39'||G.NM'
      '110185869=        FROM G_OFFICIAL G'
      
        '110185870=       WHERE G.G_OFFICIAL = COALESCE(:G_OFFICIAL_, (SE' +
        'LECT ID FROM CUR_PARAMS WHERE CUR_PARAMS = 1))'
      '110185871=        INTO :G_OFFICIAL_,'
      '110185872=             :DO_NOT_SALES_COMM_,'
      '110185873=             :OFFICIAL_NAME_;'
      '110185874='
      '110185875=      INSERT INTO ZAKAZ'
      '110185876=      ('
      '110185877=       ZAKAZ,'
      '110185878=       G_TOCHKA,'
      '110185879=       Z_DATE,'
      '110185880=       Z_TIME,'
      '110185881=       G_CLIENT,'
      '110185882=       G_PAYMENT_TYPE,'
      '110185883=       OSNOVANIE,'
      '110185884=       IS_SPISANIE,'
      '110185885=       NOTE,'
      '110185886=       SUMM,'
      '110185887=       SUMM_FACT,'
      '110185888=       SUMM_BONUS,'
      '110185889=       IS_PAYED_ALL'
      '110185890=       ,G_OFFICIAL'
      '110185891=       ,BY_RECIPE'
      '110185892=       ,SUMM_BONUS_GOT'
      '110185893=       ,IS_RESERVE'
      '110185894=       ,SUMM_CASH'
      '110185895=       ,SUMM_NONCASH'
      '110185896=       ,NOT_MINUS_OSTATOK'
      '110185897=       ,DELIVERY_ADDRESS'
      '110185898=      ) VALUES ('
      '110185899=       GEN_ID(GEN_ZAKAZ, 1),'
      '110185900=       :G_TOCHKA_,'
      '110185901=       :Z_DATE_,'
      '110185902=       :Z_TIME_,'
      '110185903=       :G_CLIENT_,'
      '110185904=       :G_PAYMENT_TYPE_,'
      '110185905=       :OSNOVANIE_,'
      '110185906=       :IS_SPISANIE_,'
      '110185907=       :NOTE_,'
      '110185908=       :SUMM_,'
      '110185909=       :SUMM_FACT_1_,'
      '110185910=       COALESCE(:SUMM_BONUS_, 0),'
      
        '110185911=       DECODE(:SUMM_, (:SUMM_FACT_1_ + COALESCE(:SUMM_' +
        'BONUS_, 0)), 1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059 +
        #1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110185912=       ,:G_OFFICIAL_'
      '110185913=       ,:BY_RECIPE_'
      '110185914=       ,:SUMM_BONUS_GOT_'
      '110185915=       ,:IS_RESERVE_'
      '110185916=       ,COALESCE(:SUMM_CASH_, 0)'
      '110185917=       ,COALESCE(:SUMM_NONCASH_, 0)'
      '110185918=       ,:NOT_MINUS_OSTATOK_'
      '110185919=       ,:ADDRESS_'
      '110185920=      )'
      '110185921=      RETURNING'
      '110185922=        ZAKAZ'
      '110185923=      INTO'
      '110185924=        :ZAKAZ_;'
      '110185925='
      '110185926=      PNT_ = '#39'02'#39';'
      
        '110185927=      FOR SELECT Z.ZAKAZ_DETAILS, Z.G_PRODUCT, Z.AMOUN' +
        'T, Z.PRICE, Z.SUMM, Z.DISCOUNT_PERC, Z.DISCOUNT_TENGE, Z.DISCOUN' +
        'T_SUMM,'
      
        '110185928=                 Z.NDS, Z.NDS_SUMM, Z.COST_PRICE, G.SA' +
        'LES_COMM, Z.MARK_CODE'
      '110185929=            FROM ZAKAZ_DETAILS_TMP Z, G_PRODUCT G'
      '110185930=           WHERE Z.G_PRODUCT = G.G_PRODUCT'
      '110185931=          INTO :ZAKAZ_DETAILS_TMP_,'
      '110185932=              :G_PRODUCT,'
      '110185933=              :AMOUNT,'
      '110185934=              :PRICE,'
      '110185935=              :SUMM,'
      '110185936=              :DISCOUNT_PERC,'
      '110185937=              :DISCOUNT_TENGE,'
      '110185938=              :DISCOUNT_SUMM,'
      '110185939=              :NDS,'
      '110185940=              :NDS_SUMM,'
      '110185941=              :COST_PRICE,'
      '110185942=              :SALES_COMM_,'
      '110185943=              :MARK_CODE_'
      '110185944=      DO BEGIN'
      
        '110185945=        -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067#1063#1053#1040#1071' '#1055 +
        #1056#1054#1044#1040#1046#1040', '#1044#1040#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1056#1045#1040#1051', '#1048' '#1045#1057#1051#1048' '#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1053#1045' '#1057#1058#1054#1048#1058' '#1043 +
        #1040#1051#1050#1040' - '#1053#1045' '#1053#1040#1063#1048#1057#1051#1071#1058#1068' '#1047#1055')'
      
        '110185946=        IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_C' +
        'OMM_ = 0 AND IS_SPISANIE_ = 0) THEN BEGIN'
      
        '110185947=          SALES_COMM_SUMM_ITER_ = SUMM * SALES_COMM_/1' +
        '00;'
      
        '110185948=          SALES_COMM_SUMM_ALL_  = SALES_COMM_SUMM_ALL_' +
        ' + SALES_COMM_SUMM_ITER_;'
      '110185949=        END'
      '110185950='
      '110185951=        INSERT INTO ZAKAZ_DETAILS'
      '110185952=        VALUES('
      '110185953=          :ZAKAZ_DETAILS_TMP_,'
      '110185954=          :ZAKAZ_,'
      '110185955=          :G_PRODUCT,'
      '110185956=          :AMOUNT,'
      '110185957=          :PRICE,'
      '110185958=          :SUMM,'
      '110185959=          :DISCOUNT_PERC,'
      '110185960=          :DISCOUNT_TENGE,'
      '110185961=          :DISCOUNT_SUMM,'
      '110185962=          :NDS,'
      '110185963=          :NDS_SUMM,'
      '110185964=          :COST_PRICE,'
      '110185965=          :SALES_COMM_SUMM_ITER_,'
      '110185966=          :MARK_CODE_'
      '110185967=        );'
      '110185968='
      
        '110185969=        -- '#1051#1048#1041#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040'. -2 '#1069#1058#1054' '#1054#1041#1057#1051#1059#1046#1048#1042#1040#1053#1048#1045 +
        ' 10%'
      '110185970=        IF (G_PRODUCT <> -2) THEN BEGIN'
      
        '110185971=            IF (IS_RESERVE_ = 0 AND NOT_MINUS_OSTATOK_' +
        ' = 0) THEN BEGIN'
      '110185972=                UPDATE LT_SKLAD_PRODUCT L'
      '110185973=                   SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '110185974=                       L.NEED_TO_EXPORT = :UPLOAD_TO_E' +
        'XT_APP_'
      '110185975=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '110185976=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110185977='
      '110185978=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      
        '110185979=                -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045 +
        #1056#1040', '#1053#1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048 +
        #1062#1040' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '110185980=                -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051 +
        #1048' '#1047#1040#1055#1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      '110185981=                PNT_ = '#39'04'#39';'
      
        '110185982=                IF ((ROW_COUNT = 0) AND ((SELECT S_VAL' +
        'UE FROM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '110185983=                  Err_Code = -20500;'
      
        '110185984=                  EXECUTE PROCEDURE GET_ERR_MSG(ERR_CO' +
        'DE, '#39#1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_P' +
        'RODUCT = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084 +
        #1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110185985=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110185986=                  EXIT;'
      '110185987=                END ELSE if (ROW_COUNT = 0) then'
      
        '110185988=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110185989=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,' +
        ' 1), :G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110185990=            END'
      '110185991='
      '110185992=            -- '#1051#1048#1041#1054' '#1057#1058#1040#1042#1051#1070' '#1053#1040' '#1056#1045#1047#1045#1056#1042
      '110185993=            ELSE IF (IS_RESERVE_ = 1) THEN'
      '110185994=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110185995=                   SET L.AMOUNT_RESERVE = L.AMOUNT_RES' +
        'ERVE + :AMOUNT'
      '110185996=                 WHERE L.G_PRODUCT = :G_PRODUCT'
      '110185997=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110185998='
      '110185999='
      '1101851000=        END'
      '1101851001=      END'
      '1101851002='
      '1101851003=      ----------------------------------------'
      
        '1101851004=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1054#1041#1067 +
        #1063#1053#1067#1049' '#1047#1040#1050#1040#1047', '#1040' '#1053#1045' '#1057#1055#1048#1057#1040#1053#1048#1045' '#1058#1054#1042#1040#1056#1040
      
        '1101851005=      -- '#1040' '#1058#1040#1050#1046#1045' '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049' '#1054#1055#1051#1040#1058#1067' '#1053#1045' '#1053#1054#1051 +
        #1068
      '1101851006=      IF (IS_SPISANIE_ in (0, 4)) THEN BEGIN'
      '1101851007='
      
        '1101851008=        -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048 +
        ', '#1063#1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054 +
        #1044#1048#1053' '#1055#1051#1040#1058#1045#1046
      '1101851009=        IF (PAYMENTS_ IS NULL) THEN BEGIN'
      '1101851010=            IF (SUMM_FACT_1_ > 0) THEN BEGIN'
      '1101851011=                PNT_ = '#39'05'#39';'
      
        '1101851012=                EXECUTE PROCEDURE K_INS_KASSA(0,     ' +
        '-- ACTION_ => :ACTION_'
      
        '1101851013=                                              1,     ' +
        '-- G_PRIHOD_RASHOD_ => :G_PRIHOD_RASHOD_,'
      
        '1101851014=                                              :SUMM_F' +
        'ACT_1_,'
      
        '1101851015=                                              :Z_DATE' +
        '_,'
      
        '1101851016=                                              NULL,  ' +
        ' --NOTE_ => :NOTE_,'
      
        '1101851017=                                              ZAKAZ_,' +
        '   --ZAKAZ_'
      '1101851018=                                              NULL,'
      
        '1101851019=                                              :G_PAYM' +
        'ENT_TYPE_,'
      
        '1101851020=                                              :G_TOCH' +
        'KA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101851021=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101851022=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101851023=                  EXIT;'
      '1101851024=                END'
      '1101851025=            END'
      '1101851026='
      '1101851027=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '1101851028=        END ELSE BEGIN'
      '1101851029=            PNT_ = '#39'06'#39';'
      
        '1101851030=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEG' +
        'IN'
      
        '1101851031=                POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS' +
        '_);'
      
        '1101851032=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TIL' +
        'DA_) THEN'
      
        '1101851033=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1101851034=                ELSE'
      
        '1101851035=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1101851036='
      
        '1101851037=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1101851038=                    RETURNING_VALUES :PAYMENT_ID_, :P' +
        'AYMENT_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1101851039='
      
        '1101851040=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FRO' +
        'M (POSITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '1101851041='
      '1101851042=                IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '1101851043=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101851044=                                                  1, ' +
        '    --:G_PRIHOD_RASHOD_,'
      
        '1101851045=                                                  :PA' +
        'YMENT_SUMM_,'
      
        '1101851046=                                                  :PA' +
        'YMENT_DATE_,'
      
        '1101851047=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101851048=                                                  :ZA' +
        'KAZ_,'
      
        '1101851049=                                                  NUL' +
        'L,     --:SKLAD_,'
      
        '1101851050=                                                  :PA' +
        'YMENT_TYPE_,'
      
        '1101851051=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101851052=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101851053=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
      '1101851054=                      EXIT;'
      '1101851055=                    END'
      '1101851056=                END'
      '1101851057=            END'
      '1101851058=        END'
      '1101851059=      END'
      '1101851060='
      
        '1101851061=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1101851062=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1101851063=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1101851064=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1101851065=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1101851066=          UPDATE G_DISCONT_CARD D'
      
        '1101851067=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1101851068=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1101851069=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1101851070=          RETURNING'
      '1101851071=            D.SUMM_ALL'
      '1101851072=          INTO'
      '1101851073=            :CLIENT_SUMM_ALL_;'
      '1101851074='
      '1101851075=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1101851076=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1101851077=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1101851078=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1101851079=          ORDER BY G.SUMM_FROM'
      '1101851080=          ROWS 1 TO 1'
      '1101851081=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1101851082='
      '1101851083=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1101851084=            UPDATE G_CLIENT G'
      '1101851085=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1101851086=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1101851087=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1101851088='
      '1101851089=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1101851090=            UPDATE G_DISCONT_CARD D'
      '1101851091=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1101851092=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1101851093=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1101851094=      END'
      '1101851095='
      '1101851096=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1101851097=      PNT_ = '#39'07'#39';'
      
        '1101851098=      IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_CO' +
        'MM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THEN ' +
        'BEGIN'
      '1101851099=        SELECT S.S_VALUE'
      '1101851100=          FROM SYSTEM_SETUP S'
      '1101851101=         WHERE S.SYSTEM_SETUP = 4'
      '1101851102=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101851103='
      '1101851104=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101851105=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101851106=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101851107='
      
        '1101851108=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1101851109=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1101851110=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1101851111='
      '1101851112=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101851113=        ELSE'
      
        '1101851114=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1101851115='
      '1101851116=        KASSA_ZP_ID_ = NULL;'
      '1101851117=        SELECT K.KASSA, K.SUMM'
      '1101851118=        FROM KASSA K'
      '1101851119=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1101851120=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101851121=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101851122=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1101851123=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1101851124='
      
        '1101851125=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1101851126='
      '1101851127=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1101851128=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101851129=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101851130=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101851131=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101851132=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1101851133=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1101851134=                                          NULL,     -' +
        '-:SKLAD_,'
      '1101851135=                                          1,'
      '1101851136=                                          :G_TOCHKA_,'
      
        '1101851137=                                          :G_OFFICIAL' +
        '_'
      
        '1101851138=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1101851139=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1101851140=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1101851141='
      '1101851142=        END ELSE BEGIN'
      
        '1101851143=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1101851144=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1101851145=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1101851146=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1101851147='
      
        '1101851148=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1101851149=                                          1,     -- A' +
        'CTION_'
      
        '1101851150=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1101851151=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1101851152=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1101851153=                                          :OFFICIAL_N' +
        'AME_,   --NOTE_'
      '1101851154=                                          NULL,'
      '1101851155=                                          NULL,'
      
        '1101851156=                                          :PAYMENT_TY' +
        'PE_,'
      
        '1101851157=                                          :G_OFFICIAL' +
        '_'
      
        '1101851158=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1101851159='
      '1101851160=        END'
      '1101851161=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101851162=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101851163=          EXIT;'
      '1101851164=        END'
      '1101851165=      END'
      '1101851166='
      '1101851167=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101851168=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101851169=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101851170=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 1);'
      '1101851171=  END'
      '1101851172=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040' '#1048#1051#1048' '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101851173=  ----------------------------------------'
      '1101851174=  ----------------------------------------'
      '1101851175=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101851176=  ELSE IF (IS_SPISANIE_ = 2) THEN BEGIN'
      '1101851177=      PNT_ = '#39'25'#39';'
      
        '1101851178=      INSERT INTO ZAKAZ_REAL_PARENT (ZAKAZ_REAL_PAREN' +
        'T, G_CLIENT, ZAKAZ_DATE, G_PAYMENT_TYPE, OSNOVANIE, NOTE, G_TOCH' +
        'KA)'
      
        '1101851179=      VALUES (GEN_ID(GEN_ZAKAZ_REAL_PARENT, 1), :G_CL' +
        'IENT_, :Z_DATE_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :G_TOCHK' +
        'A_)'
      '1101851180=      RETURNING ZAKAZ_REAL_PARENT'
      '1101851181=      INTO :ZAKAZ_;'
      '1101851182='
      
        '1101851183=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM, DISC' +
        'OUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS, NDS_SUMM'
      '1101851184=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101851185=          INTO :G_PRODUCT,'
      '1101851186=              :AMOUNT,'
      '1101851187=              :PRICE,'
      '1101851188=              :SUMM,'
      '1101851189=              :DISCOUNT_PERC,'
      '1101851190=              :DISCOUNT_TENGE,'
      '1101851191=              :DISCOUNT_SUMM,'
      '1101851192=              :NDS,'
      '1101851193=              :NDS_SUMM'
      '1101851194=      DO BEGIN'
      '1101851195=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101851196=          UPDATE LT_SKLAD_PRODUCT L'
      '1101851197=             SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      
        '1101851198=                 L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_AP' +
        'P_'
      '1101851199=           WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101851200=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101851201='
      
        '1101851202=          -- '#1055#1056#1054#1042#1045#1056#1050#1040' '#1057#1063#1057' '#1057#1058#1054#1048#1058' '#1053#1040' '#1059#1056#1054#1042#1053#1045' '#1058#1056#1048#1043#1043#1045#1056#1040', '#1053 +
        #1054' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' 22.12.2015 '#1059#1046#1045' '#1045#1057#1058#1068' '#1051#1070#1044#1048' '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1058#1040#1041#1051#1048#1062#1040' '#1053#1045 +
        ' '#1047#1040#1055#1054#1051#1053#1071#1051#1040#1057#1068' '#1055#1056#1048' '#1057#1054#1047#1044#1040#1053#1048#1048' '#1058#1054#1042#1040#1056#1040
      
        '1101851203=          -- '#1055#1054#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' - '#1045#1057#1051#1048' '#1047#1040#1055 +
        #1048#1057#1045#1049' '#1053#1045#1058', '#1047#1053#1040#1063#1048#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1041#1067#1051#1054
      
        '1101851204=          if ((ROW_COUNT = 0) AND ((SELECT S_VALUE FR' +
        'OM SYSTEM_SETUP WHERE SYSTEM_SETUP = 2) = 0)) then BEGIN'
      '1101851205=            Err_Code = -20500;'
      
        '1101851206=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #1055#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||(SELECT NAME FROM G_PRODUCT WHERE G_PRODUC' +
        'T = :G_PRODUCT)||'#39'" '#1086#1089#1090#1072#1090#1086#1082' 0. '#1055#1088#1086#1076#1072#1078#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086 +
        #1075#1088#1072#1084#1084#1099'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101851207=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101851208=            EXIT;'
      '1101851209=          END ELSE if (ROW_COUNT = 0) then'
      
        '1101851210=            INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PR' +
        'ODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101851211=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), ' +
        ':G_PRODUCT, -:AMOUNT, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '1101851212='
      
        '1101851213=          INSERT INTO ZAKAZ_NA_REAL (ZAKAZ_NA_REAL, Z' +
        'AKAZ_REAL_PARENT,'
      '1101851214=                                     G_PRODUCT,'
      '1101851215=                                     PRICE,'
      
        '1101851216=                                     AMOUNT_ALL, SUMM' +
        '_ALL,'
      
        '1101851217=                                     AMOUNT_PAYED, SU' +
        'MM_PAYED, IS_PAYED_ALL, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_' +
        'SUMM, NDS,'
      '1101851218=                                     NDS_SUMM)'
      
        '1101851219=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKA' +
        'Z_,'
      '1101851220=                  :G_PRODUCT,'
      
        '1101851221=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046 +
        #1040#1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '1101851222=                  :AMOUNT, :SUMM,'
      '1101851223=                  0, --AMOUNT_PAYED,'
      '1101851224=                  0, --SUMM_PAYED,'
      '1101851225=                  0, --IS_PAYED_ALL,'
      '1101851226=                  :DISCOUNT_PERC,'
      '1101851227=                  :DISCOUNT_TENGE,'
      '1101851228=                  :DISCOUNT_SUMM,'
      '1101851229=                  :NDS,'
      '1101851230=                  :NDS_SUMM)'
      '1101851231=          RETURNING ZAKAZ_NA_REAL'
      '1101851232=          INTO :ZAKAZ_;'
      '1101851233=      END'
      '1101851234=  END'
      '1101851235=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101851236=  ----------------------------------------'
      '1101851237=  ----------------------------------------'
      '1101851238=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '1101851239=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045 +
        #1046#1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '1101851240=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071',' +
        ' '#1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101851241=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '1101851242=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, ' +
        'TIME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, S' +
        'UMM_FACT,'
      
        '1101851243=                                IS_PAYED_ALL, IS_VOZV' +
        'RAT, G_TOCHKA, IS_EXPECTED)'
      
        '1101851244=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME' +
        '_, :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :S' +
        'UMM_FACT_,'
      '1101851245=              1, 3, :G_CLIENT_, :NOT_MINUS_OSTATOK_)'
      '1101851246=      RETURNING SKLAD'
      '1101851247=      INTO :ZAKAZ_;'
      '1101851248='
      '1101851249=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '1101851250=            FROM ZAKAZ_DETAILS_TMP Z'
      '1101851251=          INTO :G_PRODUCT,'
      '1101851252=              :AMOUNT,'
      '1101851253=              :PRICE,'
      '1101851254=              :SUMM'
      '1101851255=      DO BEGIN'
      '1101851256=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101851257=        UPDATE LT_SKLAD_PRODUCT L'
      '1101851258=           SET L.AMOUNT = L.AMOUNT - :AMOUNT,'
      '1101851259=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '1101851260=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101851261=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101851262='
      '1101851263=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '1101851264=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' ' +
        #1048#1051#1048' '#1053#1045#1058
      
        '1101851265=        /*IS_THIS_LAST_ = 0;            23,07,2018 '#1056#1045 +
        #1064#1048#1051', '#1063#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048' - '#1053#1045' '#1044#1054#1051#1046#1053#1054' '#1042#1051#1048#1071#1058#1068' '#1053#1040' '#1047#1040#1050#1059#1055' ' +
        #1062#1045#1053#1059
      '1101851266=        SELECT MAX(SK.DATE_RECEIPT)'
      '1101851267=            FROM SKLAD SK'
      '1101851268=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101851269=             AND SK.IS_LAST = 1'
      '1101851270=             AND SK.G_TOCHKA = :G_CLIENT_'
      '1101851271=            INTO :DATE_LAST_;'
      '1101851272='
      
        '1101851273=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) o' +
        'r (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1101851274=            UPDATE SKLAD SK'
      '1101851275=               SET SK.IS_LAST = 0'
      '1101851276=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '1101851277=               AND SK.IS_LAST = 1'
      '1101851278=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '1101851279='
      '1101851280=            IS_THIS_LAST_ = 1;'
      '1101851281=        END */'
      '1101851282='
      '1101851283='
      '1101851284=        INSERT INTO SKLAD'
      '1101851285=        ('
      '1101851286=         SKLAD,'
      '1101851287=         SKLAD_PARENT,'
      '1101851288=         DATE_RECEIPT,'
      '1101851289=         G_CLIENT,'
      '1101851290=         G_PRODUCT,'
      '1101851291=         AMOUNT,'
      '1101851292=         PRICE,'
      '1101851293=         SUMM,'
      '1101851294=         G_PAYMENT_TYPE,'
      '1101851295=         OSNOVANIE,'
      '1101851296=         NOTE,'
      '1101851297=         NDS,'
      '1101851298=         NDS_SUMM,'
      '1101851299=         IS_LAST,'
      '1101851300=         IS_VOZVRAT,'
      '1101851301=         G_TOCHKA'
      '1101851302=        ) VALUES ('
      '1101851303=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '1101851304=         :ZAKAZ_,'
      '1101851305=         :Z_DATE_,'
      '1101851306=         :G_TOCHKA_,'
      '1101851307=         :G_PRODUCT,'
      '1101851308=         :AMOUNT,'
      '1101851309=         :PRICE,'
      '1101851310=         :SUMM,'
      '1101851311=         :G_PAYMENT_TYPE_,'
      '1101851312=         :OSNOVANIE_,'
      '1101851313=         :NOTE_,'
      '1101851314=         0,  --:RNDS_,'
      '1101851315=         0,  --:RNDS_SUMM_,'
      
        '1101851316=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '1101851317=         3,  --:IS_VOZVRAT_,'
      '1101851318=         :G_CLIENT_'
      '1101851319=        );'
      '1101851320='
      
        '1101851321=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070 +
        ' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '1101851322=        -- '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      '1101851323=        PNT_ = '#39'02'#39';'
      '1101851324=        IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1101851325=            UPDATE LT_SKLAD_PRODUCT L'
      '1101851326=               SET L.AMOUNT = L.AMOUNT + :AMOUNT,'
      
        '1101851327=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1101851328=             WHERE L.G_PRODUCT = :G_PRODUCT'
      '1101851329=               AND L.G_TOCHKA = :G_CLIENT_;'
      '1101851330='
      '1101851331=            IF (ROW_COUNT = 0) THEN'
      
        '1101851332=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_' +
        'PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1101851333=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1)' +
        ', :G_PRODUCT, :AMOUNT, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1101851334=        END'
      '1101851335=      END'
      '1101851336=  END'
      '1101851337='
      '1101851338=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1101851339='
      
        '1101851340=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040 +
        #1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '1101851341=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101851342=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =' +
        '> :ACTION_'
      '1101851343=                                  G_PRIHOD_,'
      '1101851344=                                  :SUMM_PRIHOD_,'
      '1101851345=                                  :Z_DATE_,'
      
        '1101851346=                                  NULL,   --NOTE_ => ' +
        ':NOTE_,'
      '1101851347=                                  :ZAKAZ_,'
      '1101851348=                                  NULL,'
      '1101851349=                                  :G_PAYMENT_TYPE_,'
      
        '1101851350=                                  :G_TOCHKA_) RETURNI' +
        'NG_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101851351=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101851352=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101851353=      EXIT;'
      '1101851354=    END'
      '1101851355=  END'
      '1101851356='
      
        '1101851357=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042 +
        #1057#1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '1101851358=  IF (IS_MEBEL_ = 1) THEN'
      
        '1101851359=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATU' +
        'S, ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '1101851360=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0,' +
        ' :ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '1101851361='
      '1101851362=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1101851363=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 1, :SUMM_, :LOG_BODY_, 0);'
      '1101851364='
      '1101851365=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1101851366=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1101851367=end'
      '1101851368=;'
      '1101851369='
      '1101851370=ALTER PROCEDURE P_REP_AVERAGE_TOVBILL('
      '1101851371=  DATE_BEGIN_ DATE,'
      '1101851372=  DATE_END_ DATE,'
      '1101851373=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '1101851374=RETURNS ('
      '1101851375=  CNT_BILLS_ INTEGER,'
      '1101851376=  CNT_TOVS_ INTEGER,'
      '1101851377=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      '1101851378=  ERR_CODE INTEGER,'
      '1101851379=  ERR_MSG VARCHAR(1024))'
      '1101851380=AS'
      
        '1101851381=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_AVERAG' +
        'E_TOVBILL'#39';'
      '1101851382=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101851383=BEGIN'
      '1101851384=  SUMM_ = 0;'
      '1101851385='
      '1101851386=  SELECT COUNT(*)'
      '1101851387=    FROM ZAKAZ ZZ'
      
        '1101851388=   WHERE ZZ.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '1101851389=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||ZZ.G_TOCHKA||' +
        #39'-'#39
      '1101851390=    INTO :CNT_BILLS_;'
      '1101851391='
      '1101851392=  SELECT SUM(ZD.AMOUNT)'
      '1101851393=    FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      '1101851394=   WHERE Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '1101851395=     AND :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '1101851396=     AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101851397=    INTO :CNT_TOVS_;'
      '1101851398='
      '1101851399=  SUMM_ = ROUND( CNT_TOVS_ / CNT_BILLS_, 2);'
      '1101851400='
      '1101851401=WHEN ANY DO BEGIN'
      '1101851402=    Err_code = -20500;'
      
        '1101851403=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' "'#1057#1056#1045#1044#1053#1045#1045' '#1050#1054#1051'-'#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1063#1045#1050#1045'"!'#39') RETURNI' +
        'NG_VALUES (:ERR_MSG);'
      
        '1101851404=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101851405=  END'
      '1101851406=end'
      '1101851407=;'
      '1101851408='
      '1101851409=ALTER PROCEDURE P_REP_BILL('
      '1101851410=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101851411=  SUMM_DANO_ NUMERIC(15,2),'
      '1101851412=  SUMM_SDACHA_ NUMERIC(15,2),'
      '1101851413=  CURRENCY_ INTEGER,'
      '1101851414=  MODE_ INTEGER,'
      '1101851415=  PRINT_SLOGAN_ VARCHAR(80),'
      '1101851416=  DECIMAL_ INTEGER,'
      '1101851417=  BONUS_ NUMERIC(15,2),'
      '1101851418=  ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS)'
      '1101851419=RETURNS ('
      '1101851420=  FIRM_NAME_ VARCHAR(600),'
      '1101851421=  IDN_STR_ VARCHAR(30),'
      '1101851422=  FIRM_IDN_ VARCHAR(50),'
      '1101851423=  FIRM_ADDRESS_ VARCHAR(550),'
      '1101851424=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101851425=  DATE_ VARCHAR(100),'
      '1101851426=  PAYMENT_TYPE_ VARCHAR(100),'
      '1101851427=  G_CLIENT_NAME_ VARCHAR(300),'
      '1101851428=  G_OFFICIAL_FM_ VARCHAR(300),'
      '1101851429=  SUMM_VSEGO_ VARCHAR(50),'
      '1101851430=  SUMM_VSEGO_N_ VARCHAR(50),'
      '1101851431=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1101851432=  ROW_NUM INTEGER,'
      '1101851433=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101851434=  NAME_ART VARCHAR(1000),'
      '1101851435=  AMOUNT VARCHAR(50),'
      '1101851436=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101851437=  PRICE VARCHAR(50),'
      '1101851438=  PRICE_N VARCHAR(50),'
      '1101851439=  SUMM VARCHAR(50),'
      '1101851440=  SUMM_N VARCHAR(50),'
      '1101851441=  SUMM_POLUCH_ VARCHAR(50),'
      '1101851442=  SUMM_SDACH_ VARCHAR(50),'
      '1101851443=  SUMM_STR_ VARCHAR(200),'
      '1101851444=  SLOGAN_ VARCHAR(80),'
      '1101851445=  SUMM_SKIDKA_ VARCHAR(50),'
      '1101851446=  SUMM_SERVICE_ VARCHAR(50),'
      '1101851447=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101851448=  BONUS_STR_ VARCHAR(100),'
      '1101851449=  DELIVERY_ADDRESS_ TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      '1101851450=  ERR_CODE NUMERIC(15,2),'
      '1101851451=  ERR_MSG VARCHAR(1024))'
      '1101851452=AS'
      '1101851453=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '1101851454=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '1101851455=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101851456=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101851457=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101851458=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.AMOUNT;'
      
        '1101851459=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.AMOUNT;'
      
        '1101851460=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '1101851461=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '1101851462=DECLARE VARIABLE SERVICE_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.SUMM;'
      '1101851463=BEGIN'
      '1101851464=  SLOGAN_ = PRINT_SLOGAN_;'
      '1101851465='
      '1101851466=  IF (BONUS_ > 0) THEN BEGIN'
      
        '1101851467=    BONUS_STR_ = '#39#1053#1072#1095#1080#1089#1083#1077#1085#1086' '#1073#1086#1085#1091#1089#1086#1074': '#39' || CAST(ROUND(' +
        'BONUS_, 2) AS VARCHAR(100));'
      '1101851468=  END'
      '1101851469='
      '1101851470=  IF (CHAR_LENGTH(ADDRESS_) > 0) THEN BEGIN'
      
        '1101851471=    DELIVERY_ADDRESS_ = '#39#1040#1076#1088#1077#1089' '#1076#1086#1089#1090#1072#1074#1082#1080': '#39' || ADDRESS' +
        '_;'
      '1101851472=  END'
      '1101851473='
      '1101851474=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '1101851475=  SELECT z.ZAKAZ'
      '1101851476=         ,P.NAME'
      
        '1101851477=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39 +
        '.'#39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEA' +
        'R FROM Z.Z_DATE)||'#39'  '#39'||lpad(EXTRACT(HOUR FROM Z.Z_TIME), 2, '#39'0'#39 +
        ')||'#39':'#39'||lpad(EXTRACT(MINUTE FROM Z.Z_TIME), 2, '#39'0'#39')'
      '1101851478=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '1101851479=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COA' +
        'LESCE(O.NM, '#39#39')'
      '1101851480=         ,Z.summ_noncash'
      '1101851481=         ,Z.summ_cash'
      '1101851482=         ,Z.NOTE'
      
        '1101851483=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_' +
        'OFFICIAL = O.G_OFFICIAL,'
      '1101851484=         G_CLIENT G,'
      '1101851485=         G_PAYMENT_TYPE P'
      '1101851486=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101851487=     AND Z.G_CLIENT = G.G_CLIENT'
      '1101851488=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '1101851489=    INTO :NUM_'
      '1101851490=        ,:PAYMENT_TYPE_'
      '1101851491=        ,:DATE_'
      '1101851492=        ,:G_CLIENT_NAME_'
      '1101851493=        ,:G_OFFICIAL_FM_'
      '1101851494=        ,:SUMM_NONCASH_'
      '1101851495=        ,:SUMM_CASH_'
      '1101851496=        ,:NOTE_'
      '1101851497=        ;'
      '1101851498='
      '1101851499=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '1101851500=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '1101851501='
      '1101851502=  SELECT R.G_FIRM_REKVIZIT,'
      '1101851503=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '1101851504=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086 +
        #1088#1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '1101851505=    FROM G_FIRM_REKVIZIT R'
      '1101851506=   WHERE R.is_default = 1'
      '1101851507=    INTO :G_FIRM_REKVIZIT_,'
      '1101851508=         :FIRM_NAME_,'
      '1101851509=         :FIRM_IDN_;'
      '1101851510='
      '1101851511=  SELECT ZD.SUMM'
      '1101851512=    FROM ZAKAZ_DETAILS ZD'
      '1101851513=   WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101851514=    AND ZD.G_PRODUCT = -2'
      '1101851515=    INTO :SERVICE_SUMM_;'
      '1101851516=  SERVICE_SUMM_ = COALESCE(SERVICE_SUMM_, 0);'
      '1101851517='
      '1101851518=  SELECT SUM(ZD.AMOUNT),'
      
        '1101851519=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARC' +
        'HAR(50)),'
      
        '1101851520=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), ' +
        '2) AS VARCHAR(50)),'
      
        '1101851521=         CAST(SUM(ZD.SUMM) + :SERVICE_SUMM_ AS VARCHA' +
        'R(50)),'
      '1101851522=         CAST(:SERVICE_SUMM_  AS VARCHAR(50))'
      '1101851523=  FROM ZAKAZ_DETAILS ZD'
      '1101851524=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101851525=    AND ZD.G_PRODUCT <> -2'
      '1101851526=  INTO :AMOUNT_VSEGO_NUM_,'
      '1101851527=       :SUMM_SKIDKA_,'
      '1101851528=       :SUMM_VSEGO_,'
      '1101851529=       :SUMM_VSEGO_N_,'
      '1101851530=       :SUMM_SERVICE_;'
      '1101851531='
      '1101851532=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '1101851533=    FROM G_FIRM_ADDRESS R'
      '1101851534=   WHERE R.IS_DEFAULT = 1'
      '1101851535=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '1101851536=    INTO :FIRM_ADDRESS_;'
      '1101851537='
      
        '1101851538=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047 +
        #1048#1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '1101851539=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':' +
        #39');'
      '1101851540=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '1101851541=    IF (CURRENCY_ = 0) THEN'
      '1101851542=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '1101851543=    ELSE'
      '1101851544=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '1101851545=  END'
      '1101851546='
      '1101851547=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '1101851548='
      
        '1101851549=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR' +
        '(100));'
      
        '1101851550=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCH' +
        'AR(100));'
      '1101851551='
      '1101851552=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '1101851553=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '1101851554=  INTO :SUMM_STR_;'
      '1101851555='
      '1101851556=  FOR'
      '1101851557=    SELECT :I,'
      '1101851558=           G.NAME,'
      
        '1101851559=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39',' +
        ' '#39#39'),'
      '1101851560=           ZD.AMOUNT,'
      '1101851561=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '1101851562=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) ' +
        'AS VARCHAR(100))'
      '1101851563=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '1101851564=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENG' +
        'E, 0) AS VARCHAR(100))'
      '1101851565=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '1101851566=      FROM ZAKAZ Z,'
      '1101851567=           ZAKAZ_DETAILS ZD,'
      '1101851568=           G_PRODUCT G,'
      '1101851569=           G_UNIT U'
      '1101851570=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101851571=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '1101851572=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '1101851573=       AND G.G_UNIT = U.G_UNIT'
      '1101851574=       AND G.G_PRODUCT <> -2'
      '1101851575=     ORDER BY ZD.zakaz_details'
      '1101851576=    INTO :ROW_NUM,'
      '1101851577=        :NAME,'
      '1101851578=        :NAME_ART,'
      '1101851579=        :AMOUNT_NUM_,'
      '1101851580=        :PRICE,'
      '1101851581=        :SUMM'
      '1101851582=        ,:SHORT_NAME'
      '1101851583=        ,:PRICE_N'
      '1101851584=        ,:SUMM_N'
      '1101851585=  DO BEGIN'
      '1101851586=    I = I + 1;'
      '1101851587='
      
        '1101851588=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068 +
        ' '#1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '1101851589=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '1101851590=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '1101851591=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '1101851592=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '1101851593=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '1101851594=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN PRICE)-1);'
      '1101851595=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '1101851596=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR P' +
        'OSITION('#39'.00'#39' IN PRICE_N)-1);'
      '1101851597=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '1101851598=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN SUMM)-1);'
      '1101851599=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '1101851600=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN SUMM_N)-1);'
      '1101851601=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '1101851602=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '1101851603=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '1101851604=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '1101851605=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '1101851606=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1' +
        ' FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '1101851607=    if (POSITION('#39'.00'#39' IN SUMM_SERVICE_) > 0) then'
      
        '1101851608=      SUMM_SERVICE_    = SUBSTRING(SUMM_SERVICE_ FROM' +
        ' 1 FOR POSITION('#39'.00'#39' IN SUMM_SERVICE_)-1);'
      '1101851609=    if (POSITION('#39'.00'#39' IN BONUS_STR_) > 0) then'
      
        '1101851610=      BONUS_STR_    = SUBSTRING(BONUS_STR_ FROM 1 FOR' +
        ' POSITION('#39'.00'#39' IN BONUS_STR_)-1);'
      '1101851611='
      '1101851612=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1101851613=    IF (DECIMAL_ = 2) THEN BEGIN'
      '1101851614=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '1101851615=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,2));'
      '1101851616=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '1101851617=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '1101851618=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,3));'
      '1101851619=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '1101851620=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '1101851621=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,4));'
      '1101851622=    END ELSE BEGIN'
      '1101851623=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '1101851624=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS N' +
        'UMERIC(18,5));'
      '1101851625=    END'
      '1101851626='
      
        '1101851627=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT) > 0) then'
      
        '1101851628=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR PO' +
        'SITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '1101851629='
      
        '1101851630=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOU' +
        'NT_VSEGO_) > 0) then'
      
        '1101851631=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1' +
        ' FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '1101851632='
      '1101851633=    SUSPEND;'
      '1101851634=  END'
      '1101851635=WHEN ANY DO BEGIN'
      '1101851636=    Err_code = -20500;'
      
        '1101851637=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101851638=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101851639=  END'
      '1101851640=end'
      '1101851641=;'
      '1101851642='
      '1101851643=ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      '1101851644=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101851645=  CURRENCY_ INTEGER)'
      '1101851646=RETURNS ('
      '1101851647=  NUMBER_STR_ VARCHAR(200),'
      '1101851648=  ROW_NUM INTEGER,'
      '1101851649=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101851650=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101851651=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '1101851652=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101851653=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101851654=  AMOUNT MY_NUMERIC_5,'
      '1101851655=  PRICE_N VARCHAR(50),'
      '1101851656=  SUMM_N VARCHAR(50),'
      '1101851657=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '1101851658=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '1101851659=  SUMM_VSEGO_ VARCHAR(50),'
      '1101851660=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101851661=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '1101851662=  SUMM_STR_ VARCHAR(500),'
      '1101851663=  ERR_CODE NUMERIC(15,2),'
      '1101851664=  ERR_MSG VARCHAR(1024))'
      '1101851665=AS'
      '1101851666=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '1101851667=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD' +
        '_WAYBILL'#39';'
      '1101851668=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101851669=DECLARE VARIABLE I INTEGER = 1;'
      
        '1101851670=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FI' +
        'RM_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '1101851671=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1101851672=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101851673=DECLARE VARIABLE HAVE_RIGHT_TO_SEE_COST_PRICE_ INTEGE' +
        'R = 0;'
      '1101851674=BEGIN'
      '1101851675='
      
        '1101851676=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.sklad||'#39' '#1086#1090' '#39'||lpad(EXTRACT' +
        '(DAY FROM P.date_receipt), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM' +
        ' P.date_receipt), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.date_receipt),'
      '1101851677=         G.name,'
      '1101851678=         P.IS_VOZVRAT'
      
        '1101851679=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON' +
        ' P.g_client = G.G_CLIENT'
      '1101851680=   WHERE P.sklad = :sklad_parent_'
      '1101851681=    INTO :NUMBER_STR_,'
      '1101851682=         :POSTAVSHIK_NAME_,'
      '1101851683=         :IS_VOZVRAT_;'
      '1101851684='
      '1101851685=  SELECT ID, NAME'
      '1101851686=    FROM CUR_PARAMS'
      '1101851687=   WHERE CUR_PARAMS = 1'
      '1101851688=    INTO :G_OFFICIAL_, :G_OFFICIAL_FM_;'
      '1101851689='
      
        '1101851690=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058 +
        #1068' '#1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      
        '1101851691=  -- '#1048' '#1055#1056#1054#1042#1045#1056#1048#1058#1068' '#1045#1057#1058#1068' '#1051#1048' '#1059' '#1053#1045#1043#1054' '#1055#1056#1040#1042#1054' '#1053#1040' '#1055#1056#1054#1057#1052#1054#1058#1056' '#1047#1040#1050 +
        #1059#1055#1054#1063#1053#1067#1061' '#1062#1045#1053
      '1101851692=  IF (IS_VOZVRAT_ = 3) THEN BEGIN'
      '1101851693=    SELECT G.NAME'
      '1101851694=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '1101851695=     WHERE P.SKLAD = :sklad_parent_'
      '1101851696=       AND P.G_TOCHKA = G.G_TOCHKA'
      '1101851697=      INTO :POSTAVSHIK_NAME_;'
      '1101851698='
      '1101851699=    SELECT COUNT(*)'
      '1101851700=      FROM G_OFFICIAL_RIGHT GR'
      '1101851701=     WHERE GR.G_OFFICIAL = :G_OFFICIAL_'
      '1101851702=       AND GR.RIGHTS_ITEM = 105'
      '1101851703=      INTO :HAVE_RIGHT_TO_SEE_COST_PRICE_;'
      '1101851704=  END'
      '1101851705='
      
        '1101851706=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) ' +
        'AS VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '1101851707=         ,REPLACE(CAST(SUM(DECODE(:IS_VOZVRAT_, 3, DE' +
        'CODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.PRICE), S.PRICE)) A' +
        'S VARCHAR(50)), '#39'.'#39', '#39','#39')'
      
        '1101851708=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(DECOD' +
        'E(:IS_VOZVRAT_, 3, DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, ' +
        'S.PRICE), S.PRICE)), :CURRENCY_))'
      '1101851709=    FROM SKLAD S'
      '1101851710=   WHERE S.sklad_parent = :sklad_parent_'
      '1101851711=   GROUP BY S.sklad_parent'
      '1101851712=    INTO :AMOUNT_VSEGO_,'
      '1101851713=         :SUMM_VSEGO_,'
      '1101851714=         :summ_str_;'
      '1101851715='
      '1101851716=  FOR SELECT :I,'
      '1101851717=             G.name,'
      '1101851718=             G.ARTICUL,'
      '1101851719=             G.BARCODE,'
      '1101851720=             G.NOMENCLATUR_NUM,'
      '1101851721=             U.short_name,'
      
        '1101851722=             S.amount,    --REPLACE(CAST(S.amount AS ' +
        'VARCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '1101851723=             REPLACE(CAST(DECODE(:IS_VOZVRAT_, 3, DEC' +
        'ODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.PRICE), S.PRICE) AS ' +
        'VARCHAR(50)), '#39'.'#39', '#39','#39'),'
      
        '1101851724=             REPLACE(CAST(DECODE(:IS_VOZVRAT_, 3, DEC' +
        'ODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 0, 0, S.SUMM), S.SUMM) AS VA' +
        'RCHAR(50)), '#39'.'#39', '#39','#39'),'
      '1101851725=             G.PRICE'
      '1101851726=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '1101851727=       WHERE S.sklad_parent = :sklad_parent_'
      '1101851728=         AND S.g_product = G.g_product'
      '1101851729=         AND G.g_unit = U.g_unit'
      '1101851730=        INTO :ROW_NUM,'
      '1101851731=            :NAME,'
      '1101851732=            :ARTICUL,'
      '1101851733=            :BARCODE,'
      '1101851734=            :NOMENCLATUR_NUM,'
      '1101851735=            :SHORT_NAME,'
      '1101851736=            :AMOUNT,'
      '1101851737=            :PRICE_N,'
      '1101851738=            :SUMM_N,'
      '1101851739=            :PRICE'
      '1101851740=  DO BEGIN'
      '1101851741=    I = I + 1;'
      '1101851742=    SUSPEND;'
      '1101851743=  END'
      '1101851744=WHEN ANY DO BEGIN'
      '1101851745=    Err_code = -20500;'
      
        '1101851746=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101851747=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1101851748=  END'
      '1101851749=end'
      '1101851750=;'
      '1101851751='
      '1101851752=ALTER PROCEDURE READ_SKLAD_LIST('
      '1101851753=  DATE_BEGIN_ DATE,'
      '1101851754=  DATE_END_ DATE,'
      '1101851755=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101851756=  IS_VOZVRAT_ INTEGER,'
      '1101851757=  HAVE_RIGHT_TO_SEE_COST_PRICE_ INTEGER = 0)'
      '1101851758=RETURNS ('
      '1101851759=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '1101851760=  SKLAD_PARENT TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1101851761=  DATE_RECEIPT TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '1101851762=  G_PRODUCT TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1101851763=  AMOUNT TYPE OF COLUMN SKLAD.AMOUNT,'
      '1101851764=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '1101851765=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1101851766=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1101851767=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1101851768=  NDS TYPE OF COLUMN SKLAD.NDS,'
      '1101851769=  NDS_SUMM TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1101851770=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101851771=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101851772=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101851773=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101851774=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101851775=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1101851776=  IS_VOZVRAT TYPE OF COLUMN SKLAD.IS_VOZVRAT)'
      '1101851777=AS'
      '1101851778=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1101851779=BEGIN'
      '1101851780='
      '1101851781=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1101851782=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1101851783=      IF (sklad_parent_ is null) THEN begin'
      '1101851784=        SELECT COUNT(*)'
      '1101851785=          FROM SKLAD_PARENT T'
      
        '1101851786=         WHERE T.date_receipt BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1101851787=          AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '1101851788=          AND T.IS_vozvrat <> 3'
      '1101851789=          INTO CNT_;'
      '1101851790='
      '1101851791=        if (CNT_ = 0) then'
      '1101851792=          SELECT MAX(T.date_receipt)'
      '1101851793=            FROM SKLAD_PARENT T'
      '1101851794=           WHERE T.date_receipt < :DATE_BEGIN_'
      '1101851795=             AND T.IS_vozvrat <> 3'
      
        '1101851796=             AND T.G_TOCHKA = (SELECT ID FROM CUR_PAR' +
        'AMS WHERE CUR_PARAMS = 2)'
      '1101851797=            INTO :DATE_BEGIN_;'
      '1101851798=      end'
      '1101851799='
      '1101851800=      FOR SELECT T.sklad sklad_detail,'
      '1101851801=               T.SKLAD_PARENT sklad,'
      '1101851802=               T.date_receipt,'
      '1101851803=               T.g_product,'
      '1101851804=               T.amount,'
      '1101851805=               T.PRICE,'
      '1101851806=               T.SUMM,'
      '1101851807=               T.PRICE_CURRENCY,'
      '1101851808=               T.SUMM_CURRENCY,'
      '1101851809=               T.nds,'
      '1101851810=               T.nds_summ,'
      '1101851811=               P.NAME PRODUCT_NAME,'
      '1101851812=               C.NAME CLIENT_NAME,'
      '1101851813=               PT.NAME PAYMENT_NAME,'
      '1101851814=               P.ARTICUL,'
      '1101851815=               P.NOMENCLATUR_NUM,'
      '1101851816=               P.BARCODE,'
      '1101851817=               T.IS_VOZVRAT'
      '1101851818=          FROM SKLAD T'
      
        '1101851819=               LEFT OUTER JOIN G_CLIENT C ON T.G_CLIE' +
        'NT = C.G_CLIENT'
      
        '1101851820=               LEFT OUTER JOIN G_PAYMENT_TYPE PT ON T' +
        '.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '1101851821=               G_PRODUCT P'
      
        '1101851822=         WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1101851823=           AND T.G_PRODUCT = P.G_PRODUCT'
      
        '1101851824=           AND ((T.IS_VOZVRAT = 0 AND :IS_VOZVRAT_ IS' +
        ' NULL)'
      
        '1101851825=                OR (T.IS_VOZVRAT IN (0, 5) AND :IS_VO' +
        'ZVRAT_ = 0)'
      
        '1101851826=                OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZ' +
        'VRAT_ IN (1,2))'
      '1101851827=               )'
      '1101851828=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1101851829=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1101851830=                OR'
      
        '1101851831=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1101851832=               )'
      '1101851833=        ORDER BY T.DATE_RECEIPT DESC'
      '1101851834=      INTO :sklad,'
      '1101851835=        :SKLAD_PARENT,'
      '1101851836=        :date_receipt,'
      '1101851837=        :g_product,'
      '1101851838=        :amount,'
      '1101851839=        :PRICE,'
      '1101851840=        :SUMM,'
      '1101851841=        :PRICE_CURRENCY,'
      '1101851842=        :SUMM_CURRENCY,'
      '1101851843=        :nds,'
      '1101851844=        :nds_summ,'
      '1101851845=        :PRODUCT_NAME,'
      '1101851846=        :CLIENT_NAME,'
      '1101851847=        :PAYMENT_NAME,'
      '1101851848=        :ARTICUL,'
      '1101851849=        :NOMENCLATUR_NUM,'
      '1101851850=        :BARCODE,'
      '1101851851=        :IS_VOZVRAT'
      '1101851852=      DO'
      '1101851853=        suspend;'
      '1101851854='
      '1101851855=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040
      '1101851856=  END ELSE BEGIN'
      '1101851857=    FOR SELECT T.SKLAD_PARENT,'
      '1101851858=               T.SKLAD,'
      '1101851859=               TR.DATE_RECEIPT,'
      '1101851860=               T.g_product,'
      '1101851861=               T.amount,'
      
        '1101851862=               DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_,' +
        ' 1, T.PRICE, 0),'
      
        '1101851863=               DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_,' +
        ' 1, T.SUMM, 0),'
      '1101851864=               P.NAME PRODUCT_NAME,'
      '1101851865=               G.NAME CLIENT_NAME,'
      '1101851866=               P.ARTICUL,'
      '1101851867=               P.NOMENCLATUR_NUM,'
      '1101851868=               P.BARCODE'
      
        '1101851869=          FROM SKLAD_PARENT TR LEFT OUTER JOIN G_TOCH' +
        'KA G ON TR.G_CLIENT = G.G_TOCHKA,'
      '1101851870=               SKLAD T,'
      '1101851871=               G_PRODUCT P'
      
        '1101851872=         WHERE TR.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '1101851873=           AND TR.SKLAD = T.SKLAD_PARENT'
      '1101851874=           AND T.G_PRODUCT = P.G_PRODUCT'
      '1101851875=           AND T.IS_VOZVRAT = 3'
      '1101851876=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '1101851877=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND ' +
        ':SKLAD_PARENT_ IS NOT NULL)'
      '1101851878=                OR'
      
        '1101851879=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '1101851880=               )'
      '1101851881=        ORDER BY TR.SKLAD DESC'
      '1101851882=      INTO :sklad,'
      '1101851883=        :SKLAD_PARENT,'
      '1101851884=        :date_receipt,'
      '1101851885=        :g_product,'
      '1101851886=        :amount,'
      '1101851887=        :PRICE,'
      '1101851888=        :SUMM,'
      '1101851889=        :PRODUCT_NAME,'
      '1101851890=        :CLIENT_NAME,'
      '1101851891=        :ARTICUL,'
      '1101851892=        :NOMENCLATUR_NUM,'
      '1101851893=        :BARCODE'
      '1101851894=      DO'
      '1101851895=        suspend;'
      '1101851896=  END'
      '1101851897=end'
      '1101851898=;'
      '1101851899='
      '1101851900=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST('
      '1101851901=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101851902=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101851903=  HAVE_RIGHT_TO_SEE_COST_PRICE_ INTEGER = 0)'
      '1101851904=RETURNS ('
      '1101851905=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ,'
      
        '1101851906=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS.ZAKAZ_DE' +
        'TAILS,'
      '1101851907=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS.G_PRODUCT,'
      '1101851908=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101851909=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '1101851910=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '1101851911=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_PERC,'
      
        '1101851912=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUN' +
        'T_TENGE,'
      
        '1101851913=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_SUMM,'
      '1101851914=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1101851915=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM,'
      '1101851916=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1101851917=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101851918=  ED_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '1101851919=  OSTATOK_SKLAD TYPE OF COLUMN SKLAD.AMOUNT)'
      '1101851920=AS'
      '1101851921=BEGIN'
      '1101851922='
      '1101851923=  FOR'
      '1101851924=    SELECT D.ZAKAZ,'
      '1101851925=           D.ZAKAZ_DETAILS,'
      '1101851926=           D.G_PRODUCT,'
      '1101851927=           D.AMOUNT,'
      '1101851928=           D.PRICE,'
      '1101851929=           D.SUMM,'
      '1101851930=           D.DISCOUNT_PERC,'
      '1101851931=           D.DISCOUNT_TENGE,'
      '1101851932=           D.DISCOUNT_SUMM,'
      '1101851933=           G.ARTICUL,'
      '1101851934=           G.NOMENCLATUR_NUM,'
      '1101851935=           G.BARCODE,'
      '1101851936=           G.NAME,'
      '1101851937=           COALESCE(GU.SHORT_NAME, GU.NAME),'
      '1101851938=           LT.AMOUNT OSTATOK_SKLAD'
      '1101851939=      FROM ZAKAZ_DETAILS D,'
      '1101851940=           G_PRODUCT G,'
      '1101851941=           G_UNIT GU,'
      '1101851942=           LT_SKLAD_PRODUCT LT'
      '1101851943=     WHERE D.ZAKAZ = :ZAKAZ_'
      '1101851944=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101851945=       AND LT.G_PRODUCT = G.G_PRODUCT'
      
        '1101851946=       AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1101851947=       AND G.G_UNIT = GU.G_UNIT'
      '1101851948=       AND :IS_SPISANIE_ <> 3'
      '1101851949=    UNION ALL'
      '1101851950=    SELECT D.SKLAD_PARENT ZAKAZ,'
      '1101851951=           D.SKLAD ZAKAZ_DETAILS,'
      '1101851952=           D.G_PRODUCT,'
      '1101851953=           D.AMOUNT,'
      
        '1101851954=           DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 1, ' +
        'D.PRICE, 0),'
      
        '1101851955=           DECODE(:HAVE_RIGHT_TO_SEE_COST_PRICE_, 1, ' +
        'D.SUMM, 0),'
      '1101851956=           0 DISCOUNT_PERC,'
      '1101851957=           0 DISCOUNT_TENGE,'
      '1101851958=           0 DISCOUNT_SUMM,'
      '1101851959=           G.ARTICUL,'
      '1101851960=           G.NOMENCLATUR_NUM,'
      '1101851961=           G.BARCODE,'
      '1101851962=           G.NAME,'
      '1101851963=           GU.NAME,'
      '1101851964=           LT.AMOUNT OSTATOK_SKLAD'
      '1101851965=      FROM SKLAD D,'
      '1101851966=           G_PRODUCT G,'
      '1101851967=           G_UNIT GU,'
      '1101851968=           LT_SKLAD_PRODUCT LT'
      '1101851969=     WHERE D.SKLAD_PARENT = :ZAKAZ_'
      '1101851970=       AND D.G_PRODUCT = G.G_PRODUCT'
      '1101851971=       AND LT.G_PRODUCT = G.G_PRODUCT'
      
        '1101851972=       AND LT.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1101851973=       AND G.G_UNIT = GU.G_UNIT'
      '1101851974=       AND :IS_SPISANIE_ = 3'
      '1101851975=    ORDER BY 1'
      '1101851976=    INTO  :ZAKAZ,'
      '1101851977=          :ZAKAZ_DETAILS,'
      '1101851978=          :G_PRODUCT,'
      '1101851979=          :AMOUNT,'
      '1101851980=          :PRICE,'
      '1101851981=          :SUMM,'
      '1101851982=          :DISCOUNT_PERC,'
      '1101851983=          :DISCOUNT_TENGE,'
      '1101851984=          :DISCOUNT_SUMM,'
      '1101851985=          :ARTICUL,'
      '1101851986=          :NOMENCLATUR_NUM,'
      '1101851987=          :BARCODE,'
      '1101851988=          :PRODUCT_NAME,'
      '1101851989=          :ED_NAME,'
      '1101851990=          :OSTATOK_SKLAD'
      '1101851991=  DO'
      '1101851992=    suspend;'
      '1101851993=end'
      '1101851994=;'
      '1101851995='
      '1101851996=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '1101851997=  DATE_BEGIN_ DATE,'
      '1101851998=  DATE_END_ DATE,'
      '1101851999=  IS_SPISANIE_ INTEGER)'
      '1101852000=RETURNS ('
      '1101852001=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101852002=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101852003=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '1101852004=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101852005=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101852006=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '1101852007=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101852008=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101852009=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1101852010=  DETAILS_STR VARCHAR(3000),'
      '1101852011=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101852012=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '1101852013=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '1101852014=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '1101852015=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1101852016=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101852017=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101852018=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101852019=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101852020=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '1101852021=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '1101852022=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101852023=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101852024=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1101852025=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1101852026=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS)'
      '1101852027=AS'
      '1101852028=/*'
      '1101852029=IS_SPISANIE_'
      '1101852030=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '1101852031=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '1101852032=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101852033=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058 +
        #1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101852034=*/'
      '1101852035=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1101852036=BEGIN'
      '1101852037='
      '1101852038=  if (IS_SPISANIE_ <> 3) then BEGIN'
      '1101852039=      SELECT COUNT(*)'
      '1101852040=        FROM ZAKAZ T'
      
        '1101852041=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '1101852042=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '1101852043=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '1101852044=        INTO CNT_;'
      '1101852045='
      '1101852046=      if (CNT_ = 0) then'
      '1101852047=        SELECT MAX(T.Z_DATE)'
      '1101852048=          FROM ZAKAZ T'
      '1101852049=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '1101852050=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '1101852051=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1101852052=          INTO :DATE_BEGIN_;'
      '1101852053='
      '1101852054=  END ELSE BEGIN'
      '1101852055=      SELECT COUNT(*)'
      '1101852056=        FROM SKLAD_PARENT T'
      
        '1101852057=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '1101852058=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '1101852059=        INTO CNT_;'
      '1101852060='
      '1101852061=      if (CNT_ = 0) then'
      '1101852062=        SELECT MAX(T.DATE_RECEIPT)'
      '1101852063=          FROM SKLAD_PARENT T'
      '1101852064=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '1101852065=           AND T.IS_VOZVRAT = 3'
      
        '1101852066=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1101852067=          INTO :DATE_BEGIN_;'
      '1101852068=  END'
      '1101852069='
      '1101852070=  -- '#1055#1056#1054#1044#1040#1046#1048
      '1101852071=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '1101852072=      FOR'
      '1101852073=        SELECT T.ZAKAZ,'
      
        '1101852074=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1101852075=               T.G_TOCHKA,'
      '1101852076=               T.Z_DATE,'
      '1101852077=               T.Z_TIME,'
      '1101852078=               T.G_CLIENT,'
      '1101852079=               T.OSNOVANIE,'
      '1101852080=               T.NOTE,'
      '1101852081=               gc.name,'
      
        '1101852082=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AM' +
        'OUNT||'#39')'#39', '#39', '#39')'
      
        '1101852083=                            FROM (SELECT G.name, SUM(' +
        'D.amount) AMOUNT'
      
        '1101852084=                                    FROM ZAKAZ Z, ZAK' +
        'AZ_DETAILS D, G_PRODUCT G'
      
        '1101852085=                                   WHERE D.G_PRODUCT ' +
        '= G.G_PRODUCT'
      
        '1101852086=                                     AND D.ZAKAZ = Z.' +
        'ZAKAZ'
      
        '1101852087=                                     AND Z.ZAKAZ = T.' +
        'ZAKAZ'
      '1101852088=                                   GROUP BY G.name)'
      
        '1101852089=                          ) FROM 1 FOR 1500)*/'#39' '#39' DET' +
        'AILS_STR,'
      '1101852090=               T.IS_SPISANIE,'
      
        '1101852091=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_A' +
        'LL,'
      '1101852092=               IP.INVOICE_PAY,'
      '1101852093=               I.INVOICE,'
      '1101852094=               W.WAYBILL,'
      '1101852095=               T.SUMM,'
      '1101852096=               T.SUMM_FACT,'
      '1101852097=               COALESCE(t.SUMM_BONUS, 0),'
      '1101852098=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '1101852099=               COALESCE(T.BY_RECIPE, 0)'
      '1101852100=               ,IS_RESERVE'
      '1101852101=               ,T.SUMM_CASH'
      '1101852102=               ,T.SUMM_NONCASH'
      '1101852103=               ,O.g_official'
      '1101852104=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '1101852105=               ,T.DELIVERY_ADDRESS'
      '1101852106=          FROM ZAKAZ T'
      
        '1101852107=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1101852108=                    LEFT OUTER JOIN INVOICE_PAY IP ON' +
        ' T.ZAKAZ = IP.ZAKAZ'
      
        '1101852109=                    LEFT OUTER JOIN INVOICE I ON T.ZA' +
        'KAZ = I.ZAKAZ'
      
        '1101852110=                    LEFT OUTER JOIN WAYBILL W ON T.ZA' +
        'KAZ = W.ZAKAZ'
      
        '1101852111=                    LEFT OUTER JOIN G_OFFICIAL O ON T' +
        '.g_official = O.g_official'
      
        '1101852112=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1101852113=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISA' +
        'NIE_ = 0) or (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS_SPISANIE_ <>' +
        ' 0))'
      
        '1101852114=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1101852115=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1101852116=        INTO :ZAKAZ,'
      '1101852117=             :Z_NUM,'
      '1101852118=             :G_TOCHKA,'
      '1101852119=             :Z_DATE,'
      '1101852120=             :Z_TIME,'
      '1101852121=             :G_CLIENT,'
      '1101852122=             :OSNOVANIE,'
      '1101852123=             :NOTE,'
      '1101852124=             :CLIENT_NAME,'
      '1101852125=             :DETAILS_STR,'
      '1101852126=             :IS_SPISANIE,'
      '1101852127=             :IS_PAYED_ALL,'
      '1101852128=             :INVOICE_PAY,'
      '1101852129=             :INVOICE,'
      '1101852130=             :WAYBILL,'
      '1101852131=             :SUM_ZAKAZ,'
      '1101852132=             :SUM_FACT,'
      '1101852133=             :SUMM_PAY_BONUS,'
      '1101852134=             :SUMM_BONUS_GOT,'
      '1101852135=             :BY_RECIPE'
      '1101852136=             ,:IS_RESERVE'
      '1101852137=             ,:summ_cash'
      '1101852138=             ,:SUMM_NONCASH'
      '1101852139=             ,:G_OFFICIAL'
      '1101852140=             ,:G_OFFICIAL_FIO'
      '1101852141=             ,:ADDRESS'
      '1101852142=      DO'
      '1101852143=        suspend;'
      '1101852144='
      '1101852145=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '1101852146=  END ELSE IF (IS_SPISANIE_ = 1) THEN BEGIN'
      '1101852147=      FOR'
      '1101852148=        SELECT T.ZAKAZ,'
      
        '1101852149=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1101852150=               T.G_TOCHKA,'
      '1101852151=               T.Z_DATE,'
      '1101852152=               T.Z_TIME,'
      '1101852153=               T.G_CLIENT,'
      '1101852154=               T.OSNOVANIE,'
      '1101852155=               T.NOTE,'
      '1101852156=               NULL,'
      '1101852157=               SUBSTRING((SELECT'
      
        '1101852158=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT|' +
        '|'#39')'#39', '#39', '#39')'
      
        '1101852159=                        FROM ZAKAZ_DETAILS D, G_PRODU' +
        'CT G'
      
        '1101852160=                        WHERE D.G_PRODUCT = G.G_PRODU' +
        'CT'
      '1101852161=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '1101852162=                          GROUP BY ZAKAZ) FROM 1 FOR ' +
        '999) DETAILS_STR,'
      '1101852163=               T.IS_SPISANIE,'
      '1101852164=               0,'
      '1101852165=               NULL,'
      '1101852166=               NULL,'
      '1101852167=               NULL,'
      '1101852168=               T.SUMM,'
      '1101852169=               T.SUMM_FACT,'
      '1101852170=               0,'
      '1101852171=               0'
      '1101852172=          FROM ZAKAZ T'
      
        '1101852173=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      '1101852174=           AND T.IS_SPISANIE  = 1'
      
        '1101852175=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1101852176=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '1101852177=        INTO :ZAKAZ,'
      '1101852178=             :Z_NUM,'
      '1101852179=             :G_TOCHKA,'
      '1101852180=             :Z_DATE,'
      '1101852181=             :Z_TIME,'
      '1101852182=             :G_CLIENT,'
      '1101852183=             :OSNOVANIE,'
      '1101852184=             :NOTE,'
      '1101852185=             :CLIENT_NAME,'
      '1101852186=             :DETAILS_STR,'
      '1101852187=             :IS_SPISANIE,'
      '1101852188=             :IS_PAYED_ALL,'
      '1101852189=             :INVOICE_PAY,'
      '1101852190=             :INVOICE,'
      '1101852191=             :WAYBILL,'
      '1101852192=             :SUM_ZAKAZ,'
      '1101852193=             :SUM_FACT,'
      '1101852194=             :SUMM_PAY_BONUS,'
      '1101852195=             :SUMM_BONUS_GOT'
      '1101852196=      DO'
      '1101852197=        suspend;'
      '1101852198='
      '1101852199=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101852200=  END ELSE BEGIN'
      '1101852201=      FOR'
      '1101852202=        SELECT T.SKLAD,'
      
        '1101852203=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', ' +
        #1042#1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '1101852204=               T.G_TOCHKA,'
      '1101852205=               T.DATE_RECEIPT,'
      '1101852206=               T.TIME_RECEIPT,'
      '1101852207=               T.G_CLIENT,'
      '1101852208=               T.OSNOVANIE,'
      '1101852209=               T.NOTE,'
      '1101852210=               gc.name,'
      '1101852211=               /*SUBSTRING((SELECT'
      
        '1101852212=                            LIST(G.NAME||'#39'('#39'||D.AMOUN' +
        'T||'#39')'#39', '#39', '#39')'
      '1101852213=                            FROM SKLAD D, G_PRODUCT G'
      
        '1101852214=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1101852215=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1101852216=                            GROUP BY SKLAD_PARENT) FR' +
        'OM 1 FOR 999)*/ '#39#39' DETAILS_STR,'
      '1101852217=               T.SUMM,'
      '1101852218=               T.IS_VOZVRAT,'
      '1101852219=               W.WAYBILL'
      
        '1101852220=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL' +
        ' W ON T.SKLAD = W.ZAKAZ,'
      '1101852221=               G_TOCHKA GC'
      
        '1101852222=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      
        '1101852223=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAM' +
        'S WHERE CUR_PARAMS = 2)'
      '1101852224=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '1101852225=           AND T.IS_VOZVRAT = 3'
      '1101852226=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '1101852227=        INTO :ZAKAZ,'
      '1101852228=             :Z_NUM,'
      '1101852229=             :G_TOCHKA,'
      '1101852230=             :Z_DATE,'
      '1101852231=             :Z_TIME,'
      '1101852232=             :G_CLIENT,'
      '1101852233=             :OSNOVANIE,'
      '1101852234=             :NOTE,'
      '1101852235=             :CLIENT_NAME,'
      '1101852236=             :DETAILS_STR,'
      '1101852237=             :SUM_ZAKAZ,'
      '1101852238=             :IS_SPISANIE,'
      '1101852239=             :WAYBILL'
      '1101852240=      DO'
      '1101852241=        suspend;'
      '1101852242=  END'
      '1101852243=end'
      '1101852244=;'
      '1101852245='
      '1101852246=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1101852247=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101852248=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101852249=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101852250=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101852251=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101852252=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101852253=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101852254=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1101852255=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1101852256=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1101852257=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1101852258=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1101852259=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1101852260=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1101852261=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1101852262=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101852263=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1101852264=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1101852265=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1101852266=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1101852267=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1101852268=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      
        '1101852269=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1101852270=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1101852271=RETURNS ('
      '1101852272=  ERR_CODE INTEGER,'
      '1101852273=  ERR_MSG VARCHAR(1024))'
      '1101852274=AS'
      '1101852275=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1101852276='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1101852277=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1101852278=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1101852279='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1101852280=*/'
      
        '1101852281=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1101852282=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101852283=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
