        '1102015170=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt > :DATE_END_ and not (sp.IS_VOZVRAT = 0 and sp.IS_EX' +
        'PECTED = 1))'
      '1102015171=                       -'
      
        '1102015172=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s, sklad_parent sp'
      
        '1102015173=                        where s.SKLAD_PARENT = sp.SKL' +
        'AD and s.g_product = G.G_PRODUCT and sp.is_vozvrat = 3'
      
        '1102015174=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39'-'#39'||SP.g_tochka||'#39'-'#39' and sp.date_receipt > :DATE_END_ and sp.I' +
        'S_EXPECTED = 0)'
      '1102015175=                  from rdb$database) AMOUNT_OUT'
      '1102015176=         FROM P_REP_TREE GP,'
      '1102015177=              G_PRODUCT G'
      '1102015178=         WHERE G.G_PRODUCT_PAR = GP.G_PRODUCT'
      '1102015179=           AND EXISTS (SELECT 1'
      '1102015180=                         FROM SKLAD SS'
      
        '1102015181=                        WHERE SS.DATE_RECEIPT BETWEEN' +
        ' :DATE_BEGIN_ AND :DATE_END_'
      
        '1102015182=                          AND SS.G_PRODUCT = G.G_PROD' +
