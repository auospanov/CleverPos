      '110163445=                    14, '#39#1053#1072#1089#1090#1088#1086#1081#1082#1080#39
      '110163446=                 ) ITEM_TYPE'
      '110163447='
      
        '110163448=      FROM LOG_OPER LO LEFT OUTER JOIN G_OFFICIAL G ON' +
        ' LO.G_OFFICIAL = G.G_OFFICIAL'
      
        '110163449=    WHERE CAST(LO.ODATE AS DATE) BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '110163450=    ORDER BY 2 DESC'
      '110163451=    INTO :LOG_OPER,'
      '110163452=        :ODATE,'
      '110163453=        :OPERATION,'
      '110163454=        :HEADER,'
      '110163455=        :G_OFFICIAL_FIO,'
      '110163456=        :ITEM_TYPE'
      '110163457=  DO'
      '110163458=    SUSPEND;'
      '110163459=END'
      '110163460=;'
      '110163461='
      '110163462='
      
        '110163463=UPDATE SYSTEM_SETUP SET S_VALUE = 110163 WHERE SYSTEM_' +
