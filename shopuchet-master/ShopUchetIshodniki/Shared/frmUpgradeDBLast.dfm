      '11013410='
      '11013411='
      
        '11013412=/******************************************************' +
        '************************/'
      
        '11013413=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11013414=/******************************************************' +
        '************************/'
      '11013415=ALTER PROCEDURE G_GET_G_PRODUCT_IMAGE('
      '11013416=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT)'
      '11013417=RETURNS ('
      '11013418=  IMG TYPE OF COLUMN G_PRODUCT_IMAGE.BODY,'
      '11013419=  PTYPE TYPE OF COLUMN G_PRODUCT_IMAGE.TYPE)'
      '11013420=AS'
      '11013421=begin'
      '11013422=    SELECT T.BODY,'
      '11013423=           T."TYPE"'
      '11013424=    FROM G_PRODUCT_IMAGE T'
      '11013425=    WHERE T.G_PRODUCT = :G_PRODUCT_'
      '11013426=    ORDER BY T.G_PRODUCT_IMAGE ROWS 1 TO 1'
      '11013427=    INTO'
      '11013428=        :IMG,'
      '11013429=        :PTYPE;'
      '11013430='
      '11013431=    SUSPEND;'
      '11013432=end'
      '11013433=;'
      
