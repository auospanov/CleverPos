      '110243614='
      '110243615=ALTER PROCEDURE G_NONCASH_PAY_TYPE_READ'
      '110243616=RETURNS ('
      
        '110243617=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE,'
      '110243618=  NAME TYPE OF COLUMN G_NONCASH_PAY_TYPE.NAME,'
      
        '110243619=  IS_ACTIVE TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_ACTIV' +
        'E,'
      
        '110243620=  IS_TIS_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE.IS_TIS' +
        '_TYPE,'
      
        '110243621=  POS_TERMINAL_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE.' +
        'POS_TERMINAL_TYPE)'
      '110243622=AS'
      '110243623=BEGIN'
      '110243624=  FOR SELECT G_NONCASH_PAY_TYPE,'
      '110243625=             NAME,'
