      '1103293='#39';'
      '1103294='
      '1103295='
      '1103296=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_GET_G_CLIENT('
      '1103297=  G_CLIENT_ INTEGER)'
      '1103298=RETURNS ('
      '1103299=  G_CLIENT_PARENT_ INTEGER,'
      '11032100=  G_CONTRAGENT_ INTEGER,'
      '11032101=  NAME_ VARCHAR(500),'
      '11032102=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11032103=  IDN_ VARCHAR(12),'
      '11032104=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11032105=  KBE_ VARCHAR(5),'
      '11032106=  SKIDKA_ NUMERIC(15,2),'
      '11032107=  BY_DEFAULT_ INTEGER,'
      '11032108=  IS_BEZNAL_ INTEGER,'
      '11032109=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11032110=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11032111=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '11032112=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '11032113=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11032114=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11032115=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11032116=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '11032117=  NOTIFY_SKIDKA_ INTEGER,'
      '11032118=  NOTIFY_DR_ INTEGER,'
      '11032119=  IS_PAYING_ONLY_MASTER_ INTEGER,'
      '11032120=  ERR_CODE INTEGER,'
      '11032121=  ERR_MSG VARCHAR(1024))'
      '11032122=AS'
      '11032123=begin'
      '11032124=    SELECT'
      
        '11032125=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE, ' +
        'SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '11032126=      ,P.G_PROMOTION'
      '11032127=      ,P.NAME'
      '11032128=      ,notify_dr'
      '11032129=      ,notify_skidka'
      
        '11032130=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T.' +
        'g_promotion = P.g_promotion'
      '11032131=    WHERE T.G_CLIENT = :G_CLIENT_'
      '11032132=    INTO'
      
        '11032133=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_,' +
        ' :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :DT' +
        '_, :NAME_FULL_'
      '11032134=      ,:G_PROMOTION_'
      '11032135=      ,:G_PROMOTION_STR_'
      '11032136=      ,:NOTIFY_DR_'
      '11032137=      ,:NOTIFY_SKIDKA_'
      '11032138=      ;'
      '11032139='
      '11032140=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '11032141=    FROM G_DISCONT_CARD'
      '11032142=    WHERE G_CLIENT = :G_CLIENT_'
      '11032143=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '11032144=end'
      '11032145='#39';'
      '11032146='
      '11032147=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_INS_G_CLIENT('
      '11032148=  G_CLIENT_PARENT_ INTEGER,'
      '11032149=  G_CONTRAGENT_ INTEGER,'
      '11032150=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11032151=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11032152=  IDN_ VARCHAR(12),'
      '11032153=  KBE_ VARCHAR(5),'
      '11032154=  SKIDKA_ NUMERIC(15,2),'
      '11032155=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11032156=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11032157=  BY_DEFAULT_ INTEGER,'
      '11032158=  IS_SUPPLIER_ INTEGER,'
      '11032159=  IS_CATEGORY_ INTEGER,'
      '11032160=  IS_BEZNAL_ INTEGER,'
      '11032161=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11032162=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11032163=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11032164=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11032165=  NOTIFY_SKIDKA_ INTEGER,'
      '11032166=  NOTIFY_DR_ INTEGER,'
      '11032167=  IS_PAYING_ONLY_MASTER_ INTEGER)'
      '11032168=RETURNS ('
      '11032169=  G_CLIENT_ INTEGER,'
      '11032170=  ERR_CODE INTEGER,'
      '11032171=  ERR_MSG VARCHAR(1024))'
      '11032172=AS'
      '11032173=declare variable CNT_ integer;'
      '11032174=begin'
      
        '11032175=    -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1' +
        ', '#1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11032176=    if (BY_DEFAULT_ = 1) then'
      '11032177=      UPDATE g_client'
      '11032178=         SET BY_DEFAULT = 0'
      '11032179=       WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11032180='
      
        '11032181=    insert into G_CLIENT (G_CLIENT, G_CLIENT_PARENT, G_' +
        'CONTRAGENT, NAME, IDN, KBE, SKIDKA, IS_SUPPLIER, BY_DEFAULT,'
      
        '11032182=                          IS_CATEGORY, IS_BEZNAL, PHONE' +
        ', NOTE, DT, NAME_FULL, G_PROMOTION, NOTIFY_SKIDKA, NOTIFY_DR)'
      
        '11032183=    values (GEN_ID(GEN_G_CLIENT, 1), :G_CLIENT_PARENT_,' +
        ' :G_CONTRAGENT_, :NAME_, :IDN_, :KBE_, :SKIDKA_, :IS_SUPPLIER_, ' +
        ':BY_DEFAULT_,'
      
        '11032184=            :IS_CATEGORY_, :IS_BEZNAL_, :PHONE_, :NOTE_' +
        ', :DT_, :NAME_FULL_, :G_PROMOTION_, :NOTIFY_SKIDKA_, :NOTIFY_DR_' +
        ')'
      '11032185=    returning G_CLIENT'
      '11032186=    into :G_CLIENT_;'
      '11032187='
      '11032188=    if (IS_CATEGORY_ = 0) then BEGIN'
      '11032189=        IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11032190=            SELECT COUNT(*)'
      '11032191=              FROM G_DISCONT_CARD'
      '11032192=             WHERE BARCODE = :BARCODE_'
      
        '11032193=             AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040 +
        #1049#1058#1048' '#1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11032194=             INTO :CNT_;'
      '11032195='
      '11032196=            IF (CNT_ > 0) THEN BEGIN'
      '11032197=              ERR_CODE = -20500;'
      
        '11032198=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39 +
        #39#1044#1080#1089#1082#1086#1085#1090#1085#1072#1103' '#1082#1072#1088#1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39 +
        #39') RETURNING_VALUES (:ERR_MSG);'
      '11032199=              EXIT;'
      '11032200=            END'
      '11032201=        END'
      '11032202='
      
        '11032203=        INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_C' +
        'LIENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11032204=        VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIEN' +
        'T_, :BARCODE_, :N_PERCENT_, 0, 0);'
      '11032205=    END'
      '11032206=end'
      '11032207='#39';'
      '11032208='
      '11032209=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_CLIENT('
      '11032210=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11032211=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      '11032212=  G_CONTRAGENT_ TYPE OF COLUMN G_CLIENT.G_CONTRAGENT,'
      '11032213=  NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11032214=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11032215=  IDN_ TYPE OF COLUMN G_CLIENT.IDN,'
      '11032216=  KBE_ TYPE OF COLUMN G_CLIENT.KBE,'
      '11032217=  SKIDKA_ TYPE OF COLUMN G_CLIENT.SKIDKA,'
      '11032218=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11032219=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '11032220=  IS_SUPPLIER_ TYPE OF COLUMN G_CLIENT.IS_SUPPLIER,'
      '11032221=  BY_DEFAULT_ TYPE OF COLUMN G_CLIENT.BY_DEFAULT,'
      '11032222=  IS_CATEGORY_ TYPE OF COLUMN G_CLIENT.IS_CATEGORY,'
      '11032223=  IS_BEZNAL_ TYPE OF COLUMN G_CLIENT.IS_BEZNAL,'
      '11032224=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11032225=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11032226=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '11032227=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '11032228=  NOTIFY_SKIDKA_ INTEGER,'
      '11032229=  NOTIFY_DR_ INTEGER,'
      '11032230=  IS_PAYING_ONLY_MASTER_ INTEGER)'
      '11032231=RETURNS ('
      '11032232=  ERR_CODE INTEGER,'
      '11032233=  ERR_MSG VARCHAR(1024))'
      '11032234=AS'
      '11032235=declare variable CNT_ integer;'
      '11032236=BEGIN'
      
        '11032237=  -- '#1045#1057#1051#1048' '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1057#1058#1040#1042#1048#1058#1057#1071' '#1043#1040#1051#1054#1063#1050#1040'  BY_DEFAULT = 1, ' +
        #1058#1054' '#1059#1041#1048#1056#1040#1070' '#1059' '#1044#1056#1059#1043#1048' '#1050#1051#1048#1045#1053#1058#1054#1042' ('#1055#1054#1057#1058#1040#1042#1065#1048#1050#1054#1042')'
      '11032238=  if (BY_DEFAULT_ = 1) then'
      '11032239=    UPDATE g_client'
      '11032240=       SET BY_DEFAULT = 0'
      '11032241=     WHERE IS_SUPPLIER = :IS_SUPPLIER_;'
      '11032242='
      '11032243=  UPDATE g_client'
      '11032244=  SET'
      
        '11032245=   G_CLIENT_PARENT = COALESCE(:G_CLIENT_PARENT_, G_CLIE' +
        'NT_PARENT),'
      
        '11032246=   G_CONTRAGENT    = COALESCE(:G_CONTRAGENT_, G_CONTRAG' +
        'ENT),'
      '11032247=   NAME = COALESCE(:NAME_, NAME),'
      '11032248=   IDN  = COALESCE(:IDN_, IDN),'
      '11032249=   KBE  = COALESCE(:KBE_, KBE),'
      '11032250=   PHONE = COALESCE(:PHONE_, PHONE),'
      '11032251=   SKIDKA = COALESCE(:SKIDKA_, SKIDKA),'
      '11032252=   IS_BEZNAL = COALESCE(:IS_BEZNAL_, IS_BEZNAL),'
      '11032253=   IS_SUPPLIER = COALESCE(:IS_SUPPLIER_, IS_SUPPLIER),'
      '11032254=   BY_DEFAULT = COALESCE(:BY_DEFAULT_, BY_DEFAULT)'
      '11032255=   ,DT    = COALESCE(:DT_, DT)'
      '11032256=   ,NOTE = COALESCE(:NOTE_, NOTE)'
      '11032257=   ,NAME_FULL = COALESCE(:NAME_FULL_, NAME_FULL)'
      '11032258=   ,G_PROMOTION = :G_PROMOTION_'
      '11032259=   ,NOTIFY_SKIDKA = :NOTIFY_SKIDKA_'
      '11032260=   ,NOTIFY_DR = :NOTIFY_DR_'
      '11032261=  WHERE'
      '11032262=    g_client = :g_client_;'
      '11032263='
      '11032264=  IF (IS_CATEGORY_ = 0) then BEGIN'
      '11032265=    IF (TRIM(BARCODE_) <> '#39#39#39#39') then BEGIN'
      '11032266=        SELECT COUNT(*)'
      '11032267=          FROM G_DISCONT_CARD'
      '11032268=         WHERE BARCODE = :BARCODE_'
      
        '11032269=         AND G_CLIENT <> :G_CLIENT_   -- '#1063#1058#1054#1041' '#1053#1045' '#1053#1040#1049#1058#1048' ' +
        #1057#1040#1052#1054#1043#1054' '#1057#1045#1041#1071
      '11032270=         INTO :CNT_;'
      '11032271='
      '11032272=        IF (CNT_ > 0) THEN BEGIN'
      '11032273=          ERR_CODE = -20500;'
      
        '11032274=          EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1050#1072#1088 +
        #1090#1086#1095#1082#1072' '#1089' '#1085#1086#1084#1077#1088#1086#1084' '#39#39'||BARCODE_||'#39#39' '#1091#1078#1077' '#1077#1089#1090#1100' '#1074' '#1073#1072#1079#1077#39#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '11032275=          EXIT;'
      '11032276=        END'
      '11032277=    END'
      '11032278='
      '11032279=    UPDATE G_DISCONT_CARD G'
      '11032280=    SET G.BARCODE = :BARCODE_,'
      '11032281=        G.N_PERCENT = :N_PERCENT_,'
      '11032282=        G.summ = COALESCE(G.summ, 0),'
      '11032283=        G.summ_all = COALESCE(G.summ_all, 0)'
      '11032284=    WHERE G.G_CLIENT = :g_client_;'
      '11032285='
      '11032286=    if (ROW_COUNT = 0) then'
      
        '11032287=      INSERT INTO G_DISCONT_CARD (G_DISCONT_CARD, G_CLI' +
        'ENT, BARCODE, N_PERCENT, SUMM, SUMM_ALL)'
      
        '11032288=      VALUES (GEN_ID(GEN_G_DISCONT_CARD, 1), :G_CLIENT_' +
        ', :BARCODE_, :N_PERCENT_, 0, (select Coalesce(sum(SUMM_FACT), 0)' +
        ' from zakaz where g_client = :g_client_));'
      '11032289=  END'
      '11032290=end'
      '11032291='#39';'
      '11032292='
      '11032293=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_LIST('
      '11032294=  DATE_BEGIN_ DATE,'
      '11032295=  DATE_END_ DATE,'
      '11032296=  IS_SPISANIE_ INTEGER)'
      '11032297=RETURNS ('
      '11032298=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11032299=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11032300=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '11032301=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11032302=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11032303=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '11032304=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11032305=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '11032306=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11032307=  DETAILS_STR VARCHAR(3000),'
      '11032308=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '11032309=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '11032310=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '11032311=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '11032312=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '11032313=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '11032314=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '11032315=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11032316=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11032317=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '11032318=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '11032319=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '11032320=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '11032321=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11032322=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC)'
      '11032323=AS'
      '11032324=/*'
      '11032325=IS_SPISANIE_'
      '11032326=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '11032327=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '11032328=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '11032329=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054' ' +
        #1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11032330=*/'
      '11032331=declare variable CNT_ integer = 0;'
      '11032332=BEGIN'
      '11032333='
      '11032334=  if (IS_SPISANIE_ <> 3) then BEGIN'
      '11032335=      SELECT COUNT(*)'
      '11032336=        FROM ZAKAZ T'
      
        '11032337=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      
        '11032338=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WHE' +
        'RE CUR_PARAMS = 2)'
      '11032339=        AND T.IS_SPISANIE = :IS_SPISANIE_'
      '11032340=        INTO CNT_;'
      '11032341='
      '11032342=      if (CNT_ = 0) then'
      '11032343=        SELECT MAX(T.Z_DATE)'
      '11032344=          FROM ZAKAZ T'
      '11032345=         WHERE T.Z_DATE < :DATE_BEGIN_'
      '11032346=           AND T.IS_SPISANIE = :IS_SPISANIE_'
      
        '11032347=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032348=          INTO :DATE_BEGIN_;'
      '11032349='
      '11032350=  END ELSE BEGIN'
      '11032351=      SELECT COUNT(*)'
      '11032352=        FROM SKLAD_PARENT T'
      
        '11032353=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '11032354=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '11032355=        INTO CNT_;'
      '11032356='
      '11032357=      if (CNT_ = 0) then'
      '11032358=        SELECT MAX(T.DATE_RECEIPT)'
      '11032359=          FROM SKLAD_PARENT T'
      '11032360=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '11032361=           AND T.IS_VOZVRAT = 3'
      
        '11032362=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032363=          INTO :DATE_BEGIN_;'
      '11032364=  END'
      '11032365='
      '11032366=  -- '#1055#1056#1054#1044#1040#1046#1048
      '11032367=  IF (IS_SPISANIE_ IN (0,2,4)) THEN BEGIN'
      '11032368=      FOR'
      '11032369=        SELECT T.ZAKAZ,'
      
        '11032370=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11032371=               T.G_TOCHKA,'
      '11032372=               T.Z_DATE,'
      '11032373=               T.Z_TIME,'
      '11032374=               T.G_CLIENT,'
      '11032375=               T.OSNOVANIE,'
      '11032376=               T.NOTE,'
      '11032377=               gc.name,'
      
        '11032378=               /*SUBSTRING((SELECT LIST(NAME||'#39#39'('#39#39'||AM' +
        'OUNT||'#39#39')'#39#39', '#39#39', '#39#39')'
      
        '11032379=                            FROM (SELECT G.name, SUM(D.' +
        'amount) AMOUNT'
      
        '11032380=                                    FROM ZAKAZ Z, ZAKAZ' +
        '_DETAILS D, G_PRODUCT G'
      
        '11032381=                                   WHERE D.G_PRODUCT = ' +
        'G.G_PRODUCT'
      
        '11032382=                                     AND D.ZAKAZ = Z.ZA' +
        'KAZ'
      
        '11032383=                                     AND Z.ZAKAZ = T.ZA' +
        'KAZ'
      '11032384=                                   GROUP BY G.name)'
      
        '11032385=                          ) FROM 1 FOR 1500)*/'#39#39' '#39#39' DET' +
        'AILS_STR,'
      '11032386=               T.IS_SPISANIE,'
      
        '11032387=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_ALL' +
        ','
      '11032388=               IP.INVOICE_PAY,'
      '11032389=               I.INVOICE,'
      '11032390=               W.WAYBILL,'
      '11032391=               T.SUMM,'
      '11032392=               T.SUMM_FACT,'
      '11032393=               COALESCE(t.SUMM_BONUS, 0),'
      '11032394=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '11032395=               COALESCE(T.BY_RECIPE, 0)'
      '11032396=               ,IS_RESERVE'
      '11032397=               ,T.SUMM_CASH'
      '11032398=               ,T.SUMM_NONCASH'
      '11032399=               ,O.g_official'
      '11032400=               ,COALESCE(O.fio_doc, O.FM||'#39#39' '#39#39'||O.nm)'
      '11032401=          FROM ZAKAZ T'
      
        '11032402=                    LEFT OUTER JOIN G_CLIENT GC ON T.G_' +
        'CLIENT = GC.G_CLIENT'
      
        '11032403=                    LEFT OUTER JOIN INVOICE_PAY IP ON T' +
        '.ZAKAZ = IP.ZAKAZ'
      
        '11032404=                    LEFT OUTER JOIN INVOICE I ON T.ZAKA' +
        'Z = I.ZAKAZ'
      
        '11032405=                    LEFT OUTER JOIN WAYBILL W ON T.ZAKA' +
        'Z = W.ZAKAZ'
      
        '11032406=                    LEFT OUTER JOIN G_OFFICIAL O ON T.g' +
        '_official = O.g_official'
      
        '11032407=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11032408=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISANI' +
        'E_ = 0) or (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS_SPISANIE_ <> 0' +
        '))'
      
        '11032409=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032410=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '11032411=        INTO :ZAKAZ,'
      '11032412=             :Z_NUM,'
      '11032413=             :G_TOCHKA,'
      '11032414=             :Z_DATE,'
      '11032415=             :Z_TIME,'
      '11032416=             :G_CLIENT,'
      '11032417=             :OSNOVANIE,'
      '11032418=             :NOTE,'
      '11032419=             :CLIENT_NAME,'
      '11032420=             :DETAILS_STR,'
      '11032421=             :IS_SPISANIE,'
      '11032422=             :IS_PAYED_ALL,'
      '11032423=             :INVOICE_PAY,'
      '11032424=             :INVOICE,'
      '11032425=             :WAYBILL,'
      '11032426=             :SUM_ZAKAZ,'
      '11032427=             :SUM_FACT,'
      '11032428=             :SUMM_PAY_BONUS,'
      '11032429=             :SUMM_BONUS_GOT,'
      '11032430=             :BY_RECIPE'
      '11032431=             ,:IS_RESERVE'
      '11032432=             ,:summ_cash'
      '11032433=             ,:SUMM_NONCASH'
      '11032434=             ,:G_OFFICIAL'
      '11032435=             ,:G_OFFICIAL_FIO'
      '11032436=      DO'
      '11032437=        suspend;'
      '11032438='
      '11032439=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '11032440=  END ELSE IF (IS_SPISANIE_ = 1) THEN BEGIN'
      '11032441=      FOR'
      '11032442=        SELECT T.ZAKAZ,'
      
        '11032443=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11032444=               T.G_TOCHKA,'
      '11032445=               T.Z_DATE,'
      '11032446=               T.Z_TIME,'
      '11032447=               T.G_CLIENT,'
      '11032448=               T.OSNOVANIE,'
      '11032449=               T.NOTE,'
      '11032450=               NULL,'
      '11032451=               SUBSTRING((SELECT'
      
        '11032452=                          LIST(G.NAME||'#39#39'('#39#39'||D.AMOUNT|' +
        '|'#39#39')'#39#39', '#39#39', '#39#39')'
      
        '11032453=                        FROM ZAKAZ_DETAILS D, G_PRODUCT' +
        ' G'
      '11032454=                        WHERE D.G_PRODUCT = G.G_PRODUCT'
      '11032455=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '11032456=                          GROUP BY ZAKAZ) FROM 1 FOR 99' +
        '9) DETAILS_STR,'
      '11032457=               T.IS_SPISANIE,'
      '11032458=               0,'
      '11032459=               NULL,'
      '11032460=               NULL,'
      '11032461=               NULL,'
      '11032462=               T.SUMM,'
      '11032463=               T.SUMM_FACT,'
      '11032464=               0,'
      '11032465=               0'
      '11032466=          FROM ZAKAZ T'
      
        '11032467=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '11032468=           AND T.IS_SPISANIE  = 1'
      
        '11032469=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032470=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '11032471=        INTO :ZAKAZ,'
      '11032472=             :Z_NUM,'
      '11032473=             :G_TOCHKA,'
      '11032474=             :Z_DATE,'
      '11032475=             :Z_TIME,'
      '11032476=             :G_CLIENT,'
      '11032477=             :OSNOVANIE,'
      '11032478=             :NOTE,'
      '11032479=             :CLIENT_NAME,'
      '11032480=             :DETAILS_STR,'
      '11032481=             :IS_SPISANIE,'
      '11032482=             :IS_PAYED_ALL,'
      '11032483=             :INVOICE_PAY,'
      '11032484=             :INVOICE,'
      '11032485=             :WAYBILL,'
      '11032486=             :SUM_ZAKAZ,'
      '11032487=             :SUM_FACT,'
      '11032488=             :SUMM_PAY_BONUS,'
      '11032489=             :SUMM_BONUS_GOT'
      '11032490=      DO'
      '11032491=        suspend;'
      '11032492='
      '11032493=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '11032494=  END ELSE BEGIN'
      '11032495=      FOR'
      '11032496=        SELECT T.SKLAD,'
      
        '11032497=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042#1044 +
        #1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '11032498=               T.G_TOCHKA,'
      '11032499=               T.DATE_RECEIPT,'
      '11032500=               T.TIME_RECEIPT,'
      '11032501=               T.G_CLIENT,'
      '11032502=               T.OSNOVANIE,'
      '11032503=               T.NOTE,'
      '11032504=               gc.name,'
      '11032505=               SUBSTRING((SELECT'
      
        '11032506=                            LIST(G.NAME||'#39#39'('#39#39'||D.AMOUN' +
        'T||'#39#39')'#39#39', '#39#39', '#39#39')'
      '11032507=                            FROM SKLAD D, G_PRODUCT G'
      
        '11032508=                           WHERE D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '11032509=                             AND D.SKLAD_PARENT = T.SKL' +
        'AD'
      
        '11032510=                            GROUP BY SKLAD_PARENT) FROM' +
        ' 1 FOR 999) DETAILS_STR,'
      '11032511=               T.SUMM,'
      '11032512=               T.IS_VOZVRAT,'
      '11032513=               W.WAYBILL'
      
        '11032514=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL W' +
        ' ON T.SKLAD = W.ZAKAZ,'
      '11032515=               G_TOCHKA GC'
      
        '11032516=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      
        '11032517=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11032518=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '11032519=           AND T.IS_VOZVRAT = 3'
      '11032520=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '11032521=        INTO :ZAKAZ,'
      '11032522=             :Z_NUM,'
      '11032523=             :G_TOCHKA,'
      '11032524=             :Z_DATE,'
      '11032525=             :Z_TIME,'
      '11032526=             :G_CLIENT,'
      '11032527=             :OSNOVANIE,'
      '11032528=             :NOTE,'
      '11032529=             :CLIENT_NAME,'
      '11032530=             :DETAILS_STR,'
      '11032531=             :SUM_ZAKAZ,'
      '11032532=             :IS_SPISANIE,'
      '11032533=             :WAYBILL'
      '11032534=      DO'
      '11032535=        suspend;'
      '11032536=  END'
      '11032537=end'
      '11032538='#39';'
      '11032539=END  --END_EXECUTE_BLOCK'
      '110330=EXECUTE BLOCK AS BEGIN'
      '110331=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      
        '110332=  SKLAD_PARENT_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */ I' +
        'NTEGER,'
      '110333=  CURRENCY_ INTEGER)'
      '110334=RETURNS ('
      '110335=  NUMBER_STR_ VARCHAR(200),'
      '110336=  ROW_NUM INTEGER,'
      '110337=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '110338=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR(' +
        '30),'
      
        '110339=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR(' +
        '30),'
      
        '1103310=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      
        '1103311=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      '1103312=  AMOUNT VARCHAR(50),'
      '1103313=  PRICE_N VARCHAR(50),'
      '1103314=  SUMM_N VARCHAR(50),'
      '1103315=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1103316=  SUMM_VSEGO_ VARCHAR(50),'
      
        '1103317=  G_OFFICIAL_FM_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */' +
        ' VARCHAR(150),'
      
        '1103318=  POSTAVSHIK_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VA' +
        'RCHAR(250),'
      '1103319=  SUMM_STR_ VARCHAR(500),'
      '1103320=  ERR_CODE NUMERIC(15,2),'
      '1103321=  ERR_MSG VARCHAR(1024))'
      '1103322=AS'
      '1103323=BEGIN'
      '1103324=  SUSPEND;'
      '1103325=END'
      '1103326='#39';'
      '1103327='
      
        '1103328=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRODAZHA_WAYBIL' +
        'L('
      '1103329=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ INTEGER,'
      '1103330=  CURRENCY_ INTEGER)'
      '1103331=RETURNS ('
      '1103332=  NUMBER_STR_ VARCHAR(200),'
      '1103333=  ROW_NUM INTEGER,'
      '1103334=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1103335=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1103336=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '1103337=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLATU' +
        'R_NUM */ VARCHAR(150),'
      
        '1103338=  SHORT_NAME /* TYPE OF COLUMN G_UNIT.NAME */ VARCHAR(50' +
        '),'
      '1103339=  AMOUNT VARCHAR(50),'
      '1103340=  PRICE_N VARCHAR(50),'
      '1103341=  SUMM_N VARCHAR(50),'
      '1103342=  AMOUNT_VSEGO_ VARCHAR(50),'
      '1103343=  SUMM_VSEGO_ VARCHAR(50),'
      '1103344=  NDS_SUMM_ VARCHAR(50),'
      
        '1103345=  G_OFFICIAL_FM_ /* TYPE OF COLUMN G_OFFICIAL.FIO_DOC */' +
        ' VARCHAR(150),'
      
        '1103346=  CLIENT_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHA' +
        'R(250),'
      '1103347=  SUMM_STR_ VARCHAR(500),'
      '1103348=  NDS_SUMM_STR_ VARCHAR(500),'
      '1103349=  ERR_CODE NUMERIC(15,2),'
      '1103350=  ERR_MSG VARCHAR(1024))'
      '1103351=AS'
      '1103352=BEGIN'
      '1103353=  SUSPEND;'
      '1103354=END'
      '1103355='#39';'
      '1103356='
      '1103357='
      
        '1103358=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_DEL_G_PRIHOD_RASHOD' +
        '('
      
        '1103359=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIH' +
        'OD_RASHOD)'
      '1103360=RETURNS ('
      '1103361=  ERR_CODE INTEGER,'
      '1103362=  ERR_MSG VARCHAR(1024))'
      '1103363=AS'
      '1103364=DECLARE VARIABLE PROCNAME VARCHAR(30);'
      '1103365=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1103366=begin'
      '1103367=  PROCNAME = '#39#39'G_DEL_G_PRIHOD_RASHOD'#39#39';'
      '1103368='
      '1103369=  if (G_PRIHOD_RASHOD_ in (0, 1, 2, 3, 4)) then begin'
      '1103370=    ERR_CODE = -20500;'
      
        '1103371=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1044#1072#1085#1085#1072#1103' '#1079#1072#1087 +
        #1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1059#1076#1072#1083#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      '1103372=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1103373=    EXIT;'
      '1103374=  end'
      '1103375='
      '1103376=  delete from G_PRIHOD_RASHOD g'
      '1103377=    where g.G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_;'
      '1103378='
      '1103379=when sqlcode -530 DO'
      '1103380=  begin'
      '1103381=    ERR_CODE = -20500;'
      
        '1103382=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081' '#1089 +
        #1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '1103383=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1103384=  end'
      '1103385=end'
      '1103386='#39';'
      '1103387='
      
        '1103388=EXECUTE STATEMENT '#39'ALTER PROCEDURE G_UPD_G_PRIHOD_RASHOD' +
        '('
      
        '1103389=  G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIH' +
        'OD_RASHOD,'
      '1103390=  ACTION_ TYPE OF COLUMN G_PRIHOD_RASHOD.DO_ACTION,'
      '1103391=  NAME_ TYPE OF COLUMN G_PRIHOD_RASHOD.NAME)'
      '1103392=RETURNS ('
      '1103393=  ERR_CODE INTEGER,'
      '1103394=  ERR_MSG VARCHAR(1024))'
      '1103395=AS'
      '1103396=begin'
      '1103397=  if (G_PRIHOD_RASHOD_ in (0)) then begin'
      '1103398=    ERR_CODE = -20500;'
      
        '1103399=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1044#1072#1085#1085#1072#1103' '#1079#1072#1087 +
        #1080#1089#1100' '#1103#1074#1083#1103#1077#1090#1089#1103' '#1089#1080#1089#1090#1077#1084#1085#1086#1081'. '#1048#1079#1084#1077#1085#1077#1085#1080#1077' '#1085#1077#1074#1086#1079#1084#1086#1078#1085#1086'!'#39#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      '11033100=    EXIT;'
      '11033101=  end'
      '11033102='
      '11033103=  UPDATE G_PRIHOD_RASHOD'
      '11033104=  SET'
      '11033105=   DO_ACTION = :ACTION_,'
      '11033106=   NAME = :NAME_'
      '11033107=  WHERE'
      '11033108=    G_PRIHOD_RASHOD = :G_PRIHOD_RASHOD_;'
      '11033109=end'
      '11033110='#39';'
      '11033111='
      '11033112=EXECUTE STATEMENT '#39'ALTER PROCEDURE GET_LAST_SELF_PRICE('
      '11033113=  G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '11033114=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11033115=  MODE_ INTEGER)'
      '11033116=RETURNS ('
      '11033117=  PRICE_ TYPE OF COLUMN SKLAD.PRICE)'
      '11033118=AS'
      
        '11033119=declare variable FORMULA_ type of column SYSTEM_SETUP.S' +
        '_VALUE;'
      '11033120=BEGIN'
      '11033121=  IF (G_TOCHKA_ IS NULL) THEN'
      '11033122=    SELECT ID'
      '11033123=      FROM CUR_PARAMS'
      '11033124=     WHERE CUR_PARAMS = 2'
      '11033125=      INTO :G_TOCHKA_;'
      '11033126='
      '11033127=  if (COALESCE(MODE_, 0) = 0) then'
      '11033128=      SELECT S.PRICE'
      '11033129=        FROM SKLAD S'
      '11033130=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '11033131=         AND S.IS_LAST = 1'
      '11033132=         AND S.G_PRODUCT = :G_PRODUCT_'
      '11033133=        INTO :PRICE_;'
      '11033134='
      
        '11033135=  -- '#1045#1057#1051#1048' '#1048#1044#1045#1058' '#1055#1056#1054#1044#1040#1046#1040', '#1058#1054' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1042' '#1047#1040 +
        #1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' '#1060#1054#1056#1052#1059#1051#1067' '#1042' '#1053#1040#1057#1058#1056#1054#1049#1050#1040#1061
      '11033136=  ELSE BEGIN'
      '11033137=    SELECT S.S_VALUE'
      '11033138=      FROM SYSTEM_SETUP S'
      '11033139=     WHERE S.SYSTEM_SETUP = 1'
      '11033140=      INTO :FORMULA_;'
      '11033141='
      '11033142=    IF (FORMULA_ = 1) THEN BEGIN'
      '11033143=      SELECT S.PRICE'
      '11033144=        FROM SKLAD S'
      '11033145=       WHERE S.G_TOCHKA = :G_TOCHKA_'
      '11033146=         AND S.IS_LAST = 1'
      '11033147=         AND S.G_PRODUCT = :G_PRODUCT_'
      '11033148=        INTO :PRICE_;'
      '11033149=      IF (ROW_COUNT = 0) THEN'
      '11033150=        SELECT S.PRICE'
      '11033151=          FROM SKLAD S'
      '11033152=         WHERE S.SKLAD = (SELECT MAX(SS.SKLAD)'
      '11033153=                            FROM SKLAD SS'
      
        '11033154=                           WHERE SS.G_TOCHKA = :G_TOCHK' +
        'A_'
      
        '11033155=                             AND SS.G_PRODUCT = :G_PROD' +
        'UCT_'
      
        '11033156=                             AND SS.DATE_RECEIPT = (SEL' +
        'ECT MAX(SSS.DATE_RECEIPT)'
      
        '11033157=                                                      F' +
        'ROM SKLAD SSS'
      
        '11033158=                                                     WH' +
        'ERE SSS.G_TOCHKA = :G_TOCHKA_'
      
        '11033159=                                                       ' +
        'AND SSS.G_PRODUCT = :G_PRODUCT_'
      
        '11033160=                                                       ' +
        'AND SSS.IS_VOZVRAT IN (0, 3, 4))'
      
        '11033161=                             AND SS.IS_VOZVRAT IN (0, 3' +
        ', 4)'
      '11033162=                         )'
      '11033163=          INTO :PRICE_;'
      '11033164=    END ELSE'
      
        '11033165=      SELECT ROUND(SUM(T.AMOUNT * T.PRICE)/SUM(T.AMOUNT' +
        '), 2)'
      '11033166=        FROM (SELECT S.AMOUNT, S.PRICE'
      '11033167=                FROM SKLAD_PARENT SP,'
      '11033168=                     SKLAD S'
      '11033169=               WHERE SP.G_TOCHKA = :G_TOCHKA_'
      '11033170=                 AND SP.DATE_RECEIPT <= CURRENT_DATE'
      '11033171=                 AND SP.SKLAD = S.SKLAD_PARENT'
      '11033172=                 AND S.G_PRODUCT = :G_PRODUCT_'
      '11033173=                 AND SP.IS_VOZVRAT IN (0, 3, 4)'
      
        '11033174=                ORDER BY S.DATE_RECEIPT DESC ROWS 1 TO ' +
        '5) T'
      '11033175=        INTO :PRICE_;'
      '11033176=  END'
      '11033177='
      '11033178=  PRICE_ = COALESCE(:PRICE_, 0);'
      '11033179=  SUSPEND;'
      '11033180=END'
      '11033181='#39';'
      '11033182='
      
        '11033183=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRIHOD_WAYBILL' +
        '('
      '11033184=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11033185=  CURRENCY_ INTEGER)'
      '11033186=RETURNS ('
      '11033187=  NUMBER_STR_ VARCHAR(200),'
      '11033188=  ROW_NUM INTEGER,'
      '11033189=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11033190=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11033191=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11033192=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11033193=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11033194=  AMOUNT VARCHAR(50),'
      '11033195=  PRICE_N VARCHAR(50),'
      '11033196=  SUMM_N VARCHAR(50),'
      '11033197=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11033198=  SUMM_VSEGO_ VARCHAR(50),'
      '11033199=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11033200=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11033201=  SUMM_STR_ VARCHAR(500),'
      '11033202=  ERR_CODE NUMERIC(15,2),'
      '11033203=  ERR_MSG VARCHAR(1024))'
      '11033204=AS'
      '11033205=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '11033206=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRIHOD_' +
        'WAYBILL'#39#39';'
      '11033207=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11033208=DECLARE VARIABLE I INTEGER = 1;'
      
        '11033209=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      '11033210=BEGIN'
      '11033211='
      
        '11033212=  SELECT '#39#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39#39'||P.sklad||'#39#39' '#1086#1090' '#39#39'||lpad(EXTRA' +
        'CT(DAY FROM P.date_receipt), 2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONT' +
        'H FROM P.date_receipt), 2, 0)||'#39#39'.'#39#39'||EXTRACT(YEAR FROM P.date_r' +
        'eceipt),'
      '11033213=         G.name'
      
        '11033214=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON P' +
        '.g_client = G.G_CLIENT'
      '11033215=   WHERE P.sklad = :sklad_parent_'
      '11033216=    INTO :NUMBER_STR_,'
      '11033217=         :POSTAVSHIK_NAME_;'
      '11033218='
      
        '11033219=  SELECT REPLACE(CAST(SUM(S.amount) AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39')'
      
        '11033220=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39')'
      
        '11033221=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ)' +
        ', :CURRENCY_))'
      '11033222=    FROM SKLAD S'
      '11033223=   WHERE S.sklad_parent = :sklad_parent_'
      '11033224=   GROUP BY S.sklad_parent'
      '11033225=    INTO :AMOUNT_VSEGO_,'
      '11033226=         :SUMM_VSEGO_,'
      '11033227=         :summ_str_;'
      '11033228='
      '11033229=  SELECT NAME'
      '11033230=    FROM CUR_PARAMS'
      '11033231=   WHERE CUR_PARAMS = 1'
      '11033232=    INTO :G_OFFICIAL_FM_;'
      '11033233='
      '11033234=  FOR SELECT :I,'
      '11033235=             G.name,'
      '11033236=             G.ARTICUL,'
      '11033237=             G.BARCODE,'
      '11033238=             G.NOMENCLATUR_NUM,'
      '11033239=             U.short_name,'
      
        '11033240=             REPLACE(CAST(S.amount AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39'),'
      
        '11033241=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39#39'.'#39 +
        #39', '#39#39','#39#39'),'
      
        '11033242=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39#39'.'#39#39 +
        ', '#39#39','#39#39')'
      '11033243=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '11033244=       WHERE S.sklad_parent = :sklad_parent_'
      '11033245=         AND S.g_product = G.g_product'
      '11033246=         AND G.g_unit = U.g_unit'
      '11033247=        INTO :ROW_NUM,'
      '11033248=            :NAME,'
      '11033249=            :ARTICUL,'
      '11033250=            :BARCODE,'
      '11033251=            :NOMENCLATUR_NUM,'
      '11033252=            :SHORT_NAME,'
      '11033253=            :AMOUNT,'
      '11033254=            :PRICE_N,'
      '11033255=            :SUMM_N'
      '11033256=  DO BEGIN'
      '11033257=    I = I + 1;'
      '11033258=    SUSPEND;'
      '11033259=  END'
      '11033260=WHEN ANY DO BEGIN'
      '11033261=    Err_code = -20500;'
      
        '11033262=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11033263=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11033264=  END'
      '11033265=end'
      '11033266='#39';'
      '11033267='
      
        '11033268=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PRODAZHA_WAYBI' +
        'LL('
      '11033269=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11033270=  CURRENCY_ INTEGER)'
      '11033271=RETURNS ('
      '11033272=  NUMBER_STR_ VARCHAR(200),'
      '11033273=  ROW_NUM INTEGER,'
      '11033274=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11033275=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11033276=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11033277=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11033278=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11033279=  AMOUNT VARCHAR(50),'
      '11033280=  PRICE_N VARCHAR(50),'
      '11033281=  SUMM_N VARCHAR(50),'
      '11033282=  AMOUNT_VSEGO_ VARCHAR(50),'
      '11033283=  SUMM_VSEGO_ VARCHAR(50),'
      '11033284=  NDS_SUMM_ VARCHAR(50),'
      '11033285=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11033286=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11033287=  SUMM_STR_ VARCHAR(500),'
      '11033288=  NDS_SUMM_STR_ VARCHAR(500),'
      '11033289=  ERR_CODE NUMERIC(15,2),'
      '11033290=  ERR_MSG VARCHAR(1024))'
      '11033291=AS'
      '11033292=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '11033293=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PRODAZH' +
        'A_WAYBILL'#39#39';'
      '11033294=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11033295=DECLARE VARIABLE I INTEGER = 1;'
      
        '11033296=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11033297=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS_' +
        'SUMM;'
      '11033298=BEGIN'
      '11033299='
      
        '11033300=  SELECT decode(P.is_spisanie, 1, '#39#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39#39', '#39#39#1053#1072#1082#1083 +
        #1072#1076#1085#1072#1103' '#8470#39#39'||P.ZAKAZ)||'#39#39' '#1086#1090' '#39#39'||lpad(EXTRACT(DAY FROM P.z_date), ' +
        '2, '#39#39'0'#39#39')||'#39#39'.'#39#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39#39'.'#39 +
        #39'||EXTRACT(YEAR FROM P.z_date),'
      '11033301=         G.name'
      '11033302=    FROM ZAKAZ P,'
      '11033303=         G_CLIENT G'
      '11033304=   WHERE P.ZAKAZ = :ZAKAZ_'
      '11033305=     AND P.g_client = G.G_CLIENT'
      '11033306=    INTO :NUMBER_STR_,'
      '11033307=         :CLIENT_NAME_;'
      '11033308='
      
        '11033309=  SELECT REPLACE(CAST(SUM(S.amount) AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39')'
      
        '11033310=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39')'
      
        '11033311=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ)' +
        ', :CURRENCY_))'
      
        '11033312=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(10)),' +
        ' '#39#39'.'#39#39', '#39#39','#39#39')'
      '11033313=         ,SUM(S.nds_summ)'
      '11033314=    FROM ZAKAZ_DETAILS S'
      '11033315=   WHERE S.ZAKAZ = :ZAKAZ_'
      '11033316=   GROUP BY S.ZAKAZ'
      '11033317=    INTO :AMOUNT_VSEGO_,'
      '11033318=         :SUMM_VSEGO_,'
      '11033319=         :summ_str_,'
      '11033320=         :NDS_SUMM_,'
      '11033321=         :NDS_;'
      '11033322='
      '11033323=  if (NDS_ > 0) then'
      
        '11033324=    SELECT '#39#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39#39'||CURR_STR from CURRENC' +
        'YSTR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '11033325='
      '11033326=  SELECT NAME'
      '11033327=    FROM CUR_PARAMS'
      '11033328=   WHERE CUR_PARAMS = 1'
      '11033329=    INTO :G_OFFICIAL_FM_;'
      '11033330='
      '11033331=  FOR SELECT :I,'
      '11033332=             G.name,'
      '11033333=             G.ARTICUL,'
      '11033334=             G.BARCODE,'
      '11033335=             G.NOMENCLATUR_NUM,'
      '11033336=             U.short_name,'
      
        '11033337=             REPLACE(CAST(S.amount AS VARCHAR(10)), '#39#39'.' +
        #39#39', '#39#39','#39#39'),'
      
        '11033338=             REPLACE(CAST(S.price AS VARCHAR(10)), '#39#39'.'#39 +
        #39', '#39#39','#39#39'),'
      
        '11033339=             REPLACE(CAST(S.summ AS VARCHAR(10)), '#39#39'.'#39#39 +
        ', '#39#39','#39#39')'
      '11033340=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U'
      '11033341=       WHERE S.ZAKAZ = :ZAKAZ_'
      '11033342=         AND S.g_product = G.g_product'
      '11033343=         AND G.g_unit = U.g_unit'
      '11033344=        INTO :ROW_NUM,'
      '11033345=            :NAME,'
      '11033346=            :ARTICUL,'
      '11033347=            :BARCODE,'
      '11033348=            :NOMENCLATUR_NUM,'
      '11033349=            :SHORT_NAME,'
      '11033350=            :AMOUNT,'
      '11033351=            :PRICE_N,'
      '11033352=            :SUMM_N'
      '11033353=  DO BEGIN'
      '11033354=    I = I + 1;'
      '11033355=    SUSPEND;'
      '11033356=  END'
      '11033357=WHEN ANY DO BEGIN'
      '11033358=    Err_code = -20500;'
      
        '11033359=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11033360=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11033361=  END'
      '11033362=end'
      '11033363='#39';'
      '11033364='
      '11033365=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT('
      '11033366=  DATE_BEGIN_ DATE,'
      '11033367=  DATE_END_ DATE,'
      '11033368=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11033369=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYME' +
        'NT_TYPE,'
      '11033370=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '11033371=RETURNS ('
      '11033372=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11033373=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '11033374=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUMM' +
        ','
      '11033375=  SUMM_COST_ALL_STR VARCHAR(50),'
      '11033376=  SUMM_ALL_ NUMERIC(15,2),'
      '11033377=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '11033378=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '11033379=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '11033380=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '11033381=  PROFIT_ALL_ NUMERIC(15,2),'
      '11033382=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '11033383=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE.' +
        'P_REP_PROFIT_TABLE,'
      '11033384=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '11033385=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '11033386=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '11033387=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '11033388=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT_' +
        'NAME,'
      
        '11033389=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PA' +
        'YMENT_TYPE,'
      
        '11033390=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYMEN' +
        'T_NAME,'
      
        '11033391=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANIE' +
        ','
      
        '11033392=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUCT' +
        ','
      
        '11033393=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRO' +
        'DUCT_PAR,'
      
        '11033394=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_NA' +
        'ME,'
      '11033395=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11033396=  AMOUNT NUMERIC(15,2),'
      '11033397=  PRICE NUMERIC(15,2),'
      '11033398=  SUMM NUMERIC(15,2),'
      '11033399=  DISCOUNT_PERC NUMERIC(15,2),'
      '11033400=  DISCOUNT_SUMM NUMERIC(15,2),'
      '11033401=  NDS NUMERIC(15,2),'
      '11033402=  NDS_SUMM NUMERIC(15,2),'
      '11033403=  PRICE_SELF NUMERIC(15,2),'
      '11033404=  SUM_SELF NUMERIC(15,2),'
      '11033405=  PROFIT NUMERIC(15,2),'
      '11033406=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '11033407=  ERR_CODE INTEGER,'
      '11033408=  ERR_MSG VARCHAR(1024))'
      '11033409=AS'
      
        '11033410=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT'#39 +
        #39';'
      '11033411=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11033412=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '11033413=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '11033414=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '11033415=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '11033416=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '11033417=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '11033418=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '11033419=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '11033420=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '11033421=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '11033422=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '11033423=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRODU' +
        'CT.G_PRODUCT;'
      '11033424=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11033425=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_T' +
        'OCHKA;'
      
        '11033426=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DAT' +
        'E;'
      
        '11033427=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_C' +
        'LIENT;'
      
        '11033428=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLIE' +
        'NT.NAME;'
      
        '11033429=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZAK' +
        'AZ.G_PAYMENT_TYPE;'
      
        '11033430=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.NAME;'
      
        '11033431=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OS' +
        'NOVANIE;'
      
        '11033432=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      
        '11033433=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_PR' +
        'ODUCT.G_PRODUCT_PAR;'
      
        '11033434=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRODU' +
        'CT.NAME;'
      
        '11033435=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.AMOUNT;'
      
        '11033436=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.PRICE;'
      
        '11033437=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM;'
      
        '11033438=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_PERC;'
      
        '11033439=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM;'
      
        '11033440=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'NDS;'
      
        '11033441=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.NDS_SUMM;'
      
        '11033442=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.P' +
        'RICE;'
      
        '11033443=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '11033444=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '11033445=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACTI' +
        'ON_DATE;'
      
        '11033446=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_R' +
        'ASHOD.NAME;'
      '11033447=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '11033448=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.D' +
        'ATE_RECEIPT;'
      
        '11033449=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '11033450=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT' +
        '.NAME;'
      '11033451=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '11033452=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '11033453=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '11033454=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      '11033455=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0;'
      '11033456=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;'
      '11033457=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '11033458=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUMM' +
        ';'
      '11033459=BEGIN'
      
        '11033460=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TAB' +
        'LE = P_REP_PROFIT_TABLE;'
      '11033461=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11033462='
      '11033463=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '11033464=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '11033465=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '11033466='
      '11033467=  FOR SELECT GP.PATH,'
      '11033468=             GP.G_PRODUCT'
      '11033469=       FROM P_REP_TREE GP'
      '11033470=      WHERE EXISTS (SELECT 1'
      
        '11033471=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G' +
        '_PRODUCT G'
      
        '11033472=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39 +
        '-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11033473=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11033474=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11033475=                       AND G.G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '11033476=                       AND Z.IS_SPISANIE = 0'
      '11033477=                       AND Z.is_reserve = 0'
      
        '11033478=                       AND Z.Z_DATE BETWEEN :DATE_BEGIN' +
        '_ AND :DATE_END_'
      
        '11033479=                       AND COALESCE(Z.G_CLIENT, 0) = CO' +
        'ALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045 +
        #1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11033480=                       AND COALESCE(Z.G_PAYMENT_TYPE, 0' +
        ') = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11033481=                       )'
      '11033482=      ORDER BY 1, 2'
      '11033483=  INTO :RECCAT_NAME_,'
      '11033484=       :RECCAT_PRODUCT_'
      '11033485=  DO BEGIN'
      '11033486=    insert into p_rep_profit_table'
      '11033487=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11033488=    values'
      
        '11033489=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME_' +
        ', 1);'
      '11033490='
      '11033491=    FOR SELECT Z.ZAKAZ,'
      '11033492=               Z.G_TOCHKA,'
      '11033493=               Z.Z_DATE,'
      '11033494=               Z.G_CLIENT,'
      '11033495=               C.NAME CLIENT_NAME,'
      '11033496=               Z.G_PAYMENT_TYPE,'
      '11033497=               P.NAME PAYMENT_NAME,'
      '11033498=               Z.OSNOVANIE,'
      '11033499=               G.G_PRODUCT,'
      '11033500=               G.G_PRODUCT_PAR,'
      '11033501=               G.NAME TOVAR_NAME,'
      '11033502=               ZD.AMOUNT,'
      '11033503=               ZD.PRICE,'
      '11033504=               ZD.SUMM,'
      '11033505=               ZD.DISCOUNT_PERC,'
      '11033506=               ZD.DISCOUNT_SUMM,'
      '11033507=               ZD.NDS,'
      '11033508=               ZD.NDS_SUMM,'
      '11033509=               COALESCE(ZD.COST_PRICE, 0)'
      
        '11033510=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z.' +
        'G_CLIENT = C.G_CLIENT,'
      '11033511=               ZAKAZ_DETAILS ZD,'
      '11033512=               G_PRODUCT G,'
      '11033513=               G_PAYMENT_TYPE P'
      
        '11033514=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOC' +
        'HKA||'#39#39'-'#39#39
      '11033515=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '11033516=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11033517=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '11033518=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- '#1055 +
        #1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '11033519=           AND Z.IS_SPISANIE = 0                   -- '#1058 +
        #1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '11033520=           AND Z.IS_RESERVE = 0                    -- '#1058 +
        #1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      
        '11033521=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11033522=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CL' +
        'IENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067 +
        #1052
      
        '11033523=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE' +
        '(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11033524=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ZD' +
        '.ZAKAZ_DETAILS, G.NAME'
      '11033525=    INTO :REC_ZAKAZ_,'
      '11033526=        :REC_G_TOCHKA_,'
      '11033527=        :REC_Z_DATE_,'
      '11033528=        :REC_G_CLIENT_,'
      '11033529=        :REC_CLIENT_NAME_,'
      '11033530=        :REC_G_PAYMENT_TYPE_,'
      '11033531=        :REC_PAYMENT_NAME_,'
      '11033532=        :REC_OSNOVANIE_,'
      '11033533=        :REC_G_PRODUCT_,'
      '11033534=        :REC_G_PRODUCT_PAR_,'
      '11033535=        :REC_TOVAR_NAME_,'
      '11033536=        :REC_AMOUNT_,'
      '11033537=        :REC_PRICE_,'
      '11033538=        :REC_SUMM_,'
      '11033539=        :REC_DISCOUNT_PERC_,'
      '11033540=        :REC_DISCOUNT_SUMM_,'
      '11033541=        :REC_NDS_,'
      '11033542=        :REC_NDS_SUMM_,'
      '11033543=        :REC_PRICE_SELF_'
      '11033544=    DO BEGIN'
      '11033545=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '11033546=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_SU' +
        'M_COST_;'
      '11033547='
      '11033548=      insert into p_rep_profit_table'
      
        '11033549=        (p_rep_profit_table, zakaz, g_tochka, z_date, g' +
        '_client, client_name, g_payment_type, payment_name,'
      
        '11033550=         osnovanie, g_product, g_product_par, tovar_nam' +
        'e, amount, price, summ, discount_perc, discount_summ,'
      
        '11033551=         nds, nds_summ, price_self, sum_self, profit, i' +
        's_head)'
      '11033552=      values'
      '11033553=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '11033554=        :REC_ZAKAZ_,'
      '11033555=        :REC_g_tochka_,'
      
        '11033556=        :REC_z_date_, :REC_g_client_, :REC_client_name_' +
        ', :REC_g_payment_type_, :REC_payment_name_,'
      '11033557=         :REC_osnovanie_,'
      '11033558=         :REC_g_product_,'
      '11033559=         :REC_g_product_par_,'
      '11033560=         :REC_tovar_name_,'
      '11033561=         :REC_amount_,'
      '11033562=         :REC_price_,'
      '11033563=         :REC_summ_,'
      '11033564=         :REC_discount_perc_,'
      '11033565=         :REC_discount_summ_,'
      
        '11033566=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, :' +
        'REC_SUM_COST_, :REC_profit_, 0);'
      '11033567='
      '11033568=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '11033569=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '11033570=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '11033571=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '11033572=    END'
      '11033573='
      '11033574=    insert into p_rep_profit_table'
      
        '11033575=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11033576=    values'
      
        '11033577=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '11033578='
      '11033579=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '11033580=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '11033581=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '11033582=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11033583='
      '11033584=    SUM_ZAKAZ_ = 0;'
      '11033585=    SUM_COST_  = 0;'
      '11033586=    NDS_SUMM_  = 0;'
      '11033587=    PROFIT_    = 0;'
      '11033588=  END'
      '11033589='
      
        '11033590=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_ ' +
        '+ PROFIT_ALL_) > 0) then'
      '11033591=      insert into p_rep_profit_table'
      
        '11033592=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11033593=      values'
      
        '11033594=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '11033595='
      '11033596=  SELECT COUNT(*)'
      
        '11033597=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11033598=          UNION ALL'
      
        '11033599=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11033600=         G_PRIHOD_RASHOD G'
      
        '11033601=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11033602=    AND K.ACTION = 1'
      
        '11033603=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11033604=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11033605=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -- '#1053#1045' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11033606=  INTO :CNT_;'
      '11033607='
      '11033608=  IF (CNT_ > 0) THEN BEGIN'
      '11033609=    SUM_COST_  = 0;'
      '11033610=    PROFIT_    = 0;'
      '11033611='
      '11033612=    INSERT INTO P_REP_PROFIT_TABLE'
      '11033613=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11033614=    VALUES'
      
        '11033615=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11033616='
      '11033617=    FOR SELECT K.ACTION_DATE,'
      '11033618=               K.SUMM,'
      '11033619=               G.NAME'
      
        '11033620=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      
        '11033621=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39
      '11033622=              UNION ALL'
      
        '11033623=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, S' +
        'UMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa_bezn' +
        'al'
      
        '11033624=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39') k,'
      '11033625=              G_PRIHOD_RASHOD G'
      '11033626=        WHERE K.ACTION = 1'
      
        '11033627=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11033628=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11033629=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11033630=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11033631=    INTO :ACTION_DATE_,'
      '11033632=         :SUMM_,'
      '11033633=         :ACTION_NAME_'
      '11033634=    DO BEGIN'
      '11033635=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11033636=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11033637=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11033638=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11033639=        VALUES'
      
        '11033640=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, 0,'
      
        '11033641=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALESC' +
        'E(:SUMM_, 0), 0);'
      '11033642='
      '11033643=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '11033644=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '11033645=    END'
      '11033646='
      '11033647=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11033648=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11033649=    insert into p_rep_profit_table'
      
        '11033650=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11033651=    values'
      
        '11033652=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11033653=  END'
      '11033654=  SELECT COUNT(*)'
      
        '11033655=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11033656=          UNION ALL'
      
        '11033657=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11033658=         G_PRIHOD_RASHOD G'
      
        '11033659=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11033660=    AND K.ACTION = 0'
      
        '11033661=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11033662=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11033663=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056#1045#1040 +
        #1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11033664=  INTO :CNT_;'
      '11033665='
      '11033666=  IF (CNT_ > 0) THEN BEGIN'
      '11033667=    PRIHOD_ALL_  = 0;'
      '11033668=    PRIHOD_ALL_NAL_  = 0;'
      '11033669=    PRIHOD_ALL_BEZNAL_  = 0;'
      '11033670=    PROFIT_     = 0;'
      '11033671='
      '11033672=    INSERT INTO P_REP_PROFIT_TABLE'
      '11033673=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11033674=    VALUES'
      
        '11033675=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11033676='
      '11033677=    FOR SELECT K.ACTION_DATE,'
      '11033678=               K.NAL,'
      '11033679=               K.BEZNAL,'
      '11033680=               G.NAME'
      
        '11033681=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 B' +
        'EZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11033682=               UNION ALL'
      
        '11033683=               SELECT kassa_BEZNAL KASSA, ACTION_DATE, ' +
        '0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa' +
        '_beznal) K,'
      '11033684=              G_PRIHOD_RASHOD G'
      
        '11033685=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCH' +
        'KA||'#39#39'-'#39#39
      '11033686=          AND K.ACTION = 0'
      
        '11033687=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11033688=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11033689=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11033690=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11033691=    INTO :ACTION_DATE_,'
      '11033692=         :SUMM_NAL_,'
      '11033693=         :SUMM_BEZNAL_,'
      '11033694=         :ACTION_NAME_'
      '11033695=    DO BEGIN'
      '11033696=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11033697=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11033698=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11033699=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11033700=        VALUES'
      
        '11033701=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '11033702=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_' +
        ', 0);'
      '11033703='
      '11033704=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '11033705=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_' +
        'BEZNAL_;'
      
        '11033706=        PRIHOD_ALL_ = PRIHOD_ALL_ + PRIHOD_ALL_NAL_ + P' +
        'RIHOD_ALL_BEZNAL_;'
      
        '11033707=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      '11033708=    END'
      '11033709='
      '11033710=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '11033711=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11033712=    insert into p_rep_profit_table'
      
        '11033713=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11033714=    values'
      
        '11033715=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '11033716=  END'
      '11033717='
      '11033718=  SELECT COUNT(*)'
      '11033719=    FROM ZAKAZ Z'
      
        '11033720=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11033721=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11033722=     AND Z.IS_SPISANIE = 1'
      
        '11033723=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(Z.G_CLIENT, 0))'
      
        '11033724=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11033725=  INTO :CNT_;'
      '11033726='
      '11033727=  IF (CNT_ > 0) THEN BEGIN'
      '11033728=      SUM_ZAKAZ_ = 0;'
      '11033729=      SUM_COST_  = 0;'
      '11033730=      PROFIT_    = 0;'
      '11033731='
      '11033732=      insert into p_rep_profit_table'
      '11033733=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11033734=      values'
      
        '11033735=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39#39', 1);'
      '11033736='
      '11033737=      FOR SELECT Z.ZAKAZ,'
      '11033738=                 Z.G_TOCHKA,'
      '11033739=                 Z.Z_DATE,'
      '11033740=                 Z.G_CLIENT,'
      '11033741=                 '#39#39#39#39' CLIENT_NAME,'
      '11033742=                 Z.G_PAYMENT_TYPE,'
      '11033743=                 '#39#39#39#39' PAYMENT_NAME,'
      '11033744=                 Z.OSNOVANIE,'
      '11033745=                 G.G_PRODUCT,'
      '11033746=                 G.G_PRODUCT_PAR,'
      '11033747=                 G.NAME TOVAR_NAME,'
      '11033748=                 ZD.AMOUNT,'
      '11033749=                 ZD.PRICE,'
      '11033750=                 ZD.SUMM,'
      '11033751=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '11033752=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '11033753=                 0 NDS, --ZD.NDS,'
      '11033754=                 0 NDS_SUMM'
      '11033755=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT G'
      
        '11033756=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_T' +
        'OCHKA||'#39#39'-'#39#39
      '11033757=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '11033758=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11033759=             AND Z.IS_SPISANIE = 1                    -' +
        '- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '11033760=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11033761=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '11033762=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '11033763=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11033764=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ_' +
        'DETAILS'
      '11033765=      INTO :REC_ZAKAZ_,'
      '11033766=            :REC_G_TOCHKA_,'
      '11033767=            :REC_Z_DATE_,'
      '11033768=            :REC_G_CLIENT_,'
      '11033769=            :REC_CLIENT_NAME_,'
      '11033770=            :REC_G_PAYMENT_TYPE_,'
      '11033771=            :REC_PAYMENT_NAME_,'
      '11033772=            :REC_OSNOVANIE_,'
      '11033773=            :REC_G_PRODUCT_,'
      '11033774=            :REC_G_PRODUCT_PAR_,'
      '11033775=            :REC_TOVAR_NAME_,'
      '11033776=            :REC_AMOUNT_,'
      '11033777=            :REC_PRICE_,'
      '11033778=            :REC_SUMM_,'
      '11033779=            :REC_DISCOUNT_PERC_,'
      '11033780=            :REC_DISCOUNT_SUMM_,'
      '11033781=            :REC_NDS_,'
      '11033782=            :REC_NDS_SUMM_'
      '11033783=      DO BEGIN'
      '11033784=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '11033785=        REC_profit_   = -REC_SUMM_;'
      '11033786='
      '11033787=        insert into p_rep_profit_table'
      
        '11033788=          (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '11033789=           osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '11033790=           nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '11033791=        values'
      
        '11033792=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAKA' +
        'Z_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_na' +
        'me_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '11033793=         :REC_osnovanie_, :REC_g_product_, :REC_g_produ' +
        'ct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_per' +
        'c_, :REC_discount_summ_,'
      
        '11033794=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_S' +
        'UM_COST_, :REC_profit_, 0);'
      '11033795='
      
        '11033796=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST_' +
        ', 0);'
      
        '11033797=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, 0' +
        ');'
      '11033798=      END'
      '11033799='
      '11033800=      insert into p_rep_profit_table'
      
        '11033801=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11033802=      values'
      
        '11033803=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', ' +
        '0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11033804='
      '11033805=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11033806=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '11033807=  END'
      '11033808=  SELECT COUNT(*)'
      '11033809=    FROM SKLAD S'
      
        '11033810=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39 +
        #39'-'#39#39
      
        '11033811=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '11033812=     AND S.IS_VOZVRAT IN (1,2)'
      
        '11033813=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.G' +
        '_CLIENT, 0))'
      
        '11033814=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, ' +
        'COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11033815=  INTO :CNT_;'
      '11033816='
      '11033817=  IF (CNT_ > 0) THEN BEGIN'
      '11033818=    SUM_ZAKAZ_ = 0;'
      '11033819=    PROFIT_    = 0;'
      '11033820=    SUM_COST_  = 0;'
      '11033821='
      '11033822=    insert into p_rep_profit_table'
      '11033823=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11033824=    values'
      
        '11033825=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39#39', 1);'
      '11033826='
      '11033827=    FOR SELECT S.DATE_RECEIPT,'
      '11033828=               S.G_PRODUCT,'
      '11033829=               G.NAME TOVAR_NAME,'
      '11033830=               S.AMOUNT,'
      '11033831=               S.PRICE,'
      '11033832=               S.SUMM,'
      '11033833=               SP.G_TOCHKA'
      '11033834=         FROM SKLAD_PARENT SP,'
      '11033835=              SKLAD S,'
      '11033836=              G_PRODUCT G'
      
        '11033837=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TOC' +
        'HKA||'#39#39'-'#39#39
      
        '11033838=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '11033839=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '11033840=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALES' +
        'CE(S.G_CLIENT, 0))'
      
        '11033841=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_T' +
        'YPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11033842=          AND SP.SKLAD = S.SKLAD_PARENT'
      '11033843=          AND S.G_PRODUCT = G.G_PRODUCT'
      '11033844=        ORDER BY 1'
      '11033845=    INTO :V_DATE_RECEIPT_,'
      '11033846=         :V_G_PRODUCT_,'
      '11033847=         :V_TOVAR_NAME_,'
      '11033848=         :V_AMOUNT_,'
      '11033849=         :V_PRICE_,'
      '11033850=         :V_SUMM_,'
      '11033851=         :REC_G_TOCHKA_'
      '11033852=    DO BEGIN'
      '11033853=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;'
      '11033854='
      '11033855='
      '11033856=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '11033857=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_N' +
        'AME, AMOUNT, PRICE, SUMM,'
      '11033858=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11033859=         NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT, I' +
        'S_HEAD)'
      '11033860=      VALUES'
      
        '11033861=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_REC' +
        'EIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, 0 /*:REC_PRICE' +
        '_SELF_*/, 0/*:REC_SUM_COST_*/,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' ' +
        #1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045 +
        #1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '11033862=         0, 0, 0, 0, :V_PRICE_, :V_SUMM_, :REC_profit_,' +
        ' 0);'
      '11033863='
      '11033864=      SUM_COST_ = 0;'
      '11033865=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '11033866=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '11033867=    END'
      '11033868='
      '11033869='
      '11033870=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_COST_;'
      '11033871=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '11033872=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '11033873='
      '11033874=    insert into p_rep_profit_table'
      
        '11033875=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11033876=    values'
      
        '11033877=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '11033878=  END'
      '11033879='
      '11033880=  SELECT COUNT(*)'
      '11033881=    FROM ZAKAZ S'
      
        '11033882=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11033883=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11033884=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11033885=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11033886=     AND S.IS_SPISANIE = 2'
      '11033887=  INTO :CNT_;'
      '11033888='
      '11033889=  IF (CNT_ > 0) THEN BEGIN'
      '11033890=      insert into p_rep_profit_table'
      '11033891=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11033892=      values'
      
        '11033893=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '11033894='
      '11033895=      SUM_ZAKAZ_ = 0;'
      '11033896=      SUM_COST_  = 0;'
      '11033897=      NDS_SUMM_  = 0;'
      '11033898=      PROFIT_    = 0;'
      '11033899=      FOR SELECT GP.NAME,'
      '11033900=                 GP.G_PRODUCT'
      '11033901=           FROM G_PRODUCT GP'
      '11033902=          WHERE IS_CATEGORY = 1'
      '11033903=            AND EXISTS (SELECT 1'
      
        '11033904=                          FROM ZAKAZ Z, ZAKAZ_DETAILS Z' +
        'D, G_PRODUCT G'
      
        '11033905=                         WHERE :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11033906=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '11033907=                           AND ZD.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11033908=                           AND G.G_PRODUCT_PAR = GP.G_P' +
        'RODUCT'
      '11033909=                           AND Z.IS_SPISANIE = 2'
      '11033910=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11033911=                           AND Z.Z_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      
        '11033912=                           AND COALESCE(Z.G_CLIENT, 0) ' +
        '= COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' ' +
        #1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11033913=                           AND COALESCE(Z.G_PAYMENT_TYP' +
        'E, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0)' +
        ')'
      '11033914=                           )'
      '11033915=          ORDER BY 1'
      '11033916=      INTO :RECCAT_NAME_,'
      '11033917=           :RECCAT_PRODUCT_'
      '11033918=      DO BEGIN'
      '11033919=        insert into p_rep_profit_table'
      '11033920=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11033921=        values'
      
        '11033922=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_N' +
        'AME_, 1);'
      '11033923='
      '11033924=        FOR SELECT Z.ZAKAZ,'
      '11033925=                   Z.G_TOCHKA,'
      '11033926=                   Z.Z_DATE,'
      '11033927=                   Z.G_CLIENT,'
      '11033928=                   C.NAME CLIENT_NAME,'
      '11033929=                   Z.G_PAYMENT_TYPE,'
      '11033930=                   P.NAME PAYMENT_NAME,'
      '11033931=                   Z.OSNOVANIE,'
      '11033932=                   G.G_PRODUCT,'
      '11033933=                   G.G_PRODUCT_PAR,'
      '11033934=                   G.NAME TOVAR_NAME,'
      '11033935=                   ZD.AMOUNT,'
      '11033936=                   ZD.PRICE,'
      '11033937=                   ZD.SUMM,'
      '11033938=                   ZD.DISCOUNT_PERC,'
      '11033939=                   ZD.DISCOUNT_SUMM,'
      '11033940=                   ZD.NDS,'
      '11033941=                   ZD.NDS_SUMM,'
      '11033942=                   ZD.COST_PRICE'
      
        '11033943=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C O' +
        'N Z.G_CLIENT = C.G_CLIENT,'
      '11033944=                   ZAKAZ_DETAILS ZD,'
      '11033945=                   G_PRODUCT G,'
      '11033946=                   G_PAYMENT_TYPE P'
      
        '11033947=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G' +
        '_TOCHKA||'#39#39'-'#39#39
      '11033948=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '11033949=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11033950=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '11033951=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  ' +
        '-- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '11033952=               AND Z.IS_SPISANIE = 2                   ' +
        ' -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '11033953=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11033954=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '11033955=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:' +
        'G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '11033956=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COAL' +
        'ESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11033957=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ' +
        ', ZD.ZAKAZ_DETAILS, G.NAME'
      '11033958=        INTO :REC_ZAKAZ_,'
      '11033959=            :REC_G_TOCHKA_,'
      '11033960=            :REC_Z_DATE_,'
      '11033961=            :REC_G_CLIENT_,'
      '11033962=            :REC_CLIENT_NAME_,'
      '11033963=            :REC_G_PAYMENT_TYPE_,'
      '11033964=            :REC_PAYMENT_NAME_,'
      '11033965=            :REC_OSNOVANIE_,'
      '11033966=            :REC_G_PRODUCT_,'
      '11033967=            :REC_G_PRODUCT_PAR_,'
      '11033968=            :REC_TOVAR_NAME_,'
      '11033969=            :REC_AMOUNT_,'
      '11033970=            :REC_PRICE_,'
      '11033971=            :REC_SUMM_,'
      '11033972=            :REC_DISCOUNT_PERC_,'
      '11033973=            :REC_DISCOUNT_SUMM_,'
      '11033974=            :REC_NDS_,'
      '11033975=            :REC_NDS_SUMM_,'
      '11033976=            :REC_PRICE_SELF_'
      '11033977=        DO BEGIN'
      
        '11033978=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_' +
        ';'
      
        '11033979=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - R' +
        'EC_NDS_SUMM_;'
      '11033980='
      '11033981=          insert into p_rep_profit_table'
      
        '11033982=            (p_rep_profit_table, zakaz, g_tochka, z_dat' +
        'e, g_client, client_name, g_payment_type, payment_name,'
      
        '11033983=             osnovanie, g_product, g_product_par, tovar' +
        '_name, amount, price, summ, discount_perc, discount_summ,'
      
        '11033984=             nds, nds_summ, price_self, sum_self, profi' +
        't, is_head)'
      '11033985=          values'
      '11033986=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '11033987=            :REC_ZAKAZ_,'
      '11033988=            :REC_g_tochka_,'
      
        '11033989=            :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      '11033990=             :REC_osnovanie_,'
      '11033991=             :REC_g_product_,'
      '11033992=             :REC_g_product_par_,'
      '11033993=             :REC_tovar_name_,'
      '11033994=             :REC_amount_,'
      '11033995=             :REC_price_,'
      '11033996=             :REC_summ_,'
      '11033997=             :REC_discount_perc_,'
      '11033998=             :REC_discount_summ_,'
      
        '11033999=             :REC_nds_, :REC_nds_summ_, :REC_price_self' +
        '_, :REC_SUM_COST_, :REC_profit_, 0);'
      '110331000='
      
        '110331001=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_' +
        ', 0);'
      
        '110331002=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_CO' +
        'ST_, 0);'
      
        '110331003=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SU' +
        'MM_, 0);'
      
        '110331004=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_,' +
        ' 0);'
      '110331005=        END'
      '110331006='
      '110331007=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110331008=        insert into p_rep_profit_table'
      
        '110331009=          (p_rep_profit_table, tovar_name, summ, sum_s' +
        'elf, NDS_SUMM, profit, is_head)'
      '110331010=        values'
      
        '110331011=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39 +
        #39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '110331012='
      
        '110331013=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_' +
        ';'
      '110331014=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '110331015=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '110331016=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '110331017='
      '110331018=        SUM_ZAKAZ_ = 0;'
      '110331019=        SUM_COST_  = 0;'
      '110331020=        NDS_SUMM_  = 0;'
      '110331021=        PROFIT_    = 0;'
      '110331022=      END'
      '110331023='
      '110331024=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110331025=      insert into p_rep_profit_table'
      
        '110331026=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110331027=      values'
      
        '110331028=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' ' +
        #1090#1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_S' +
        'UMM_REAL_, :PROFIT_REAL_, 2);'
      '110331029='
      
        '110331030=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL' +
        '_;'
      
        '110331031=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL' +
        '_;'
      '110331032=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '110331033=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '110331034=  END'
      '110331035=  insert into p_rep_profit_table'
      '110331036=    (p_rep_profit_table, is_head)'
      '110331037=  values'
      '110331038=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110331039='
      '110331040=  insert into p_rep_profit_table'
      
        '110331041=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110331042=  values'
      
        '110331043=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFI' +
        'T_ALL_, 1);'
      '110331044='
      '110331045=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110331046=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110331047=         SUM(Z.SUMM_BONUS)'
      '110331048=    FROM ZAKAZ Z'
      
        '110331049=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      '110331050=     AND Z.IS_SPISANIE not in (1, 4)'
      '110331051=     AND Z.IS_RESERVE = 0'
      '110331052=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110331053=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))'
      
        '110331054=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110331055=    INTO :SUMM_CASH_ALL_,'
      '110331056=         :SUMM_NONCASH_ALL_,'
      '110331057=         :SUMM_BONUS_ALL_;'
      '110331058='
      '110331059=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '110331060=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '110331061=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110331062='
      '110331063=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110331064='
      
        '110331065=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '110331066=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110331067='
      '110331068=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110331069=    SELECT G.NAME'
      '110331070=      FROM G_CLIENT G'
      '110331071=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110331072=    INTO :CLIENT_NAME_;'
      '110331073=  ELSE'
      '110331074=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110331075='
      '110331076=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110331077=    SELECT G.NAME'
      '110331078=      FROM G_PAYMENT_TYPE G'
      '110331079=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110331080=    INTO :PAYMENT_NAME_;'
      '110331081=  ELSE'
      '110331082=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110331083='
      '110331084=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110331085=        P.ZAKAZ,'
      '110331086=        P.G_TOCHKA,'
      '110331087=        P.Z_DATE,'
      '110331088=        P.G_CLIENT,'
      '110331089=        P.CLIENT_NAME,'
      '110331090=        P.G_PAYMENT_TYPE,'
      '110331091=        P.PAYMENT_NAME,'
      '110331092=        P.OSNOVANIE,'
      '110331093=        P.G_PRODUCT,'
      '110331094=        P.G_PRODUCT_PAR,'
      '110331095=        P.TOVAR_NAME,'
      '110331096=        G.ARTICUL,'
      '110331097=        P.AMOUNT,'
      '110331098=        P.PRICE,'
      '110331099=        P.SUMM,'
      '110331100=        P.DISCOUNT_PERC,'
      '110331101=        P.DISCOUNT_SUMM,'
      '110331102=        P.NDS,'
      '110331103=        P.NDS_SUMM,'
      '110331104=        P.PRICE_SELF,'
      '110331105=        P.SUM_SELF,'
      '110331106=        P.PROFIT,'
      '110331107=        P.IS_HEAD'
      
        '110331108=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110331109=    ORDER BY 1'
      '110331110=  INTO :P_REP_PROFIT_TABLE,'
      '110331111=       :ZAKAZ,'
      '110331112=       :G_TOCHKA,'
      '110331113=       :Z_DATE,'
      '110331114=       :G_CLIENT,'
      '110331115=       :CLIENT_NAME,'
      '110331116=       :G_PAYMENT_TYPE,'
      '110331117=       :PAYMENT_NAME,'
      '110331118=       :OSNOVANIE,'
      '110331119=       :G_PRODUCT,'
      '110331120=       :G_PRODUCT_PAR,'
      '110331121=       :TOVAR_NAME,'
      '110331122=       :ARTICUL,'
      '110331123=       :AMOUNT,'
      '110331124=       :PRICE,'
      '110331125=       :SUMM,'
      '110331126=       :DISCOUNT_PERC,'
      '110331127=       :DISCOUNT_SUMM,'
      '110331128=       :NDS,'
      '110331129=       :NDS_SUMM,'
      '110331130=       :PRICE_SELF,'
      '110331131=       :SUM_SELF,'
      '110331132=       :PROFIT,'
      '110331133=       :IS_HEAD'
      '110331134=  DO'
      '110331135=    suspend;'
      '110331136='
      '110331137=WHEN ANY DO BEGIN'
      '110331138=    Err_code = -20500;'
      
        '110331139=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110331140=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110331141=  END'
      '110331142=end'
      '110331143='#39';'
      '110331144=END  --END_EXECUTE_BLOCK'
      '110331145=EXECUTE BLOCK AS BEGIN'
      '110331146='
      
        '110331147=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT_CATEGO' +
        'RY('
      '110331148=  DATE_BEGIN_ DATE,'
      '110331149=  DATE_END_ DATE,'
      '110331150=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110331151=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYM' +
        'ENT_TYPE,'
      '110331152=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110331153=RETURNS ('
      '110331154=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110331155=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      
        '110331156=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUM' +
        'M,'
      '110331157=  SUMM_COST_ALL_STR VARCHAR(50),'
      '110331158=  SUMM_ALL_ NUMERIC(15,2),'
      '110331159=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '110331160=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '110331161=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '110331162=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '110331163=  PROFIT_ALL_ NUMERIC(15,2),'
      '110331164=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '110331165=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE' +
        '.P_REP_PROFIT_TABLE,'
      
        '110331166=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_N' +
        'AME,'
      '110331167=  SUMM NUMERIC(15,2),'
      '110331168=  NDS_SUMM NUMERIC(15,2),'
      '110331169=  SUM_SELF NUMERIC(15,2),'
      '110331170=  PROFIT NUMERIC(15,2),'
      '110331171=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '110331172=  ERR_CODE INTEGER,'
      '110331173=  ERR_MSG VARCHAR(1024))'
      '110331174=AS'
      
        '110331175=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT' +
        #39#39';'
      '110331176=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110331177=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '110331178=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '110331179=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '110331180=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '110331181=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '110331182=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '110331183=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PROD' +
        'UCT.NAME;'
      
        '110331184=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM;'
      
        '110331185=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.NDS_SUMM;'
      
        '110331186=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SU' +
        'MM;'
      '110331187=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      '110331188=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      '110331189=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110331190=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      '110331191=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0;'
      '110331192=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0;'
      '110331193=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      
        '110331194=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUM' +
        'M;'
      '110331195=DECLARE VARIABLE IS_FIRST_ INTEGER;'
      '110331196=BEGIN'
      
        '110331197=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TA' +
        'BLE = P_REP_PROFIT_TABLE;'
      '110331198=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '110331199='
      '110331200=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '110331201=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '110331202=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '110331203='
      '110331204=  FOR SELECT SUM(ZD.SUMM)'
      '110331205=           ,TR.PATH'
      '110331206=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '110331207=           ,SUM(ZD.nds_summ)'
      '110331208=      FROM ZAKAZ Z,'
      '110331209=           ZAKAZ_DETAILS ZD,'
      '110331210=           G_PRODUCT GP,'
      '110331211=           P_REP_TREE TR'
      
        '110331212=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA' +
        '||'#39#39'-'#39#39
      '110331213=       AND Z.IS_SPISANIE = 0'
      '110331214=       AND Z.IS_RESERVE = 0'
      '110331215=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110331216=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110331217=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110331218=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110331219=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110331220=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110331221=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110331222=     GROUP BY TR.PATH'
      '110331223=     ORDER BY TR.PATH'
      
        '110331224=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_, :SUM_COST_, N' +
        'DS_SUMM_'
      '110331225=  DO BEGIN'
      '110331226=    PROFIT_ = SUM_ZAKAZ_ - SUM_COST_ - NDS_SUMM_;'
      '110331227='
      '110331228=    insert into p_rep_profit_table'
      
        '110331229=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110331230=    values'
      '110331231=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110331232=        :REC_TOVAR_NAME_, :SUM_ZAKAZ_, :NDS_SUMM_, :SU' +
        'M_COST_, :PROFIT_, 0);'
      '110331233='
      '110331234=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110331235=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110331236=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110331237=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110331238=  END'
      '110331239='
      
        '110331240=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_' +
        ' + PROFIT_ALL_) > 0) then'
      '110331241=      insert into p_rep_profit_table'
      
        '110331242=        (p_rep_profit_table, tovar_name, summ, sum_sel' +
        'f, NDS_SUMM, profit, is_head)'
      '110331243=      values'
      
        '110331244=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' ' +
        #1087#1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :P' +
        'ROFIT_ALL_, 3);'
      '110331245='
      '110331246=  IS_FIRST_ = 1;'
      '110331247=  SUM_COST_ = 0;'
      '110331248=  PROFIT_   = 0;'
      '110331249='
      '110331250=  FOR SELECT G.NAME,'
      '110331251=             SUM(K.SUMM)'
      
        '110331252=        FROM (SELECT ACTION_DATE, SUMM, ACTION, G_PRIH' +
        'OD_RASHOD, G_TOCHKA FROM KASSA'
      '110331253=              UNION ALL'
      
        '110331254=              SELECT ACTION_DATE, SUMM NAL, ACTION, G_' +
        'PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '110331255=             G_PRIHOD_RASHOD G'
      
        '110331256=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCH' +
        'KA||'#39#39'-'#39#39
      '110331257=        AND K.ACTION = 1'
      
        '110331258=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110331259=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110331260=        AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)    -' +
        '- '#1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110331261=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '110331262=        INTO :REC_TOVAR_NAME_'
      '110331263=             ,:SUMM_'
      '110331264=  DO BEGIN'
      '110331265=    IF (IS_FIRST_ = 1) then BEGIN'
      '110331266=      INSERT INTO P_REP_PROFIT_TABLE'
      '110331267=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110331268=      VALUES'
      
        '110331269=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39 +
        #39', 1);'
      '110331270='
      '110331271=      IS_FIRST_ = 0;'
      '110331272=    END'
      '110331273='
      '110331274=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110331275=      (P_REP_PROFIT_TABLE, tovar_name, summ, NDS_SUMM,' +
        ' SUM_SELF, PROFIT, IS_HEAD)'
      '110331276=    VALUES'
      
        '110331277=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :SUMM_, -:SUMM_, 0);'
      '110331278='
      '110331279=    SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '110331280=    PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '110331281=  END'
      '110331282='
      '110331283=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054#1044#1067
      '110331284=  IF (SUM_COST_ > 0) then BEGIN'
      '110331285=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110331286=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110331287=    insert into p_rep_profit_table'
      
        '110331288=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110331289=    values'
      
        '110331290=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061 +
        #1054#1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '110331291=  END'
      '110331292='
      '110331293=  IS_FIRST_ = 1;'
      '110331294=  PROFIT_   = 0;'
      '110331295=  PRIHOD_ALL_  = 0;'
      '110331296=  PRIHOD_ALL_NAL_  = 0;'
      '110331297=  PRIHOD_ALL_BEZNAL_  = 0;'
      '110331298='
      '110331299=  FOR SELECT G.NAME,'
      '110331300=             SUM(K.NAL),'
      '110331301=             SUM(K.BEZNAL)'
      
        '110331302=        FROM (SELECT ACTION_DATE, SUMM NAL, 0 BEZNAL, ' +
        'ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '110331303=              UNION ALL'
      
        '110331304=              SELECT ACTION_DATE, 0 NAL, SUMM BEZNAL, ' +
        'ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZNAL) K,'
      '110331305=             G_PRIHOD_RASHOD G'
      
        '110331306=       WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCH' +
        'KA||'#39#39'-'#39#39
      '110331307=        AND K.ACTION = 0'
      
        '110331308=        AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110331309=        AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '110331310=        AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053 +
        #1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110331311=      GROUP BY K.G_PRIHOD_RASHOD, G.NAME'
      '110331312=        INTO :REC_TOVAR_NAME_'
      '110331313=             ,:SUMM_NAL_'
      '110331314=             ,:SUMM_BEZNAL_'
      '110331315=  DO BEGIN'
      '110331316=    IF (IS_FIRST_ = 1) then BEGIN'
      '110331317=      INSERT INTO P_REP_PROFIT_TABLE'
      '110331318=        (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '110331319=      VALUES'
      
        '110331320=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39 +
        #39', 1);'
      '110331321='
      '110331322=      IS_FIRST_ = 0;'
      '110331323=    END'
      '110331324='
      '110331325=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110331326=      (P_REP_PROFIT_TABLE, tovar_name, SUM_SELF, NDS_S' +
        'UMM, SUMM, PROFIT, IS_HEAD)'
      '110331327=    VALUES'
      
        '110331328=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_, :SUMM_NAL_ + :SUMM_BEZNA' +
        'L_, 0);'
      '110331329='
      '110331330=    PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '110331331=    PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_BEZ' +
        'NAL_;'
      
        '110331332=    PRIHOD_ALL_ = PRIHOD_ALL_ + PRIHOD_ALL_NAL_ + PRIH' +
        'OD_ALL_BEZNAL_;'
      
        '110331333=    PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZNAL_' +
        ';'
      '110331334=  END'
      '110331335='
      '110331336=  IF (PROFIT_ > 0) then BEGIN'
      '110331337=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '110331338=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '110331339=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1067
      '110331340=    insert into p_rep_profit_table'
      
        '110331341=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110331342=    values'
      
        '110331343=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061 +
        #1054#1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '110331344=  END'
      '110331345='
      '110331346=  IS_FIRST_ = 1;'
      '110331347=  SUM_COST_ = 0;'
      '110331348=  PROFIT_   = 0;'
      '110331349=  FOR SELECT SUM(ZD.SUMM)'
      '110331350=           ,TR.PATH'
      '110331351=      FROM ZAKAZ Z,'
      '110331352=           ZAKAZ_DETAILS ZD,'
      '110331353=           G_PRODUCT GP,'
      '110331354=           P_REP_TREE TR'
      
        '110331355=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA' +
        '||'#39#39'-'#39#39
      '110331356=       AND Z.IS_SPISANIE = 1'
      '110331357=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110331358=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110331359=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110331360=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110331361=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110331362=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110331363=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110331364=     GROUP BY TR.PATH'
      '110331365=     ORDER BY TR.PATH'
      '110331366=     INTO :SUM_ZAKAZ_, :REC_TOVAR_NAME_'
      '110331367=  DO BEGIN'
      '110331368='
      '110331369=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '110331370=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110331371=      insert into p_rep_profit_table'
      '110331372=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110331373=      values'
      
        '110331374=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067 +
        #1049' '#1058#1054#1042#1040#1056#39#39', 1);'
      '110331375='
      '110331376=      IS_FIRST_ = 0;'
      '110331377=    END'
      '110331378='
      '110331379=    insert into p_rep_profit_table'
      
        '110331380=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110331381=    values'
      '110331382=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110331383=        :REC_TOVAR_NAME_, 0, 0, :SUM_ZAKAZ_, -:SUM_ZAK' +
        'AZ_, 0);'
      '110331384='
      '110331385=    SUM_COST_ = SUM_COST_ + COALESCE(:SUM_ZAKAZ_, 0);'
      '110331386=    PROFIT_    = PROFIT_ + COALESCE(-:SUM_ZAKAZ_, 0);'
      '110331387=  END'
      '110331388='
      '110331389=  if (SUM_COST_ > 0) then BEGIN'
      '110331390=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110331391=    insert into p_rep_profit_table'
      
        '110331392=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110331393=    values'
      
        '110331394=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', 0' +
        ', :SUM_COST_, 0, :PROFIT_, 2);'
      '110331395='
      '110331396=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '110331397=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110331398=  END'
      '110331399='
      '110331400=  IS_FIRST_  = 1;'
      '110331401=  SUM_ZAKAZ_ = 0;'
      '110331402=  PROFIT_    = 0;'
      '110331403=  FOR SELECT SUM(S.SUMM)'
      '110331404=             ,TR.PATH'
      '110331405=     FROM SKLAD_PARENT SP,'
      '110331406=          SKLAD S,'
      '110331407=          G_PRODUCT G,'
      '110331408=          P_REP_TREE TR'
      
        '110331409=    WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TOCHKA' +
        '||'#39#39'-'#39#39
      
        '110331410=      AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DA' +
        'TE_END_'
      '110331411=      AND SP.IS_VOZVRAT IN (1,2)'
      '110331412=      and G.g_product_PAR = TR.g_product'
      
        '110331413=      AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'S.G_CLIENT, 0))'
      
        '110331414=      AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE' +
        '_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '110331415=      AND SP.SKLAD = S.SKLAD_PARENT'
      '110331416=      AND S.G_PRODUCT = G.G_PRODUCT'
      '110331417=     GROUP BY TR.PATH'
      '110331418=     ORDER BY TR.PATH'
      '110331419=     INTO :V_SUMM_,'
      '110331420=          :REC_TOVAR_NAME_'
      '110331421=  DO BEGIN'
      '110331422=    IF (IS_FIRST_ = 1) THEN BEGIN'
      '110331423=      insert into p_rep_profit_table'
      '110331424=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110331425=      values'
      
        '110331426=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' ' +
        #1058#1054#1042#1040#1056#1040#39#39', 1);'
      '110331427='
      '110331428=      IS_FIRST_ = 0;'
      '110331429=    END'
      '110331430='
      '110331431=    REC_profit_   = 0 - V_SUMM_;'
      '110331432=    INSERT INTO P_REP_PROFIT_TABLE'
      
        '110331433=      (P_REP_PROFIT_TABLE, TOVAR_NAME, SUMM, NDS_SUMM,' +
        ' SUM_SELF, PROFIT, IS_HEAD)'
      '110331434=    VALUES'
      
        '110331435=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_TOVAR_N' +
        'AME_, 0, 0, :V_SUMM_, :REC_profit_, 0);'
      '110331436='
      '110331437=    SUM_COST_ = 0;'
      '110331438=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '110331439=    PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '110331440=  END'
      '110331441='
      '110331442=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '110331443=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '110331444=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '110331445='
      '110331446=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110331447=    insert into p_rep_profit_table'
      
        '110331448=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110331449=    values'
      
        '110331450=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :' +
        'SUM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '110331451=  END'
      '110331452='
      '110331453=  IS_FIRST_  = 1;'
      '110331454=  SUM_ZAKAZ_ = 0;'
      '110331455=  SUM_COST_  = 0;'
      '110331456=  PROFIT_    = 0;'
      '110331457=  NDS_SUMM_  = 0;'
      '110331458=  FOR SELECT SUM(ZD.SUMM)'
      '110331459=           ,TR.PATH'
      '110331460=           ,SUM(ZD.cost_price * ZD.AMOUNT)'
      '110331461=           ,SUM(ZD.nds_summ)'
      '110331462=      FROM ZAKAZ Z,'
      '110331463=           ZAKAZ_DETAILS ZD,'
      '110331464=           G_PRODUCT GP,'
      '110331465=           P_REP_TREE TR'
      
        '110331466=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA' +
        '||'#39#39'-'#39#39
      '110331467=       AND Z.IS_SPISANIE = 2'
      '110331468=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110331469=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110331470=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110331471=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110331472=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
        '_'
      
        '110331473=       AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIEN' +
        'T_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110331474=       AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G' +
        '_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110331475=     GROUP BY TR.PATH'
      '110331476=     ORDER BY TR.PATH'
      
        '110331477=     INTO :REC_SUMM_, :REC_TOVAR_NAME_, :REC_SUM_COST_' +
        ', REC_NDS_SUMM_'
      '110331478=  DO BEGIN'
      '110331479=    IF (IS_FIRST_ = 1) then BEGIN'
      '110331480=      insert into p_rep_profit_table'
      '110331481=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '110331482=      values'
      
        '110331483=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040 +
        ' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '110331484='
      '110331485=      IS_FIRST_ = 0;'
      '110331486=    END'
      '110331487='
      
        '110331488=    REC_PROFIT_ = REC_SUMM_ - REC_SUM_COST_ - REC_NDS_' +
        'SUMM_;'
      '110331489='
      '110331490=    insert into p_rep_profit_table'
      
        '110331491=        (p_rep_profit_table, tovar_name, summ, nds_sum' +
        'm, sum_self, profit, is_head)'
      '110331492=    values'
      '110331493=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      
        '110331494=        :REC_TOVAR_NAME_, :REC_SUMM_, :REC_NDS_SUMM_, ' +
        ':REC_SUM_COST_, :REC_PROFIT_, 0);'
      '110331495='
      '110331496=    SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '110331497=    SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, 0' +
        ');'
      
        '110331498=    NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, 0' +
        ');'
      '110331499=    PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '110331500=  END'
      '110331501='
      '110331502=  IF (SUM_ZAKAZ_ > 0) then BEGIN'
      '110331503=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110331504=    insert into p_rep_profit_table'
      
        '110331505=      (p_rep_profit_table, tovar_name, summ, sum_self,' +
        ' NDS_SUMM, profit, is_head)'
      '110331506=    values'
      
        '110331507=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROF' +
        'IT_, 2);'
      '110331508='
      '110331509=    SUM_ZAKAZ_ALL_  = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '110331510=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '110331511=    NDS_SUMM_ALL_   = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '110331512=    PROFIT_ALL_     = PROFIT_ALL_ + PROFIT_;'
      '110331513=  END'
      '110331514='
      '110331515=  insert into p_rep_profit_table'
      '110331516=    (p_rep_profit_table, is_head)'
      '110331517=  values'
      '110331518=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '110331519='
      '110331520=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1052#1040#1043#1040#1047#1048#1053#1059
      '110331521=  insert into p_rep_profit_table'
      
        '110331522=    (p_rep_profit_table, tovar_name, summ, sum_self, N' +
        'DS_SUMM, profit, is_head)'
      '110331523=  values'
      
        '110331524=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072 +
        #1079#1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFI' +
        'T_ALL_, 1);'
      '110331525='
      '110331526=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1056#1045#1040#1051#1068#1053#1054' '#1054#1055#1051#1040#1063#1045#1053#1054
      '110331527=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '110331528=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '110331529=         SUM(Z.SUMM_BONUS)'
      '110331530=    FROM ZAKAZ Z'
      
        '110331531=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||' +
        #39#39'-'#39#39
      
        '110331532=     AND Z.IS_SPISANIE not in (1, 4)  -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1089 +
        #1087#1080#1089#1072#1085#1080#1077' '#1080' '#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091
      '110331533=     AND Z.IS_RESERVE = 0'
      '110331534=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '110331535=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_' +
        ', COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '110331536=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_P' +
        'AYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '110331537=    INTO :SUMM_CASH_ALL_,'
      '110331538=         :SUMM_NONCASH_ALL_,'
      '110331539=         :SUMM_BONUS_ALL_;'
      '110331540='
      '110331541=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '110331542=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '110331543=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '110331544='
      '110331545=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '110331546='
      
        '110331547=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS V' +
        'ARCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '110331548=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_' +
        'summ_all_;'
      '110331549='
      '110331550=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '110331551=    SELECT G.NAME'
      '110331552=      FROM G_CLIENT G'
      '110331553=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110331554=    INTO :CLIENT_NAME_;'
      '110331555=  ELSE'
      '110331556=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110331557='
      '110331558=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '110331559=    SELECT G.NAME'
      '110331560=      FROM G_PAYMENT_TYPE G'
      '110331561=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '110331562=    INTO :PAYMENT_NAME_;'
      '110331563=  ELSE'
      '110331564=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '110331565='
      '110331566=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '110331567=        P.TOVAR_NAME,'
      '110331568=        P.SUMM,'
      '110331569=        P.NDS_SUMM,'
      '110331570=        P.SUM_SELF,'
      '110331571=        P.PROFIT,'
      '110331572=        P.IS_HEAD'
      
        '110331573=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUC' +
        'T G ON P.G_PRODUCT = G.G_PRODUCT'
      '110331574=    ORDER BY 1'
      '110331575=  INTO :P_REP_PROFIT_TABLE,'
      '110331576=       :TOVAR_NAME,'
      '110331577=       :SUMM,'
      '110331578=       :NDS_SUMM,'
      '110331579=       :SUM_SELF,'
      '110331580=       :PROFIT,'
      '110331581=       :IS_HEAD'
      '110331582=  DO'
      '110331583=    suspend;'
      '110331584='
      '110331585=WHEN ANY DO BEGIN'
      '110331586=    Err_code = -20500;'
      
        '110331587=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110331588=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110331589=  END'
      '110331590=end'
      '110331591='#39';'
      '110331592='
      '110331593=EXECUTE STATEMENT '#39'ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '110331594=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110331595=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110331596=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110331597=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110331598=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110331599=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110331600=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110331601=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110331602=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '110331603=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED)'
      '110331604=RETURNS ('
      '110331605=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110331606=  ERR_CODE INTEGER,'
      '110331607=  ERR_MSG VARCHAR(1024))'
      '110331608=AS'
      
        '110331609=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'PAY_ZAKAZ_NA' +
        '_REAL'#39#39';'
      '110331610=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110331611=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110331612=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110331613=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'AMOUNT_ALL;'
      
        '110331614=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'SUMM_PAYED;'
      
        '110331615=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110331616=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '110331617=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110331618=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110331619=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      '110331620=BEGIN'
      '110331621='
      '110331622=  IF (G_TOCHKA_ IS NULL) THEN'
      '110331623=    SELECT ID'
      '110331624=      FROM CUR_PARAMS'
      '110331625=     WHERE CUR_PARAMS = 2'
      '110331626=      INTO :G_TOCHKA_;'
      '110331627='
      '110331628=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110331629=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '110331630=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110331631=            INTO :AMOUNT_,'
      '110331632=                 :G_PRODUCT_'
      '110331633=      DO BEGIN'
      '110331634=          UPDATE LT_SKLAD_PRODUCT L'
      '110331635=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110331636=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110331637=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110331638=      END'
      '110331639='
      
        '110331640=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E,'
      
        '110331641=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE)'
      
        '110331642=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '110331643=             NDS_SUMM, COST_PRICE'
      '110331644=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110331645='
      '110331646=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110331647=                                  :Z_DATE_,'
      '110331648=                                  :Z_TIME_,'
      '110331649=                                  :G_CLIENT_,'
      '110331650=                                  :G_PAYMENT_TYPE_,'
      '110331651=                                  :OSNOVANIE_,'
      
        '110331652=                                  :IS_SPISANIE_,   -- ' +
        ':IS_SPISANIE_'
      '110331653=                                  :NOTE_,'
      
        '110331654=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040 +
        #1050#1040#1047#1040
      
        '110331655=                                  :SUMM_FACT_,  -- '#1048' '#1057 +
        #1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '110331656=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 1, SUMM_FACT_, 0),'
      
        '110331657=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 2, SUMM_FACT_, 0),'
      '110331658=                                  0, --SUMM_BONUS_'
      '110331659=                                  0, --SUMM_BONUS_GOT_'
      
        '110331660=                                  null,         -- '#1057#1058#1040 +
        #1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '110331661=                                  0,            -- '#1057#1059#1052 +
        #1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '110331662=                                  0,    --BY_RECIPE'
      '110331663=                                  0     --IS_RESERVE'
      '110331664=                                  ,NULL  -- PAYMENTS_'
      '110331665=                                  )'
      '110331666=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110331667='
      '110331668=      if (ERR_CODE <> 0) then BEGIN'
      '110331669=        ERR_CODE = -20500;'
      '110331670=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110331671=        Exit;'
      '110331672=      END'
      '110331673='
      '110331674=      UPDATE ZAKAZ'
      '110331675=         SET IS_SPISANIE = 2'
      '110331676=       WHERE ZAKAZ = :ZAKAZ_;'
      '110331677='
      
        '110331678=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '110331679=      FOR SELECT T.AMOUNT,'
      '110331680=                 T.SUMM,'
      '110331681=                 T.G_PRODUCT,'
      '110331682=                 T.ZAKAZ_NA_REAL,'
      '110331683=                 T.ZAKAZ_DETAILS'
      '110331684=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110331685=            INTO :AMOUNT_,'
      '110331686=                 :Z_SUMM_,'
      '110331687=                 :G_PRODUCT_,'
      '110331688=                 :ZAKAZ_NA_REAL_,'
      '110331689=                 :ZAKAZ_DETAILS_'
      '110331690=      DO BEGIN'
      '110331691=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110331692=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOU' +
        'NT_,'
      
        '110331693=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110331694=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110331695=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110331696='
      
        '110331697=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' ' +
        'ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '110331698=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110331699=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110331700=      END'
      '110331701=  END'
      '110331702=  ELSE BEGIN'
      '110331703=      FOR SELECT T.AMOUNT,'
      '110331704=                 T.SUMM,'
      '110331705=                 T.G_PRODUCT,'
      '110331706=                 T.ZAKAZ_NA_REAL,'
      '110331707=                 T.ZAKAZ_DETAILS'
      '110331708=                 ,T.PRICE'
      '110331709=                 ,T.NDS'
      '110331710=                 ,T.NDS_SUMM'
      '110331711=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110331712=            INTO :AMOUNT_,'
      '110331713=                 :Z_SUMM_,'
      '110331714=                 :G_PRODUCT_,'
      '110331715=                 :ZAKAZ_NA_REAL_,'
      '110331716=                 :ZAKAZ_DETAILS_'
      '110331717=                 ,:PRICE_'
      '110331718=                 ,:NDS_'
      '110331719=                 ,:NDS_SUMM_'
      '110331720=      DO BEGIN'
      
        '110331721=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUN' +
        'T, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110331722=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '110331723='
      
        '110331724=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110331725=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110331726='
      '110331727=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110331728=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :AMOUNT_,'
      
        '110331729=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110331730=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110331731=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110331732=      END'
      '110331733='
      '110331734=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110331735=                                  :Z_DATE_,'
      '110331736=                                  :Z_TIME_,'
      '110331737=                                  :G_CLIENT_,'
      '110331738=                                  :G_PAYMENT_TYPE_,'
      '110331739=                                  :OSNOVANIE_,'
      '110331740=                                  :NOTE_,'
      
        '110331741=                                  2,        --:IS_VOZV' +
        'RAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-' +
        #1050#1059
      '110331742=                                  :SUMM_,'
      '110331743=                                  :SUMM_FACT_,'
      
        '110331744=                                  NULL,     --:G_PRIHO' +
        'D_,'
      
        '110331745=                                  NULL      --:SUMM_PR' +
        'IHOD_'
      
        '110331746=                                  ,NULL     -- PAYMENT' +
        'S'
      
        '110331747=                                  ) RETURNING_VALUES :' +
        'SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110331748='
      '110331749=      if (ERR_CODE <> 0) then BEGIN'
      '110331750=        ERR_CODE = -20500;'
      '110331751=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110331752=        Exit;'
      '110331753=      END'
      '110331754=  END'
      '110331755='
      '110331756=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110331757=END'
      '110331758='#39';'
      '110331759=END  --END_EXECUTE_BLOCK'
      '110340=EXECUTE BLOCK AS BEGIN'
      '110341=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_PROFIT('
      '110342=  DATE_BEGIN_ DATE,'
      '110343=  DATE_END_ DATE,'
      '110344=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110345=  G_PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMENT_TYPE.G_PAYMENT' +
        '_TYPE,'
      '110346=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110347=RETURNS ('
      '110348=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '110349=  PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1103410=  SUMM_COST_ALL_ TYPE OF COLUMN P_REP_PROFIT_TABLE.SUMM,'
      '1103411=  SUMM_COST_ALL_STR VARCHAR(50),'
      '1103412=  SUMM_ALL_ NUMERIC(15,2),'
      '1103413=  SUMM_CASH_ALL_ NUMERIC(15,2),'
      '1103414=  SUMM_NONCASH_ALL_ NUMERIC(15,2),'
      '1103415=  SUMM_BONUS_ALL_ NUMERIC(15,2),'
      '1103416=  NDS_SUMM_ALL_ NUMERIC(15,2),'
      '1103417=  PROFIT_ALL_ NUMERIC(15,2),'
      '1103418=  PROFIT_ALL_REAL_ NUMERIC(15,2),'
      
        '1103419=  P_REP_PROFIT_TABLE TYPE OF COLUMN P_REP_PROFIT_TABLE.P' +
        '_REP_PROFIT_TABLE,'
      '1103420=  ZAKAZ TYPE OF COLUMN P_REP_PROFIT_TABLE.ZAKAZ,'
      '1103421=  G_TOCHKA TYPE OF COLUMN P_REP_PROFIT_TABLE.G_TOCHKA,'
      '1103422=  Z_DATE TYPE OF COLUMN P_REP_PROFIT_TABLE.Z_DATE,'
      '1103423=  G_CLIENT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_CLIENT,'
      
        '1103424=  CLIENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.CLIENT_N' +
        'AME,'
      
        '1103425=  G_PAYMENT_TYPE TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PAY' +
        'MENT_TYPE,'
      
        '1103426=  PAYMENT_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.PAYMENT' +
        '_NAME,'
      '1103427=  OSNOVANIE TYPE OF COLUMN P_REP_PROFIT_TABLE.OSNOVANIE,'
      '1103428=  G_PRODUCT TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PRODUCT,'
      
        '1103429=  G_PRODUCT_PAR TYPE OF COLUMN P_REP_PROFIT_TABLE.G_PROD' +
        'UCT_PAR,'
      
        '1103430=  TOVAR_NAME TYPE OF COLUMN P_REP_PROFIT_TABLE.TOVAR_NAM' +
        'E,'
      '1103431=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1103432=  AMOUNT NUMERIC(15,2),'
      '1103433=  PRICE NUMERIC(15,2),'
      '1103434=  SUMM NUMERIC(15,2),'
      '1103435=  DISCOUNT_PERC NUMERIC(15,2),'
      '1103436=  DISCOUNT_SUMM NUMERIC(15,2),'
      '1103437=  NDS NUMERIC(15,2),'
      '1103438=  NDS_SUMM NUMERIC(15,2),'
      '1103439=  PRICE_SELF NUMERIC(15,2),'
      '1103440=  SUM_SELF NUMERIC(15,2),'
      '1103441=  PROFIT NUMERIC(15,2),'
      '1103442=  IS_HEAD TYPE OF COLUMN P_REP_PROFIT_TABLE.IS_HEAD,'
      '1103443=  ERR_CODE INTEGER,'
      '1103444=  ERR_MSG VARCHAR(1024))'
      '1103445=AS'
      
        '1103446=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_PROFIT'#39#39 +
        ';'
      '1103447=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1103448=DECLARE VARIABLE SUM_ZAKAZ_ NUMERIC(15,2) = 0;'
      '1103449=DECLARE VARIABLE SUM_COST_ NUMERIC(15,2) = 0;'
      '1103450=DECLARE VARIABLE NDS_SUMM_ NUMERIC(15,2) = 0;'
      '1103451=DECLARE VARIABLE PROFIT_ NUMERIC(15,2) = 0;'
      '1103452=DECLARE VARIABLE SUM_ZAKAZ_ALL_ NUMERIC(15,2) = 0;'
      '1103453=DECLARE VARIABLE SUM_ZAKAZ_REAL_ NUMERIC(15,2) = 0;'
      '1103454=DECLARE VARIABLE SUM_COST_REAL_ NUMERIC(15,2) = 0;'
      '1103455=DECLARE VARIABLE NDS_SUMM_REAL_ NUMERIC(15,2) = 0;'
      '1103456=DECLARE VARIABLE PROFIT_REAL_ NUMERIC(15,2) = 0;'
      '1103457=DECLARE VARIABLE CNT_ NUMERIC(15,2) = 0;'
      
        '1103458=DECLARE VARIABLE RECCAT_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '1103459=DECLARE VARIABLE RECCAT_PRODUCT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      '1103460=DECLARE VARIABLE REC_ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1103461=DECLARE VARIABLE REC_G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TO' +
        'CHKA;'
      
        '1103462=DECLARE VARIABLE REC_Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE' +
        ';'
      
        '1103463=DECLARE VARIABLE REC_G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CL' +
        'IENT;'
      
        '1103464=DECLARE VARIABLE REC_CLIENT_NAME_ TYPE OF COLUMN G_CLIEN' +
        'T.NAME;'
      
        '1103465=DECLARE VARIABLE REC_G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKA' +
        'Z.G_PAYMENT_TYPE;'
      
        '1103466=DECLARE VARIABLE REC_PAYMENT_NAME_ TYPE OF COLUMN G_PAYM' +
        'ENT_TYPE.NAME;'
      
        '1103467=DECLARE VARIABLE REC_OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSN' +
        'OVANIE;'
      
        '1103468=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PRODUCT' +
        '.G_PRODUCT;'
      
        '1103469=DECLARE VARIABLE REC_G_PRODUCT_PAR_ TYPE OF COLUMN G_PRO' +
        'DUCT.G_PRODUCT_PAR;'
      
        '1103470=DECLARE VARIABLE REC_TOVAR_NAME_ TYPE OF COLUMN G_PRODUC' +
        'T.NAME;'
      
        '1103471=DECLARE VARIABLE REC_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '1103472=DECLARE VARIABLE REC_PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.PRICE;'
      
        '1103473=DECLARE VARIABLE REC_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '1103474=DECLARE VARIABLE REC_DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_PERC;'
      
        '1103475=DECLARE VARIABLE REC_DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ' +
        '_DETAILS.DISCOUNT_SUMM;'
      
        '1103476=DECLARE VARIABLE REC_NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.N' +
        'DS;'
      
        '1103477=DECLARE VARIABLE REC_NDS_SUMM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.NDS_SUMM;'
      
        '1103478=DECLARE VARIABLE REC_PRICE_SELF_ TYPE OF COLUMN SKLAD.PR' +
        'ICE;'
      
        '1103479=DECLARE VARIABLE REC_SUM_COST_ TYPE OF COLUMN SKLAD.SUMM' +
        ';'
      '1103480=DECLARE VARIABLE REC_PROFIT_ NUMERIC(15,2);'
      
        '1103481=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACTIO' +
        'N_DATE;'
      
        '1103482=DECLARE VARIABLE ACTION_NAME_ TYPE OF COLUMN G_PRIHOD_RA' +
        'SHOD.NAME;'
      '1103483=DECLARE VARIABLE SUMM_ TYPE OF COLUMN KASSA.SUMM;'
      
        '1103484=DECLARE VARIABLE V_DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DA' +
        'TE_RECEIPT;'
      
        '1103485=DECLARE VARIABLE V_G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '1103486=DECLARE VARIABLE V_TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      '1103487=DECLARE VARIABLE V_AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '1103488=DECLARE VARIABLE V_PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1103489=DECLARE VARIABLE V_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1103490=DECLARE VARIABLE PRIHOD_ALL_ NUMERIC(15,2) = 0; /* '#1057#1059#1052#1052#1040 +
        ' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1103491=DECLARE VARIABLE PRIHOD_ALL_NAL_ NUMERIC(15,2) = 0; /* '#1057 +
        #1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      
        '1103492=DECLARE VARIABLE PRIHOD_ALL_BEZNAL_ NUMERIC(15,2) = 0; /' +
        '* '#1057#1059#1052#1052#1040' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1040#1052' '#1042' '#1050#1040#1057#1057#1059' */'
      '1103493=DECLARE VARIABLE SUMM_NAL_ TYPE OF COLUMN KASSA.SUMM;'
      '1103494=DECLARE VARIABLE SUMM_BEZNAL_ TYPE OF COLUMN KASSA.SUMM;'
      '1103495=BEGIN'
      
        '1103496=  DELETE FROM P_REP_PROFIT_TABLE WHERE P_REP_PROFIT_TABL' +
        'E = P_REP_PROFIT_TABLE;'
      '1103497=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1103498='
      '1103499=  SUMM_COST_ALL_    = COALESCE(SUMM_COST_ALL_, 0);'
      '11034100=  NDS_SUMM_ALL_     = COALESCE(NDS_SUMM_ALL_, 0);'
      '11034101=  PROFIT_ALL_       = COALESCE(PROFIT_ALL_, 0);'
      '11034102='
      '11034103=  FOR SELECT GP.PATH,'
      '11034104=             GP.G_PRODUCT'
      '11034105=       FROM P_REP_TREE GP'
      '11034106=      WHERE EXISTS (SELECT 1'
      
        '11034107=                      FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G' +
        '_PRODUCT G'
      
        '11034108=                     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39 +
        '-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11034109=                       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11034110=                       AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11034111=                       AND G.G_PRODUCT_PAR = GP.G_PRODU' +
        'CT'
      '11034112=                       AND Z.IS_SPISANIE = 0'
      '11034113=                       AND Z.is_reserve = 0'
      '11034114=                       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11034115=                       AND Z.Z_DATE BETWEEN :DATE_BEGIN' +
        '_ AND :DATE_END_'
      
        '11034116=                       AND COALESCE(Z.G_CLIENT, 0) = CO' +
        'ALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045 +
        #1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11034117=                       AND COALESCE(Z.G_PAYMENT_TYPE, 0' +
        ') = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11034118=                       )'
      '11034119=      ORDER BY 1, 2'
      '11034120=  INTO :RECCAT_NAME_,'
      '11034121=       :RECCAT_PRODUCT_'
      '11034122=  DO BEGIN'
      '11034123=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11034124=    insert into p_rep_profit_table'
      '11034125=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11034126=    values'
      
        '11034127=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_NAME_' +
        ', 1);'
      '11034128='
      '11034129=    FOR SELECT Z.ZAKAZ,'
      '11034130=               Z.G_TOCHKA,'
      '11034131=               Z.Z_DATE,'
      '11034132=               Z.G_CLIENT,'
      '11034133=               C.NAME CLIENT_NAME,'
      '11034134=               Z.G_PAYMENT_TYPE,'
      '11034135=               P.NAME PAYMENT_NAME,'
      '11034136=               Z.OSNOVANIE,'
      '11034137=               G.G_PRODUCT,'
      '11034138=               G.G_PRODUCT_PAR,'
      '11034139=               G.NAME TOVAR_NAME,'
      '11034140=               ZD.AMOUNT,'
      '11034141=               ZD.PRICE,'
      '11034142=               ZD.SUMM,'
      '11034143=               ZD.DISCOUNT_PERC,'
      '11034144=               ZD.DISCOUNT_SUMM,'
      '11034145=               ZD.NDS,'
      '11034146=               ZD.NDS_SUMM,'
      '11034147=               COALESCE(ZD.COST_PRICE, 0)'
      
        '11034148=          FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C ON Z.' +
        'G_CLIENT = C.G_CLIENT,'
      '11034149=               ZAKAZ_DETAILS ZD,'
      '11034150=               G_PRODUCT G,'
      '11034151=               G_PAYMENT_TYPE P'
      
        '11034152=         WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOC' +
        'HKA||'#39#39'-'#39#39
      '11034153=           AND Z.ZAKAZ = ZD.ZAKAZ'
      '11034154=           AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11034155=           AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '11034156=           AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  -- '#1055 +
        #1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '11034157=           AND Z.IS_SPISANIE = 0                   -- '#1058 +
        #1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067
      
        '11034158=           AND Z.IS_RESERVE = 0                    -- '#1058 +
        #1054#1051#1068#1050#1054' '#1056#1045#1040#1051#1068#1053#1067#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1053#1048#1050#1040#1050#1048#1061' '#1056#1045#1047#1045#1056#1042#1054#1042
      '11034159=           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11034160=           AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      
        '11034161=           AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CL' +
        'IENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067 +
        #1052
      
        '11034162=           AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE' +
        '(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11034163=        ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ, ZD' +
        '.ZAKAZ_DETAILS, G.NAME'
      '11034164=    INTO :REC_ZAKAZ_,'
      '11034165=        :REC_G_TOCHKA_,'
      '11034166=        :REC_Z_DATE_,'
      '11034167=        :REC_G_CLIENT_,'
      '11034168=        :REC_CLIENT_NAME_,'
      '11034169=        :REC_G_PAYMENT_TYPE_,'
      '11034170=        :REC_PAYMENT_NAME_,'
      '11034171=        :REC_OSNOVANIE_,'
      '11034172=        :REC_G_PRODUCT_,'
      '11034173=        :REC_G_PRODUCT_PAR_,'
      '11034174=        :REC_TOVAR_NAME_,'
      '11034175=        :REC_AMOUNT_,'
      '11034176=        :REC_PRICE_,'
      '11034177=        :REC_SUMM_,'
      '11034178=        :REC_DISCOUNT_PERC_,'
      '11034179=        :REC_DISCOUNT_SUMM_,'
      '11034180=        :REC_NDS_,'
      '11034181=        :REC_NDS_SUMM_,'
      '11034182=        :REC_PRICE_SELF_'
      '11034183=    DO BEGIN'
      '11034184=      REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_;'
      
        '11034185=      REC_profit_   = REC_SUMM_ - REC_NDS_SUMM_- REC_SU' +
        'M_COST_;'
      '11034186='
      '11034187=      insert into p_rep_profit_table'
      
        '11034188=        (p_rep_profit_table, zakaz, g_tochka, z_date, g' +
        '_client, client_name, g_payment_type, payment_name,'
      
        '11034189=         osnovanie, g_product, g_product_par, tovar_nam' +
        'e, amount, price, summ, discount_perc, discount_summ,'
      
        '11034190=         nds, nds_summ, price_self, sum_self, profit, i' +
        's_head)'
      '11034191=      values'
      '11034192=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '11034193=        :REC_ZAKAZ_,'
      '11034194=        :REC_g_tochka_,'
      
        '11034195=        :REC_z_date_, :REC_g_client_, :REC_client_name_' +
        ', :REC_g_payment_type_, :REC_payment_name_,'
      '11034196=         :REC_osnovanie_,'
      '11034197=         :REC_g_product_,'
      '11034198=         :REC_g_product_par_,'
      '11034199=         :REC_tovar_name_,'
      '11034200=         :REC_amount_,'
      '11034201=         :REC_price_,'
      '11034202=         :REC_summ_,'
      '11034203=         :REC_discount_perc_,'
      '11034204=         :REC_discount_summ_,'
      
        '11034205=         :REC_nds_, :REC_nds_summ_, :REC_price_self_, :' +
        'REC_SUM_COST_, :REC_profit_, 0);'
      '11034206='
      '11034207=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_, 0);'
      
        '11034208=      SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COST_, ' +
        '0);'
      
        '11034209=      NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUMM_, ' +
        '0);'
      '11034210=      PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, 0);'
      '11034211=    END'
      '11034212='
      '11034214=    insert into p_rep_profit_table'
      
        '11034215=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11034216=    values'
      
        '11034217=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :S' +
        'UM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '11034218='
      '11034219=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_;'
      '11034220=    SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_;'
      '11034221=    NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_;'
      '11034222=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11034223='
      '11034224=    SUM_ZAKAZ_ = 0;'
      '11034225=    SUM_COST_  = 0;'
      '11034226=    NDS_SUMM_  = 0;'
      '11034227=    PROFIT_    = 0;'
      '11034228=  END'
      '11034229='
      
        '11034231=  if ((SUM_ZAKAZ_ALL_ + SUMM_COST_ALL_ + NDS_SUMM_ALL_ ' +
        '+ PROFIT_ALL_) > 0) then'
      '11034232=      insert into p_rep_profit_table'
      
        '11034233=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11034234=      values'
      
        '11034235=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1087 +
        #1088#1086#1076#1072#1078#1072#1084#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PR' +
        'OFIT_ALL_, 3);'
      '11034236='
      '11034237=  SELECT COUNT(*)'
      
        '11034238=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11034239=          UNION ALL'
      
        '11034240=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11034241=         G_PRIHOD_RASHOD G'
      
        '11034242=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11034243=    AND K.ACTION = 1'
      
        '11034244=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11034245=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11034246=    AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '11034247=  INTO :CNT_;'
      '11034248='
      '11034249=  IF (CNT_ > 0) THEN BEGIN'
      '11034250=    SUM_COST_  = 0;'
      '11034251=    PROFIT_    = 0;'
      '11034252='
      '11034254=    INSERT INTO P_REP_PROFIT_TABLE'
      '11034255=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11034256=    VALUES'
      
        '11034257=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1056#1040#1057#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11034258='
      '11034259=    FOR SELECT K.ACTION_DATE,'
      '11034260=               K.SUMM,'
      '11034261=               G.NAME'
      
        '11034262=         FROM (SELECT kassa, ACTION_DATE, SUMM, 0 BEZNA' +
        'L, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      
        '11034263=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39
      '11034264=              UNION ALL'
      
        '11034265=              SELECT KASSA_BEZNAL kassa, ACTION_DATE, S' +
        'UMM, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa_bezn' +
        'al'
      
        '11034266=               WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||G' +
        '_TOCHKA||'#39#39'-'#39#39') k,'
      '11034267=              G_PRIHOD_RASHOD G'
      '11034268=        WHERE K.ACTION = 1'
      
        '11034269=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11034270=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      '11034271=          AND G.G_PRIHOD_RASHOD NOT IN (0, 1, 2, 3)'
      '11034272=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11034273=    INTO :ACTION_DATE_,'
      '11034274=         :SUMM_,'
      '11034275=         :ACTION_NAME_'
      '11034276=    DO BEGIN'
      '11034277=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11034278=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11034279=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11034280=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11034281=        VALUES'
      
        '11034282=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, 0,'
      
        '11034283=           0, 0, 0, 0, 0, COALESCE(:SUMM_, 0), -COALESC' +
        'E(:SUMM_, 0), 0);'
      '11034284='
      '11034285=        SUM_COST_ = SUM_COST_ + COALESCE(:SUMM_, 0);'
      '11034286=        PROFIT_   = PROFIT_   - COALESCE(:SUMM_, 0);'
      '11034287=    END'
      '11034288='
      '11034289=    SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11034290=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11034292=    insert into p_rep_profit_table'
      
        '11034293=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11034294=    values'
      
        '11034295=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1056#1040#1057#1061#1054 +
        #1044#1067#39#39', 0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11034296=  END'
      '11034297=  SELECT COUNT(*)'
      
        '11034298=    FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 BEZNAL' +
        ', ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11034299=          UNION ALL'
      
        '11034300=          SELECT KASSA_BEZNAL kassa, ACTION_DATE, SUMM ' +
        'NAL, 0 BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA_BEZN' +
        'AL) K,'
      '11034301=         G_PRIHOD_RASHOD G'
      
        '11034302=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11034303=    AND K.ACTION = 0'
      
        '11034304=    AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_'
      '11034305=    AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11034306=    AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- '#1053#1045' '#1056#1045#1040 +
        #1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11034307=  INTO :CNT_;'
      '11034308='
      '11034309=  IF (CNT_ > 0) THEN BEGIN'
      '11034310=    PRIHOD_ALL_  = 0;'
      '11034311=    PRIHOD_ALL_NAL_  = 0;'
      '11034312=    PRIHOD_ALL_BEZNAL_  = 0;'
      '11034313=    PROFIT_     = 0;'
      '11034314='
      '11034316=    INSERT INTO P_REP_PROFIT_TABLE'
      '11034317=      (P_REP_PROFIT_TABLE, TOVAR_NAME, IS_HEAD)'
      '11034318=    VALUES'
      
        '11034319=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1055#1056#1048#1061#1054#1044#1067#39#39', ' +
        '1);'
      '11034320='
      '11034321=    FOR SELECT K.ACTION_DATE,'
      '11034322=               K.NAL,'
      '11034323=               K.BEZNAL,'
      '11034324=               G.NAME'
      
        '11034325=         FROM (SELECT kassa, ACTION_DATE, SUMM NAL, 0 B' +
        'EZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM KASSA'
      '11034326=               UNION ALL'
      
        '11034327=               SELECT kassa_BEZNAL KASSA, ACTION_DATE, ' +
        '0 NAL, SUMM BEZNAL, ACTION, G_PRIHOD_RASHOD, G_TOCHKA FROM kassa' +
        '_beznal) K,'
      '11034328=              G_PRIHOD_RASHOD G'
      
        '11034329=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||K.G_TOCH' +
        'KA||'#39#39'-'#39#39
      '11034330=          AND K.ACTION = 0'
      
        '11034331=          AND K.ACTION_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '11034332=          AND K.G_PRIHOD_RASHOD = G.G_PRIHOD_RASHOD'
      
        '11034333=          AND G.G_PRIHOD_RASHOD NOT IN (1, 2, 3)    -- ' +
        #1053#1045' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1071', '#1047#1040#1050#1059#1055#1050#1040' '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '11034334=        ORDER BY K.ACTION_DATE, K.KASSA'
      '11034335=    INTO :ACTION_DATE_,'
      '11034336=         :SUMM_NAL_,'
      '11034337=         :SUMM_BEZNAL_,'
      '11034338=         :ACTION_NAME_'
      '11034339=    DO BEGIN'
      '11034340=        INSERT INTO P_REP_PROFIT_TABLE'
      
        '11034341=          (P_REP_PROFIT_TABLE, Z_DATE, tovar_name, SUMM' +
        ','
      '11034342=           DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11034343=           NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT,' +
        ' IS_HEAD)'
      '11034344=        VALUES'
      
        '11034345=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :ACTION_D' +
        'ATE_, :ACTION_NAME_, :SUMM_NAL_ + :SUMM_BEZNAL_,'
      
        '11034346=           0, 0, 0, 0, 0, 0, :SUMM_NAL_ + :SUMM_BEZNAL_' +
        ', 0);'
      '11034347='
      '11034348=        PRIHOD_ALL_NAL_ = PRIHOD_ALL_NAL_ + SUMM_NAL_;'
      
        '11034349=        PRIHOD_ALL_BEZNAL_ = PRIHOD_ALL_BEZNAL_ + SUMM_' +
        'BEZNAL_;'
      
        '11034350=        PRIHOD_ALL_ = PRIHOD_ALL_ + PRIHOD_ALL_NAL_ + P' +
        'RIHOD_ALL_BEZNAL_;'
      
        '11034351=        PROFIT_    = PROFIT_    + SUMM_NAL_ + SUMM_BEZN' +
        'AL_;'
      '11034352=    END'
      '11034353='
      '11034354=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + PRIHOD_ALL_;'
      '11034355=    PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_;'
      '11034357=    insert into p_rep_profit_table'
      
        '11034358=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11034359=    values'
      
        '11034360=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054' '#1055#1056#1048#1061#1054 +
        #1044#1067#39#39', :PRIHOD_ALL_, 0, 0, :PROFIT_, 2);'
      '11034361=  END'
      '11034362=  SELECT COUNT(*)'
      '11034363=    FROM ZAKAZ Z'
      
        '11034364=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11034365=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      '11034366=     AND Z.IS_SPISANIE = 1'
      
        '11034367=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(Z.G_CLIENT, 0))'
      
        '11034368=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11034369=  INTO :CNT_;'
      '11034370='
      '11034371=  IF (CNT_ > 0) THEN BEGIN'
      '11034372=      SUM_ZAKAZ_ = 0;'
      '11034373=      SUM_COST_  = 0;'
      '11034374=      PROFIT_    = 0;'
      '11034375='
      '11034376=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11034377=      insert into p_rep_profit_table'
      '11034378=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11034379=      values'
      
        '11034380=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1057#1055#1048#1057#1040#1053#1053#1067#1049 +
        ' '#1058#1054#1042#1040#1056#39#39', 1);'
      '11034381='
      '11034382=      FOR SELECT Z.ZAKAZ,'
      '11034383=                 Z.G_TOCHKA,'
      '11034384=                 Z.Z_DATE,'
      '11034385=                 Z.G_CLIENT,'
      '11034386=                 '#39#39#39#39' CLIENT_NAME,'
      '11034387=                 Z.G_PAYMENT_TYPE,'
      '11034388=                 '#39#39#39#39' PAYMENT_NAME,'
      '11034389=                 Z.OSNOVANIE,'
      '11034390=                 G.G_PRODUCT,'
      '11034391=                 G.G_PRODUCT_PAR,'
      '11034392=                 G.NAME TOVAR_NAME,'
      '11034393=                 ZD.AMOUNT,'
      '11034394=                 ZD.PRICE,'
      '11034395=                 ZD.SUMM,'
      '11034396=                 0 DISCOUNT_PERC, --ZD.DISCOUNT_PERC,'
      '11034397=                 0 DISCOUNT_SUMM, --ZD.DISCOUNT_SUMM,'
      '11034398=                 0 NDS, --ZD.NDS,'
      '11034399=                 0 NDS_SUMM'
      '11034400=            FROM ZAKAZ Z, ZAKAZ_DETAILS ZD, G_PRODUCT G'
      
        '11034401=           WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_T' +
        'OCHKA||'#39#39'-'#39#39
      '11034402=             AND Z.ZAKAZ = ZD.ZAKAZ'
      '11034403=             AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '11034404=             AND Z.IS_SPISANIE = 1                    -' +
        '- '#1058#1054#1051#1068#1050#1054' '#1057#1055#1048#1057#1040#1053#1048#1071
      '11034405=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11034406=             AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '11034407=             AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_' +
        'CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057 +
        #1058#1067#1052
      
        '11034408=             AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALES' +
        'CE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11034409=          ORDER BY G.NAME, Z.Z_DATE, Z.ZAKAZ, ZD.ZAKAZ_' +
        'DETAILS'
      '11034410=      INTO :REC_ZAKAZ_,'
      '11034411=            :REC_G_TOCHKA_,'
      '11034412=            :REC_Z_DATE_,'
      '11034413=            :REC_G_CLIENT_,'
      '11034414=            :REC_CLIENT_NAME_,'
      '11034415=            :REC_G_PAYMENT_TYPE_,'
      '11034416=            :REC_PAYMENT_NAME_,'
      '11034417=            :REC_OSNOVANIE_,'
      '11034418=            :REC_G_PRODUCT_,'
      '11034419=            :REC_G_PRODUCT_PAR_,'
      '11034420=            :REC_TOVAR_NAME_,'
      '11034421=            :REC_AMOUNT_,'
      '11034422=            :REC_PRICE_,'
      '11034423=            :REC_SUMM_,'
      '11034424=            :REC_DISCOUNT_PERC_,'
      '11034425=            :REC_DISCOUNT_SUMM_,'
      '11034426=            :REC_NDS_,'
      '11034427=            :REC_NDS_SUMM_'
      '11034428=      DO BEGIN'
      '11034431=        REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_;'
      '11034432=        REC_profit_   = -REC_SUMM_;'
      '11034433='
      '11034434=        insert into p_rep_profit_table'
      
        '11034435=          (p_rep_profit_table, zakaz, g_tochka, z_date,' +
        ' g_client, client_name, g_payment_type, payment_name,'
      
        '11034436=           osnovanie, g_product, g_product_par, tovar_n' +
        'ame, amount, price, summ, discount_perc, discount_summ,'
      
        '11034437=           nds, nds_summ, price_self, sum_self, profit,' +
        ' is_head)'
      '11034438=        values'
      
        '11034439=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :REC_ZAKA' +
        'Z_, :REC_g_tochka_, :REC_z_date_, :REC_g_client_, :REC_client_na' +
        'me_, :REC_g_payment_type_, :REC_payment_name_,'
      
        '11034440=         :REC_osnovanie_, :REC_g_product_, :REC_g_produ' +
        'ct_par_, :REC_tovar_name_, :REC_amount_, 0, 0, :REC_discount_per' +
        'c_, :REC_discount_summ_,'
      
        '11034441=         :REC_nds_, :REC_nds_summ_, :REC_PRICE_, :REC_S' +
        'UM_COST_, :REC_profit_, 0);'
      '11034442='
      
        '11034443=        SUM_COST_ = SUM_COST_ + COALESCE(:REC_SUM_COST_' +
        ', 0);'
      
        '11034444=        PROFIT_    = PROFIT_ + COALESCE(:REC_profit_, 0' +
        ');'
      '11034445=      END'
      '11034446='
      '11034448=      insert into p_rep_profit_table'
      
        '11034449=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11034450=      values'
      
        '11034451=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', ' +
        '0, :SUM_COST_, 0, :PROFIT_, 2);'
      '11034452='
      '11034453=      SUMM_COST_ALL_ = SUMM_COST_ALL_ + SUM_COST_;'
      '11034454=      PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '11034455=  END'
      '11034456='
      '11034457=  SELECT COUNT(*)'
      '11034458=    FROM SKLAD S'
      
        '11034459=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39 +
        #39'-'#39#39
      
        '11034460=     AND S.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DATE_' +
        'END_'
      '11034461=     AND S.IS_VOZVRAT IN (1,2)'
      
        '11034462=     AND S.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(S.G' +
        '_CLIENT, 0))'
      
        '11034463=     AND S.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, ' +
        'COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11034464=  INTO :CNT_;'
      '11034465='
      '11034466=  IF (CNT_ > 0) THEN BEGIN'
      '11034467=    SUM_ZAKAZ_ = 0;'
      '11034468=    PROFIT_    = 0;'
      '11034469=    SUM_COST_  = 0;'
      '11034470='
      '11034472=    insert into p_rep_profit_table'
      '11034473=      (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11034474=    values'
      
        '11034475=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042 +
        #1040#1056#1040#39#39', 1);'
      '11034476='
      '11034477=    FOR SELECT S.DATE_RECEIPT,'
      '11034478=               S.G_PRODUCT,'
      '11034479=               G.NAME TOVAR_NAME,'
      '11034480=               S.AMOUNT,'
      '11034481=               S.PRICE,'
      '11034482=               S.SUMM,'
      '11034483=               SP.G_TOCHKA'
      '11034484=         FROM SKLAD_PARENT SP,'
      '11034485=              SKLAD S,'
      '11034486=              G_PRODUCT G'
      
        '11034487=        WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||SP.G_TOC' +
        'HKA||'#39#39'-'#39#39
      
        '11034488=          AND SP.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND ' +
        ':DATE_END_'
      '11034489=          AND SP.IS_VOZVRAT IN (1,2)'
      
        '11034490=          AND SP.G_CLIENT = COALESCE(:G_CLIENT_, COALES' +
        'CE(S.G_CLIENT, 0))'
      
        '11034491=          AND SP.G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_T' +
        'YPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11034492=          AND SP.SKLAD = S.SKLAD_PARENT'
      '11034493=          AND S.G_PRODUCT = G.G_PRODUCT'
      '11034494=        ORDER BY 1'
      '11034495=    INTO :V_DATE_RECEIPT_,'
      '11034496=         :V_G_PRODUCT_,'
      '11034497=         :V_TOVAR_NAME_,'
      '11034498=         :V_AMOUNT_,'
      '11034499=         :V_PRICE_,'
      '11034500=         :V_SUMM_,'
      '11034501=         :REC_G_TOCHKA_'
      '11034502=    DO BEGIN'
      '11034503=      --REC_SUM_COST_ = V_AMOUNT_ * REC_PRICE_SELF_;'
      '11034504=      REC_profit_   = 0/*REC_SUM_COST_*/ - V_SUMM_;'
      '11034505='
      '11034506='
      '11034507=      INSERT INTO P_REP_PROFIT_TABLE'
      
        '11034508=        (P_REP_PROFIT_TABLE, Z_DATE, G_PRODUCT, TOVAR_N' +
        'AME, AMOUNT, PRICE, SUMM,'
      '11034509=         DISCOUNT_PERC, DISCOUNT_SUMM,'
      
        '11034510=         NDS, NDS_SUMM, PRICE_SELF, SUM_SELF, PROFIT, I' +
        'S_HEAD)'
      '11034511=      VALUES'
      
        '11034512=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :V_DATE_REC' +
        'EIPT_, :V_G_PRODUCT_, :V_TOVAR_NAME_, :V_AMOUNT_, 0 /*:REC_PRICE' +
        '_SELF_*/, 0/*:REC_SUM_COST_*/,  -- 26.05.2016 '#1055#1054#1057#1063#1048#1058#1040#1051' '#1042' '#1045#1050#1057#1045#1051#1045' ' +
        #1048' '#1055#1054#1053#1071#1051' '#1063#1058#1054' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1050#1054#1051#1054#1053#1050#1059' '#1057#1050#1054#1051#1068#1050#1054' '#1055#1054#1058#1056#1040#1063#1045#1053#1054', '#1042#1045 +
        #1056#1053#1059#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1040' 7000, '#1047#1053#1040#1063#1048#1058' '#1042' '#1059#1041#1067#1058#1050#1045' '#1053#1040' 7000'
      
        '11034513=         0, 0, 0, 0, :V_PRICE_, :V_SUMM_, :REC_profit_,' +
        ' 0);'
      '11034514='
      '11034516=      SUM_COST_ = 0;'
      '11034517=      SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(V_SUMM_, 0);'
      '11034518=      PROFIT_    = PROFIT_ + COALESCE(REC_profit_, 0);'
      '11034519=    END'
      '11034520='
      '11034521='
      '11034522=    SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_COST_;'
      '11034523=    SUMM_COST_All_ = SUMM_COST_All_ + SUM_ZAKAZ_;'
      '11034524=    PROFIT_ALL_   = PROFIT_ALL_ + PROFIT_;'
      '11034525='
      '11034527=    insert into p_rep_profit_table'
      
        '11034528=      (p_rep_profit_table, tovar_name, summ, sum_self, ' +
        'NDS_SUMM, profit, is_head)'
      '11034529=    values'
      
        '11034530=      (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39', :S' +
        'UM_COST_, :SUM_ZAKAZ_, 0, :PROFIT_, 2);'
      '11034531=  END'
      '11034532='
      '11034533=  SELECT COUNT(*)'
      '11034534=    FROM ZAKAZ S'
      
        '11034535=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11034536=     AND S.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11034537=     AND COALESCE(S.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(S.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11034538=     AND COALESCE(S.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(S.G_PAYMENT_TYPE, 0))'
      '11034539=     AND S.IS_SPISANIE = 2'
      '11034540=  INTO :CNT_;'
      '11034541='
      '11034542=  IF (CNT_ > 0) THEN BEGIN'
      '11034544=      insert into p_rep_profit_table'
      '11034545=        (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11034546=      values'
      
        '11034547=        (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1058#1054#1042#1040#1056' '#1053#1040' ' +
        #1056#1045#1040#1051#1048#1047#1040#1062#1048#1048#39#39', 1);'
      '11034548='
      '11034549=      SUM_ZAKAZ_ = 0;'
      '11034550=      SUM_COST_  = 0;'
      '11034551=      NDS_SUMM_  = 0;'
      '11034552=      PROFIT_    = 0;'
      '11034553=      FOR SELECT GP.NAME,'
      '11034554=                 GP.G_PRODUCT'
      '11034555=           FROM G_PRODUCT GP'
      '11034556=          WHERE IS_CATEGORY = 1'
      '11034557=            AND EXISTS (SELECT 1'
      
        '11034558=                          FROM ZAKAZ Z, ZAKAZ_DETAILS Z' +
        'D, G_PRODUCT G'
      
        '11034559=                         WHERE :G_TOCHKA_ARR_ CONTAININ' +
        'G '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      '11034560=                           AND Z.ZAKAZ = ZD.ZAKAZ'
      
        '11034561=                           AND ZD.G_PRODUCT = G.G_PRODU' +
        'CT'
      
        '11034562=                           AND G.G_PRODUCT_PAR = GP.G_P' +
        'RODUCT'
      '11034563=                           AND Z.IS_SPISANIE = 2'
      '11034564=                           -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11034565=                           AND Z.Z_DATE BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      
        '11034566=                           AND COALESCE(Z.G_CLIENT, 0) ' +
        '= COALESCE(:G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' ' +
        #1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11034567=                           AND COALESCE(Z.G_PAYMENT_TYP' +
        'E, 0) = COALESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0)' +
        ')'
      '11034568=                           )'
      '11034569=          ORDER BY 1'
      '11034570=      INTO :RECCAT_NAME_,'
      '11034571=           :RECCAT_PRODUCT_'
      '11034572=      DO BEGIN'
      '11034574=        insert into p_rep_profit_table'
      '11034575=          (p_rep_profit_table, tovar_name, IS_HEAD)'
      '11034576=        values'
      
        '11034577=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), :RECCAT_N' +
        'AME_, 1);'
      '11034578='
      '11034579=        FOR SELECT Z.ZAKAZ,'
      '11034580=                   Z.G_TOCHKA,'
      '11034581=                   Z.Z_DATE,'
      '11034582=                   Z.G_CLIENT,'
      '11034583=                   C.NAME CLIENT_NAME,'
      '11034584=                   Z.G_PAYMENT_TYPE,'
      '11034585=                   P.NAME PAYMENT_NAME,'
      '11034586=                   Z.OSNOVANIE,'
      '11034587=                   G.G_PRODUCT,'
      '11034588=                   G.G_PRODUCT_PAR,'
      '11034589=                   G.NAME TOVAR_NAME,'
      '11034590=                   ZD.AMOUNT,'
      '11034591=                   ZD.PRICE,'
      '11034592=                   ZD.SUMM,'
      '11034593=                   ZD.DISCOUNT_PERC,'
      '11034594=                   ZD.DISCOUNT_SUMM,'
      '11034595=                   ZD.NDS,'
      '11034596=                   ZD.NDS_SUMM,'
      '11034597=                   ZD.COST_PRICE'
      
        '11034598=              FROM ZAKAZ Z LEFT OUTER JOIN G_CLIENT C O' +
        'N Z.G_CLIENT = C.G_CLIENT,'
      '11034599=                   ZAKAZ_DETAILS ZD,'
      '11034600=                   G_PRODUCT G,'
      '11034601=                   G_PAYMENT_TYPE P'
      
        '11034602=             WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G' +
        '_TOCHKA||'#39#39'-'#39#39
      '11034603=               AND Z.ZAKAZ = ZD.ZAKAZ'
      '11034604=               AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11034605=               AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      
        '11034606=               AND G.G_PRODUCT_PAR = :RECCAT_PRODUCT_  ' +
        '-- '#1055#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1071#1052
      
        '11034607=               AND Z.IS_SPISANIE = 2                   ' +
        ' -- '#1058#1054#1051#1068#1050#1054' '#1047#1040#1050#1040#1047#1067' '#1054#1058#1044#1040#1053#1053#1067#1045' '#1055#1054#1044' '#1056#1045#1040#1051
      '11034608=               -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11034609=               AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      
        '11034610=               AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:' +
        'G_CLIENT_, COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055 +
        #1059#1057#1058#1067#1052
      
        '11034611=               AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COAL' +
        'ESCE(:G_PAYMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      
        '11034612=            ORDER BY G.G_PRODUCT_PAR, Z.Z_DATE, Z.ZAKAZ' +
        ', ZD.ZAKAZ_DETAILS, G.NAME'
      '11034613=        INTO :REC_ZAKAZ_,'
      '11034614=            :REC_G_TOCHKA_,'
      '11034615=            :REC_Z_DATE_,'
      '11034616=            :REC_G_CLIENT_,'
      '11034617=            :REC_CLIENT_NAME_,'
      '11034618=            :REC_G_PAYMENT_TYPE_,'
      '11034619=            :REC_PAYMENT_NAME_,'
      '11034620=            :REC_OSNOVANIE_,'
      '11034621=            :REC_G_PRODUCT_,'
      '11034622=            :REC_G_PRODUCT_PAR_,'
      '11034623=            :REC_TOVAR_NAME_,'
      '11034624=            :REC_AMOUNT_,'
      '11034625=            :REC_PRICE_,'
      '11034626=            :REC_SUMM_,'
      '11034627=            :REC_DISCOUNT_PERC_,'
      '11034628=            :REC_DISCOUNT_SUMM_,'
      '11034629=            :REC_NDS_,'
      '11034630=            :REC_NDS_SUMM_,'
      '11034631=            :REC_PRICE_SELF_'
      '11034632=        DO BEGIN'
      
        '11034633=          REC_SUM_COST_ = REC_AMOUNT_ * REC_PRICE_SELF_' +
        ';'
      
        '11034634=          REC_profit_   = REC_SUMM_ - REC_SUM_COST_ - R' +
        'EC_NDS_SUMM_;'
      '11034635='
      '11034636=          insert into p_rep_profit_table'
      
        '11034637=            (p_rep_profit_table, zakaz, g_tochka, z_dat' +
        'e, g_client, client_name, g_payment_type, payment_name,'
      
        '11034638=             osnovanie, g_product, g_product_par, tovar' +
        '_name, amount, price, summ, discount_perc, discount_summ,'
      
        '11034639=             nds, nds_summ, price_self, sum_self, profi' +
        't, is_head)'
      '11034640=          values'
      '11034641=            (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1),'
      '11034642=            :REC_ZAKAZ_,'
      '11034643=            :REC_g_tochka_,'
      
        '11034644=            :REC_z_date_, :REC_g_client_, :REC_client_n' +
        'ame_, :REC_g_payment_type_, :REC_payment_name_,'
      '11034645=             :REC_osnovanie_,'
      '11034646=             :REC_g_product_,'
      '11034647=             :REC_g_product_par_,'
      '11034648=             :REC_tovar_name_,'
      '11034649=             :REC_amount_,'
      '11034650=             :REC_price_,'
      '11034651=             :REC_summ_,'
      '11034652=             :REC_discount_perc_,'
      '11034653=             :REC_discount_summ_,'
      
        '11034654=             :REC_nds_, :REC_nds_summ_, :REC_price_self' +
        '_, :REC_SUM_COST_, :REC_profit_, 0);'
      '11034655='
      
        '11034656=          SUM_ZAKAZ_ = SUM_ZAKAZ_ + COALESCE(REC_SUMM_,' +
        ' 0);'
      
        '11034657=          SUM_COST_  = SUM_COST_ + COALESCE(REC_SUM_COS' +
        'T_, 0);'
      
        '11034658=          NDS_SUMM_  = NDS_SUMM_ + COALESCE(REC_NDS_SUM' +
        'M_, 0);'
      
        '11034659=          PROFIT_    = PROFIT_ + COALESCE(REC_PROFIT_, ' +
        '0);'
      '11034660=        END'
      '11034661='
      '11034662=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11034663=        insert into p_rep_profit_table'
      
        '11034664=          (p_rep_profit_table, tovar_name, summ, sum_se' +
        'lf, NDS_SUMM, profit, is_head)'
      '11034665=        values'
      
        '11034666=          (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1058#1054#1043#1054#39#39 +
        ', :SUM_ZAKAZ_, :SUM_COST_, :NDS_SUMM_, :PROFIT_, 2);'
      '11034667='
      '11034668=        SUM_ZAKAZ_REAL_ = SUM_ZAKAZ_REAL_ + SUM_ZAKAZ_;'
      '11034669=        SUM_COST_REAL_  = SUM_COST_REAL_ + SUM_COST_;'
      '11034670=        NDS_SUMM_REAL_  = NDS_SUMM_REAL_ + NDS_SUMM_;'
      '11034671=        PROFIT_REAL_    = PROFIT_REAL_ + PROFIT_;'
      '11034672='
      '11034673=        SUM_ZAKAZ_ = 0;'
      '11034674=        SUM_COST_  = 0;'
      '11034675=        NDS_SUMM_  = 0;'
      '11034676=        PROFIT_    = 0;'
      '11034677=      END'
      '11034678='
      '11034679=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '11034680=      insert into p_rep_profit_table'
      
        '11034681=        (p_rep_profit_table, tovar_name, summ, sum_self' +
        ', NDS_SUMM, profit, is_head)'
      '11034682=      values'
      
        '11034683=       (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1079#1072' '#1090 +
        #1086#1074#1072#1088' '#1085#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080#39#39', :SUM_ZAKAZ_REAL_, :SUM_COST_REAL_, :NDS_SU' +
        'MM_REAL_, :PROFIT_REAL_, 2);'
      '11034684='
      
        '11034685=      SUM_ZAKAZ_ALL_ = SUM_ZAKAZ_ALL_ + SUM_ZAKAZ_REAL_' +
        ';'
      
        '11034686=      SUMM_COST_ALL_  = SUMM_COST_ALL_ + SUM_COST_REAL_' +
        ';'
      '11034687=      NDS_SUMM_ALL_  = NDS_SUMM_ALL_ + NDS_SUMM_REAL_;'
      '11034688=      PROFIT_ALL_    = PROFIT_ALL_ + PROFIT_REAL_;'
      '11034689=  END'
      '11034690='
      '11034691=  insert into p_rep_profit_table'
      '11034692=    (p_rep_profit_table, is_head)'
      '11034693=  values'
      '11034694=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), 2);'
      '11034695='
      '11034697=  insert into p_rep_profit_table'
      
        '11034698=    (p_rep_profit_table, tovar_name, summ, sum_self, ND' +
        'S_SUMM, profit, is_head)'
      '11034699=  values'
      
        '11034700=   (GEN_ID(GEN_P_REP_PROFIT_TABLE, 1), '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1084#1072#1075#1072#1079 +
        #1080#1085#1091#39#39', :SUM_ZAKAZ_ALL_, :SUMM_COST_ALL_, :NDS_SUMM_ALL_, :PROFIT' +
        '_ALL_, 1);'
      '11034701='
      '11034703=  SELECT SUM(Z.summ_cash) + :PRIHOD_ALL_NAL_,'
      '11034704=         SUM(Z.summ_noncash) + :PRIHOD_ALL_BEZNAL_,'
      '11034705=         SUM(Z.SUMM_BONUS)'
      '11034706=    FROM ZAKAZ Z'
      
        '11034707=   WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39 +
        #39'-'#39#39
      '11034708=     AND Z.IS_SPISANIE not in (1, 4)'
      '11034709=     AND Z.IS_RESERVE = 0'
      '11034710=     AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END_'
      
        '11034711=     AND COALESCE(Z.G_CLIENT, 0) = COALESCE(:G_CLIENT_,' +
        ' COALESCE(Z.G_CLIENT, 0))  -- '#1055#1054#1051#1045' '#1050#1051#1048#1045#1053#1058' '#1052#1054#1046#1045#1058' '#1041#1067#1058#1068' '#1055#1059#1057#1058#1067#1052
      
        '11034712=     AND COALESCE(Z.G_PAYMENT_TYPE, 0) = COALESCE(:G_PA' +
        'YMENT_TYPE_, COALESCE(Z.G_PAYMENT_TYPE, 0))'
      '11034713=    INTO :SUMM_CASH_ALL_,'
      '11034714=         :SUMM_NONCASH_ALL_,'
      '11034715=         :SUMM_BONUS_ALL_;'
      '11034716='
      '11034717=  SUMM_CASH_ALL_ = COALESCE(SUMM_CASH_ALL_, 0);'
      '11034718=  SUMM_NONCASH_ALL_ = COALESCE(SUMM_NONCASH_ALL_, 0);'
      '11034719=  SUMM_BONUS_ALL_   = COALESCE(SUMM_BONUS_ALL_, 0);'
      '11034720='
      '11034721=  SUMM_ALL_ = SUMM_CASH_ALL_ + SUMM_NONCASH_ALL_;'
      '11034722='
      
        '11034723=  SUMM_COST_ALL_STR = REPLACE(CAST(SUMM_COST_ALL_ AS VA' +
        'RCHAR(100)), '#39#39'.'#39#39', '#39#39','#39#39');'
      
        '11034724=  PROFIT_ALL_REAL_ = SUMM_ALL_ - SUMM_COST_ALL_ - nds_s' +
        'umm_all_;'
      '11034725='
      '11034726=  IF (COALESCE(:G_CLIENT_, 0) <> 0) THEN'
      '11034727=    SELECT G.NAME'
      '11034728=      FROM G_CLIENT G'
      '11034729=     WHERE G.G_CLIENT = :G_CLIENT_'
      '11034730=    INTO :CLIENT_NAME_;'
      '11034731=  ELSE'
      '11034732=    CLIENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '11034733='
      '11034734=  IF (COALESCE(G_PAYMENT_TYPE_, 0) <> 0) THEN'
      '11034735=    SELECT G.NAME'
      '11034736=      FROM G_PAYMENT_TYPE G'
      '11034737=     WHERE G.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_'
      '11034738=    INTO :PAYMENT_NAME_;'
      '11034739=  ELSE'
      '11034740=    PAYMENT_NAME_ = '#39#39#1042#1089#1077#39#39';'
      '11034741='
      '11034742=  FOR SELECT P.P_REP_PROFIT_TABLE,'
      '11034743=        P.ZAKAZ,'
      '11034744=        P.G_TOCHKA,'
      '11034745=        P.Z_DATE,'
      '11034746=        P.G_CLIENT,'
      '11034747=        P.CLIENT_NAME,'
      '11034748=        P.G_PAYMENT_TYPE,'
      '11034749=        P.PAYMENT_NAME,'
      '11034750=        P.OSNOVANIE,'
      '11034751=        P.G_PRODUCT,'
      '11034752=        P.G_PRODUCT_PAR,'
      '11034753=        P.TOVAR_NAME,'
      '11034754=        G.ARTICUL,'
      '11034755=        P.AMOUNT,'
      '11034756=        P.PRICE,'
      '11034757=        P.SUMM,'
      '11034758=        P.DISCOUNT_PERC,'
      '11034759=        P.DISCOUNT_SUMM,'
      '11034760=        P.NDS,'
      '11034761=        P.NDS_SUMM,'
      '11034762=        P.PRICE_SELF,'
      '11034763=        P.SUM_SELF,'
      '11034764=        P.PROFIT,'
      '11034765=        P.IS_HEAD'
      
        '11034766=    FROM P_REP_PROFIT_TABLE P LEFT OUTER JOIN G_PRODUCT' +
        ' G ON P.G_PRODUCT = G.G_PRODUCT'
      '11034767=    ORDER BY 1'
      '11034768=  INTO :P_REP_PROFIT_TABLE,'
      '11034769=       :ZAKAZ,'
      '11034770=       :G_TOCHKA,'
      '11034771=       :Z_DATE,'
      '11034772=       :G_CLIENT,'
      '11034773=       :CLIENT_NAME,'
      '11034774=       :G_PAYMENT_TYPE,'
      '11034775=       :PAYMENT_NAME,'
      '11034776=       :OSNOVANIE,'
      '11034777=       :G_PRODUCT,'
      '11034778=       :G_PRODUCT_PAR,'
      '11034779=       :TOVAR_NAME,'
      '11034780=       :ARTICUL,'
      '11034781=       :AMOUNT,'
      '11034782=       :PRICE,'
      '11034783=       :SUMM,'
      '11034784=       :DISCOUNT_PERC,'
      '11034785=       :DISCOUNT_SUMM,'
      '11034786=       :NDS,'
      '11034787=       :NDS_SUMM,'
      '11034788=       :PRICE_SELF,'
      '11034789=       :SUM_SELF,'
      '11034790=       :PROFIT,'
      '11034791=       :IS_HEAD'
      '11034792=  DO'
      '11034793=    suspend;'
      '11034794='
      '11034795=WHEN ANY DO BEGIN'
      '11034796=    Err_code = -20500;'
      
        '11034797=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11034798=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11034799=  END'
      '11034800=end'
      '11034801='#39';'
      '11034802=END  --END_EXECUTE_BLOCK'
      '110350=EXECUTE BLOCK AS BEGIN'
      '110351=EXECUTE STATEMENT '#39'ALTER PROCEDURE IMPORT_DOWNLOAD('
      '110352=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110353=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110354=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110355=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110356=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110357=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110358=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110359=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1103510=RETURNS ('
      '1103511=  ERR_CODE INTEGER,'
      '1103512=  ERR_MSG VARCHAR(1024))'
      '1103513=AS'
      '1103514=/*'
      
        '1103515='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1047#1040#1043#1056#1059#1047#1050#1048' '#1044#1040#1053#1053#1067#1061' '#1048#1047' '#1048#1053#1058#1045#1056#1053#1045#1058'-'#1052#1040#1043#1040#1047#1048#1053#1040' '#1042' '#1041#1040#1047#1059' '#1044#1040 +
        #1053#1053#1067#1061
      
        '1103516='#1044#1040#1053#1053#1067#1045' '#1059#1046#1045' '#1045#1057#1058#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1045' IMPORT_TBL_TMP, '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1054' '#1055#1054 +
        ' '#1053#1048#1052' '#1055#1056#1054#1041#1045#1046#1040#1058#1068#1057#1071' '#1048' '#1048#1044#1045#1053#1058#1048#1060#1048#1062#1048#1056#1054#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067
      '1103517='#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1058#1054#1042#1040#1056
      '1103518=*/'
      
        '1103519=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'IMPORT_DOWNLOA' +
        'D'#39#39';'
      '1103520=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1103521=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN IMPORT_TBL_TMP.' +
        'BARCODE;'
      
        '1103522=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN IMPORT_TBL_TMP.' +
        'ARTICUL;'
      
        '1103523=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN IMPORT_TBL_TMP.A' +
        'MOUNT;'
      
        '1103524=DECLARE VARIABLE PRICE_ TYPE OF COLUMN IMPORT_TBL_TMP.PR' +
        'ICE;'
      
        '1103525=DECLARE VARIABLE PRICE_OUR_ TYPE OF COLUMN IMPORT_TBL_TM' +
        'P.PRICE;'
      
        '1103526=DECLARE VARIABLE DISCOUNT_ TYPE OF COLUMN IMPORT_TBL_TMP' +
        '.DISCOUNT;'
      '1103527=DECLARE VARIABLE CLRF VARCHAR(2);'
      
        '1103528=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      '1103529=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2);'
      
        '1103530=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.DISCOUNT_PERC;'
      '1103531=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS;'
      
        '1103532=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS_TMP.ZAKAZ_DETAILS;'
      
        '1103533=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.COST_PRICE;'
      '1103534=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1103535=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CA' +
        'SH;'
      
        '1103536=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_NONCASH;'
      
        '1103537=DECLARE VARIABLE SUMM__ TYPE OF COLUMN ZAKAZ.SUMM_NONCAS' +
        'H;'
      '1103538=BEGIN'
      '1103539='
      '1103540=  PNT_ = '#39#39'00'#39#39';'
      '1103541=  CLRF = ascii_char( 10 );'
      '1103542='
      '1103543=  SELECT S.S_VALUE'
      '1103544=    FROM SYSTEM_SETUP S'
      '1103545=   WHERE S.SYSTEM_SETUP = 2'
      '1103546=    INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1103547='
      '1103548=  PNT_ = '#39#39'01'#39#39';'
      '1103549=  SELECT G.nds_value'
      '1103550=    FROM G_FIRM_REKVIZIT G'
      '1103551=   WHERE G.is_default = 1'
      '1103552=    INTO :NDS_;'
      '1103553='
      '1103554=  PNT_ = '#39#39'02'#39#39';'
      
        '1103555=  FOR SELECT TRIM(COALESCE(BARCODE, '#39#39#39#39')), ARTICUL, AMO' +
        'UNT, PRICE, DISCOUNT'
      '1103556=        FROM IMPORT_TBL_TMP'
      
        '1103557=        INTO :BARCODE_, :ARTICUL_, :AMOUNT_, :PRICE_, :D' +
        'ISCOUNT_'
      '1103558=  DO BEGIN'
      '1103559=    SELECT G_PRODUCT,'
      '1103560=           PRICE'
      '1103561=      FROM ('
      '1103562=            SELECT P.G_PRODUCT, P.price'
      '1103563=              FROM G_PRODUCT P'
      
        '1103564=             WHERE (P.BARCODE = :BARCODE_ AND TRIM(COALE' +
        'SCE(P.BARCODE, '#39#39#39#39')) <> '#39#39#39#39')'
      
        '1103565=                OR (P.ARTICUL = :ARTICUL_ and TRIM(COALE' +
        'SCE(P.ARTICUL, '#39#39#39#39')) <> '#39#39#39#39')'
      '1103566=            UNION'
      '1103567=            SELECT LT.G_PRODUCT, P.PRICE'
      '1103568=              FROM LT_BARCODE LT, g_product P'
      
        '1103569=             WHERE LT.BARCODE = :BARCODE_ and TRIM(COALE' +
        'SCE(LT.BARCODE, '#39#39#39#39')) <> '#39#39#39#39
      '1103570=               AND LT.g_product = P.g_product'
      '1103571=           )'
      '1103572=      INTO :G_PRODUCT_,'
      '1103573=           :PRICE_OUR_;'
      '1103574='
      '1103575=    IF (G_PRODUCT_ IS NULL) then BEGIN'
      '1103576=      ERR_CODE = -20500;'
      
        '1103577=      ERR_MSG = '#39#39#1058#1086#1074#1072#1088#1072' '#1085#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'. '#1064#1090#1088#1080#1093#1082#1086#1076' '#39#39'|' +
        '|BARCODE_||'#39#39', '#1072#1088#1090#1080#1082#1091#1083' '#39#39'||ARTICUL_;'
      '1103578=      Exit;'
      '1103579=    END'
      '1103580='
      '1103581=    PNT_ = '#39#39'03'#39#39';'
      
        '1103582=    DISCOUNT_PERC_ = COALESCE(:DISCOUNT_, 0) * 100 / PRI' +
        'CE_;'
      
        '1103583=    EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT_, :' +
        'G_TOCHKA_, 1)'
      '1103584=      RETURNING_VALUES :COST_PRICE_;'
      '1103585='
      '1103586=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' 0, '#1058#1054' '#1041#1059#1044#1059' '#1048#1047' '#1057#1055#1056#1040#1042#1054#1063#1053#1048#1050#1040' '#1062#1045#1053#1059' '#1041#1056#1040#1058#1068
      '1103587=    IF (price_ IS NULL) THEN'
      '1103588=      PRICE_ = PRICE_OUR_;'
      '1103589='
      '1103590=    PNT_ = '#39#39'04'#39#39';'
      
        '1103591=    EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(  :G_PRODUCT' +
        '_,'
      '1103592=                                              :AMOUNT_,'
      '1103593=                                              :PRICE_,'
      
        '1103594=                                              :AMOUNT_ *' +
        ' (:PRICE_ - COALESCE(:DISCOUNT_, 0)),'
      
        '1103595=                                              :DISCOUNT_' +
        'PERC_,'
      
        '1103596=                                              :DISCOUNT_' +
        ','
      
        '1103597=                                              :AMOUNT_ *' +
        ' :DISCOUNT_,'
      '1103598=                                              :NDS_,'
      
        '1103599=                                              SUMM_ * ND' +
        'S_ / (100 + NDS_),'
      
        '11035100=                                              :COST_PRI' +
        'CE_,'
      
        '11035101=                                              :ALLOW_SE' +
        'LL_ABSENT_GOODS_,'
      
        '11035102=                                              0,     --' +
        'IS_SPISANIE_'
      
        '11035103=                                              1,     --' +
        ' NEW_LINE_SALE_'
      
        '11035104=                                              0     --M' +
        'ODE_'
      
        '11035105=                                              ) RETURNI' +
        'NG_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '11035106=    IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11035107=      ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1079#1072#1087#1080#1089#1080' '#1076#1077#1090#1072#1083#1077#1081'. ERR_CODE ' +
        '= '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39',' +
        ' ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11035108=      EXIT;'
      '11035109=    END'
      '11035110='
      '11035111=    G_PRODUCT_ = NULL;'
      '11035112=  END'
      '11035113='
      '11035114=  PNT_ = '#39#39'05'#39#39';'
      '11035115=  IF (summ_ is null OR SUMM_FACT_ is null) THEN BEGIN'
      '11035116=    SELECT SUM(T.summ)'
      '11035117=      FROM ZAKAZ_DETAILS_TMP T'
      '11035118=      INTO :SUMM_;'
      '11035119=    SUMM_FACT_ = SUMM_;'
      '11035120=  END'
      '11035121='
      '11035122=  G_PAYMENT_TYPE_ = COALESCE(G_PAYMENT_TYPE_, 1);'
      '11035123=  if (G_PAYMENT_TYPE_ = 1) then'
      '11035124=    SUMM_CASH_ = summ_fact_;'
      '11035125=  ELSE'
      '11035126=    SUMM_NONCASH_ = summ_fact_;'
      '11035127='
      '11035128=  PNT_ = '#39#39'06'#39#39';'
      '11035129=  IF (COALESCE(G_CLIENT_, 0) = 0) THEN'
      '11035130=    G_CLIENT_ = 10;'
      '11035131='
      '11035132=  EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '11035133=                              :Z_DATE_,'
      '11035134=                              :Z_TIME_,'
      '11035135=                              :G_CLIENT_,'
      '11035136=                              :G_PAYMENT_TYPE_,'
      '11035137=                              '#39#39#39#39', --:OSNOVANIE_,'
      '11035138=                              0,  -- IS_SPISANIE'
      
        '11035139=                              '#39#39#1047#1072#1082#1072#1079' '#1089' '#1089#1072#1081#1090#1072'. '#39#39'||:NOT' +
        'E_,'
      '11035140=                              :SUMM_,'
      '11035141=                              :SUMM_FACT_,'
      '11035142=                              :SUMM_CASH_,'
      '11035143=                              :SUMM_NONCASH_,'
      
        '11035144=                              0,    --:SUMM_PAY_BONUS__' +
        ','
      
        '11035145=                              0,    --:SUMM_BONUS_GOT__' +
        ','
      
        '11035146=                              NULL,        --:G_PRIHOD_' +
        ','
      
        '11035147=                              NULL,        --:SUMM_PRIH' +
        'OD_'
      '11035148=                              0,    -- :BY_RECIPE__,'
      '11035149=                              0,    -- IS_RESERVE__'
      '11035150=                              NULL -- :PAYMENTS__'
      '11035151=                              )'
      
        '11035152=                              RETURNING_VALUES :ZAKAZ_,' +
        ' :ERR_CODE, :ERR_MSG;'
      '11035153=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '11035154=    ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1074#1089#1090#1072#1074#1082#1077' '#1087#1088#1086#1076#1072#1078#1080'. ERR_CODE =' +
        ' '#39#39'||ERR_CODE||'#39#39'. '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ' +
        'ERR_MSG) + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '11035155=    EXIT;'
      '11035156=  END'
      '11035157='
      '11035158=  DELETE FROM import_tbl_tmp;'
      '11035159='
      '11035160=WHEN ANY DO BEGIN'
      '11035161=    ERR_CODE = gdscode;'
      
        '11035162=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||gds' +
        'code;'
      '11035163=  END'
      '11035164=end'
      '11035165='#39';'
      '11035166=END  --END_EXECUTE_BLOCK'
      '110360=EXECUTE BLOCK AS BEGIN'
      '110361=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '110362=RETURNS ('
      '110363=  SKLAD /* TYPE OF COLUMN SKLAD_TMP.SKLAD */ INTEGER,'
      
        '110364=  G_PRODUCT /* TYPE OF COLUMN SKLAD_TMP.G_PRODUCT */ INTE' +
        'GER,'
      
        '110365=  AMOUNT /* TYPE OF COLUMN SKLAD_TMP.AMOUNT */ NUMERIC(15' +
        ',2),'
      
        '110366=  PRICE /* TYPE OF COLUMN SKLAD_TMP.PRICE */ NUMERIC(15,2' +
        '),'
      '110367=  SUMM /* TYPE OF COLUMN SKLAD_TMP.SUMM */ NUMERIC(15,2),'
      
        '110368=  PRICE_CURRENCY /* TYPE OF COLUMN SKLAD.PRICE_CURRENCY *' +
        '/ NUMERIC(15,2),'
      
        '110369=  SUMM_CURRENCY /* TYPE OF COLUMN SKLAD.SUMM_CURRENCY */ ' +
        'NUMERIC(15,2),'
      '1103610=  NDS /* TYPE OF COLUMN SKLAD_TMP.NDS */ NUMERIC(15,2),'
      
        '1103611=  NDS_SUMM /* TYPE OF COLUMN SKLAD_TMP.NDS_SUMM */ NUMER' +
        'IC(15,2),'
      '1103612=  NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHAR(250),'
      
        '1103613=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '1103614=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30),'
      
        '1103615=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NUM' +
        'ERIC(15,2))'
      '1103616=AS'
      '1103617=BEGIN'
      '1103618=  SUSPEND;'
      '1103619=END'
      '1103620='#39';'
      '1103621='
      
        '1103622=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_DETAILS_LI' +
        'ST_TMP'
      '1103623=RETURNS ('
      
        '1103624=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS */ INTEGER,'
      
        '1103625=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ INT' +
        'EGER,'
      
        '1103626=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUC' +
        'T */ INTEGER,'
      
        '1103627=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ N' +
        'UMERIC(15,2),'
      
        '1103628=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NUM' +
        'ERIC(15,2),'
      
        '1103629=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUMER' +
        'IC(15,2),'
      
        '1103630=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC */ NUMERIC(15,2),'
      
        '1103631=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_SUMM */ NUMERIC(15,2),'
      
        '1103632=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMERIC' +
        '(15,2),'
      
        '1103633=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM ' +
        '*/ NUMERIC(15,2),'
      
        '1103634=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCH' +
        'AR(250),'
      
        '1103635=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHAR' +
        '(30),'
      
        '1103636=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHAR' +
        '(30))'
      '1103637=AS'
      '1103638=BEGIN'
      '1103639=  SUSPEND;'
      '1103640=END'
      '1103641='#39';'
      '1103642='
      '1103643='
      '1103644=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_LIST('
      '1103645=  DATE_BEGIN_ DATE,'
      '1103646=  DATE_END_ DATE,'
      '1103647=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1103648=  IS_VOZVRAT_ INTEGER)'
      '1103649=RETURNS ('
      '1103650=  SKLAD TYPE OF COLUMN SKLAD.SKLAD,'
      '1103651=  SKLAD_PARENT TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1103652=  DATE_RECEIPT TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      '1103653=  G_PRODUCT TYPE OF COLUMN SKLAD.G_PRODUCT,'
      '1103654=  AMOUNT TYPE OF COLUMN SKLAD.AMOUNT,'
      '1103655=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '1103656=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '1103657=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '1103658=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '1103659=  NDS TYPE OF COLUMN SKLAD.NDS,'
      '1103660=  NDS_SUMM TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '1103661=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      
        '1103662=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_N' +
        'UM,'
      '1103663=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '1103664=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1103665=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '1103666=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1103667=  IS_VOZVRAT TYPE OF COLUMN SKLAD.IS_VOZVRAT)'
      '1103668=AS'
      '1103669=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1103670=BEGIN'
      '1103671='
      '1103672=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1103673=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1103674=      IF (sklad_parent_ is null) THEN begin'
      '1103675=        SELECT COUNT(*)'
      '1103676=          FROM SKLAD_PARENT T'
      
        '1103677=         WHERE T.date_receipt BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '1103678=          AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      '1103679=          AND T.IS_vozvrat <> 3'
      '1103680=          INTO CNT_;'
      '1103681='
      '1103682=        if (CNT_ = 0) then'
      '1103683=          SELECT MAX(T.date_receipt)'
      '1103684=            FROM SKLAD_PARENT T'
      '1103685=           WHERE T.date_receipt < :DATE_BEGIN_'
      '1103686=             AND T.IS_vozvrat <> 3'
      
        '1103687=             AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '1103688=            INTO :DATE_BEGIN_;'
      '1103689=      end'
      '1103690='
      '1103691=      FOR SELECT T.sklad sklad_detail,'
      '1103692=               T.SKLAD_PARENT sklad,'
      '1103693=               T.date_receipt,'
      '1103694=               T.g_product,'
      '1103695=               T.amount,'
      '1103696=               T.PRICE,'
      '1103697=               T.SUMM,'
      '1103698=               T.PRICE_CURRENCY,'
      '1103699=               T.SUMM_CURRENCY,'
      '11036100=               T.nds,'
      '11036101=               T.nds_summ,'
      '11036102=               P.NAME PRODUCT_NAME,'
      '11036103=               C.NAME CLIENT_NAME,'
      '11036104=               PT.NAME PAYMENT_NAME,'
      '11036105=               P.ARTICUL,'
      '11036106=               P.NOMENCLATUR_NUM,'
      '11036107=               P.BARCODE,'
      '11036108=               T.IS_VOZVRAT'
      '11036109=          FROM SKLAD T'
      
        '11036110=               LEFT OUTER JOIN G_CLIENT C ON T.G_CLIENT' +
        ' = C.G_CLIENT'
      
        '11036111=               LEFT OUTER JOIN G_PAYMENT_TYPE PT ON T.G' +
        '_PAYMENT_TYPE = PT.G_PAYMENT_TYPE,'
      '11036112=               G_PRODUCT P'
      
        '11036113=         WHERE T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS ' +
        'WHERE CUR_PARAMS = 2)'
      '11036114=           AND T.G_PRODUCT = P.G_PRODUCT'
      
        '11036115=           AND ((T.IS_VOZVRAT = 0 AND :IS_VOZVRAT_ IS N' +
        'ULL)'
      
        '11036116=                OR (T.IS_VOZVRAT IN (0, 5) AND :IS_VOZV' +
        'RAT_ = 0)'
      
        '11036117=                OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVR' +
        'AT_ IN (1,2))'
      '11036118=               )'
      '11036119=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '11036120=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND :S' +
        'KLAD_PARENT_ IS NOT NULL)'
      '11036121=                OR'
      
        '11036122=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '11036123=               )'
      '11036124=        ORDER BY T.DATE_RECEIPT DESC'
      '11036125=      INTO :sklad,'
      '11036126=        :SKLAD_PARENT,'
      '11036127=        :date_receipt,'
      '11036128=        :g_product,'
      '11036129=        :amount,'
      '11036130=        :PRICE,'
      '11036131=        :SUMM,'
      '11036132=        :PRICE_CURRENCY,'
      '11036133=        :SUMM_CURRENCY,'
      '11036134=        :nds,'
      '11036135=        :nds_summ,'
      '11036136=        :PRODUCT_NAME,'
      '11036137=        :CLIENT_NAME,'
      '11036138=        :PAYMENT_NAME,'
      '11036139=        :ARTICUL,'
      '11036140=        :NOMENCLATUR_NUM,'
      '11036141=        :BARCODE,'
      '11036142=        :IS_VOZVRAT'
      '11036143=      DO'
      '11036144=        suspend;'
      '11036145='
      '11036146=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040
      '11036147=  END ELSE BEGIN'
      '11036148=    FOR SELECT T.SKLAD_PARENT,'
      '11036149=               T.SKLAD,'
      '11036150=               TR.DATE_RECEIPT,'
      '11036151=               T.g_product,'
      '11036152=               T.amount,'
      '11036153=               T.PRICE,'
      '11036154=               T.SUMM,'
      '11036155=               P.NAME PRODUCT_NAME,'
      '11036156=               G.NAME CLIENT_NAME,'
      '11036157=               P.ARTICUL,'
      '11036158=               P.NOMENCLATUR_NUM,'
      '11036159=               P.BARCODE'
      
        '11036160=          FROM SKLAD_PARENT TR LEFT OUTER JOIN G_TOCHKA' +
        ' G ON TR.G_CLIENT = G.G_TOCHKA,'
      '11036161=               SKLAD T,'
      '11036162=               G_PRODUCT P'
      
        '11036163=         WHERE TR.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '11036164=           AND TR.SKLAD = T.SKLAD_PARENT'
      '11036165=           AND T.G_PRODUCT = P.G_PRODUCT'
      '11036166=           AND T.IS_VOZVRAT = 3'
      '11036167=           --'#1044#1051#1071' '#1042#1050#1051#1040#1044#1050#1048' "'#1055#1056#1048#1061#1054#1044' '#1055#1054' '#1058#1054#1042#1040#1056#1040#1052'"'
      
        '11036168=           AND ((T.SKLAD_PARENT = :SKLAD_PARENT_ AND :S' +
        'KLAD_PARENT_ IS NOT NULL)'
      '11036169=                OR'
      
        '11036170=                (T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_ AND :SKLAD_PARENT_ IS NULL)'
      '11036171=               )'
      '11036172=        ORDER BY TR.SKLAD DESC'
      '11036173=      INTO :sklad,'
      '11036174=        :SKLAD_PARENT,'
      '11036175=        :date_receipt,'
      '11036176=        :g_product,'
      '11036177=        :amount,'
      '11036178=        :PRICE,'
      '11036179=        :SUMM,'
      '11036180=        :PRODUCT_NAME,'
      '11036181=        :CLIENT_NAME,'
      '11036182=        :ARTICUL,'
      '11036183=        :NOMENCLATUR_NUM,'
      '11036184=        :BARCODE'
      '11036185=      DO'
      '11036186=        suspend;'
      '11036187=  END'
      '11036188=end'
      '11036189='#39';'
      '11036190='
      '11036191=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_SKLAD_LIST_TMP'
      '11036192=RETURNS ('
      '11036193=  SKLAD TYPE OF COLUMN SKLAD_TMP.SKLAD,'
      '11036194=  G_PRODUCT TYPE OF COLUMN SKLAD_TMP.G_PRODUCT,'
      '11036195=  AMOUNT TYPE OF COLUMN SKLAD_TMP.AMOUNT,'
      '11036196=  PRICE TYPE OF COLUMN SKLAD_TMP.PRICE,'
      '11036197=  SUMM TYPE OF COLUMN SKLAD_TMP.SUMM,'
      '11036198=  PRICE_CURRENCY TYPE OF COLUMN SKLAD.PRICE_CURRENCY,'
      '11036199=  SUMM_CURRENCY TYPE OF COLUMN SKLAD.SUMM_CURRENCY,'
      '11036200=  NDS TYPE OF COLUMN SKLAD_TMP.NDS,'
      '11036201=  NDS_SUMM TYPE OF COLUMN SKLAD_TMP.NDS_SUMM,'
      '11036202=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11036203=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11036204=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11036205=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE)'
      '11036206=AS'
      '11036207=begin'
      '11036208=  FOR'
      
        '11036209=    SELECT T.SKLAD, T.G_PRODUCT, T.AMOUNT, T.PRICE, T.S' +
        'UMM, T.NDS, T.NDS_SUMM, P.NAME, P.BARCODE, P.PRICE, P.ARTICUL'
      '11036210=           ,PRICE_CURRENCY'
      '11036211=           ,SUMM_CURRENCY'
      '11036212=    FROM SKLAD_TMP T,'
      '11036213=         G_PRODUCT P'
      '11036214=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11036215=    ORDER BY T.sklad'
      
        '11036216=    INTO :SKLAD, :G_PRODUCT, :AMOUNT, :PRICE, :SUMM, :N' +
        'DS, :NDS_SUMM, :NAME, :BARCODE, :PRODUCT_PRICE, :ARTICUL'
      '11036217=      ,:PRICE_CURRENCY'
      '11036218=      ,:SUMM_CURRENCY'
      '11036219=  DO'
      '11036220=    suspend;'
      '11036221=end'
      '11036222='#39';'
      '11036223='
      
        '11036224=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_DETAILS_L' +
        'IST_TMP'
      '11036225=RETURNS ('
      
        '11036226=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ_' +
        'DETAILS,'
      '11036227=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      '11036228=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT,'
      '11036229=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '11036230=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '11036231=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '11036232=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_PERC,'
      
        '11036233=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCOU' +
        'NT_SUMM,'
      '11036234=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '11036235=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '11036236=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11036237=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11036238=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL)'
      '11036239=AS'
      '11036240=begin'
      '11036241='
      '11036242=  FOR'
      '11036243=    SELECT T.ZAKAZ_DETAILS,'
      '11036244=           T.ZAKAZ,'
      '11036245=           T.G_PRODUCT,'
      '11036246=           T.AMOUNT,'
      '11036247=           T.PRICE,'
      '11036248=           T.SUMM,'
      '11036249=           T.DISCOUNT_PERC,'
      '11036250=           T.DISCOUNT_SUMM,'
      '11036251=           T.NDS,'
      '11036252=           T.NDS_SUMM,'
      '11036253=           P.NAME PRODUCT_NAME'
      '11036254=           ,P.BARCODE'
      '11036255=           ,P.ARTICUL'
      '11036256=      FROM ZAKAZ_DETAILS_TMP T,'
      '11036257=           G_PRODUCT P'
      '11036258=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '11036259=    ORDER BY t.ZAKAZ_DETAILS'
      '11036260=    INTO :ZAKAZ_DETAILS,'
      '11036261=          :ZAKAZ,'
      '11036262=          :G_PRODUCT,'
      '11036263=          :AMOUNT,'
      '11036264=          :PRICE,'
      '11036265=          :SUMM,'
      '11036266=          :DISCOUNT_PERC,'
      '11036267=          :DISCOUNT_SUMM,'
      '11036268=          :NDS,'
      '11036269=          :NDS_SUMM,'
      '11036270=          :PRODUCT_NAME'
      '11036271=          ,:BARCODE'
      '11036272=          ,:ARTICUL'
      '11036273=  DO'
      '11036274=    suspend;'
      '11036275=end'
      '11036276='#39';'
      '11036277=END  --END_EXECUTE_BLOCK'
      '110370=EXECUTE BLOCK AS BEGIN'
      '110371=EXECUTE STATEMENT '#39'ALTER PROCEDURE INV_GET_INVOICE('
      '110372=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '110373=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ)'
      '110374=RETURNS ('
      '110375=  NUM_ TYPE OF COLUMN INVOICE.NUM,'
      '110376=  INIT_DATE_ TYPE OF COLUMN INVOICE.INIT_DATE,'
      '110377=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '110378=  POSTAVSHIK_ TYPE OF COLUMN INVOICE.POSTAVSHIK,'
      '110379=  IDN_ TYPE OF COLUMN INVOICE.IDN,'
      '1103710=  ADDRESS_ TYPE OF COLUMN INVOICE.ADDRESS,'
      '1103711=  IIK_ TYPE OF COLUMN INVOICE.IIK,'
      '1103712=  AGREEMENT_ TYPE OF COLUMN INVOICE.AGREEMENT,'
      '1103713=  G_PAYMENT_TYPE_ TYPE OF COLUMN INVOICE.G_PAYMENT_TYPE,'
      
        '1103714=  PUNKT_NAZNACHENIYA_ TYPE OF COLUMN INVOICE.PUNKT_NAZNA' +
        'CHENIYA,'
      '1103715=  DOVERENNOST_ TYPE OF COLUMN INVOICE.DOVERENNOST,'
      
        '1103716=  SPOSOB_OTPRAVKI_ TYPE OF COLUMN INVOICE.SPOSOB_OTPRAVK' +
        'I,'
      '1103717=  NAKLADNAYA_ TYPE OF COLUMN INVOICE.NAKLADNAYA,'
      
        '1103718=  GRUZOOTPRAVITEL_ TYPE OF COLUMN INVOICE.GRUZOOTPRAVITE' +
        'L,'
      
        '1103719=  GRUZOPOLUCHATEL_ TYPE OF COLUMN INVOICE.GRUZOPOLUCHATE' +
        'L,'
      
        '1103720=  ADDRESS_POLUCHATELYA_ TYPE OF COLUMN INVOICE.ADDRESS_P' +
        'OLUCHATELYA,'
      '1103721=  G_CLIENT_ TYPE OF COLUMN INVOICE.G_CLIENT,'
      '1103722=  CLIENT_NAME_ TYPE OF COLUMN INVOICE.CLIENT_NAME,'
      '1103723=  IDN_CLIENT_ TYPE OF COLUMN INVOICE.IDN_CLIENT,'
      
        '1103724=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE.ADDRESS_POKU' +
        'PATEL,'
      '1103725=  IIK_CLIENT_ TYPE OF COLUMN INVOICE.IIK_CLIENT,'
      
        '1103726=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN INVOICE.G_OFFICIAL_' +
        'RUKOVOD,'
      '1103727=  G_OFFICIAL_GB_ TYPE OF COLUMN INVOICE.G_OFFICIAL_GB,'
      '1103728=  G_OFFICIAL_ TYPE OF COLUMN INVOICE.G_OFFICIAL,'
      '1103729=  ZAKAZ_SAVED_ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1103730=  ERR_CODE INTEGER,'
      '1103731=  ERR_MSG VARCHAR(1024))'
      '1103732=AS'
      
        '1103733=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INV_GET_INVOI' +
        'CE'#39#39';'
      '1103734=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1103735=BEGIN'
      '1103736=  SELECT'
      '1103737=    t.NUM,'
      '1103738=    t.INIT_DATE,'
      '1103739=    T.G_FIRM,'
      '1103740=    t.POSTAVSHIK,'
      '1103741=    t.IDN,'
      '1103742=    t.ADDRESS,'
      '1103743=    t.IIK,'
      '1103744=    t.AGREEMENT,'
      '1103745=    t.G_PAYMENT_TYPE,'
      '1103746=    t.PUNKT_NAZNACHENIYA,'
      '1103747=    t.DOVERENNOST,'
      '1103748=    t.SPOSOB_OTPRAVKI,'
      '1103749=    t.NAKLADNAYA,'
      '1103750=    t.GRUZOOTPRAVITEL,'
      '1103751=    t.GRUZOPOLUCHATEL,'
      '1103752=    t.ADDRESS_POLUCHATELYA,'
      '1103753=    t.G_CLIENT,'
      '1103754=    T.CLIENT_NAME,'
      '1103755=    t.IDN_CLIENT,'
      '1103756=    t.ADDRESS_POKUPATEL,'
      '1103757=    t.IIK_CLIENT,'
      '1103758=    t.G_OFFICIAL_RUKOVOD,'
      '1103759=    t.G_OFFICIAL_GB,'
      '1103760=    t.G_OFFICIAL,'
      '1103761=    t.ZAKAZ'
      '1103762=  FROM invoice t'
      '1103763=  WHERE'
      '1103764=    t.invoice = :invoice_'
      '1103765=  INTO'
      '1103766=    :NUM_,'
      '1103767=    :INIT_DATE_,'
      '1103768=    :G_FIRM_,'
      '1103769=    :POSTAVSHIK_,'
      '1103770=    :IDN_,'
      '1103771=    :ADDRESS_,'
      '1103772=    :IIK_,'
      '1103773=    :AGREEMENT_,'
      '1103774=    :G_PAYMENT_TYPE_,'
      '1103775=    :PUNKT_NAZNACHENIYA_,'
      '1103776=    :DOVERENNOST_,'
      '1103777=    :SPOSOB_OTPRAVKI_,'
      '1103778=    :NAKLADNAYA_,'
      '1103779=    :GRUZOOTPRAVITEL_,'
      '1103780=    :GRUZOPOLUCHATEL_,'
      '1103781=    :ADDRESS_POLUCHATELYA_,'
      '1103782=    :G_CLIENT_,'
      '1103783=    :CLIENT_NAME_,'
      '1103784=    :IDN_CLIENT_,'
      '1103785=    :ADDRESS_POKUPATEL_,'
      '1103786=    :IIK_CLIENT_,'
      '1103787=    :G_OFFICIAL_RUKOVOD_,'
      '1103788=    :G_OFFICIAL_GB_,'
      '1103789=    :G_OFFICIAL_,'
      '1103790=    :ZAKAZ_SAVED_;'
      '1103791='
      '1103792=  IF (ROW_COUNT = 0) then BEGIN'
      '1103793=    --**************************************************'
      
        '1103794=    -- '#1047#1053#1040#1063#1048#1058' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1040' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056 +
        #1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1103795=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1103796=    SELECT'
      '1103797=      G.g_firm_rekvizIT,'
      
        '1103798=      G.NAME, --DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1085#1076#1080#1074#1080#1076#1091#1072#1083#1100#1085#1099#1081' ' +
        #1087#1088#1077#1076#1087#1088#1080#1085#1080#1084#1072#1090#1077#1083#1100' '#39#39', '#39#39#1058#1054#1054' '#39#39')||G.NAME,'
      '1103799=      G.IDN,'
      '11037100=      AD.G_ADDRESS,'
      '11037101=      AC.G_ACCOUNT,'
      
        '11037102=      DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, '#39#39#1041#1048#1053#39#39')||'#39#39': ' +
        #39#39'||G.IDN||'#39#39', '#39#39'||G.NAME||'#39#39', '#39#39'||AD.ADDRESS'
      '11037103=    FROM G_FIRM_REKVIZIT g'
      '11037104=           LEFT OUTER JOIN (SELECT *'
      '11037105=                              FROM G_FIRM_ADDRESS F'
      
        '11037106=                             WHERE F.IS_DEFAULT = 1) AD' +
        ' ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT'
      '11037107=           LEFT OUTER JOIN (SELECT A.G_ACCOUNT,'
      '11037108=                                   A.ACCOUNT,'
      '11037109=                                   A.G_FIRM_REKVIZIT,'
      '11037110=                                   A.G_BANK,'
      '11037111=                                   B.BIK, B.NAME'
      '11037112=                              FROM G_FIRM_ACCOUNT A,'
      '11037113=                                   G_BANK B'
      '11037114=                             WHERE A.G_BANK = B.G_BANK'
      
        '11037115=                               AND A.IS_DEFAULT = 1) AC' +
        ' ON G.G_FIRM_REKVIZIT = AC.G_FIRM_REKVIZIT'
      '11037116=    WHERE G.IS_DEFAULT = 1'
      '11037117=    INTO'
      '11037118=      :g_firm_,'
      '11037119=      :POSTAVSHIK_,'
      '11037120=      :IDN_,'
      '11037121=      :ADDRESS_,'
      '11037122=      :IIK_,'
      '11037123=      :GRUZOOTPRAVITEL_;'
      '11037124='
      '11037125=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '11037126=    SELECT'
      '11037127=      Z.Z_DATE,'
      '11037128=      C.G_CLIENT,'
      
        '11037129=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39#39#39')), ' +
        '0, C.NAME, c.name_FULL),'
      '11037130=      C.IDN,'
      '11037131=      AD.G_ADDRESS,'
      
        '11037132=      DECODE(CHAR_LENGTH(COALESCE(Z.OSNOVANIE, '#39#39#39#39')), ' +
        '0, '#39#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39#39', Z.OSNOVANIE),'
      '11037133=      Z.G_PAYMENT_TYPE,'
      '11037134=      AD.ADDRESS,'
      '11037135=      AD.ADDRESS,'
      '11037136=      '#39#39#1041#1077#1079' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080#39#39','
      '11037137=      '#39#39#1057#1072#1084#1086#1074#1099#1074#1086#1079#39#39','
      
        '11037138=      DECODE(CHAR_LENGTH(TRIM(C.IDN)), 0, '#39#39#39#39', '#39#39#1048#1048#1053'/'#1041 +
        #1048#1053': '#39#39'||TRIM(C.IDN)||'#39#39', '#39#39', '#39#39#39#39')||DECODE(CHAR_LENGTH(TRIM(COAL' +
        'ESCE(C.NAME_FULL, '#39#39#39#39'))), 0, C.NAME, TRIM(C.NAME_FULL))||COALES' +
        'CE('#39#39', '#39#39'||AD.ADDRESS, '#39#39#39#39'),'
      '11037139=      COALESCE(AC.G_ACCOUNT, null)'
      '11037140=    FROM ZAKAZ Z LEFT OUTER JOIN (SELECT *'
      '11037141=                                    FROM G_ADDRESS G'
      
        '11037142=                                   WHERE G.IS_DEFAULT =' +
        ' 1) AD ON Z.G_CLIENT = AD.G_CLIENT'
      '11037143=                 LEFT OUTER JOIN (SELECT *'
      '11037144=                                    FROM G_ACCOUNT G'
      
        '11037145=                                   WHERE G.IS_DEFAULT =' +
        ' 1) AC ON Z.G_CLIENT = AC.G_CLIENT,'
      '11037146=         G_CLIENT C'
      '11037147=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '11037148=      AND Z.G_CLIENT = C.G_CLIENT'
      '11037149=    INTO'
      '11037150=      :INIT_DATE_,'
      '11037151=      :G_CLIENT_,'
      '11037152=      :CLIENT_NAME_,'
      '11037153=      :IDN_CLIENT_,'
      '11037154=      :ADDRESS_POKUPATEL_,'
      '11037155=      :AGREEMENT_,'
      '11037156=      :G_PAYMENT_TYPE_,'
      '11037157=      :PUNKT_NAZNACHENIYA_,'
      '11037158=      :ADDRESS_POLUCHATELYA_,'
      '11037159=      :DOVERENNOST_,'
      '11037160=      :SPOSOB_OTPRAVKI_,'
      '11037161=      :GRUZOPOLUCHATEL_,'
      '11037162=      :IIK_CLIENT_;'
      '11037163='
      
        '11037164=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054#1041 +
        #1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '11037165=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054' '#1056 +
        #1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '11037166=    PNT_ = '#39#39'05'#39#39';'
      '11037167=    SELECT C.id'
      '11037168=      FROM cur_params C'
      '11037169=     WHERE C.cur_params = 1'
      '11037170=    INTO :G_OFFICIAL_;'
      '11037171='
      '11037172=    IF (ROW_COUNT = 0) then BEGIN'
      '11037173=        SELECT MIN(O.G_OFFICIAL)'
      '11037174=          FROM G_OFFICIAL O'
      '11037175=          INTO :G_OFFICIAL_;'
      '11037176=        IF (ROW_COUNT = 0) then BEGIN'
      '11037177=            Err_Code = -20500;'
      
        '11037178=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1057 +
        #1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '11037179=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11037180=            EXIT;'
      '11037181=        END'
      '11037182=    END'
      '11037183='
      '11037184=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '11037185=    SELECT O.G_OFFICIAL'
      '11037186=    FROM G_OFFICIAL O'
      '11037187=    WHERE O.IS_RUKOVODITEL = 1'
      '11037188=    INTO :G_OFFICIAL_RUKOVOD_;'
      '11037189='
      '11037190=    --'#1048#1065#1059' '#1043#1051#1040#1042#1041#1059#1061#1040
      '11037191=    SELECT O.G_OFFICIAL'
      '11037192=    FROM G_OFFICIAL O'
      '11037193=    WHERE O.IS_GLAVBUH = 1'
      '11037194=    INTO :G_OFFICIAL_GB_;'
      '11037195='
      
        '11037196=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059', '#1057#1053#1040#1063#1040#1051#1040' '#1057 +
        #1044#1045#1051#1040#1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '11037197=    --select substring('#39#39'0000000000'#39#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '11037198=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VARC' +
        'HAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '11037199=      FROM INVOICE P'
      '11037200=    INTO :NUM_;'
      '11037201='
      
        '11037202=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059' '#1042 +
        #1054#1054#1041#1065#1045' '#1053#1045#1058
      '11037203=      NUM_ = '#39#39'1'#39#39';'
      '11037204=  END'
      '11037205=END'
      '11037206='#39';'
      '11037207='
      '11037208=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_INVOICE('
      '11037209=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '11037210=  CURRENCY_ INTEGER)'
      '11037211=RETURNS ('
      '11037212=  NUM_ VARCHAR(50),'
      '11037213=  POSTAVSHIK_NAME_ VARCHAR(1000),'
      '11037214=  POSTAVSHIK_IDN_ADDRESS_ VARCHAR(1000),'
      '11037215=  ACCOUNT_ VARCHAR(500),'
      '11037216=  AGREEMENT_ VARCHAR(500),'
      '11037217=  G_PAYMENT_TYPE_ VARCHAR(1000),'
      '11037218=  PUNKT_ VARCHAR(1000),'
      '11037219=  DOVERKA_ VARCHAR(1000),'
      '11037220=  SPOSOB_OTPRAVKI_ VARCHAR(1000),'
      '11037221=  NAKLADNAYA_ VARCHAR(1000),'
      '11037222=  GRUZOOTPRAVITEL_ VARCHAR(1000),'
      '11037223=  GRUZOPOLUCHATEL_ VARCHAR(1000),'
      '11037224=  POLUCHATEL_ VARCHAR(1000),'
      '11037225=  POLUCHATEL_ADDRESS_ VARCHAR(1000),'
      '11037226=  POLUCHATEL_IIK_ VARCHAR(1000),'
      '11037227=  RUKOVODITEL_ VARCHAR(1000),'
      '11037228=  GLAVBUH_ VARCHAR(1000),'
      '11037229=  ISPOLNITEL_APP_ VARCHAR(1000),'
      '11037230=  ISPOLNITEL_ VARCHAR(1000),'
      '11037231=  NUM_W_ VARCHAR(20),'
      '11037232=  DATE_ VARCHAR(20),'
      '11037233=  IDN_KPP_POST_ VARCHAR(30),'
      '11037234=  IDN_KPP_POLUCH_ VARCHAR(30),'
      '11037235=  CURR_STR_ VARCHAR(15),'
      '11037236=  ROW_NUM VARCHAR(10),'
      '11037237=  NAME VARCHAR(1000),'
      '11037238=  SHORT_NAME VARCHAR(1000),'
      '11037239=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11037240=  AMOUNT VARCHAR(500),'
      '11037241=  PRICE VARCHAR(500),'
      '11037242=  WITHOUT_NDS VARCHAR(500),'
      '11037243=  NDS VARCHAR(500),'
      '11037244=  NDS_SUMM VARCHAR(500),'
      '11037245=  SUMM VARCHAR(500),'
      '11037246=  STOIM_TOVAROV_ VARCHAR(500),'
      '11037247=  SUMM_NDS_ VARCHAR(500),'
      '11037248=  SUMM_VSEGO_ VARCHAR(500),'
      '11037249=  ERR_CODE INTEGER,'
      '11037250=  ERR_MSG VARCHAR(1024))'
      '11037251=AS'
      
        '11037252=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_INVOICE' +
        #39#39';'
      '11037253=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11037254=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '11037255=DECLARE VARIABLE BEZ_NDS_ TYPE OF COLUMN G_FIRM_REKVIZI' +
        'T.NOL_VMESTO_BEZ;'
      
        '11037256=DECLARE VARIABLE NDS_VALUE_ TYPE OF COLUMN G_FIRM_REKVI' +
        'ZIT.NDS_VALUE;'
      '11037257=DECLARE VARIABLE I INTEGER = 1;'
      
        '11037258=DECLARE VARIABLE ZSUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM;'
      '11037259=BEGIN'
      '11037260='
      '11037261=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1057#1063#1045#1058#1040
      
        '11037262=  SELECT DECODE(:CURRENCY_, 0, '#39#39#1055#1086#1089#1090#1072#1074#1097#1080#1082': '#39#39', '#39#39#39#39')||' +
        'I.POSTAVSHIK,'
      '11037263=         DECODE(:CURRENCY_,'
      
        '11037264=                0, DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, '#39 +
        #39#1041#1048#1053#39#39')||'#39#39' '#1080' '#1077#1075#1086' '#1072#1076#1088#1077#1089': '#39#39'||DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, ' +
        #39#39#1041#1048#1053#39#39')||'#39#39': '#39#39'||G.IDN||'#39#39', '#39#39','
      
        '11037265=                '#39#39#39#39')||I.POSTAVSHIK||'#39#39', '#39#39'||FD.ADDRESS' +
        '||'
      
        '11037266=                DECODE(G.is_nds, 1, '#39#39'. '#1057#1074#1080#1076#1077#1090#1077#1083#1100#1089#1090#1074#1086' '#1086 +
        ' '#1087#1086#1089#1090#1072#1085#1086#1074#1082#1077' '#1085#1072' '#1088#1077#1075#1080#1089#1090#1088#1072#1094#1080#1086#1085#1085#1099#1081' '#1091#1095#1077#1090' '#1087#1086' '#1053#1044#1057': '#1057#1077#1088#1080#1103' '#39#39'||G.nds_seri' +
        'al'
      
        '11037267=                       ||'#39#39', '#8470#39#39'||G.nds_num||'#39#39' '#1086#1090' '#39#39'||' +
        'EXTRACT(DAY from g.nds_date)||'#39#39'.'#39#39'||EXTRACT(MONTH from g.nds_da' +
        'te)||'#39#39'.'#39#39'||EXTRACT(YEAR from g.nds_date), '#39#39#39#39'),'
      
        '11037268=         '#39#39#1048#1048#1050' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1072': '#39#39'||FC.ACCOUNT||'#39#39' '#1074' '#39#39'||FB.' +
        'NAME||'#39#39', '#1041#1048#1050': '#39#39'||FB.BIK,'
      
        '11037269=         '#39#39#1044#1086#1075#1086#1074#1086#1088' ('#1082#1086#1085#1090#1088#1072#1082#1090') '#1085#1072' '#1087#1086#1089#1090#1072#1074#1082#1091' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086 +
        #1090', '#1091#1089#1083#1091#1075'): '#39#39'||COALESCE(TRIM(I.AGREEMENT), '#39#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39#39'),'
      
        '11037270=         '#39#39#1059#1089#1083#1086#1074#1080#1103' '#1086#1087#1083#1072#1090#1099' '#1087#1086' '#1076#1086#1075#1086#1074#1086#1088#1091' ('#1082#1086#1085#1090#1088#1072#1082#1090#1091'): '#39#39'||' +
        'GP.NAME,'
      
        '11037271=         '#39#39#1055#1091#1085#1082#1090' '#1085#1072#1079#1085#1072#1095#1077#1085#1080#1103' '#1087#1086#1089#1090#1072#1074#1083#1103#1077#1084#1099#1093' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086#1090 +
        ', '#1091#1089#1083#1091#1075'): '#39#39'||I.PUNKT_NAZNACHENIYA,'
      
        '11037272=         '#39#39#1055#1086#1089#1090#1072#1074#1082#1072' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072#1073#1086#1090','#1091#1089#1083#1091#1075') '#1086#1089#1091#1097#1077#1089#1090#1074#1083#1077#1085#1072' ' +
        #1087#1086' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080': '#39#39'||I.DOVERENNOST,'
      '11037273=         '#39#39#1057#1087#1086#1089#1086#1073' '#1086#1090#1087#1088#1072#1074#1083#1077#1085#1080#1103': '#39#39'||I.SPOSOB_OTPRAVKI,'
      
        '11037274=         '#39#39#1058#1086#1074#1072#1088#1085#1086'-'#1090#1088#1072#1085#1089#1087#1086#1088#1090#1085#1072#1103' '#1085#1072#1082#1083#1072#1076#1085#1072#1103': '#39#39'||I.NAKLAD' +
        'NAYA,'
      
        '11037275=         DECODE(:CURRENCY_, 0, '#39#39#1043#1088#1091#1079#1086#1086#1090#1087#1088#1072#1074#1080#1090#1077#1083#1100': '#39#39', ' +
        #39#39#39#39')||I.GRUZOOTPRAVITEL,'
      
        '11037276=         DECODE(:CURRENCY_, 0, '#39#39#1043#1088#1091#1079#1086#1087#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39#39', '#39 +
        #39#39#39')||I.GRUZOPOLUCHATEL,'
      
        '11037277=         DECODE(:CURRENCY_, 0, '#39#39#1055#1086#1083#1091#1095#1072#1090#1077#1083#1100': '#39#39', '#39#39#39#39')|' +
        '|I.CLIENT_NAME,'
      '11037278=         DECODE(:CURRENCY_,'
      
        '11037279=                0, '#39#39#1048#1048#1053'/'#1041#1048#1053' '#1080' '#1072#1076#1088#1077#1089' '#1084#1077#1089#1090#1086#1085#1072#1093#1086#1078#1076#1077#1085#1080#1103' '#1087#1086 +
        #1083#1091#1095#1072#1090#1077#1083#1103': '#39#39'||COALESCE(I.IDN_CLIENT, '#39#39#39#39'),'
      
        '11037280=                '#39#39#39#39')||COALESCE('#39#39', '#39#39'||AD.ADDRESS, '#39#39#39 +
        #39'),'
      
        '11037281=         '#39#39#1048#1048#1050' '#1087#1086#1083#1091#1095#1072#1090#1077#1083#1103': '#39#39'||COALESCE(CC.ACCOUNT||'#39#39' ' +
        #1074' '#39#39'||CC.NAME||'#39#39', '#1041#1048#1050': '#39#39'||CC.BIK, '#39#39#39#39'),'
      '11037282=         RO.FIO_DOC,'
      '11037283=         COALESCE(GO.FIO_DOC, '#39#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39#39'),'
      '11037284=         AP.NAME,'
      '11037285=         IO.FIO_DOC,'
      
        '11037286=         '#39#39#1057#1095#1077#1090'-'#1092#1072#1082#1090#1091#1088#1072' '#8470#39#39'||I.NUM||'#39#39' '#1086#1090' '#39#39'||EXTRACT(D' +
        'AY FROM I.INIT_DATE)||'#39#39' '#39#39'||'
      
        '11037287=           (SELECT * FROM GET_RUSSIAN_MONTH(EXTRACT(MON' +
        'TH FROM I.INIT_DATE), 1))||'#39#39' '#39#39'||EXTRACT(YEAR FROM I.INIT_DATE)' +
        '||'#39#39' '#1075'.'#39#39','
      '11037288=         I.ZAKAZ,'
      '11037289=         -- '#1044#1051#1071' '#1056#1054#1057#1057#1048#1049#1057#1050#1054#1049' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1067
      '11037290=         I.NUM,'
      
        '11037291=         EXTRACT(DAY FROM I.INIT_DATE)||'#39#39' '#39#39'||(SELECT ' +
        '* FROM GET_RUSSIAN_MONTH(EXTRACT(MONTH FROM I.INIT_DATE), 1))||'#39 +
        #39' '#39#39'||EXTRACT(YEAR FROM I.INIT_DATE)||'#39#39' '#1075'.'#39#39','
      '11037292=         G.IDN||'#39#39'/'#39#39'||G.KPP,'
      '11037293=         G.nol_vmesto_bez,'
      '11037294=         G.NDS_VALUE,'
      '11037295=         I.IDN_CLIENT,'
      
        '11037296=         DECODE(:CURRENCY_, 1, '#39#39#1056#1091#1073#1083#1100', 643'#39#39', 2, '#39#39#1043#1088#1080 +
        #1074#1085#1072', 980'#39#39')'
      '11037297=    FROM INVOICE I'
      
        '11037298=           LEFT OUTER JOIN G_OFFICIAL RO ON I.G_OFFICIA' +
        'L_RUKOVOD = RO.G_OFFICIAL'
      
        '11037299=           LEFT OUTER JOIN G_OFFICIAL GO ON I.G_OFFICIA' +
        'L_GB = GO.G_OFFICIAL'
      
        '11037300=           LEFT OUTER JOIN G_ADDRESS  AD ON I.ADDRESS_P' +
        'OKUPATEL = AD.G_ADDRESS'
      
        '11037301=           LEFT OUTER JOIN (SELECT GA.g_account, GA.acc' +
        'ount, CB.name, CB.BIK'
      
        '11037302=                            FROM g_account GA, g_bank C' +
        'B WHERE GA.g_bank = CB.g_bank) CC ON I.IIK_CLIENT = CC.G_ACCOUNT' +
        ','
      '11037303=         G_FIRM_REKVIZIT G,'
      '11037304=         G_FIRM_ACCOUNT  FC,'
      '11037305=         G_FIRM_ADDRESS  FD,'
      '11037306=         G_BANK          FB,'
      '11037307=         ---'
      '11037308=         G_PAYMENT_TYPE  GP,'
      '11037309=         G_OFFICIAL      IO,'
      '11037310=         G_APPOINTMENT   AP'
      '11037311=   WHERE I.INVOICE = :INVOICE_'
      
        '11037312=     AND ((I.g_firm = G.g_firm_rekvizit AND I.g_firm IS' +
        ' NOT NULL) OR (G.is_default = 1 AND I.g_firm IS NULL))  -- '#1044#1054' 02' +
        '.2017 '#1053#1045' '#1041#1067#1051#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1061' '#1060#1048#1056#1052', '#1050#1054#1051#1054#1053#1050#1048' I.g_firm '#1053#1045' '#1041#1067#1051#1054
      '11037313=     AND I.ADDRESS = FD.G_ADDRESS'
      '11037314=     AND I.IIK = FC.G_ACCOUNT'
      '11037315=     AND FC.G_BANK = FB.G_BANK'
      '11037316=     AND I.G_PAYMENT_TYPE = GP.G_PAYMENT_TYPE'
      '11037317=     AND I.G_OFFICIAL = IO.G_OFFICIAL'
      '11037318=     AND IO.G_APPOINTMENT = AP.G_APPOINTMENT'
      '11037319=   INTO  :POSTAVSHIK_NAME_,'
      '11037320=         :POSTAVSHIK_IDN_ADDRESS_,'
      '11037321=         :ACCOUNT_,'
      '11037322=         :AGREEMENT_,'
      '11037323=         :G_PAYMENT_TYPE_,'
      '11037324=         :PUNKT_,'
      '11037325=         :DOVERKA_,'
      '11037326=         :SPOSOB_OTPRAVKI_,'
      '11037327=         :NAKLADNAYA_,'
      '11037328=         :GRUZOOTPRAVITEL_,'
      '11037329=         :GRUZOPOLUCHATEL_,'
      '11037330=         :POLUCHATEL_,'
      '11037331=         :POLUCHATEL_ADDRESS_,'
      '11037332=         :POLUCHATEL_IIK_,'
      '11037333=         :RUKOVODITEL_,'
      '11037334=         :GLAVBUH_,'
      '11037335=         :ISPOLNITEL_APP_,'
      '11037336=         :ISPOLNITEL_,'
      '11037337=         :NUM_,'
      '11037338=         :ZAKAZ_,'
      '11037339=         :NUM_W_,'
      '11037340=         :DATE_,'
      '11037341=         :IDN_KPP_POST_,'
      '11037342=         :BEZ_NDS_,'
      '11037343=         :NDS_VALUE_,'
      '11037344=         :IDN_KPP_POLUCH_,'
      '11037345=         :CURR_STR_;'
      '11037346='
      '11037347=  -- '#1057#1055#1048#1057#1054#1050' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1047#1040#1050#1040#1047#1045
      
        '11037348=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1042#1067#1058#1040#1065#1059' '#1057#1059#1052#1052#1067' "'#1057#1090#1086#1080#1084#1086#1089#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' ('#1088#1072 +
        #1073#1086#1090', '#1091#1089#1083#1091#1075') '#1073#1077#1079' '#1053#1044#1057'" '#1048' "'#1053#1044#1057' '#1057#1059#1052#1052#1040'" '#1048' "'#1042#1089#1077#1075#1086' '#1089#1090#1086#1080#1084#1086#1089#1090#1100' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1080 +
        '"'
      
        '11037349=  -- '#1042' '#1045#1050#1057#1045#1051#1045' '#1057#1059#1052#1052#1048#1056#1054#1042#1040#1058#1068' '#1042#1054#1054#1041#1065#1045' '#1053#1045' '#1042#1040#1056#1048#1040#1053#1058', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054 +
        ' '#1063#1048#1057#1051#1040' '#1057#1054#1061#1056#1040#1053#1071#1070#1058#1057#1071' '#1050#1040#1050' '#1058#1045#1050#1057#1058' '#1055#1054#1057#1051#1045' '#1042#1067#1043#1056#1059#1047#1050#1048' '#1048' '#1053#1048#1061#1045#1056#1040' '#1053#1045' '#1057#1063#1048#1058#1040#1045#1058#1057 +
        #1071
      '11037350=  SELECT Z.SUMM'
      '11037351=    FROM ZAKAZ Z'
      '11037352=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '11037353=    INTO :ZSUMM_;'
      '11037354='
      
        '11037355=  STOIM_TOVAROV_ = REPLACE(CAST(ROUND(ZSUMM_/(1 + :NDS_' +
        'VALUE_/100), 2) AS VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39');'
      '11037356=  IF (ZSUMM_ <> 0) then'
      
        '11037357=    SUMM_NDS_    = REPLACE(CAST(CAST(ROUND(ZSUMM_ * NDS' +
        '_VALUE_/(100 + NDS_VALUE_), 2) AS NUMERIC(15,2)) AS VARCHAR(10))' +
        ', '#39#39'.'#39#39', '#39#39','#39#39');'
      '11037358=  ELSE'
      '11037359=    SUMM_NDS_    = '#39#39#39#39';'
      
        '11037360=  SUMM_VSEGO_    = REPLACE(CAST(ZSUMM_ AS VARCHAR(10)),' +
        ' '#39#39'.'#39#39', '#39#39','#39#39');'
      '11037361='
      '11037362=  FOR'
      '11037363=    SELECT :I,'
      '11037364=           G.NAME||DECODE(G.articul,'
      '11037365=                          NULL, '#39#39#39#39','
      '11037366=                          '#39#39#39#39', '#39#39#39#39','
      '11037367=                          '#39#39', '#1072#1088#1090'. '#39#39'||G.articul),'
      '11037368=           U.SHORT_NAME,'
      '11037369=           G.barcode,'
      '11037370=           CAST(ZD.AMOUNT AS VARCHAR(10)),'
      
        '11037371=           REPLACE(CAST(ROUND((ZD.PRICE - COALESCE(ZD.D' +
        'ISCOUNT_TENGE, 0))/(1 + :NDS_VALUE_/100), 2) AS VARCHAR(10)), '#39#39 +
        '.'#39#39', '#39#39','#39#39'),'
      
        '11037372=           REPLACE(CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE_/' +
        '100), 2) AS VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      '11037373=           DECODE(:NDS_VALUE_,'
      
        '11037374=                   0, DECODE(:BEZ_NDS_,     -- '#1045#1057#1051#1048' '#1053#1045' ' +
        #1057#1058#1054#1048#1058' '#1043#1040#1051#1054#1063#1050#1040', '#1058#1054' '#1042#1067#1042#1054#1044#1048#1058#1068' "'#1041#1045#1047' '#1053#1044#1057'" '#1042#1052#1045#1057#1058#1054' "0"'
      '11037375=                             0, '#39#39#1041#1077#1079' '#1053#1044#1057#39#39','
      '11037376=                             '#39#39'0,00'#39#39'),'
      
        '11037377=                   REPLACE(CAST(:NDS_VALUE_ AS VARCHAR(' +
        '10)), '#39#39'.'#39#39', '#39#39','#39#39')),'
      
        '11037378=           REPLACE(CAST(DECODE(ZD.SUMM, 0, NULL, ZD.SUM' +
        'M - CAST(ROUND(ZD.SUMM/(1 + :NDS_VALUE_/100), 2) AS NUMERIC(15,2' +
        '))) AS VARCHAR(10)), '#39#39'.'#39#39', '#39#39','#39#39'),'
      
        '11037379=           REPLACE(CAST(ZD.SUMM AS VARCHAR(10)), '#39#39'.'#39#39',' +
        ' '#39#39','#39#39')'
      '11037380=      FROM ZAKAZ Z,'
      '11037381=           ZAKAZ_DETAILS ZD,'
      '11037382=           G_PRODUCT G,'
      '11037383=           G_UNIT U'
      '11037384=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '11037385=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11037386=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '11037387=       AND G.G_UNIT = U.G_UNIT'
      '11037388=    INTO :ROW_NUM,'
      '11037389=        :NAME,'
      '11037390=        :SHORT_NAME,'
      '11037391=        :BARCODE,'
      '11037392=        :AMOUNT,'
      '11037393=        :PRICE,'
      '11037394=        :WITHOUT_NDS,'
      '11037395=        :NDS,'
      '11037396=        :NDS_SUMM,'
      '11037397=        :SUMM'
      '11037398=  DO BEGIN'
      '11037399=    I = I + 1;'
      '11037400=    SUSPEND;'
      '11037401=  END'
      '11037402='
      '11037403=WHEN ANY DO BEGIN'
      '11037404=    Err_code = -20500;'
      
        '11037405=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1054#1048#1057#1050#1045' '#1042#1061#1054#1044#1071#1065#1045#1043#1054' '#1054#1057#1058#1040#1058#1050#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11037406=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11037407=  END'
      '11037408=end'
      '11037409='#39';'
      '11037410=END  --END_EXECUTE_BLOCK'
      '110380=EXECUTE BLOCK AS BEGIN'
      '110381=EXECUTE STATEMENT '#39'ALTER PROCEDURE INV_GET_INVOICE('
      '110382=  INVOICE_ TYPE OF COLUMN INVOICE.INVOICE,'
      '110383=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ)'
      '110384=RETURNS ('
      '110385=  NUM_ TYPE OF COLUMN INVOICE.NUM,'
      '110386=  INIT_DATE_ TYPE OF COLUMN INVOICE.INIT_DATE,'
      '110387=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '110388=  POSTAVSHIK_ TYPE OF COLUMN INVOICE.POSTAVSHIK,'
      '110389=  IDN_ TYPE OF COLUMN INVOICE.IDN,'
      '1103810=  ADDRESS_ TYPE OF COLUMN INVOICE.ADDRESS,'
      '1103811=  IIK_ TYPE OF COLUMN INVOICE.IIK,'
      '1103812=  AGREEMENT_ TYPE OF COLUMN INVOICE.AGREEMENT,'
      '1103813=  G_PAYMENT_TYPE_ TYPE OF COLUMN INVOICE.G_PAYMENT_TYPE,'
      
        '1103814=  PUNKT_NAZNACHENIYA_ TYPE OF COLUMN INVOICE.PUNKT_NAZNA' +
        'CHENIYA,'
      '1103815=  DOVERENNOST_ TYPE OF COLUMN INVOICE.DOVERENNOST,'
      
        '1103816=  SPOSOB_OTPRAVKI_ TYPE OF COLUMN INVOICE.SPOSOB_OTPRAVK' +
        'I,'
      '1103817=  NAKLADNAYA_ TYPE OF COLUMN INVOICE.NAKLADNAYA,'
      
        '1103818=  GRUZOOTPRAVITEL_ TYPE OF COLUMN INVOICE.GRUZOOTPRAVITE' +
        'L,'
      
        '1103819=  GRUZOPOLUCHATEL_ TYPE OF COLUMN INVOICE.GRUZOPOLUCHATE' +
        'L,'
      
        '1103820=  ADDRESS_POLUCHATELYA_ TYPE OF COLUMN INVOICE.ADDRESS_P' +
        'OLUCHATELYA,'
      '1103821=  G_CLIENT_ TYPE OF COLUMN INVOICE.G_CLIENT,'
      '1103822=  CLIENT_NAME_ TYPE OF COLUMN INVOICE.CLIENT_NAME,'
      '1103823=  IDN_CLIENT_ TYPE OF COLUMN INVOICE.IDN_CLIENT,'
      
        '1103824=  ADDRESS_POKUPATEL_ TYPE OF COLUMN INVOICE.ADDRESS_POKU' +
        'PATEL,'
      '1103825=  IIK_CLIENT_ TYPE OF COLUMN INVOICE.IIK_CLIENT,'
      
        '1103826=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN INVOICE.G_OFFICIAL_' +
        'RUKOVOD,'
      '1103827=  G_OFFICIAL_GB_ TYPE OF COLUMN INVOICE.G_OFFICIAL_GB,'
      '1103828=  G_OFFICIAL_ TYPE OF COLUMN INVOICE.G_OFFICIAL,'
      '1103829=  ZAKAZ_SAVED_ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1103830=  ERR_CODE INTEGER,'
      '1103831=  ERR_MSG VARCHAR(1024))'
      '1103832=AS'
      
        '1103833=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'INV_GET_INVOI' +
        'CE'#39#39';'
      '1103834=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1103835=BEGIN'
      '1103836=  SELECT'
      '1103837=    t.NUM,'
      '1103838=    t.INIT_DATE,'
      '1103839=    T.G_FIRM,'
      '1103840=    t.POSTAVSHIK,'
      '1103841=    t.IDN,'
      '1103842=    t.ADDRESS,'
      '1103843=    t.IIK,'
      '1103844=    t.AGREEMENT,'
      '1103845=    t.G_PAYMENT_TYPE,'
      '1103846=    t.PUNKT_NAZNACHENIYA,'
      '1103847=    t.DOVERENNOST,'
      '1103848=    t.SPOSOB_OTPRAVKI,'
      '1103849=    t.NAKLADNAYA,'
      '1103850=    t.GRUZOOTPRAVITEL,'
      '1103851=    t.GRUZOPOLUCHATEL,'
      '1103852=    t.ADDRESS_POLUCHATELYA,'
      '1103853=    t.G_CLIENT,'
      '1103854=    T.CLIENT_NAME,'
      '1103855=    t.IDN_CLIENT,'
      '1103856=    t.ADDRESS_POKUPATEL,'
      '1103857=    t.IIK_CLIENT,'
      '1103858=    t.G_OFFICIAL_RUKOVOD,'
      '1103859=    t.G_OFFICIAL_GB,'
      '1103860=    t.G_OFFICIAL,'
      '1103861=    t.ZAKAZ'
      '1103862=  FROM invoice t'
      '1103863=  WHERE'
      '1103864=    t.invoice = :invoice_'
      '1103865=  INTO'
      '1103866=    :NUM_,'
      '1103867=    :INIT_DATE_,'
      '1103868=    :G_FIRM_,'
      '1103869=    :POSTAVSHIK_,'
      '1103870=    :IDN_,'
      '1103871=    :ADDRESS_,'
      '1103872=    :IIK_,'
      '1103873=    :AGREEMENT_,'
      '1103874=    :G_PAYMENT_TYPE_,'
      '1103875=    :PUNKT_NAZNACHENIYA_,'
      '1103876=    :DOVERENNOST_,'
      '1103877=    :SPOSOB_OTPRAVKI_,'
      '1103878=    :NAKLADNAYA_,'
      '1103879=    :GRUZOOTPRAVITEL_,'
      '1103880=    :GRUZOPOLUCHATEL_,'
      '1103881=    :ADDRESS_POLUCHATELYA_,'
      '1103882=    :G_CLIENT_,'
      '1103883=    :CLIENT_NAME_,'
      '1103884=    :IDN_CLIENT_,'
      '1103885=    :ADDRESS_POKUPATEL_,'
      '1103886=    :IIK_CLIENT_,'
      '1103887=    :G_OFFICIAL_RUKOVOD_,'
      '1103888=    :G_OFFICIAL_GB_,'
      '1103889=    :G_OFFICIAL_,'
      '1103890=    :ZAKAZ_SAVED_;'
      '1103891='
      '1103892=  IF (ROW_COUNT = 0) then BEGIN'
      '1103893=    --**************************************************'
      
        '1103894=    -- '#1047#1053#1040#1063#1048#1058' '#1057#1063#1045#1058'-'#1060#1040#1050#1058#1059#1056#1040' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056 +
        #1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '1103895=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '1103896=    SELECT'
      '1103897=      G.g_firm_rekvizIT,'
      
        '1103898=      G.NAME, --DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1085#1076#1080#1074#1080#1076#1091#1072#1083#1100#1085#1099#1081' ' +
        #1087#1088#1077#1076#1087#1088#1080#1085#1080#1084#1072#1090#1077#1083#1100' '#39#39', '#39#39#1058#1054#1054' '#39#39')||G.NAME,'
      '1103899=      G.IDN,'
      '11038100=      AD.G_ADDRESS,'
      '11038101=      AC.G_ACCOUNT,'
      
        '11038102=      DECODE(G.IP_OR_JUR, 0, '#39#39#1048#1048#1053#39#39', 1, '#39#39#1041#1048#1053#39#39')||'#39#39': ' +
        #39#39'||G.IDN||'#39#39', '#39#39'||G.NAME||'#39#39', '#39#39'||AD.ADDRESS'
      '11038103=    FROM G_FIRM_REKVIZIT g'
      '11038104=           LEFT OUTER JOIN (SELECT *'
      '11038105=                              FROM G_FIRM_ADDRESS F'
      
        '11038106=                             WHERE F.IS_DEFAULT = 1) AD' +
        ' ON G.G_FIRM_REKVIZIT = AD.G_FIRM_REKVIZIT'
      '11038107=           LEFT OUTER JOIN (SELECT A.G_ACCOUNT,'
      '11038108=                                   A.ACCOUNT,'
      '11038109=                                   A.G_FIRM_REKVIZIT,'
      '11038110=                                   A.G_BANK,'
      '11038111=                                   B.BIK, B.NAME'
      '11038112=                              FROM G_FIRM_ACCOUNT A,'
      '11038113=                                   G_BANK B'
      '11038114=                             WHERE A.G_BANK = B.G_BANK'
      
        '11038115=                               AND A.IS_DEFAULT = 1) AC' +
        ' ON G.G_FIRM_REKVIZIT = AC.G_FIRM_REKVIZIT'
      '11038116=    WHERE G.IS_DEFAULT = 1'
      '11038117=    INTO'
      '11038118=      :g_firm_,'
      '11038119=      :POSTAVSHIK_,'
      '11038120=      :IDN_,'
      '11038121=      :ADDRESS_,'
      '11038122=      :IIK_,'
      '11038123=      :GRUZOOTPRAVITEL_;'
      '11038124='
      '11038125=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '11038126=    SELECT'
      '11038127=      Z.Z_DATE,'
      '11038128=      C.G_CLIENT,'
      
        '11038129=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39#39#39')), ' +
        '0, C.NAME, c.name_FULL),'
      '11038130=      C.IDN,'
      '11038131=      AD.G_ADDRESS,'
      
        '11038132=      DECODE(CHAR_LENGTH(COALESCE(Z.OSNOVANIE, '#39#39#39#39')), ' +
        '0, '#39#39#1041#1077#1079' '#1076#1086#1075#1086#1074#1086#1088#1072#39#39', Z.OSNOVANIE),'
      '11038133=      Z.G_PAYMENT_TYPE,'
      '11038134=      AD.ADDRESS,'
      '11038135=      AD.ADDRESS,'
      '11038136=      '#39#39#1041#1077#1079' '#1076#1086#1074#1077#1088#1077#1085#1085#1086#1089#1090#1080#39#39','
      '11038137=      '#39#39#1057#1072#1084#1086#1074#1099#1074#1086#1079#39#39','
      
        '11038138=      DECODE(CHAR_LENGTH(TRIM(C.IDN)), 0, '#39#39#39#39', '#39#39#1048#1048#1053'/'#1041 +
        #1048#1053': '#39#39'||TRIM(C.IDN)||'#39#39', '#39#39')||DECODE(CHAR_LENGTH(TRIM(COALESCE(C' +
        '.NAME_FULL, '#39#39#39#39'))), 0, C.NAME, TRIM(C.NAME_FULL))||COALESCE('#39#39',' +
        ' '#39#39'||AD.ADDRESS, '#39#39#39#39'),'
      '11038139=      COALESCE(AC.G_ACCOUNT, null)'
      '11038140=    FROM ZAKAZ Z LEFT OUTER JOIN (SELECT *'
      '11038141=                                    FROM G_ADDRESS G'
      
        '11038142=                                   WHERE G.IS_DEFAULT =' +
        ' 1) AD ON Z.G_CLIENT = AD.G_CLIENT'
      '11038143=                 LEFT OUTER JOIN (SELECT *'
      '11038144=                                    FROM G_ACCOUNT G'
      
        '11038145=                                   WHERE G.IS_DEFAULT =' +
        ' 1) AC ON Z.G_CLIENT = AC.G_CLIENT,'
      '11038146=         G_CLIENT C'
      '11038147=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '11038148=      AND Z.G_CLIENT = C.G_CLIENT'
      '11038149=    INTO'
      '11038150=      :INIT_DATE_,'
      '11038151=      :G_CLIENT_,'
      '11038152=      :CLIENT_NAME_,'
      '11038153=      :IDN_CLIENT_,'
      '11038154=      :ADDRESS_POKUPATEL_,'
      '11038155=      :AGREEMENT_,'
      '11038156=      :G_PAYMENT_TYPE_,'
      '11038157=      :PUNKT_NAZNACHENIYA_,'
      '11038158=      :ADDRESS_POLUCHATELYA_,'
      '11038159=      :DOVERENNOST_,'
      '11038160=      :SPOSOB_OTPRAVKI_,'
      '11038161=      :GRUZOPOLUCHATEL_,'
      '11038162=      :IIK_CLIENT_;'
      '11038163='
      
        '11038164=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054#1041 +
        #1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '11038165=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054' '#1056 +
        #1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '11038166=    PNT_ = '#39#39'05'#39#39';'
      '11038167=    SELECT C.id'
      '11038168=      FROM cur_params C'
      '11038169=     WHERE C.cur_params = 1'
      '11038170=    INTO :G_OFFICIAL_;'
      '11038171='
      '11038172=    IF (ROW_COUNT = 0) then BEGIN'
      '11038173=        SELECT MIN(O.G_OFFICIAL)'
      '11038174=          FROM G_OFFICIAL O'
      '11038175=          INTO :G_OFFICIAL_;'
      '11038176=        IF (ROW_COUNT = 0) then BEGIN'
      '11038177=            Err_Code = -20500;'
      
        '11038178=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1057 +
        #1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39#39') RETURNING_VALUE' +
        'S (:ERR_MSG);'
      
        '11038179=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39 +
        ' '#39#39'||ERR_MSG;'
      '11038180=            EXIT;'
      '11038181=        END'
      '11038182=    END'
      '11038183='
      '11038184=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '11038185=    SELECT O.G_OFFICIAL'
      '11038186=    FROM G_OFFICIAL O'
      '11038187=    WHERE O.IS_RUKOVODITEL = 1'
      '11038188=    INTO :G_OFFICIAL_RUKOVOD_;'
      '11038189='
      '11038190=    --'#1048#1065#1059' '#1043#1051#1040#1042#1041#1059#1061#1040
      '11038191=    SELECT O.G_OFFICIAL'
      '11038192=    FROM G_OFFICIAL O'
      '11038193=    WHERE O.IS_GLAVBUH = 1'
      '11038194=    INTO :G_OFFICIAL_GB_;'
      '11038195='
      
        '11038196=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1057#1063#1045#1058#1040' '#1053#1040' '#1054#1055#1051#1040#1058#1059', '#1057#1053#1040#1063#1040#1051#1040' '#1057 +
        #1044#1045#1051#1040#1051' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '11038197=    --select substring('#39#39'0000000000'#39#39' from CHAR_LENGTH(' +
        'MAX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMER' +
        'IC(15))) + 1) FROM INVOICE_PAY'
      
        '11038198=    SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS VARC' +
        'HAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '11038199=      FROM INVOICE P'
      '11038200=    INTO :NUM_;'
      '11038201='
      
        '11038202=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1057#1063#1045#1058#1054#1042' '#1053#1040' '#1054#1055#1051#1040#1058#1059' '#1042 +
        #1054#1054#1041#1065#1045' '#1053#1045#1058
      '11038203=      NUM_ = '#39#39'1'#39#39';'
      '11038204=  END'
      '11038205=END'
      '11038206='#39';'
      '11038206=END  --END_EXECUTE_BLOCK'
      '110390=EXECUTE BLOCK AS BEGIN'
      '110391=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_HISTORY('
      '110392=  G_PRODUCT_ARR_ VARCHAR(1000),'
      '110393=  DATE_BEGIN_ DATE,'
      '110394=  DATE_END_ DATE,'
      '110395=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110396=RETURNS ('
      '110397=  ROW INTEGER,'
      '110398=  DATE_ACT DATE,'
      '110399=  OPER VARCHAR(500),'
      '1103910=  PRICE_PRIHOD NUMERIC(15,2),'
      '1103911=  AMOUNT_PRIHOD NUMERIC(15,2),'
      '1103912=  SUMM_PRIHOD NUMERIC(15,2),'
      '1103913=  PRICE_UHOD NUMERIC(15,2),'
      '1103914=  AMOUNT_UHOD NUMERIC(15,2),'
      '1103915=  SUMM_UHOD NUMERIC(15,2),'
      '1103916=  ERR_CODE INTEGER,'
      '1103917=  ERR_MSG VARCHAR(1024))'
      '1103918=AS'
      
        '1103919=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_TOVAR_MO' +
        'VE'#39#39';'
      '1103920=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1103921=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_P' +
        'RODUCT;'
      '1103922=DECLARE VARIABLE DATE_SORT DATE;'
      '1103923=BEGIN'
      '1103924='
      '1103925=  FOR SELECT F.G_PRODUCT'
      '1103926=        FROM G_PRODUCT F'
      
        '1103927=       WHERE :G_PRODUCT_ARR_ CONTAINING '#39#39'~'#39#39'||F.G_PRODU' +
        'CT||'#39#39'~'#39#39
      '1103928=       AND EXISTS (SELECT 1'
      '1103929=                     FROM SKLAD SS'
      
        '1103930=                    WHERE SS.DATE_RECEIPT BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      '1103931=                      AND SS.G_PRODUCT = F.G_PRODUCT'
      
        '1103932=                      AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||SS.G_TOCHKA||'#39#39'-'#39#39
      '1103933=                   UNION ALL'
      '1103934=                   SELECT 1'
      '1103935=                     FROM ZAKAZ ZZ,'
      '1103936=                          ZAKAZ_DETAILS ZZD'
      '1103937=                    WHERE ZZ.ZAKAZ = ZZD.ZAKAZ'
