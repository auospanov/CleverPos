      '110606559=  SHORT_NAME_ TYPE OF COLUMN G_BANK.SHORT_NAME)'
      '110606560=RETURNS ('
      '110606561=  G_BANK_ TYPE OF COLUMN G_BANK.G_BANK,'
      '110606562=  ERR_CODE INTEGER,'
      '110606563=  ERR_MSG VARCHAR(1024))'
      '110606564=AS'
      '110606565=begin'
      '110606566=    INSERT INTO G_BANK (G_BANK, BIK, NAME, SHORT_NAME)'
      
        '110606567=    VALUES (GEN_ID(GEN_G_BANK,  1), :BIK_, :NAME_, :SH' +
        'ORT_NAME_)'
      '110606568=    RETURNING G_BANK'
      '110606569=    INTO :G_BANK_;'
