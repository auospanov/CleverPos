        '1102201420=                                                    :' +
        'UPLOAD_TO_EXT_APP_'
      
        '1102201421=                                                    )' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102201422=                END'
      '1102201423=            END'
      '1102201424=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201425=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102201426=              EXIT;'
      '1102201427=            END'
      '1102201428='
      
        '1102201429=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1102201430=      END'
      '1102201431='
      
        '1102201432=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1102201433=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1102201434=            FROM KASSA K'
      '1102201435=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102201436=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1102201437=           UNION'
      '1102201438=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1102201439=            FROM KASSA K'
      '1102201440=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102201441=             AND K.SUMM = 0'
      '1102201442=          UNION'
      '1102201443=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102201444=            FROM KASSA_BEZNAL K'
      '1102201445=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102201446=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1102201447=          UNION'
      '1102201448=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102201449=            FROM KASSA_BEZNAL K'
      '1102201450=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102201451=             AND K.SUMM = 0'
      '1102201452=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1102201453=      DO BEGIN'
      '1102201454=        PNT_ = '#39'011A'#39';'
      
        '1102201455=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, ' +
        ':ERR_MSG);'
      '1102201456=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201457=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102201458=          EXIT;'
      '1102201459=        END'
      '1102201460=      END'
      '1102201461=  END'
      '1102201462='
      
        '1102201463=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1102201464=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1102201465=    SELECT K.KASSA'
      '1102201466=      FROM KASSA K'
      '1102201467=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102201468=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102201469=      INTO :KASSA_POP_;'
      '1102201470=  ELSE'
      '1102201471=    SELECT K.KASSA_BEZNAL'
      '1102201472=      FROM KASSA_BEZNAL K'
      '1102201473=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102201474=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102201475=       INTO :KASSA_POP_;'
      '1102201476='
      
        '1102201477=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1102201478=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1102201479=      PNT_ = '#39'012'#39';'
      '1102201480=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1102201481=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1102201482=                                          1,     -- A' +
        'CTION_'
      '1102201483=                                          :G_PRIHOD_,'
      
        '1102201484=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102201485=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102201486=                                          NULL,   --N' +
        'OTE_'
      '1102201487=                                          NULL,'
      
        '1102201488=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102201489=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1102201490=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102201491=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102201492=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1102201493=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102201494=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1102201495=                                          :G_PRIHOD_,'
      
        '1102201496=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102201497=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102201498=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1102201499=                                          NULL,'
      
        '1102201500=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102201501=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102201502=                                          :G_TOCHKA_,'
      
        '1102201503=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102201504=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102201505=      END'
      '1102201506=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201507=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102201508=        EXIT;'
      '1102201509=      END'
      '1102201510='
      
        '1102201511=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102201512=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102201513=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102201514=        PNT_ = '#39'013'#39';'
      
        '1102201515=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_' +
        'CODE, :ERR_MSG);'
      '1102201516=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201517=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102201518=          EXIT;'
      '1102201519=        END'
      '1102201520=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102201521=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1102201522=                                          :G_PRIHOD_,'
      
        '1102201523=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102201524=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102201525=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1102201526=                                          NULL,   --Z' +
