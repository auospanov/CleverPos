      '11040109='#39';'
      '11040110='
      '11040111=EXECUTE STATEMENT '#39'ALTER PROCEDURE INS_ZAKAZ('
      
        '11040112=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ INTE' +
        'GER,'
      '11040113=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '11040114=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '11040115=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ INTEGER' +
        ','
      
        '11040116=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYP' +
        'E */ INTEGER,'
      
        '11040117=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCH' +
        'AR(150),'
      
        '11040118=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ I' +
        'NTEGER,'
      '11040119=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '11040120=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '11040121=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUMER' +
        'IC(15,2),'
      
        '11040122=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMER' +
        'IC(15,2),'
      
        '11040123=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */' +
        ' NUMERIC(15,2),'
      
        '11040124=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NUM' +
        'ERIC(15,2),'
      
        '11040125=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GO' +
        'T */ NUMERIC(15,2),'
      
        '11040126=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_' +
        'RASHOD */ INTEGER,'
      
        '11040127=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11040128=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTEG' +
        'ER,'
      
        '11040129=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ INT' +
        'EGER,'
      '11040130=  PAYMENTS_ BLOB SUB_TYPE 1)'
      '11040131=RETURNS ('
      '11040132=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ INTEGER,'
      '11040133=  ERR_CODE INTEGER,'
      '11040134=  ERR_MSG VARCHAR(1024))'
      '11040135=AS'
