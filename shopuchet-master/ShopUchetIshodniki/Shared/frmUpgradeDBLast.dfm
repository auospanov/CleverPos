        'D = 0,'
      '1102016050=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102016051=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102016052=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102016053=RETURNS ('
      '1102016054=  ERR_CODE INTEGER,'
      '1102016055=  ERR_MSG VARCHAR(1024))'
      '1102016056=AS'
      
        '1102016057=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
