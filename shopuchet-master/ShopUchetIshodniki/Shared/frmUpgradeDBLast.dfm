      '11071310=  G_CLIENT_PROMO_ INTEGER,'
      
        '11071311=  MAX_BONUS_PAY_SUMM_ /* TYPE OF COLUMN G_CLIENT.MAX_BO' +
        'NUS_PAY_SUMM */ NUMERIC(15,2))'
      '11071312=RETURNS ('
