      '110233636=           ZAKAZ_DETAILS ZD,'
      '110233637=           G_PRODUCT GP,'
      '110233638=           P_REP_TREE TR'
      
        '110233639=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110233640=       AND Z.IS_SPISANIE = 2'
      '110233641=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110233642=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110233643=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110233644=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110233645=       AND Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_END' +
