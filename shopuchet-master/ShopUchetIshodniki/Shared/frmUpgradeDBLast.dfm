        '110752600=                     SET L.AMOUNT = L.AMOUNT - (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110752601=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110752602=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110752603='
      
        '110752604=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
