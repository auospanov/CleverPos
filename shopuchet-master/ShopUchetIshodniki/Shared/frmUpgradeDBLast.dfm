        '1101241198=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101241199=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
