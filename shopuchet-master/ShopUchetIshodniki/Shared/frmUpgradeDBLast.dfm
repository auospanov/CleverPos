        #39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '11039282=                       +'
      
        '11039283=                       (select COALESCE(sum(zd.amount),' +
        ' 0) from zakaz_details zd, zakaz z'
      
        '11039284=                        where zd.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '11039285=                        and zd.zakaz = z.zakaz and z.z_' +
        'date > :DATE_END_)'
      '11039286=                       +'
      
        '11039287=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11039288=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '11039289=                       +'
      
        '11039290=                       (select COALESCE(sum(od.amount),' +
        ' 0) from other_details od, other o'
      
        '11039291=                        where od.g_product = G.G_PRODUC' +
        'T and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '11039292=                        and od.other = o.other and o.op' +
        '_date > :DATE_END_)'
      '11039293=                       -'
      
        '11039294=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_AR' +
        'R_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '11039295=                        and s.is_vozvrat <> 3 and s.dat' +
        'e_receipt > :DATE_END_)'
      '11039296=                       -'
      
        '11039297=                       (select COALESCE(sum(s.amount), ' +
        '0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvrat' +
        ' = 3'
      
        '11039298=                        and :G_TOCHKA_ARR_ CONTAINING '#39 +
        #39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt > :DATE_END_)'
      '11039299=                  from rdb$database) PRICE,'
      '11039300=                 NULL,'
      '11039301=                 NULL,'
      '11039302=                 NULL,'
      '11039303=                 NULL,'
      '11039304=                 NULL'
      '11039305=            FROM G_PRODUCT G'
      '11039306=           WHERE G.G_PRODUCT = :G_PRODUCT_'
      '11039307=         ORDER BY 2, 1, 3'
      '11039308=            INTO :ROW,'
      '11039309=                 :DATE_SORT,'
      '11039310=                 :DATE_ACT,'
      '11039311=                 :OPER,'
      '11039312=                 :PRICE_PRIHOD,'
      '11039313=                 :AMOUNT_PRIHOD,'
      '11039314=                 :SUMM_PRIHOD,'
      '11039315=                 :PRICE_UHOD,'
      '11039316=                 :AMOUNT_UHOD,'
      '11039317=                 :SUMM_UHOD'
      '11039318=      DO BEGIN'
      '11039319=        IF (ROW not in (-2, -1, 13)) THEN BEGIN'
      '11039320=            PRICE_PRIHOD = COALESCE(PRICE_PRIHOD, 0);'
      '11039321=            AMOUNT_PRIHOD = COALESCE(AMOUNT_PRIHOD, 0);'
      '11039322=            SUMM_PRIHOD = COALESCE(SUMM_PRIHOD, 0);'
      '11039323=            PRICE_UHOD = COALESCE(PRICE_UHOD, 0);'
      '11039324=            AMOUNT_UHOD = COALESCE(AMOUNT_UHOD, 0);'
      '11039325=            SUMM_UHOD  = COALESCE(SUMM_UHOD, 0);'
      '11039326=        END'
      '11039327=        SUSPEND;'
      '11039328=      END'
      '11039329=  END'
      '11039330=WHEN ANY DO BEGIN'
      '11039331=    Err_code = -20500;'
      
        '11039332=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1048#1057#1058#1054#1056#1048#1048' '#1058#1054#1042#1040#1056#1040'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11039333=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR' +
        '_MSG;'
      '11039334=  END'
      '11039335=end'
      '11039336='#39';'
      '11039337='
      
        '11039338=EXECUTE STATEMENT '#39'ALTER PROCEDURE READ_ZAKAZ_NA_REAL_L' +
        'IST('
      '11039339=  MODE_ INTEGER)'
      '11039340=RETURNS ('
      
        '11039341=  ZAKAZ_NA_REAL TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA_R' +
        'EAL,'
      '11039342=  G_CLIENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.G_CLIENT,'
      '11039343=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11039344=  ZAKAZ_NUM TYPE OF COLUMN ZAKAZ_REAL_PARENT.OSNOVANIE,'
      
        '11039345=  ZAKAZ_DATE TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZAKAZ_DAT' +
        'E,'
      
        '11039346=  ZAKAZ_REAL_PARENT TYPE OF COLUMN ZAKAZ_REAL_PARENT.ZA' +
        'KAZ_REAL_PARENT,'
      '11039347=  G_PRODUCT TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '11039348=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11039349=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11039350=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '11039351=  PRICE TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      '11039352=  AMOUNT_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '11039353=  SUMM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      
        '11039354=  AMOUNT_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PAYE' +
        'D,'
      '11039355=  SUMM_PAYED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '11039356=  AMOUNT_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_R' +
        'ETURNED,'
      
        '11039357=  SUMM_RETURNED TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED' +
        ','
      
        '11039358=  AMOUNT_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_PAYED' +
        ','
      '11039359=  SUMM_LEFT TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      
        '11039360=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.IS_PAYED_AL' +
        'L,'
      '11039361=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '11039362=  PRODCAT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11039363=  AM_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '11039364=  SU_ALL TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL)'
      '11039365=AS'
      '11039366=begin'
      '11039367=  FOR SELECT Z.ZAKAZ_NA_REAL,'
      '11039368=             ZP.G_CLIENT,'
      '11039369=             C.NAME,'
      '11039370=             ZP.ZAKAZ_DATE,'
      '11039371=             Z.G_PRODUCT,'
      '11039372=             P.NAME,'
      '11039373=             P.ARTICUL,'
      '11039374=             P.BARCODE,'
      '11039375=             Z.PRICE,'
      '11039376=             Z.AMOUNT_ALL,'
      '11039377=             Z.SUMM_ALL,'
      '11039378=             Z.AMOUNT_PAYED,'
      '11039379=             Z.SUMM_PAYED,'
      '11039380=             COALESCE(Z.AMOUNT_RETURNED, 0),'
      '11039381=             COALESCE(Z.SUMM_RETURNED, 0),'
      
        '11039382=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE(Z' +
        '.AMOUNT_RETURNED, 0),'
      
        '11039383=             Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.SUM' +
        'M_RETURNED, 0),'
      '11039384=             Z.IS_PAYED_ALL,'
      '11039385=             P.G_PRODUCT_PAR,'
      '11039386=             CAT.NAME,'
      '11039387=             ZP.ZAKAZ_REAL_PARENT,'
      '11039388=             ZP.OSNOVANIE,'
      '11039389=             ZT.AM_ALL,'
      '11039390=             ZT.SU_ALL'
      
        '11039391=        FROM ZAKAZ_REAL_PARENT ZP, ZAKAZ_NA_REAL Z, G_C' +
        'LIENT C, G_PRODUCT P, g_product CAT/*(select -1 g_product, '#39#39#1041#1077#1079 +
        ' '#1075#1088#1091#1087#1087#1099#39#39' NAME FROM RDB$DATABASE'
      
        '11039392=                                                       ' +
        '                       UNION ALL'
      
        '11039393=                                                       ' +
        '                       SELECT g_product,  NAME FROM G_PRODUCT WH' +
        'ERE IS_CATEGORY = 1) CAT*/,'
      
        '11039394=             (SELECT SUM(ZZ.AMOUNT_ALL - ZZ.amount_paye' +
        'd - ZZ.amount_returned) AM_ALL,'
      
        '11039395=                     SUM(ZZ.SUMM_ALL - ZZ.summ_payed - ' +
        'ZZ.summ_returned) SU_ALL,'
      '11039396=                     ZPP.G_CLIENT,'
      '11039397=                     ZPP.OSNOVANIE'
      '11039398=                FROM ZAKAZ_REAL_PARENT ZPP,'
      '11039399=                     ZAKAZ_NA_REAL ZZ'
      
        '11039400=               WHERE ZPP.ZAKAZ_REAL_PARENT = ZZ.ZAKAZ_R' +
        'EAL_PARENT'
      '11039401=               GROUP BY ZPP.G_CLIENT, ZPP.OSNOVANIE) ZT'
      
        '11039402=       WHERE ZP.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '11039403=         AND ZP.G_CLIENT = C.G_CLIENT'
      '11039404=         AND ZP.ZAKAZ_REAL_PARENT = Z.ZAKAZ_REAL_PARENT'
      '11039405=         AND Z.G_PRODUCT = P.G_PRODUCT'
      '11039406=         AND P.G_PRODUCT_par = CAT.G_PRODUCT'
      '11039407=         AND ZP.G_CLIENT = ZT.G_CLIENT'
      '11039408=         AND ZP.OSNOVANIE = ZT.OSNOVANIE'
      '11039409=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      '11039410=         AND ((Z.IS_PAYED_ALL = 0 AND :MODE_ = 0)'
      '11039411=              OR'
      
        '11039412=              (Z.IS_PAYED_ALL = 1 AND Z.AMOUNT_PAYED > ' +
        '0 AND :MODE_ = 1)'
      '11039413=              OR'
      
        '11039414=              (COALESCE(Z.AMOUNT_RETURNED, 0) > 0 AND :' +
        'MODE_ = 2)'
      '11039415=              OR'
      '11039416=              :MODE_ = 3)'
      '11039417=       ORDER BY C.NAME, ZP.ZAKAZ_DATE'
      '11039418=      INTO :ZAKAZ_NA_REAL,'
      '11039419=           :G_CLIENT,'
      '11039420=           :CLIENT_NAME,'
      '11039421=           :ZAKAZ_DATE,'
      '11039422=           :G_PRODUCT,'
      '11039423=           :PRODUCT_NAME,'
      '11039424=           :ARTICUL,'
      '11039425=           :BARCODE,'
      '11039426=           :PRICE,'
      '11039427=           :AMOUNT_ALL,'
      '11039428=           :SUMM_ALL,'
      '11039429=           :AMOUNT_PAYED,'
      '11039430=           :SUMM_PAYED,'
      '11039431=           :AMOUNT_RETURNED,'
      '11039432=           :SUMM_RETURNED,'
      '11039433=           :AMOUNT_LEFT,'
      '11039434=           :SUMM_LEFT,'
      '11039435=           :IS_PAYED_ALL,'
      '11039436=           :G_PRODUCT_PAR,'
      '11039437=           :PRODCAT_NAME,'
      '11039438=           :ZAKAZ_REAL_PARENT,'
      '11039439=           :ZAKAZ_NUM,'
      '11039440=           :AM_ALL,'
      '11039441=           :SU_ALL'
      '11039442=  DO'
      '11039443=    suspend;'
      '11039444=end'
      '11039445='#39';'
      '11039445=END  --END_EXECUTE_BLOCK'
      '110400=EXECUTE BLOCK AS BEGIN'
      '110401=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD('
      '110402=  SKLAD_ /* TYPE OF COLUMN SKLAD.SKLAD */ INTEGER,'
      '110403=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '110404=RETURNS ('
      '110405=  ERR_CODE INTEGER,'
      '110406=  ERR_MSG VARCHAR(1024))'
      '110407=AS'
      '110408=BEGIN'
      '110409=  SUSPEND;'
      '1104010=END'
      '1104011='#39';'
      '1104012='
      '1104013=EXECUTE STATEMENT '#39'ALTER PROCEDURE DEL_SKLAD_DETAIL('
      
        '1104014=  SKLAD_PARENT_ /* TYPE OF COLUMN SKLAD_PARENT.SKLAD */ ' +
        'INTEGER)'
      '1104015=RETURNS ('
      '1104016=  ERR_CODE INTEGER,'
      '1104017=  ERR_MSG VARCHAR(1024))'
      '1104018=AS'
      '1104019=BEGIN'
