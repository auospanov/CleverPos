      '110201992=RETURNS ('
      '110201993=  ERR_CODE INTEGER,'
      '110201994=  ERR_MSG VARCHAR(1024))'
      '110201995=AS'
      '110201996=BEGIN'
      '110201997=  SUSPEND;'
      '110201998=END'
      '110201999=;'
      '1102011000='
      '1102011001='
      
        '1102011002=/****************************************************' +
        '**************************/'
      
        '1102011003=/****                          Altering triggers     ' +
        '                      ****/'
      
        '1102011004=/****************************************************' +
        '**************************/'
      '1102011005=ALTER TRIGGER LT_SKLAD_PRODUCT_BU0'
      '1102011006=AS'
      
        '1102011007=declare variable G_NAME_  TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      '1102011008=declare variable CNT_     INTEGER;'
      
        '1102011009=declare variable T_NAME_  TYPE OF COLUMN G_TOCHKA.NAM' +
        'E = '#39#39';'
      '1102011010=BEGIN'
      '1102011011=  IF (OLD.AMOUNT <> NEW.AMOUNT) THEN BEGIN'
      
        '1102011012=      IF (RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'REPLICAT'#39 +
        ') IS NOT NULL OR'
      
        '1102011013=      RDB$GET_CONTEXT ('#39'USER_SESSION'#39', '#39'EXT_APP'#39') IS ' +
        'NOT NULL) THEN EXIT;'
      '1102011014='
      
        '1102011015=      if ((OLD.G_PRODUCT <> -2) AND ((NEW.AMOUNT - NE' +
        'W.AMOUNT_RESERVE) < 0) AND (SELECT S_VALUE FROM SYSTEM_SETUP WHE' +
        'RE SYSTEM_SETUP = 2) = 0) then BEGIN'
      '1102011016=        SELECT G.NAME'
      '1102011017=          FROM G_PRODUCT G'
      '1102011018=         WHERE G.G_PRODUCT = NEW.G_PRODUCT'
      '1102011019=          INTO :G_NAME_;'
      '1102011020='
      '1102011021=        if ((SELECT COUNT(*) FROM G_TOCHKA) > 1) then'
      '1102011022=          SELECT '#39' '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||G.NAME||'#39'"'#39
      '1102011023=            FROM G_TOCHKA G'
      '1102011024=           WHERE G.G_TOCHKA = NEW.G_TOCHKA'
      '1102011025=            INTO :T_NAME_;'
      '1102011026='
      
        '1102011027=        --'#39'/Q\'#39' - '#1041#1059#1044#1059' '#1042' '#1044#1045#1051#1068#1060#1071#1061' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1050#1040#1050' '#1050#1054#1053 +
        #1045#1062' '#1057#1054#1054#1041#1065#1045#1053#1048#1071', '#1048' '#1042#1057#1045' '#1063#1058#1054' '#1044#1040#1051#1068#1064#1045' - '#1042#1067#1056#1045#1047#1040#1058#1068', '#1040' '#1058#1054' FIREBIRD '#1057#1040#1052' '#1044#1054#1041 +
        #1040#1042#1051#1071#1045#1058
      
        '1102011028=        -- '#1055#1054#1058#1054#1052' '#1043#1044#1045' '#1048' '#1042' '#1050#1040#1050#1054#1052' '#1058#1056#1048#1043#1043#1045#1056#1045' '#1055#1056#1054#1048#1047#1054#1064#1051#1040' '#1054#1064#1048 +
        #1041#1050#1040
      
        '1102011029=        EXCEPTION NOL_EXCEPTION '#39'/R\'#1042' '#1088#1077#1079#1091#1083#1100#1090#1072#1090#1077' '#1086#1087#1077#1088 +
        #1072#1094#1080#1080' '#1086#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||G_NAME_||'#39'"'#39'||T_NAME_||'#39' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077 +
        #1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'./Q\'#39';'
      '1102011030=      END'
      '1102011031=  END'
      '1102011032=END'
      '1102011033=;'
      '1102011034='
      '1102011035='
      
        '1102011036=/****************************************************' +
        '**************************/'
      
        '1102011037=/****                      Altering stored procedures' +
        '                      ****/'
      
        '1102011038=/****************************************************' +
        '**************************/'
      '1102011039=ALTER PROCEDURE DEL_SKLAD('
      '1102011040=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '1102011041=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '1102011042=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102011043=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102011044=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102011045=RETURNS ('
      '1102011046=  ERR_CODE INTEGER,'
      '1102011047=  ERR_MSG VARCHAR(1024))'
      '1102011048=AS'
      '1102011049=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD'#39';'
      '1102011050=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102011051=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102011052=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AM' +
        'OUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '1102011053=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1102011054=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1102011055=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1102011056=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1102011057=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.' +
        'AMOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057 +
        #1071') */'
      
        '1102011058=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA' +
        '.NAME;'
      
        '1102011059=DECLARE VARIABLE DATE_ TYPE OF COLUMN SKLAD_PARENT.DA' +
        'TE_RECEIPT;'
      
        '1102011060=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1102011061=DECLARE VARIABLE REC_ID_ TYPE OF COLUMN SKLAD_PARENT.' +
        'REC_ID;'
      '1102011062=BEGIN'
      '1102011063='
      '1102011064=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '1102011065=    SELECT S_VALUE'
      '1102011066=      FROM SYSTEM_SETUP'
      '1102011067=     WHERE SYSTEM_SETUP = 2'
      '1102011068=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '1102011069='
      '1102011070=  SELECT SP.IS_VOZVRAT,'
      
        '1102011071=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TO' +
        'CHKA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '1102011072=         ,G.NAME'
      '1102011073=         ,SP.DATE_RECEIPT'
      '1102011074=         ,SP.SUMM'
      '1102011075=         ,SP.REC_ID'
      '1102011076=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '1102011077=   WHERE SP.SKLAD = :SKLAD_'
      '1102011078=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '1102011079=    INTO :IS_VOZVRAT_,'
      '1102011080=         :G_TOCHKA_'
      '1102011081=         ,:TOCHKA_NAME_'
      '1102011082=         ,:DATE_'
      '1102011083=         ,:SUMM_'
      '1102011084=         ,:REC_ID_;'
      '1102011085='
      '1102011086=  PNT_ = '#39'02'#39';'
      '1102011087=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '1102011088=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' ' +
        #1053#1040' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '1102011089=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040 +
        #1045#1058' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      '1102011090=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '1102011091=      FOR SELECT S.G_PRODUCT,'
      '1102011092=                 SUM(S.AMOUNT)'
      '1102011093=            FROM SKLAD S'
      '1102011094=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '1102011095=           GROUP BY S.G_PRODUCT'
      '1102011096=            INTO :G_PRODUCT_,'
      '1102011097=                 :AMOUNT_PRIHOD_'
      '1102011098=      DO BEGIN'
      '1102011099=          SELECT L.AMOUNT,'
      '1102011100=                 G.NAME'
      '1102011101=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '1102011102=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102011103=             AND L.G_PRODUCT = G.G_PRODUCT'
      '1102011104=             AND L.G_TOCHKA = :G_TOCHKA_'
      '1102011105=            INTO :AMOUNT_LAST_,'
      '1102011106=                 :NAME_;'
      '1102011107='
      
        '1102011108=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) ' +
        'THEN BEGIN'
      '1102011109=              ERR_CODE = -20500;'
      
        '1102011110=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE,' +
        ' '#39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||NAME_||'#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||TOCHKA_NAME_||'#39'" '#1089#1090 +
        #1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETUR' +
        'NING_VALUES (:ERR_MSG);'
      
        '1102011111=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102011112=              EXIT;'
      '1102011113=          END'
      '1102011114=      END'
      '1102011115=  END'
      '1102011116='
      
        '1102011117=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL, :' +
        'UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102011118=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102011119=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102011120=    EXIT;'
      '1102011121=  END'
      '1102011122='
      '1102011123=  -------------------------------------'
      
        '1102011124=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048 +
        ' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050 +
        #1051#1040#1044#1040
      
        '1102011125=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053 +
        #1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' ' +
        #1055#1054#1044#1056#1071#1044
      '1102011126=  PNT_ = '#39'05'#39';'
      '1102011127=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '1102011128=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '1102011129=      FOR SELECT S.KASSA'
      '1102011130=            FROM KASSA S'
      '1102011131=           WHERE S.SKLAD = :SKLAD_'
      '1102011132=            INTO :KASSA_'
      '1102011133=      DO BEGIN'
      
        '1102011134=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1, :' +
        'UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102011135=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102011136=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1102011137=             EXIT;'
      '1102011138=          END'
      '1102011139=      END'
      '1102011140='
      '1102011141=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '1102011142=      FOR SELECT S.KASSA_BEZNAL'
      '1102011143=            FROM KASSA_BEZNAL S'
      '1102011144=           WHERE S.SKLAD = :SKLAD_'
      '1102011145=            INTO :KASSA_'
      '1102011146=      DO BEGIN'
      
        '1102011147=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102011148=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102011149=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '1102011150=             EXIT;'
      '1102011151=          END'
      '1102011152=      END'
      '1102011153=  END'
      '1102011154=  -------------------------------------'
      '1102011155='
      '1102011156=  PNT_ = '#39'06'#39';'
      '1102011157=  DELETE FROM sklad_PARENT'
      '1102011158=  WHERE sklad = :sklad_;'
      '1102011159='
      '1102011160=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1102011161=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ IN (0,1,' +
        '2)) THEN BEGIN'
      '1102011162=    UPDATE SYNC_EXT_APP AP'
      '1102011163=       SET AP.OPER = 3,'
      '1102011164=           AP.ID = COALESCE(:REC_ID_, :SKLAD_)'
      '1102011165=     WHERE AP.OBJECT_TYPE = 2'
      '1102011166=       AND AP.ID = :SKLAD_'
      '1102011167=       AND AP.IS_LOADING = 0;'
      '1102011168='
      '1102011169=    IF (ROW_COUNT = 0) THEN'
      
        '1102011170=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1102011171=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, COALE' +
        'SCE(:REC_ID_, :SKLAD_), 3);'
      '1102011172=  END'
      '1102011173='
      '1102011174=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102011175=  EXECUTE PROCEDURE LOG_OPER_INS(IS_VOZVRAT_, :USER_I' +
        'D_, :SKLAD_, :DATE_, 3, :SUMM_, :LOG_BODY_, 1);'
      '1102011176='
      '1102011177=WHEN SQLCODE -530 DO'
      '1102011178=  begin'
      '1102011179=    ERR_CODE = -20500;'
      
        '1102011180=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1102011181=    ERR_MSG = PROCNAME||ERR_MSG;'
      '1102011182=  end'
      '1102011183=END'
      '1102011184=;'
      '1102011185='
      '1102011186=ALTER PROCEDURE DEL_ZAKAZ('
      '1102011187=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102011188=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0,'
      '1102011189=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102011190=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102011191=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102011192=RETURNS ('
      '1102011193=  ERR_CODE INTEGER,'
      '1102011194=  ERR_MSG VARCHAR(1024))'
      '1102011195=AS'
      '1102011196=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '1102011197=DECLARE VARIABLE PNT_ VARCHAR(5) = '#39'00'#39';'
      '1102011198=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102011199=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M;'
      
        '1102011200=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '1102011201=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1102011202=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '1102011203=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1102011204=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1102011205=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1102011206=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM;'
      
        '1102011207=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1102011208=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1102011209=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1102011210=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOC' +
        'HKA;'
      
        '1102011211=DECLARE VARIABLE LOG_ITEM_TYPE_ TYPE OF COLUMN LOG_OP' +
        'ER.ITEM_TYPE;'
      '1102011212=DECLARE VARIABLE STR_ VARCHAR(50);'
      '1102011213=DECLARE VARIABLE Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE;'
      '1102011214=DECLARE VARIABLE LOG_BODY_KASSA_ VARCHAR(1024) = '#39#39';'
      
        '1102011215=DECLARE VARIABLE LOG_KASSA_OPER_TYPE_ TYPE OF COLUMN ' +
        'LOG_OPER.OPERATION;'
      '1102011216=DECLARE VARIABLE REC_ID_ TYPE OF COLUMN ZAKAZ.REC_ID;'
      '1102011217=BEGIN'
      '1102011218='
      
        '1102011219=  --*************************************************' +
        '***************'
      '1102011220=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1102011221=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1102011222=      SELECT Z.SUMM,'
      '1102011223=             Z.SUMM_BONUS,'
      '1102011224=             Z.SUMM_BONUS_GOT,'
      '1102011225=             Z.G_CLIENT,'
      '1102011226=             Z.G_OFFICIAL,'
      '1102011227=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '1102011228=             G.FM'
      '1102011229=             ,Z.G_TOCHKA'
      '1102011230=             ,Z.Z_DATE'
      '1102011231=             ,Z.REC_ID'
      
        '1102011232=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1102011233=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1102011234=        INTO :SUMM_ZAKAZ_,'
      '1102011235=             :SUMM_PAY_BONUS_,'
      '1102011236=             :SUMM_BONUS_GOT_,'
      '1102011237=             :G_CLIENT_,'
      '1102011238=             :G_OFFICIAL_,'
      '1102011239=             :DO_NOT_SALES_COMM_,'
      '1102011240=             :OFFICIAL_NAME_'
      '1102011241=             ,:G_TOCHKA_'
      '1102011242=             ,:Z_DATE_'
      '1102011243=             ,:REC_ID_;'
      '1102011244='
      
        '1102011245=      -- 07.09.2021 '#1055#1054#1050#1040' '#1059#1041#1056#1040#1051' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056 +
        #1054#1044#1040#1042#1062#1059', '#1041#1059#1044#1059#1058' '#1054#1058#1063#1045#1058#1067' '#1044#1045#1056#1043#1040#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047
      
        '1102011246=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1102011247=      /*IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ =' +
        ' 0) THEN'
      '1102011248=        SELECT SUM(ZD.SALES_COMM)'
      '1102011249=          FROM ZAKAZ_DETAILS ZD'
      '1102011250=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1102011251=          INTO :SALES_COMM_OLD_;*/'
      '1102011252='
      '1102011253=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1102011254=      PNT_ = '#39'01'#39';'
      
        '1102011255=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_, :UP' +
        'LOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102011256=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102011257=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102011258=        EXIT;'
      '1102011259=      END'
      '1102011260='
      '1102011261=      -------------------------------------'
      '1102011262=      PNT_ = '#39'02'#39';'
      '1102011263=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '1102011264=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040 +
        #1051#1048#1063#1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045 +
        #1053#1048#1071' '#1055#1054#1044#1056#1071#1044
      '1102011265=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '1102011266=      FOR SELECT S.KASSA'
      '1102011267=            FROM KASSA S'
      '1102011268=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1102011269=            INTO :KASSA_'
      '1102011270=      DO BEGIN'
      
        '1102011271=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1, :' +
        'UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1102011272=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102011273=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
