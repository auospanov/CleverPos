      '110124198='
      
        '110124199=/*****************************************************' +
        '*************************/'
      
        '110124200=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110124201=/*****************************************************' +
        '*************************/'
      '110124202=ALTER PROCEDURE DEL_SKLAD('
      '110124203=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110124204=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      '110124205=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110124206=RETURNS ('
      '110124207=  ERR_CODE INTEGER,'
      '110124208=  ERR_MSG VARCHAR(1024))'
      '110124209=AS'
      '110124210=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_SKLAD'#39';'
      '110124211=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110124212=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110124213=DECLARE VARIABLE AMOUNT_LAST_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1053#1040' '#1044#1040#1053#1053#1067#1049' '#1052#1054#1052#1045#1053#1058' */'
      
        '110124214=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110124215=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110124216=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110124217=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110124218=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN SKLAD.A' +
        'MOUNT = 0; /* '#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1042' '#1055#1056#1048#1061#1054#1044#1045' ('#1057#1050#1054#1051#1068#1050#1054' '#1058#1054#1042#1040#1056#1040' '#1059#1044#1040#1051#1071#1045#1058#1057#1071 +
        ') */'
      
        '110124219=DECLARE VARIABLE TOCHKA_NAME_ TYPE OF COLUMN G_TOCHKA.' +
        'NAME;'
      '110124220=BEGIN'
      '110124221='
      '110124222=  IF (ALLOW_SELL_ABSENT_GOODS_ IS NULL) THEN'
      '110124223=    SELECT S_VALUE'
      '110124224=      FROM SYSTEM_SETUP'
      '110124225=     WHERE SYSTEM_SETUP = 2'
      '110124226=      INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110124227='
      '110124228=  SELECT SP.IS_VOZVRAT,'
      
        '110124229=         SP.G_TOCHKA   -- '#1055#1056#1048' '#1058#1056#1040#1053#1057#1060#1045#1056#1045' '#1058#1054#1042#1040#1056#1054#1042', G_TOC' +
        'HKA '#1069#1058#1054' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068', G_CLIENT - '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '110124230=         ,G.NAME'
      '110124231=    FROM SKLAD_PARENT SP, G_TOCHKA G'
      '110124232=   WHERE SP.SKLAD = :SKLAD_'
      '110124233=     AND SP.G_TOCHKA = G.G_TOCHKA'
      '110124234=    INTO :IS_VOZVRAT_,'
      '110124235=         :G_TOCHKA_'
      '110124236=         ,:TOCHKA_NAME_;'
      '110124237='
      '110124238=  PNT_ = '#39'02'#39';'
      '110124239=  -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1055#1056#1054#1042#1045#1056#1050#1040
      
        '110124240=  -- '#1053#1045' '#1044#1040#1070' '#1059#1044#1040#1051#1071#1058#1068', '#1045#1057#1051#1048' '#1055#1056#1048' '#1069#1058#1054#1052' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040' '#1057#1050#1051#1040#1044#1045' '#1057#1058#1040#1053#1045#1058' '#1054#1058#1056#1048#1062#1040#1058#1045#1051#1068#1053#1067#1052
      
        '110124241=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1054#1064#1048#1041#1050#1040', '#1045#1057#1051#1048' '#1055#1056#1054#1043#1056#1040#1052#1052#1040' '#1069#1058#1054#1043#1054' '#1053#1045' '#1056#1040#1047#1056#1045#1064#1040#1045 +
        #1058' - '#1055#1056#1054#1044#1040#1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052
      '110124242=  IF (:ALLOW_SELL_ABSENT_GOODS_ = 0) THEN BEGIN'
      '110124243=      FOR SELECT S.G_PRODUCT,'
      '110124244=                 SUM(S.AMOUNT)'
      '110124245=            FROM SKLAD S'
      '110124246=           WHERE S.SKLAD_PARENT = :SKLAD_'
      '110124247=           GROUP BY S.G_PRODUCT'
      '110124248=            INTO :G_PRODUCT_,'
      '110124249=                 :AMOUNT_PRIHOD_'
      '110124250=      DO BEGIN'
      '110124251=          SELECT L.AMOUNT,'
      '110124252=                 G.NAME'
      '110124253=            FROM LT_SKLAD_PRODUCT L, G_PRODUCT G'
      '110124254=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110124255=             AND L.G_PRODUCT = G.G_PRODUCT'
      '110124256=             AND L.G_TOCHKA = :G_TOCHKA_'
      '110124257=            INTO :AMOUNT_LAST_,'
      '110124258=                 :NAME_;'
      '110124259='
      
        '110124260=          IF ((:AMOUNT_LAST_ - :AMOUNT_PRIHOD_) < 0) T' +
        'HEN BEGIN'
      '110124261=              ERR_CODE = -20500;'
      
        '110124262=              EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ' +
        #39#1054#1089#1090#1072#1090#1086#1082' '#1090#1086#1074#1072#1088#1072' "'#39'||NAME_||'#39'" '#1085#1072' '#1089#1082#1083#1072#1076#1077' "'#39'||TOCHKA_NAME_||'#39'" '#1089#1090#1072 +
        #1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'! '#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'!'#39') RETURN' +
        'ING_VALUES (:ERR_MSG);'
      
        '110124263=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110124264=              EXIT;'
      '110124265=          END'
      '110124266=      END'
      '110124267=  END'
      '110124268='
      
        '110124269=  EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_, NULL) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110124270=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110124271=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110124272=    EXIT;'
      '110124273=  END'
      '110124274='
      '110124275=  -------------------------------------'
      
        '110124276=  -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1057#1059#1052#1052#1067' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' ' +
        #1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040'-'#1055#1054#1044'-'#1056#1045#1040#1051', '#1048' '#1053#1045' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051 +
        #1040#1044#1040
      
        '110124277=  -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040#1051#1048#1063#1053#1067 +
        #1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1055 +
        #1054#1044#1056#1071#1044
      '110124278=  PNT_ = '#39'05'#39';'
      '110124279=  IF (IS_VOZVRAT_ IN (0, 1)) THEN BEGIN'
      '110124280=      -- '#1050#1040#1057#1057#1040' '#1053#1040#1051
      '110124281=      FOR SELECT S.KASSA'
      '110124282=            FROM KASSA S'
      '110124283=           WHERE S.SKLAD = :SKLAD_'
      '110124284=            INTO :KASSA_'
      '110124285=      DO BEGIN'
      
        '110124286=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110124287=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110124288=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '110124289=             EXIT;'
      '110124290=          END'
      '110124291=      END'
      '110124292='
      '110124293=      -- '#1050#1040#1057#1057#1040' '#1041#1045#1047#1053#1040#1051
      '110124294=      FOR SELECT S.KASSA_BEZNAL'
      '110124295=            FROM KASSA_BEZNAL S'
      '110124296=           WHERE S.SKLAD = :SKLAD_'
      '110124297=            INTO :KASSA_'
      '110124298=      DO BEGIN'
      
        '110124299=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RE' +
        'TURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110124300=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110124301=             ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '110124302=             EXIT;'
      '110124303=          END'
      '110124304=      END'
      '110124305=  END'
      '110124306=  -------------------------------------'
      '110124307='
      '110124308=  PNT_ = '#39'06'#39';'
      '110124309=  DELETE FROM sklad_PARENT'
      '110124310=  WHERE sklad = :sklad_;'
      '110124311='
      '110124312=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110124313=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THEN'
      
        '110124314=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER)'
      
        '110124315=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_, 3' +
        ');'
      '110124316='
      '110124317=when sqlcode -530 DO'
      '110124318=  begin'
      '110124319=    ERR_CODE = -20500;'
      
        '110124320=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081' ' +
        #1089#1090#1088#1086#1082#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VAL' +
        'UES (:ERR_MSG);'
      '110124321=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110124322=  end'
      '110124323=end'
      '110124324=;'
      '110124325='
      '110124326=ALTER PROCEDURE INS_SKLAD('
      '110124327=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110124328=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110124329=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110124330=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110124331=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110124332=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110124333=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110124334=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110124335=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110124336=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110124337=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110124338=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110124339=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110124340=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110124341=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0,'
      '110124342=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110124343=RETURNS ('
      '110124344=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110124345=  ERR_CODE INTEGER,'
      '110124346=  ERR_MSG VARCHAR(1024))'
      '110124347=AS'
      '110124348=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110124349=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110124350=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110124351=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110124352=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110124353=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110124354=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110124355=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110124356=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110124357=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110124358=--'
      
        '110124359=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110124360=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110124361=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110124362=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110124363=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110124364=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110124365=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110124366=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110124367=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110124368=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110124369=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110124370=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110124371=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110124372=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110124373=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110124374=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110124375=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110124376=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110124377=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110124378=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110124379=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110124380=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110124381=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110124382=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL' +
        '.G_OFFICIAL;'
      
        '110124383=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110124384=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      '110124385=BEGIN'
      '110124386='
      '110124387=  PNT_ = '#39'00'#39';'
      '110124388=  IS_THIS_LAST_ = 0;'
      '110124389='
      '110124390=  IF (G_TOCHKA_ IS NULL) THEN'
      '110124391=    SELECT ID'
      '110124392=      FROM CUR_PARAMS'
      '110124393=     WHERE CUR_PARAMS = 2'
      '110124394=      INTO :G_TOCHKA_;'
      '110124395='
      '110124396=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110124397=  SELECT ID'
      '110124398=    FROM CUR_PARAMS'
      '110124399=   WHERE CUR_PARAMS = 1'
      '110124400=    INTO :G_OFFICIAL_;'
      '110124401='
      '110124402=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110124403=                            DATE_RECEIPT,'
      '110124404=                            TIME_RECEIPT,'
      '110124405=                            G_CLIENT,'
      '110124406=                            G_PAYMENT_TYPE,'
      '110124407=                            OSNOVANIE,'
      '110124408=                            NOTE,'
      '110124409=                            SUMM,'
      '110124410=                            SUMM_FACT,'
      '110124411=                            SUMM_CURRENCY,'
      '110124412=                            IS_PAYED_ALL,'
      '110124413=                            IS_VOZVRAT,'
      '110124414=                            G_TOCHKA'
      '110124415=                            ,G_OFFICIAL'
      '110124416=                            ,IS_EXPECTED)'
      '110124417=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110124418=          :DATE_RECEIPT_,'
      '110124419=          :TIME_RECEIPT_,'
      '110124420=          :G_CLIENT_,'
      '110124421=          :G_PAYMENT_TYPE_,'
      '110124422=          :OSNOVANIE_,'
      '110124423=          :NOTE_,'
      '110124424=          :SUMM_,'
      '110124425=          :SUMM_FACT_,'
      '110124426=          :SUMM_CURRENCY_,'
      
        '110124427=          DECODE(:SUMM_, :SUMM_FACT_, 1, 0),  -- IS_PA' +
        'YED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "' +
        #1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110124428=          :IS_VOZVRAT_,'
      '110124429=          :G_TOCHKA_'
      '110124430=          ,:G_OFFICIAL_'
      '110124431=          ,:IS_EXPECTED_)'
      '110124432=  RETURNING'
      '110124433=    SKLAD'
      '110124434=  INTO'
      '110124435=    :SKLAD_;'
      '110124436='
      '110124437=  PNT_ = '#39'01'#39';'
      '110124438=  FOR SELECT SKLAD,'
      '110124439=             T.G_PRODUCT,'
      '110124440=             AMOUNT,'
      '110124441=             T.PRICE,'
      '110124442=             SUMM,'
      '110124443=             NDS,'
      '110124444=             NDS_SUMM'
      '110124445=             ,PRICE_CURRENCY'
      '110124446=             ,SUMM_CURRENCY'
      '110124447=             ,PRICE_ROZN'
      '110124448=             ,GG.PRICE'
      '110124449=        FROM SKLAD_TMP T,'
      '110124450=             G_PRODUCT GG'
      '110124451=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110124452=      ORDER BY 1'
      '110124453=      INTO :SKLAD_TMP_,'
      '110124454=           :RG_PRODUCT_,'
      '110124455=           :RAMOUNT_,'
      '110124456=           :RPRICE_,'
      '110124457=           :RSUMM_,'
      '110124458=           :RNDS_,'
      '110124459=           :RNDS_SUMM_'
      '110124460=           ,:PRICE_CURRENCY_'
      '110124461=           ,:SUMM_CURRENCY_TMP_'
      '110124462=           ,:SALE_PRICE_'
      '110124463=           ,:SALE_PRICE_CUR_'
      '110124464=  DO BEGIN'
      '110124465=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110124466=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110124467=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110124468=      IS_THIS_LAST_ = 0;'
      '110124469=      SELECT MAX(SK.DATE_RECEIPT)'
      '110124470=        FROM SKLAD SK'
      '110124471=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110124472=         AND SK.IS_LAST = 1'
      '110124473=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110124474=        INTO :DATE_LAST_;'
      '110124475='
      
        '110124476=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110124477=        UPDATE SKLAD SK'
      '110124478=           SET SK.IS_LAST = 0'
      '110124479=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110124480=           AND SK.IS_LAST = 1'
      '110124481=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110124482='
      '110124483=        IS_THIS_LAST_ = 1;'
      '110124484=      END'
      '110124485=    END'
      '110124486='
      '110124487=    INSERT INTO SKLAD'
      '110124488=    ('
      '110124489=     SKLAD,'
      '110124490=     SKLAD_PARENT,'
      '110124491=     DATE_RECEIPT,'
      '110124492=     G_CLIENT,'
      '110124493=     G_PRODUCT,'
      '110124494=     AMOUNT,'
      '110124495=     PRICE,'
      '110124496=     SUMM,'
      '110124497=     G_PAYMENT_TYPE,'
      '110124498=     OSNOVANIE,'
      '110124499=     NOTE,'
      '110124500=     NDS,'
      '110124501=     NDS_SUMM,'
      '110124502=     IS_LAST,'
      '110124503=     IS_VOZVRAT,'
      '110124504=     G_TOCHKA'
      '110124505=     ,PRICE_CURRENCY'
      '110124506=     ,SUMM_CURRENCY'
      '110124507=    ) VALUES ('
      '110124508=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110124509=     :SKLAD_,'
      '110124510=     :DATE_RECEIPT_,'
      '110124511=     :G_CLIENT_,'
      '110124512=     :RG_PRODUCT_,'
      '110124513=     :RAMOUNT_,'
      '110124514=     :RPRICE_,'
      '110124515=     :RSUMM_,'
      '110124516=     :G_PAYMENT_TYPE_,'
      '110124517=     :OSNOVANIE_,'
      '110124518=     :NOTE_,'
      '110124519=     :RNDS_,'
      '110124520=     :RNDS_SUMM_,'
      
        '110124521=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110124522=     :IS_VOZVRAT_,'
      '110124523=     :G_TOCHKA_'
      '110124524=     ,:PRICE_CURRENCY_'
      '110124525=     ,:SUMM_CURRENCY_TMP_'
      '110124526=    );'
      '110124527='
      
        '110124528=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110124529=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110124530=        PNT_ = '#39'02'#39';'
      '110124531=        UPDATE LT_SKLAD_PRODUCT L'
      '110124532=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_'
      '110124533=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110124534=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110124535='
      '110124536=        IF (ROW_COUNT = 0) THEN'
      
        '110124537=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA) VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_' +
        ');'
      '110124538=    END'
      '110124539='
      
        '110124540=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '110124541=      UPDATE G_PRODUCT G'
      '110124542=         SET G.PRICE = :SALE_PRICE_'
      '110124543=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110124544=  END'
      '110124545=  ----------------------------------------'
      '110124546='
      
        '110124547=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110124548=  PNT_ = '#39'05'#39';'
      
        '110124549=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110124550=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110124551=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110124552=      ELSE'
      '110124553=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110124554='
      
        '110124555=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110124556=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110124557=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110124558=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110124559=                                        :SUMM_FACT_,'
      
        '110124560=                                        :DATE_RECEIPT_' +
        ','
      
        '110124561=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110124562=                                        NULL,   --ZAKA' +
        'Z_'
      '110124563=                                        :SKLAD_,'
      
        '110124564=                                        :G_PAYMENT_TYP' +
        'E_,'
      
        '110124565=                                        :G_TOCHKA_) RE' +
        'TURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110124566=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110124567=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110124568=            EXIT;'
      '110124569=          END'
      '110124570=      END ELSE BEGIN'
      '110124571=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110124572=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110124573=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110124574=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110124575=            ELSE'
      
        '110124576=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110124577='
      '110124578=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110124579=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110124580='
      
        '110124581=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110124582='
      '110124583=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110124584=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110124585=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110124586=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110124587=                                              :PAYMENT' +
        '_DATE_,'
      
        '110124588=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110124589=                                              NULL,   ' +
        '--ZAKAZ_'
      '110124590=                                              :SKLAD_,'
      
        '110124591=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110124592=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110124593=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110124594=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110124595=                  EXIT;'
      '110124596=                END'
      '110124597=            END'
      '110124598=          END'
      '110124599=      END'
      '110124600=  END'
      '110124601='
      '110124602=  DELETE FROM SKLAD_TMP;'
      '110124603='
      
        '110124604=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110124605=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110124606=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110124607=                                  G_PRIHOD_,'
      '110124608=                                  :SUMM_PRIHOD_,'
      '110124609=                                  :DATE_RECEIPT_,'
      
        '110124610=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110124611=                                  NULL,   --:ZAKAZ_,'
      '110124612=                                  :SKLAD_,'
      '110124613=                                  :G_PAYMENT_TYPE_,'
      
        '110124614=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110124615=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110124616=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110124617=      EXIT;'
      '110124618=    END'
      '110124619=  END'
      '110124620='
      '110124621=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110124622=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THEN'
      
        '110124623=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER)'
      
        '110124624=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_, 1' +
        ');'
      '110124625=end'
      '110124626=;'
      '110124627='
      '110124628=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD('
      '110124629=  OBJECT_TYPE_ INTEGER)'
      '110124630=RETURNS ('
      '110124631=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '110124632=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110124633=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110124634=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110124635=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110124636=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '110124637=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110124638=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110124639=  SUMM_SERT MY_NUMERIC,'
      '110124640=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110124641=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110124642=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110124643=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110124644=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110124645=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110124646=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110124647=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_AP' +
        'P)'
      '110124648=AS'
      '110124649=/*'
      '110124650=*/'
      '110124651=BEGIN'
      '110124652=  FOR  SELECT S.OPER'
      '110124653=              ,Z.ZAKAZ'
      '110124654=              ,Z.Z_DATE'
      '110124655=              ,Z.Z_TIME'
      '110124656=              ,C.NAME CLIENT_NAME'
      '110124657=              ,G.NAME SKLAD_NAME'
      '110124658=              ,Z.SUMM_CASH'
      '110124659=              ,Z.SUMM_NONCASH'
      '110124660=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110124661=              ,P.ARTICUL'
      '110124662=              ,P.BARCODE'
      '110124663=              ,P.NOMENCLATUR_NUM'
      '110124664=              ,P.NAME'
      '110124665=              ,ZD.AMOUNT'
      '110124666=              ,ZD.PRICE - ZD.DISCOUNT_TENGE PRICE'
      '110124667=              ,ZD.SUMM'
      '110124668=              ,S.SYNC_EXT_APP'
      '110124669=         FROM SYNC_EXT_APP S'
      '110124670=              ,ZAKAZ Z'
      '110124671=              ,ZAKAZ_DETAILS ZD'
      '110124672=              ,G_TOCHKA G'
      '110124673=              ,G_CLIENT C'
      '110124674=              ,G_PRODUCT P'
      '110124675=        WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110124676=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110124677=          AND S.ID = Z.ZAKAZ'
      '110124678=          AND Z.ZAKAZ = ZD.ZAKAZ'
      '110124679=          AND Z.G_TOCHKA = G.G_TOCHKA'
      '110124680=          AND Z.G_CLIENT = C.G_CLIENT'
      '110124681=          AND ZD.G_PRODUCT = P.G_PRODUCT'
      '110124682=        UNION ALL'
      '110124683=        SELECT S.OPER'
      '110124684=               ,S.ID'
      '110124685=               ,NULL Z_DATE'
      '110124686=               ,NULL Z_TIME'
      '110124687=               ,NULL CLIENT_NAME'
      '110124688=               ,NULL SKLAD_NAME'
      '110124689=               ,0 SUMM_CASH'
      '110124690=               ,0 SUMM_NONCASH'
      '110124691=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110124692=               ,NULL ARTICUL'
      '110124693=               ,NULL BARCODE'
      '110124694=               ,NULL NOMENCLATUR_NUM'
      '110124695=               ,NULL'
      '110124696=               ,0 AMOUNT'
      '110124697=               ,0 PRICE'
      '110124698=               ,0 SUMM'
      '110124699=               ,S.SYNC_EXT_APP'
      '110124700=          FROM SYNC_EXT_APP S'
      '110124701=         WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110124702=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110124703=        UNION ALL'
      '110124704=        SELECT S.OPER'
      '110124705=              ,Z.SKLAD ZAKAZ'
      '110124706=              ,Z.DATE_RECEIPT Z_DATE'
      '110124707=              ,NULL Z_TIME'
      '110124708=              ,C.NAME CLIENT_NAME'
      '110124709=              ,G.NAME SKLAD_NAME'
      
        '110124710=              ,(SELECT SUM(KS.SUMM) FROM KASSA KS WHER' +
        'E KS.SKLAD = Z.SKLAD) SUMM_CASH'
      
        '110124711=              ,(SELECT SUM(KS.SUMM) FROM KASSA_BEZNAL ' +
        'KS WHERE KS.SKLAD = Z.SKLAD) SUMM_NONCASH'
      '110124712=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110124713=              ,P.ARTICUL'
      '110124714=              ,P.BARCODE'
      '110124715=              ,P.NOMENCLATUR_NUM'
      '110124716=              ,P.NAME'
      '110124717=              ,ZD.AMOUNT'
      '110124718=              ,ZD.PRICE'
      '110124719=              ,ZD.SUMM'
      '110124720=              ,S.SYNC_EXT_APP'
      '110124721=         FROM SYNC_EXT_APP S'
      '110124722=              ,SKLAD_PARENT Z'
      '110124723=              ,SKLAD ZD'
      '110124724=              ,G_TOCHKA G'
      '110124725=              ,G_CLIENT C'
      '110124726=              ,G_PRODUCT P'
      '110124727=        WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110124728=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110124729=          AND S.ID = Z.SKLAD'
      '110124730=          AND Z.SKLAD = ZD.SKLAD_PARENT'
      '110124731=          AND Z.G_TOCHKA = G.G_TOCHKA'
      '110124732=          AND Z.G_CLIENT = C.G_CLIENT'
      '110124733=          AND ZD.G_PRODUCT = P.G_PRODUCT'
      '110124734=        UNION ALL'
      '110124735=        SELECT S.OPER'
      '110124736=               ,S.ID'
      '110124737=               ,NULL Z_DATE'
      '110124738=               ,NULL Z_TIME'
      '110124739=               ,NULL CLIENT_NAME'
      '110124740=               ,NULL SKLAD_NAME'
      '110124741=               ,0 SUMM_CASH'
      '110124742=               ,0 SUMM_NONCASH'
      '110124743=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110124744=               ,NULL ARTICUL'
      '110124745=               ,NULL BARCODE'
      '110124746=               ,NULL NOMENCLATUR_NUM'
      '110124747=               ,NULL'
      '110124748=               ,0 AMOUNT'
      '110124749=               ,0 PRICE'
      '110124750=               ,0 SUMM'
      '110124751=               ,S.SYNC_EXT_APP'
      '110124752=          FROM SYNC_EXT_APP S'
      '110124753=         WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110124754=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110124755=        ORDER BY 1, 3, 4, 2, 10'
      '110124756=         INTO :OPER,'
      '110124757=              :ZAKAZ,'
      '110124758=              :Z_DATE,'
      '110124759=              :Z_TIME,'
      '110124760=              :CLIENT_NAME,'
      '110124761=              :SKLAD_NAME,'
      '110124762=              :SUMM_CASH,'
      '110124763=              :SUMM_NONCASH,'
      '110124764=              :SUMM_SERT,'
      '110124765=              :ARTICUL,'
      '110124766=              :BARCODE,'
      '110124767=              :NOMENCLATUR_NUM,'
      '110124768=              :TOVAR_NAME,'
      '110124769=              :AMOUNT,'
      '110124770=              :PRICE,'
      '110124771=              :SUMM,'
      '110124772=              :SYNC_EXT_APP'
      '110124773=  DO'
      '110124774=    SUSPEND;'
      '110124775=END'
      '110124776=;'
      '110124777='
      '110124778=ALTER PROCEDURE UPD_SKLAD('
      '110124779=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110124780=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '110124781=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110124782=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110124783=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110124784=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110124785=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110124786=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110124787=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '110124788=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110124789=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110124790=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110124791=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110124792=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0,'
      '110124793=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110124794=RETURNS ('
      '110124795=  ERR_CODE INTEGER,'
      '110124796=  ERR_MSG VARCHAR(1024))'
      '110124797=AS'
      
        '110124798=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110124799=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110124800=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '110124801=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110124802=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      '110124803=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110124804=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110124805=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLAD' +
        '_PARENT.IS_EXPECTED;'
      
        '110124806=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110124807=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110124808=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110124809=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      '110124810=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110124811=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '110124812=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '110124813=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110124814=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110124815=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN SK' +
        'LAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110124816=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLAD' +
        '.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058 +
        ' */'
      
        '110124817=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110124818=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110124819=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110124820=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110124821=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110124822=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110124823=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110124824=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110124825=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110124826=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110124827=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044#1051 +
        #1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '110124828=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110124829=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110124830=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110124831=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      '110124832=BEGIN'
      '110124833='
      '110124834=  IS_THIS_LAST_ = 0;'
      '110124835='
      '110124836=  SELECT S.G_TOCHKA,'
      '110124837=         S.IS_VOZVRAT,'
      '110124838=         S.G_PAYMENT_TYPE'
      '110124839=         ,S.is_expected'
      '110124840=    FROM SKLAD_parent S'
      '110124841=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '110124842=    INTO :G_TOCHKA_,'
      '110124843=         :IS_VOZVRAT_,'
      '110124844=         :G_PAYMENT_TYPE_OLD_'
      '110124845=         ,:IS_EXPECTED_OLD_;'
      '110124846='
      '110124847=  PNT_ = '#39'00'#39';'
      '110124848=  UPDATE SKLAD_PARENT'
      '110124849=  SET'
      
        '110124850=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEIP' +
        'T),'
      
        '110124851=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEIP' +
        'T),'
      
        '110124852=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYME' +
        'NT_TYPE),'
      '110124853=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110124854=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110124855=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '110124856=   SUMM      = :SUMM_,'
      '110124857=   SUMM_FACT = :SUMM_FACT_,'
      '110124858=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '110124859=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0)  ' +
        '-- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' ' +
        #1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110124860=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '110124861=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '110124862='
      
        '110124863=  ----------------------------------------------------' +
        '---------'
      '110124864=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040
      '110124865=  PNT_ = '#39'02'#39';'
      '110124866=  FOR SELECT SKLAD'
      '110124867=        FROM SKLAD S'
      '110124868=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110124869=         AND NOT EXISTS (SELECT 1'
      '110124870=                           FROM SKLAD_TMP T'
      '110124871=                        WHERE T.SKLAD = S.SKLAD)'
      '110124872=  INTO :SKLAD_'
      '110124873=  DO BEGIN'
      
        '110124874=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_,' +
        ' :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110124875=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110124876=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110124877=      EXIT;'
      '110124878=    END'
      '110124879=  END'
      '110124880='
      
        '110124881=  ----------------------------------------------------' +
        '---------'
      
        '110124882=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044#1054 +
        #1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '110124883=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '110124884=  PNT_ = '#39'03'#39';'
      '110124885=  FOR SELECT S.SKLAD,'
      '110124886=             S.G_PRODUCT,'
      '110124887=             S.AMOUNT,'
      '110124888=             S.PRICE,'
      '110124889=             S.SUMM,'
      '110124890=             S.NDS,'
      '110124891=             S.NDS_SUMM,'
      '110124892=             T.SKLAD,'
      '110124893=             T.AMOUNT,'
      '110124894=             T.IS_LAST,'
      '110124895=             T.DATE_RECEIPT'
      '110124896=             ,S.PRICE_CURRENCY'
      '110124897=             ,S.SUMM_CURRENCY'
      '110124898=             ,S.PRICE_ROZN'
      
        '110124899=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.G' +
        '_PRODUCT = S.G_PRODUCT)'
      
        '110124900=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLAD' +
        ', AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT = ' +
        ':SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '110124901=  INTO :SKLAD_,'
      '110124902=       :G_PRODUCT_,'
      '110124903=       :AMOUNT_,'
      '110124904=       :PRICE_,'
      '110124905=       :SUMM_ONE_,'
      '110124906=       :NDS_,'
      '110124907=       :NDS_SUMM_,'
      '110124908=       :SKLAD_OLD_,'
      '110124909=       :AMOUNT_OLD_,'
      '110124910=       :IS_THIS_LAST_,'
      '110124911=       :DATE_RECEIPT_OLD_'
      '110124912=       ,:PRICE_CURRENCY_'
      '110124913=       ,:SUMM_CURRENCY_TMP_'
      '110124914=       ,:SALE_PRICE_'
      '110124915=       ,:SALE_PRICE_CUR_'
      '110124916=  DO BEGIN'
      
        '110124917=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058#1040 +
        #1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110124918=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '110124919=        PNT_ = '#39'04'#39';'
      
        '110124920=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_R' +
        'ECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYPE' +
        ', NDS, NDS_SUMM,'
      
        '110124921=                          IS_LAST, NOTE, OSNOVANIE, IS' +
        '_VOZVRAT, G_TOCHKA'
      '110124922=                          ,PRICE_CURRENCY'
      '110124923=                          ,SUMM_CURRENCY)'
      
        '110124924=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIPT' +
        '_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_PA' +
        'YMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
