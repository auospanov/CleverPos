        '                    ****/'
      
        '11016539=/******************************************************' +
        '************************/'
      '11016540=ALTER PROCEDURE G_GET_DCARD_BY_CODE('
      
        '11016541=  G_DISCONT_CARD_ TYPE OF COLUMN G_DISCONT_CARD.G_DISCO' +
        'NT_CARD,'
      '11016542=  CARD_CODE_ VARCHAR(13))'
      '11016543=RETURNS ('
      '11016544=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11016545=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11016546=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '11016547=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '11016548=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '11016549=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '11016550=  LAST_PURCHASE_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11016551=  ERR_CODE INTEGER,'
      '11016552=  ERR_MSG VARCHAR(1024))'
      '11016553=AS'
      '11016554=/**/'
      
        '11016555=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'G_GET_DCARD_BY' +
        '_CODE'#39';'
      '11016556=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11016557=BEGIN'
      '11016558=  SELECT'
      '11016559=    C.G_CLIENT,'
      '11016560=    C.NAME,'
      '11016561=    D.BARCODE,'
      '11016562=    D.N_PERCENT,'
      '11016563=    D.SUMM,'
      '11016564=    D.SUMM_ALL'
      '11016565=  FROM G_DISCONT_CARD D, G_CLIENT C'
      '11016566=  WHERE ('
      
        '11016567=            ((BARCODE = :CARD_CODE_ AND CHAR_LENGTH(:CA' +
        'RD_CODE_) > 0)  -- '#1063#1058#1054#1041#1067' '#1057#1058#1056#1054#1050#1048' '#1053#1045' '#1053#1040#1061#1054#1044#1048#1051#1048#1057#1068' '#1055#1054' '#1055#1059#1057#1058#1054#1058#1045
      '11016568=             OR'
      
        '11016569=             (C.PHONE LIKE '#39'%'#39'||:CARD_CODE_||'#39'%'#39' AND CH' +
        'AR_LENGTH(:CARD_CODE_) > 0)'
      '11016570=             )'
      
        '11016571=         or (D.G_DISCONT_CARD = COALESCE(:G_DISCONT_CAR' +
        'D_, 0))'
      '11016572=        )'
      '11016573=    AND D.G_CLIENT = C.G_CLIENT'
      '11016574=  INTO'
      '11016575=    :G_CLIENT_,'
      '11016576=    :CLIENT_NAME_,'
      '11016577=    :BARCODE_,'
      '11016578=    :N_PERCENT_,'
      '11016579=    :SUMM_,'
      '11016580=    :SUMM_ALL_;'
      '11016581='
      '11016582=    SELECT MAX(Z.Z_DATE)'
      '11016583=      FROM ZAKAZ Z'
      '11016584=     WHERE Z.G_CLIENT = :G_CLIENT_'
      '11016585=     INTO :LAST_PURCHASE_DATE_;'
      '11016586=END'
      '11016587=;'
      '11016588='
      '11016589=ALTER PROCEDURE G_GET_G_CLIENT('
      '11016590=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT)'
      '11016591=RETURNS ('
      
        '11016592=  G_CLIENT_PARENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAR' +
        'ENT,'
      
        '11016593=  G_CONTRAGENT_ TYPE OF COLUMN G_CONTRAGENT.G_CONTRAGEN' +
        'T,'
      '11016594=  NAME_ VARCHAR(500),'
      '11016595=  NAME_FULL_ TYPE OF COLUMN G_CLIENT.NAME_FULL,'
      '11016596=  IDN_ VARCHAR(12),'
      '11016597=  PHONE_ TYPE OF COLUMN G_CLIENT.PHONE,'
      '11016598=  KBE_ VARCHAR(5),'
      '11016599=  SKIDKA_ NUMERIC(15,2),'
      '110165100=  BY_DEFAULT_ INTEGER,'
      '110165101=  IS_BEZNAL_ INTEGER,'
      '110165102=  BARCODE_ TYPE OF COLUMN G_DISCONT_CARD.BARCODE,'
      '110165103=  N_PERCENT_ TYPE OF COLUMN G_DISCONT_CARD.N_PERCENT,'
      '110165104=  SUMM_ TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110165105=  SUMM_ALL_ TYPE OF COLUMN G_DISCONT_CARD.SUMM_ALL,'
      '110165106=  NOTE_ TYPE OF COLUMN G_CLIENT.NOTE,'
      '110165107=  DT_ TYPE OF COLUMN G_CLIENT.DT,'
      '110165108=  G_PROMOTION_ TYPE OF COLUMN G_PROMOTION.G_PROMOTION,'
      '110165109=  G_PROMOTION_STR_ TYPE OF COLUMN G_PROMOTION.NAME,'
      '110165110=  NOTIFY_SKIDKA_ INTEGER,'
      '110165111=  NOTIFY_DR_ INTEGER,'
      '110165112=  G_CLIENT_PROMO_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110165113=  FM_PROMO_ VARCHAR(50),'
      
        '110165114=  MAX_BONUS_PAY_SUMM_ TYPE OF COLUMN G_CLIENT.MAX_BONU' +
        'S_PAY_SUMM,'
      '110165115=  LAST_PURCHASE_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110165116=  ERR_CODE INTEGER,'
      '110165117=  ERR_MSG VARCHAR(1024))'
      '110165118=AS'
      '110165119=/**/'
      '110165120=begin'
      '110165121=    SELECT'
      
        '110165122=      G_CLIENT_PARENT, G_CONTRAGENT, T.NAME, IDN, KBE,' +
        ' SKIDKA, BY_DEFAULT, IS_BEZNAL, PHONE, NOTE, DT, NAME_FULL'
      '110165123=      ,P.G_PROMOTION'
      '110165124=      ,P.NAME'
      '110165125=      ,notify_dr'
      '110165126=      ,notify_skidka'
      '110165127=      ,MAX_BONUS_PAY_SUMM'
      
        '110165128=    FROM G_CLIENT T LEFT OUTER JOIN g_promotion P ON T' +
        '.g_promotion = P.g_promotion'
      '110165129=    WHERE T.G_CLIENT = :G_CLIENT_'
      '110165130=    INTO'
      
        '110165131=      :G_CLIENT_PARENT_, :G_CONTRAGENT_, :NAME_, :IDN_' +
        ', :KBE_, :SKIDKA_, :BY_DEFAULT_, IS_BEZNAL_, :PHONE_, :NOTE_, :D' +
        'T_, :NAME_FULL_'
      '110165132=      ,:G_PROMOTION_'
      '110165133=      ,:G_PROMOTION_STR_'
      '110165134=      ,:NOTIFY_DR_'
      '110165135=      ,:NOTIFY_SKIDKA_'
      '110165136=      ,:MAX_BONUS_PAY_SUMM_'
      '110165137=      ;'
      '110165138='
      '110165139=    SELECT MAX(Z.Z_DATE)'
      '110165140=      FROM ZAKAZ Z'
      '110165141=     WHERE Z.G_CLIENT = :G_CLIENT_'
      '110165142=     INTO :LAST_PURCHASE_DATE_;'
      '110165143='
      '110165144=    SELECT BARCODE, N_PERCENT, SUMM, SUMM_ALL'
      '110165145=    FROM G_DISCONT_CARD'
      '110165146=    WHERE G_CLIENT = :G_CLIENT_'
      '110165147=    INTO :BARCODE_, :N_PERCENT_, :SUMM_, :SUMM_ALL_;'
      '110165148=end'
      '110165149=;'
      '110165150='
      '110165151='
      
