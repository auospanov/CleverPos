        'NT_,'
      
        '1101241232=                                          :G_PAYMENT_' +
        'TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101241233=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101241234=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101241235=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1101241236=                                          :G_PRIHOD_,'
      
        '1101241237=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101241238=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101241239=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1101241240=                                          NULL,'
      
        '1101241241=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101241242=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101241243=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101241244=      END'
      '1101241245=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241246=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
