      '11024156='
      '11024157='
      
        '11024158=/******************************************************' +
        '************************/'
      
        '11024159=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11024160=/******************************************************' +
        '************************/'
      '11024161='
      '11024162=ALTER PROCEDURE G_RECALC_G_PRODUCT_AMOUNT'
      '11024163=RETURNS ('
      '11024164=  ERR_CODE INTEGER,'
      '11024165=  ERR_MSG VARCHAR(1024))'
      '11024166=AS'
      '11024167=/*'
      
        '11024168='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1045#1051#1040#1045#1058' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1042#1057#1045#1061' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052 +
        ', '#1055#1054' '#1050#1054#1058#1054#1056#1067#1052' '#1054#1057#1058#1040#1058#1050#1048' '#1050#1056#1048#1042#1067#1045
      '11024169=*/'
      
        '11024170=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'G_RECALC_G_PR' +
        'ODUCT_AMOUNT'#39';'
      
        '11024171=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11024172=BEGIN'
      '11024173='
      '11024174=  FOR SELECT G_TOCHKA'
      '11024175=        FROM G_TOCHKA'
      '11024176=        INTO :G_TOCHKA_'
      '11024177=  DO BEGIN'
      '11024178=    update LT_SKLAD_PRODUCT ll'
      '11024179=    set ll.AMOUNT = (select ('
      '11024180=                           -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '11024181=                           (select COALESCE(sum(s.amoun' +
        't), 0) from sklad s, sklad_parent sp'
      
        '11024182=                            where sp.SKLAD = s.SKLAD_PA' +
        'RENT'
      
        '11024183=                              and sp.G_TOCHKA = :G_TOCH' +
        'KA_'
      
        '11024184=                              and s.g_product = LL.G_PR' +
        'ODUCT'
      
        '11024185=                              and sp.IS_EXPECTED = 0)  ' +
        ' -- '#1085#1077' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '11024186='
      '11024187=                           -'
      '11024188=                           -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '11024189=                           (select COALESCE(sum(zr.AMOU' +
        'NT_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '11024190=                            where zr.g_product = LL.G_P' +
        'RODUCT and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '11024191=                            and zr.ZAKAZ_REAL_PARENT = ' +
        'zrp.ZAKAZ_REAL_PARENT)'
      '11024192='
      '11024193=                           -'
      '11024194=                           -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '11024195=                           (select COALESCE(sum(zd.amou' +
        'nt), 0) from zakaz_details zd, zakaz z'
      
        '11024196=                            where zd.g_product = LL.G_P' +
        'RODUCT and Z.G_TOCHKA = :G_TOCHKA_'
      '11024197=                            and zd.zakaz = z.zakaz'
      
        '11024198=                            and z.IS_RESERVE = 0      -' +
        '- '#1085#1077' '#1074#1099#1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100 +
        #1085#1086' '#1087#1086#1081#1076#1077#1090' '#1085#1080#1078#1077
      
        '11024199=                            and z.IS_SPISANIE <> 2   --' +
        ' '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076 +
        #1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110241100=                            and not (z.IS_SPISANIE = 0' +
        ' and z.NOT_MINUS_OSTATOK = 1)'
      '110241101=                           )'
      '110241102='
      '110241103=                           -'
      
        '110241104=                           -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050 +
        #1051#1040#1044
      
        '110241105=                           (select COALESCE(sum(s.amou' +
        'nt), 0) from sklad s where s.g_product = LL.G_PRODUCT and s.is_v' +
        'ozvrat = 3'
      
        '110241106=                            and S.g_client = :G_TOCHKA' +
        '_)'
      '110241107='
      '110241108=                           -'
      '110241109=                           -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '110241110=                           (select COALESCE(sum(od.amo' +
        'unt), 0) from other_details od, other o'
      
        '110241111=                            where od.g_product = LL.G_' +
        'PRODUCT and o.G_TOCHKA = :G_TOCHKA_'
      '110241112=                            and od.other = o.other)'
      '110241113=                       )'
      '110241114=                 from rdb$database'
      '110241115=                ),'
      
        '110241116=        ll.AMOUNT_RESERVE = (SELECT COALESCE(sum(ZD.am' +
        'ount), 0) FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '110241117=                         WHERE Z.G_TOCHKA = :G_TOCHKA_' +
        ' AND Z.IS_RESERVE = 1'
      
        '110241118=                           AND Z.ZAKAZ = ZD.ZAKAZ AND ' +
        'ZD.G_PRODUCT = LL.G_PRODUCT)'
      '110241119=where LL.G_TOCHKA = :G_TOCHKA_'
      '110241120=AND ll.AMOUNT <> (select ('
      '110241121=                               -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '110241122=                               (select COALESCE(sum(s.' +
        'amount), 0) from sklad s, sklad_parent sp'
      
        '110241123=                                where sp.SKLAD = s.SKL' +
        'AD_PARENT'
      
        '110241124=                                  and sp.G_TOCHKA = :G' +
        '_TOCHKA_'
      
        '110241125=                                  and s.g_product = LL' +
        '.G_PRODUCT'
      
        '110241126=                                  and sp.IS_EXPECTED =' +
        ' 0)   -- '#1085#1077' '#1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '110241127='
      '110241128=                               -'
      
        '110241129=                               -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048 +
        #1070
      
        '110241130=                               (select COALESCE(sum(zr' +
        '.AMOUNT_ALL), 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110241131=                                where zr.g_product = L' +
        'L.G_PRODUCT and Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '110241132=                                and zr.ZAKAZ_REAL_PARE' +
        'NT = zrp.ZAKAZ_REAL_PARENT)'
      '110241133='
      '110241134=                               -'
      '110241135=                               -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '110241136=                               (select COALESCE(sum(zd' +
        '.amount), 0) from zakaz_details zd, zakaz z'
      
        '110241137=                                where zd.g_product = L' +
        'L.G_PRODUCT and Z.G_TOCHKA = :G_TOCHKA_'
      '110241138=                                and zd.zakaz = z.zakaz'
      
        '110241139=                                and z.IS_RESERVE = 0  ' +
        '    -- '#1085#1077' '#1074#1099#1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086 +
        #1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076#1077#1090' '#1085#1080#1078#1077
      
        '110241140=                                and z.IS_SPISANIE <> 2' +
        '   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072 +
        ' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110241141=                                and not (z.IS_SPISANIE' +
        ' = 0 and z.NOT_MINUS_OSTATOK = 1)'
      '110241142=                               )'
      '110241143='
      '110241144=                               -'
      
        '110241145=                               -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054 +
        #1049' '#1057#1050#1051#1040#1044
      
        '110241146=                               (select COALESCE(sum(s.' +
        'amount), 0) from sklad s where s.g_product = LL.G_PRODUCT and s.' +
        'is_vozvrat = 3'
      
        '110241147=                                and S.g_client = :G_TO' +
        'CHKA_)'
      '110241148='
      '110241149=                               -'
      '110241150=                               -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '110241151=                               (select COALESCE(sum(od' +
        '.amount), 0) from other_details od, other o'
      
        '110241152=                                where od.g_product = L' +
        'L.G_PRODUCT and o.G_TOCHKA = :G_TOCHKA_'
      
        '110241153=                                and od.other = o.other' +
        ')'
      '110241154=                           )'
      '110241155=                     from rdb$database);'
      '110241156=  END'
      '110241157='
      '110241158=WHEN ANY DO BEGIN'
      '110241159=    Err_code = -20500;'
      
        '110241160=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1056#1045#1057#1063#1045#1058#1045' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1058#1054#1042#1040#1056#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      '110241161=    ERR_MSG = PROCNAME||'#39' '#39'||ERR_MSG;'
      '110241162=  END'
      '110241163=END'
      '110241164=;'
      '110241165='
      '110241166=ALTER PROCEDURE K_RECALC_KASSA_BY_DATE('
      '110241167=  ACTION_DATE_ DATE,'
      '110241168=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110241169=RETURNS ('
      '110241170=  ERR_CODE INTEGER,'
      '110241171=  ERR_MSG VARCHAR(1024))'
      '110241172=AS'
      
        '110241173=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'K_RECALC_KASS' +
        'A_BY_DATE'#39';'
      '110241174=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110241175=DECLARE VARIABLE CREDIT_ TYPE OF COLUMN KASSA_STATE.CR' +
        'EDIT;'
      
        '110241176=DECLARE VARIABLE DEBET_ TYPE OF COLUMN KASSA_STATE.DEB' +
        'ET;'
      
        '110241177=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110241178=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      '110241179=BEGIN'
      '110241180='
      '110241181=  ERR_CODE = 0;'
      '110241182=  ERR_MSG = '#39#39';'
      '110241183='
      '110241184=  PNT_ = '#39'01'#39';'
      '110241185=  FOR SELECT G_TOCHKA'
      '110241186=        FROM G_TOCHKA'
      '110241187=        INTO :G_TOCHKA_'
      '110241188=  DO BEGIN'
      
        '110241189=      EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_, ' +
        ':G_TOCHKA_, :UPLOAD_TO_EXT_APP_)'
      '110241190=          RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110241191='
      '110241192=      IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110241193=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39'. G_TO' +
        'CHKA '#39'||G_TOCHKA_|| '#39'. '#39' ||ERR_MSG;'
      '110241194=        EXIT;'
      '110241195=      END'
      '110241196=  END'
      '110241197='
      
        '110241198=  EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL(:ACTION_DATE' +
        '_)'
      '110241199=      RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110241200='
      '110241201=  IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110241202=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110241203=    EXIT;'
      '110241204=  END'
      '110241205='
      '110241206=  --=============================================='
      '110241207=  -- '#1055#1045#1056#1045#1057#1063#1045#1058' '#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067
      '110241208=  --=============================================='
      '110241209=  /*PNT_ = '#39'00'#39';'
      '110241210=  FOR SELECT G_TOCHKA'
      '110241211=        FROM G_TOCHKA'
      '110241212=        INTO :G_TOCHKA_'
      '110241213=  DO BEGIN'
      '110241214=      SELECT SUM(K.SUMM)'
      '110241215=        FROM KASSA K'
      '110241216=       WHERE K."ACTION" = 0'
      '110241217=         AND K.ACTION_DATE = :ACTION_DATE_'
      '110241218=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110241219=        INTO :CREDIT_;'
      '110241220=      CREDIT_ = COALESCE(CREDIT_, 0);'
      '110241221='
      '110241222=      PNT_ = '#39'01'#39';'
      '110241223=      SELECT SUM(K.SUMM)'
      '110241224=        FROM KASSA K'
      '110241225=       WHERE K."ACTION" = 1'
      '110241226=         AND K.ACTION_DATE = :ACTION_DATE_'
      '110241227=         AND K.G_TOCHKA = :G_TOCHKA_'
      '110241228=        INTO :DEBET_;'
      '110241229=      DEBET_ = COALESCE(DEBET_, 0);'
      '110241230='
      '110241231=      PNT_ = '#39'02'#39';'
      '110241232=      BEGIN'
      '110241233=            MERGE INTO KASSA_STATE c'
      
        '110241234=            USING (SELECT :ACTION_DATE_ AS K_DATE, :G_' +
        'TOCHKA_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_D' +
        'ATE AND C.G_TOCHKA = CD.G_TOCHKA)'
      '110241235=            WHEN MATCHED THEN'
      '110241236=                UPDATE SET'
      '110241237=                    C.DEBET  = :DEBET_,'
      '110241238=                    C.CREDIT = :CREDIT_,'
      
        '110241239=                    C."OUTPUT" = C."INPUT" - :DEBET_ +' +
        ' :CREDIT_,'
      
        '110241240=                    C.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '110241241=            WHEN NOT MATCHED THEN'
      
        '110241242=                INSERT (KASSA_STATE, K_DATE, "INPUT", ' +
        'DEBET, CREDIT, "OUTPUT", G_TOCHKA, NEED_TO_EXPORT)'
      '110241243=                VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110241244=                        :ACTION_DATE_,'
      
        '110241245=                        COALESCE((SELECT "OUTPUT" FROM' +
        ' KASSA_STATE'
      
        '110241246=                                  WHERE K_DATE = (SELE' +
        'CT MAX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G' +
        '_TOCHKA = CD.G_TOCHKA)'
      
        '110241247=                                    AND G_TOCHKA = CD.' +
        'G_TOCHKA), 0),'
      '110241248=                        :DEBET_,'
      '110241249=                        :CREDIT_,'
      
        '110241250=                        COALESCE((SELECT "OUTPUT" FROM' +
        ' KASSA_STATE'
      
        '110241251=                                  WHERE K_DATE = (SELE' +
        'CT MAX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G' +
        '_TOCHKA = CD.G_TOCHKA)'
      
        '110241252=                                    AND G_TOCHKA = CD.' +
        'G_TOCHKA), 0) - :DEBET_ + :CREDIT_,'
      '110241253=                       :G_TOCHKA_,'
      '110241254=                       :UPLOAD_TO_EXT_APP_);'
      '110241255=      WHEN ANY DO'
      '110241256=          BEGIN'
      '110241257=              ERR_CODE = GDSCODE;'
      
        '110241258=              EXECUTE PROCEDURE GET_ERR_MSG(GDSCODE, '#39 +
        #1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1085#1072#1083#1080#1095#1085#1086#1081' '#1082#1072#1089#1089#1099'. '#39' || sqlcode) RETURNING_VAL' +
        'UES (:ERR_MSG);'
      
        '110241259=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39 +
        ' '#39'||ERR_MSG;'
      '110241260=              EXIT;'
      '110241261=          END'
      '110241262=      END'
      '110241263=  END'
      '110241264='
      '110241265=  --=============================================='
      '110241266=  -- '#1055#1045#1056#1045#1057#1063#1045#1058' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067
      '110241267=  --=============================================='
      '110241268=  PNT_ = '#39'03'#39';'
      '110241269=  SELECT SUM(K.SUMM)'
      '110241270=    FROM KASSA_BEZNAL K'
      '110241271=   WHERE K."ACTION" = 0'
      '110241272=     AND K.ACTION_DATE = :ACTION_DATE_'
      '110241273=    INTO :CREDIT_;'
      '110241274=  CREDIT_ = COALESCE(CREDIT_, 0);'
      '110241275='
      '110241276=  PNT_ = '#39'04'#39';'
      '110241277=  SELECT SUM(K.SUMM)'
      '110241278=    FROM KASSA_BEZNAL K'
      '110241279=   WHERE K."ACTION" = 1'
      '110241280=     AND K.ACTION_DATE = :ACTION_DATE_'
      '110241281=    INTO :DEBET_;'
      '110241282=  DEBET_ = COALESCE(DEBET_, 0);'
      '110241283='
      '110241284=  PNT_ = '#39'05'#39';'
      '110241285=  BEGIN'
      '110241286=      MERGE INTO KASSA_BEZNAL_STATE c'
      
        '110241287=      USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCHKA' +
        '_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE)'
      '110241288=      WHEN MATCHED THEN'
      '110241289=          UPDATE SET'
      '110241290=              C.DEBET  = :DEBET_,'
      '110241291=              C.CREDIT = :CREDIT_,'
      
        '110241292=              C."OUTPUT" = C."INPUT" - :DEBET_ + :CRED' +
        'IT_'
      '110241293=      WHEN NOT MATCHED THEN'
      
        '110241294=          INSERT (KASSA_BEZNAL_STATE, K_DATE, "INPUT",' +
        ' DEBET, CREDIT, "OUTPUT")'
      '110241295=          VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110241296=                  :ACTION_DATE_,'
      
        '110241297=                  COALESCE((SELECT "OUTPUT" FROM KASSA' +
        '_STATE'
      
        '110241298=                            WHERE K_DATE = (SELECT MAX' +
        '(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHK' +
        'A = CD.G_TOCHKA)'
      
        '110241299=                              AND G_TOCHKA = CD.G_TOCH' +
        'KA), 0),'
      '110241300=                  :DEBET_,'
      '110241301=                  :CREDIT_,'
      
        '110241302=                  COALESCE((SELECT "OUTPUT" FROM KASSA' +
        '_STATE'
      
        '110241303=                            WHERE K_DATE = (SELECT MAX' +
        '(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOCHK' +
        'A = CD.G_TOCHKA)'
      
        '110241304=                              AND G_TOCHKA = CD.G_TOCH' +
        'KA), 0) - :DEBET_ + :CREDIT_);'
      '110241305=  WHEN ANY DO'
      '110241306=      BEGIN'
      '110241307=          ERR_CODE = GDSCODE;'
      
        '110241308=          EXECUTE PROCEDURE GET_ERR_MSG(GDSCODE, '#39#1054#1096#1080#1073 +
        #1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1073#1077#1079#1085#1072#1083#1080#1095#1085#1086#1081' '#1082#1072#1089#1089#1099'. '#39' || sqlcode) RETURNING_VALU' +
        'ES (:ERR_MSG);'
      
        '110241309=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110241310=          EXIT;'
      '110241311=      END'
      '110241312=  END*/'
      '110241313='
      '110241314=WHEN ANY DO BEGIN'
      '110241315=    ERR_CODE = sqlcode;'
      
        '110241316=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1096#1080#1073#1082#1080' '#1087#1088 +
        #1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1082#1072#1089#1089#1099' '#39' || GDSCODE) RETURNING_VALUES (:ERR_MSG);'
      
        '110241317=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110241318=  END'
      '110241319=end'
      '110241320=;'
      '110241321='
      '110241322=ALTER PROCEDURE SYNC_DOWNLOAD('
      '110241323=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110241324=RETURNS ('
      '110241325=  ERR_CODE INTEGER,'
      '110241326=  ERR_MSG VARCHAR(1024),'
      '110241327=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '110241328=AS'
      '110241329=/*'
      '110241330='#1060#1048#1053#1040#1051' 07.02.2019'
      '110241331=*/'
      
        '110241332=DECLARE VARIABLE SQL_ TYPE OF COLUMN LOGS.SQLSTMT; /* ' +
        'VARCHAR(30000); */'
      
        '110241333=DECLARE VARIABLE SQL_UPD_ TYPE OF COLUMN LOGS.SQLSTMT;' +
        ' /* VARCHAR(30000); */'
      '110241334=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '110241335=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '110241336=DECLARE VARIABLE POS_ INTEGER = 0;'
      '110241337=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '110241338=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110241339=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '110241340=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGME' +
        'NT SIZE 80 = '#39#39';'
      
        '110241341=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110241342=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110241343=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      
        '110241344=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT;'
      
        '110241345=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT_RESERVE;'
      
        '110241346=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110241347=DECLARE VARIABLE ACTION_DATE_MIN_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE = CURRENT_DATE;'
      
        '110241348=DECLARE VARIABLE ACTION_DATE_MIN_OLD_ TYPE OF COLUMN K' +
        'ASSA.ACTION_DATE = CURRENT_DATE;'
      
        '110241349=DECLARE VARIABLE CREDIT_ TYPE OF COLUMN KASSA_STATE.CR' +
        'EDIT;'
      
        '110241350=DECLARE VARIABLE DEBET_ TYPE OF COLUMN KASSA_STATE.DEB' +
        'ET;'
      '110241351=DECLARE VARIABLE RECALC_STR_ VARCHAR(1024) = '#39#39';'
      '110241352=DECLARE VARIABLE STR_ VARCHAR(1024);'
      '110241353=DECLARE VARIABLE TABLE_ TYPE OF COLUMN LOGS.TTABLE;'
      '110241354=DECLARE VARIABLE TABLE_INT_ INTEGER;'
      '110241355=DECLARE VARIABLE OPER_ INTEGER;'
      '110241356=DECLARE VARIABLE PNT_ VARCHAR(10);'
      '110241357=BEGIN'
      '110241358=  ERR_CODE = 0;'
      '110241359=  ERR_MSG = '#39#39';'
      '110241360=  ERR_BODY = '#39#39';'
      '110241361='
      '110241362=  FOR SELECT L.ID,'
      '110241363=             L.SQLSTMT,'
      '110241364=             L.TTABLE'
      '110241365=        FROM LOGS L'
      '110241366=       WHERE L.USR = '#39'REPLICAT'#39
      '110241367=         AND L.DAT IS NULL'
      '110241368=         AND L.IS_TRANSFERED = 0'
      
        '110241369=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        ') = 0'
      '110241370=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) = 0'
      
        '110241371=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) = ' +
        '0'
      
        '110241372=         AND POSITION('#39'EXECUTE PROCEDURE K_RECALC_KASS' +
        'A'#39' IN L.SQLSTMT) = 0'
      '110241373=        ORDER BY L.ID_ORIGINAL'
      '110241374=        INTO :LOGS_ID_,'
      '110241375=             :SQL_,'
      '110241376=             :TABLE_'
      '110241377=  DO BEGIN'
      '110241378=    BEGIN'
      '110241379=        SQLCODE_ = 0;'
      '110241380='
      '110241381=        EXECUTE STATEMENT SQL_;'
      '110241382='
      
        '110241383=        /*IF (UPLOAD_TO_EXT_APP_ = 1 AND TABLE_ IN ('#39'G' +
        '_PRODUCT'#39', '#39'ZAKAZ'#39', '#39'SKLAD_PARENT'#39', '#39'G_TOCHKA'#39')) THEN BEGIN'
      '110241384=           IF (TABLE_ = '#39'ZAKAZ'#39') THEN'
      '110241385=             TABLE_INT_ = 1;'
      '110241386=           ELSE IF (TABLE_ = '#39'SKLAD_PARENT'#39') THEN'
      '110241387=             TABLE_INT_ = 2;'
      '110241388=           ELSE IF (TABLE_ = '#39'G_TOCHKA'#39') THEN'
      '110241389=             TABLE_INT_ = 3;'
      '110241390=           ELSE IF (TABLE_ = '#39'G_PRODUCT'#39') THEN'
      '110241391=             TABLE_INT_ = 4;'
      '110241392='
      '110241393=           IF (POSITION('#39'INSERT'#39' IN SQL_) > 0) THEN'
      '110241394=             OPER_ = 1;'
      
        '110241395=           ELSE IF (POSITION('#39'UPDATE'#39' IN SQL_) > 0) TH' +
        'EN'
      '110241396=             OPER_ = 2;'
      
        '110241397=           ELSE IF (POSITION('#39'DELETE'#39' IN SQL_) > 0) TH' +
        'EN'
      '110241398=             OPER_ = 3;'
      '110241399='
      
        '110241400=           INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJ' +
        'ECT_TYPE, ID, OPER)'
      
        '110241401=             VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), :TAB' +
        'LE_INT_, 111, :OPER_);'
      '110241402=        END*/'
      '110241403='
      '110241404=    WHEN ANY DO'
      '110241405=        BEGIN'
      '110241406=            SQLCODE_ = GDSCODE;'
      '110241407=            IF (ERR_BODY = '#39#39') THEN'
      
        '110241408=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085#1080 +
        #1081'.'#39';'
      '110241409=            ERR_BODY = ERR_BODY ||'#39
      
        '110241410=ID_ '#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE || '#39'. SQL '#39'||SQL_||' +
        #39'.'#39';'
      '110241411=        END'
      '110241412=    END'
      '110241413='
      
        '110241414=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110241415=    UPDATE LOGS L'
      
        '110241416=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110241417=           L.ERR_CODE = :SQLCODE_'
      '110241418=     WHERE L.ID = :LOGS_ID_;'
      '110241419=  END'
      '110241420='
      '110241421=  POS_ = 0;'
      '110241422=  FOR SELECT L.ID,'
      '110241423=             L.SQLSTMT,'
      '110241424=             L.DAT,'
      '110241425=             L.RR'
      '110241426=        FROM LOGS L'
      '110241427=       WHERE L.USR = '#39'REPLICAT'#39
      '110241428=         AND L.DAT IS NOT NULL'
      '110241429=         AND L.IS_TRANSFERED = 0'
      '110241430=        ORDER BY L.ID_ORIGINAL'
      '110241431=        INTO :LOGS_ID_,'
      '110241432=             :SQL_,'
      '110241433=             :DAT_,'
      '110241434=             :IDX_'
      '110241435=  DO BEGIN'
      '110241436=    POS_ = POSITION('#39'.'#39', SQL_);'
      '110241437=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '110241438=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR PO' +
        'S_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_ ' +
        '- 1)||'#39' = :DAT_'#39'||'
      
        '110241439=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ + ' +
        '1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '110241440='
      '110241441=    BEGIN'
      '110241442=        SQLCODE_ = 0;'
      '110241443=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '110241444=    WHEN ANY DO'
      '110241445=        BEGIN'
      '110241446=            SQLCODE_ = GDSCODE;'
      '110241447=            ERR_BODY = ERR_BODY ||'#39
      '110241448='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110241449=        END'
      '110241450=    END'
      '110241451='
      
        '110241452=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110241453='
      '110241454=    UPDATE LOGS L'
      
        '110241455=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110241456=           L.ERR_CODE = :SQLCODE_'
      '110241457=     WHERE L.ID = :LOGS_ID_;'
      '110241458=  END'
      '110241459='
      
        '110241460=  --==================================================' +
        '==================='
      '110241461=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      
        '110241462=  -- '#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054' '#1054#1058#1044#1045#1051 +
        #1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048#1042' '#1057#1054#1041#1048#1056#1040#1058#1068'?'
      
        '110241463=  --==================================================' +
        '==================='
      '110241464=  FOR SELECT MAX(L.ID) ID,'
      '110241465=             L.SQLSTMT'
      '110241466=        FROM LOGS L'
      '110241467=       WHERE L.USR = '#39'REPLICAT'#39
      '110241468=         AND L.DAT IS NULL'
      '110241469=         AND L.IS_TRANSFERED = 0'
      
        '110241470=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        ') > 0'
      '110241471=       GROUP BY L.SQLSTMT'
      '110241472=        INTO :LOGS_ID_,'
      '110241473=             :SQL_'
      '110241474=  DO BEGIN'
      '110241475=    SQLCODE_ = 0;'
      '110241476=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110241477=    POS1_ = POSITION('#39'-'#39' IN SQL_);'
      '110241478='
      
        '110241479=    G_PRODUCT_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR' +
        ' POS1_ - POS_ - 1) AS BIGINT);'
      
        '110241480=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 FOR' +
        ' CHAR_LENGTH(SQL_)) AS BIGINT);'
      '110241481='
      '110241482=    BEGIN'
      '110241483=        select ('
      '110241484=               -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '110241485=               (select COALESCE(sum(s.amount), 0) from' +
        ' sklad s, sklad_parent sp'
      '110241486=                where sp.SKLAD = s.SKLAD_PARENT'
      '110241487=                  and sp.G_TOCHKA = :G_TOCHKA_'
      '110241488=                  and s.g_product = :G_PRODUCT_'
      
        '110241489=                  and sp.IS_EXPECTED = 0)   -- '#1085#1077' '#1073#1077#1088#1091 +
        ' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '110241490='
      '110241491=               -'
      '110241492=               -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110241493=               (select COALESCE(sum(zr.AMOUNT_ALL), 0)' +
        ' from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110241494=                where zr.g_product = :G_PRODUCT_ and Z' +
        'rp.G_TOCHKA = :G_TOCHKA_'
      
        '110241495=                and zr.ZAKAZ_REAL_PARENT = zrp.ZAKAZ_R' +
        'EAL_PARENT)'
      '110241496='
      '110241497=               -'
      '110241498=               -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '110241499=               (select COALESCE(sum(zd.amount), 0) fro' +
        'm zakaz_details zd, zakaz z'
      
        '110241500=                where zd.g_product = :G_PRODUCT_ and Z' +
        '.G_TOCHKA = :G_TOCHKA_'
      '110241501=                and zd.zakaz = z.zakaz'
      
        '110241502=                and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099#1095#1080#1090#1072 +
        #1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076#1077#1090' '#1085 +
        #1080#1078#1077
      
        '110241503=                and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072 +
        #1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095 +
        #1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110241504=                and not (z.IS_SPISANIE = 0 and z.NOT_M' +
        'INUS_OSTATOK = 1)'
      '110241505=               )'
      '110241506='
      '110241507=               -'
      '110241508=               -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '110241509=               (select COALESCE(sum(s.amount), 0) from' +
        ' sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = 3'
      '110241510=                and S.g_client = :G_TOCHKA_)'
      '110241511='
      '110241512=               -'
      '110241513=               -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '110241514=               (select COALESCE(sum(od.amount), 0) fro' +
        'm other_details od, other o'
      
        '110241515=                where od.g_product = :G_PRODUCT_ and o' +
        '.G_TOCHKA = :G_TOCHKA_'
      '110241516=                and od.other = o.other)'
      '110241517=               ) amount,'
      '110241518='
      
        '110241519=               (SELECT COALESCE(sum(ZD.amount), 0) FRO' +
        'M ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '110241520=                 WHERE Z.G_TOCHKA = :G_TOCHKA_ AND Z.I' +
        'S_RESERVE = 1'
      
        '110241521=                   AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G_PRO' +
        'DUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '110241522=        from rdb$database'
      '110241523=        INTO :AMOUNT_,'
      '110241524=             :AMOUNT_RESERVE_;'
      '110241525='
      '110241526=        MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '110241527=        USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G_TOC' +
        'HKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '110241528=        ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_TOCHK' +
        'A = CD.G_TOCHKA)'
      '110241529=        WHEN MATCHED THEN'
      
        '110241530=            UPDATE SET LT.AMOUNT = :AMOUNT_, LT.AMOUNT' +
        '_RESERVE = :AMOUNT_RESERVE_'
      '110241531=        WHEN NOT MATCHED THEN'
      
        '110241532=            INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, AMOUN' +
        'T, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110241533=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,  1), ' +
        ':G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '110241534=    WHEN ANY DO'
      '110241535=        BEGIN'
      '110241536=            SQLCODE_ = GDSCODE;'
      '110241537=            IF (ERR_BODY = '#39#39') THEN'
      
        '110241538=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086#1074 +
        '.'#39';'
      '110241539=            ERR_BODY = ERR_BODY ||'#39
      
        '110241540=ID_ '#39'||LOGS_ID_||'#39'. SQL_ '#39'||SQL_||'#39'. '#1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||GDS' +
        'CODE;'
      '110241541=        END'
      '110241542=    END'
      '110241543='
      '110241544=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110241545=    UPDATE LOGS L'
      
        '110241546=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110241547=           L.ERR_CODE = :SQLCODE_'
      '110241548=     WHERE L.SQLSTMT = :SQL_'
      '110241549=       AND L.USR = '#39'REPLICAT'#39
      '110241550=       AND L.DAT IS NULL'
      '110241551=       AND L.IS_TRANSFERED = 0;'
      '110241552=  END'
      '110241553='
      
        '110241554=  --==================================================' +
        '==================='
      '110241555=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1050#1040#1057#1057#1067
      
        '110241556=  -- '#1058#1059#1058' '#1053#1045#1052#1053#1054#1043#1054' '#1053#1040#1042#1054#1056#1054#1063#1045#1053#1053#1054' '#1055#1054#1051#1059#1063#1048#1051#1054#1057#1068', '#1052#1040#1057#1057#1048#1042#1054#1042' '#1058#1059#1058' ' +
        #1053#1045#1058', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1057#1053#1054#1042#1040' '#1042#1057#1045' '#1063#1045#1056#1045#1047' G_TOCHKA_OLD '#1044#1045#1051#1040#1058#1068
      
        '110241557=  --==================================================' +
        '==================='
      '110241558=  G_TOCHKA_OLD_ = 0;'
      '110241559=  FOR SELECT L.ID,'
      '110241560=             L.SQLSTMT'
      '110241561=        FROM LOGS L'
      '110241562=       WHERE L.USR = '#39'REPLICAT'#39
      '110241563=         AND L.DAT IS NULL'
      '110241564=         AND L.IS_TRANSFERED = 0'
      '110241565=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT) > 0'
      '110241566=     ORDER BY L.SQLSTMT'
      '110241567=        INTO :LOGS_ID_,'
      '110241568=             :SQL_'
      '110241569=  DO BEGIN'
      '110241570=    PNT_ = '#39'01'#39';'
      '110241571=    SQLCODE_ = 0;'
      '110241572=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110241573=    POS1_ = POSITION('#39'~'#39' IN SQL_);'
      '110241574='
      
        '110241575=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR ' +
        'POS1_ - POS_ - 1) AS BIGINT);'
      
        '110241576=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 ' +
        'FOR CHAR_LENGTH(SQL_)) AS DATE);'
      
        '110241577=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACTI' +
        'ON_DATE_);'
      '110241578='
      '110241579=    PNT_ = '#39'02'#39';'
      '110241580=    SELECT SUM(K.SUMM)'
      '110241581=      FROM KASSA K'
      '110241582=     WHERE K."ACTION" = 0'
      '110241583=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110241584=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110241585=      INTO :CREDIT_;'
      '110241586=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '110241587='
      '110241588=    SELECT SUM(K.SUMM)'
      '110241589=      FROM KASSA K'
      '110241590=     WHERE K."ACTION" = 1'
      '110241591=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110241592=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110241593=      INTO :DEBET_;'
      '110241594=    DEBET_ = COALESCE(DEBET_, 0);'
      '110241595='
      '110241596=    PNT_ = '#39'03'#39';'
      '110241597=    BEGIN'
      '110241598=        MERGE INTO KASSA_STATE c'
      
        '110241599=        USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCH' +
        'KA_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE ' +
        'AND C.G_TOCHKA = CD.G_TOCHKA)'
      '110241600=        WHEN MATCHED THEN'
      '110241601=            UPDATE SET'
      '110241602=                C.DEBET  = :DEBET_,'
      '110241603=                C.CREDIT = :CREDIT_,'
      
        '110241604=                C."OUTPUT" = C."INPUT" - :DEBET_ + :CR' +
        'EDIT_'
      '110241605=        WHEN NOT MATCHED THEN'
      
        '110241606=            INSERT (KASSA_STATE, K_DATE, "INPUT", DEBE' +
        'T, CREDIT, "OUTPUT", G_TOCHKA)'
      '110241607=            VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110241608=                    :ACTION_DATE_,'
      
        '110241609=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110241610=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110241611=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0),'
      '110241612=                    :DEBET_,'
      '110241613=                    :CREDIT_,'
      
        '110241614=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110241615=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110241616=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0) - :DEBET_ + :CREDIT_,'
      '110241617=                   :G_TOCHKA_);'
      '110241618='
      '110241619=        PNT_ = '#39'04'#39';'
      
        '110241620=        IF (G_TOCHKA_OLD_ > 0 AND G_TOCHKA_OLD_ <> G_T' +
        'OCHKA_ AND ACTION_DATE_MIN_OLD_ < CURRENT_DATE) THEN BEGIN'
      
        '110241621=           EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DA' +
        'TE_MIN_OLD_, :G_TOCHKA_OLD_, 0)'
      '110241622=             RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110241623=        END'
      '110241624='
      '110241625=        G_TOCHKA_OLD_ = G_TOCHKA_;'
      '110241626=        ACTION_DATE_MIN_OLD_ = ACTION_DATE_MIN_;'
      '110241627=    WHEN ANY DO'
      '110241628=        BEGIN'
      '110241629=            SQLCODE_ = GDSCODE;'
      '110241630=            IF (ERR_BODY = '#39#39') THEN'
      
        '110241631=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1085#1072#1083#1080#1095#1085#1086 +
        #1081' '#1082#1072#1089#1089#1099'.'#39';'
      '110241632=            ERR_BODY = ERR_BODY ||'#39
      
        '110241633=PNT_ '#39'||PNT_||'#39'. ID_ '#39'||LOGS_ID_||'#39'. SQL_ '#39'||SQL_||'#39'. ' +
        #1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||GDSCODE;'
      '110241634=        END'
      '110241635=    END'
      '110241636='
      '110241637=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110241638=    UPDATE LOGS L'
      
        '110241639=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110241640=           L.ERR_CODE = :SQLCODE_'
      '110241641=     WHERE L.ID = :LOGS_ID_'
      '110241642=       AND L.USR = '#39'REPLICAT'#39
      '110241643=       AND L.DAT IS NULL'
      '110241644=       AND L.IS_TRANSFERED = 0;'
      '110241645='
      '110241646=  END'
      '110241647='
      '110241648=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045#1058
      '110241649=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '110241650=      EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_MI' +
        'N_, :G_TOCHKA_, 0)'
      '110241651=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110241652=  END'
      '110241653='
      
        '110241654=  --==================================================' +
        '==================='
      '110241655=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071
      
        '110241656=  --==================================================' +
        '==================='
      '110241657=  ACTION_DATE_MIN_ = CURRENT_DATE;'
      '110241658=  FOR SELECT L.ID,'
      '110241659=             L.SQLSTMT'
      '110241660=        FROM LOGS L'
      '110241661=       WHERE L.USR = '#39'REPLICAT'#39
      '110241662=         AND L.DAT IS NULL'
      '110241663=         AND L.IS_TRANSFERED = 0'
      
        '110241664=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT) > ' +
        '0'
      '110241665=        INTO :LOGS_ID_,'
      '110241666=             :SQL_'
      '110241667=  DO BEGIN'
      '110241668=    PNT_ = '#39'01'#39';'
      '110241669=    SQLCODE_ = 0;'
      '110241670=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110241671='
      
        '110241672=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1) ' +
        'AS DATE);'
      
        '110241673=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACTI' +
        'ON_DATE_);'
      '110241674='
      '110241675=    PNT_ = '#39'02'#39';'
      '110241676=    SELECT SUM(K.SUMM)'
      '110241677=      FROM KASSA_BEZNAL K'
      '110241678=     WHERE K."ACTION" = 0'
      '110241679=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110241680=      INTO :CREDIT_;'
      '110241681=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '110241682='
      '110241683=    SELECT SUM(K.SUMM)'
      '110241684=      FROM KASSA_BEZNAL K'
      '110241685=     WHERE K."ACTION" = 1'
      '110241686=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110241687=      INTO :DEBET_;'
      '110241688=    DEBET_ = COALESCE(DEBET_, 0);'
      '110241689='
      '110241690=    PNT_ = '#39'03'#39';'
      '110241691=    BEGIN'
      '110241692=        MERGE INTO KASSA_BEZNAL_STATE c'
      
        '110241693=        USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCH' +
        'KA_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE)'
      '110241694=        WHEN MATCHED THEN'
      '110241695=            UPDATE SET'
      '110241696=                C.DEBET  = :DEBET_,'
      '110241697=                C.CREDIT = :CREDIT_,'
      
        '110241698=                C."OUTPUT" = C."INPUT" - :DEBET_ + :CR' +
        'EDIT_'
      '110241699=        WHEN NOT MATCHED THEN'
      
        '110241700=            INSERT (KASSA_BEZNAL_STATE, K_DATE, "INPUT' +
        '", DEBET, CREDIT, "OUTPUT")'
      '110241701=            VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110241702=                    :ACTION_DATE_,'
      
        '110241703=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110241704=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110241705=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0),'
      '110241706=                    :DEBET_,'
      '110241707=                    :CREDIT_,'
      
        '110241708=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110241709=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110241710=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0) - :DEBET_ + :CREDIT_);'
      '110241711=    WHEN ANY DO'
      '110241712=        BEGIN'
      '110241713=            SQLCODE_ = GDSCODE;'
      '110241714=            IF (ERR_BODY = '#39#39') THEN'
      
        '110241715=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1073#1077#1079#1085#1072#1083#1080 +
        #1095#1085#1086#1081' '#1082#1072#1089#1089#1099'.'#39';'
      '110241716=            ERR_BODY = ERR_BODY ||'#39
      
        '110241717=PNT_ '#39'||PNT_||'#39'. ID_ '#39'||LOGS_ID_||'#39'. SQL_ '#39'||SQL_||'#39'. ' +
        #1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||GDSCODE;'
      '110241718=        END'
      '110241719=    END'
      '110241720='
      '110241721=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110241722=    UPDATE LOGS L'
      
        '110241723=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110241724=           L.ERR_CODE = :SQLCODE_'
      '110241725=     WHERE L.ID = :LOGS_ID_'
      '110241726=       AND L.USR = '#39'REPLICAT'#39
      '110241727=       AND L.DAT IS NULL'
      '110241728=       AND L.IS_TRANSFERED = 0;'
      '110241729='
      '110241730=  END'
      '110241731='
      '110241732=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045#1058
      '110241733=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '110241734=    EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL(:ACTION_DA' +
        'TE_MIN_)'
      '110241735=      RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110241736=  END'
      '110241737='
      '110241738=  /*'
      '110241739=  POS_ = 1;'
      '110241740=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '110241741=    BEGIN'
      
        '110241742=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ FR' +
        'OM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '110241743='
      '110241744=        WHILE (POS_ > 0) DO BEGIN'
      '110241745=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '110241746='
      '110241747=            IF (POS_ > 0) THEN'
      
        '110241748=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1 ' +
        'FOR POS_ - 1);'
      '110241749=            ELSE'
      '110241750=              STR_ = PRODUCT_ID_ARR_;'
      '110241751='
      
        '110241752=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 FO' +
        'R POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '110241753=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSIT' +
        'ION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN STR' +
        '_)) AS BIGINT);'
      '110241754='
      
        '110241755=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_A' +
        'RR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '110241756='
      '110241757=            select ('
      '110241758=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '110241759=                   (select COALESCE(sum(s.amount), 0) ' +
        'from sklad s, sklad_parent sp'
      '110241760=                    where sp.SKLAD = s.SKLAD_PARENT'
      '110241761=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '110241762=                      and s.g_product = :G_PRODUCT_'
      
        '110241763=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077' ' +
        #1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '110241764='
      '110241765=                   -'
      '110241766=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110241767=                   (select COALESCE(sum(zr.AMOUNT_ALL)' +
        ', 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110241768=                    where zr.g_product = :G_PRODUCT_ a' +
        'nd Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '110241769=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZAK' +
        'AZ_REAL_PARENT)'
      '110241770='
      '110241771=                   -'
      '110241772=                   -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '110241773=                   (select COALESCE(sum(zd.amount), 0)' +
        ' from zakaz_details zd, zakaz z'
      
        '110241774=                    where zd.g_product = :G_PRODUCT_ a' +
        'nd Z.G_TOCHKA = :G_TOCHKA_'
      '110241775=                    and zd.zakaz = z.zakaz'
      
        '110241776=                    and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099 +
        #1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076 +
        #1077#1090' '#1085#1080#1078#1077
      
        '110241777=                    and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080 +
        #1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086 +
        #1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110241778=                    and not (z.IS_SPISANIE = 0 and z.N' +
        'OT_MINUS_OSTATOK = 1)'
      '110241779=                   )'
      '110241780='
      '110241781=                   -'
      '110241782=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '110241783=                   (select COALESCE(sum(s.amount), 0) ' +
        'from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = ' +
        '3'
      '110241784=                    and S.g_client = :G_TOCHKA_)'
      '110241785='
      '110241786=                   -'
      '110241787=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '110241788=                   (select COALESCE(sum(od.amount), 0)' +
        ' from other_details od, other o'
      
        '110241789=                    where od.g_product = :G_PRODUCT_ a' +
        'nd o.G_TOCHKA = :G_TOCHKA_'
      '110241790=                    and od.other = o.other)'
      '110241791=                   ) amount,'
      '110241792='
      
        '110241793=                   (SELECT COALESCE(sum(ZD.amount), 0)' +
        ' FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '110241794=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AND' +
        ' Z.IS_RESERVE = 1'
      
        '110241795=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G' +
        '_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '110241796=            from rdb$database'
      '110241797=            INTO :AMOUNT_,'
      '110241798=                 :AMOUNT_RESERVE_;'
      '110241799='
      '110241800=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '110241801=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G' +
        '_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '110241802=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_T' +
        'OCHKA = CD.G_TOCHKA)'
      '110241803=            WHEN MATCHED THEN'
      
        '110241804=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.AM' +
        'OUNT_RESERVE = :AMOUNT_RESERVE_'
      '110241805=            WHEN NOT MATCHED THEN'
      
        '110241806=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, A' +
        'MOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110241807=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,  ' +
        '1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '110241808=        END'
      '110241809=    WHEN ANY DO'
      '110241810=        BEGIN'
      '110241811=            SQLCODE_ = GDSCODE;'
      '110241812=            IF (ERR_BODY = '#39#39') THEN'
      
        '110241813=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086#1074 +
        '.'#39';'
      '110241814=            ERR_BODY = ERR_BODY ||'#39
      '110241815=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110241816=        END'
      '110241817=    END'
      '110241818=  END'
      '110241819='
      '110241820=  */'
      '110241821=END'
