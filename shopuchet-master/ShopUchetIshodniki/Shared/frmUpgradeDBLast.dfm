      '1101824407=              :G_PRODUCT'
      '1101824408=    DO'
      '1101824409=        SUSPEND;'
      '1101824410=  END'
      '1101824411=  ELSE BEGIN'
      '1101824412=      FOR SELECT S.OPER'
      '1101824413=                  ,Z.ZAKAZ'
      '1101824414=                  ,Z.Z_DATE'
