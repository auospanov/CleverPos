        '1102504029=             0, --DECODE(:IS_THIS_LAST_, 1, 1, 0),  -' +
        '- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055 +
        #1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056 +
        #1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044#1045#1058' 0'
      '1102504030=             3,  --:IS_VOZVRAT_,'
      '1102504031=             :G_CLIENT_'
      '1102504032=            );'
      '1102504033='
      
        '1102504034=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-'#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1045
      '1102504035=            UPDATE LT_SKLAD_PRODUCT L'
      '1102504036=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_,'
      
        '1102504037=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102504038=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504039=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102504040='
      
        '1102504041=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052 +
        #1045#1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040 +
        #1042#1050#1059
      '1102504042=            PNT_ = '#39'023'#39';'
      '1102504043=            IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102504044=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504045=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUN' +
        'T_,'
      
        '1102504046=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102504047=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504048=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '1102504049='
      '1102504050=                IF (ROW_COUNT = 0) THEN'
      
        '1102504051=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SK' +
        'LAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102504052=                  VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT' +
        ', 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_APP_);'
      '1102504053=            END'
      '1102504054=          END'
      '1102504055=      END'
      '1102504056=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040', '#1043#1044#1045' '#1052#1045#1053#1071#1051#1057#1071' '#1057#1050#1051#1040#1044
      '1102504057=      -- '#1057#1050#1051#1040#1044' '#1053#1045' '#1052#1045#1053#1071#1051#1057#1071
      '1102504058=      ELSE BEGIN'
      
        '1102504059=          -------------------------------------------' +
        '------------------'
      
        '1102504060=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048 +
        #1071' '#1055#1056#1048#1061#1054#1044#1040
      '1102504061=          PNT_ = '#39'025'#39';'
      '1102504062=          FOR SELECT SKLAD,'
      '1102504063=                     AMOUNT,'
      '1102504064=                     G_PRODUCT'
      '1102504065=                FROM SKLAD S'
      '1102504066=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '1102504067=                 AND NOT EXISTS (SELECT 1'
      
        '1102504068=                                   FROM ZAKAZ_DETAILS' +
        '_TMP T'
      
        '1102504069=                                  WHERE T.ZAKAZ_DETAI' +
        'LS = S.SKLAD)'
      '1102504070=          INTO :SKLAD_,'
      '1102504071=               :Z_AMOUNT_,'
      '1102504072=               :G_PRODUCT_'
      '1102504073=          DO BEGIN'
      
        '1102504074=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ' +
        '_, :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :E' +
        'RR_MSG);'
      '1102504075=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102504076=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102504077=              EXIT;'
      '1102504078=            END'
      '1102504079=          END'
      '1102504080='
      '1102504081=          PNT_ = '#39'030'#39';'
      '1102504082=          FOR SELECT S.ZAKAZ_DETAILS,'
      '1102504083=                     S.G_PRODUCT,'
      '1102504084=                     S.AMOUNT,'
      '1102504085=                     S.PRICE,'
      '1102504086=                     S.SUMM,'
      '1102504087=                     T.SKLAD,'
      '1102504088=                     T.AMOUNT,'
      '1102504089=                     T.IS_LAST,'
      '1102504090=                     T.DATE_RECEIPT'
      
        '1102504091=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER J' +
        'OIN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHER' +
        'E SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '1102504092=                INTO :ZAKAZ_DETAILS_,'
      '1102504093=                     :G_PRODUCT_,'
      '1102504094=                     :Z_AMOUNT_,'
      '1102504095=                     :PRICE_,'
      '1102504096=                     :SUMMM_,'
      '1102504097=                     :SKLAD_OLD_,'
      '1102504098=                     :AMOUNT_OLD_,'
      '1102504099=                     :IS_THIS_LAST_,'
      '1102504100=                     :DATE_RECEIPT_OLD_'
      '1102504101=          DO BEGIN'
      
        '1102504102=            -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041 +
        #1067#1051#1054' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102504103=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '1102504104=                INSERT INTO SKLAD (SKLAD, SKLAD_PAREN' +
        'T, DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAY' +
        'MENT_TYPE, NDS, NDS_SUMM,'
      
        '1102504105=                                  IS_LAST, NOTE, OSNO' +
        'VANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '1102504106=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :' +
        'ZAKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, ' +
        ':SUMMM_, 1, 0, 0,'
      
        '1102504107=                       0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048 +
        #1047#1048#1056#1059#1070' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102504108=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_C' +
        'LIENT_'
      '1102504109=                       )'
      '1102504110=                RETURNING'
      '1102504111=                  SKLAD'
      '1102504112=                INTO'
      '1102504113=                  :SKLAD_;'
      '1102504114='
      
        '1102504115=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102504116=                UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504117=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUN' +
        'T_,'
      
        '1102504118=                       L.NEED_TO_EXPORT = :UPLOAD_TO_' +
        'EXT_APP_'
      '1102504119=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504120=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102504121='
      
        '1102504122=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1102504123=                IF (NOT_MINUS_OSTATOK_ = 0) THEN BEGI' +
        'N'
      '1102504124=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504125=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_,'
      
        '1102504126=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102504127=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504128=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102504129='
      '1102504130=                    IF (ROW_COUNT = 0) THEN'
      
        '1102504131=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102504132=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_AP' +
        'P_);'
      '1102504133=                END'
      '1102504134='
      
        '1102504135=                -- '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, '#1054 +
        #1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040 +
        #1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102504136=                -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045 +
        #1053#1068#1064#1059#1070' '#1063#1045#1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042 +
        #1051#1045#1053#1048#1045' '#1055#1056#1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1102504137=                -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_S' +
        'KLAD_DETAIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1102504138=                /*SELECT MAX(SK.DATE_RECEIPT)'
      '1102504139=                  FROM SKLAD SK'
      '1102504140=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102504141=                   AND SK.IS_LAST = 1'
      '1102504142=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '1102504143=                  INTO :DATE_LAST_;'
      '1102504144='
      
        '1102504145=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ ' +
        '>= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057 +
        #1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102504146=                  UPDATE SKLAD SK'
      '1102504147=                     SET SK.IS_LAST = 0'
      '1102504148=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102504149=                     AND SK.IS_LAST = 1'
      '1102504150=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '1102504151='
      '1102504152=                  UPDATE SKLAD SK'
      '1102504153=                     SET SK.IS_LAST = 1'
      '1102504154=                   WHERE SK.SKLAD = :SKLAD_;'
      '1102504155=                END*/'
      '1102504156='
      
        '1102504157=            -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' ' +
        #1041#1067#1051#1040' '#1042' '#1057#1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102504158=            END ELSE BEGIN'
      '1102504159=                UPDATE SKLAD S'
      '1102504160=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '1102504161=                       S.AMOUNT   = :Z_AMOUNT_,'
      '1102504162=                       S.PRICE    = :PRICE_,'
      '1102504163=                       S.SUMM     = :SUMMM_,'
      '1102504164=                       S.OSNOVANIE = :OSNOVANIE_,'
      '1102504165=                       S.NOTE      = :NOTE_'
      '1102504166=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '1102504167='
      
        '1102504168=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '1102504169=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102504170=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504171=                     SET L.AMOUNT = L.AMOUNT + (:AMOU' +
        'NT_OLD_ - :Z_AMOUNT_),'
      
        '1102504172=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102504173=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504174=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      
        '1102504175=                ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_) THE' +
        'N'
      '1102504176=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504177=                     SET L.AMOUNT = L.AMOUNT - (:Z_AM' +
        'OUNT_ - :AMOUNT_OLD_),'
      
        '1102504178=                         L.NEED_TO_EXPORT = :UPLOAD_T' +
        'O_EXT_APP_'
      '1102504179=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504180=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102504181='
      
        '1102504182=                -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045'-' +
        #1055#1054#1051#1059#1063#1040#1058#1045#1051#1045
      
        '1102504183=                IF (NOT_MINUS_OSTATOK_ = IS_EXPECTED_' +
        'OLD_ AND NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102504184=                    IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN'
      '1102504185=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504186=                         SET L.AMOUNT = L.AMOUNT - (:' +
        'AMOUNT_OLD_ - :Z_AMOUNT_),'
      
        '1102504187=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1102504188=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1102504189=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1102504190='
      
        '1102504191=                    ELSE IF (Z_AMOUNT_ > AMOUNT_OLD_)' +
        ' THEN'
      '1102504192=                      UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504193=                         SET L.AMOUNT = L.AMOUNT + (:' +
        'Z_AMOUNT_ - :AMOUNT_OLD_),'
      
        '1102504194=                             L.NEED_TO_EXPORT = :UPLO' +
        'AD_TO_EXT_APP_'
      
        '1102504195=                       WHERE L.G_PRODUCT = :G_PRODUCT' +
        '_'
      '1102504196=                         AND L.G_TOCHKA = :G_CLIENT_;'
      '1102504197='
      
        '1102504198=                -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' ' +
        #1057#1050#1051#1040#1044', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1102504199=                END ELSE IF (IS_EXPECTED_OLD_ = 1 AND' +
        ' NOT_MINUS_OSTATOK_ = 0) THEN BEGIN'
      '1102504200=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504201=                       SET L.AMOUNT = L.AMOUNT + :Z_A' +
        'MOUNT_,'
      
        '1102504202=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102504203=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504204=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102504205='
      '1102504206=                    IF (ROW_COUNT = 0) THEN'
      
        '1102504207=                      INSERT INTO LT_SKLAD_PRODUCT (L' +
        'T_SKLAD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA, NEED_TO_EXPORT)'
      
        '1102504208=                      VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_, :UPLOAD_TO_EXT_AP' +
        'P_);'
      '1102504209=                END'
      
        '1102504210=                -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042 +
        #1040' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1102504211=                ELSE IF (IS_EXPECTED_OLD_ = 0 AND NOT' +
        '_MINUS_OSTATOK_ = 1) THEN BEGIN'
      '1102504212=                    UPDATE LT_SKLAD_PRODUCT L'
      
        '1102504213=                       SET L.AMOUNT = L.AMOUNT - (:AM' +
        'OUNT_OLD_ - :Z_AMOUNT_) - :Z_AMOUNT_,'
      
        '1102504214=                           L.NEED_TO_EXPORT = :UPLOAD' +
        '_TO_EXT_APP_'
      '1102504215=                     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102504216=                       AND L.G_TOCHKA = :G_CLIENT_;'
      '1102504217=                END'
      '1102504218='
      
        '1102504219=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044 +
        #1054' '#1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 1'
      
        '1102504220=                /*IF ((Z_DATE_ > DATE_RECEIPT_OLD_) A' +
        'ND (IS_THIS_LAST_ = 0)) THEN BEGIN'
      '1102504221=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1102504222=                      FROM SKLAD SK'
      '1102504223=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102504224=                       AND SK.IS_LAST = 1'
      '1102504225=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1102504226=                      INTO :DATE_LAST_;'
      '1102504227='
      
        '1102504228=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' ' +
        #1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102504229=                      UPDATE SKLAD SK'
      '1102504230=                         SET SK.IS_LAST = 0'
      
        '1102504231=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      '1102504232=                         AND SK.IS_LAST = 1'
      
        '1102504233=                         AND SK.G_TOCHKA = :G_CLIENT_' +
        ';'
      '1102504234='
      '1102504235=                      UPDATE SKLAD SK'
      '1102504236=                         SET SK.IS_LAST = 1'
      
        '1102504237=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1102504238=                    END'
      '1102504239=                END'
      '1102504240='
      
        '1102504241=                -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' ' +
        #1059' '#1047#1040#1055#1048#1057#1048' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' ' +
        #1055#1054#1057#1058#1040#1042#1048#1058#1068' IS_LAST = 0'
      
        '1102504242=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND' +
        ' (IS_THIS_LAST_ = 1)) THEN BEGIN'
      '1102504243=                    SELECT MAX(SK.DATE_RECEIPT)'
      '1102504244=                      FROM SKLAD SK'
      '1102504245=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102504246=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '1102504247=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '1102504248=                       AND SK.is_vozvrat IN (0,3,4)'
      '1102504249=                      INTO :DATE_LAST_;'
      '1102504250='
      
        '1102504251=                    IF ((DATE_LAST_ IS NOT NULL) AND ' +
        '(Z_DATE_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045 +
        #1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102504252=                      UPDATE SKLAD SK'
      '1102504253=                         SET SK.IS_LAST = 0'
      
        '1102504254=                       WHERE SK.SKLAD = :ZAKAZ_DETAIL' +
        'S_;'
      '1102504255='
      '1102504256=                       UPDATE SKLAD SK'
      '1102504257=                         SET SK.IS_LAST = 1'
      
        '1102504258=                       WHERE SK.G_PRODUCT = :G_PRODUC' +
        'T_'
      
        '1102504259=                         AND SK.SKLAD = (SELECT MAX(S' +
        'S.SKLAD)'
      
        '1102504260=                                           FROM SKLAD' +
        ' SS'
      
        '1102504261=                                          WHERE SS.G_' +
        'PRODUCT = SK.G_PRODUCT'
      
        '1102504262=                                            AND SS.DA' +
        'TE_RECEIPT = :DATE_LAST_'
      
        '1102504263=                                            AND SS.G_' +
        'TOCHKA = :G_CLIENT_'
      
        '1102504264=                                            AND SS.is' +
        '_vozvrat IN (0,3,4));'
      '1102504265=                    END'
      '1102504266=                END*/'
      '1102504267=            END'
      '1102504268=          END -- '#1050#1054#1053#1045#1062' FOR BEGIN'
      '1102504269=      END  -- '#1050#1054#1053#1045#1062' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1054'-'#1058#1056#1040#1053#1057#1060#1045#1056
      '1102504270='
      '1102504271=      UPDATE SKLAD_PARENT'
      '1102504272=      SET'
      
        '1102504273=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT' +
        '),'
      
        '1102504274=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT' +
        '),'
      
        '1102504275=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),   ' +
        '    -- '#1055#1056#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1048' '#1042' G_TOCHKA '#1057#1048#1044#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '1102504276=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102504277=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102504278=       SUMM      = :SUMM_,'
      '1102504279=       SUMM_FACT = :SUMM_FACT_,'
      '1102504280=       IS_EXPECTED = :NOT_MINUS_OSTATOK_'
      '1102504281=      WHERE SKLAD  = :ZAKAZ_;'
      '1102504282=  END'
      '1102504283='
      '1102504284=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '1102504285='
      '1102504286=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102504287=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_SPISANIE_, :USER' +
        '_ID_, :ZAKAZ_, :Z_DATE_, 2, :SUMM_, :LOG_BODY_, 0);'
      '1102504288='
      '1102504289=  IF (LOG_BODY_KASSA_ <> '#39#39') THEN'
      
        '1102504290=    EXECUTE PROCEDURE LOG_OPER_INS(11, :USER_ID_, :KA' +
        'SSA_ZP_ID_, :ACTION_DATE_ZP_, :LOG_KASSA_OPER_TYPE_, :SALES_COMM' +
        '_SUMM_ALL_, :LOG_BODY_KASSA_, 1);'
      '1102504291=END'
      '1102504292=;'
      '1102504293='
      '1102504294='
      
        '1102504295=UPDATE SYSTEM_SETUP SET S_VALUE = 110250 WHERE SYSTEM' +
        '_SETUP = 3;'
      '1102510='
      '1102511=ALTER PROCEDURE G_TOCHKA_DEL('
      '1102512=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1102513=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1102514=RETURNS ('
      '1102515=  ERR_CODE INTEGER,'
      '1102516=  ERR_MSG VARCHAR(1024))'
      '1102517=AS'
      '1102518=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '1102519=BEGIN'
      '11025110=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '11025111=    ERR_CODE = -20500;'
      
        '11025112=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076#1072 +
        #1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '11025113=    EXIT;'
      '11025114=  END'
      '11025115='
      '11025116=  DELETE FROM KASSA_STATE S'
      '11025117=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '11025118='
      
        '11025119=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040#1041#1051 +
        #1048#1062#1059' LOGS'
      
        '11025120=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SE' +
        'TUP = 5) > 0) THEN'
      
        '11025121=      INSERT INTO LOGS (ID, SQLSTMT, USR, IS_TRANSFERED' +
        ', SYSDATE, ERR_CODE)'
      
        '11025122=      VALUES (GEN_ID(GEN_LOGS, 1), '#39'DELETE FROM KASSA_S' +
        'TATE S WHERE S.G_TOCHKA = '#39'||:G_TOCHKA_||'#39';'#39', '#39'SYSDBA'#39', 0, CURRE' +
        'NT_TIMESTAMP, :ERR_CODE);'
      '11025123='
      '11025124=  DELETE FROM KASSA S'
      '11025125=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '11025126='
      '11025127=  FOR SELECT KASSA_BEZNAL'
      '11025128=        FROM KASSA_BEZNAL'
      '11025129=       WHERE G_TOCHKA = :G_TOCHKA_'
      '11025130=        INTO :KASSA_'
      '11025131=  DO BEGIN'
      
        '11025132=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNING' +
        '_VALUES (:ERR_CODE, :ERR_MSG);'
      '11025133=    IF (:ERR_CODE <> 0) THEN'
      '11025134=      EXIT;'
      '11025135=  END'
      '11025136='
      '11025137=  UPDATE G_OFFICIAL O'
      '11025138=     SET O.G_TOCHKA = NULL'
      '11025139=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '11025140='
      '11025141=  DELETE FROM INVOICE I'
      '11025142=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '11025143=                      FROM ZAKAZ'
      '11025144=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11025145='
      '11025146=  DELETE FROM INVOICE_PAY I'
      '11025147=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '11025148=                      FROM ZAKAZ'
      '11025149=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11025150='
      '11025151=  DELETE FROM WAYBILL I'
      '11025152=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '11025153=                      FROM ZAKAZ'
      '11025154=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11025155='
      '11025156=  DELETE FROM LT_ZAKAZ_REAL R'
      '11025157=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '11025158=                              FROM ZAKAZ Z, ZAKAZ_DETAI' +
        'LS ZD'
      
        '11025159=                             WHERE Z.G_TOCHKA = :G_TOCH' +
        'KA_'
      '11025160=                               AND Z.ZAKAZ = ZD.ZAKAZ);'
      '11025161='
      '11025162=  DELETE FROM LT_ZAKAZ_REAL R'
      '11025163=  WHERE R.ZAKAZ_NA_REAL IN (SELECT D.ZAKAZ_NA_REAL'
      '11025164=                              FROM ZAKAZ_NA_REAL D'
      
        '11025165=                             WHERE D.ZAKAZ_REAL_PARENT ' +
        'IN (SELECT ZAKAZ_REAL_PARENT'
      
        '11025166=                                                       ' +
        '      FROM ZAKAZ_REAL_PARENT'
      
        '11025167=                                                       ' +
        '     WHERE G_TOCHKA = :G_TOCHKA_)'
      '11025168=                           );'
      '11025169='
      '11025170=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '11025171=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PAREN' +
        'T'
      
        '11025172=                                  FROM ZAKAZ_REAL_PAREN' +
        'T'
      
        '11025173=                                 WHERE G_TOCHKA = :G_TO' +
        'CHKA_);'
      '11025174='
      '11025175=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '11025176=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11025177='
      '11025178=  DELETE FROM ZAKAZ_DETAILS D'
      '11025179=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '11025180=                      FROM ZAKAZ'
      '11025181=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11025182='
      '11025183=  DELETE FROM ZAKAZ D'
      '11025184=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11025185='
      '11025186=  DELETE FROM SKLAD D'
      '11025187=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11025188='
      '11025189=  DELETE FROM SKLAD_PARENT D'
      '11025190=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '11025191='
      '11025192=  DELETE FROM ZAKAZ_DETAILS D'
      '11025193=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '11025194=                      FROM ZAKAZ'
      '11025195=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '11025196='
      '11025197=  DELETE FROM LT_SKLAD_PRODUCT'
      '11025198=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '11025199='
      '110251100=  DELETE FROM G_TOCHKA'
      '110251101=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '110251102='
      
        '110251103=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051 +
        #1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110251104=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110251105=    UPDATE SYNC_EXT_APP AP'
      '110251106=       SET AP.OPER = 3'
      '110251107=     WHERE AP.OBJECT_TYPE = 3'
      '110251108=       AND AP.ID = :G_TOCHKA_'
      '110251109=       AND AP.IS_LOADING = 0;'
      '110251110='
      '110251111=    IF (ROW_COUNT = 0) THEN'
      
        '110251112=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110251113=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 3, :G_TOC' +
        'HKA_, 3);'
      '110251114=  END'
      '110251115=END'
      '110251116=;'
      '110251117='
      '110251118=ALTER PROCEDURE LOG_INIT'
      '110251119=AS'
      '110251120=DECLARE VARIABLE TN VARCHAR(64);'
      '110251121=DECLARE VARIABLE TN_ALT VARCHAR(64);'
      '110251122=DECLARE VARIABLE FN VARCHAR(64);'
      '110251123=DECLARE VARIABLE TP INTEGER;'
      
        '110251124=DECLARE VARIABLE TRGI BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110251125=DECLARE VARIABLE TRGU BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110251126=DECLARE VARIABLE TRGD BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000); */'
      
        '110251127=DECLARE VARIABLE SQLSTMT BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80; /* VARCHAR(30000); */'
      '110251128=DECLARE VARIABLE TRGIX VARCHAR(2000);'
      '110251129=DECLARE VARIABLE TRGUX VARCHAR(2000);'
      '110251130=DECLARE VARIABLE TRGDX VARCHAR(2000);'
      
        '110251131=DECLARE VARIABLE SQLF BLOB SUB_TYPE 1 SEGMENT SIZE 80;' +
        ' /* VARCHAR(30000) */'
      '110251132=DECLARE VARIABLE SQLV BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110251133=DECLARE VARIABLE SQLU BLOB SUB_TYPE 1 SEGMENT SIZE 80;'
      '110251134=DECLARE VARIABLE ANZ INTEGER;'
      '110251135=DECLARE VARIABLE L INTEGER;'
      '110251136=DECLARE VARIABLE P INTEGER;'
      '110251137=DECLARE VARIABLE S INTEGER;'
      '110251138=DECLARE VARIABLE FT CHAR(1);'
      '110251139=DECLARE VARIABLE CRLF VARCHAR(10);'
      '110251140=DECLARE VARIABLE ID_COLUMN VARCHAR(64);'
      '110251141=BEGIN'
      '110251142=  CRLF = ASCII_CHAR(13)||ASCII_CHAR(10);'
      '110251143='
      '110251144=  TN_ALT='#39#39';'
      '110251145=  TRGI='#39#39';'
      '110251146=  TRGU='#39#39';'
      '110251147=  TRGD='#39#39';'
      '110251148=  TRGIX='#39#39';'
      '110251149=  TRGUX='#39#39';'
      '110251150=  TRGDX='#39#39';'
      '110251151=  SQLF='#39#39';'
      '110251152=  SQLV='#39#39';'
      '110251153=  SQLU='#39#39';'
      '110251154=  FT='#39#39';'
      '110251155='
      '110251156=  FOR SELECT R.RDB$RELATION_NAME,'
      '110251157=            R.RDB$FIELD_NAME,'
      '110251158=            F.RDB$FIELD_TYPE,'
      '110251159=            F.RDB$FIELD_LENGTH,'
      '110251160=            F.RDB$FIELD_PRECISION,'
      '110251161=            F.RDB$FIELD_SCALE'
      '110251162=        FROM RDB$RELATION_FIELDS R,'
      '110251163=             RDB$FIELDS F'
      '110251164=       WHERE R.RDB$SYSTEM_FLAG=0'
      '110251165=         AND R.RDB$FIELD_SOURCE=F.RDB$FIELD_NAME'
      '110251166=         AND NOT R.RDB$RELATION_NAME CONTAINING '#39'$'#39
      
        '110251167=         AND R.RDB$RELATION_NAME NOT IN ('#39'CUR_PARAMS'#39',' +
        ' '#39'DELIVERY'#39', '#39'G_PRODUCT_KIT_TMP'#39', '#39'G_PRODUCT_SIZES'#39','
      
        '110251168=                                         '#39'IMPORT_TBL_T' +
        'MP'#39', '#39'LOGS'#39', '#39'LT_BARCODE_TMP'#39','
      
        '110251169=                                         '#39'P_REP_KASSIR' +
        '_TABLE'#39', '#39'P_REP_PRICE_LIST_TABLE'#39', '#39'P_REP_PRIHOD_TABLE'#39','
      
        '110251170=                                         '#39'P_REP_PROFIT' +
        '_TABLE'#39', '#39'P_REP_RASHODY_PROFIT_TABLE'#39', '#39'P_REP_TOVAR_MOVE_TABLE'#39','
      
        '110251171=                                         '#39'P_REP_TREE'#39',' +
        ' '#39'P_REP_ZAKAZI_LIST_TABLE'#39', '#39'P_REP_ZAKAZ_NA_REAL_TABLE'#39', '#39'REPORT' +
        #39','
      
        '110251172=                                         '#39'RIGHTS_ITEM'#39 +
        ', '#39'SKLAD_TMP'#39', '#39'SYSTEM_SETUP'#39','
      
        '110251173=                                         '#39'ZAKAZ_DETAIL' +
        'S_TMP'#39', '#39'ZAKAZ_DETAILS_TMP_REAL'#39', '#39'G_PRODUCT_IMAGE_TMP'#39', '#39'G_PROD' +
        'UCT_FILL'#39','
      
        '110251174=                                         '#39'KASSA_STATE'#39 +
        ', '#39'KASSA_BEZNAL_STATE'#39', '#39'SYNC_EXT_APP'#39','#39'REVISION_TMP'#39','#39'UPLOAD_TA' +
        'BLE_TMP'#39','
      
        '110251175=                                         '#39'KASPI_CITY'#39',' +
        #39'KASPI_POINT'#39')'
      '110251176=         --AND R.RDB$RELATION_NAME = '#39'KASSA_STATE'#39
      '110251177=         AND ((F.RDB$FIELD_TYPE <> 261)'
      '110251178=              OR'
      
        '110251179=              (F.RDB$FIELD_TYPE = 261 AND F.RDB$FIELD_' +
        'SUB_TYPE <> 0)'
      '110251180=             )'
      
        '110251181=       ORDER BY R.RDB$RELATION_NAME,R.RDB$FIELD_POSITI' +
        'ON'
      '110251182=        INTO :TN,:FN,:TP,:L,:P,:S'
      '110251183=  DO BEGIN'
      '110251184=    TN=TRIM(TN);'
      '110251185=    FN=TRIM(FN);'
      '110251186=    IF ((TN_ALT<>TN) AND (TN_ALT<>'#39#39')) THEN BEGIN'
      '110251187=      IF (TRGIX<>'#39#39') THEN  EXECUTE STATEMENT TRGIX;'
      '110251188=      EXECUTE STATEMENT TRGI;'
      '110251189=      IF (TRGUX<>'#39#39') THEN  EXECUTE STATEMENT TRGUX;'
      '110251190=      EXECUTE STATEMENT TRGU;'
      '110251191=      IF (TRGDX<>'#39#39') THEN  EXECUTE STATEMENT TRGDX;'
      '110251192=      EXECUTE STATEMENT TRGD;'
      '110251193='
      '110251194=      SQLF='#39#39';'
      '110251195=      SQLV='#39#39';'
      '110251196=      SQLU='#39#39';'
      '110251197=    END'
