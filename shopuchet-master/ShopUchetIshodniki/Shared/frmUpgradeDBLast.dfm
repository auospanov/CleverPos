        ' FROM GET_RUSSIAN_MONTH(EXTRACT(MONTH FROM I.INIT_DATE), 1))||'#39' ' +
        #39'||EXTRACT(YEAR FROM I.INIT_DATE)||'#39' '#1075'.'#39','
