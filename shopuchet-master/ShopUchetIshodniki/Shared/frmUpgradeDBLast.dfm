      '110487387=            ,ARTICUL'
      '110487388=            ,BARCODE'
      '110487389=            ,NAME'
      '110487390=            ,AMOUNT'
      '110487391=            ,SUMM'
      '110487392=        FROM P_REP_KASSIR_TABLE'
      '110487393=    ORDER BY 1, 3, 7'
      '110487394=    INTO :SORT_COL,'
      '110487395=        :ROWCOL,'
      '110487396=        :Z_DATE_LOC,'
      '110487397=        :Z_DATE,'
      '110487398=        :ARTICUL,'
      '110487399=        :BARCODE,'
      '110487400=        :NAME,'
      '110487401=        :AMOUNT,'
      '110487402=        :SUMM'
      '110487403=  DO'
      '110487404=    suspend;'
      '110487405=end'
      '110487406='#39';'
      '110487407=END  --END_EXECUTE_BLOCK'
      '110487408=EXECUTE BLOCK AS BEGIN'
      '110487409='
      
        '110487410=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAKAZ_NA_REAL' +
        '('
      '110487411=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110487412=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110487413=  DATE_BEGIN_ DATE,'
      '110487414=  DATE_END_ DATE,'
      '110487415=  G_CATEGORY_ VARCHAR(1000),'
      '110487416=  G_PRODUCT_ VARCHAR(1000),'
      '110487417=  MODE_ INTEGER,'
      '110487418=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110487419=RETURNS ('
      
        '110487420=  ZAKAZ_DATE TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.' +
        'ZAKAZ_DATE,'
      '110487421=  NAME TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.NAME,'
      
        '110487422=  ARTICUL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.ART' +
        'ICUL,'
      
        '110487423=  PRICE TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.PRICE' +
        ','
      
        '110487424=  AMOUNT_ALL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.' +
        'AMOUNT_ALL,'
      
        '110487425=  SUMM_ALL TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.SU' +
        'MM_ALL,'
      
        '110487426=  AMOUNT_PAYED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABL' +
        'E.AMOUNT_PAYED,'
      
        '110487427=  SUMM_PAYED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.' +
        'SUMM_PAYED,'
      
        '110487428=  AMOUNT_RETURNED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_T' +
        'ABLE.AMOUNT_RETURNED,'
      
        '110487429=  SUMM_RETURNED TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TAB' +
        'LE.SUMM_RETURNED,'
      
        '110487430=  AMOUNT_LEFT TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE' +
        '.AMOUNT_LEFT,'
      
        '110487431=  SUMM_LEFT TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.S' +
        'UMM_LEFT,'
      
        '110487432=  IS_HEAD TYPE OF COLUMN P_REP_ZAKAZ_NA_REAL_TABLE.IS_' +
        'HEAD)'
      '110487433=AS'
      
        '110487434=DECLARE VARIABLE G_CLIENT_NAME_ TYPE OF COLUMN G_CLIEN' +
        'T.NAME;'
      
        '110487435=DECLARE VARIABLE G_CLIENT_NAME_OLD_ TYPE OF COLUMN G_C' +
        'LIENT.NAME;'
      '110487436=DECLARE VARIABLE SUMM_ NUMERIC(15,2) = 0;'
      '110487437=DECLARE VARIABLE SUMM_IT_ NUMERIC(15,2) = 0;'
      '110487438=DECLARE VARIABLE SUMM_ALL_ NUMERIC(15,2) = 0;'
      '110487439=DECLARE VARIABLE SUMM_PAYED_ NUMERIC(15,2) = 0;'
      '110487440=DECLARE VARIABLE SUMM_PAYED_IT_ NUMERIC(15,2) = 0;'
      '110487441=DECLARE VARIABLE SUMM_PAYED_ALL_ NUMERIC(15,2) = 0;'
      '110487442=DECLARE VARIABLE SUMM_RETURNED_ NUMERIC(15,2) = 0;'
      '110487443=DECLARE VARIABLE SUMM_RETURNED_IT_ NUMERIC(15,2) = 0;'
      '110487444=DECLARE VARIABLE SUMM_RETURNED_ALL_ NUMERIC(15,2) = 0;'
      '110487445=DECLARE VARIABLE SUMM_LEFT_ NUMERIC(15,2) = 0;'
      '110487446=DECLARE VARIABLE SUMM_LEFT_IT_ NUMERIC(15,2) = 0;'
      '110487447=DECLARE VARIABLE SUMM_LEFT_ALL_ NUMERIC(15,2) = 0;'
      
        '110487448=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN P_REP_ZAKAZ_NA' +
        '_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487449=DECLARE VARIABLE AMOUNT_IT_ TYPE OF COLUMN P_REP_ZAKAZ' +
        '_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487450=DECLARE VARIABLE AMOUNT_ALL_ TYPE OF COLUMN P_REP_ZAKA' +
        'Z_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487451=DECLARE VARIABLE AMOUNT_PAYED_ TYPE OF COLUMN P_REP_ZA' +
        'KAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487452=DECLARE VARIABLE AMOUNT_PAYED_IT_ TYPE OF COLUMN P_REP' +
        '_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487453=DECLARE VARIABLE AMOUNT_PAYED_ALL_ TYPE OF COLUMN P_RE' +
        'P_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487454=DECLARE VARIABLE AMOUNT_RETURNED_ TYPE OF COLUMN P_REP' +
        '_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487455=DECLARE VARIABLE AMOUNT_RETURNED_IT_ TYPE OF COLUMN P_' +
        'REP_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487456=DECLARE VARIABLE AMOUNT_RETURNED_ALL_ TYPE OF COLUMN P' +
        '_REP_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487457=DECLARE VARIABLE AMOUNT_LEFT_ TYPE OF COLUMN P_REP_ZAK' +
        'AZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487458=DECLARE VARIABLE AMOUNT_LEFT_IT_ TYPE OF COLUMN P_REP_' +
        'ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487459=DECLARE VARIABLE AMOUNT_LEFT_ALL_ TYPE OF COLUMN P_REP' +
        '_ZAKAZ_NA_REAL_TABLE.AMOUNT_ALL = 0;'
      
        '110487460=DECLARE VARIABLE ZAKAZ_DATE_ TYPE OF COLUMN ZAKAZ_REAL' +
        '_PARENT.ZAKAZ_DATE;'
      '110487461=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '110487462=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ART' +
        'ICUL;'
      
        '110487463=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_NA_REAL.P' +
        'RICE;'
      '110487464=BEGIN'
      '110487465=  DELETE FROM P_REP_ZAKAZ_NA_REAL_TABLE;'
      '110487466=  G_CLIENT_NAME_OLD_ = '#39#39#39#39';'
      '110487467='
      '110487468=  FOR SELECT TRIM(G.NAME),'
      '110487469=             ZP.ZAKAZ_DATE,'
      '110487470=             P.NAME,'
      '110487471=             P.ARTICUL,'
      '110487472=             Z.PRICE,'
      '110487473=             Z.AMOUNT_ALL,'
      '110487474=             Z.SUMM_ALL,'
      '110487475=             Z.AMOUNT_PAYED,'
      '110487476=             Z.SUMM_PAYED,'
      '110487477=             COALESCE(Z.AMOUNT_RETURNED, 0),'
      '110487478=             COALESCE(Z.SUMM_RETURNED, 0),'
      
        '110487479=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALESCE(' +
        'Z.AMOUNT_RETURNED, 0),'
      
        '110487480=             Z.SUMM_ALL - Z.SUMM_PAYED - COALESCE(Z.SU' +
        'MM_RETURNED, 0)'
      '110487481=        FROM ZAKAZ_REAL_PARENT ZP,'
      '110487482=             ZAKAZ_NA_REAL Z,'
      '110487483=             G_CLIENT G,'
      '110487484=             G_PRODUCT P'
      
        '110487485=       WHERE ZP.ZAKAZ_DATE BETWEEN :DATE_BEGIN_ AND :D' +
        'ATE_END_'
      '110487486=         AND ZP.G_CLIENT = G.G_CLIENT'
      
        '110487487=         AND Z.ZAKAZ_REAL_PARENT = ZP.ZAKAZ_REAL_PAREN' +
        'T'
      '110487488=         AND Z.G_PRODUCT = P.G_PRODUCT'
      
        '110487489=         AND ZP.G_CLIENT = COALESCE(:G_CLIENT_, ZP.G_C' +
        'LIENT)'
      
        '110487490=         AND G.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CA' +
        'T_, G.G_CLIENT_PARENT)'
      
        '110487491=         AND (((Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COALES' +
        'CE(Z.AMOUNT_RETURNED, 0)) > 0 AND :MODE_ = 0)'
      '110487492=              OR'
      '110487493=              (Z.AMOUNT_PAYED > 0 AND :MODE_ = 1)'
      '110487494=              OR'
      
        '110487495=              (COALESCE(Z.AMOUNT_RETURNED, 0) > 0 AND ' +
        ':MODE_ = 2)'
      '110487496=              OR'
      '110487497=              :MODE_ = 3)'
      
        '110487498=         AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||P.G_PROD' +
        'UCT_PAR||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL) or :G_CATEGORY_ IS ' +
        'NULL)'
      
        '110487499=         AND ((:G_PRODUCT_ CONTAINING '#39#39'~'#39#39'||P.G_PRODU' +
        'CT||'#39#39'~'#39#39' AND :G_PRODUCT_ IS NOT NULL) or :G_PRODUCT_ IS NULL)'
      
        '110487500=         AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||ZP.G_TOC' +
        'HKA||'#39#39'-'#39#39
      '110487501=       ORDER BY G.NAME, ZP.ZAKAZ_DATE, P.NAME'
      
        '110487502=        INTO :G_CLIENT_NAME_, :ZAKAZ_DATE_, :NAME_, :A' +
        'RTICUL_, :PRICE_, :AMOUNT_, :SUMM_, :AMOUNT_PAYED_, :SUMM_PAYED_' +
        ', :AMOUNT_RETURNED_, :SUMM_RETURNED_, :AMOUNT_LEFT_, :SUMM_LEFT_'
      '110487503=  DO BEGIN'
      '110487504=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050
      
        '110487505=      IF (G_CLIENT_NAME_ <> G_CLIENT_NAME_OLD_) THEN B' +
        'EGIN'
      
        '110487506=          -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1055#1045 +
        #1056#1042#1067#1049' '#1050#1051#1048#1045#1053#1058
      '110487507=          IF (G_CLIENT_NAME_OLD_ <> '#39#39#39#39') THEN BEGIN'
      
        '110487508=              INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P' +
        '_REP_ZAKAZ_NA_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAY' +
        'ED, SUMM_PAYED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED' +
        ', SUMM_RETURNED)'
      
        '110487509=              VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, ' +
        '1), '#39#39#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059#39#39', :AMOUNT_IT_, :SUMM_IT_, :AMOUNT_PAYED_' +
        'IT_, :SUMM_PAYED_IT_, :AMOUNT_LEFT_IT_, :SUMM_LEFT_IT_, 2, :AMOU' +
        'NT_RETURNED_IT_, :SUMM_RETURNED_IT_);'
      '110487510='
      '110487511=              SUMM_ALL_ = SUMM_ALL_ + SUMM_IT_;'
      
        '110487512=              SUMM_PAYED_ALL_  = SUMM_PAYED_ALL_ + SUM' +
        'M_PAYED_IT_;'
      
        '110487513=              SUMM_RETURNED_ALL_  = SUMM_RETURNED_ALL_' +
        ' + SUMM_RETURNED_IT_;'
      
        '110487514=              SUMM_LEFT_ALL_   = SUMM_LEFT_ALL_ + SUMM' +
        '_LEFT_IT_;'
      
        '110487515=              AMOUNT_ALL_      = AMOUNT_ALL_ + AMOUNT_' +
        'IT_;'
      
        '110487516=              AMOUNT_PAYED_ALL_ = AMOUNT_PAYED_ALL_ + ' +
        'AMOUNT_PAYED_IT_;'
      
        '110487517=              AMOUNT_RETURNED_ALL_ = AMOUNT_RETURNED_A' +
        'LL_ + AMOUNT_RETURNED_IT_;'
      
        '110487518=              AMOUNT_LEFT_ALL_  = AMOUNT_LEFT_ALL_ + A' +
        'MOUNT_LEFT_IT_;'
      '110487519='
      '110487520=              SUMM_IT_ = 0;'
      '110487521=              SUMM_PAYED_IT_  = 0;'
      '110487522=              SUMM_RETURNED_IT_ = 0;'
      '110487523=              SUMM_LEFT_IT_   = 0;'
      '110487524=              AMOUNT_IT_      = 0;'
      '110487525=              AMOUNT_PAYED_IT_ = 0;'
      '110487526=              AMOUNT_RETURNED_IT_ = 0;'
      '110487527=              AMOUNT_LEFT_IT_  = 0;'
      '110487528=          END'
      '110487529='
      
        '110487530=          INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP' +
        '_ZAKAZ_NA_REAL_TABLE, NAME, IS_HEAD)'
      
        '110487531=          VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), ' +
        ':G_CLIENT_NAME_, 1);'
      '110487532='
      '110487533=          G_CLIENT_NAME_OLD_ = G_CLIENT_NAME_;'
      '110487534=      END'
      '110487535='
      
        '110487536=      INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZAK' +
        'AZ_NA_REAL_TABLE, ZAKAZ_DATE, NAME, ARTICUL, PRICE, AMOUNT_ALL, ' +
        'SUMM_ALL, AMOUNT_PAYED,'
      
        '110487537=                                       SUMM_PAYED, AMO' +
        'UNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_RETURNED)'
      
        '110487538=      VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), :ZAK' +
        'AZ_DATE_, :NAME_, :ARTICUL_, :PRICE_, :AMOUNT_, :SUMM_, :AMOUNT_' +
        'PAYED_, :SUMM_PAYED_, :AMOUNT_LEFT_, :SUMM_LEFT_, 0, :AMOUNT_RET' +
        'URNED_, :SUMM_RETURNED_);'
      '110487539='
      '110487540=      SUMM_IT_ = SUMM_IT_ + SUMM_;'
      '110487541=      SUMM_PAYED_IT_  = SUMM_PAYED_IT_ + SUMM_PAYED_;'
      
        '110487542=      SUMM_RETURNED_IT_  = SUMM_RETURNED_IT_ + SUMM_RE' +
        'TURNED_;'
      '110487543=      SUMM_LEFT_IT_   = SUMM_LEFT_IT_ + SUMM_LEFT_;'
      '110487544=      AMOUNT_IT_      = AMOUNT_IT_ + AMOUNT_;'
      
        '110487545=      AMOUNT_PAYED_IT_ = AMOUNT_PAYED_IT_ + AMOUNT_PAY' +
        'ED_;'
      
        '110487546=      AMOUNT_RETURNED_IT_ = AMOUNT_RETURNED_IT_ + AMOU' +
        'NT_RETURNED_;'
      
        '110487547=      AMOUNT_LEFT_IT_  = AMOUNT_LEFT_IT_ + AMOUNT_LEFT' +
        '_;'
      '110487548=  END'
      '110487549='
      '110487550=  SUMM_ALL_ = SUMM_ALL_ + SUMM_IT_;'
      '110487551=  SUMM_PAYED_ALL_  = SUMM_PAYED_ALL_ + SUMM_PAYED_IT_;'
      
        '110487552=  SUMM_RETURNED_ALL_  = SUMM_RETURNED_ALL_ + SUMM_RETU' +
        'RNED_IT_;'
      '110487553=  SUMM_LEFT_ALL_   = SUMM_LEFT_ALL_ + SUMM_LEFT_IT_;'
      '110487554=  AMOUNT_ALL_      = AMOUNT_ALL_ + AMOUNT_IT_;'
      
        '110487555=  AMOUNT_PAYED_ALL_ = AMOUNT_PAYED_ALL_ + AMOUNT_PAYED' +
        '_IT_;'
      
        '110487556=  AMOUNT_RETURNED_ALL_ = AMOUNT_RETURNED_ALL_ + AMOUNT' +
        '_RETURNED_IT_;'
      
        '110487557=  AMOUNT_LEFT_ALL_  = AMOUNT_LEFT_ALL_ + AMOUNT_LEFT_I' +
        'T_;'
      '110487558='
      
        '110487559=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1055#1054' '#1055#1054#1057#1051#1045#1044#1053#1045#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048 +
        ' '#1054#1058#1063#1045#1058' '#1053#1045' '#1055#1054' '#1050#1054#1053#1050#1056#1045#1058#1053#1054#1052#1059' '#1050#1051#1048#1045#1053#1058#1059', '#1058'.'#1050'. '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1048#1058#1054#1043#1054' '#1055#1054' '#1050#1051 +
        #1048#1045#1053#1058#1059' '#1048' '#1057#1051#1045#1044' '#1057#1058#1056#1054#1063#1050#1040' '#1048#1058#1054#1043#1054' '#1041#1059#1044#1059#1058' '#1056#1040#1042#1053#1067
      '110487560=  IF (G_CLIENT_ IS NULL) THEN'
      
        '110487561=      INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZAK' +
        'AZ_NA_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAYED, SUMM' +
        '_PAYED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_R' +
        'ETURNED)'
      
        '110487562=      VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), '#39#39#1048#1058 +
        #1054#1043#1054' '#1055#1054' '#1050#1051#1048#1045#1053#1058#1059#39#39', :AMOUNT_IT_, :SUMM_IT_, :AMOUNT_PAYED_IT_, :SU' +
        'MM_PAYED_IT_, :AMOUNT_LEFT_IT_, :SUMM_LEFT_IT_, 2, :AMOUNT_RETUR' +
        'NED_IT_, :SUMM_RETURNED_IT_);'
      '110487563='
      '110487564=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054
      
        '110487565=  INSERT INTO P_REP_ZAKAZ_NA_REAL_TABLE (P_REP_ZAKAZ_N' +
        'A_REAL_TABLE, NAME, AMOUNT_ALL, SUMM_ALL, AMOUNT_PAYED, SUMM_PAY' +
        'ED, AMOUNT_LEFT, SUMM_LEFT, IS_HEAD, AMOUNT_RETURNED, SUMM_RETUR' +
        'NED)'
      
        '110487566=  VALUES (GEN_ID(GEN_P_REP_ZAKAZ_NA_REAL, 1), '#39#39#1048#1058#1054#1043#1054#39 +
        #39', :AMOUNT_ALL_, :SUMM_ALL_, :AMOUNT_PAYED_ALL_, :SUMM_PAYED_ALL' +
        '_, :AMOUNT_LEFT_ALL_, :SUMM_LEFT_ALL_, 1, :AMOUNT_RETURNED_ALL_,' +
        ' :SUMM_RETURNED_ALL_);'
      '110487567='
      '110487568=  FOR SELECT ZAKAZ_DATE,'
      '110487569=             NAME,'
      '110487570=             ARTICUL,'
      '110487571=             PRICE,'
      '110487572=             AMOUNT_ALL,'
      '110487573=             SUMM_ALL,'
      '110487574=             AMOUNT_PAYED,'
      '110487575=             SUMM_PAYED,'
      '110487576=             AMOUNT_RETURNED,'
      '110487577=             SUMM_RETURNED,'
      '110487578=             AMOUNT_LEFT,'
      '110487579=             SUMM_LEFT,'
      '110487580=             IS_HEAD'
      '110487581=      FROM P_REP_ZAKAZ_NA_REAL_TABLE'
      '110487582=      ORDER BY P_REP_ZAKAZ_NA_REAL_TABLE'
      
        '110487583=      INTO :ZAKAZ_DATE, :NAME, :ARTICUL, :PRICE, :AMOU' +
        'NT_ALL, :SUMM_ALL, :AMOUNT_PAYED, :SUMM_PAYED, :AMOUNT_RETURNED,' +
        ' :SUMM_RETURNED,'
      '110487584=           :AMOUNT_LEFT, :SUMM_LEFT, :IS_HEAD'
      '110487585=  DO'
      '110487586=    SUSPEND;'
      '110487587=end'
      '110487588='#39';'
      '110487589='
      '110487590=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '110487591=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110487592=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110487593=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110487594=  DATE_BEGIN_ DATE,'
      '110487595=  DATE_END_ DATE,'
      '110487596=  TIME_BEGIN_ TIME,'
      '110487597=  TIME_END_ TIME,'
      '110487598=  G_CATEGORY_ VARCHAR(1000),'
      '110487599=  G_PRODUCT_ VARCHAR(1000),'
      '110487600=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110487601=RETURNS ('
      '110487602=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110487603=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110487604=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110487605=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_TENGE,'
      
        '110487606=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110487607=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110487608=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '110487609=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110487610=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110487611=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110487612=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110487613=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110487614=  Z_DATE BLOB SUB_TYPE 1,'
      '110487615=  ROW INTEGER,'
      '110487616=  ERR_CODE INTEGER,'
      '110487617=  ERR_MSG VARCHAR(1024))'
      '110487618=AS'
      
        '110487619=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_ZAKAZI' +
        '_LIST'#39#39';'
      '110487620=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110487621=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '110487622=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80;'
      
        '110487623=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ART' +
        'ICUL;'
      
        '110487624=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BAR' +
        'CODE;'
      
        '110487625=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRO' +
        'DUCT.BARCODE;'
      
        '110487626=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110487627=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110487628=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.NAME;'
      
        '110487629=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      
        '110487630=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110487631=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM = 0;'
      
        '110487632=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110487633=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '110487634=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110487635=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM = 0;'
      
        '110487636=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110487637=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '110487638=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '110487639=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.' +
        'PATH = '#39#39#39#39';'
      '110487640=DECLARE VARIABLE I INTEGER = 1;'
      '110487641=BEGIN'
      '110487642=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '110487643=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '110487644='
      
        '110487645=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39#39'0'#39#39') ' +
        '|| '#39#39'.'#39#39' || lpad(extract(month from Z.Z_DATE),2,'#39#39'0'#39#39') || '#39#39'.'#39#39' ' +
        '|| extract(year from Z.Z_DATE),'
      '110487646=             Z.Z_TIME,'
      '110487647=             GP.ARTICUL,'
      '110487648=             GP.BARCODE,'
      '110487649=             GP.NOMENCLATUR_NUM,'
      '110487650=             GP.NAME,'
      '110487651=             ZD.AMOUNT,'
      '110487652=             ZD.PRICE,'
      '110487653=             ZD.DISCOUNT_TENGE,'
      '110487654=             ZD.SUMM,'
      '110487655=             ZD.DISCOUNT_SUMM,'
      '110487656=             GC.NAME,'
      '110487657=             P.NAME,'
      '110487658=             TR.PATH'
      '110487659=      FROM ZAKAZ Z,'
      '110487660=           ZAKAZ_DETAILS ZD,'
      '110487661=           G_CLIENT GC,'
      '110487662=           G_PAYMENT_TYPE P,'
      '110487663=           G_PRODUCT GP,'
      '110487664=           P_REP_TREE TR'
      
        '110487665=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA' +
        '||'#39#39'-'#39#39
      '110487666=       AND Z.IS_SPISANIE IN (0,2)'
      '110487667=       AND Z.IS_RESERVE = 0'
      '110487668=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110487669=       AND Z.G_CLIENT = GC.G_CLIENT'
      '110487670=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110487671=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110487672=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110487673=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110487674=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'Z.G_CLIENT, 1))'
      
        '110487675=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, GC.G_CLIENT_PARENT)'
      
        '110487676=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '110487677=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_ AND :TIME_BEGIN_ IS NULL)'
      '110487678=            OR'
      
        '110487679=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGI' +
        'N_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN' +
        '_ IS NOT NULL)'
      '110487680=           )'
      
        '110487681=       AND ((:G_CATEGORY_ CONTAINING '#39#39'~'#39#39'||TR.G_PRODU' +
        'CT||'#39#39'~'#39#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110487682=             OR'
      '110487683=             (:G_CATEGORY_ IS NULL)'
      '110487684=           )'
      
        '110487685=       AND ((:G_PRODUCT_ CONTAINING '#39#39'~'#39#39'||GP.G_PRODUC' +
        'T||'#39#39'~'#39#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110487686=             OR'
      '110487687=            (:G_PRODUCT_ IS NULL)'
      '110487688=           )'
      '110487689=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '110487690=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :N' +
        'OMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT_TENG' +
        'E_, :SUMM_, :DISCOUNT_SUMM_, :CLIENT_NAME_, :PAYMENT_NAME_, :PAT' +
        'H_'
      '110487691=  DO BEGIN'
      '110487692=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '110487693=        IF (LAST_PATH_ <> '#39#39#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069 +
        #1058#1054' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110487694=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110487695=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "' +
        'DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '110487696=            VALUES (:I, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39', :SUMM_ROL' +
        'L_, :DISCOUNT_SUMM_ROLL_, 1);'
      '110487697='
      '110487698=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110487699=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110487700=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + ' +
        'DISCOUNT_SUMM_ROLL_;'
      '110487701=            SUMM_ROLL_ = 0;'
      '110487702=            DISCOUNT_SUMM_ROLL_ = 0;'
      '110487703=            I = I + 1;'
      '110487704=        END'
      '110487705='
      '110487706=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110487707=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE' +
        '", ROW)'
      '110487708=        VALUES (:I, :PATH_, 1);'
      '110487709=        I = I + 1;'
      '110487710=    END'
      '110487711='
      
        '110487712=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "' +
        'TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, D' +
        'ISCOUNT, SUMM,'
      
        '110487713=                                         DISCOUNT_SUMM' +
        ', CLIENT_NAME, PAYMENT_TYPE, ROW)'
      
        '110487714=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCOD' +
        'E_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUN' +
        'T_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      '110487715=            :CLIENT_NAME_, :PAYMENT_NAME_, 0);'
      '110487716='
      '110487717=    I = I + 1;'
      '110487718=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '110487719=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOU' +
        'NT_SUMM_;'
      '110487720=    LAST_PATH_ = PATH_;'
      '110487721=  END'
      '110487722='
      '110487723=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110487724=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUM' +
        'M, DISCOUNT_SUMM, ROW)'
      
        '110487725=  VALUES (:I, '#39#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39#39', :SUMM_ROLL_, :DISCO' +
        'UNT_SUMM_ROLL_, 1);'
      '110487726='
      '110487727=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110487728=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110487729=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_S' +
        'UMM_ROLL_;'
      '110487730='
      
        '110487731=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUM' +
        'M, DISCOUNT_SUMM, ROW)'
      
        '110487732=  VALUES (:I, '#39#39#1048#1090#1086#1075#1086#39#39', :SUMM_ALL_, :DISCOUNT_SUMM_AL' +
        'L_, 2);'
      '110487733='
      
        '110487734=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCL' +
        'ATUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CL' +
        'IENT_NAME,'
      '110487735=             PAYMENT_TYPE, ROW'
      '110487736=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '110487737=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOME' +
        'NCLATUR_NUM, :TOVAR_NAME, :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUM' +
        'M, :DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW'
      '110487738=  do suspend;'
      '110487739='
      '110487740=WHEN ANY DO BEGIN'
      '110487741=    Err_code = -20500;'
      
        '110487742=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39#39') RETURNING_VALUES (:ERR_MSG' +
        ');'
      
        '110487743=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110487744=  END'
      '110487745=end'
      '110487746='#39';'
      '110487747='
      '110487748=EXECUTE STATEMENT '#39'ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '110487749=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110487750=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110487751=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110487752=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110487753=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110487754=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110487755=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110487756=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110487757=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '110487758=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED)'
      '110487759=RETURNS ('
      '110487760=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110487761=  ERR_CODE INTEGER,'
      '110487762=  ERR_MSG VARCHAR(1024))'
      '110487763=AS'
      
        '110487764=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'PAY_ZAKAZ_NA' +
        '_REAL'#39#39';'
      '110487765=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110487766=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110487767=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110487768=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'AMOUNT_ALL;'
      
        '110487769=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.' +
        'SUMM_PAYED;'
      
        '110487770=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      
        '110487771=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '110487772=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110487773=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110487774=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      '110487775=BEGIN'
      '110487776='
      '110487777=  IF (G_TOCHKA_ IS NULL) THEN'
      '110487778=    SELECT ID'
      '110487779=      FROM CUR_PARAMS'
      '110487780=     WHERE CUR_PARAMS = 2'
      '110487781=      INTO :G_TOCHKA_;'
      '110487782='
      '110487783=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110487784=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '110487785=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110487786=            INTO :AMOUNT_,'
      '110487787=                 :G_PRODUCT_'
      '110487788=      DO BEGIN'
      '110487789=          UPDATE LT_SKLAD_PRODUCT L'
      '110487790=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110487791=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110487792=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '110487793=      END'
      '110487794='
      
        '110487795=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZAK' +
        'AZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENG' +
        'E,'
      
        '110487796=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM, COST_PRICE)'
      
        '110487797=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '110487798=             NDS_SUMM, COST_PRICE'
      '110487799=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110487800='
      '110487801=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110487802=                                  :Z_DATE_,'
      '110487803=                                  :Z_TIME_,'
      '110487804=                                  :G_CLIENT_,'
      '110487805=                                  :G_PAYMENT_TYPE_,'
      '110487806=                                  :OSNOVANIE_,'
      
        '110487807=                                  :IS_SPISANIE_,   -- ' +
        ':IS_SPISANIE_'
      '110487808=                                  :NOTE_,'
      
        '110487809=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047#1040 +
        #1050#1040#1047#1040
      
        '110487810=                                  :SUMM_FACT_,  -- '#1048' '#1057 +
        #1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '110487811=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 1, SUMM_FACT_, 0),'
      
        '110487812=                                  DECODE(G_PAYMENT_TYP' +
        'E_, 2, SUMM_FACT_, 0),'
      '110487813=                                  0, --SUMM_BONUS_'
      '110487814=                                  0, --SUMM_BONUS_GOT_'
      
        '110487815=                                  null,         -- '#1057#1058#1040 +
        #1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '110487816=                                  0,            -- '#1057#1059#1052 +
        #1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '110487817=                                  0,    --BY_RECIPE'
      '110487818=                                  0     --IS_RESERVE'
      '110487819=                                  ,NULL  -- PAYMENTS_'
      '110487820=                                  )'
      '110487821=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110487822='
      '110487823=      if (ERR_CODE <> 0) then BEGIN'
      '110487824=        ERR_CODE = -20500;'
      '110487825=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110487826=        Exit;'
      '110487827=      END'
      '110487828='
      '110487829=      UPDATE ZAKAZ'
      '110487830=         SET IS_SPISANIE = 2'
      '110487831=       WHERE ZAKAZ = :ZAKAZ_;'
      '110487832='
      '110487833=      FOR SELECT T.AMOUNT,'
      '110487834=                 T.SUMM,'
      '110487835=                 T.G_PRODUCT,'
      '110487836=                 T.ZAKAZ_NA_REAL,'
      '110487837=                 T.ZAKAZ_DETAILS'
      '110487838=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110487839=            INTO :AMOUNT_,'
      '110487840=                 :Z_SUMM_,'
      '110487841=                 :G_PRODUCT_,'
      '110487842=                 :ZAKAZ_NA_REAL_,'
      '110487843=                 :ZAKAZ_DETAILS_'
      '110487844=      DO BEGIN'
      '110487845=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110487846=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMOU' +
        'NT_,'
      
        '110487847=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110487848=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110487849=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110487850='
      
        '110487851=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110487852=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110487853=      END'
      '110487854=  END'
      '110487855='
      '110487856=  ELSE BEGIN'
      '110487857=      FOR SELECT T.AMOUNT,'
      '110487858=                 T.SUMM,'
      '110487859=                 T.G_PRODUCT,'
      '110487860=                 T.ZAKAZ_NA_REAL,'
      '110487861=                 T.ZAKAZ_DETAILS'
      '110487862=                 ,T.PRICE'
      '110487863=                 ,T.NDS'
      '110487864=                 ,T.NDS_SUMM'
      '110487865=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110487866=            INTO :AMOUNT_,'
      '110487867=                 :Z_SUMM_,'
      '110487868=                 :G_PRODUCT_,'
      '110487869=                 :ZAKAZ_NA_REAL_,'
      '110487870=                 :ZAKAZ_DETAILS_'
      '110487871=                 ,:PRICE_'
      '110487872=                 ,:NDS_'
      '110487873=                 ,:NDS_SUMM_'
      '110487874=      DO BEGIN'
      
        '110487875=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUN' +
        'T, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110487876=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '110487877='
      
        '110487878=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110487879=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110487880='
      '110487881=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110487882=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :AMOUNT_,'
      
        '110487883=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110487884=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':AMOUNT_, 1, 0)'
      '110487885=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110487886=      END'
      '110487887='
      '110487888=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110487889=                                  :Z_DATE_,'
      '110487890=                                  :Z_TIME_,'
      '110487891=                                  :G_CLIENT_,'
      '110487892=                                  :G_PAYMENT_TYPE_,'
      '110487893=                                  :OSNOVANIE_,'
      '110487894=                                  :NOTE_,'
      
        '110487895=                                  2,        --:IS_VOZV' +
        'RAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2-' +
        #1050#1059
      '110487896=                                  :SUMM_,'
      '110487897=                                  :SUMM_FACT_,'
      
        '110487898=                                  NULL,     --:G_PRIHO' +
        'D_,'
      
        '110487899=                                  NULL      --:SUMM_PR' +
        'IHOD_'
      
        '110487900=                                  ,NULL     -- PAYMENT' +
        'S'
      
        '110487901=                                  ) RETURNING_VALUES :' +
        'SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110487902='
      '110487903=      if (ERR_CODE <> 0) then BEGIN'
      '110487904=        ERR_CODE = -20500;'
      '110487905=        ERR_MSG = PROCNAME||'#39#39' -> '#39#39'||ERR_MSG;'
      '110487906=        Exit;'
      '110487907=      END'
      '110487908=  END'
      '110487909=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '110487910=END'
      '110487911='#39';'
      '110487912='
      '110487913=EXECUTE STATEMENT '#39'ALTER PROCEDURE R_FILL_REVISION('
      '110487914=  G_PRODUCT_PAR_ VARCHAR(2000),'
      '110487915=  G_PRODUCT_ VARCHAR(2000),'
      '110487916=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110487917=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '110487918=  TYPE_ INTEGER)'
      '110487919=RETURNS ('
      '110487920=  ERR_CODE INTEGER,'
      '110487921=  ERR_MSG VARCHAR(1024))'
      '110487922=AS'
      
        '110487923=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN LT_SKLAD_PR' +
        'ODUCT.AMOUNT;'
      
        '110487924=DECLARE VARIABLE G_PRODUCT__ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.G_PRODUCT;'
      '110487925=DECLARE VARIABLE I INTEGER = 1;'
      '110487926=BEGIN'
      '110487927='
      '110487928=  DELETE FROM REVISION WHERE REVISION = REVISION;'
      '110487929='
      '110487930=  IF (G_TOCHKA_ IS NULL) THEN'
      '110487931=    SELECT ID'
      '110487932=      FROM CUR_PARAMS'
      '110487933=     WHERE CUR_PARAMS = 2'
      '110487934=      INTO :G_TOCHKA_;'
      '110487935='
      '110487936=  -- '#1056#1045#1042#1048#1047#1048#1071' '#1044#1051#1071' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1041#1044
      '110487937=  IF (COALESCE(SKLAD_, 0) = 0) THEN BEGIN'
      '110487938=      FOR SELECT G.G_PRODUCT,'
      '110487939=                 COALESCE(LT.AMOUNT, 0)'
      
        '110487940=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, AMOUNT'
      
        '110487941=                                                FROM L' +
        'T_SKLAD_PRODUCT'
      
        '110487942=                                               WHERE G' +
        '_TOCHKA = :G_TOCHKA_) LT ON G.g_product = LT.g_product'
      '110487943=           WHERE G.IS_ACTIVE = 1'
      
        '110487944=             AND ((:G_PRODUCT_PAR_ CONTAINING '#39#39'~'#39#39'||G' +
        '.G_PRODUCT_PAR||'#39#39'~'#39#39' AND :G_PRODUCT_PAR_ IS NOT NULL)'
      '110487945=                  OR'
      '110487946=                  (:G_PRODUCT_PAR_ IS NULL)'
      '110487947=                 )'
      
        '110487948=             AND ((:G_PRODUCT_ CONTAINING '#39#39'~'#39#39'||G.G_P' +
        'RODUCT||'#39#39'~'#39#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110487949=                  OR'
      '110487950=                  (:G_PRODUCT_ IS NULL)'
      '110487951=                 )'
      '110487952=             AND G.IS_CATEGORY = 0'
      '110487953=          ORDER BY 1'
      '110487954=          INTO :G_PRODUCT__,'
      '110487955=               :AMOUNT_BD_'
      '110487956=      DO BEGIN'
      '110487957='
      
        '110487958=        INSERT INTO REVISION (REVISION, SKLAD, G_PRODU' +
        'CT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '110487959=        VALUES (:I, NULL, :G_PRODUCT__, :AMOUNT_BD_, 0' +
        ', 0, :G_TOCHKA_);'
      '110487960='
      '110487961=        I = I + 1;'
      '110487962=      END'
      '110487963='
      '110487964=  END ELSE BEGIN'
      '110487965=      FOR SELECT SS.G_PRODUCT,'
      '110487966=                 SS.AMOUNT'
      '110487967=            FROM SKLAD_PARENT S, SKLAD SS'
      '110487968=           WHERE S.SKLAD = :SKLAD_'
      '110487969=             AND S.SKLAD = SS.SKLAD_PARENT'
      
        '110487970=             AND S.G_TOCHKA = (SELECT ID FROM CUR_PARA' +
        'MS WHERE CUR_PARAMS = 2)'
      '110487971=          ORDER BY 1'
      '110487972=          INTO :G_PRODUCT__,'
      '110487973=               :AMOUNT_BD_'
      '110487974=      DO BEGIN'
      '110487975='
      
        '110487976=        INSERT INTO REVISION (REVISION, SKLAD, G_PRODU' +
        'CT, AMOUNT_BD, AMOUNT_REAL, IS_UNIFIED, G_TOCHKA)'
      
        '110487977=        VALUES (:I, NULL, :G_PRODUCT__, :AMOUNT_BD_, 0' +
        ', 0, :G_TOCHKA_);'
      '110487978='
      '110487979=        I = I + 1;'
      '110487980=      END'
      '110487981=  END'
      '110487982=END'
      '110487983='#39';'
      '110487984='
      '110487985=EXECUTE STATEMENT '#39'ALTER PROCEDURE R_UNIFICATION('
      '110487986=  MODE_ INTEGER)'
      '110487987=RETURNS ('
      '110487988=  COUNT_SPIS_ INTEGER,'
      '110487989=  COUNT_PRIH_ INTEGER,'
      '110487990=  ERR_CODE INTEGER,'
      '110487991=  ERR_MSG VARCHAR(1024))'
      '110487992=AS'
      
        '110487993=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39#39'R_UNIFICATIO' +
        'N'#39#39';'
      '110487994=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110487995=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.REV' +
        'ISION;'
      
        '110487996=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G_' +
        'PRODUCT;'
      
        '110487997=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.AM' +
        'OUNT_BD;'
      
        '110487998=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION.' +
        'AMOUNT_REAL;'
      
        '110487999=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRIC' +
        'E;'
      '110488000=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110488001=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUM' +
        'M;'
      
        '110488002=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SK' +
        'LAD;'
      
        '110488003=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110488004=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      '110488005=BEGIN'
      '110488006='
      '110488007=  COUNT_SPIS_ = 0;'
      '110488008=  COUNT_PRIH_ = 0;'
      '110488009='
      '110488010=  SELECT ID'
      '110488011=    FROM CUR_PARAMS'
      '110488012=   WHERE CUR_PARAMS = 2'
      '110488013=    INTO :G_TOCHKA_;'
      '110488014='
      
        '110488015=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_RE' +
        'AL'
      '110488016=      FROM REVISION'
      
        '110488017=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMOU' +
        'NT_REAL_'
      '110488018=  DO BEGIN'
      
        '110488019=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,2' +
        '))) THEN BEGIN'
      
        '110488020=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, NULL, 1)'
      '110488021=        RETURNING_VALUES :COST_PRICE_;'
      '110488022='
      
        '110488023=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G_' +
        'PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '110488024=                                     DISCOUNT_SUMM, ND' +
        'S, NDS_SUMM)'
      
        '110488025=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AMO' +
        'UNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '110488026='
      '110488027=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '110488028=    END'
      '110488029='
      
        '110488030=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,1' +
        '))) then BEGIN'
      '110488031=      SELECT S.PRICE'
      '110488032=        FROM SKLAD S'
      '110488033=       WHERE S.IS_LAST = 1'
      '110488034=         AND S.G_PRODUCT = :G_PRODUCT_'
      '110488035=         AND S.G_TOCHKA = :G_TOCHKA_'
      '110488036=        INTO :PRICE_LAST_;'
      '110488037='
      
        '110488038=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044#1056 +
        #1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '110488039='
      
        '110488040=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110488041=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :AM' +
        'OUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '110488042='
      '110488043=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '110488044=    END'
      '110488045='
      '110488046=    UPDATE REVISION R'
      '110488047=       SET R.IS_UNIFIED = 1'
      '110488048=     WHERE R.REVISION = :REVISION_;'
      '110488049=  END'
      '110488050='
      '110488051=  PNT_ = '#39#39'01'#39#39';'
      '110488052=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '110488053=    SELECT SUM(S.SUMM)'
      '110488054=      FROM ZAKAZ_DETAILS_TMP S'
      '110488055=      INTO :SUMM_;'
      '110488056='
      '110488057=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110488058=                                CURRENT_DATE, --:Z_DAT' +
        'E_,'
      
        '110488059=                                CURRENT_TIME, --:Z_TIM' +
        'E'
      
        '110488060=                                10,          --:G_CLIE' +
        'NT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '110488061=                                1,            --:G_PAY' +
        'MENT_TYPE_,'
      
        '110488062=                                NULL,         --:OSNOV' +
        'ANIE_,'
      
        '110488063=                                1,              --:IS_' +
        'SPISANIE_,'
      
        '110488064=                                NULL,           --:NOT' +
        'E_,'
      
        '110488065=                                :SUMM_,              -' +
        '-:SUMM_,'
      
        '110488066=                                :SUMM_,              -' +
        '-:SUMM_FACT_,'
      
        '110488067=                                0,              --SUMM' +
        '_BONUS_'
      
        '110488068=                                0,              --SUMM' +
        '_BONUS_GOT'
      
        '110488069=                                NULL,           --:G_P' +
        'RIHOD_,'
      '110488070=                                NULL,'
      '110488071=                                0,        -- BY_RECIPE'
      
        '110488072=                                0         -- IS_RESERV' +
        'E'
      '110488073=                                ,NULL  -- PAYMENTS_'
      '110488074=                                ,0     -- SUMM_CASH'
      '110488075=                                ,0     -- SUMM_NONCASH'
      
        '110488076=                                ) RETURNING_VALUES :ZA' +
        'KAZ_, :ERR_CODE, :ERR_MSG;'
      '110488077=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488078=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110488079=      EXIT;'
      '110488080=    END'
      '110488081=  END'
      '110488082='
      '110488083=  PNT_ = '#39#39'02'#39#39';'
      '110488084=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '110488085=    SELECT SUM(S.SUMM)'
      '110488086=      FROM SKLAD_TMP S'
      '110488087=      INTO :SUMM_;'
      '110488088='
      '110488089=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110488090=                                CURRENT_DATE,   --:DAT' +
        'E_RECEIPT_,'
      '110488091=                                CURRENT_TIME,'
      
        '110488092=                                NULL,           --:G_C' +
        'LIENT_,'
      
        '110488093=                                1,              --:G_P' +
        'AYMENT_TYPE_,'
      
        '110488094=                                NULL,           --:OSN' +
        'OVANIE_,'
      
        '110488095=                                '#39#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39#39', ' +
        '          --:NOTE_,'
      
        '110488096=                                5,              --:IS_' +
        'VOZVRAT_,'
      '110488097=                                :SUMM_,'
      '110488098=                                :SUMM_,'
      
        '110488099=                                NULL,           --:G_P' +
        'RIHOD_,'
      
        '110488100=                                NULL            --:SUM' +
        'M_PRIHOD_'
      '110488101=                                ,NULL  --PAYMENTS'
      '110488102=                                )'
      '110488103=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110488104=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488105=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110488106=      EXIT;'
      '110488107=    END'
      '110488108=  END'
      '110488109=END'
      '110488110='#39';'
      '110488111='
      '110488112=EXECUTE STATEMENT '#39'ALTER PROCEDURE R_UPD_REVISION('
      '110488113=  REVISION_ TYPE OF COLUMN REVISION.REVISION,'
      '110488114=  AMOUNT_REAL_ TYPE OF COLUMN REVISION.AMOUNT_REAL)'
      '110488115=RETURNS ('
      '110488116=  ERR_CODE INTEGER,'
      '110488117=  ERR_MSG VARCHAR(1024))'
      '110488118=AS'
      '110488119=begin'
      '110488120=   UPDATE REVISION'
      '110488121=   SET AMOUNT_REAL = :AMOUNT_REAL_'
      '110488122=   WHERE REVISION = :REVISION_;'
      '110488123=end'
      '110488124='#39';'
      '110488125='
      '110488126=EXECUTE STATEMENT '#39'ALTER PROCEDURE SYNC_DOWNLOAD('
      '110488127=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110488128=  UPLOAD_TABLE_TMP TYPE OF COLUMN UPLOAD_TABLE_TMP.UPL' +
        'OAD_TABLE_TMP,'
      '110488129=  MODE TYPE OF COLUMN UPLOAD_TABLE_TMP.MODE,'
      '110488130=  PARENT TYPE OF COLUMN UPLOAD_TABLE_TMP.PARENT,'
      '110488131=  DATE_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.DATE_OPER,'
      '110488132=  TIME_OPER TYPE OF COLUMN UPLOAD_TABLE_TMP.TIME_OPER,'
      '110488133=  G_CLIENT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_CLIENT,'
      
        '110488134=  G_PAYMENT_TYPE TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PAY' +
        'MENT_TYPE,'
      '110488135=  SUMM_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_ALL,'
      
        '110488136=  SUMM_FACT_ALL TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_F' +
        'ACT_ALL,'
      
        '110488137=  SUMM_PAY_BONUS TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'PAY_BONUS,'
      
        '110488138=  SUMM_BONUS_GOT TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM_' +
        'BONUS_GOT,'
      '110488139=  OSNOVANIE TYPE OF COLUMN UPLOAD_TABLE_TMP.OSNOVANIE,'
      '110488140=  NOTE TYPE OF COLUMN UPLOAD_TABLE_TMP.NOTE,'
      
        '110488141=  G_OFFICIAL TYPE OF COLUMN UPLOAD_TABLE_TMP.G_OFFICIA' +
        'L,'
      '110488142=  G_PRODUCT TYPE OF COLUMN UPLOAD_TABLE_TMP.G_PRODUCT,'
      '110488143=  AMOUNT TYPE OF COLUMN UPLOAD_TABLE_TMP.AMOUNT,'
      '110488144=  PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.PRICE,'
      '110488145=  SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.SUMM,'
      
        '110488146=  DISCOUNT_PERC TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_PERC,'
      
        '110488147=  DISCOUNT_TENGE TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCO' +
        'UNT_TENGE,'
      
        '110488148=  DISCOUNT_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.DISCOU' +
        'NT_SUMM,'
      '110488149=  NDS TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS,'
      '110488150=  NDS_SUMM TYPE OF COLUMN UPLOAD_TABLE_TMP.NDS_SUMM,'
      
        '110488151=  COST_PRICE TYPE OF COLUMN UPLOAD_TABLE_TMP.COST_PRIC' +
        'E,'
      '110488152=  BY_RECIPE TYPE OF COLUMN UPLOAD_TABLE_TMP.BY_RECIPE,'
      
        '110488153=  IS_RESERVE TYPE OF COLUMN UPLOAD_TABLE_TMP.IS_RESERV' +
        'E,'
      '110488154=  PAYMENTS BLOB SUB_TYPE 1,'
      '110488155=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110488156=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110488157=  IS_LOAD_ INTEGER)'
      '110488158=RETURNS ('
      '110488159=  ERR_CODE INTEGER,'
      '110488160=  ERR_MSG VARCHAR(1024))'
      '110488161=AS'
      
        '110488162=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'SYNC_DOWNLOA' +
        'D'#39#39';'
      '110488163=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110488164=DECLARE VARIABLE MODE_ TYPE OF COLUMN UPLOAD_TABLE_TMP' +
        '.MODE;'
      
        '110488165=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110488166=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110488167=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110488168=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110488169=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110488170=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110488171=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.COST_PRICE;'
      
        '110488172=DECLARE VARIABLE BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RE' +
        'CIPE;'
      
        '110488173=DECLARE VARIABLE BY_RECIPE__ TYPE OF COLUMN ZAKAZ.BY_R' +
        'ECIPE;'
      
        '110488174=DECLARE VARIABLE IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_R' +
        'ESERVE;'
      
        '110488175=DECLARE VARIABLE IS_RESERVE__ TYPE OF COLUMN ZAKAZ.IS_' +
        'RESERVE;'
      
        '110488176=DECLARE VARIABLE PAYMENTS_ BLOB SUB_TYPE 1 SEGMENT SIZ' +
        'E 80;'
      
        '110488177=DECLARE VARIABLE PAYMENTS__ BLOB SUB_TYPE 1 SEGMENT SI' +
        'ZE 80;'
      
        '110488178=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT' +
        '.G_CLIENT;'
      
        '110488179=DECLARE VARIABLE G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_' +
        'PARENT.G_PAYMENT_TYPE;'
      
        '110488180=DECLARE VARIABLE OSNOVANIE_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.OSNOVANIE;'
      
        '110488181=DECLARE VARIABLE NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOT' +
        'E;'
      
        '110488182=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN SKLAD_PARENT' +
        '.SUMM;'
      
        '110488183=DECLARE VARIABLE SUMM_FACT_ALL_ TYPE OF COLUMN SKLAD_P' +
        'ARENT.SUMM_FACT;'
      
        '110488184=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS;'
      
        '110488185=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110488186=DECLARE VARIABLE PARENT_ TYPE OF COLUMN UPLOAD_TABLE_T' +
        'MP.PARENT;'
      
        '110488187=DECLARE VARIABLE PARENT_OLD_ TYPE OF COLUMN UPLOAD_TAB' +
        'LE_TMP.PARENT;'
      '110488188=DECLARE VARIABLE MODE_OLD_ INTEGER;'
      '110488189=DECLARE VARIABLE DATE_OPER__ DATE;'
      '110488190=DECLARE VARIABLE TIME_OPER__ TIME;'
      
        '110488191=DECLARE VARIABLE G_CLIENT__ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '110488192=DECLARE VARIABLE G_PAYMENT_TYPE__ TYPE OF COLUMN G_PAY' +
        'MENT_TYPE.G_PAYMENT_TYPE;'
      
        '110488193=DECLARE VARIABLE OSNOVANIE__ TYPE OF COLUMN ZAKAZ.OSNO' +
        'VANIE;'
      '110488194=DECLARE VARIABLE NOTE__ TYPE OF COLUMN ZAKAZ.NOTE;'
      '110488195=DECLARE VARIABLE SUMM__ NUMERIC(15,2);'
      '110488196=DECLARE VARIABLE SUMM_FACT__ NUMERIC(15,2);'
      
        '110488197=DECLARE VARIABLE SUMM_CASH__ TYPE OF COLUMN ZAKAZ.SUMM' +
        '_CASH;'
      
        '110488198=DECLARE VARIABLE SUMM_NONCASH__ TYPE OF COLUMN ZAKAZ.S' +
        'UMM_NONCASH;'
      
        '110488199=DECLARE VARIABLE SUMM_PAY_BONUS__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '110488200=DECLARE VARIABLE SUMM_BONUS_GOT__ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '110488201=DECLARE VARIABLE G_OFFICIAL__ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '110488202=DECLARE VARIABLE ALLOW_SELL_ABSENT_GOODS_ NUMERIC(15,2' +
        ');'
      
        '110488203=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      '110488204=DECLARE VARIABLE DATE_OPER_ DATE;'
      '110488205=DECLARE VARIABLE TIME_OPER_ TIME;'
      
        '110488206=DECLARE VARIABLE DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_PERC;'
      
        '110488207=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110488208=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM;'
      
        '110488209=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN ZAKAZ.G_OF' +
        'FICIAL;'
      
        '110488210=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PAR' +
        'ENT;'
      '110488211=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '110488212=DECLARE VARIABLE IS_FIRST_TIME_ INTEGER = 0; /* '#1054#1041#1056#1040#1041#1040 +
        #1058#1067#1042#1040#1045#1058#1057#1071' '#1055#1045#1056#1042#1040#1071' '#1057#1058#1056#1054#1050#1040' 0, '#1057#1051#1045#1044#1059#1070#1065#1048#1045' '#1057#1058#1056#1054#1050#1048' = 1 */'
      '110488213=BEGIN'
      '110488214=  PNT_ = '#39#39'00'#39#39';'
      '110488215=  IF (IS_LOAD_ = 0) THEN BEGIN'
      '110488216=      SELECT 1'
      '110488217=        FROM G_PRODUCT G'
      '110488218=       WHERE G.G_PRODUCT = :G_PRODUCT'
      '110488219=       INTO :G_PRODUCT_;'
      '110488220='
      '110488221=      IF (G_PRODUCT_ IS NULL) THEN BEGIN'
      '110488222=        ERR_CODE = -20500;'
      
        '110488223=        ERR_MSG  = '#39#39#1054#1096#1080#1073#1082#1072': '#1090#1086#1074#1072#1088' '#1089' '#1080#1076#1077#1085#1090#1080#1092#1080#1082#1072#1090#1086#1088#1086#1084' '#39 +
        #39'||G_PRODUCT||'#39#39' '#1086#1090#1089#1091#1090#1089#1090#1074#1091#1077#1090' '#1074' '#1073#1072#1079#1077' '#1076#1072#1085#1085#1099#1093'.'#39#39';'
      '110488224=        Exit;'
      '110488225=      END'
      '110488226='
      
        '110488227=      INSERT INTO UPLOAD_TABLE_TMP (UPLOAD_TABLE_TMP, ' +
        'MODE, PARENT, DATE_OPER, TIME_OPER, G_CLIENT, G_PAYMENT_TYPE,'
      
        '110488228=                                    SUMM_ALL, SUMM_FAC' +
        'T_ALL, SUMM_PAY_BONUS, SUMM_BONUS_GOT, OSNOVANIE, NOTE, G_OFFICI' +
        'AL, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC,'
      
        '110488229=                                    DISCOUNT_TENGE, DI' +
        'SCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE, BY_RECIPE, IS_RESERVE, P' +
        'AYMENTS)'
      
        '110488230=      VALUES (:UPLOAD_TABLE_TMP, :MODE, :PARENT, :DATE' +
        '_OPER, :TIME_OPER, DECODE(:G_CLIENT, 0, NULL, :G_CLIENT), :G_PAY' +
        'MENT_TYPE,'
      
        '110488231=              :SUMM_ALL, :SUMM_FACT_ALL, :SUMM_PAY_BON' +
        'US, :SUMM_BONUS_GOT, :OSNOVANIE, :NOTE, :G_OFFICIAL, :G_PRODUCT,' +
        ' :AMOUNT, :PRICE, :SUMM, :DISCOUNT_PERC,'
      
        '110488232=              :DISCOUNT_TENGE, :DISCOUNT_SUMM, :NDS, :' +
        'NDS_SUMM, :COST_PRICE, :BY_RECIPE, :IS_RESERVE, :PAYMENTS);'
      '110488233='
      '110488234=  END ELSE BEGIN'
      '110488235=      PNT_ = '#39#39'01'#39#39';'
      '110488236=      IF (G_TOCHKA_ IS NULL) THEN'
      '110488237=        SELECT ID'
      '110488238=          FROM CUR_PARAMS'
      '110488239=         WHERE CUR_PARAMS = 2'
      '110488240=          INTO :G_TOCHKA_;'
      '110488241='
      
        '110488242=      FOR SELECT MODE, PARENT, DATE_OPER, TIME_OPER, G' +
        '_CLIENT, G_PAYMENT_TYPE, SUMM_ALL, SUMM_FACT_ALL, SUMM_PAY_BONUS' +
        ', SUMM_BONUS_GOT, OSNOVANIE,'
      
        '110488243=                 NOTE, G_OFFICIAL, G_PRODUCT, AMOUNT, ' +
        'PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      
        '110488244=                 NDS_SUMM, COST_PRICE, BY_RECIPE, IS_R' +
        'ESERVE, PAYMENTS'
      '110488245=          FROM UPLOAD_TABLE_TMP'
      
        '110488246=          WHERE MODE <> 6        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056 +
        #1040' '#1041#1059#1044#1059' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068' '#1054#1058#1044#1045#1051#1068#1053#1054', '#1058#1040#1052' '#1044#1056#1059#1043#1054#1049' '#1055#1056#1048#1053#1062#1048#1055
      '110488247=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110488248=          INTO :MODE_, :PARENT_, :DATE_OPER_, :TIME_OP' +
        'ER_, :G_CLIENT_, :G_PAYMENT_TYPE_, :SUMM_ALL_, :SUMM_FACT_ALL_, ' +
        ' :SUMM_PAY_BONUS_, :SUMM_BONUS_GOT_,'
      
        '110488249=               :OSNOVANIE_, :NOTE_, :G_OFFICIAL_, :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :DISCOUNT_PERC_, :DISCOUNT_T' +
        'ENGE_,'
      
        '110488250=               :DISCOUNT_SUMM_, :NDS_, :NDS_SUMM_, :CO' +
        'ST_PRICE_, :BY_RECIPE_, :IS_RESERVE_, :PAYMENTS_'
      '110488251=      DO BEGIN'
      '110488252=          -- '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055#1056#1048#1061#1054#1044#1040
      '110488253=          PNT_ = '#39#39'02'#39#39';'
      
        '110488254=          IF (PARENT_ <> PARENT_OLD_ AND IS_FIRST_TIME' +
        '_ = 1) THEN BEGIN'
      '110488255=            IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '110488256=              PNT_ = '#39#39'02a'#39#39';'
      '110488257=              EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '110488258=                                          :DATE_OPER__' +
        ','
      
        '110488259=                                          :TIME_OPER__' +
        ','
      '110488260=                                          :G_CLIENT__,'
      
        '110488261=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110488262=                                          :OSNOVANIE__' +
        ','
      '110488263=                                          :NOTE__,'
      
        '110488264=                                          DECODE(:MODE' +
        '_OLD_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '110488265=                                          :SUMM__,'
      
        '110488266=                                          :SUMM_FACT__' +
        ','
      
        '110488267=                                          0, --:G_PRIH' +
        'OD_,'
      
        '110488268=                                          0 --:SUMM_PR' +
        'IHOD_)'
      
        '110488269=                                          ,:PAYMENTS__' +
        '  -- PAYMENTS'
      
        '110488270=                                         )RETURNING_VA' +
        'LUES :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110488271=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110488272=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090 +
        #1086#1074#1072#1088#1072' (01).'#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG)' +
        ' + 3 FOR CHAR_LENGTH(ERR_MSG));'
      '110488273=                EXIT;'
      '110488274=              END'
      '110488275=            END'
      '110488276=            ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '110488277=              PNT_ = '#39#39'03'#39#39';'
      '110488278=              EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '110488279=                                          :DATE_OPER__' +
        ','
      
        '110488280=                                          :TIME_OPER__' +
        ','
      '110488281=                                          :G_CLIENT__,'
      
        '110488282=                                          :G_PAYMENT_T' +
        'YPE__,'
      
        '110488283=                                          :OSNOVANIE__' +
        ','
      
        '110488284=                                          DECODE(MODE_' +
        'OLD_,'
      
        '110488285=                                                 2, 0,' +
        '   -- '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '110488286=                                                 3, 1,' +
        '   -- '#1057#1055#1048#1057#1040#1053#1048#1045
      
        '110488287=                                                 5, 3)' +
        ',  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110488288=                                          :NOTE__,'
      '110488289=                                          :SUMM__,'
      
        '110488290=                                          :SUMM_FACT__' +
        ','
      
        '110488291=                                          :SUMM_CASH__' +
        ','
      
        '110488292=                                          :SUMM_NONCAS' +
        'H__,'
      
        '110488293=                                          :SUMM_PAY_BO' +
        'NUS__,'
      
        '110488294=                                          :SUMM_BONUS_' +
        'GOT__,'
      
        '110488295=                                          NULL,       ' +
        ' --:G_PRIHOD_,'
      
        '110488296=                                          NULL,       ' +
        ' --:SUMM_PRIHOD_'
      
        '110488297=                                          :BY_RECIPE__' +
        ','
      
        '110488298=                                          :IS_RESERVE_' +
        '_'
      '110488299=                                          ,:PAYMENTS__'
      '110488300=                                          )'
      
        '110488301=                                          RETURNING_VA' +
        'LUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110488302=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110488303=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077 +
        ' (02). '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3' +
        ' FOR CHAR_LENGTH(ERR_MSG));'
      '110488304=                EXIT;'
      '110488305=              END'
      '110488306='
      '110488307=              PNT_ = '#39#39'03a'#39#39';'
      '110488308=              UPDATE ZAKAZ Z'
      
        '110488309=              SET Z.G_OFFICIAL = DECODE(:G_OFFICIAL__,' +
        ' 0, NULL, NULL, NULL)'
      '110488310=              WHERE Z.ZAKAZ = :ZAKAZ_;'
      '110488311=            END'
      '110488312=          END'
      
        '110488313=          -- '#1050#1054#1053#1045#1062' '#1042#1057#1058#1040#1042#1050#1040' '#1054#1050#1054#1053#1063#1040#1058#1045#1051#1068#1053#1054#1043#1054' '#1047#1040#1050#1040#1047#1040' '#1048#1051#1048' '#1055 +
        #1056#1048#1061#1054#1044#1040
      
        '110488314=          -- '#1053#1040#1063#1040#1051#1054' '#1042#1057#1058#1040#1042#1050#1048' '#1044#1045#1058#1040#1051#1045#1049' '#1055#1054' '#1055#1056#1048#1061#1054#1044#1059' '#1048#1051#1048' '#1047#1040#1050 +
        #1040#1047#1059' '#1058#1054#1042#1040#1056#1040
      '110488315='
      '110488316=          PNT_ = '#39#39'03b'#39#39';'
      '110488317=          IF (MODE_ IN (0,1,4)) THEN'
      
        '110488318=              INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT,' +
        ' AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110488319=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_P' +
        'RODUCT_, :AMOUNT_, :PRICE_, :SUMM_, :NDS_, :NDS_SUMM_);'
      '110488320='
      '110488321=          ELSE IF (MODE_ IN (2,3,5)) THEN BEGIN'
      '110488322=              PNT_ = '#39#39'04'#39#39';'
      '110488323=              SELECT S.S_VALUE'
      '110488324=              FROM SYSTEM_SETUP S'
      '110488325=              WHERE S.SYSTEM_SETUP = 2'
      '110488326=              INTO :ALLOW_SELL_ABSENT_GOODS_;'
      '110488327='
      
        '110488328=              EXECUTE PROCEDURE INS_ZAKAZ_DETAILS_TMP(' +
        ':G_PRODUCT_,'
      
        '110488329=                                                      ' +
        ':AMOUNT_,'
      
        '110488330=                                                      ' +
        ':PRICE_,'
      
        '110488331=                                                      ' +
        ':SUMM_,'
      
        '110488332=                                                      ' +
        ':DISCOUNT_PERC_,'
      
        '110488333=                                                      ' +
        ':DISCOUNT_TENGE_,'
      
        '110488334=                                                      ' +
        ':DISCOUNT_SUMM_,'
      
        '110488335=                                                      ' +
        ':NDS_,'
      
        '110488336=                                                      ' +
        ':NDS_SUMM_,'
      
        '110488337=                                                      ' +
        ':COST_PRICE_,'
      
        '110488338=                                                      ' +
        ':ALLOW_SELL_ABSENT_GOODS_,'
      
        '110488339=                                                      ' +
        '0,     --IS_SPISANIE_'
      
        '110488340=                                                      ' +
        '1,     -- NEW_LINE_SALE_'
      
        '110488341=                                                      ' +
        '0     --MODE_'
      
        '110488342=                                                      ' +
        ') RETURNING_VALUES :ZAKAZ_DETAILS_, :ERR_CODE, :ERR_MSG;'
      '110488343=              IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110488344=                ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077 +
        ' (03). '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3' +
        ' FOR CHAR_LENGTH(ERR_MSG));'
      '110488345=                EXIT;'
      '110488346=              END'
      '110488347=          END'
      '110488348='
      '110488349=          PARENT_OLD_ = PARENT_;'
      '110488350=          DATE_OPER__ = DATE_OPER_;'
      '110488351=          TIME_OPER__ = TIME_OPER_;'
      '110488352=          G_CLIENT__  = G_CLIENT_;'
      '110488353=          G_PAYMENT_TYPE__ = G_PAYMENT_TYPE_;'
      '110488354=          OSNOVANIE__      = OSNOVANIE_;'
      '110488355=          NOTE__           = NOTE_;'
      '110488356=          SUMM__           = SUMM_ALL_;'
      '110488357=          SUMM_FACT__      = SUMM_FACT_ALL_;'
      '110488358=          SUMM_PAY_BONUS__ = SUMM_PAY_BONUS_;'
      '110488359=          SUMM_BONUS_GOT__ = SUMM_BONUS_GOT_;'
      '110488360=          G_OFFICIAL__     = G_OFFICIAL_;'
      '110488361=          BY_RECIPE__      = BY_RECIPE_;'
      '110488362=          IS_RESERVE__     = COALESCE(IS_RESERVE_, 0);'
      '110488363=          IS_FIRST_TIME_   = 1;'
      '110488364=          PAYMENTS__       = PAYMENTS_;'
      '110488365=          MODE_OLD_        = MODE_;'
      '110488366=      END'
      '110488367='
      '110488368=      IF (MODE_OLD_ IN (0,1,4)) THEN BEGIN'
      '110488369=          PNT_ = '#39#39'05'#39#39';'
      '110488370=          EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110488371=                                      :DATE_OPER__,'
      '110488372=                                      :TIME_OPER__,'
      '110488373=                                      :G_CLIENT__,'
      
        '110488374=                                      :G_PAYMENT_TYPE_' +
        '_,'
      '110488375=                                      :OSNOVANIE__,'
      '110488376=                                      :NOTE__,'
      
        '110488377=                                      DECODE(:MODE_OLD' +
        '_, 4, 2, :MODE_OLD_), --:IS_VOZVRAT_,'
      '110488378=                                      :SUMM__,'
      '110488379=                                      :SUMM_FACT__,'
      '110488380=                                      0, --:G_PRIHOD_,'
      
        '110488381=                                      0 --:SUMM_PRIHOD' +
        '_)'
      '110488382=                                     ,:PAYMENTS__'
      
        '110488383=                                     )RETURNING_VALUES' +
        ' :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '110488384=          IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110488385=            ERR_MSG  =  '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1080#1093#1086#1076'/'#1074#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072 +
        #1088#1072' (04).'#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + ' +
        '3 FOR CHAR_LENGTH(ERR_MSG));'
      '110488386=            EXIT;'
      '110488387=          END'
      '110488388=      END'
      '110488389=      ELSE IF (MODE_OLD_ IN (2,3,5)) THEN BEGIN'
      '110488390=          PNT_ = '#39#39'06'#39#39';'
      '110488391=          EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '110488392=                                      :DATE_OPER__,'
      '110488393=                                      :TIME_OPER__,'
      '110488394=                                      :G_CLIENT__,'
      
        '110488395=                                      :G_PAYMENT_TYPE_' +
        '_,'
      '110488396=                                      :OSNOVANIE__,'
      
        '110488397=                                      DECODE(MODE_OLD_' +
        ', 2, 0, 3, 1),  --:IS_SPISANIE_,'
      '110488398=                                      :NOTE__,'
      '110488399=                                      :SUMM__,'
      '110488400=                                      :SUMM_FACT__,'
      '110488401=                                      :SUMM_CASH__,'
      '110488402=                                      :SUMM_NONCASH__,'
      
        '110488403=                                      :SUMM_PAY_BONUS_' +
        '_,'
      
        '110488404=                                      :SUMM_BONUS_GOT_' +
        '_,'
      
        '110488405=                                      NULL,        --:' +
        'G_PRIHOD_,'
      
        '110488406=                                      NULL,        --:' +
        'SUMM_PRIHOD_'
      '110488407=                                      :BY_RECIPE__,'
      '110488408=                                      :IS_RESERVE__'
      '110488409=                                      ,:PAYMENTS__'
      '110488410=                                      )'
      
        '110488411=                                      RETURNING_VALUES' +
        ' :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '110488412=          IF (ERR_CODE <> 0) THEN BEGIN'
      
        '110488413=            ERR_MSG  = '#39#39#1054#1087#1077#1088#1072#1094#1080#1103' '#1087#1088#1086#1076#1072#1078#1072'/'#1089#1087#1080#1089#1072#1085#1080#1077' (05' +
        '). '#39#39'||SUBSTRING(ERR_MSG FROM POSITION('#39#39'/R\'#39#39', ERR_MSG) + 3 FOR' +
        ' CHAR_LENGTH(ERR_MSG));'
      '110488414=            EXIT;'
      '110488415=          END'
      '110488416='
      '110488417=          UPDATE ZAKAZ Z'
      
        '110488418=          SET Z.G_OFFICIAL = DECODE(:G_OFFICIAL__, 0, ' +
        'NULL, NULL, NULL)'
      '110488419=          WHERE Z.ZAKAZ = :ZAKAZ_;'
      '110488420=      END'
      '110488421='
      '110488422=      -- '#1058#1045#1055#1045#1056#1068' '#1054#1041#1056#1040#1041#1040#1058#1067#1042#1040#1070#1058' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110488423=      FOR SELECT DATE_OPER, NOTE, G_PRODUCT, AMOUNT'
      '110488424=          FROM UPLOAD_TABLE_TMP'
      '110488425=          WHERE MODE = 6'
      '110488426=          ORDER BY UPLOAD_TABLE_TMP, PARENT'
      
        '110488427=          INTO :DATE_OPER_, :NOTE_, :G_PRODUCT_, :AMOU' +
        'NT_'
      '110488428=      DO BEGIN'
      '110488429=        EXECUTE PROCEDURE DO_PRODUCT(:G_TOCHKA_,'
      '110488430=                                   :DATE_OPER_,'
      '110488431=                                   :G_PRODUCT_,'
      '110488432=                                   :AMOUNT_,'
      '110488433=                                   :NOTE_)'
      
        '110488434=                                   RETURNING_VALUES :S' +
        'KLAD_, :ERR_CODE, :ERR_MSG;'
      '110488435=      END'
      '110488436='
      
        '110488437=      DELETE FROM UPLOAD_TABLE_TMP WHERE UPLOAD_TABLE_' +
        'TMP = UPLOAD_TABLE_TMP;'
      '110488438=  END'
      '110488439='
      '110488440=WHEN ANY DO BEGIN'
      '110488441=    Err_code = -20500;'
      
        '110488442=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1048'!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110488443=    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||ER' +
        'R_MSG;'
      '110488444=  END'
      '110488445=end'
      '110488446='#39';'
      '110488447=END  --END_EXECUTE_BLOCK'
      '110488448=EXECUTE BLOCK AS BEGIN'
      '110488449='
      '110488450=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD('
      '110488451=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110488452=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '110488453=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110488454=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110488455=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110488456=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110488457=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110488458=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110488459=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '110488460=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110488461=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110488462=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110488463=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110488464=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110488465=RETURNS ('
      '110488466=  ERR_CODE INTEGER,'
      '110488467=  ERR_MSG VARCHAR(1024))'
      '110488468=AS'
      
        '110488469=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110488470=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110488471=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      '110488472=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110488473=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110488474=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLAD' +
        '_PARENT.IS_EXPECTED;'
      
        '110488475=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110488476=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110488477=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110488478=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      '110488479=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110488480=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '110488481=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '110488482=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110488483=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110488484=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN SK' +
        'LAD.G_PAYMENT_TYPE;'
      
        '110488485=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLAD' +
        '.G_PAYMENT_TYPE;'
      
        '110488486=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT;'
      '110488487=DECLARE VARIABLE IS_THIS_LAST_ INTEGER;'
      
        '110488488=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110488489=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110488490=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110488491=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110488492=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110488493=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110488494=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110488495=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '110488496=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39';'
      
        '110488497=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110488498=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      '110488499=BEGIN'
      '110488500='
      '110488501=  IS_THIS_LAST_ = 0;'
      '110488502='
      '110488503=  SELECT S.G_TOCHKA,'
      '110488504=         S.IS_VOZVRAT,'
      '110488505=         S.G_PAYMENT_TYPE'
      '110488506=         ,S.is_expected'
      '110488507=    FROM SKLAD_parent S'
      '110488508=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '110488509=    INTO :G_TOCHKA_,'
      '110488510=         :IS_VOZVRAT_,'
      '110488511=         :G_PAYMENT_TYPE_OLD_'
      '110488512=         ,:IS_EXPECTED_OLD_;'
      '110488513='
      '110488514=  PNT_ = '#39#39'00'#39#39';'
      '110488515=  UPDATE SKLAD_PARENT'
      '110488516=  SET'
      
        '110488517=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEIP' +
        'T),'
      
        '110488518=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEIP' +
        'T),'
      
        '110488519=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYME' +
        'NT_TYPE),'
      '110488520=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110488521=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110488522=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '110488523=   SUMM      = :SUMM_,'
      '110488524=   SUMM_FACT = :SUMM_FACT_,'
      '110488525=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      '110488526=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0)'
      '110488527=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '110488528=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '110488529='
      '110488530=  PNT_ = '#39#39'02'#39#39';'
      '110488531=  FOR SELECT SKLAD'
      '110488532=        FROM SKLAD S'
      '110488533=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110488534=         AND NOT EXISTS (SELECT 1'
      '110488535=                           FROM SKLAD_TMP T'
      '110488536=                        WHERE T.SKLAD = S.SKLAD)'
      '110488537=  INTO :SKLAD_'
      '110488538=  DO BEGIN'
      
        '110488539=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_,' +
        ' :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110488540=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488541=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110488542=      EXIT;'
      '110488543=    END'
      '110488544=  END'
      '110488545='
      '110488546=  PNT_ = '#39#39'03'#39#39';'
      '110488547=  FOR SELECT S.SKLAD,'
      '110488548=             S.G_PRODUCT,'
      '110488549=             S.AMOUNT,'
      '110488550=             S.PRICE,'
      '110488551=             S.SUMM,'
      '110488552=             S.NDS,'
      '110488553=             S.NDS_SUMM,'
      '110488554=             T.SKLAD,'
      '110488555=             T.AMOUNT,'
      '110488556=             T.IS_LAST,'
      '110488557=             T.DATE_RECEIPT'
      '110488558=             ,S.PRICE_CURRENCY'
      '110488559=             ,S.SUMM_CURRENCY'
      
        '110488560=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLAD' +
        ', AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT = ' +
        ':SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '110488561=  INTO :SKLAD_,'
      '110488562=       :G_PRODUCT_,'
      '110488563=       :AMOUNT_,'
      '110488564=       :PRICE_,'
      '110488565=       :SUMM_ONE_,'
      '110488566=       :NDS_,'
      '110488567=       :NDS_SUMM_,'
      '110488568=       :SKLAD_OLD_,'
      '110488569=       :AMOUNT_OLD_,'
      '110488570=       :IS_THIS_LAST_,'
      '110488571=       :DATE_RECEIPT_OLD_'
      '110488572=       ,:PRICE_CURRENCY_'
      '110488573=       ,:SUMM_CURRENCY_TMP_'
      '110488574=  DO BEGIN'
      '110488575=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '110488576=        PNT_ = '#39#39'04'#39#39';'
      
        '110488577=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_R' +
        'ECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYPE' +
        ', NDS, NDS_SUMM,'
      
        '110488578=                          IS_LAST, NOTE, OSNOVANIE, IS' +
        '_VOZVRAT, G_TOCHKA'
      '110488579=                          ,PRICE_CURRENCY'
      '110488580=                          ,SUMM_CURRENCY)'
      
        '110488581=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIPT' +
        '_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_PA' +
        'YMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      '110488582=               0'
      
        '110488583=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :G' +
        '_TOCHKA_'
      '110488584=               ,:PRICE_CURRENCY_'
      '110488585=               ,:SUMM_CURRENCY_TMP_'
      '110488586=               );'
      '110488587='
      '110488588=        IF (IS_EXPECTED_ = 0) THEN BEGIN'
      '110488589=            UPDATE LT_SKLAD_PRODUCT L'
      '110488590=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110488591=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110488592=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110488593='
      '110488594=            IF (ROW_COUNT = 0) THEN'
      
        '110488595=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN' +
        '_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCHK' +
        'A_);'
      '110488596=        END'
      '110488597='
      '110488598=        PNT_ = '#39#39'05'#39#39';'
      '110488599=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '110488600=            SELECT MAX(SK.DATE_RECEIPT)'
      '110488601=              FROM SKLAD SK'
      '110488602=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110488603=               AND SK.IS_LAST = 1'
      '110488604=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110488605=              INTO :DATE_LAST_;'
      '110488606='
      
        '110488607=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' >= DATE_LAST_)) THEN BEGIN'
      '110488608=              UPDATE SKLAD SK'
      '110488609=                 SET SK.IS_LAST = 0'
      '110488610=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110488611=                 AND SK.IS_LAST = 1'
      '110488612=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110488613='
      '110488614=              UPDATE SKLAD SK'
      '110488615=                 SET SK.IS_LAST = 1'
      '110488616=               WHERE SK.SKLAD = :SKLAD_;'
      '110488617=            END'
      '110488618=        END'
      '110488619=    END ELSE BEGIN'
      '110488620=        PNT_ = '#39#39'06'#39#39';'
      '110488621=        UPDATE SKLAD S'
      '110488622=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '110488623=               S.G_CLIENT = :G_CLIENT_,'
      '110488624=               S.AMOUNT   = :AMOUNT_,'
      '110488625=               S.PRICE    = :PRICE_,'
      '110488626=               S.SUMM     = :SUMM_ONE_,'
      '110488627=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110488628=               S.NDS      = :NDS_,'
      '110488629=               S.NDS_SUMM = :NDS_SUMM_,'
      '110488630=               S.OSNOVANIE = :OSNOVANIE_,'
      '110488631=               S.NOTE      = :NOTE_'
      '110488632=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110488633=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP_'
      '110488634=         WHERE S.SKLAD = :SKLAD_;'
      '110488635='
      
        '110488636=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_) THEN BEGI' +
        'N'
      '110488637=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '110488638=              UPDATE LT_SKLAD_PRODUCT L'
      
        '110488639=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OL' +
        'D_ - :AMOUNT_)'
      '110488640=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110488641=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '110488642='
      '110488643=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '110488644=              UPDATE LT_SKLAD_PRODUCT L'
      
        '110488645=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ -' +
        ' :AMOUNT_OLD_)'
      '110488646=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110488647=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '110488648=        END'
      
        '110488649=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED_' +
        ' = 0) THEN BEGIN'
      '110488650=            UPDATE LT_SKLAD_PRODUCT L'
      '110488651=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '110488652=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110488653=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110488654='
      '110488655=            IF (ROW_COUNT = 0) THEN'
      
        '110488656=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN' +
        '_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCHK' +
        'A_);'
      '110488657=        END'
      '110488658=        ELSE BEGIN'
      '110488659=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110488660=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD_' +
        ' - :AMOUNT_) - :AMOUNT_'
      '110488661=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110488662=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110488663=        END'
      '110488664='
      '110488665=        PNT_ = '#39#39'07'#39#39';'
      
        '110488666=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110488667=            SELECT MAX(SK.DATE_RECEIPT)'
      '110488668=              FROM SKLAD SK'
      '110488669=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110488670=               AND SK.IS_LAST = 1'
      '110488671=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110488672=              INTO :DATE_LAST_;'
      '110488673='
      
        '110488674=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT_' +
        ' > DATE_LAST_)) THEN BEGIN'
      '110488675=              UPDATE SKLAD SK'
      '110488676=                 SET SK.IS_LAST = 0'
      '110488677=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110488678=                 AND SK.IS_LAST = 1'
      '110488679=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110488680='
      '110488681=              UPDATE SKLAD SK'
      '110488682=                 SET SK.IS_LAST = 1'
      '110488683=               WHERE SK.SKLAD = :SKLAD_;'
      '110488684=            END'
      '110488685=        END'
      '110488686='
      '110488687=        PNT_ = '#39#39'08'#39#39';'
      
        '110488688=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (I' +
        'S_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '110488689=            SELECT MAX(SK.DATE_RECEIPT)'
      '110488690=              FROM SKLAD SK'
      '110488691=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110488692=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '110488693=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '110488694=               AND SK.is_vozvrat IN (0,4)'
      '110488695=              INTO :DATE_LAST_;'
      '110488696='
      
        '110488697=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_REC' +
        'EIPT_ < DATE_LAST_)) THEN BEGIN'
      '110488698=              UPDATE SKLAD SK'
      '110488699=                 SET SK.IS_LAST = 0'
      '110488700=               WHERE SK.SKLAD = :SKLAD_;'
      '110488701='
      '110488702=               UPDATE SKLAD SK'
      '110488703=                 SET SK.IS_LAST = 1'
      '110488704=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110488705=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '110488706=                                   FROM SKLAD SS'
      
        '110488707=                                  WHERE SS.G_PRODUCT =' +
        ' SK.G_PRODUCT'
      
        '110488708=                                    AND SS.DATE_RECEIP' +
        'T = :DATE_LAST_'
      
        '110488709=                                    AND SS.G_TOCHKA = ' +
        ':G_TOCHKA_'
      
        '110488710=                                    AND SS.is_vozvrat ' +
        'IN (0,4));'
      '110488711='
      '110488712=            END'
      
        '110488713=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THIS' +
        '_LAST_ = 1)) THEN BEGIN'
      '110488714=              UPDATE SKLAD SK'
      '110488715=                 SET SK.IS_LAST = 1'
      '110488716=               WHERE SK.SKLAD = :SKLAD_;'
      '110488717=            END'
      '110488718=        END'
      '110488719=    END'
      '110488720=  END'
      '110488721='
      '110488722=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN'
      '110488723=      IF (IS_VOZVRAT_ = 0) THEN'
      '110488724=        G_PRIHOD_RASHOD_ = 2;'
      '110488725=      ELSE'
      '110488726=        G_PRIHOD_RASHOD_ = 3;'
      '110488727='
      '110488728=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110488729=            PNT_ = '#39#39'09'#39#39';'
      '110488730=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110488731=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110488732=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110488733=            ELSE'
      
        '110488734=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110488735='
      '110488736=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110488737=                RETURNING_VALUES :KASSA_, :PAYMENT_DAT' +
        'E_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110488738='
      
        '110488739=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110488740=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THEN'
      '110488741=                EXECUTE PROCEDURE K_INS_KASSA(1,'
      
        '110488742=                                              :G_PRIHO' +
        'D_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110488743=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110488744=                                              :PAYMENT' +
        '_DATE_,'
      
        '110488745=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110488746=                                              NULL,   ' +
        '--ZAKAZ_'
      
        '110488747=                                              :SKLAD_P' +
        'ARENT_,'
      
        '110488748=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110488749=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110488750='
      '110488751=            ELSE BEGIN'
      '110488752=                SELECT 1'
      '110488753=                  FROM KASSA K'
      '110488754=                 WHERE K.KASSA = :KASSA_'
      '110488755=                UNION ALL'
      '110488756=                SELECT 2'
      '110488757=                  FROM KASSA_BEZNAL KB'
      '110488758=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110488759=                 INTO :PAYMENT_TYPE_OLD_;'
      '110488760='
      
        '110488761=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110488762=                      PNT_ = '#39#39'010'#39#39';'
      
        '110488763=                      EXECUTE PROCEDURE K_UPD_KASSA(:K' +
        'ASSA_,'
      
        '110488764=                                                    1,' +
        '     -- ACTION_'
      
        '110488765=                                                    :G' +
        '_PRIHOD_RASHOD_,'
      
        '110488766=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110488767=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110488768=                                                    NU' +
        'LL,   --NOTE_'
      
        '110488769=                                                    NU' +
        'LL,  --ZAKAZ'
      
        '110488770=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110488771=                                                    :P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110488772='
      
        '110488773=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110488774=                      PNT_ = '#39#39'011'#39#39';'
      
        '110488775=                      EXECUTE PROCEDURE K_DEL_KASSA(:K' +
        'ASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG' +
        ');'
      '110488776=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488777=                        ERR_MSG = PROCNAME||'#39#39' -> PNT_' +
        ' '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110488778=                        EXIT;'
      '110488779=                      END'
      '110488780='
      
        '110488781=                      EXECUTE PROCEDURE K_INS_KASSA(1,' +
        '     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110488782=                                                    :G' +
        '_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110488783=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110488784=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110488785=                                                    NU' +
        'LL,   --NOTE_ => :NOTE_,'
      
        '110488786=                                                    NU' +
        'LL,   --ZAKAZ_'
      
        '110488787=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110488788=                                                    :P' +
        'AYMENT_TYPE_,'
      
        '110488789=                                                    :G' +
        '_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110488790=                END'
      '110488791=            END'
      '110488792=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488793=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110488794=              EXIT;'
      '110488795=            END'
      '110488796='
      '110488797=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~'#39#39';'
      '110488798=      END'
      '110488799='
      '110488800=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110488801=            FROM KASSA K'
      '110488802=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110488803=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA||'#39#39'~'#39#39
      '110488804=           UNION'
      '110488805=          SELECT KASSA, 1 PAYMENT_TYPE'
      '110488806=            FROM KASSA K'
      '110488807=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110488808=             AND K.SUMM = 0'
      '110488809=          UNION'
      '110488810=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110488811=            FROM KASSA_BEZNAL K'
      '110488812=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '110488813=             AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'||K.K' +
        'ASSA_BEZNAL||'#39#39'~'#39#39
      '110488814=          UNION'
      '110488815=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '110488816=            FROM KASSA_BEZNAL K'
      '110488817=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '110488818=             AND K.SUMM = 0'
      '110488819=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110488820=      DO BEGIN'
      '110488821=        PNT_ = '#39#39'011A'#39#39';'
      
        '110488822=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYMEN' +
        'T_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110488823=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488824=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110488825=          EXIT;'
      '110488826=        END'
      '110488827=      END'
      '110488828=  END'
      '110488829='
      '110488830=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110488831=    SELECT K.KASSA'
      '110488832=      FROM KASSA K'
      '110488833=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110488834=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110488835=      INTO :KASSA_POP_;'
      '110488836=  ELSE'
      '110488837=    SELECT K.KASSA_BEZNAL'
      '110488838=      FROM KASSA_BEZNAL K'
      '110488839=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '110488840=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110488841=       INTO :KASSA_POP_;'
      '110488842='
      
        '110488843=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEGI' +
        'N'
      '110488844=      PNT_ = '#39#39'012'#39#39';'
      '110488845=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      '110488846=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_,'
      
        '110488847=                                          1,     -- AC' +
        'TION_'
      '110488848=                                          :G_PRIHOD_,'
      
        '110488849=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110488850=                                          :DATE_RECEIP' +
        'T_,'
      
        '110488851=                                          NULL,   --NO' +
        'TE_'
      '110488852=                                          NULL,'
      
        '110488853=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110488854=                                          :G_PAYMENT_T' +
        'YPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110488855=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110488856=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_'
      '110488857=                                          :G_PRIHOD_,'
      
        '110488858=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110488859=                                          :DATE_RECEIP' +
        'T_,'
      
        '110488860=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      '110488861=                                          NULL,'
      
        '110488862=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110488863=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110488864=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110488865=      END'
      '110488866=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488867=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110488868=        EXIT;'
      '110488869=      END'
      '110488870='
      
        '110488871=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110488872=        PNT_ = '#39#39'013'#39#39';'
      
        '110488873=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110488874=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488875=          ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' ' +
        #39#39'||ERR_MSG;'
      '110488876=          EXIT;'
      '110488877=        END'
      '110488878=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110488879=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '110488880=                                          :G_PRIHOD_,'
      
        '110488881=                                          :SUMM_PRIHOD' +
        '_,'
      
        '110488882=                                          :DATE_RECEIP' +
        'T_,'
      
        '110488883=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110488884=                                          NULL,   --ZA' +
        'KAZ_'
      
        '110488885=                                          :SKLAD_PAREN' +
        'T_,'
      
        '110488886=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110488887=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110488888=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110488889=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110488890=              EXIT;'
      '110488891=            END'
      '110488892=        END'
      '110488893=  END'
      '110488894=end'
      '110488895='#39';'
      '110488896='
      '110488897=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD_TMP('
      '110488898=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110488899=  AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT,'
      '110488900=  PRICE_ TYPE OF COLUMN SKLAD.PRICE,'
      '110488901=  SUMM_ TYPE OF COLUMN SKLAD.SUMM,'
      '110488902=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110488903=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110488904=  ALLOW_SELL_ABSENT_GOODS_ INTEGER,'
      
        '110488905=  PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.PRICE_CURRENCY ' +
        '= 0,'
      
        '110488906=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD.SUMM_CURRENCY = ' +
        '0)'
      '110488907=RETURNS ('
      '110488908=  ERR_CODE INTEGER,'
      '110488909=  ERR_MSG VARCHAR(1024))'
      '110488910=AS'
      
        '110488911=declare variable PROCNAME varchar(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110488912=declare variable PNT_ varchar(5);'
      '110488913=declare variable G_PRODUCT_ integer;'
      
        '110488914=declare variable AMOUNT_CUR_ type of column SKLAD.AMOU' +
        'NT = 0;'
      
        '110488915=declare variable AMOUNT_CUR_SKLAD_ type of column SKLA' +
        'D.AMOUNT = 0;'
      
        '110488916=declare variable SKLAD_PARENT_ type of column SKLAD_PA' +
        'RENT.SKLAD;'
      
        '110488917=declare variable AMOUNT_OLD_ type of column SKLAD.AMOU' +
        'NT = 0;'
      '110488918=begin'
      '110488919=  PNT_ = '#39#39'01'#39#39';'
      '110488920=  UPDATE sklad_TMP'
      '110488921=  SET'
      '110488922=    AMOUNT = :AMOUNT_,'
      '110488923=    PRICE = :PRICE_,'
      '110488924=    SUMM = :SUMM_,'
      '110488925=    NDS = :NDS_,'
      '110488926=    NDS_SUMM = :NDS_SUMM_'
      '110488927=    ,PRICE_CURRENCY = :PRICE_CURRENCY_'
      '110488928=    ,SUMM_CURRENCY  = :SUMM_CURRENCY_'
      '110488929=  WHERE'
      '110488930=    sklad = :sklad_'
      '110488931=  RETURNING'
      '110488932=    SKLAD_PARENT'
      '110488933=  INTO'
      '110488934=    SKLAD_PARENT_;'
      '110488935='
      
        '110488936=  if ((ALLOW_SELL_ABSENT_GOODS_ = 0) AND (COALESCE(SKL' +
        'AD_PARENT_, 0) <> 0)) then BEGIN'
      '110488937=      SELECT L.G_PRODUCT,'
      '110488938=             L.AMOUNT'
      '110488939=        FROM SKLAD S,'
      '110488940=             LT_SKLAD_PRODUCT L'
      '110488941=       WHERE S.SKLAD = :SKLAD_'
      '110488942=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '110488943=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110488944=        INTO :G_PRODUCT_,'
      '110488945=             :AMOUNT_CUR_;'
      '110488946='
      '110488947=      SELECT SUM(AMOUNT)'
      '110488948=        FROM SKLAD T'
      '110488949=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110488950=         AND T.SKLAD_PARENT = :SKLAD_PARENT_'
      '110488951=        INTO :AMOUNT_OLD_;'
      '110488952='
      '110488953=      SELECT SUM(AMOUNT)'
      '110488954=        FROM SKLAD_TMP T'
      '110488955=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110488956=       INTO :AMOUNT_CUR_SKLAD_;'
      '110488957='
      
        '110488958=      IF (COALESCE(AMOUNT_OLD_, 0) > AMOUNT_CUR_SKLAD_' +
        ') THEN BEGIN'
      
        '110488959=          IF ((AMOUNT_CUR_ - (:AMOUNT_OLD_ - AMOUNT_CU' +
        'R_SKLAD_)) < 0) THEN BEGIN'
      '110488960=            ERR_CODE = -20500;'
      
        '110488961=            ERR_MSG = '#39#39#1055#1086#1089#1083#1077' '#1089#1086#1093#1088#1072#1085#1077#1085#1080#1103' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090#1086 +
        #1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1073#1091#1076#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39#39'||ASCII_CHAR(10)||'
      
        '110488962=                      '#39#39#1069#1090#1086' '#1079#1072#1087#1088#1077#1097#1077#1085#1086' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1084#1080' '#1087#1088#1086#1075 +
        #1088#1072#1084#1084#1099'.'#39#39';'
      
        '110488963=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ER' +
        'R_MSG) RETURNING_VALUES (:ERR_MSG);'
      '110488964=            ERR_MSG = PROCNAME||ERR_MSG;'
      '110488965=            EXIT;'
      '110488966=          END'
      '110488967=      END'
      '110488968=  END'
      '110488969=end'
      '110488970='#39';'
      '110488971='
      '110488972=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_ZAKAZ_NA_REAL('
      
        '110488973=  ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_NA_REAL.ZAKAZ_NA' +
        '_REAL,'
      '110488974=  G_PRODUCT_ TYPE OF COLUMN ZAKAZ_NA_REAL.G_PRODUCT,'
      '110488975=  PRICE_ TYPE OF COLUMN ZAKAZ_NA_REAL.PRICE,'
      '110488976=  AMOUNT_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.AMOUNT_ALL,'
      '110488977=  SUMM_ALL_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_ALL,'
      '110488978=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '110488979=RETURNS ('
      '110488980=  ERR_CODE INTEGER,'
      '110488981=  ERR_MSG VARCHAR(1024))'
      '110488982=AS'
      '110488983=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047'*/'
      
        '110488984=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPD_ZAKAZ_NA' +
        '_REAL'#39#39';'
      
        '110488985=DECLARE VARIABLE AMOUNT_ALL_OLD_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.AMOUNT_ALL;'
      
        '110488986=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110488987=declare variable TOVAR_PRICE_ TYPE OF COLUMN G_PRODUCT' +
        '.PRICE;  -- '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058' '#1057#1050#1048#1044#1050#1048
      '110488988=BEGIN'
      '110488989='
      '110488990=  SELECT Z.G_TOCHKA'
      '110488991=    FROM ZAKAZ_REAL_PARENT Z,'
      '110488992=         ZAKAZ_NA_REAL ZR'
      '110488993=   WHERE Z.ZAKAZ_REAL_PARENT = ZR.ZAKAZ_REAL_PARENT'
      '110488994=     AND ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110488995=    INTO :G_TOCHKA_;'
      '110488996='
      
        '110488997=  -- '#1055#1056#1054#1042#1045#1056#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', '#1042#1044#1056#1059#1043' '#1055#1054#1051#1068#1047#1054 +
        #1042#1040#1058#1045#1051#1068' '#1059#1042#1045#1051#1048#1063#1048#1051' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1053#1040' '#1041#1054#1051#1068#1064#1045#1045
      '110488998=  if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '110488999=      SELECT L.AMOUNT + (S.AMOUNT_ALL - :AMOUNT_ALL_)'
      '110489000=        FROM ZAKAZ_NA_REAL S,'
      '110489001=             LT_SKLAD_PRODUCT L'
      '110489002=       WHERE S.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110489003=         AND S.G_PRODUCT = L.G_PRODUCT'
      '110489004=         AND L.G_TOCHKA = :G_TOCHKA_'
      '110489005=        INTO :AMOUNT_ALL_OLD_;'
      '110489006='
      '110489007=      IF (:AMOUNT_ALL_OLD_ < 0) THEN BEGIN'
      '110489008=        Err_Code = -20500;'
      
        '110489009=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1050#1086#1083#1080 +
        #1095#1077#1089#1090#1074#1086' '#1090#1086#1074#1072#1088#1072' '#1087#1088#1077#1074#1099#1096#1072#1077#1090' '#1086#1089#1090#1072#1090#1086#1082' '#1085#1072' '#1089#1082#1083#1072#1076#1077'!'#39#39'||ASCII_CHAR(10)||'
      
        '110489010=                                      '#39#39#1058#1072#1082#1072#1103' '#1087#1088#1086#1076#1072#1078#1072' ' +
        #1090#1086#1074#1072#1088#1072' '#1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39#39') RETURNING_VALUES (:E' +
        'RR_MSG);'
      '110489011=        ERR_MSG = PROCNAME||ERR_MSG;'
      '110489012=        EXIT;'
      '110489013=      END'
      '110489014=  END'
      '110489015='
      '110489016=  SELECT Z.AMOUNT_ALL'
      '110489017=    FROM ZAKAZ_NA_REAL Z'
      '110489018=   WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110489019=    INTO :AMOUNT_ALL_OLD_;'
      '110489020='
      '110489021=  SELECT PRICE'
      '110489022=    FROM G_PRODUCT'
      '110489023=   WHERE G_PRODUCT = :G_PRODUCT_'
      '110489024=    INTO :TOVAR_PRICE_;'
      '110489025='
      '110489026=  UPDATE ZAKAZ_NA_REAL'
      '110489027=  SET G_PRODUCT = :G_PRODUCT_,'
      '110489028=      PRICE = :PRICE_,'
      '110489029=      DISCOUNT_TENGE = :TOVAR_PRICE_ - :PRICE_,'
      
        '110489030=      DISCOUNT_PERC = ROUND((:TOVAR_PRICE_ - :PRICE_)*' +
        '100/:TOVAR_PRICE_, 2),'
      
        '110489031=      DISCOUNT_SUMM = (:TOVAR_PRICE_ - :PRICE_) * :AMO' +
        'UNT_ALL_,'
      '110489032=      AMOUNT_ALL = :AMOUNT_ALL_,'
      '110489033=      SUMM_ALL = :SUMM_ALL_,'
      
        '110489034=      IS_PAYED_ALL = DECODE(:AMOUNT_ALL_, AMOUNT_PAYED' +
        ', 1, 0)'
      '110489035=  WHERE ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110489036='
      '110489037=  IF (AMOUNT_ALL_OLD_ <> AMOUNT_ALL_) THEN'
      '110489038=    UPDATE LT_SKLAD_PRODUCT L'
      
        '110489039=       SET L.AMOUNT = L.AMOUNT + :AMOUNT_ALL_OLD_ - :A' +
        'MOUNT_ALL_'
      '110489040=     WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489041=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '110489042=end'
      '110489043='#39';'
      '110489044='
      
        '110489045=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        '('
      '110489046=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110489047=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110489048=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110489049=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110489050=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110489051=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110489052=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110489053=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110489054=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110489055=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110489056=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110489057=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110489058=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      
        '110489059=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110489060=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110489061=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110489062=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110489063=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110489064=  PAYMENTS_ BLOB SUB_TYPE 1)'
      '110489065=RETURNS ('
      '110489066=  ERR_CODE INTEGER,'
      '110489067=  ERR_MSG VARCHAR(1024))'
      '110489068=AS'
      
        '110489069=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39#39';'
      '110489070=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110489071=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110489072=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      
        '110489073=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE;'
      
        '110489074=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      
        '110489075=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '110489076=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110489077=DECLARE VARIABLE SUMMM_ TYPE OF COLUMN ZAKAZ_DETAILS.S' +
        'UMM;'
      
        '110489078=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110489079=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      '110489080=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110489081=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110489082=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110489083=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      '110489084=DECLARE VARIABLE IS_THIS_LAST_ INTEGER;'
      
        '110489085=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110489086=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110489087=DECLARE VARIABLE SUMM_OLD_ TYPE OF COLUMN ZAKAZ.SUMM; ' +
        '/* '#1057#1059#1052#1052#1040' '#1057#1058#1040#1056#1040#1071' */'
      
        '110489088=DECLARE VARIABLE SUMM_BONUS_OLD_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS; /* '#1057#1059#1052#1052#1040' '#1054#1055#1051#1040#1063#1045#1053#1053#1040#1071' '#1041#1054#1053#1059#1057#1040#1052#1048' */'
      
        '110489089=DECLARE VARIABLE SUMM_BONUS_GOT_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.SUMM_BONUS_GOT; /* '#1057#1059#1052#1052#1040' '#1055#1054#1051#1059#1063#1045#1053#1053#1067#1061' '#1041#1054#1053#1059#1057#1054#1042' */'
      
        '110489090=DECLARE VARIABLE SUMM_FACT_1_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M_FACT;'
      
        '110489091=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110489092=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110489093=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110489094=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110489095=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110489096=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110489097=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39'; /* ' +
        #1044#1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '110489098=DECLARE VARIABLE G_CLIENT_OLD_ TYPE OF COLUMN G_CLIENT' +
        '.G_CLIENT;'
      '110489099=BEGIN'
      '110489100=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110489101=      SELECT Z.G_PAYMENT_TYPE,'
      '110489102=             Z.G_TOCHKA,'
      '110489103=             Z.SUMM,'
      '110489104=             Z.SUMM_BONUS,'
      '110489105=             Z.SUMM_BONUS_GOT,'
      '110489106=             z.g_client'
      '110489107=        FROM ZAKAZ Z'
      '110489108=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110489109=        INTO :G_PAYMENT_TYPE_OLD_,'
      '110489110=             :G_TOCHKA_,'
      '110489111=             :SUMM_OLD_,'
      '110489112=             :SUMM_BONUS_OLD_,'
      '110489113=             :SUMM_BONUS_GOT_OLD_,'
      '110489114=             :g_client_old_;'
      '110489115='
      '110489116=      PNT_ = '#39#39'02'#39#39';'
      
        '110489117=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110489118=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489119=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110489120=        EXIT;'
      '110489121=      END'
      '110489122='
      '110489123=      IF ((SUMM_FACT_ + SUMM_BONUS_) > SUMM_) THEN'
      '110489124=        SUMM_FACT_1_ = SUMM_ - SUMM_BONUS_;'
      '110489125=      ELSE'
      '110489126=        SUMM_FACT_1_ = SUMM_FACT_;'
      '110489127='
      '110489128=      PNT_ = '#39#39'01'#39#39';'
      '110489129=      UPDATE zakaz'
      '110489130=      SET'
      '110489131=       G_TOCHKA = :G_TOCHKA_,'
      '110489132=       Z_DATE = :Z_DATE_,'
      '110489133=       Z_TIME = :Z_TIME_,'
      '110489134=       G_CLIENT = :G_CLIENT_,'
      '110489135=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110489136=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110489137=       NOTE = COALESCE(:NOTE_, NOTE),'
      '110489138=       SUMM = :SUMM_,'
      '110489139=       SUMM_FACT = :SUMM_FACT_1_,'
      
        '110489140=       IS_PAYED_ALL = DECODE(:SUMM_, (:SUMM_FACT_1_ + ' +
        ':SUMM_BONUS_), 1, 0)'
      '110489141=       ,BY_RECIPE = :BY_RECIPE_'
      '110489142=       ,IS_RESERVE = :IS_RESERVE_'
      '110489143=       ,SUMM_BONUS = :SUMM_BONUS_'
      '110489144=       ,SUMM_BONUS_GOT = :SUMM_BONUS_GOT_'
      '110489145=       ,SUMM_CASH = COALESCE(:SUMM_CASH_, 0)'
      '110489146=       ,SUMM_NONCASH = COALESCE(:SUMM_NONCASH_, 0)'
      '110489147=      WHERE'
      '110489148=        zakaz = :zakaz_;'
      '110489149='
      '110489150=      if (G_CLIENT_ <> G_CLIENT_OLD_) then BEGIN'
      '110489151=          UPDATE G_DISCONT_CARD D'
      '110489152=          SET D.SUMM = D.SUMM - :SUMM_BONUS_GOT_OLD_,'
      '110489153=              D.SUMM_ALL = D.SUMM_ALL - :SUMM_OLD_'
      '110489154=          WHERE D.G_CLIENT = :G_CLIENT_OLD_;'
      '110489155='
      '110489156=          SUMM_BONUS_GOT_OLD_ = 0;'
      '110489157=          SUMM_OLD_           = 0;'
      '110489158=      END'
      '110489159=      UPDATE G_DISCONT_CARD D'
      
        '110489160=      SET D.SUMM = (D.SUMM + :SUMM_BONUS_OLD_ - :SUMM_' +
        'BONUS_GOT_OLD_) - COALESCE(:SUMM_BONUS_, 0) + :SUMM_BONUS_GOT_,'
      
        '110489161=          D.SUMM_ALL = (D.SUMM_ALL - :SUMM_OLD_) + :SU' +
        'MM_'
      '110489162=      WHERE D.G_CLIENT = :G_CLIENT_;'
      '110489163='
      '110489164=      PNT_ = '#39#39'03'#39#39';'
      '110489165=      FOR SELECT ZAKAZ_DETAILS,'
      '110489166=                 G_PRODUCT,'
      '110489167=                 AMOUNT'
      '110489168=            FROM ZAKAZ_DETAILS_TMP'
      '110489169=      INTO :ZAKAZ_DETAILS_,'
      '110489170=           :G_PRODUCT_,'
      '110489171=           :Z_AMOUNT_'
      '110489172=      DO BEGIN'
      
        '110489173=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE' +
        ', DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '110489174=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE'
      '110489175=          FROM ZAKAZ_DETAILS_TMP Z'
      '110489176=         WHERE Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '110489177='
      '110489178=        IF (IS_RESERVE_ = 0) THEN'
      '110489179=            UPDATE LT_SKLAD_PRODUCT L'
      '110489180=               SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT_'
      '110489181=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489182=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110489183='
      '110489184=        ELSE IF (IS_RESERVE_ = 1) THEN'
      '110489185=            UPDATE LT_SKLAD_PRODUCT L'
      
        '110489186=               SET L.AMOUNT_RESERVE = L.AMOUNT_RESERVE' +
        ' + :Z_AMOUNT_'
      '110489187=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489188=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110489189=      END'
      '110489190=      IF (:IS_SPISANIE_ IN (0,4)) THEN BEGIN'
      
        '110489191=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGI' +
        'N'
      '110489192=                PNT_ = '#39#39'04'#39#39';'
      
        '110489193=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENT' +
        'S_);'
      
        '110489194=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILD' +
        'A_) THEN'
      
        '110489195=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '110489196=                ELSE'
      
        '110489197=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FO' +
        'R CHAR_LENGTH(PAYMENTS_) - 1);'
      '110489198='
      
        '110489199=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:ST' +
        'R_)'
      
        '110489200=                    RETURNING_VALUES :KASSA_, :PAYMENT' +
        '_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110489201='
      
        '110489202=                PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM' +
        ' (POSITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110489203='
      '110489204=                PNT_ = '#39#39'05'#39#39';'
      
        '110489205=                IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) ' +
        'THEN'
      '110489206=                    EXECUTE PROCEDURE K_INS_KASSA(0,'
      '110489207=                                                  1,'
      
        '110489208=                                                  :PAY' +
        'MENT_SUMM_,'
      
        '110489209=                                                  :PAY' +
        'MENT_DATE_,'
      
        '110489210=                                                  NULL' +
        ','
      
        '110489211=                                                  :ZAK' +
        'AZ_,'
      
        '110489212=                                                  NULL' +
        ','
      
        '110489213=                                                  :PAY' +
        'MENT_TYPE_,'
      
        '110489214=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110489215='
      '110489216=                ELSE BEGIN'
      '110489217=                    SELECT 1'
      '110489218=                      FROM KASSA K'
      '110489219=                     WHERE K.KASSA = :KASSA_'
      '110489220=                    UNION ALL'
      '110489221=                    SELECT 2'
      '110489222=                      FROM KASSA_BEZNAL KB'
      '110489223=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110489224=                     INTO :PAYMENT_TYPE_OLD_;'
      '110489225='
      '110489226=                    PNT_ = '#39#39'06'#39#39';'
      
        '110489227=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_TY' +
        'PE_) THEN'
      
        '110489228=                        EXECUTE PROCEDURE K_UPD_KASSA(' +
        ':KASSA_,'
      
        '110489229=                                                      ' +
        '0,'
      
        '110489230=                                                      ' +
        '1,'
      
        '110489231=                                                      ' +
        ':PAYMENT_SUMM_,'
      
        '110489232=                                                      ' +
        ':PAYMENT_DATE_,'
      
        '110489233=                                                      ' +
        'NULL,'
      
        '110489234=                                                      ' +
        ':ZAKAZ_,'
      
        '110489235=                                                      ' +
        'NULL,'
      
        '110489236=                                                      ' +
        ':PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      
        '110489237=                    ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110489238=                        PNT_ = '#39#39'07'#39#39';'
      
        '110489239=                        EXECUTE PROCEDURE K_DEL_KASSA(' +
        ':KASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_M' +
        'SG);'
      '110489240=                        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489241=                          ERR_MSG = PROCNAME||'#39#39' -> PN' +
        'T_ '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110489242=                          EXIT;'
      '110489243=                        END'
      '110489244='
      '110489245=                        IF (PAYMENT_SUMM_ > 0) THEN'
      
        '110489246=                           EXECUTE PROCEDURE K_INS_KAS' +
        'SA(0,'
      
        '110489247=                                                      ' +
        '    1,'
      
        '110489248=                                                      ' +
        '    :PAYMENT_SUMM_,'
      
        '110489249=                                                      ' +
        '    :PAYMENT_DATE_,'
      
        '110489250=                                                      ' +
        '    NULL,'
      
        '110489251=                                                      ' +
        '    :ZAKAZ_,'
      
        '110489252=                                                      ' +
        '    NULL,'
      
        '110489253=                                                      ' +
        '    :PAYMENT_TYPE_,'
      
        '110489254=                                                      ' +
        '    :G_TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110489255=                    END'
      '110489256=                END'
      '110489257=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489258=                  ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||P' +
        'NT_||'#39#39' '#39#39'||ERR_MSG;'
      '110489259=                  EXIT;'
      '110489260=                END'
      '110489261='
      
        '110489262=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39#39'~' +
        #39#39';'
      '110489263=            END'
      '110489264=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110489265=                FROM KASSA K'
      '110489266=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110489267=                 AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'|' +
        '|K.KASSA||'#39#39'~'#39#39
      '110489268=                UNION'
      '110489269=                SELECT KASSA, 1 PAYMENT_TYPE'
      '110489270=                  FROM KASSA K'
      '110489271=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '110489272=                   AND K.SUMM = 0'
      '110489273=                UNION'
      
        '110489274=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110489275=                FROM KASSA_BEZNAL K'
      '110489276=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110489277=                 AND NOT :KASSA_STR_ CONTAINING '#39#39'~'#39#39'|' +
        '|K.KASSA_BEZNAL||'#39#39'~'#39#39
      '110489278=                UNION'
      
        '110489279=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110489280=                FROM KASSA_BEZNAL K'
      '110489281=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110489282=                 AND K.SUMM = 0'
      '110489283=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110489284=            DO BEGIN'
      '110489285=                PNT_ = '#39#39'08'#39#39';'
      
        '110489286=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_,' +
        ' :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110489287=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489288=                    ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'|' +
        '|PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110489289=                    EXIT;'
      '110489290=                END'
      '110489291=            END'
      '110489292=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110489293=                SELECT K.KASSA'
      '110489294=                FROM KASSA K'
      '110489295=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110489296=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110489297=                 INTO :KASSA_POP_;'
      '110489298=            ELSE'
      '110489299=                SELECT K.KASSA_BEZNAL'
      '110489300=                FROM KASSA_BEZNAL K'
      '110489301=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110489302=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110489303=                 INTO :KASSA_POP_;'
      '110489304='
      
        '110489305=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110489306=              PNT_ = '#39#39'09'#39#39';'
      '110489307=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '110489308=                    EXECUTE PROCEDURE K_UPD_KASSA(:KAS' +
        'SA_POP_,'
      
        '110489309=                                                  0,  ' +
        '   -- ACTION_'
      
        '110489310=                                                  :G_P' +
        'RIHOD_,'
      
        '110489311=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110489312=                                                  :Z_D' +
        'ATE_,'
      
        '110489313=                                                  NULL' +
        ',   --NOTE_'
      
        '110489314=                                                  :ZAK' +
        'AZ_,'
      
        '110489315=                                                  NULL' +
        ','
      
        '110489316=                                                  :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110489317=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '110489318=                    PNT_ = '#39#39'10'#39#39';'
      
        '110489319=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_'
      
        '110489320=                                                  :G_P' +
        'RIHOD_,'
      
        '110489321=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110489322=                                                  :Z_D' +
        'ATE_,'
      
        '110489323=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110489324=                                                  :ZAK' +
        'AZ_,'
      
        '110489325=                                                  NULL' +
        ','
      
        '110489326=                                                  :G_P' +
        'AYMENT_TYPE_,'
      
        '110489327=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110489328=              END'
      
        '110489329=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110489330=                PNT_ = '#39#39'11'#39#39';'
      '110489331=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110489332=                    EXECUTE PROCEDURE K_DEL_KASSA(:KAS' +
        'SA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR' +
        '_MSG);'
      '110489333=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489334=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110489335=                      EXIT;'
      '110489336=                    END'
      '110489337='
      
        '110489338=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110489339=                                                  :G_P' +
        'RIHOD_,'
      
        '110489340=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110489341=                                                  :Z_D' +
        'ATE_,'
      
        '110489342=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110489343=                                                  :ZAK' +
        'AZ_,   --ZAKAZ_'
      
        '110489344=                                                  NULL' +
        ','
      
        '110489345=                                                  :G_P' +
        'AYMENT_TYPE_,'
      
        '110489346=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110489347=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489348=                      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39 +
        #39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110489349=                      EXIT;'
      '110489350=                    END'
      '110489351=                END'
      '110489352=            END'
      '110489353=      END'
      '110489354=  END'
      '110489355=  ELSE BEGIN'
      '110489356=      PNT_ = '#39#39'020'#39#39';'
      '110489357=      SELECT SP.G_TOCHKA,'
      '110489358=             SP.G_CLIENT'
      '110489359=        FROM SKLAD_PARENT SP'
      '110489360=       WHERE SP.SKLAD = :ZAKAZ_'
      '110489361=        INTO :G_TOCHKA_OLD_,'
      '110489362=             :G_TOCHKA_;'
      '110489363=      PNT_ = '#39#39'021'#39#39';'
      '110489364=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '110489365=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, ' +
        'NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110489366=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489367=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110489368=            EXIT;'
      '110489369=          END'
      '110489370='
      '110489371=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110489372=                FROM ZAKAZ_DETAILS_TMP Z'
      '110489373=              INTO :G_PRODUCT_,'
      '110489374=                  :Z_AMOUNT_,'
      '110489375=                  :PRICE_,'
      '110489376=                  :SUMMM_'
      '110489377=          DO BEGIN'
      '110489378=            IS_THIS_LAST_ = 0;'
      '110489379=            SELECT MAX(SK.DATE_RECEIPT)'
      '110489380=                FROM SKLAD SK'
      '110489381=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110489382=                 AND SK.IS_LAST = 1'
      '110489383=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '110489384=                INTO :DATE_LAST_;'
      '110489385='
      
        '110489386=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALESC' +
        'E(DATE_LAST_, CURRENT_DATE))) THEN BEGIN'
      '110489387=                UPDATE SKLAD SK'
      '110489388=                   SET SK.IS_LAST = 0'
      '110489389=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110489390=                   AND SK.IS_LAST = 1'
      '110489391=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '110489392='
      '110489393=                IS_THIS_LAST_ = 1;'
      '110489394=            END'
      '110489395='
      '110489396='
      '110489397=            INSERT INTO SKLAD'
      '110489398=            ('
      '110489399=             SKLAD,'
      '110489400=             SKLAD_PARENT,'
      '110489401=             DATE_RECEIPT,'
      '110489402=             G_CLIENT,'
      '110489403=             G_PRODUCT,'
      '110489404=             AMOUNT,'
      '110489405=             PRICE,'
      '110489406=             SUMM,'
      '110489407=             G_PAYMENT_TYPE,'
      '110489408=             OSNOVANIE,'
      '110489409=             NOTE,'
      '110489410=             NDS,'
      '110489411=             NDS_SUMM,'
      '110489412=             IS_LAST,'
      '110489413=             IS_VOZVRAT,'
      '110489414=             G_TOCHKA'
      '110489415=            ) VALUES ('
      '110489416=             GEN_ID(GEN_DETAILS_TMP, 1),'
      '110489417=             :ZAKAZ_,'
      '110489418=             :Z_DATE_,'
      '110489419=             :G_TOCHKA_,'
      '110489420=             :G_PRODUCT_,'
      '110489421=             :Z_AMOUNT_,'
      '110489422=             :PRICE_,'
      '110489423=             :SUMMM_,'
      '110489424=             :G_PAYMENT_TYPE_,'
      '110489425=             :OSNOVANIE_,'
      '110489426=             :NOTE_,'
      '110489427=             0,  --:RNDS_,'
      '110489428=             0,  --:RNDS_SUMM_,'
      '110489429=             DECODE(:IS_THIS_LAST_, 1, 1, 0),'
      '110489430=             3,  --:IS_VOZVRAT_,'
      '110489431=             :G_CLIENT_'
      '110489432=            );'
      '110489433='
      '110489434=            PNT_ = '#39#39'023'#39#39';'
      '110489435=            UPDATE LT_SKLAD_PRODUCT L'
      '110489436=               SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '110489437=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489438=               AND L.G_TOCHKA = :G_CLIENT_;'
      '110489439='
      '110489440=            IF (ROW_COUNT = 0) THEN'
      
        '110489441=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD' +
        '_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110489442=          END'
      '110489443=      END'
      '110489444=      ELSE BEGIN'
      '110489445=          PNT_ = '#39#39'025'#39#39';'
      '110489446=          FOR SELECT SKLAD,'
      '110489447=                     AMOUNT,'
      '110489448=                     G_PRODUCT'
      '110489449=                FROM SKLAD S'
      '110489450=               WHERE S.SKLAD_PARENT = :ZAKAZ_'
      '110489451=                 AND NOT EXISTS (SELECT 1'
      
        '110489452=                                   FROM ZAKAZ_DETAILS_' +
        'TMP T'
      
        '110489453=                                  WHERE T.ZAKAZ_DETAIL' +
        'S = S.SKLAD)'
      '110489454=          INTO :SKLAD_,'
      '110489455=               :Z_AMOUNT_,'
      '110489456=               :G_PRODUCT_'
      '110489457=          DO BEGIN'
      
        '110489458=            EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_' +
        ', :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110489459=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489460=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110489461=              EXIT;'
      '110489462=            END'
      '110489463=          END'
      '110489464='
      '110489465=          PNT_ = '#39#39'030'#39#39';'
      '110489466=          FOR SELECT S.ZAKAZ_DETAILS,'
      '110489467=                     S.G_PRODUCT,'
      '110489468=                     S.AMOUNT,'
      '110489469=                     S.PRICE,'
      '110489470=                     S.SUMM,'
      '110489471=                     T.SKLAD,'
      '110489472=                     T.AMOUNT,'
      '110489473=                     T.IS_LAST,'
      '110489474=                     T.DATE_RECEIPT'
      
        '110489475=                FROM ZAKAZ_DETAILS_TMP S LEFT OUTER JO' +
        'IN (SELECT SKLAD, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE' +
        ' SKLAD_PARENT = :ZAKAZ_) T ON S.ZAKAZ_DETAILS = T.SKLAD'
      '110489476=                INTO :ZAKAZ_DETAILS_,'
      '110489477=                     :G_PRODUCT_,'
      '110489478=                     :Z_AMOUNT_,'
      '110489479=                     :PRICE_,'
      '110489480=                     :SUMMM_,'
      '110489481=                     :SKLAD_OLD_,'
      '110489482=                     :AMOUNT_OLD_,'
      '110489483=                     :IS_THIS_LAST_,'
      '110489484=                     :DATE_RECEIPT_OLD_'
      '110489485=          DO BEGIN'
      '110489486=            IF (SKLAD_OLD_ IS NULL) then BEGIN'
      
        '110489487=                INSERT INTO SKLAD (SKLAD, SKLAD_PARENT' +
        ', DATE_RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYM' +
        'ENT_TYPE, NDS, NDS_SUMM,'
      
        '110489488=                                  IS_LAST, NOTE, OSNOV' +
        'ANIE, IS_VOZVRAT, G_TOCHKA)'
      
        '110489489=                VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :Z' +
        'AKAZ_, :Z_DATE_, :G_TOCHKA_, :G_PRODUCT_, :Z_AMOUNT_, :PRICE_, :' +
        'SUMMM_, 1, 0, 0,'
      '110489490=                       0'
      
        '110489491=                       ,:NOTE_,  :OSNOVANIE_, 3, :G_CL' +
        'IENT_'
      '110489492=                       )'
      '110489493=                RETURNING'
      '110489494=                  SKLAD'
      '110489495=                INTO'
      '110489496=                  :SKLAD_;'
      '110489497='
      '110489498=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110489499=                   SET L.AMOUNT = L.AMOUNT - :Z_AMOUNT' +
        '_'
      '110489500=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489501=                   AND L.G_TOCHKA = :G_TOCHKA_;'
      '110489502='
      '110489503=                UPDATE LT_SKLAD_PRODUCT L'
      
        '110489504=                   SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT' +
        '_'
      '110489505=                 WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489506=                   AND L.G_TOCHKA = :G_CLIENT_;'
      '110489507='
      '110489508=                IF (ROW_COUNT = 0) THEN'
      
        '110489509=                  INSERT INTO LT_SKLAD_PRODUCT (LT_SKL' +
        'AD_PRODUCT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_S' +
        'KLAD_PRODUCT, 1), :G_PRODUCT_, :Z_AMOUNT_, :G_CLIENT_);'
      '110489510='
      '110489511=                SELECT MAX(SK.DATE_RECEIPT)'
      '110489512=                  FROM SKLAD SK'
      '110489513=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110489514=                   AND SK.IS_LAST = 1'
      '110489515=                   AND SK.G_TOCHKA = :G_CLIENT_'
      '110489516=                  INTO :DATE_LAST_;'
      '110489517='
      
        '110489518=                IF ((DATE_LAST_ IS NULL) OR (Z_DATE_ >' +
        '= DATE_LAST_)) THEN BEGIN'
      '110489519=                  UPDATE SKLAD SK'
      '110489520=                     SET SK.IS_LAST = 0'
      '110489521=                   WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110489522=                     AND SK.IS_LAST = 1'
      '110489523=                     AND SK.G_TOCHKA = :G_CLIENT_;'
      '110489524='
      '110489525=                  UPDATE SKLAD SK'
      '110489526=                     SET SK.IS_LAST = 1'
      '110489527=                   WHERE SK.SKLAD = :SKLAD_;'
      '110489528=                END'
      '110489529='
      '110489530=            END ELSE BEGIN'
      '110489531=                UPDATE SKLAD S'
      '110489532=                   SET S.DATE_RECEIPT = :Z_DATE_,'
      '110489533=                       S.AMOUNT   = :Z_AMOUNT_,'
      '110489534=                       S.PRICE    = :PRICE_,'
      '110489535=                       S.SUMM     = :SUMMM_,'
      '110489536=                       S.OSNOVANIE = :OSNOVANIE_,'
      '110489537=                       S.NOTE      = :NOTE_'
      '110489538=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '110489539='
      '110489540='
      
        '110489541=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN BEGI' +
        'N'
      '110489542=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110489543=                     SET L.AMOUNT = L.AMOUNT + (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110489544=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489545=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110489546='
      '110489547=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110489548=                     SET L.AMOUNT = L.AMOUNT - (:AMOUN' +
        'T_OLD_ - :Z_AMOUNT_)'
      '110489549=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489550=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110489551='
      
        '110489552=                END ELSE if (Z_AMOUNT_ > AMOUNT_OLD_) ' +
        'THEN BEGIN'
      '110489553=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110489554=                     SET L.AMOUNT = L.AMOUNT - (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110489555=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489556=                     AND L.G_TOCHKA = :G_TOCHKA_;'
      '110489557='
      '110489558=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110489559=                     SET L.AMOUNT = L.AMOUNT + (:Z_AMO' +
        'UNT_ - :AMOUNT_OLD_)'
      '110489560=                   WHERE L.G_PRODUCT = :G_PRODUCT_'
      '110489561=                     AND L.G_TOCHKA = :G_CLIENT_;'
      '110489562=                END'
      '110489563='
      
        '110489564=                IF ((Z_DATE_ > DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0)) THEN BEGIN'
      '110489565=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110489566=                      FROM SKLAD SK'
      '110489567=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110489568=                       AND SK.IS_LAST = 1'
      '110489569=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110489570=                      INTO :DATE_LAST_;'
      '110489571='
      
        '110489572=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ > DATE_LAST_)) THEN BEGIN'
      '110489573=                      UPDATE SKLAD SK'
      '110489574=                         SET SK.IS_LAST = 0'
      
        '110489575=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      '110489576=                         AND SK.IS_LAST = 1'
      '110489577=                         AND SK.G_TOCHKA = :G_CLIENT_;'
      '110489578='
      '110489579=                      UPDATE SKLAD SK'
      '110489580=                         SET SK.IS_LAST = 1'
      
        '110489581=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110489582=                    END'
      '110489583=                END'
      '110489584='
      
        '110489585=                IF ((Z_DATE_ < DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 1)) THEN BEGIN'
      '110489586=                    SELECT MAX(SK.DATE_RECEIPT)'
      '110489587=                      FROM SKLAD SK'
      '110489588=                     WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110489589=                       AND SK.SKLAD_PARENT <> :ZAKAZ_'
      '110489590=                       AND SK.G_TOCHKA = :G_CLIENT_'
      '110489591=                       AND SK.is_vozvrat IN (0,3,4)'
      '110489592=                      INTO :DATE_LAST_;'
      '110489593='
      
        '110489594=                    IF ((DATE_LAST_ IS NOT NULL) AND (' +
        'Z_DATE_ < DATE_LAST_)) THEN BEGIN'
      '110489595=                      UPDATE SKLAD SK'
      '110489596=                         SET SK.IS_LAST = 0'
      
        '110489597=                       WHERE SK.SKLAD = :ZAKAZ_DETAILS' +
        '_;'
      '110489598='
      '110489599=                       UPDATE SKLAD SK'
      '110489600=                         SET SK.IS_LAST = 1'
      
        '110489601=                       WHERE SK.G_PRODUCT = :G_PRODUCT' +
        '_'
      
        '110489602=                         AND SK.SKLAD = (SELECT MAX(SS' +
        '.SKLAD)'
      
        '110489603=                                           FROM SKLAD ' +
        'SS'
      
        '110489604=                                          WHERE SS.G_P' +
        'RODUCT = SK.G_PRODUCT'
      
        '110489605=                                            AND SS.DAT' +
        'E_RECEIPT = :DATE_LAST_'
      
        '110489606=                                            AND SS.G_T' +
        'OCHKA = :G_CLIENT_'
      
        '110489607=                                            AND SS.is_' +
        'vozvrat IN (0,3,4));'
      '110489608=                    END'
      '110489609=                END'
      '110489610=            END'
      '110489611=          END'
      '110489612=      END'
      '110489613='
      '110489614=      UPDATE SKLAD_PARENT'
      '110489615=      SET'
      
        '110489616=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110489617=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      '110489618=       G_TOCHKA  = COALESCE(:G_CLIENT_, G_TOCHKA),'
      '110489619=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110489620=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110489621=       SUMM      = :SUMM_,'
      '110489622=       SUMM_FACT = :SUMM_FACT_'
      '110489623=      WHERE SKLAD  = :ZAKAZ_;'
      '110489624=  END'
      '110489625='
      '110489626=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110489627=END'
      '110489628='#39';'
      '110489629=END  --END_EXECUTE_BLOCK'
      '110489630=EXECUTE BLOCK AS BEGIN'
      '110489631='
      
        '110489632=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        '_REAL('
      '110489633=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110489634=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110489635=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110489636=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110489637=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE,'
      '110489638=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110489639=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110489640=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110489641=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110489642=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT)'
      '110489643=RETURNS ('
      '110489644=  ERR_CODE INTEGER,'
      '110489645=  ERR_MSG VARCHAR(1024))'
      '110489646=AS'
      
        '110489647=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL_REAL'#39#39';'
      '110489648=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110489649=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110489650=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN ZA' +
        'KAZ.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110489651=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.ZAKAZ_DETAILS;'
      
        '110489652=DECLARE VARIABLE Z_G_PRODUCT_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.G_PRODUCT;'
      
        '110489653=DECLARE VARIABLE Z_AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.AMOUNT;'
      
        '110489654=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'SUMM;'
      
        '110489655=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_N' +
        'A_REAL.ZAKAZ_NA_REAL;'
      '110489656=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110489657=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110489658=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110489659=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110489660=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110489661=BEGIN'
      '110489662=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '110489663=      SELECT Z.G_PAYMENT_TYPE'
      '110489664=        FROM ZAKAZ Z'
      '110489665=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '110489666=        INTO :G_PAYMENT_TYPE_OLD_;'
      '110489667='
      '110489668=      PNT_ = '#39#39'01a'#39#39';'
      '110489669=      UPDATE zakaz'
      '110489670=      SET'
      '110489671=       Z_DATE = :Z_DATE_,'
      '110489672=       Z_TIME = :Z_TIME_,'
      '110489673=       G_CLIENT = :G_CLIENT_,'
      '110489674=       G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '110489675=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110489676=       NOTE = COALESCE(:NOTE_, NOTE),'
      '110489677=       SUMM = :SUMM_,'
      '110489678=       SUMM_FACT = :SUMM_FACT_'
      '110489679=      WHERE'
      '110489680=        zakaz = :zakaz_;'
      '110489681='
      '110489682=      PNT_ = '#39#39'02a'#39#39';'
      
        '110489683=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RETU' +
        'RNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110489684=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489685=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110489686=        EXIT;'
      '110489687=      END'
      '110489688='
      '110489689=      PNT_ = '#39#39'03a'#39#39';'
      '110489690=      DELETE from zakaz_DETAILS z'
      '110489691=      WHERE z.zakaz = :zakaz_;'
      '110489692=      FOR SELECT G_PRODUCT,'
      '110489693=                 AMOUNT,'
      '110489694=                 SUMM,'
      '110489695=                 ZAKAZ_NA_REAL,'
      '110489696=                 ZAKAZ_DETAILS'
      '110489697=            FROM ZAKAZ_DETAILS_TMP_REAL'
      '110489698=      INTO :Z_G_PRODUCT_,'
      '110489699=           :Z_AMOUNT_,'
      '110489700=           :Z_SUMM_,'
      '110489701=           :ZAKAZ_NA_REAL_,'
      '110489702=           :ZAKAZ_DETAILS_'
      '110489703=      DO BEGIN'
      '110489704=        PNT_ = '#39#39'04a'#39#39';'
      
        '110489705=        INSERT INTO ZAKAZ_DETAILS (ZAKAZ_DETAILS, ZAKA' +
        'Z, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE' +
        ', DISCOUNT_SUMM, NDS, NDS_SUMM, COST_PRICE)'
      
        '110489706=        SELECT ZAKAZ_DETAILS, :ZAKAZ_, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE'
      '110489707=          FROM ZAKAZ_DETAILS_TMP_REAL Z'
      '110489708=         WHERE Z.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_'
      '110489709=           AND Z.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_;'
      '110489710='
      '110489711=        PNT_ = '#39#39'05a'#39#39';'
      '110489712=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110489713=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :Z_AM' +
        'OUNT_,'
      
        '110489714=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUMM' +
        '_,'
      
        '110489715=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, Z' +
        'R.AMOUNT_PAYED + :Z_AMOUNT_, 1, 0)'
      '110489716=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110489717='
      '110489718=        PNT_ = '#39#39'06a'#39#39';'
      
        '110489719=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, ZAKAZ_DETAILS)'
      
        '110489720=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, :ZAKAZ_DETAILS_);'
      '110489721=      END'
      '110489722='
      '110489723=      if (G_PAYMENT_TYPE_OLD_ = 1) then'
      '110489724=          SELECT S.KASSA,'
      '110489725=                 S.G_TOCHKA'
      '110489726=            FROM KASSA S'
      '110489727=           WHERE S.ZAKAZ = :ZAKAZ_'
      
        '110489728=             AND S.G_PRIHOD_RASHOD = 1     -- '#1055#1056#1054#1044#1040#1046#1040' ' +
        #1058#1054#1042#1040#1056#1040
      '110489729=            INTO :KASSA_,'
      '110489730=                 :G_TOCHKA_;'
      '110489731=      ELSE'
      '110489732=          SELECT S.KASSA_BEZNAL,'
      '110489733=                 S.G_TOCHKA'
      '110489734=            FROM KASSA_BEZNAL S'
      '110489735=           WHERE S.ZAKAZ = :ZAKAZ_'
      '110489736=             AND S.G_PRIHOD_RASHOD = 1'
      '110489737=            INTO :KASSA_,'
      '110489738=                 :G_TOCHKA_;'
      '110489739='
      
        '110489740=        IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THE' +
        'N BEGIN'
      '110489741=          PNT_ = '#39#39'05'#39#39';'
      '110489742=          EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_,'
      
        '110489743=                                        0,     -- ACTI' +
        'ON_'
      
        '110489744=                                        1,     --:G_PR' +
        'IHOD_RASHOD_,'
      '110489745=                                        :SUMM_FACT_,'
      '110489746=                                        :Z_DATE_,'
      
        '110489747=                                        NULL,   --NOTE' +
        '_'
      '110489748=                                        :ZAKAZ_,'
      '110489749=                                        NULL,'
      
        '110489750=                                        :G_PAYMENT_TYP' +
        'E_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110489751=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489752=            ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39 +
        #39' '#39#39'||ERR_MSG;'
      '110489753=            EXIT;'
      '110489754=          END'
      '110489755='
      
        '110489756=        END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_' +
        'TYPE_) THEN BEGIN'
      '110489757=            PNT_ = '#39#39'07'#39#39';'
      
        '110489758=            EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :G_' +
        'PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110489759=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489760=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110489761=              EXIT;'
      '110489762=            END'
      '110489763='
      
        '110489764=            EXECUTE PROCEDURE K_INS_KASSA(0,     -- AC' +
        'TION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110489765=                                          1,     -- G_' +
        'PRIHOD_RASHOD_'
      '110489766=                                          :SUMM_FACT_,'
      '110489767=                                          :Z_DATE_,'
      
        '110489768=                                          NULL,   --NO' +
        'TE_ => :NOTE_,'
      
        '110489769=                                          :ZAKAZ_,   -' +
        '-ZAKAZ_'
      '110489770=                                          NULL,'
      
        '110489771=                                          :G_PAYMENT_T' +
        'YPE_,'
      
        '110489772=                                          :G_TOCHKA_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110489773=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489774=              ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_|' +
        '|'#39#39' '#39#39'||ERR_MSG;'
      '110489775=              EXIT;'
      '110489776=            END'
      '110489777=        END'
      '110489778=  END'
      '110489779=  ELSE BEGIN'
      '110489780=      UPDATE SKLAD_PARENT'
      '110489781=      SET'
      
        '110489782=       DATE_RECEIPT = COALESCE(:Z_DATE_, DATE_RECEIPT)' +
        ','
      
        '110489783=       TIME_RECEIPT = COALESCE(:Z_TIME_, TIME_RECEIPT)' +
        ','
      
        '110489784=       G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_P' +
        'AYMENT_TYPE),'
      '110489785=       G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110489786=       OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110489787=       NOTE      = COALESCE(:NOTE_, NOTE),'
      '110489788=       SUMM = :SUMM_,'
      '110489789=       SUMM_FACT = :SUMM_FACT_'
      '110489790=      WHERE SKLAD  = :ZAKAZ_'
      '110489791=      RETURNING G_TOCHKA'
      '110489792=      INTO :G_TOCHKA_;'
      '110489793='
      '110489794=      PNT_ = '#39#39'02'#39#39';'
      
        '110489795=      EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, NULL' +
        ') RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110489796=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110489797=        ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39 +
        '||ERR_MSG;'
      '110489798=        EXIT;'
      '110489799=      END'
      '110489800='
      '110489801=      PNT_ = '#39#39'03'#39#39';'
      '110489802=      FOR SELECT T.AMOUNT,'
      '110489803=                 T.SUMM,'
      '110489804=                 T.G_PRODUCT,'
      '110489805=                 T.ZAKAZ_NA_REAL,'
      '110489806=                 T.ZAKAZ_DETAILS'
      '110489807=                 ,T.PRICE'
      '110489808=                 ,T.NDS'
      '110489809=                 ,T.NDS_SUMM'
      '110489810=                 ,T.DISCOUNT_TENGE'
      '110489811=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '110489812=            INTO :Z_AMOUNT_,'
      '110489813=                 :Z_SUMM_,'
      '110489814=                 :Z_G_PRODUCT_,'
      '110489815=                 :ZAKAZ_NA_REAL_,'
      '110489816=                 :ZAKAZ_DETAILS_'
      '110489817=                 ,:PRICE_'
      '110489818=                 ,:NDS_'
      '110489819=                 ,:NDS_SUMM_'
      '110489820=                 ,:DISCOUNT_TENGE_'
      '110489821=      DO BEGIN'
      
        '110489822=        INSERT INTO SKLAD(SKLAD, G_PRODUCT, DATE_RECEI' +
        'PT, AMOUNT, PRICE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, IS_VOZVRAT'
      
        '110489823=                         ,G_CLIENT, G_PAYMENT_TYPE, OS' +
        'NOVANIE, NOTE, G_TOCHKA)'
      
        '110489824=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :Z_G_PRODUC' +
        'T_, :Z_DATE_, :Z_AMOUNT_, :PRICE_ - :DISCOUNT_TENGE_, :Z_SUMM_, ' +
        ':NDS_, :NDS_SUMM_, :ZAKAZ_, 2'
      
        '110489825=                         ,:G_CLIENT_, :G_PAYMENT_TYPE_' +
        ', :OSNOVANIE_, :NOTE_, :G_TOCHKA_);'
      '110489826='
      '110489827=        UPDATE LT_SKLAD_PRODUCT L'
      '110489828=           SET L.AMOUNT = L.AMOUNT + :Z_AMOUNT_'
      '110489829=         WHERE L.G_PRODUCT = :Z_G_PRODUCT_'
      '110489830=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110489831='
      
        '110489832=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAKA' +
        'Z_NA_REAL, SKLAD)'
      
        '110489833=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_N' +
        'A_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '110489834='
      '110489835=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '110489836=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_R' +
        'ETURNED, 0) + :Z_AMOUNT_,'
      
        '110489837=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RET' +
        'URNED, 0) + :Z_SUMM_,'
      
        '110489838=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, C' +
        'OALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) + ' +
        ':Z_AMOUNT_, 1, 0)'
      '110489839=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '110489840=      END'
      '110489841=  END'
      '110489842='
      '110489843=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110489844=END'
      '110489845='#39';'
      '110489846='
      
        '110489847=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL' +
        'S_TMP('
      
        '110489848=  ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKA' +
        'Z_DETAILS,'
      '110489849=  AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110489850=  PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110489851=  SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110489852=  DISCOUNT_PERC_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      
        '110489853=  DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_TENGE,'
      
        '110489854=  DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_PERC,'
      '110489855=  NDS_ TYPE OF COLUMN SKLAD.NDS,'
      '110489856=  NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SUMM,'
      '110489857=  ALLOW_SELL_ABSENT_GOODS_ INTEGER)'
      '110489858=RETURNS ('
      '110489859=  ERR_CODE INTEGER,'
      '110489860=  ERR_MSG VARCHAR(1024))'
      '110489861=AS'
      
        '110489862=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39#39'UPDATE_ZAKAZ' +
        '_DETAIL_TMP'#39#39';'
      '110489863=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110489864=DECLARE VARIABLE G_PRODUCT_ INTEGER;'
      
        '110489865=DECLARE VARIABLE AMOUNT_CUR_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110489866=DECLARE VARIABLE AMOUNT_CUR_ZAKAZ_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS_TMP.AMOUNT = 0;'
      '110489867=DECLARE VARIABLE ZAKAZ_ INTEGER = 0;'
      
        '110489868=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS_TMP.AMOUNT = 0;'
      
        '110489869=DECLARE VARIABLE Z_TYPE_ TYPE OF COLUMN ZAKAZ_DETAILS_' +
        'TMP.Z_TYPE = 0;'
      '110489870=BEGIN'
      '110489871=  PNT_ = '#39#39'01'#39#39';'
      '110489872=  UPDATE ZAKAZ_DETAILS_TMP t'
      '110489873=     SET t.AMOUNT = :AMOUNT_,'
      '110489874=        t.PRICE = :PRICE_,'
      '110489875=        t.SUMM = :SUMM_,'
      '110489876=        t.DISCOUNT_PERC = :DISCOUNT_PERC_,'
      '110489877=        t.DISCOUNT_TENGE = :DISCOUNT_TENGE_,'
      '110489878=        T.DISCOUNT_SUMM = :DISCOUNT_SUMM_,'
      '110489879=        T.NDS = :NDS_,'
      '110489880=        T.NDS_SUMM = :NDS_SUMM_'
      '110489881=  WHERE t.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '110489882=  RETURNING'
      '110489883=    ZAKAZ, Z_TYPE'
      '110489884=  INTO'
      '110489885=    :ZAKAZ_, :Z_TYPE_;'
      '110489886='
      '110489887=  PNT_ = '#39#39'02'#39#39';'
      '110489888=  if (ALLOW_SELL_ABSENT_GOODS_ = 0) then BEGIN'
      '110489889=      SELECT L.G_PRODUCT,'
      '110489890=             L.AMOUNT - L.AMOUNT_RESERVE'
      '110489891=        FROM ZAKAZ_DETAILS_TMP S,'
      '110489892=             LT_SKLAD_PRODUCT L'
      '110489893=       WHERE S.ZAKAZ_DETAILS = :ZAKAZ_DETAILS_'
      '110489894=         AND S.G_PRODUCT = L.G_PRODUCT'
      
        '110489895=         AND L.G_TOCHKA = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110489896=        INTO :G_PRODUCT_,'
      '110489897=             :AMOUNT_CUR_;'
      '110489898='
      '110489899=      PNT_ = '#39#39'04'#39#39';'
      '110489900=      if (COALESCE(Z_TYPE_, 0) <> 3) then'
      '110489901=          SELECT SUM(AMOUNT)'
      '110489902=            FROM ZAKAZ_DETAILS T'
      '110489903=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110489904=             AND T.ZAKAZ = :ZAKAZ_'
      '110489905=            INTO :AMOUNT_OLD_;'
      '110489906=      ELSE'
      '110489907=          SELECT SUM(AMOUNT)'
      '110489908=            FROM SKLAD T'
      '110489909=           WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110489910=             AND T.SKLAD_PARENT = :ZAKAZ_'
      '110489911=            INTO :AMOUNT_OLD_;'
      '110489912='
      '110489913=      PNT_ = '#39#39'05'#39#39';'
      '110489914=      SELECT SUM(AMOUNT)'
      '110489915=        FROM ZAKAZ_DETAILS_TMP T'
      '110489916=       WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110489917=       INTO :AMOUNT_CUR_ZAKAZ_;'
      '110489918='
      
        '110489919=      IF ((AMOUNT_CUR_ - (:AMOUNT_CUR_ZAKAZ_ - COALESC' +
        'E(:AMOUNT_OLD_, 0))) < 0) THEN BEGIN'
      '110489920=        ERR_CODE = -20500;'
      
        '110489921=        ERR_MSG = '#39#39#1055#1086#1089#1083#1077' '#1076#1072#1085#1085#1086#1081' '#1086#1087#1077#1088#1072#1094#1080#1080' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1090 +
        #1086#1074#1072#1088#1072' '#1085#1072' '#1089#1082#1083#1072#1076#1077' '#1089#1090#1072#1085#1077#1090' '#1086#1090#1088#1080#1094#1072#1090#1077#1083#1100#1085#1099#1084'!'#39#39'||ASCII_CHAR(10)||'
      
        '110489922=                  '#39#39#1055#1088#1086#1076#1072#1078#1072' '#1090#1086#1074#1072#1088#1072' '#1089' '#1085#1091#1083#1077#1074#1099#1084' '#1086#1089#1090#1072#1090#1082#1086#1084' ' +
        #1079#1072#1087#1088#1077#1097#1077#1085#1072' '#1074' '#1085#1072#1089#1090#1088#1086#1081#1082#1072#1093' '#1087#1088#1086#1075#1088#1072#1084#1084#1099'.'#39#39';'
      
        '110489923=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, ERR_MS' +
        'G) RETURNING_VALUES (:ERR_MSG);'
      '110489924=        ERR_MSG = PROCNAME||ERR_MSG;'
      '110489925=        EXIT;'
      '110489926=      END'
      '110489927=  END'
      '110489928=when sqlcode -811 DO'
      '110489929=  begin'
      '110489930=    ERR_CODE = -20500;'
      
        '110489931=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1052#1085#1086#1078#1077#1089#1090#1074 +
        #1086' '#1089#1090#1088#1086#1082' '#1074' '#1086#1076#1080#1085#1086#1095#1085#1086#1084' SELECT!'#39#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110489932=    ERR_MSG = PROCNAME||'#39#39' ->  PNT_ '#39#39'||PNT_||'#39#39'. '#39#39'||' +
        'ERR_MSG;'
      '110489933=  end'
      '110489934=END'
      '110489935='#39';'
      '110489936='
      
        '110489937=EXECUTE STATEMENT '#39'ALTER PROCEDURE ZR_DEL_ZAKAZ_REAL_P' +
        'ARENT('
      
        '110489938=  ZAKAZ_REAL_PARENT_ TYPE OF COLUMN ZAKAZ_REAL_PARENT.' +
        'ZAKAZ_REAL_PARENT)'
      '110489939=RETURNS ('
      '110489940=  ERR_CODE INTEGER,'
      '110489941=  ERR_MSG VARCHAR(1024))'
      '110489942=AS'
      
        '110489943=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'ZR_DEL_ZAKAZ' +
        '_REAL_PARENT'#39#39';'
      '110489944=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110489945=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110489946=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110489947=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110489948=BEGIN'
      '110489949='
      
        '110489950=  -- '#1057#1053#1040#1063#1040#1051#1040' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044 +
        #1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1054#1053' '#1059#1046#1045' '#1053#1045' '#1054#1055#1051#1040#1063#1045#1053
      '110489951=  FOR SELECT G_PRODUCT,'
      '110489952=             Z.AMOUNT_ALL - Z.AMOUNT_PAYED,'
      '110489953=             ZP.G_TOCHKA'
      '110489954=        FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      '110489955=       WHERE Z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_'
      '110489956=         AND Z.IS_PAYED_ALL = 0'
      
        '110489957=         AND ZP.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT' +
        '_'
      '110489958=       INTO :G_PRODUCT_,'
      '110489959=            :AMOUNT_,'
      '110489960=            :G_TOCHKA_'
      '110489961=  DO BEGIN'
      '110489962=    UPDATE LT_SKLAD_PRODUCT LT'
      '110489963=       SET LT.AMOUNT = LT.AMOUNT + :AMOUNT_'
      '110489964=     WHERE LT.G_PRODUCT = :G_PRODUCT_'
      '110489965=       AND LT.G_TOCHKA = :G_TOCHKA_;'
      '110489966=  END'
      '110489967='
      '110489968=  -- '#1059#1044#1040#1051#1071#1070' '#1058#1054#1042#1040#1056' '#1048#1047' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      '110489969=  PNT_ = '#39#39'03'#39#39';'
      '110489970=  DELETE from ZAKAZ_NA_REAL z'
      '110489971=  WHERE z.ZAKAZ_REAL_PARENT = :ZAKAZ_REAL_PARENT_;'
      '110489972='
      '110489973=  DELETE FROM ZAKAZ_REAL_PARENT'
      '110489974=  WHERE ZAKAZ_REAL_PARENT =  :ZAKAZ_REAL_PARENT_;'
      '110489975=WHEN SQLCODE -530 DO'
      '110489976=  BEGIN'
      '110489977=    ERR_CODE = -20500;'
      
        '110489978=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39#39') RETURNING_V' +
        'ALUES (:ERR_MSG);'
      '110489979=    ERR_MSG = PROCNAME||ERR_MSG;'
      '110489980=  END'
      '110489981=END'
      '110489982='#39';'
      '110489983='
      '110489984=EXECUTE STATEMENT '#39'ALTER PROCEDURE P_REP_TOVAR_MOVE('
      '110489985=  G_CATEGORY_ VARCHAR(1000),'
      '110489986=  G_PRODUCT_ VARCHAR(1000),'
      '110489987=  DATE_BEGIN_ DATE,'
      '110489988=  DATE_END_ DATE,'
      '110489989=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '110489990=  G_TOCHKA_ARR_ VARCHAR(1000))'
      '110489991=RETURNS ('
      '110489992=  DATE_BEGIN_OUT_ DATE,'
      '110489993=  DATE_END_OUT_ DATE,'
      '110489994=  STR_ VARCHAR(500),'
      '110489995=  P_REP_TOVAR_MOVE_TABLE VARCHAR(100),'
      '110489996=  NAME VARCHAR(1000),'
      '110489997=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110489998=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110489999=  AMOUNT_IN MY_NUMERIC_5,'
      
        '1104810000=  AMOUNT_PRIHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUN' +
        'T,'
      '1104810001=  SUMM_PRIHOD NUMERIC(15,2),'
      '1104810002=  AMOUNT_UHOD TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1104810003=  SUMM_UHOD NUMERIC(15,2),'
      
        '1104810004=  AMOUNT_SPISANO TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1104810005=  SUMM_SPISANO NUMERIC(15,2),'
      
        '1104810006=  AMOUNT_VOZVRAT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOU' +
        'NT,'
      '1104810007=  SUMM_VOZVRAT NUMERIC(15,2),'
      
        '1104810008=  AMOUNT_PRIHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.A' +
        'MOUNT,'
      '1104810009=  SUMM_PRIHOD_SKL NUMERIC(15,2),'
      
        '1104810010=  AMOUNT_UHOD_SKL TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1104810011=  SUMM_UHOD_SKL NUMERIC(15,2),'
      '1104810012=  AMOUNT_OUT MY_NUMERIC_5,'
      '1104810013=  IS_HEAD INTEGER,'
      '1104810014=  ERR_CODE INTEGER,'
      '1104810015=  ERR_MSG VARCHAR(1024))'
      '1104810016=AS'
      
        '1104810017=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39#39'P_REP_TOVAR' +
        '_MOVE'#39#39';'
      '1104810018=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1104810019=DECLARE VARIABLE AMOUNT_PRIHOD_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT = 0;'
      '1104810020=DECLARE VARIABLE SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1104810021=DECLARE VARIABLE AMOUNT_UHOD_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT = 0;'
      '1104810022=DECLARE VARIABLE SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1104810023=DECLARE VARIABLE AMOUNT_SPISANO_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1104810024=DECLARE VARIABLE SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1104810025=DECLARE VARIABLE AMOUNT_VOZVRAT_ TYPE OF COLUMN LT_SK' +
        'LAD_PRODUCT.AMOUNT = 0;'
      '1104810026=DECLARE VARIABLE SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1104810027=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1104810028=DECLARE VARIABLE SUMM_PRIHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1104810029=DECLARE VARIABLE AMOUNT_UHOD_SKL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1104810030=DECLARE VARIABLE SUMM_UHOD_SKL_ NUMERIC(15,2) = 0;'
      
        '1104810031=DECLARE VARIABLE RECCAT_G_PRODUCT_ TYPE OF COLUMN G_P' +
        'RODUCT.G_PRODUCT;'
      
        '1104810032=DECLARE VARIABLE REC_G_PRODUCT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1104810033=DECLARE VARIABLE REC_AMOUNT_PRIHOD_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1104810034=DECLARE VARIABLE REC_SUMM_PRIHOD_ NUMERIC(15,2) = 0;'
      
        '1104810035=DECLARE VARIABLE REC_AMOUNT_UHOD_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1104810036=DECLARE VARIABLE REC_SUMM_UHOD_ NUMERIC(15,2) = 0;'
      
        '1104810037=DECLARE VARIABLE REC_AMOUNT_SPISANO_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1104810038=DECLARE VARIABLE REC_SUMM_SPISANO_ NUMERIC(15,2) = 0;'
      
        '1104810039=DECLARE VARIABLE REC_AMOUNT_VOZVRAT_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1104810040=DECLARE VARIABLE REC_SUMM_VOZVRAT_ NUMERIC(15,2) = 0;'
      
        '1104810041=DECLARE VARIABLE REC_AMOUNT_PRIHOD_SKL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1104810042=DECLARE VARIABLE REC_SUMM_PRIHOD_SKL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1104810043=DECLARE VARIABLE REC_AMOUNT_UHOD_SKL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1104810044=DECLARE VARIABLE REC_SUMM_UHOD_SKL_ NUMERIC(15,2) = 0' +
        ';'
      
        '1104810045=DECLARE VARIABLE AMOUNT_PRIHOD_ALL_ TYPE OF COLUMN LT' +
        '_SKLAD_PRODUCT.AMOUNT = 0;'
      '1104810046=DECLARE VARIABLE SUMM_PRIHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1104810047=DECLARE VARIABLE AMOUNT_UHOD_ALL_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT = 0;'
      '1104810048=DECLARE VARIABLE SUMM_UHOD_ALL_ NUMERIC(15,2) = 0;'
      
        '1104810049=DECLARE VARIABLE AMOUNT_SPISANO_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1104810050=DECLARE VARIABLE SUMM_SPISANO_ALL_ NUMERIC(15,2) = 0;'
      
        '1104810051=DECLARE VARIABLE AMOUNT_VOZVRAT_ALL_ TYPE OF COLUMN L' +
        'T_SKLAD_PRODUCT.AMOUNT = 0;'
      '1104810052=DECLARE VARIABLE SUMM_VOZVRAT_ALL_ NUMERIC(15,2) = 0;'
      
        '1104810053=DECLARE VARIABLE AMOUNT_PRIHOD_SKL_ALL_ TYPE OF COLUM' +
        'N LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1104810054=DECLARE VARIABLE SUMM_PRIHOD_SKL_ALL_ NUMERIC(15,2) =' +
        ' 0;'
      
        '1104810055=DECLARE VARIABLE AMOUNT_UHOD_SKL_ALL_ TYPE OF COLUMN ' +
        'LT_SKLAD_PRODUCT.AMOUNT = 0;'
      
        '1104810056=DECLARE VARIABLE SUMM_UHOD_SKL_ALL_ NUMERIC(15,2) = 0' +
        ';'
      '1104810057=DECLARE VARIABLE PATH_ VARCHAR(2000);'
      '1104810058=DECLARE VARIABLE PATH_OLD_ VARCHAR(2000) = '#39#39#39#39';'
      
        '1104810059=DECLARE VARIABLE GNAME_ TYPE OF COLUMN G_PRODUCT.NAME' +
        ';'
      '1104810060=DECLARE VARIABLE REC_AMOUNT_IN_ MY_NUMERIC_5 = 0;'
      '1104810061=DECLARE VARIABLE REC_AMOUNT_OUT_ MY_NUMERIC_5 = 0;'
      '1104810062=BEGIN'
      '1104810063='
      '1104810064=    DELETE FROM P_REP_TOVAR_MOVE_TABLE;'
      '1104810065=    EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -1);'
      '1104810066='
      '1104810067=    FOR SELECT G.G_PRODUCT, GP.PATH, G.NAME,'
      '1104810068=               -- '#1042#1061#1054#1044#1071#1065#1048#1049' '#1054#1057#1058#1040#1058#1054#1050
      
        '1104810069=               (select (select amount from lt_sklad_p' +
        'roduct where g_product = G.G_PRODUCT'
      
        '1104810070=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||g_tochka||'#39#39'-'#39#39')'
      '1104810071=                       +'
      
        '1104810072=                       (select COALESCE(sum(zd.amount' +
        '), 0) from zakaz_details zd, zakaz z'
      
        '1104810073=                        where zd.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '1104810074=                        and zd.zakaz = z.zakaz and z.' +
        'z_date >= :DATE_BEGIN_)'
      '1104810075=                       +'
      
        '1104810076=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1104810077=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||S.g_client||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1104810078=                       +'
      
        '1104810079=                       (select COALESCE(sum(od.amount' +
        '), 0) from other_details od, other o'
      
        '1104810080=                        where od.g_product = G.G_PROD' +
        'UCT and :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39#39'||o.G_TOCHKA||'#39#39'-'#39#39
      
        '1104810081=                        and od.other = o.other and o.' +
        'op_date >= :DATE_BEGIN_)'
      '1104810082=                       -'
      
        '1104810083=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and :G_TOCHKA_' +
        'ARR_ CONTAINING '#39#39'-'#39#39'||S.G_TOCHKA||'#39#39'-'#39#39
      
        '1104810084=                        and s.is_vozvrat <> 3 and s.d' +
        'ate_receipt >= :DATE_BEGIN_)'
      '1104810085=                       -'
      
        '1104810086=                       (select COALESCE(sum(s.amount)' +
        ', 0) from sklad s where s.g_product = G.G_PRODUCT and s.is_vozvr' +
        'at = 3'
      
        '1104810087=                        and :G_TOCHKA_ARR_ CONTAINING' +
        ' '#39#39'-'#39#39'||S.g_tochka||'#39#39'-'#39#39' and s.date_receipt >= :DATE_BEGIN_)'
      '1104810088=                  from rdb$database) AMOUNT_OUT,'
      '1104810089=               -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '1104810090=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1104810091=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1104810092=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1104810093=                   AND S.IS_VOZVRAT = 0'
      
        '1104810094=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD,'
      '1104810095=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1104810096=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1104810097=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1104810098=                   AND S.IS_VOZVRAT = 0'
      
        '1104810099=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD,'
      '1104810100=               -- '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040
      '1104810101=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1104810102=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1104810103=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1104810104=                   AND Z.IS_SPISANIE IN (0, 2)'
      '1104810105=                   AND Z.IS_RESERVE = 0'
      
        '1104810106=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_UHOD,'
      '1104810107=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1104810108=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1104810109=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1104810110=                   AND Z.IS_SPISANIE IN (0, 2)'
      '1104810111=                   AND Z.IS_RESERVE = 0'
      
        '1104810112=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_UHOD,'
      '1104810113=               -- '#1057#1055#1048#1057#1040#1053#1048#1045
      '1104810114=               (SELECT COALESCE(SUM(ZD.AMOUNT),0)'
      
        '1104810115=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1104810116=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1104810117=                   AND Z.IS_SPISANIE = 1'
      
        '1104810118=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||Z.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_SPISANO,'
      '1104810119=               (SELECT COALESCE(SUM(ZD.SUMM),0)'
      
        '1104810120=                  FROM ZAKAZ_DETAILS ZD, ZAKAZ Z WHER' +
        'E ZD.ZAKAZ = Z.ZAKAZ AND ZD.G_PRODUCT = G.G_PRODUCT'
      
        '1104810121=                   AND Z.Z_DATE BETWEEN :DATE_BEGIN_ ' +
        'AND :DATE_END_'
      '1104810122=                   AND Z.IS_SPISANIE = 1'
      
        '1104810123=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||Z.G_TOCHKA||'#39#39'-'#39#39') SUMM_SPISANO,'
      '1104810124=               -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '1104810125=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      
        '1104810126=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1104810127=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1104810128=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1104810129=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_VOZVRAT,'
      '1104810130=               (SELECT COALESCE(SUM(S.SUMM),0)'
      
        '1104810131=                  FROM SKLAD S WHERE S.G_PRODUCT = G.' +
        'G_PRODUCT'
      
        '1104810132=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1104810133=                   AND S.IS_VOZVRAT IN (1,2)'
      
        '1104810134=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_VOZVRAT,'
      
        '1104810135=               -- '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1057' '#1044#1056#1059 +
        #1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1067#1056#1040#1042#1053#1048#1042#1040#1053#1048#1045' '#1054#1057#1058#1040#1058#1050#1054#1042' '#1042' '#1056#1045#1047#1059#1051 +
        #1068#1058#1040#1058#1045' '#1056#1045#1042#1048#1047#1048#1048
      '1104810136=               (SELECT COALESCE(SUM(S.AMOUNT),0)'
      '1104810137=                  FROM SKLAD S'
      '1104810138=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '1104810139=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1104810140=                   AND S.IS_VOZVRAT IN (3, 4, 5)'
      
        '1104810141=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||S.G_TOCHKA||'#39#39'-'#39#39') AMOUNT_PRIHOD_SKL,'
      '1104810142=               (SELECT COALESCE(SUM(S.SUMM),0)'
      '1104810143=                  FROM SKLAD S'
      '1104810144=                 WHERE S.G_PRODUCT = G.G_PRODUCT'
      
        '1104810145=                   AND S.DATE_RECEIPT BETWEEN :DATE_B' +
        'EGIN_ AND :DATE_END_'
      '1104810146=                   AND S.IS_VOZVRAT IN (3, 4)'
      
        '1104810147=                   AND :G_TOCHKA_ARR_ CONTAINING '#39#39'-'#39 +
        #39'||S.G_TOCHKA||'#39#39'-'#39#39') SUMM_PRIHOD_SKL,'
      
        '1104810148=               -- '#1059#1061#1054#1044' '#1055#1056#1054#1063#1045#1045' - '#1059#1061#1054#1044' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1044#1056'. '#1057#1050 +
        #1051#1040#1044' '#1048' '#1059#1061#1054#1044' '#1050#1054#1052#1055#1051#1045#1050#1058#1059#1070#1065#1048#1061' '#1055#1056#1048' '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1045', '#1048' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058 +
        #1040#1042#1065#1048#1050#1059
      '1104810149=               (SELECT COALESCE(SUM(AMOUNT), 0)'
      
        '1104810150=                  FROM (SELECT COALESCE(S.AMOUNT, 0) ' +
        'AMOUNT'
      '1104810151=                          FROM SKLAD S'
      
        '1104810152=                         WHERE S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '1104810153=                           AND S.DATE_RECEIPT BETWEEN' +
        ' :DATE_BEGIN_ AND :DATE_END_'
      '1104810154=                           AND S.IS_VOZVRAT = 3'
      
        '1104810155=                           AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39#39'-'#39#39'||S.G_CLIENT||'#39#39'-'#39#39
      '1104810156=                        UNION ALL'
      
        '1104810157=                        SELECT COALESCE(D.AMOUNT, 0) ' +
        'AMOUNT'
      
        '1104810158=                          FROM OTHER O, OTHER_DETAILS' +
        ' D'
      '1104810159=                         WHERE O.OTHER = D.OTHER'
      
        '1104810160=                           AND O.OP_DATE BETWEEN :DAT' +
        'E_BEGIN_ AND :DATE_END_'
      
        '1104810161=                           AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39#39'-'#39#39'||O.G_TOCHKA||'#39#39'-'#39#39
      
        '1104810162=                           AND D.G_PRODUCT = G.G_PROD' +
        'UCT'
      '1104810163=                        UNION ALL'
      
        '1104810164=                        SELECT COALESCE(D.AMOUNT, 0) ' +
        'AMOUNT'
      
        '1104810165=                          FROM ZAKAZ Z, ZAKAZ_DETAILS' +
        ' D'
      '1104810166=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '1104810167=                           AND Z.Z_DATE BETWEEN :DATE' +
        '_BEGIN_ AND :DATE_END_'
      
        '1104810168=                           AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39#39'-'#39#39'||Z.G_TOCHKA||'#39#39'-'#39#39
      
        '1104810169=                           AND D.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '1104810170=                           AND Z.IS_SPISANIE = 4)) AM' +
