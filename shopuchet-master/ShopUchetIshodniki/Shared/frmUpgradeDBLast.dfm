      '11042683=                END'
      '11042684=            END'
      '11042685='
      '11042686=        -- '#1045#1057#1051#1048' '#1042#1057#1045'-'#1058#1040#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1045#1057#1050#1054#1051#1068#1050#1054
      '11042687=        END ELSE BEGIN'
      '11042688=            WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      
        '11042689=                POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS' +
        '_);'
      
        '11042690=                IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA' +
        '_) THEN'
      
        '11042691=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' POS_TILDA_ - 1);'
      '11042692=                ELSE'
      
        '11042693=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR' +
        ' CHAR_LENGTH(PAYMENTS_) - 1);'
      '11042694='
      
