      '110752577=                       S.PRICE    = :PRICE_,'
      '110752578=                       S.SUMM     = :SUMMM_,'
      '110752579=                       S.OSNOVANIE = :OSNOVANIE_,'
      '110752580=                       S.NOTE      = :NOTE_'
      '110752581=                 WHERE S.SKLAD = :ZAKAZ_DETAILS_;'
      '110752582='
      '110752583='
      
        '110752584=                IF (AMOUNT_OLD_ > Z_AMOUNT_) THEN BEGI' +
        'N'
      
        '110752585=                  -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045 +
        '-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1045
      '110752586=                  UPDATE LT_SKLAD_PRODUCT L'
      
        '110752587=                     SET L.AMOUNT = L.AMOUNT + (:AMOUN' +
