      '1102426=  NAME_G_UNIT_ TYPE OF COLUMN G_UNIT.NAME,'
      '1102427=  PRICE_ TYPE OF COLUMN G_PRODUCT.PRICE,'
      '1102428=  VOLUME_PRICE_ TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '1102429=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11024210=  SELF_PRICE_ NUMERIC(15,2),'
      '11024211=  AMOUNT_ MY_NUMERIC_5,'
      '11024212=  PACK_AMOUNT_ TYPE OF COLUMN G_PRODUCT.PACK_AMOUNT,'
