      '11079149=END'
      '11079150=;'
      '11079151='
      '11079152='
      
        '11079153=/******************************************************' +
        '************************/'
      
        '11079154=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11079155=/******************************************************' +
        '************************/'
      '11079156=ALTER PROCEDURE P_REP_PRIHOD_WAYBILL('
      '11079157=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '11079158=  CURRENCY_ INTEGER)'
      '11079159=RETURNS ('
      '11079160=  NUMBER_STR_ VARCHAR(200),'
      '11079161=  ROW_NUM INTEGER,'
      '11079162=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11079163=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11079164=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11079165=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11079166=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11079167=  AMOUNT MY_NUMERIC_5,'
      '11079168=  PRICE_N VARCHAR(50),'
      '11079169=  SUMM_N VARCHAR(50),'
      '11079170=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '11079171=  PRICE TYPE OF COLUMN SKLAD.PRICE,'
      '11079172=  SUMM_VSEGO_ VARCHAR(50),'
      '11079173=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11079174=  POSTAVSHIK_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11079175=  SUMM_STR_ VARCHAR(500),'
      '11079176=  ERR_CODE NUMERIC(15,2),'
      '11079177=  ERR_MSG VARCHAR(1024))'
      '11079178=AS'
      '11079179=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1048#1061#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '11079180=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRIHOD_W' +
        'AYBILL'#39';'
      '11079181=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11079182=DECLARE VARIABLE I INTEGER = 1;'
      
        '11079183=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11079184=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.IS_VOZVRAT;'
      '11079185=BEGIN'
      '11079186='
      
        '11079187=  SELECT '#39#1053#1072#1082#1083#1072#1076#1085#1072#1103' '#8470#39'||P.sklad||'#39' '#1086#1090' '#39'||lpad(EXTRACT(D' +
        'AY FROM P.date_receipt), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P' +
        '.date_receipt), 2, 0)||'#39'.'#39'||EXTRACT(YEAR FROM P.date_receipt),'
      '11079188=         G.name,'
      '11079189=         P.IS_VOZVRAT'
      
        '11079190=    FROM sklad_parent P LEFT OUTER join G_CLIENT G ON P' +
        '.g_client = G.G_CLIENT'
      '11079191=   WHERE P.sklad = :sklad_parent_'
      '11079192=    INTO :NUMBER_STR_,'
      '11079193=         :POSTAVSHIK_NAME_,'
      '11079194=         :IS_VOZVRAT_;'
      '11079195='
      
        '11079196=  -- '#1045#1057#1051#1048' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048', '#1058#1054' '#1053#1040#1044#1054' '#1042#1067#1058#1040#1065#1048#1058#1068' ' +
        #1048#1052#1071' '#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071' '#1048#1047' G_TOCHKA'
      '11079197=  IF (IS_VOZVRAT_ = 3) THEN'
      '11079198=    SELECT G.NAME'
      '11079199=      FROM SKLAD_PARENT P, G_TOCHKA G'
      '11079200=     WHERE P.SKLAD = :sklad_parent_'
      '11079201=       AND P.G_TOCHKA = G.G_TOCHKA'
      '11079202=      INTO :POSTAVSHIK_NAME_;'
      '11079203='
      
        '11079204=  SELECT SUM(S.amount)  --REPLACE(CAST(SUM(S.amount) AS' +
        ' VARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '11079205=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39')'
      
        '11079206=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ)' +
        ', :CURRENCY_))'
      '11079207=    FROM SKLAD S'
      '11079208=   WHERE S.sklad_parent = :sklad_parent_'
      '11079209=   GROUP BY S.sklad_parent'
      '11079210=    INTO :AMOUNT_VSEGO_,'
      '11079211=         :SUMM_VSEGO_,'
      '11079212=         :summ_str_;'
      '11079213='
      '11079214=  SELECT NAME'
      '11079215=    FROM CUR_PARAMS'
      '11079216=   WHERE CUR_PARAMS = 1'
      '11079217=    INTO :G_OFFICIAL_FM_;'
      '11079218='
      '11079219=  FOR SELECT :I,'
      '11079220=             G.name,'
      '11079221=             G.ARTICUL,'
      '11079222=             G.BARCODE,'
      '11079223=             G.NOMENCLATUR_NUM,'
      '11079224=             U.short_name,'
      
        '11079225=             S.amount,    --REPLACE(CAST(S.amount AS VA' +
        'RCHAR(10)), '#39'.'#39', '#39','#39'),'
      
        '11079226=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.'#39',' +
        ' '#39','#39'),'
      
        '11079227=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39', ' +
        #39','#39'),'
      '11079228=             G.PRICE'
      '11079229=        FROM SKLAD S, G_PRODUCT G, G_UNIT U'
      '11079230=       WHERE S.sklad_parent = :sklad_parent_'
      '11079231=         AND S.g_product = G.g_product'
      '11079232=         AND G.g_unit = U.g_unit'
      '11079233=        INTO :ROW_NUM,'
      '11079234=            :NAME,'
      '11079235=            :ARTICUL,'
      '11079236=            :BARCODE,'
      '11079237=            :NOMENCLATUR_NUM,'
      '11079238=            :SHORT_NAME,'
      '11079239=            :AMOUNT,'
      '11079240=            :PRICE_N,'
      '11079241=            :SUMM_N,'
      '11079242=            :PRICE'
      '11079243=  DO BEGIN'
      '11079244=    I = I + 1;'
      '11079245=    SUSPEND;'
      '11079246=  END'
      '11079247=WHEN ANY DO BEGIN'
      '11079248=    Err_code = -20500;'
      
        '11079249=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11079250=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11079251=  END'
      '11079252=end'
      '11079253=;'
      '11079254='
      '11079255=ALTER PROCEDURE P_REP_PRODAZHA_WAYBILL('
      '11079256=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11079257=  CURRENCY_ INTEGER)'
      '11079258=RETURNS ('
      '11079259=  NUMBER_STR_ VARCHAR(200),'
      '11079260=  ROW_NUM INTEGER,'
      '11079261=  CATEGORY_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11079262=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11079263=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11079264=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11079265=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11079266=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11079267=  AMOUNT MY_NUMERIC_5,'
      '11079268=  PRICE_N VARCHAR(50),'
      '11079269=  SUMM_N VARCHAR(50),'
      '11079270=  AMOUNT_VSEGO_ MY_NUMERIC_5,'
      '11079271=  SUMM_VSEGO_ VARCHAR(50),'
      '11079272=  NDS_SUMM_ VARCHAR(50),'
      '11079273=  G_OFFICIAL_FM_ TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '11079274=  CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.NAME,'
      '11079275=  SUMM_STR_ VARCHAR(500),'
      '11079276=  NDS_SUMM_STR_ VARCHAR(500),'
      '11079277=  ERR_CODE NUMERIC(15,2),'
      '11079278=  ERR_MSG VARCHAR(1024))'
      '11079279=AS'
      '11079280=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1055#1056#1054#1044#1040#1046#1053#1054#1049' '#1059#1055#1056#1054#1065#1045#1053#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049'*/'
      
        '11079281=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRODAZHA' +
        '_WAYBILL'#39';'
      '11079282=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11079283=DECLARE VARIABLE I INTEGER = 1;'
      
        '11079284=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIRM' +
        '_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '11079285=DECLARE VARIABLE NDS_ TYPE OF COLUMN ZAKAZ_DETAILS.NDS_' +
        'SUMM;'
      '11079286=BEGIN'
      '11079287='
      
        '11079288=  SELECT decode(P.is_spisanie, 1, '#39#1057#1087#1080#1089#1072#1085#1080#1077' '#39', '#39#1053#1072#1082#1083#1072#1076#1085 +
        #1072#1103' '#8470#39'||P.ZAKAZ)||'#39' '#1086#1090' '#39'||lpad(EXTRACT(DAY FROM P.z_date), 2, '#39'0'#39 +
        ')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM P.z_date), 2, 0)||'#39'.'#39'||EXTRACT(Y' +
        'EAR FROM P.z_date),'
      '11079289=         G.name'
      '11079290=    FROM ZAKAZ P,'
      '11079291=         G_CLIENT G'
      '11079292=   WHERE P.ZAKAZ = :ZAKAZ_'
      '11079293=     AND P.g_client = G.G_CLIENT'
      '11079294=    INTO :NUMBER_STR_,'
      '11079295=         :CLIENT_NAME_;'
      '11079296='
      
        '11079297=  SELECT SUM(S.amount)--REPLACE(CAST(SUM(S.amount) AS V' +
        'ARCHAR(10)), '#39'.'#39', '#39','#39')'
      
        '11079298=         ,REPLACE(CAST(SUM(S.summ) AS VARCHAR(50)), '#39'.'#39 +
        ', '#39','#39')'
      
        '11079299=         ,(SELECT CURR_STR from CURRENCYSTR(SUM(S.summ)' +
        ', :CURRENCY_))'
      
        '11079300=         ,REPLACE(CAST(SUM(S.nds_summ) AS VARCHAR(50)),' +
        ' '#39'.'#39', '#39','#39')'
      '11079301=         ,SUM(S.nds_summ)'
      '11079302=    FROM ZAKAZ_DETAILS S'
      '11079303=   WHERE S.ZAKAZ = :ZAKAZ_'
      '11079304=   GROUP BY S.ZAKAZ'
      '11079305=    INTO :AMOUNT_VSEGO_,'
      '11079306=         :SUMM_VSEGO_,'
      '11079307=         :summ_str_,'
      '11079308=         :NDS_SUMM_,'
      '11079309=         :NDS_;'
      '11079310='
      '11079311=  if (NDS_ > 0) then'
      
        '11079312=    SELECT '#39#1042' '#1090#1086#1084' '#1095#1080#1089#1083#1077' '#1053#1044#1057': '#39'||CURR_STR from CURRENCYS' +
        'TR(:NDS_, :CURRENCY_) INTO NDS_SUMM_STR_;'
      '11079313='
      '11079314=  SELECT NAME'
      '11079315=    FROM CUR_PARAMS'
      '11079316=   WHERE CUR_PARAMS = 1'
      '11079317=    INTO :G_OFFICIAL_FM_;'
      '11079318='
      '11079319=  FOR SELECT :I,'
      '11079320=             C.NAME,'
      '11079321=             G.name,'
      '11079322=             G.ARTICUL,'
      '11079323=             G.BARCODE,'
      '11079324=             G.NOMENCLATUR_NUM,'
      '11079325=             U.short_name,'
      
        '11079326=             S.amount,--REPLACE(CAST(S.amount AS VARCHA' +
        'R(10)), '#39'.'#39', '#39','#39'),'
      
        '11079327=             REPLACE(CAST(S.price AS VARCHAR(50)), '#39'.'#39',' +
        ' '#39','#39'),'
      
        '11079328=             REPLACE(CAST(S.summ AS VARCHAR(50)), '#39'.'#39', ' +
        #39','#39')'
      
        '11079329=        FROM ZAKAZ_DETAILS S, G_PRODUCT G, G_UNIT U, G_' +
        'PRODUCT C'
      '11079330=       WHERE S.ZAKAZ = :ZAKAZ_'
      '11079331=         AND S.g_product = G.g_product'
      '11079332=         AND G.g_unit = U.g_unit'
      '11079333=         AND G.G_PRODUCT_PAR = C.G_PRODUCT'
      '11079334=        INTO :ROW_NUM,'
      '11079335=            :CATEGORY_NAME,'
      '11079336=            :NAME,'
      '11079337=            :ARTICUL,'
      '11079338=            :BARCODE,'
      '11079339=            :NOMENCLATUR_NUM,'
      '11079340=            :SHORT_NAME,'
      '11079341=            :AMOUNT,'
      '11079342=            :PRICE_N,'
      '11079343=            :SUMM_N'
      '11079344=  DO BEGIN'
      '11079345=    I = I + 1;'
      '11079346=    SUSPEND;'
      '11079347=  END'
      '11079348=WHEN ANY DO BEGIN'
      '11079349=    Err_code = -20500;'
      
        '11079350=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1055#1045#1063#1040#1058#1048'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11079351=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11079352=  END'
      '11079353=end'
      '11079354=;'
      '11079355='
      '11079356=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '11079357=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '11079358=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PARENT' +
        ','
      '11079359=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '11079360=  DATE_BEGIN_ DATE,'
      '11079361=  DATE_END_ DATE,'
      '11079362=  TIME_BEGIN_ TIME,'
      '11079363=  TIME_END_ TIME,'
      '11079364=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '11079365=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '11079366=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1)'
      '11079367=RETURNS ('
      '11079368=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11079369=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11079370=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '11079371=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'TENGE,'
      
        '11079372=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_S' +
        'UMM,'
      '11079373=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11079374=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '11079375=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11079376=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11079377=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11079378=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11079379=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11079380=  Z_DATE BLOB SUB_TYPE 1,'
      '11079381=  ROW INTEGER,'
      '11079382=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '11079383=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11079384=  ERR_CODE INTEGER,'
      '11079385=  ERR_MSG VARCHAR(1024))'
      '11079386=AS'
      
        '11079387=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_L' +
        'IST'#39';'
      '11079388=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11079389=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '11079390=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE 8' +
        '0;'
      
        '11079391=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ARTI' +
        'CUL;'
      
        '11079392=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BARC' +
        'ODE;'
      
        '11079393=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PROD' +
        'UCT.BARCODE;'
      
        '11079394=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      
        '11079395=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11079396=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMENT' +
        '_TYPE.NAME;'
      
        '11079397=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.N' +
        'AME;'
      
        '11079398=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.PR' +
        'ICE;'
      
        '11079399=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SUM' +
        'M = 0;'
      
        '11079400=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11079401=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '11079402=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_TENGE;'
      
        '11079403=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_DE' +
        'TAILS.DISCOUNT_SUMM = 0;'
      
        '11079404=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '11079405=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '11079406=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '11079407=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.P' +
        'ATH = '#39#39';'
      '11079408=DECLARE VARIABLE I INTEGER = 1;'
      '11079409=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      '11079410=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAME;'
      '11079411=BEGIN'
      '11079412=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '11079413=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '11079414='
      
        '11079415=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') || ' +
        #39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extrac' +
        't(year from Z.Z_DATE),'
      '11079416=             Z.Z_TIME,'
      '11079417=             GP.ARTICUL,'
      '11079418=             GP.BARCODE,'
      '11079419=             GP.NOMENCLATUR_NUM,'
      '11079420=             GP.NAME,'
      '11079421=             ZD.AMOUNT,'
      '11079422=             ZD.PRICE,'
      '11079423=             ZD.DISCOUNT_TENGE,'
      '11079424=             ZD.SUMM,'
      '11079425=             ZD.DISCOUNT_SUMM,'
      '11079426=             GC.NAME,'
      '11079427=             P.NAME,'
      '11079428=             TR.PATH,'
      '11079429=             Z.NOTE,'
      '11079430=             U.SHORT_NAME'
      '11079431=      FROM ZAKAZ Z,'
      '11079432=           ZAKAZ_DETAILS ZD,'
      '11079433=           G_CLIENT GC,'
      '11079434=           G_PAYMENT_TYPE P,'
      '11079435=           G_PRODUCT GP,'
      '11079436=           G_UNIT U,'
      '11079437=           P_REP_TREE TR'
      
        '11079438=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||'#39 +
        '-'#39
      '11079439=       AND Z.IS_SPISANIE IN (0,2)'
      '11079440=       AND Z.IS_RESERVE = 0'
      '11079441=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '11079442=       AND Z.G_CLIENT = GC.G_CLIENT'
      '11079443=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '11079444=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '11079445=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '11079446=       AND GP.G_UNIT = U.G_UNIT'
      '11079447=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11079448=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(Z' +
        '.G_CLIENT, 1))'
      
        '11079449=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT_' +
        ', GC.G_CLIENT_PARENT)'
      
        '11079450=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFFI' +
        'CIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '11079451=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_EN' +
        'D_ AND :TIME_BEGIN_ IS NULL)'
      '11079452=            OR'
      
        '11079453=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGIN' +
        '_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN_' +
        ' IS NOT NULL)'
      '11079454=           )/*'
      
        '11079455=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_EN' +
        'D_ AND :TIME_BEGIN_ IS NOT NULL)'
      '11079456=            OR'
      '11079457=            :TIME_BEGIN_ IS NULL)*/'
      
        '11079458=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11079459=             OR'
      '11079460=             (:G_CATEGORY_ IS NULL)'
      '11079461=           )'
      
        '11079462=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT||' +
        #39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '11079463=             OR'
      '11079464=            (:G_PRODUCT_ IS NULL)'
      '11079465=           )'
      '11079466=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '11079467=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :NO' +
        'MENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '11079468=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, :C' +
        'LIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_'
      '11079469=  DO BEGIN'
      '11079470=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '11079471=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '11079472=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11079473=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "D' +
        'ATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '11079474=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_,' +
        ' :DISCOUNT_SUMM_ROLL_, 1);'
      '11079475='
      '11079476=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11079477=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11079478=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + D' +
        'ISCOUNT_SUMM_ROLL_;'
      '11079479=            SUMM_ROLL_ = 0;'
      '11079480=            DISCOUNT_SUMM_ROLL_ = 0;'
      '11079481=            I = I + 1;'
      '11079482=        END'
      '11079483='
      '11079484=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11079485=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE"' +
        ', ROW)'
      '11079486=        VALUES (:I, :PATH_, 1);'
      '11079487=        I = I + 1;'
      '11079488=    END'
      '11079489='
      
        '11079490=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "T' +
        'IME", ARTICUL, BARCODE, NOMENCLATUR_NUM, NAME, AMOUNT, PRICE, DI' +
        'SCOUNT, SUMM,'
      
        '11079491=                                         DISCOUNT_SUMM,' +
        ' CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME)'
      
        '11079492=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE' +
        '_, :NOMENCLATUR_NUM_, :TOVAR_NAME_, :AMOUNT_, :PRICE_, :DISCOUNT' +
        '_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '11079493=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0, :' +
        'UNIT_NAME_);'
      '11079494='
      '11079495=    I = I + 1;'
      '11079496=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '11079497=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOUN' +
        'T_SUMM_;'
      '11079498=    LAST_PATH_ = PATH_;'
      '11079499=  END'
      '11079500='
      '11079501=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '11079502=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11079503=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOUNT' +
        '_SUMM_ROLL_, 1);'
      '11079504='
      '11079505=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '11079506=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '11079507=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_SU' +
        'MM_ROLL_;'
      '11079508='
      
        '11079509=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUMM' +
        ', DISCOUNT_SUMM, ROW)'
      
        '11079510=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL_,' +
        ' 2);'
      '11079511='
      
        '11079512=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENCLA' +
        'TUR_NUM, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_SUMM, CLI' +
        'ENT_NAME,'
      '11079513=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME'
      '11079514=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '11079515=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOMEN' +
        'CLATUR_NUM, :TOVAR_NAME,'
      
        '11079516=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :DI' +
        'SCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      '11079517=           :NOTE, :UNIT_NAME'
      '11079518=  do suspend;'
      '11079519='
      '11079520=WHEN ANY DO BEGIN'
      '11079521=    Err_code = -20500;'
      
        '11079522=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048 +
        ' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11079523=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MSG' +
        ';'
      '11079524=  END'
      '11079525=end'
      '11079526=;'
      
