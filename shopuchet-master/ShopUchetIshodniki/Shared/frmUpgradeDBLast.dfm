      '11060119=;'
      '11060120='
      '11060121=ALTER PROCEDURE DELIVERY_GET('
      
        '11060122=  DELIVERY_ /* TYPE OF COLUMN DELIVERY.DELIVERY */ INTE' +
        'GER)'
      '11060123=RETURNS ('
      
        '11060124=  G_CLIENT_ /* TYPE OF COLUMN DELIVERY.G_CLIENT */ INTE' +
        'GER,'
      
        '11060125=  DOSTAVSHIK_ /* TYPE OF COLUMN DELIVERY.DOSTAVSHIK */ ' +
        'INTEGER,'
      
        '11060126=  DOSTAVSHIK_NAME_ /* TYPE OF COLUMN G_CLIENT.NAME */ V' +
        'ARCHAR(250),'
      
        '11060127=  DELIVERY_DATE_ /* TYPE OF COLUMN DELIVERY.DELIVERY_DA' +
        'TE */ DATE,'
      
        '11060128=  ADDRESS_ /* TYPE OF COLUMN DELIVERY.ADDRESS */ VARCHA' +
        'R(250),'
      
