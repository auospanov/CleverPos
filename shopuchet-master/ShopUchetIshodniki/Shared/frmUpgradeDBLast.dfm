        'FFICIAL_'
      
        '110621289=                                                  ) RE' +
        'TURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110621290=                END'
      '110621291=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621292=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110621293=                  EXIT;'
      '110621294=                END'
      '110621295=            END'
      
        '110621296=            -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062 +
        #1059
      
        '110621297=            --========================================' +
        '========================='
      '110621298='
      '110621299=      END -- '#1050#1054#1053#1045#1062' IF SPISANIE = 0'
      '110621300='
      '110621301=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '110621302=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0)' +
        ' THEN'
      
        '110621303=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110621304=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKAZ' +
        '_, 2);'
      '110621305=  END'
      '110621306=  -- '#1050#1054#1053#1045#1062' '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      
        '110621307=  ----------------------------------------------------' +
        '-----------'
      
        '110621308=  --**************************************************' +
        '***********'
      
        '110621309=  ----------------------------------------------------' +
        '-----------'
      '110621310=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110621311=  ELSE BEGIN'
      '110621312=      PNT_ = '#39'020'#39';'
      '110621313=      SELECT SP.G_TOCHKA,'
      '110621314=             SP.G_CLIENT'
      '110621315=        FROM SKLAD_PARENT SP'
      '110621316=       WHERE SP.SKLAD = :ZAKAZ_'
      '110621317=        INTO :G_TOCHKA_OLD_,'
      '110621318=             :G_TOCHKA_;'
      '110621319='
      
        '110621320=      -- '#1052#1054#1046#1045#1058' '#1055#1054#1051#1059#1063#1048#1058#1068#1057#1071' '#1058#1040#1050', '#1063#1058#1054' '#1055#1054#1052#1045#1053#1071#1051' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063 +
        #1040#1058#1045#1051#1068', '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1042#1057#1045', '#1063#1058#1054' '#1041#1067#1051#1054' '#1053#1040' '#1055#1056#1045#1046#1053#1045#1052' '#1057#1050#1051#1040#1044 +
        #1045'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1045', '#1048' '#1055#1045#1056#1045#1050#1048#1053#1059#1058#1068' '#1042#1057#1045' '#1053#1040' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110621321=      PNT_ = '#39'021'#39';'
      '110621322=      IF (G_TOCHKA_OLD_ <> G_CLIENT_) THEN BEGIN'
      
        '110621323=          EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:ZAKAZ_, ' +
        'NULL) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110621324=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621325=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110621326=            EXIT;'
      '110621327=          END'
      '110621328='
      '110621329=          --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1048' '#1042' '#1053#1054#1042#1067#1049' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      '110621330=          FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110621331=                FROM ZAKAZ_DETAILS_TMP Z'
      '110621332=              INTO :G_PRODUCT_,'
      '110621333=                  :Z_AMOUNT_,'
      '110621334=                  :PRICE_,'
      '110621335=                  :SUMMM_'
      '110621336=          DO BEGIN'
      '110621337=            -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '110621338=            -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1048#1051#1048' '#1053#1045#1058
      '110621339=            IS_THIS_LAST_ = 0;'
      '110621340=            SELECT MAX(SK.DATE_RECEIPT)'
      '110621341=                FROM SKLAD SK'
      '110621342=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110621343=                 AND SK.IS_LAST = 1'
      '110621344=                 AND SK.G_TOCHKA = :G_CLIENT_'
      '110621345=                INTO :DATE_LAST_;'
      '110621346='
      
        '110621347=            IF ((ROW_COUNT = 0) or (Z_DATE_ >= COALESC' +
        'E(DATE_LAST_, CURRENT_DATE))) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110621348=                UPDATE SKLAD SK'
      '110621349=                   SET SK.IS_LAST = 0'
      '110621350=                 WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '110621351=                   AND SK.IS_LAST = 1'
      '110621352=                   AND SK.G_TOCHKA = :G_CLIENT_;'
      '110621353='
      '110621354=                IS_THIS_LAST_ = 1;'
      '110621355=            END'
      '110621356='
      '110621357='
      '110621358=            INSERT INTO SKLAD'
      '110621359=            ('
      '110621360=             SKLAD,'
      '110621361=             SKLAD_PARENT,'
      '110621362=             DATE_RECEIPT,'
      '110621363=             G_CLIENT,'
      '110621364=             G_PRODUCT,'
