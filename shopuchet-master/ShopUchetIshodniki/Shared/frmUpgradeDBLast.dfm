      '110202514='
      '110202515=      INSERT INTO KASSA_BEZNAL_STATE'
      
        '110202516=        (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CRE' +
        'DIT, OUTPUT)'
      '110202517=      VALUES'
      
        '110202518=        (GEN_ID(GEN_KASSA_STATE, 1), :ACTION_DATE_, CO' +
        'ALESCE(:INPUT_, 0), COALESCE(:DEBET_, 0), COALESCE(:CREDIT_, 0),' +
        ' COALESCE(:INPUT_, 0) - COALESCE(:DEBET_, 0) + COALESCE(:CREDIT_' +
        ',0));'
      '110202519='
      
        '110202520=      -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068 +
        ' '#1058#1040#1041#1051#1048#1062#1059' LOGS'
      
        '110202521=      IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYST' +
        'EM_SETUP = 5) > 0) THEN BEGIN'
      
        '110202522=            SQL_STMT_ ='#39'MERGE INTO KASSA_BEZNAL_STATE ' +
        'c '#39'||'
      
        '110202523=                       '#39'USING (select CAST('#39#39#39'||ACTION' +
        '_DATE_||'#39#39#39' AS DATE) as K_DATE'#39'||'
      '110202524=                       '#39' from RDB$DATABASE) cd '#39'||'
      '110202525=                       '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '110202526=                       '#39'WHEN MATCHED THEN '#39'||'
      '110202527=                       '#39' UPDATE SET '#39'||'
      
        '110202528=                       '#39'  C.INPUT  = COALESCE((SELECT ' +
        '"OUTPUT" FROM KASSA_BEZNAL_STATE WHERE K_DATE = (SELECT MAX(K_DA' +
        'TE) '#39'||'
      
        '110202529=                                                      ' +
        '                                          '#39' FROM KASSA_BEZNAL_ST' +
        'ATE '#39'||'
      
        '110202530=                                                      ' +
        '                                          '#39' WHERE K_DATE < CD.K_' +
        'DATE) '#39'||'
      
        '110202531=                                                      ' +
        '                                          '#39' ), 0), '#39'||'
      
        '110202532=                       '#39'  C.DEBET  = C.DEBET + '#39'||DEBE' +
        'T_||'#39', '#39'||'
      
        '110202533=                       '#39'  C.CREDIT = C.CREDIT + '#39'||CRE' +
        'DIT_||'#39', '#39'||'
      
        '110202534=                       '#39'  C.OUTPUT = COALESCE((SELECT ' +
        '"OUTPUT" FROM KASSA_BEZNAL_STATE WHERE K_DATE = (SELECT MAX(K_DA' +
        'TE) '#39'||'
      
        '110202535=                                                      ' +
        '                                          '#39' FROM KASSA_BEZNAL_ST' +
        'ATE '#39'||'
      
        '110202536=                                                      ' +
        '                                          '#39' WHERE K_DATE < CD.K_' +
        'DATE) '#39'||'
      
        '110202537=                                                      ' +
        '                                          '#39' ), 0) - (C.DEBET + '#39 +
        '||DEBET_||'#39') + (C.CREDIT + '#39'||CREDIT_||'#39') '#39'||'
      '110202538=                       '#39'WHEN NOT MATCHED THEN '#39'||'
      
        '110202539=                       '#39' INSERT (KASSA_BEZNAL_STATE, K' +
        '_DATE, "INPUT", DEBET, CREDIT, "OUTPUT") '#39'||'
      
        '110202540=                       '#39' VALUES ('#39'||GEN_ID(GEN_KASSA_S' +
        'TATE, 0)||'#39', '#39#39#39'||ACTION_DATE_||'#39#39#39', COALESCE((SELECT "OUTPUT" F' +
        'ROM KASSA_BEZNAL_STATE WHERE '#39'||'
      
