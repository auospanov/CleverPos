      '11023912='
      '11023913=ALTER PROCEDURE SYNC_DOWNLOAD('
      '11023914=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '11023915=RETURNS ('
      '11023916=  ERR_CODE INTEGER,'
      '11023917=  ERR_MSG VARCHAR(1024),'
      '11023918=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '11023919=AS'
      '11023920=BEGIN'
      '11023921=  SUSPEND;'
      '11023922=END'
      '11023923=;'
      '11023924='
      '11023925=ALTER PROCEDURE SYNC_UPLOAD('
      
        '11023926=  SYNC_COMPS_ /* TYPE OF COLUMN SYNC_COMPS.SYNC_COMPS *' +
        '/ INTEGER)'
      '11023927=RETURNS ('
      '11023928=  ID /* TYPE OF COLUMN LOGS.ID */ BIGINT,'
      
        '11023929=  SQLSTMT /* TYPE OF COLUMN LOGS.SQLSTMT */ VARCHAR(300' +
        '00),'
      '11023930=  TTABLE /* TYPE OF COLUMN LOGS.TTABLE */ VARCHAR(50),'
      '11023931=  USR /* TYPE OF COLUMN LOGS.USR */ VARCHAR(50),'
      '11023932=  RR /* TYPE OF COLUMN LOGS.RR */ VARCHAR(50),'
      
        '11023933=  DAT /* TYPE OF COLUMN LOGS.DAT */ BLOB SEGMENT SIZE 1' +
        '6384)'
      '11023934=AS'
      '11023935=BEGIN'
      '11023936=  SUSPEND;'
      '11023937=END'
      '11023938=;'
      '11023939='
      '11023940='
      
        '11023941=/******************************************************' +
        '************************/'
      
        '11023942=/****                           Altering tables        ' +
        '                    ****/'
      
        '11023943=/******************************************************' +
        '************************/'
      '11023944=EXECUTE PROCEDURE LOG_DEINIT;'
      '11023945=ALTER TABLE LOGS'
      '11023946=  ADD SQLSTMT1 BLOB SUB_TYPE 1 SEGMENT SIZE 16384;'
      '11023947='
      '11023948='
      
        '11023949=/******************************************************' +
        '************************/'
      
        '11023950=/****                      Updating column positions   ' +
        '                    ****/'
      
        '11023951=/******************************************************' +
        '************************/'
      '11023952=ALTER TABLE LOGS ALTER COLUMN ID POSITION 1;'
      '11023953='
      '11023954=ALTER TABLE LOGS ALTER COLUMN ID_ORIGINAL POSITION 2;'
      '11023955='
      '11023956=ALTER TABLE LOGS ALTER COLUMN SQLSTMT POSITION 3;'
      '11023957='
      '11023958=ALTER TABLE LOGS ALTER COLUMN TTABLE POSITION 4;'
      '11023959='
      '11023960=ALTER TABLE LOGS ALTER COLUMN USR POSITION 5;'
      '11023961='
      '11023962=ALTER TABLE LOGS ALTER COLUMN RR POSITION 6;'
      '11023963='
      '11023964=ALTER TABLE LOGS ALTER COLUMN DAT POSITION 7;'
      '11023965='
      '11023966=ALTER TABLE LOGS ALTER COLUMN IS_TRANSFERED POSITION 8;'
      '11023967='
      '11023968=ALTER TABLE LOGS ALTER COLUMN SYSDATE POSITION 9;'
      '11023969='
      '11023970=ALTER TABLE LOGS ALTER COLUMN ERR_CODE POSITION 10;'
      '11023971='
      '11023972=ALTER TABLE LOGS ALTER COLUMN SQLSTMT1 POSITION 11;'
      '11023973=COMMIT WORK;'
      '11023974='
      
        '11023975=/******************************************************' +
        '************************/'
      
        '11023976=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11023977=/******************************************************' +
        '************************/'
      '11023978='
      '11023979=ALTER PROCEDURE G_TOCHKA_DEL('
      '11023980=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '11023981=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '11023982=RETURNS ('
      '11023983=  ERR_CODE INTEGER,'
      '11023984=  ERR_MSG VARCHAR(1024))'
      '11023985=AS'
      '11023986=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      '11023987=BEGIN'
      '11023988=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '11023989=    ERR_CODE = -20500;'
      
        '11023990=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091#1076#1072 +
        #1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '11023991=    EXIT;'
      '11023992=  END'
      '11023993='
      '11023994=  DELETE FROM KASSA_STATE S'
      '11023995=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '11023996='
      
        '11023997=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053#1040' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1058#1054' '#1053#1040#1044#1054' '#1042#1057#1058#1040#1042#1048#1058#1068' '#1058#1040#1041#1051 +
        #1048#1062#1059' LOGS'
      
        '11023998=  IF ((SELECT S_VALUE FROM SYSTEM_SETUP WHERE SYSTEM_SE' +
        'TUP = 5) > 0) THEN'
      
        '11023999=      INSERT INTO LOGS (ID, SQLSTMT1, USR, IS_TRANSFERE' +
        'D, SYSDATE, ERR_CODE)'
      
        '110239100=      VALUES (GEN_ID(GEN_LOGS, 1), '#39'DELETE FROM KASSA_' +
        'STATE S WHERE S.G_TOCHKA = '#39'||:G_TOCHKA_||'#39';'#39', '#39'SYSDBA'#39', 0, CURR' +
        'ENT_TIMESTAMP, :ERR_CODE);'
      '110239101='
      '110239102=  DELETE FROM KASSA S'
      '110239103=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '110239104='
      '110239105=  FOR SELECT KASSA_BEZNAL'
      '110239106=        FROM KASSA_BEZNAL'
      '110239107=       WHERE G_TOCHKA = :G_TOCHKA_'
      '110239108=        INTO :KASSA_'
      '110239109=  DO BEGIN'
      
        '110239110=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '110239111=    IF (:ERR_CODE <> 0) THEN'
      '110239112=      EXIT;'
      '110239113=  END'
      '110239114='
      '110239115=  UPDATE G_OFFICIAL O'
      '110239116=     SET O.G_TOCHKA = NULL'
      '110239117=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '110239118='
      '110239119=  DELETE FROM INVOICE I'
      '110239120=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '110239121=                      FROM ZAKAZ'
      '110239122=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239123='
      '110239124=  DELETE FROM INVOICE_PAY I'
      '110239125=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '110239126=                      FROM ZAKAZ'
      '110239127=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239128='
      '110239129=  DELETE FROM WAYBILL I'
      '110239130=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '110239131=                      FROM ZAKAZ'
      '110239132=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239133='
      '110239134=  DELETE FROM LT_ZAKAZ_REAL R'
      '110239135=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '110239136=                              FROM ZAKAZ Z, ZAKAZ_DETA' +
        'ILS ZD'
      
        '110239137=                             WHERE Z.G_TOCHKA = :G_TOC' +
        'HKA_'
      
        '110239138=                               AND Z.ZAKAZ = ZD.ZAKAZ)' +
        ';'
      '110239139='
      '110239140=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '110239141=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PARE' +
        'NT'
      
        '110239142=                                  FROM ZAKAZ_REAL_PARE' +
        'NT'
      
        '110239143=                                 WHERE G_TOCHKA = :G_T' +
        'OCHKA_);'
      '110239144='
      '110239145=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '110239146=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239147='
      '110239148=  DELETE FROM ZAKAZ_DETAILS D'
      '110239149=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '110239150=                      FROM ZAKAZ'
      '110239151=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239152='
      '110239153=  DELETE FROM ZAKAZ D'
      '110239154=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239155='
      '110239156=  DELETE FROM SKLAD D'
      '110239157=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239158='
      '110239159=  DELETE FROM SKLAD_PARENT D'
      '110239160=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '110239161='
      '110239162=  DELETE FROM ZAKAZ_DETAILS D'
      '110239163=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '110239164=                      FROM ZAKAZ'
      '110239165=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '110239166='
      '110239167=  DELETE FROM LT_SKLAD_PRODUCT'
      '110239168=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '110239169='
      '110239170=  DELETE FROM G_TOCHKA'
      '110239171=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '110239172='
      
        '110239173=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051 +
        #1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110239174=  IF (UPLOAD_TO_EXT_APP_ = 1) THEN BEGIN'
      '110239175=    UPDATE SYNC_EXT_APP AP'
      '110239176=       SET AP.OPER = 3'
      '110239177=     WHERE AP.OBJECT_TYPE = 3'
      '110239178=       AND AP.ID = :G_TOCHKA_'
      '110239179=       AND AP.IS_LOADING = 0;'
      '110239180='
      '110239181=    IF (ROW_COUNT = 0) THEN'
      
        '110239182=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT' +
        '_TYPE, ID, OPER)'
      
        '110239183=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 3, :G_TOC' +
        'HKA_, 3);'
      '110239184=  END'
      '110239185=END'
      '110239186=;'
      '110239187='
      '110239188=ALTER PROCEDURE SYNC_DOWNLOAD('
      '110239189=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '110239190=RETURNS ('
      '110239191=  ERR_CODE INTEGER,'
      '110239192=  ERR_MSG VARCHAR(1024),'
      '110239193=  ERR_BODY BLOB SUB_TYPE 1 SEGMENT SIZE 16384)'
      '110239194=AS'
      '110239195=/*'
      '110239196='#1060#1048#1053#1040#1051' 07.02.2019'
      '110239197=*/'
      
        '110239198=DECLARE VARIABLE SQL_ TYPE OF COLUMN LOGS.SQLSTMT1; /*' +
        ' VARCHAR(30000); */'
      
        '110239199=DECLARE VARIABLE SQL_UPD_ TYPE OF COLUMN LOGS.SQLSTMT1' +
        '; /* VARCHAR(30000); */'
      '110239200=DECLARE VARIABLE DAT_ TYPE OF COLUMN LOGS.DAT;'
      '110239201=DECLARE VARIABLE IDX_ TYPE OF COLUMN LOGS.RR;'
      '110239202=DECLARE VARIABLE POS_ INTEGER = 0;'
      '110239203=DECLARE VARIABLE POS1_ INTEGER = 0;'
      '110239204=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110239205=DECLARE VARIABLE SQLCODE_ DM_BIGINT;'
      
        '110239206=DECLARE VARIABLE PRODUCT_ID_ARR_ BLOB SUB_TYPE 1 SEGME' +
        'NT SIZE 80 = '#39#39';'
      
        '110239207=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G' +
        '_PRODUCT;'
      
        '110239208=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      
        '110239209=DECLARE VARIABLE G_TOCHKA_OLD_ TYPE OF COLUMN G_TOCHKA' +
        '.G_TOCHKA;'
      
        '110239210=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PRODU' +
        'CT.AMOUNT;'
      
        '110239211=DECLARE VARIABLE AMOUNT_RESERVE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT_RESERVE;'
      
        '110239212=DECLARE VARIABLE ACTION_DATE_ TYPE OF COLUMN KASSA.ACT' +
        'ION_DATE;'
      
        '110239213=DECLARE VARIABLE ACTION_DATE_MIN_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE = CURRENT_DATE;'
      
        '110239214=DECLARE VARIABLE ACTION_DATE_MIN_OLD_ TYPE OF COLUMN K' +
        'ASSA.ACTION_DATE = CURRENT_DATE;'
      
        '110239215=DECLARE VARIABLE CREDIT_ TYPE OF COLUMN KASSA_STATE.CR' +
        'EDIT;'
      
        '110239216=DECLARE VARIABLE DEBET_ TYPE OF COLUMN KASSA_STATE.DEB' +
        'ET;'
      '110239217=DECLARE VARIABLE RECALC_STR_ VARCHAR(1024) = '#39#39';'
      '110239218=DECLARE VARIABLE STR_ VARCHAR(1024);'
      '110239219=DECLARE VARIABLE TABLE_ TYPE OF COLUMN LOGS.TTABLE;'
      '110239220=DECLARE VARIABLE TABLE_INT_ INTEGER;'
      '110239221=DECLARE VARIABLE OPER_ INTEGER;'
      '110239222=DECLARE VARIABLE PNT_ VARCHAR(10);'
      '110239223=BEGIN'
      '110239224=  ERR_CODE = 0;'
      '110239225=  ERR_MSG = '#39#39';'
      '110239226=  ERR_BODY = '#39#39';'
      '110239227='
      '110239228=  FOR SELECT L.ID,'
      '110239229=             L.SQLSTMT1,'
      '110239230=             L.TTABLE'
      '110239231=        FROM LOGS L'
      '110239232=       WHERE L.USR = '#39'REPLICAT'#39
      '110239233=         AND L.DAT IS NULL'
      '110239234=         AND L.IS_TRANSFERED = 0'
      
        '110239235=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        '1) = 0'
      '110239236=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT1) = 0'
      
        '110239237=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT1) =' +
        ' 0'
      
        '110239238=         AND POSITION('#39'EXECUTE PROCEDURE K_RECALC_KASS' +
        'A'#39' IN L.SQLSTMT1) = 0'
      '110239239=        ORDER BY L.ID_ORIGINAL'
      '110239240=        INTO :LOGS_ID_,'
      '110239241=             :SQL_,'
      '110239242=             :TABLE_'
      '110239243=  DO BEGIN'
      '110239244=    BEGIN'
      '110239245=        SQLCODE_ = 0;'
      '110239246='
      '110239247=        EXECUTE STATEMENT SQL_;'
      '110239248='
      
        '110239249=        /*IF (UPLOAD_TO_EXT_APP_ = 1 AND TABLE_ IN ('#39'G' +
        '_PRODUCT'#39', '#39'ZAKAZ'#39', '#39'SKLAD_PARENT'#39', '#39'G_TOCHKA'#39')) THEN BEGIN'
      '110239250=           IF (TABLE_ = '#39'ZAKAZ'#39') THEN'
      '110239251=             TABLE_INT_ = 1;'
      '110239252=           ELSE IF (TABLE_ = '#39'SKLAD_PARENT'#39') THEN'
      '110239253=             TABLE_INT_ = 2;'
      '110239254=           ELSE IF (TABLE_ = '#39'G_TOCHKA'#39') THEN'
      '110239255=             TABLE_INT_ = 3;'
      '110239256=           ELSE IF (TABLE_ = '#39'G_PRODUCT'#39') THEN'
      '110239257=             TABLE_INT_ = 4;'
      '110239258='
      '110239259=           IF (POSITION('#39'INSERT'#39' IN SQL_) > 0) THEN'
      '110239260=             OPER_ = 1;'
      
        '110239261=           ELSE IF (POSITION('#39'UPDATE'#39' IN SQL_) > 0) TH' +
        'EN'
      '110239262=             OPER_ = 2;'
      
        '110239263=           ELSE IF (POSITION('#39'DELETE'#39' IN SQL_) > 0) TH' +
        'EN'
      '110239264=             OPER_ = 3;'
      '110239265='
      
        '110239266=           INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJ' +
        'ECT_TYPE, ID, OPER)'
      
        '110239267=             VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), :TAB' +
        'LE_INT_, 111, :OPER_);'
      '110239268=        END*/'
      '110239269='
      '110239270=    WHEN ANY DO'
      '110239271=        BEGIN'
      '110239272=            SQLCODE_ = GDSCODE;'
      '110239273=            IF (ERR_BODY = '#39#39') THEN'
      
        '110239274=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1080#1079#1084#1077#1085#1077#1085#1080 +
        #1081'.'#39';'
      '110239275=            ERR_BODY = ERR_BODY ||'#39
      '110239276='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110239277=        END'
      '110239278=    END'
      '110239279='
      
        '110239280=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110239281=    UPDATE LOGS L'
      
        '110239282=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110239283=           L.ERR_CODE = :SQLCODE_'
      '110239284=     WHERE L.ID = :LOGS_ID_;'
      '110239285=  END'
      '110239286='
      '110239287=  POS_ = 0;'
      '110239288=  FOR SELECT L.ID,'
      '110239289=             L.SQLSTMT1,'
      '110239290=             L.DAT,'
      '110239291=             L.RR'
      '110239292=        FROM LOGS L'
      '110239293=       WHERE L.USR = '#39'REPLICAT'#39
      '110239294=         AND L.DAT IS NOT NULL'
      '110239295=         AND L.IS_TRANSFERED = 0'
      '110239296=        ORDER BY L.ID_ORIGINAL'
      '110239297=        INTO :LOGS_ID_,'
      '110239298=             :SQL_,'
      '110239299=             :DAT_,'
      '110239300=             :IDX_'
      '110239301=  DO BEGIN'
      '110239302=    POS_ = POSITION('#39'.'#39', SQL_);'
      '110239303=    POS1_ = POSITION('#39'.'#39', SQL_, POS_ + 1 );'
      
        '110239304=    SQL_UPD_ = '#39'UPDATE '#39'||SUBSTRING(SQL_ FROM 1 FOR PO' +
        'S_ - 1)||'#39' SET '#39'||SUBSTRING(SQL_ FROM POS_ + 1 FOR POS1_ - POS_ ' +
        '- 1)||'#39' = :DAT_'#39'||'
      
        '110239305=               '#39' WHERE '#39'||SUBSTRING(SQL_ FROM POS1_ + ' +
        '1 FOR CHAR_LENGTH(SQL_))||'#39' = '#39'||IDX_;'
      '110239306='
      '110239307=    BEGIN'
      '110239308=        SQLCODE_ = 0;'
      '110239309=        EXECUTE STATEMENT (:SQL_UPD_) (DAT_ := DAT_);'
      '110239310=    WHEN ANY DO'
      '110239311=        BEGIN'
      '110239312=            SQLCODE_ = GDSCODE;'
      '110239313=            ERR_BODY = ERR_BODY ||'#39
      '110239314='#39'||LOGS_ID_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110239315=        END'
      '110239316=    END'
      '110239317='
      
        '110239318=    --DELETE FROM LOGS WHERE ID = :LOGS_ID_;  '#1055#1054#1050#1040' '#1053#1045' ' +
        #1041#1059#1044#1059' '#1059#1044#1040#1051#1071#1058#1068', '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040#1050', '#1055#1059#1057#1058#1068' '#1053#1040' '#1055#1045#1056#1042#1054#1045' '#1042#1056#1045#1052#1071' '#1044#1051#1071' '#1051#1054 +
        #1043#1054#1042' '#1054#1057#1058#1040#1045#1058#1057#1071
      '110239319='
      '110239320=    UPDATE LOGS L'
      
        '110239321=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110239322=           L.ERR_CODE = :SQLCODE_'
      '110239323=     WHERE L.ID = :LOGS_ID_;'
      '110239324=  END'
      '110239325='
      
        '110239326=  --==================================================' +
        '==================='
      '110239327=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1058#1054#1042#1040#1056#1054#1042
      
        '110239328=  -- '#1056#1045#1064#1048#1051' '#1053#1045' '#1057#1054#1041#1048#1056#1040#1058#1068' '#1040#1049#1044#1048#1064#1050#1048' '#1058#1054#1042#1040#1056#1054#1042', '#1040' '#1055#1056#1054#1057#1058#1054' '#1054#1058#1044#1045#1051 +
        #1068#1053#1067#1049' '#1062#1048#1050#1051' '#1055#1054' '#1053#1048#1052' '#1047#1040#1055#1059#1057#1058#1048#1058#1068', '#1047#1040#1063#1045#1052' '#1041#1067#1051#1054' '#1042#1054#1054#1041#1065#1045' '#1042' '#1052#1040#1057#1057#1048#1042' '#1057#1054#1041#1048#1056#1040#1058#1068'?'
      
        '110239329=  --==================================================' +
        '==================='
      '110239330=  FOR SELECT MAX(L.ID) ID,'
      '110239331=             L.SQLSTMT1'
      '110239332=        FROM LOGS L'
      '110239333=       WHERE L.USR = '#39'REPLICAT'#39
      '110239334=         AND L.DAT IS NULL'
      '110239335=         AND L.IS_TRANSFERED = 0'
      
        '110239336=         AND POSITION('#39'LT_SKLAD_PRODUCT:'#39' IN L.SQLSTMT' +
        '1) > 0'
      '110239337=       GROUP BY L.SQLSTMT1'
      '110239338=        INTO :LOGS_ID_,'
      '110239339=             :SQL_'
      '110239340=  DO BEGIN'
      '110239341=    SQLCODE_ = 0;'
      '110239342=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110239343=    POS1_ = POSITION('#39'-'#39' IN SQL_);'
      '110239344='
      
        '110239345=    G_PRODUCT_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR' +
        ' POS1_ - POS_ - 1) AS BIGINT);'
      
        '110239346=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 FOR' +
        ' CHAR_LENGTH(SQL_)) AS BIGINT);'
      '110239347='
      '110239348=    BEGIN'
      '110239349=        select ('
      '110239350=               -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '110239351=               (select COALESCE(sum(s.amount), 0) from' +
        ' sklad s, sklad_parent sp'
      '110239352=                where sp.SKLAD = s.SKLAD_PARENT'
      '110239353=                  and sp.G_TOCHKA = :G_TOCHKA_'
      '110239354=                  and s.g_product = :G_PRODUCT_'
      
        '110239355=                  and sp.IS_EXPECTED = 0)   -- '#1085#1077' '#1073#1077#1088#1091 +
        ' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '110239356='
      '110239357=               -'
      '110239358=               -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110239359=               (select COALESCE(sum(zr.AMOUNT_ALL), 0)' +
        ' from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110239360=                where zr.g_product = :G_PRODUCT_ and Z' +
        'rp.G_TOCHKA = :G_TOCHKA_'
      
        '110239361=                and zr.ZAKAZ_REAL_PARENT = zrp.ZAKAZ_R' +
        'EAL_PARENT)'
      '110239362='
      '110239363=               -'
      '110239364=               -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '110239365=               (select COALESCE(sum(zd.amount), 0) fro' +
        'm zakaz_details zd, zakaz z'
      
        '110239366=                where zd.g_product = :G_PRODUCT_ and Z' +
        '.G_TOCHKA = :G_TOCHKA_'
      '110239367=                and zd.zakaz = z.zakaz'
      
        '110239368=                and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099#1095#1080#1090#1072 +
        #1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076#1077#1090' '#1085 +
        #1080#1078#1077
      
        '110239369=                and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080#1090#1099#1074#1072 +
        #1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086#1087#1083#1072#1095 +
        #1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110239370=                and not (z.IS_SPISANIE = 0 and z.NOT_M' +
        'INUS_OSTATOK = 1)'
      '110239371=               )'
      '110239372='
      '110239373=               -'
      '110239374=               -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '110239375=               (select COALESCE(sum(s.amount), 0) from' +
        ' sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = 3'
      '110239376=                and S.g_client = :G_TOCHKA_)'
      '110239377='
      '110239378=               -'
      '110239379=               -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '110239380=               (select COALESCE(sum(od.amount), 0) fro' +
        'm other_details od, other o'
      
        '110239381=                where od.g_product = :G_PRODUCT_ and o' +
        '.G_TOCHKA = :G_TOCHKA_'
      '110239382=                and od.other = o.other)'
      '110239383=               ) amount,'
      '110239384='
      
        '110239385=               (SELECT COALESCE(sum(ZD.amount), 0) FRO' +
        'M ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '110239386=                 WHERE Z.G_TOCHKA = :G_TOCHKA_ AND Z.I' +
        'S_RESERVE = 1'
      
        '110239387=                   AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G_PRO' +
        'DUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '110239388=        from rdb$database'
      '110239389=        INTO :AMOUNT_,'
      '110239390=             :AMOUNT_RESERVE_;'
      '110239391='
      '110239392=        MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '110239393=        USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G_TOC' +
        'HKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '110239394=        ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_TOCHK' +
        'A = CD.G_TOCHKA)'
      '110239395=        WHEN MATCHED THEN'
      
        '110239396=            UPDATE SET LT.AMOUNT = :AMOUNT_, LT.AMOUNT' +
        '_RESERVE = :AMOUNT_RESERVE_'
      '110239397=        WHEN NOT MATCHED THEN'
      
        '110239398=            INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, AMOUN' +
        'T, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110239399=            VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,  1), ' +
        ':G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '110239400=    WHEN ANY DO'
      '110239401=        BEGIN'
      '110239402=            SQLCODE_ = GDSCODE;'
      '110239403=            IF (ERR_BODY = '#39#39') THEN'
      
        '110239404=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086#1074 +
        '.'#39';'
      '110239405=            ERR_BODY = ERR_BODY ||'#39
      '110239406=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110239407=        END'
      '110239408=    END'
      '110239409='
      '110239410=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110239411=    UPDATE LOGS L'
      
        '110239412=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110239413=           L.ERR_CODE = :SQLCODE_'
      '110239414=     WHERE L.SQLSTMT1 = :SQL_'
      '110239415=       AND L.USR = '#39'REPLICAT'#39
      '110239416=       AND L.DAT IS NULL'
      '110239417=       AND L.IS_TRANSFERED = 0;'
      '110239418=  END'
      '110239419='
      
        '110239420=  --==================================================' +
        '==================='
      '110239421=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1050#1040#1057#1057#1067
      
        '110239422=  -- '#1058#1059#1058' '#1053#1045#1052#1053#1054#1043#1054' '#1053#1040#1042#1054#1056#1054#1063#1045#1053#1053#1054' '#1055#1054#1051#1059#1063#1048#1051#1054#1057#1068', '#1052#1040#1057#1057#1048#1042#1054#1042' '#1058#1059#1058' ' +
        #1053#1045#1058', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1057#1053#1054#1042#1040' '#1042#1057#1045' '#1063#1045#1056#1045#1047' G_TOCHKA_OLD '#1044#1045#1051#1040#1058#1068
      
        '110239423=  --==================================================' +
        '==================='
      '110239424=  G_TOCHKA_OLD_ = 0;'
      '110239425=  FOR SELECT L.ID,'
      '110239426=             L.SQLSTMT1'
      '110239427=        FROM LOGS L'
      '110239428=       WHERE L.USR = '#39'REPLICAT'#39
      '110239429=         AND L.DAT IS NULL'
      '110239430=         AND L.IS_TRANSFERED = 0'
      '110239431=         AND POSITION('#39'KASSA:'#39' IN L.SQLSTMT1) > 0'
      '110239432=     ORDER BY L.SQLSTMT1'
      '110239433=        INTO :LOGS_ID_,'
      '110239434=             :SQL_'
      '110239435=  DO BEGIN'
      '110239436=    SQLCODE_ = 0;'
      '110239437=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110239438=    POS1_ = POSITION('#39'~'#39' IN SQL_);'
      '110239439='
      
        '110239440=    G_TOCHKA_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1 FOR ' +
        'POS1_ - POS_ - 1) AS BIGINT);'
      
        '110239441=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS1_ + 1 ' +
        'FOR CHAR_LENGTH(SQL_)) AS DATE);'
      
        '110239442=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACTI' +
        'ON_DATE_);'
      '110239443='
      '110239444=    SELECT SUM(K.SUMM)'
      '110239445=      FROM KASSA K'
      '110239446=     WHERE K."ACTION" = 0'
      '110239447=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110239448=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110239449=      INTO :CREDIT_;'
      '110239450=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '110239451='
      '110239452=    SELECT SUM(K.SUMM)'
      '110239453=      FROM KASSA K'
      '110239454=     WHERE K."ACTION" = 1'
      '110239455=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110239456=       AND K.G_TOCHKA = :G_TOCHKA_'
      '110239457=      INTO :DEBET_;'
      '110239458=    DEBET_ = COALESCE(DEBET_, 0);'
      '110239459='
      '110239460=    PNT_ = '#39'03'#39';'
      '110239461=    BEGIN'
      '110239462=        MERGE INTO KASSA_STATE c'
      
        '110239463=        USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCH' +
        'KA_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE ' +
        'AND C.G_TOCHKA = CD.G_TOCHKA)'
      '110239464=        WHEN MATCHED THEN'
      '110239465=            UPDATE SET'
      '110239466=                C.DEBET  = :DEBET_,'
      '110239467=                C.CREDIT = :CREDIT_,'
      
        '110239468=                C."OUTPUT" = C."INPUT" - :DEBET_ + :CR' +
        'EDIT_'
      '110239469=        WHEN NOT MATCHED THEN'
      
        '110239470=            INSERT (KASSA_STATE, K_DATE, "INPUT", DEBE' +
        'T, CREDIT, "OUTPUT", G_TOCHKA)'
      '110239471=            VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110239472=                    :ACTION_DATE_,'
      
        '110239473=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110239474=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110239475=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0),'
      '110239476=                    :DEBET_,'
      '110239477=                    :CREDIT_,'
      
        '110239478=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110239479=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110239480=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0) - :DEBET_ + :CREDIT_,'
      '110239481=                   :G_TOCHKA_);'
      '110239482='
      '110239483=        PNT_ = '#39'04'#39';'
      
        '110239484=        IF (G_TOCHKA_OLD_ > 0 AND G_TOCHKA_OLD_ <> G_T' +
        'OCHKA_ AND ACTION_DATE_MIN_OLD_ < CURRENT_DATE) THEN BEGIN'
      
        '110239485=           EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DA' +
        'TE_MIN_OLD_, :G_TOCHKA_OLD_, 0)'
      '110239486=             RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110239487=        END'
      '110239488='
      '110239489=        G_TOCHKA_OLD_ = G_TOCHKA_;'
      '110239490=        ACTION_DATE_MIN_OLD_ = ACTION_DATE_MIN_;'
      '110239491=    WHEN ANY DO'
      '110239492=        BEGIN'
      '110239493=            SQLCODE_ = GDSCODE;'
      '110239494=            IF (ERR_BODY = '#39#39') THEN'
      
        '110239495=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1085#1072#1083#1080#1095#1085#1086 +
        #1081' '#1082#1072#1089#1089#1099'.'#39';'
      '110239496=            ERR_BODY = ERR_BODY ||'#39
      
        '110239497=PNT_ '#39'||PNT_||'#39'. ID_ '#39'||LOGS_ID_||'#39'. SQL_ '#39'||SQL_||'#39'. ' +
        #1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||GDSCODE;'
      '110239498=        END'
      '110239499=    END'
      '110239500='
      '110239501=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110239502=    UPDATE LOGS L'
      
        '110239503=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110239504=           L.ERR_CODE = :SQLCODE_'
      '110239505=     WHERE L.ID = :LOGS_ID_'
      '110239506=       AND L.USR = '#39'REPLICAT'#39
      '110239507=       AND L.DAT IS NULL'
      '110239508=       AND L.IS_TRANSFERED = 0;'
      '110239509='
      '110239510=  END'
      '110239511='
      '110239512=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045#1058
      '110239513=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '110239514=      EXECUTE PROCEDURE K_RECALC_KASSA(:ACTION_DATE_MI' +
        'N_, :G_TOCHKA_, 0)'
      '110239515=        RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110239516=  END'
      '110239517='
      
        '110239518=  --==================================================' +
        '==================='
      '110239519=  -- '#1044#1045#1051#1040#1070' '#1055#1045#1056#1045#1057#1063#1045#1058' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049' '#1050#1040#1057#1057#1067' '#1047#1040' '#1057#1045#1043#1054#1044#1053#1071
      
        '110239520=  --==================================================' +
        '==================='
      '110239521=  ACTION_DATE_MIN_ = CURRENT_DATE;'
      '110239522=  FOR SELECT L.ID,'
      '110239523=             L.SQLSTMT1'
      '110239524=        FROM LOGS L'
      '110239525=       WHERE L.USR = '#39'REPLICAT'#39
      '110239526=         AND L.DAT IS NULL'
      '110239527=         AND L.IS_TRANSFERED = 0'
      
        '110239528=         AND POSITION('#39'KASSA_BEZNAL:'#39' IN L.SQLSTMT1) >' +
        ' 0'
      '110239529=        INTO :LOGS_ID_,'
      '110239530=             :SQL_'
      '110239531=  DO BEGIN'
      '110239532=    SQLCODE_ = 0;'
      '110239533=    POS_ = POSITION('#39':'#39' IN SQL_);'
      '110239534='
      
        '110239535=    ACTION_DATE_ = CAST(SUBSTRING(SQL_ FROM POS_ + 1) ' +
        'AS DATE);'
      
        '110239536=    ACTION_DATE_MIN_ = MINVALUE(ACTION_DATE_MIN_, ACTI' +
        'ON_DATE_);'
      '110239537='
      '110239538=    SELECT SUM(K.SUMM)'
      '110239539=      FROM KASSA_BEZNAL K'
      '110239540=     WHERE K."ACTION" = 0'
      '110239541=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110239542=      INTO :CREDIT_;'
      '110239543=    CREDIT_ = COALESCE(CREDIT_, 0);'
      '110239544='
      '110239545=    SELECT SUM(K.SUMM)'
      '110239546=      FROM KASSA_BEZNAL K'
      '110239547=     WHERE K."ACTION" = 1'
      '110239548=       AND K.ACTION_DATE = :ACTION_DATE_'
      '110239549=      INTO :DEBET_;'
      '110239550=    DEBET_ = COALESCE(DEBET_, 0);'
      '110239551='
      '110239552=    PNT_ = '#39'03'#39';'
      '110239553=    BEGIN'
      '110239554=        MERGE INTO KASSA_BEZNAL_STATE c'
      
        '110239555=        USING (SELECT :ACTION_DATE_ AS K_DATE, :G_TOCH' +
        'KA_ AS G_TOCHKA  FROM RDB$DATABASE) cd ON (c.K_DATE = cd.K_DATE)'
      '110239556=        WHEN MATCHED THEN'
      '110239557=            UPDATE SET'
      '110239558=                C.DEBET  = :DEBET_,'
      '110239559=                C.CREDIT = :CREDIT_,'
      
        '110239560=                C."OUTPUT" = C."INPUT" - :DEBET_ + :CR' +
        'EDIT_'
      '110239561=        WHEN NOT MATCHED THEN'
      
        '110239562=            INSERT (KASSA_BEZNAL_STATE, K_DATE, "INPUT' +
        '", DEBET, CREDIT, "OUTPUT")'
      '110239563=            VALUES (GEN_ID(GEN_KASSA_STATE, 1),'
      '110239564=                    :ACTION_DATE_,'
      
        '110239565=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110239566=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110239567=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0),'
      '110239568=                    :DEBET_,'
      '110239569=                    :CREDIT_,'
      
        '110239570=                    COALESCE((SELECT "OUTPUT" FROM KAS' +
        'SA_STATE'
      
        '110239571=                              WHERE K_DATE = (SELECT M' +
        'AX(K_DATE)  FROM KASSA_STATE  WHERE K_DATE < CD.K_DATE AND G_TOC' +
        'HKA = CD.G_TOCHKA)'
      
        '110239572=                                AND G_TOCHKA = CD.G_TO' +
        'CHKA), 0) - :DEBET_ + :CREDIT_);'
      '110239573=    WHEN ANY DO'
      '110239574=        BEGIN'
      '110239575=            SQLCODE_ = GDSCODE;'
      '110239576=            IF (ERR_BODY = '#39#39') THEN'
      
        '110239577=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1087#1077#1088#1077#1089#1095#1077#1090#1077' '#1073#1077#1079#1085#1072#1083#1080 +
        #1095#1085#1086#1081' '#1082#1072#1089#1089#1099'.'#39';'
      '110239578=            ERR_BODY = ERR_BODY ||'#39
      
        '110239579=PNT_ '#39'||PNT_||'#39'. ID_ '#39'||LOGS_ID_||'#39'. SQL_ '#39'||SQL_||'#39'. ' +
        #1050#1086#1076' '#1086#1096#1080#1073#1082#1080' '#39'||GDSCODE;'
      '110239580=        END'
      '110239581=    END'
      '110239582='
      '110239583=    -- '#1057#1058#1040#1042#1051#1070' '#1055#1056#1048#1047#1053#1040#1050' "'#1054#1041#1056#1040#1041#1054#1058#1040#1053'"'
      '110239584=    UPDATE LOGS L'
      
        '110239585=       SET L.IS_TRANSFERED = DECODE(:SQLCODE_, 0, 1, -' +
        '1),'
      '110239586=           L.ERR_CODE = :SQLCODE_'
      '110239587=     WHERE L.ID = :LOGS_ID_'
      '110239588=       AND L.USR = '#39'REPLICAT'#39
      '110239589=       AND L.DAT IS NULL'
      '110239590=       AND L.IS_TRANSFERED = 0;'
      '110239591='
      '110239592=  END'
      '110239593='
      '110239594=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1058#1045#1050#1059#1065#1045#1049', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1045#1056#1045#1057#1063#1045#1058
      '110239595=  IF (ACTION_DATE_MIN_ < CURRENT_DATE) THEN BEGIN'
      
        '110239596=    EXECUTE PROCEDURE K_RECALC_KASSA_BEZNAL(:ACTION_DA' +
        'TE_MIN_)'
      '110239597=      RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110239598=  END'
      '110239599='
      '110239600=  /*'
      '110239601=  POS_ = 1;'
      '110239602=  IF (PRODUCT_ID_ARR_ <> '#39#39') THEN BEGIN'
      '110239603=    BEGIN'
      
        '110239604=        PRODUCT_ID_ARR_ = SUBSTRING(PRODUCT_ID_ARR_ FR' +
        'OM 2 FOR CHAR_LENGTH(PRODUCT_ID_ARR_) - 1);'
      '110239605='
      '110239606=        WHILE (POS_ > 0) DO BEGIN'
      '110239607=            POS_ = POSITION('#39'~'#39' IN PRODUCT_ID_ARR_);'
      '110239608='
      '110239609=            IF (POS_ > 0) THEN'
      
        '110239610=              STR_ = SUBSTRING(PRODUCT_ID_ARR_ FROM 1 ' +
        'FOR POS_ - 1);'
      '110239611=            ELSE'
      '110239612=              STR_ = PRODUCT_ID_ARR_;'
      '110239613='
      
        '110239614=            G_PRODUCT_ = CAST(SUBSTRING(STR_ FROM 1 FO' +
        'R POSITION('#39'-'#39' IN STR_) - 1) AS BIGINT);'
      
        '110239615=            G_TOCHKA_ = CAST(SUBSTRING(STR_ FROM POSIT' +
        'ION('#39'-'#39' IN STR_) + 1 FOR CHAR_LENGTH(STR_) - POSITION('#39'-'#39' IN STR' +
        '_)) AS BIGINT);'
      '110239616='
      
        '110239617=            PRODUCT_ID_ARR_   = SUBSTRING(PRODUCT_ID_A' +
        'RR_ FROM (POSITION('#39'~'#39' IN PRODUCT_ID_ARR_)) + 1);'
      '110239618='
      '110239619=            select ('
      '110239620=                   -- '#1057#1063#1048#1058#1040#1070' '#1042#1045#1057#1068' '#1055#1056#1048#1061#1054#1044
      
        '110239621=                   (select COALESCE(sum(s.amount), 0) ' +
        'from sklad s, sklad_parent sp'
      '110239622=                    where sp.SKLAD = s.SKLAD_PARENT'
      '110239623=                      and sp.G_TOCHKA = :G_TOCHKA_'
      '110239624=                      and s.g_product = :G_PRODUCT_'
      
        '110239625=                      and sp.IS_EXPECTED = 0)   -- '#1085#1077' ' +
        #1073#1077#1088#1091' '#1087#1088#1080#1093#1086#1076', '#1082#1086#1090#1086#1088#1099#1081' '#1077#1097#1077' '#1086#1078#1080#1076#1072#1077#1090#1089#1103
      '110239626='
      '110239627=                   -'
      '110239628=                   -- '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '110239629=                   (select COALESCE(sum(zr.AMOUNT_ALL)' +
        ', 0) from zakaz_na_real zr, zakaz_real_parent zrp'
      
        '110239630=                    where zr.g_product = :G_PRODUCT_ a' +
        'nd Zrp.G_TOCHKA = :G_TOCHKA_'
      
        '110239631=                    and zr.ZAKAZ_REAL_PARENT = zrp.ZAK' +
        'AZ_REAL_PARENT)'
      '110239632='
      '110239633=                   -'
      '110239634=                   -- '#1055#1056#1054#1044#1040#1046#1048', '#1057#1055#1048#1057#1040#1053#1048#1071
      
        '110239635=                   (select COALESCE(sum(zd.amount), 0)' +
        ' from zakaz_details zd, zakaz z'
      
        '110239636=                    where zd.g_product = :G_PRODUCT_ a' +
        'nd Z.G_TOCHKA = :G_TOCHKA_'
      '110239637=                    and zd.zakaz = z.zakaz'
      
        '110239638=                    and z.IS_RESERVE = 0      -- '#1085#1077' '#1074#1099 +
        #1095#1080#1090#1072#1102' '#1089#1086' '#1089#1082#1083#1072#1076#1072' '#1079#1072#1088#1077#1088#1077#1079#1074#1080#1088#1086#1074#1072#1085#1085#1099#1081' '#1090#1086#1074#1072#1088', '#1086#1085' '#1087#1088#1086#1089#1090#1086' '#1086#1090#1076#1077#1083#1100#1085#1086' '#1087#1086#1081#1076 +
        #1077#1090' '#1085#1080#1078#1077
      
        '110239639=                    and z.IS_SPISANIE <> 2   -- '#1085#1077' '#1091#1095#1080 +
        #1090#1099#1074#1072#1102' '#1086#1087#1083#1072#1090#1091' '#1079#1072' '#1088#1077#1072#1083#1080#1079#1072#1094#1080#1102', '#1090'.'#1082'. '#1082#1086#1075#1076#1072' '#1090#1086#1074#1072#1088' '#1091#1096#1077#1083', '#1072' '#1082#1086#1075#1076#1072' '#1073#1099#1083' '#1086 +
        #1087#1083#1072#1095#1077#1085' - '#1085#1077#1087#1086#1085#1103#1090#1085#1086
      
        '110239640=                    and not (z.IS_SPISANIE = 0 and z.N' +
        'OT_MINUS_OSTATOK = 1)'
      '110239641=                   )'
      '110239642='
      '110239643=                   -'
      '110239644=                   -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      
        '110239645=                   (select COALESCE(sum(s.amount), 0) ' +
        'from sklad s where s.g_product = :G_PRODUCT_ and s.is_vozvrat = ' +
        '3'
      '110239646=                    and S.g_client = :G_TOCHKA_)'
      '110239647='
      '110239648=                   -'
      '110239649=                   -- '#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054
      
        '110239650=                   (select COALESCE(sum(od.amount), 0)' +
        ' from other_details od, other o'
      
        '110239651=                    where od.g_product = :G_PRODUCT_ a' +
        'nd o.G_TOCHKA = :G_TOCHKA_'
      '110239652=                    and od.other = o.other)'
      '110239653=                   ) amount,'
      '110239654='
      
        '110239655=                   (SELECT COALESCE(sum(ZD.amount), 0)' +
        ' FROM ZAKAZ Z, ZAKAZ_DETAILS ZD'
      
        '110239656=                     WHERE Z.G_TOCHKA = :G_TOCHKA_ AND' +
        ' Z.IS_RESERVE = 1'
      
        '110239657=                       AND Z.ZAKAZ = ZD.ZAKAZ AND ZD.G' +
        '_PRODUCT = :G_PRODUCT_) AMOUNT_RESERVE'
      '110239658=            from rdb$database'
      '110239659=            INTO :AMOUNT_,'
      '110239660=                 :AMOUNT_RESERVE_;'
      '110239661='
      '110239662=            MERGE INTO LT_SKLAD_PRODUCT LT'
      
        '110239663=            USING (SELECT :G_PRODUCT_ AS G_PRODUCT, :G' +
        '_TOCHKA_ AS G_TOCHKA FROM RDB$DATABASE) CD'
      
        '110239664=            ON (LT.G_PRODUCT = CD.G_PRODUCT AND LT.G_T' +
        'OCHKA = CD.G_TOCHKA)'
      '110239665=            WHEN MATCHED THEN'
      
        '110239666=                UPDATE SET LT.AMOUNT = :AMOUNT_, LT.AM' +
        'OUNT_RESERVE = :AMOUNT_RESERVE_'
      '110239667=            WHEN NOT MATCHED THEN'
      
        '110239668=                INSERT (LT_SKLAD_PRODUCT, G_PRODUCT, A' +
        'MOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110239669=                VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT,  ' +
        '1), :G_PRODUCT_, :AMOUNT_, :AMOUNT_RESERVE_, :G_TOCHKA_, 0);'
      '110239670=        END'
      '110239671=    WHEN ANY DO'
      '110239672=        BEGIN'
      '110239673=            SQLCODE_ = GDSCODE;'
      '110239674=            IF (ERR_BODY = '#39#39') THEN'
      
        '110239675=              ERR_BODY = '#39#1054#1096#1080#1073#1082#1080' '#1087#1088#1080' '#1079#1072#1075#1088#1091#1079#1082#1077' '#1086#1089#1090#1072#1090#1082#1086#1074 +
        '.'#39';'
      '110239676=            ERR_BODY = ERR_BODY ||'#39
      '110239677=PRODUCT_ID_ARR_ '#39'||PRODUCT_ID_ARR_||'#39'. '#1050#1086#1076' '#39'||GDSCODE;'
      '110239678=        END'
      '110239679=    END'
      '110239680=  END'
      '110239681='
      '110239682=  */'
      '110239683=END'
      '110239684=;'
      '110239685='
      '110239686=ALTER PROCEDURE SYNC_UPLOAD('
      '110239687=  SYNC_COMPS_ TYPE OF COLUMN SYNC_COMPS.SYNC_COMPS)'
      '110239688=RETURNS ('
      '110239689=  ID TYPE OF COLUMN LOGS.ID,'
      '110239690=  SQLSTMT TYPE OF COLUMN LOGS.SQLSTMT1,'
      '110239691=  TTABLE TYPE OF COLUMN LOGS.TTABLE,'
      '110239692=  USR TYPE OF COLUMN LOGS.USR,'
      '110239693=  RR TYPE OF COLUMN LOGS.RR,'
      '110239694=  DAT TYPE OF COLUMN LOGS.DAT)'
      '110239695=AS'
      '110239696=/*'
      '110239697=*/'
      '110239698=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'SYNC_UPLOAD'#39';'
      '110239699=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110239700=DECLARE VARIABLE LOGS_ID_ TYPE OF COLUMN LOGS.ID;'
      '110239701=BEGIN'
      '110239702=  FOR SELECT ID, SQLSTMT1, TTABLE, USR, RR, DAT'
      '110239703=      FROM LOGS'
      '110239704=      WHERE IS_TRANSFERED = 0'
      '110239705=        AND USR <> '#39'REPLICAT'#39
      '110239706=      ORDER BY ID'
      '110239707=      INTO :ID, :SQLSTMT, :TTABLE, :USR, :RR, :DAT'
      '110239708=  DO BEGIN'
      '110239709=    UPDATE LOGS L'
      '110239710=       SET L.IS_TRANSFERED = 1'
      '110239711=     WHERE L.ID = :ID;'
      '110239712='
      '110239713=    SUSPEND;'
      '110239714=  END'
      '110239715=end'
      '110239716=;'
      '110239717='
      '110239718='
      '110239719='
      '110239720=UPDATE LOGS L SET L.SQLSTMT1 = L.SQLSTMT;'
      '110239721='
      '110239722=ALTER TABLE LOGS DROP SQLSTMT;'
      '110239723='
      '110239724='
      
        '110239725=/*****************************************************' +
        '*************************/'
      
        '110239726=/****                      Updating column positions  ' +
        '                     ****/'
      
        '110239727=/*****************************************************' +
        '*************************/'
      '110239728=ALTER TABLE LOGS ALTER COLUMN ID POSITION 1;'
      '110239729='
      '110239730=ALTER TABLE LOGS ALTER COLUMN ID_ORIGINAL POSITION 2;'
      '110239731='
      '110239732=ALTER TABLE LOGS ALTER COLUMN TTABLE POSITION 3;'
      '110239733='
      '110239734=ALTER TABLE LOGS ALTER COLUMN USR POSITION 4;'
      '110239735='
      '110239736=ALTER TABLE LOGS ALTER COLUMN RR POSITION 5;'
      '110239737='
      '110239738=ALTER TABLE LOGS ALTER COLUMN DAT POSITION 6;'
      '110239739='
      
        '110239740=ALTER TABLE LOGS ALTER COLUMN IS_TRANSFERED POSITION 7' +
        ';'
      '110239741='
      '110239742=ALTER TABLE LOGS ALTER COLUMN SYSDATE POSITION 8;'
      '110239743='
      '110239744=ALTER TABLE LOGS ALTER COLUMN ERR_CODE POSITION 9;'
      '110239745='
      '110239746=ALTER TABLE LOGS ALTER COLUMN SQLSTMT1 POSITION 10;'
      '110239747=COMMIT WORK;'
      '110239748='
