      '1106017933=ALTER PROCEDURE G_UPD_G_BANK('
      '1106017934=  G_BANK_ TYPE OF COLUMN G_BANK.G_BANK,'
      '1106017935=  BIK_ TYPE OF COLUMN G_BANK.BIK,'
      '1106017936=  NAME_ TYPE OF COLUMN G_BANK.NAME,'
