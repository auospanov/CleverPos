      '1102016436=                END'
      '1102016437=            END'
      '1102016438=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102016439=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102016440=              EXIT;'
      '1102016441=            END'
      '1102016442='
      
        '1102016443=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1102016444=      END'
      '1102016445='
      
        '1102016446=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1102016447=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1102016448=            FROM KASSA K'
      '1102016449=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102016450=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1102016451=           UNION'
      '1102016452=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1102016453=            FROM KASSA K'
      '1102016454=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102016455=             AND K.SUMM = 0'
      '1102016456=          UNION'
      '1102016457=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102016458=            FROM KASSA_BEZNAL K'
      '1102016459=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1102016460=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1102016461=          UNION'
      '1102016462=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1102016463=            FROM KASSA_BEZNAL K'
      '1102016464=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102016465=             AND K.SUMM = 0'
      '1102016466=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1102016467=      DO BEGIN'
      '1102016468=        PNT_ = '#39'011A'#39';'
      
        '1102016469=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, ' +
        ':ERR_MSG);'
      '1102016470=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102016471=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102016472=          EXIT;'
      '1102016473=        END'
      '1102016474=      END'
      '1102016475=  END'
      '1102016476='
      
        '1102016477=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1102016478=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1102016479=    SELECT K.KASSA'
      '1102016480=      FROM KASSA K'
      '1102016481=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102016482=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102016483=      INTO :KASSA_POP_;'
      '1102016484=  ELSE'
      '1102016485=    SELECT K.KASSA_BEZNAL'
      '1102016486=      FROM KASSA_BEZNAL K'
      '1102016487=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1102016488=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1102016489=       INTO :KASSA_POP_;'
      '1102016490='
      
        '1102016491=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1102016492=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1102016493=      PNT_ = '#39'012'#39';'
      '1102016494=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1102016495=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1102016496=                                          1,     -- A' +
        'CTION_'
      '1102016497=                                          :G_PRIHOD_,'
      
        '1102016498=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102016499=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102016500=                                          NULL,   --N' +
        'OTE_'
      '1102016501=                                          NULL,'
      
        '1102016502=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102016503=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1102016504=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102016505=                                          ) RETURNING' +
        '_VALUES :ERR_CODE, :ERR_MSG;'
      '1102016506=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1102016507=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102016508=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1102016509=                                          :G_PRIHOD_,'
      
        '1102016510=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102016511=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102016512=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1102016513=                                          NULL,'
      
        '1102016514=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102016515=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102016516=                                          :G_TOCHKA_,'
      
        '1102016517=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102016518=                                          ) RETURNING' +
        '_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102016519=      END'
      '1102016520=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102016521=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1102016522=        EXIT;'
      '1102016523=      END'
      '1102016524='
      
        '1102016525=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1102016526=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1102016527=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1102016528=        PNT_ = '#39'013'#39';'
      
        '1102016529=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_' +
        'CODE, :ERR_MSG);'
      '1102016530=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102016531=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102016532=          EXIT;'
      '1102016533=        END'
      '1102016534=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1102016535=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1102016536=                                          :G_PRIHOD_,'
      
        '1102016537=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1102016538=                                          :DATE_RECEI' +
        'PT_,'
      
        '1102016539=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1102016540=                                          NULL,   --Z' +
        'AKAZ_'
      
        '1102016541=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1102016542=                                          :G_PAYMENT_' +
        'TYPE_,'
      '1102016543=                                          :G_TOCHKA_,'
      
        '1102016544=                                          :UPLOAD_TO_' +
        'EXT_APP_'
      
        '1102016545=                                         ) RETURNING_' +
        'VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102016546=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102016547=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1102016548=              EXIT;'
      '1102016549=            END'
      '1102016550=        END'
      '1102016551=  END'
      '1102016552='
      
        '1102016553=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO' +
        '_EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' ' +
        #1043#1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '1102016554=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0,1' +
        ')) THEN'
      
        '1102016555=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER, IS_LOADED_MOB)'
      
        '1102016556=    SELECT GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PAR' +
        'ENT_, 2, CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ELSE 0 END'
      '1102016557=      FROM RDB$DATABASE'
      
        '1102016558=     WHERE NOT EXISTS (SELECT 1 FROM SYNC_EXT_APP AP ' +
        'WHERE AP.OBJECT_TYPE = 2 AND AP.ID = :SKLAD_PARENT_ AND AP.IS_LO' +
        'ADING = 0);'
      '1102016559='
      '1102016560=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '1102016561=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_' +
        'ID_, :SKLAD_PARENT_, :DATE_RECEIPT_, 2, :SUMM_, :LOG_BODY_, 1);'
      '1102016562=end'
      '1102016563=;'
      '1102016564='
      '1102016565=ALTER PROCEDURE UPDATE_ZAKAZ_DETAIL('
      '1102016566=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1102016567=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1102016568=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1102016569=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1102016570=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1102016571=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1102016572=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1102016573=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102016574=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '1102016575=  SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '1102016576=  SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '1102016577=  SUMM_BONUS_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      
        '1102016578=  SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT' +
        ','
      
        '1102016579=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102016580=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102016581=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1102016582=  BY_RECIPE_ TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '1102016583=  IS_RESERVE_ TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '1102016584=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '1102016585=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      '1102016586=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '1102016587=  ADDRESS_ TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS = NU' +
        'LL,'
      
        '1102016588=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102016589=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL)'
      '1102016590=RETURNS ('
      '1102016591=  ERR_CODE INTEGER,'
      '1102016592=  ERR_MSG VARCHAR(1024))'
      '1102016593=AS'
      '1102016594=/* '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1059#1045#1058' '#1059#1046#1045' '#1057#1059#1065#1045#1057#1058#1042#1059#1070#1065#1048#1049' '#1047#1040#1050#1040#1047
      '1102016595='#1055#1056#1048' '#1069#1058#1054#1052':'
      '1102016596=1) '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1053#1045' '#1055#1045#1056#1045#1041#1048#1042#1040#1045#1058#1057#1071
      
        '1102016597=2) '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1070' '#1041#1067#1051#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1040' '#1050#1054#1052#1048#1057#1057#1048#1071', '#1048' '#1054#1053#1040' '#1041 +
        #1067#1051#1040' '#1059#1046#1045' '#1042#1067#1055#1051#1040#1063#1045#1053#1040', '#1058#1054' '#1055#1056#1048' '#1055#1054#1057#1051#1045#1044#1059#1070#1065#1045#1052' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1048' '#1047#1040#1050#1040#1047#1040
      
        '1102016598='#1071' '#1041#1059#1044#1059' '#1058#1056#1054#1043#1040#1058#1068' '#1050#1054#1052#1048#1057#1057#1048#1070', '#1050#1054#1058#1054#1056#1040#1071' '#1059#1046#1045' '#1057#1058#1054#1048#1058' '#1041#1059#1044#1059#1065#1045#1049' '#1044#1040 +
        #1058#1054#1049' ('#1041#1054#1051#1068#1064#1045' '#1048#1051#1048' '#1056#1040#1042#1053#1054' '#1057#1045#1043#1054#1044#1053#1071'), '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1057#1058#1040#1056#1059#1070' '#1042#1067#1055#1051#1040#1058#1059' '#1050#1054#1052#1048#1057#1057 +
        #1048#1048' '#1050#1040#1050' '#1071' '#1052#1054#1043#1059' '#1058#1056#1054#1043#1040#1058#1068
      '1102016599='
      
        '1102016600=UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044 +
        #1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102016601=*/'
      
        '1102016602=DECLARE VARIABLE PROCNAME VARCHAR(55) = '#39'UPDATE_ZAKAZ' +
        '_DETAIL'#39';'
      '1102016603=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1102016604=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102016605=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
