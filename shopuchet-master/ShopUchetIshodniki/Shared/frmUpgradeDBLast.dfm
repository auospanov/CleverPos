      '110237883=ALTER PROCEDURE INS_ZAKAZ('
      
        '110237884=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIG' +
        'INT,'
      '110237885=  Z_DATE_ /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '110237886=  Z_TIME_ /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '110237887=  G_CLIENT_ /* TYPE OF COLUMN ZAKAZ.G_CLIENT */ BIGINT' +
        ','
      
        '110237888=  G_PAYMENT_TYPE_ /* TYPE OF COLUMN ZAKAZ.G_PAYMENT_TY' +
        'PE */ BIGINT,'
      
        '110237889=  OSNOVANIE_ /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARC' +
        'HAR(150),'
      
        '110237890=  IS_SPISANIE_ /* TYPE OF COLUMN ZAKAZ.IS_SPISANIE */ ' +
        'INTEGER,'
      '110237891=  NOTE_ /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      '110237892=  SUMM_ /* TYPE OF COLUMN ZAKAZ.SUMM */ NUMERIC(15,2),'
      
        '110237893=  SUMM_FACT_ /* TYPE OF COLUMN ZAKAZ.SUMM_FACT */ NUME' +
        'RIC(15,2),'
      
        '110237894=  SUMM_CASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUME' +
        'RIC(15,2),'
      
        '110237895=  SUMM_NONCASH_ /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH *' +
        '/ NUMERIC(15,2),'
      
        '110237896=  SUMM_BONUS_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS */ NU' +
        'MERIC(15,2),'
      
        '110237897=  SUMM_BONUS_GOT_ /* TYPE OF COLUMN ZAKAZ.SUMM_BONUS_G' +
        'OT */ NUMERIC(15,2),'
      
        '110237898=  G_PRIHOD_ /* TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD' +
        '_RASHOD */ BIGINT,'
      
        '110237899=  SUMM_PRIHOD_ /* TYPE OF COLUMN KASSA.SUMM */ NUMERIC' +
        '(15,2),'
      
        '110237900=  BY_RECIPE_ /* TYPE OF COLUMN ZAKAZ.BY_RECIPE */ INTE' +
        'GER,'
      
        '110237901=  IS_RESERVE_ /* TYPE OF COLUMN ZAKAZ.IS_RESERVE */ IN' +
        'TEGER,'
      '110237902=  PAYMENTS_ BLOB SUB_TYPE 1,'
      '110237903=  IS_MEBEL_ INTEGER = 0,'
      
        '110237904=  DOSTAVSHIK_ /* TYPE OF COLUMN DELIVERY.DOSTAVSHIK */' +
        ' BIGINT = NULL,'
      
        '110237905=  DELIVERY_DATE_ /* TYPE OF COLUMN DELIVERY.DELIVERY_D' +
        'ATE */ DATE = NULL,'
      
        '110237906=  ADDRESS_ /* TYPE OF COLUMN ZAKAZ.DELIVERY_ADDRESS */' +
        ' VARCHAR(500) = NULL,'
      
        '110237907=  PRICE_ /* TYPE OF COLUMN DELIVERY.PRICE */ NUMERIC(1' +
        '5,2) = NULL,'
      '110237908=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110237909=  G_OFFICIAL_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL ' +
        '*/ BIGINT = NULL,'
      '110237910=  NOT_MINUS_OSTATOK_ INTEGER = 0,'
      
        '110237911=  USER_ID_ /* TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL */ ' +
        'BIGINT = NULL,'
      
        '110237912=  LOG_BODY_ /* TYPE OF COLUMN LOG_OPER.BODY */ BLOB SU' +
        'B_TYPE 1 SEGMENT SIZE 16384 = NULL,'
      
        '110237913=  REC_ID_ /* TYPE OF COLUMN SKLAD_PARENT.REC_ID */ BIG' +
        'INT = NULL,'
      
        '110237914=  G_NONCASH_PAY_TYPE_ /* TYPE OF COLUMN G_NONCASH_PAY_' +
        'TYPE.G_NONCASH_PAY_TYPE */ BIGINT = NULL,'
      
        '110237915=  POS_PAY_METHOD_ /* TYPE OF COLUMN ZAKAZ.POS_PAY_METH' +
        'OD */ VARCHAR(50) = NULL,'
      
        '110237916=  POS_PAY_TRANSACTION_ID_ /* TYPE OF COLUMN ZAKAZ.POS_' +
        'PAY_TRANSACTION_ID */ VARCHAR(50) = NULL)'
      '110237917=RETURNS ('
      '110237918=  ZAKAZ_ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '110237919=  ERR_CODE INTEGER,'
      '110237920=  ERR_MSG VARCHAR(1024))'
      '110237921=AS'
      '110237922=BEGIN'
      '110237923=  SUSPEND;'
      '110237924=END'
      '110237925=;'
