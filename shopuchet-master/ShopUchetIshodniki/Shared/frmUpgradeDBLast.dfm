        'UMM, NDS,'
      '110401744=                                     NDS_SUMM)'
      
        '110401745=          VALUES (GEN_ID(GEN_ZAKAZ_NA_REAL, 1), :ZAKAZ' +
        '_REAL_PARENT_,'
      '110401746=                  :G_PRODUCT,'
      
        '110401747=                  :PRICE - :DISCOUNT_TENGE,   --'#1054#1058#1056#1040#1046#1040 +
        #1070' '#1062#1045#1053#1059' '#1057#1056#1040#1047#1059' '#1057#1054' '#1057#1050#1048#1044#1050#1054#1049
      '110401748=                  :AMOUNT, :SUMM,'
      '110401749=                  0, --AMOUNT_PAYED,'
      '110401750=                  0, --SUMM_PAYED,'
      '110401751=                  0, --IS_PAYED_ALL,'
      '110401752=                  :DISCOUNT_PERC,'
      '110401753=                  :DISCOUNT_TENGE,'
      '110401754=                  :DISCOUNT_SUMM,'
      '110401755=                  :NDS,'
      '110401756=                  :NDS_SUMM)'
      '110401757=          RETURNING ZAKAZ_NA_REAL'
      '110401758=          INTO :ZAKAZ_;'
      '110401759=      END'
      '110401760=  END'
      '110401761=  -- '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '110401762=  ----------------------------------------'
      '110401763=  ----------------------------------------'
      '110401764=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      
        '110401765=  -- '#1058#1054' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1058#1040#1041#1051#1048#1062#1067' SKLAD, '#1055#1059#1057#1058#1068' '#1058#1040#1052' '#1051#1045#1046 +
        #1040#1058' '#1057' '#1055#1056#1048#1047#1053#1040#1050#1054#1052' IS_VOZVRAT = 3,'
      
        '110401766=  -- '#1055#1056#1048' '#1069#1058#1054#1052' '#1042' G_TOCHKA_ - '#1069#1058#1054' ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1071', ' +
        #1040' G_CLIENT - ID '#1057#1050#1051#1040#1044#1040'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110401767=  ELSE IF (IS_SPISANIE_ = 3) then BEGIN'
      
        '110401768=      INSERT INTO SKLAD_PARENT (SKLAD, DATE_RECEIPT, T' +
        'IME_RECEIPT, G_CLIENT, G_PAYMENT_TYPE, OSNOVANIE, NOTE, SUMM, SU' +
        'MM_FACT,'
      
        '110401769=                                IS_PAYED_ALL, IS_VOZVR' +
        'AT, G_TOCHKA)'
      
        '110401770=      VALUES (GEN_ID(GEN_SKLAD, 1), :Z_DATE_, :Z_TIME_' +
        ', :G_TOCHKA_, :G_PAYMENT_TYPE_, :OSNOVANIE_, :NOTE_, :SUMM_, :SU' +
        'MM_FACT_,'
      '110401771=              1, 3, :G_CLIENT_)'
      '110401772=      RETURNING SKLAD'
      '110401773=      INTO :SKLAD_;'
      '110401774='
      '110401775=      FOR SELECT G_PRODUCT, AMOUNT, PRICE, SUMM'
      '110401776=            FROM ZAKAZ_DETAILS_TMP Z'
      '110401777=          INTO :G_PRODUCT,'
      '110401778=              :AMOUNT,'
      '110401779=              :PRICE,'
      '110401780=              :SUMM'
      '110401781=      DO BEGIN'
      '110401782=        -- '#1042#1067#1063#1048#1058#1040#1070' '#1057#1054' '#1057#1050#1051#1040#1044#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '110401783=        UPDATE LT_SKLAD_PRODUCT L'
      '110401784=           SET L.AMOUNT = L.AMOUNT - :AMOUNT'
      '110401785=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110401786=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110401787='
      '110401788=        -- '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1053#1040' '#1057#1050#1051#1040#1044'-'#1055#1054#1051#1059#1063#1040#1058#1045#1051#1068
      
        '110401789=        -- '#1055#1054#1055#1059#1058#1053#1054' '#1042#1067#1063#1048#1057#1051#1071#1070' - '#1069#1058#1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048 +
        #1051#1048' '#1053#1045#1058
      '110401790=        IS_THIS_LAST_ = 0;'
      '110401791=        SELECT MAX(SK.DATE_RECEIPT)'
      '110401792=            FROM SKLAD SK'
      '110401793=         WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110401794=             AND SK.IS_LAST = 1'
      '110401795=             AND SK.G_TOCHKA = :G_CLIENT_'
      '110401796=            INTO :DATE_LAST_;'
      '110401797='
      
        '110401798=        IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or' +
        ' (Z_DATE_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051 +
        #1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110401799=            UPDATE SKLAD SK'
      '110401800=               SET SK.IS_LAST = 0'
      '110401801=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '110401802=               AND SK.IS_LAST = 1'
      '110401803=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '110401804='
      '110401805=            IS_THIS_LAST_ = 1;'
      '110401806=        END'
      '110401807='
      '110401808='
      '110401809=        INSERT INTO SKLAD'
      '110401810=        ('
      '110401811=         SKLAD,'
      '110401812=         SKLAD_PARENT,'
      '110401813=         DATE_RECEIPT,'
      '110401814=         G_CLIENT,'
      '110401815=         G_PRODUCT,'
      '110401816=         AMOUNT,'
      '110401817=         PRICE,'
      '110401818=         SUMM,'
      '110401819=         G_PAYMENT_TYPE,'
      '110401820=         OSNOVANIE,'
      '110401821=         NOTE,'
      '110401822=         NDS,'
      '110401823=         NDS_SUMM,'
      '110401824=         IS_LAST,'
      '110401825=         IS_VOZVRAT,'
      '110401826=         G_TOCHKA'
      '110401827=        ) VALUES ('
      '110401828=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '110401829=         :SKLAD_,'
      '110401830=         :Z_DATE_,'
      '110401831=         :G_TOCHKA_,'
      '110401832=         :G_PRODUCT,'
      '110401833=         :AMOUNT,'
      '110401834=         :PRICE,'
      '110401835=         :SUMM,'
      '110401836=         :G_PAYMENT_TYPE_,'
      '110401837=         :OSNOVANIE_,'
      '110401838=         :NOTE_,'
      '110401839=         0,  --:RNDS_,'
      '110401840=         0,  --:RNDS_SUMM_,'
      
        '110401841=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040 +
        ' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040 +
        ' '#1041#1059#1044#1045#1058' 0'
      '110401842=         3,  --:IS_VOZVRAT_,'
      '110401843=         :G_CLIENT_'
      '110401844=        );'
      '110401845='
      
        '110401846=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110401847=        PNT_ = '#39#39'02'#39#39';'
      '110401848=        UPDATE LT_SKLAD_PRODUCT L'
      '110401849=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '110401850=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '110401851=           AND L.G_TOCHKA = :G_CLIENT_;'
      '110401852='
      '110401853=        IF (ROW_COUNT = 0) THEN'
      
        '110401854=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PRO' +
        'DUCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '110401855=      END'
      '110401856=  END'
      '110401857='
      '110401858=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '110401859='
      
        '110401860=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '110401861=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110401862=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ =>' +
        ' :ACTION_'
      '110401863=                                  G_PRIHOD_,'
      '110401864=                                  :SUMM_PRIHOD_,'
      '110401865=                                  :Z_DATE_,'
      
        '110401866=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110401867=                                  :ZAKAZ_,'
      '110401868=                                  NULL,'
      '110401869=                                  :G_PAYMENT_TYPE_,'
      
        '110401870=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110401871=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110401872=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110401873=      EXIT;'
      '110401874=    END'
      '110401875=  END'
      '110401876='
      
        '110401877=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057 +
        #1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '110401878=  IF (IS_MEBEL_ = 1) THEN'
      
        '110401879=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS' +
        ', ZAKAZ)'
      
        '110401880=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, ' +
        ':ZAKAZ_);'
      '110401881=end'
      '110401882='#39';'
      '110401883=END  --END_EXECUTE_BLOCK'
      '110401884=EXECUTE BLOCK AS BEGIN'
      '110401885='
      '110401886=EXECUTE STATEMENT '#39'ALTER PROCEDURE UPD_SKLAD('
      '110401887=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110401888=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '110401889=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110401890=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110401891=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110401892=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110401893=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110401894=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110401895=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '110401896=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110401897=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110401898=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110401899=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110401900=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0)'
      '110401901=RETURNS ('
      '110401902=  ERR_CODE INTEGER,'
      '110401903=  ERR_MSG VARCHAR(1024))'
      '110401904=AS'
      
        '110401905=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110401906=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      
        '110401907=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39#39'UPD_SKLAD'#39#39 +
        ';'
      '110401908=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110401909=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASSA' +
        ';'
      '110401910=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '110401911=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLAD' +
        ';'
      
        '110401912=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLAD' +
        '_PARENT.IS_EXPECTED;'
      
        '110401913=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      '110401914=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '110401915=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMOU' +
        'NT;'
      
        '110401916=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKLA' +
        'D.DATE_RECEIPT;'
      '110401917=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '110401918=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '110401919=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '110401920=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '110401921=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      
        '110401922=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN SK' +
        'LAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '110401923=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLAD' +
        '.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058 +
        ' */'
      
        '110401924=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110401925=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110401926=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_T' +
        'OCHKA;'
      '110401927=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110401928=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110401929=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110401930=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      
        '110401931=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_PA' +
        'YMENT_TYPE.G_PAYMENT_TYPE;'
      '110401932=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110401933=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110401934=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39#39'~'#39#39'; /* ' +
        #1044#1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '110401935=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110401936=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      '110401937=BEGIN'
      '110401938='
      '110401939=  IS_THIS_LAST_ = 0;'
      '110401940='
      '110401941=  SELECT S.G_TOCHKA,'
      '110401942=         S.IS_VOZVRAT,'
      '110401943=         S.G_PAYMENT_TYPE'
      '110401944=         ,S.is_expected'
      '110401945=    FROM SKLAD_parent S'
      '110401946=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '110401947=    INTO :G_TOCHKA_,'
      '110401948=         :IS_VOZVRAT_,'
      '110401949=         :G_PAYMENT_TYPE_OLD_'
      '110401950=         ,:IS_EXPECTED_OLD_;'
      '110401951='
      '110401952=  PNT_ = '#39#39'00'#39#39';'
      '110401953=  UPDATE SKLAD_PARENT'
      '110401954=  SET'
      
        '110401955=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEIP' +
        'T),'
      
        '110401956=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEIP' +
        'T),'
      
        '110401957=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYME' +
        'NT_TYPE),'
      '110401958=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '110401959=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '110401960=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '110401961=   SUMM      = :SUMM_,'
      '110401962=   SUMM_FACT = :SUMM_FACT_,'
      '110401963=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '110401964=   IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, 1, 0)  ' +
        '-- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' ' +
        #1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110401965=   ,IS_EXPECTED  = :IS_EXPECTED_'
      '110401966=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '110401967='
      
        '110401968=  ----------------------------------------------------' +
        '---------'
      '110401969=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040
      '110401970=  PNT_ = '#39#39'02'#39#39';'
      '110401971=  FOR SELECT SKLAD'
      '110401972=        FROM SKLAD S'
      '110401973=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '110401974=         AND NOT EXISTS (SELECT 1'
      '110401975=                           FROM SKLAD_TMP T'
      '110401976=                        WHERE T.SKLAD = S.SKLAD)'
      '110401977=  INTO :SKLAD_'
      '110401978=  DO BEGIN'
      
        '110401979=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_,' +
        ' :SKLAD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110401980=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110401981=      ERR_MSG = PROCNAME||'#39#39' -> PNT_ '#39#39'||PNT_||'#39#39' '#39#39'||' +
        'ERR_MSG;'
      '110401982=      EXIT;'
      '110401983=    END'
      '110401984=  END'
      '110401985='
      
        '110401986=  ----------------------------------------------------' +
        '---------'
      
        '110401987=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044#1054 +
        #1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '110401988=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '110401989=  PNT_ = '#39#39'03'#39#39';'
      '110401990=  FOR SELECT S.SKLAD,'
      '110401991=             S.G_PRODUCT,'
      '110401992=             S.AMOUNT,'
      '110401993=             S.PRICE,'
      '110401994=             S.SUMM,'
      '110401995=             S.NDS,'
      '110401996=             S.NDS_SUMM,'
      '110401997=             T.SKLAD,'
      '110401998=             T.AMOUNT,'
      '110401999=             T.IS_LAST,'
      '110402000=             T.DATE_RECEIPT'
      '110402001=             ,S.PRICE_CURRENCY'
      '110402002=             ,S.SUMM_CURRENCY'
      
        '110402003=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLAD' +
        ', AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT = ' +
        ':SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '110402004=  INTO :SKLAD_,'
      '110402005=       :G_PRODUCT_,'
      '110402006=       :AMOUNT_,'
      '110402007=       :PRICE_,'
      '110402008=       :SUMM_ONE_,'
      '110402009=       :NDS_,'
      '110402010=       :NDS_SUMM_,'
      '110402011=       :SKLAD_OLD_,'
      '110402012=       :AMOUNT_OLD_,'
      '110402013=       :IS_THIS_LAST_,'
      '110402014=       :DATE_RECEIPT_OLD_'
      '110402015=       ,:PRICE_CURRENCY_'
      '110402016=       ,:SUMM_CURRENCY_TMP_'
      '110402017=  DO BEGIN'
      
        '110402018=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058#1040 +
        #1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110402019=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '110402020=        PNT_ = '#39#39'04'#39#39';'
      
        '110402021=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_R' +
        'ECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYPE' +
        ', NDS, NDS_SUMM,'
      
        '110402022=                          IS_LAST, NOTE, OSNOVANIE, IS' +
        '_VOZVRAT, G_TOCHKA'
      '110402023=                          ,PRICE_CURRENCY'
      '110402024=                          ,SUMM_CURRENCY)'
      
        '110402025=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIPT' +
        '_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_PA' +
        'YMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '110402026=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '110402027=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :G' +
        '_TOCHKA_'
      '110402028=               ,:PRICE_CURRENCY_'
      '110402029=               ,:SUMM_CURRENCY_TMP_'
      '110402030=               );'
      '110402031='
      
        '110402032=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058 +
        #1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '110402033=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110402034=            UPDATE LT_SKLAD_PRODUCT L'
      '110402035=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
