      '110911181=                                  :ZAKAZ_,'
      '110911182=                                  NULL,'
      '110911183=                                  :G_PAYMENT_TYPE_,'
      
        '110911184=                                  :G_TOCHKA_) RETURNIN' +
        'G_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110911185=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110911186=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110911187=      EXIT;'
      '110911188=    END'
      '110911189=  END'
      '110911190='
      
        '110911191=  -- '#1045#1057#1051#1048' '#1042#1050#1051#1070#1063#1045#1053' '#1052#1045#1041#1045#1051#1068#1053#1067#1049' '#1052#1040#1043#1040#1047#1048#1053', '#1058#1054' '#1053#1040#1044#1054' '#1044#1045#1051#1040#1058#1068' '#1042#1057 +
        #1058#1040#1042#1050#1059' '#1042' '#1046#1059#1056#1053#1040#1051' '#1044#1054#1057#1058#1040#1042#1050#1048
      '110911192=  IF (IS_MEBEL_ = 1) THEN'
      
        '110911193=      INSERT INTO DELIVERY (DELIVERY, G_CLIENT, STATUS' +
        ', ZAKAZ, DOSTAVSHIK, DELIVERY_DATE, ADDRESS, PRICE)'
      
        '110911194=      VALUES (GEN_ID(GEN_DELIVERY, 1), :G_CLIENT_, 0, ' +
        ':ZAKAZ_, :DOSTAVSHIK_, :DELIVERY_DATE_, :ADDRESS_, :PRICE_);'
      '110911195=end'
      '110911196=;'
      '110911197='
      '110911198=ALTER PROCEDURE P_REP_BILL('
      '110911199=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110911200=  SUMM_DANO_ NUMERIC(15,2),'
      '110911201=  SUMM_SDACHA_ NUMERIC(15,2),'
      '110911202=  CURRENCY_ INTEGER,'
      '110911203=  MODE_ INTEGER,'
      '110911204=  PRINT_SLOGAN_ VARCHAR(80),'
      '110911205=  DECIMAL_ INTEGER)'
      '110911206=RETURNS ('
      '110911207=  FIRM_NAME_ VARCHAR(600),'
      '110911208=  IDN_STR_ VARCHAR(30),'
      '110911209=  FIRM_IDN_ VARCHAR(50),'
      '110911210=  FIRM_ADDRESS_ VARCHAR(550),'
      '110911211=  NUM_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110911212=  DATE_ VARCHAR(100),'
      '110911213=  PAYMENT_TYPE_ VARCHAR(100),'
      '110911214=  G_CLIENT_NAME_ VARCHAR(300),'
      '110911215=  G_OFFICIAL_FM_ VARCHAR(300),'
      '110911216=  SUMM_VSEGO_ VARCHAR(50),'
      '110911217=  SUMM_VSEGO_N_ VARCHAR(50),'
      '110911218=  AMOUNT_VSEGO_ VARCHAR(50),'
      '110911219=  ROW_NUM INTEGER,'
      '110911220=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110911221=  NAME_ART VARCHAR(1000),'
      '110911222=  AMOUNT VARCHAR(50),'
      '110911223=  SHORT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110911224=  PRICE VARCHAR(50),'
      '110911225=  PRICE_N VARCHAR(50),'
      '110911226=  SUMM VARCHAR(50),'
      '110911227=  SUMM_N VARCHAR(50),'
      '110911228=  SUMM_POLUCH_ VARCHAR(50),'
      '110911229=  SUMM_SDACH_ VARCHAR(50),'
      '110911230=  SUMM_STR_ VARCHAR(200),'
      '110911231=  SLOGAN_ VARCHAR(80),'
      '110911232=  SUMM_SKIDKA_ VARCHAR(50),'
      '110911233=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '110911234=  ERR_CODE NUMERIC(15,2),'
      '110911235=  ERR_MSG VARCHAR(1024))'
      '110911236=AS'
      '110911237=/*'#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040' '#1055#1056#1048' '#1055#1056#1054#1044#1040#1046#1045'*/'
      '110911238=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_BILL'#39';'
      '110911239=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110911240=DECLARE VARIABLE I INTEGER = 1;'
      
        '110911241=DECLARE VARIABLE G_FIRM_REKVIZIT_ TYPE OF COLUMN G_FIR' +
        'M_REKVIZIT.G_FIRM_REKVIZIT;'
      
        '110911242=DECLARE VARIABLE AMOUNT_NUM_ TYPE OF COLUMN ZAKAZ_DETA' +
        'ILS.AMOUNT;'
      
        '110911243=DECLARE VARIABLE AMOUNT_VSEGO_NUM_ TYPE OF COLUMN ZAKA' +
        'Z_DETAILS.AMOUNT;'
      
        '110911244=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110911245=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      '110911246=BEGIN'
      '110911247=  SLOGAN_ = PRINT_SLOGAN_;'
      '110911248='
      '110911249=  -- '#1042#1045#1056#1061#1053#1071#1071' '#1063#1040#1057#1058#1068' '#1063#1045#1050#1040
      '110911250=  SELECT z.ZAKAZ'
      '110911251=         ,P.NAME'
      
        '110911252=         ,lpad(EXTRACT(DAY FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.' +
        #39'||lpad(EXTRACT(MONTH FROM Z.Z_DATE), 2, '#39'0'#39')||'#39'.'#39'||EXTRACT(YEAR' +
        ' FROM Z.Z_DATE)||'#39'  '#39'||EXTRACT(HOUR FROM Z.Z_TIME)||'#39':'#39'||EXTRACT' +
        '(MINUTE FROM Z.Z_TIME)'
      '110911253=         ,'#39#1050#1083#1080#1077#1085#1090': '#39'||G.NAME'
      
        '110911254=         ,'#39#1057#1086#1090#1088#1091#1076#1085#1080#1082': '#39'||COALESCE(O.FM, '#39#39')||'#39' '#39'||COAL' +
        'ESCE(O.NM, '#39#39')'
      '110911255=         ,Z.summ_noncash'
      '110911256=         ,Z.summ_cash'
      '110911257=         ,Z.NOTE'
      
        '110911258=    FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G_O' +
        'FFICIAL = O.G_OFFICIAL,'
      '110911259=         G_CLIENT G,'
      '110911260=         G_PAYMENT_TYPE P'
      '110911261=   WHERE Z.ZAKAZ = :ZAKAZ_'
      '110911262=     AND Z.G_CLIENT = G.G_CLIENT'
      '110911263=     AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110911264=    INTO :NUM_'
      '110911265=        ,:PAYMENT_TYPE_'
      '110911266=        ,:DATE_'
      '110911267=        ,:G_CLIENT_NAME_'
      '110911268=        ,:G_OFFICIAL_FM_'
      '110911269=        ,:SUMM_NONCASH_'
      '110911270=        ,:SUMM_CASH_'
      '110911271=        ,:NOTE_'
      '110911272=        ;'
      '110911273='
      '110911274=  IF (SUMM_NONCASH_ <> 0 AND SUMM_CASH_ <> 0) THEN'
      '110911275=    PAYMENT_TYPE_ = '#39#1057#1087#1086#1089#1086#1073' '#1086#1087#1083#1072#1090#1099': '#1085#1072#1083'./'#1073#1077#1079#1085#1072#1083'.'#39';'
      '110911276='
      '110911277=  SELECT R.G_FIRM_REKVIZIT,'
      '110911278=         '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103': '#39'||r.NAME,'
      
        '110911279=         DECODE(:CURRENCY_, 0, '#39#1048#1048#1053'/'#1041#1048#1053#39', '#39#1048#1053#1053#39')||'#39' '#1086#1088 +
        #1075'.: '#39'||COALESCE(R.IDN, '#39#39')'
      '110911280=    FROM G_FIRM_REKVIZIT R'
      '110911281=   WHERE R.is_default = 1'
      '110911282=    INTO :G_FIRM_REKVIZIT_,'
      '110911283=         :FIRM_NAME_,'
      '110911284=         :FIRM_IDN_;'
      '110911285='
      '110911286=  SELECT SUM(ZD.AMOUNT),'
      
        '110911287=         CAST(ROUND(SUM(ZD.DISCOUNT_SUMM), 2) AS VARCH' +
        'AR(100)),'
      
        '110911288=         CAST(ROUND(SUM(ZD.SUMM + ZD.DISCOUNT_SUMM), 2' +
        ') AS VARCHAR(100)),'
      '110911289=         CAST(SUM(ZD.SUMM) AS VARCHAR(100))'
      '110911290=  FROM ZAKAZ_DETAILS ZD'
      '110911291=  WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110911292=  INTO :AMOUNT_VSEGO_NUM_,'
      '110911293=       :SUMM_SKIDKA_,'
      '110911294=       :SUMM_VSEGO_,'
      '110911295=       :SUMM_VSEGO_N_;'
      '110911296='
      '110911297=  SELECT '#39#1040#1076#1088#1077#1089': '#39'||R.address'
      '110911298=    FROM G_FIRM_ADDRESS R'
      '110911299=   WHERE R.IS_DEFAULT = 1'
      '110911300=     AND R.g_firm_rekvizit = :G_FIRM_REKVIZIT_'
      '110911301=    INTO :FIRM_ADDRESS_;'
      '110911302='
      
        '110911303=  --'#1041#1067#1042#1040#1045#1058' '#1063#1058#1054' '#1050#1051#1048#1045#1053#1058' '#1045#1065#1045' '#1053#1045' '#1047#1040#1055#1054#1051#1053#1048#1051' '#1056#1045#1050#1042#1048#1047#1048#1058#1067' '#1052#1040#1043#1040#1047#1048 +
        #1053#1040', '#1053#1040#1044#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068
      
        '110911304=  FIRM_NAME_    = COALESCE(:FIRM_NAME_, '#39#1054#1088#1075#1072#1085#1080#1079#1072#1094#1080#1103':'#39 +
        ');'
      '110911305=  IF (FIRM_IDN_ IS NULL) THEN BEGIN'
      '110911306=    IF (CURRENCY_ = 0) THEN'
      '110911307=      FIRM_IDN_ = '#39#1048#1048#1053'/'#1041#1048#1053' '#1086#1088#1075'.:'#39';'
      '110911308=    ELSE'
      '110911309=      FIRM_IDN_ = '#39#1048#1053#1053' '#1086#1088#1075'.:'#39';'
      '110911310=  END'
      '110911311='
      '110911312=  FIRM_ADDRESS_ = COALESCE(:FIRM_ADDRESS_, '#39#1040#1076#1088#1077#1089':'#39');'
      '110911313='
      
        '110911314=  SUMM_POLUCH_ = CAST(ROUND(SUMM_DANO_, 2) AS VARCHAR(' +
        '100));'
      
        '110911315=  SUMM_SDACH_  = CAST(ROUND(SUMM_SDACHA_, 2) AS VARCHA' +
        'R(100));'
      '110911316='
      '110911317=  SELECT CURR_STR||'#39'. '#1041#1077#1079' '#1053#1044#1057'.'#39
      '110911318=    from CURRENCYSTR(:SUMM_VSEGO_N_, :CURRENCY_)'
      '110911319=  INTO :SUMM_STR_;'
      '110911320='
      '110911321=  FOR'
      '110911322=    SELECT :I,'
      '110911323=           G.NAME,'
      
        '110911324=           G.NAME||COALESCE('#39'('#1072#1088#1090'. '#39'||G.ARTICUL||'#39')'#39', ' +
        #39#39'),'
      '110911325=           ZD.AMOUNT,'
      '110911326=           CAST(ROUND(ZD.PRICE, 2) AS VARCHAR(100)),'
      
        '110911327=           CAST(ROUND(ZD.SUMM + ZD.DISCOUNT_SUMM, 2) A' +
        'S VARCHAR(100))'
      '110911328=           ,COALESCE(U.SHORT_NAME, U.NAME)'
      
        '110911329=           ,CAST(ZD.PRICE - COALESCE(ZD.DISCOUNT_TENGE' +
        ', 0) AS VARCHAR(100))'
      '110911330=           ,CAST(ZD.SUMM AS VARCHAR(100))'
      '110911331=      FROM ZAKAZ Z,'
      '110911332=           ZAKAZ_DETAILS ZD,'
      '110911333=           G_PRODUCT G,'
      '110911334=           G_UNIT U'
      '110911335=     WHERE Z.ZAKAZ = :ZAKAZ_'
      '110911336=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110911337=       AND ZD.G_PRODUCT = G.G_PRODUCT'
      '110911338=       AND G.G_UNIT = U.G_UNIT'
      '110911339=     ORDER BY ZD.zakaz_details'
      '110911340=    INTO :ROW_NUM,'
      '110911341=        :NAME,'
      '110911342=        :NAME_ART,'
      '110911343=        :AMOUNT_NUM_,'
      '110911344=        :PRICE,'
      '110911345=        :SUMM'
      '110911346=        ,:SHORT_NAME'
      '110911347=        ,:PRICE_N'
      '110911348=        ,:SUMM_N'
      '110911349=  DO BEGIN'
      '110911350=    I = I + 1;'
      '110911351='
      
        '110911352=    -- '#1048#1047#1041#1040#1042#1051#1071#1070#1057#1068' '#1054#1058' '#1055#1059#1057#1058#1067#1061' ".00", '#1045#1057#1051#1048' '#1044#1056#1054#1041#1053#1040#1071' '#1063#1040#1057#1058#1068' ' +
        #1055#1059#1057#1058#1040#1071', '#1058#1054' '#1053#1040#1061' '#1042#1067#1042#1054#1044#1048#1058#1068' '#1042#1040#1065#1055#1045
      '110911353=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_) > 0) then'
      
        '110911354=      SUMM_VSEGO_    = SUBSTRING(SUMM_VSEGO_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_VSEGO_)-1);'
      '110911355=    if (POSITION('#39'.00'#39' IN SUMM_VSEGO_N_) > 0) then'
      
        '110911356=      SUMM_VSEGO_N_  = SUBSTRING(SUMM_VSEGO_N_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_VSEGO_N_)-1);'
      '110911357=    if (POSITION('#39'.00'#39' IN PRICE) > 0) then'
      
        '110911358=      PRICE          = SUBSTRING(PRICE FROM 1 FOR POSI' +
        'TION('#39'.00'#39' IN PRICE)-1);'
      '110911359=    if (POSITION('#39'.00'#39' IN PRICE_N) > 0) then'
      
        '110911360=      PRICE_N        = SUBSTRING(PRICE_N FROM 1 FOR PO' +
        'SITION('#39'.00'#39' IN PRICE_N)-1);'
      '110911361=    if (POSITION('#39'.00'#39' IN SUMM) > 0) then'
      
        '110911362=      SUMM           = SUBSTRING(SUMM FROM 1 FOR POSIT' +
        'ION('#39'.00'#39' IN SUMM)-1);'
      '110911363=    if (POSITION('#39'.00'#39' IN SUMM_N) > 0) then'
      
        '110911364=      SUMM_N         = SUBSTRING(SUMM_N FROM 1 FOR POS' +
        'ITION('#39'.00'#39' IN SUMM_N)-1);'
      '110911365=    if (POSITION('#39'.00'#39' IN SUMM_POLUCH_) > 0) then'
      
        '110911366=      SUMM_POLUCH_   = SUBSTRING(SUMM_POLUCH_ FROM 1 F' +
        'OR POSITION('#39'.00'#39' IN SUMM_POLUCH_)-1);'
      '110911367=    if (POSITION('#39'.00'#39' IN SUMM_SDACH_) > 0) then'
      
        '110911368=      SUMM_SDACH_    = SUBSTRING(SUMM_SDACH_ FROM 1 FO' +
        'R POSITION('#39'.00'#39' IN SUMM_SDACH_)-1);'
      '110911369=    if (POSITION('#39'.00'#39' IN SUMM_SKIDKA_) > 0) then'
      
        '110911370=      SUMM_SKIDKA_    = SUBSTRING(SUMM_SKIDKA_ FROM 1 ' +
        'FOR POSITION('#39'.00'#39' IN SUMM_SKIDKA_)-1);'
      '110911371='
      '110911372=    -- '#1055#1056#1045#1054#1041#1056#1040#1047#1059#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '110911373=    IF (DECIMAL_ = 2) THEN BEGIN'
      '110911374=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,2));'
      
        '110911375=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,2));'
      '110911376=    END ELSE IF (DECIMAL_ = 3) THEN BEGIN'
      '110911377=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,3));'
      
        '110911378=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,3));'
      '110911379=    END ELSE IF (DECIMAL_ = 4) THEN BEGIN'
      '110911380=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,4));'
      
        '110911381=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,4));'
      '110911382=    END ELSE BEGIN'
      '110911383=      AMOUNT = CAST(AMOUNT_NUM_ AS NUMERIC(18,5));'
      
        '110911384=      AMOUNT_VSEGO_NUM_ = CAST(AMOUNT_VSEGO_NUM_ AS NU' +
        'MERIC(18,5));'
      '110911385=    END'
      '110911386='
      
        '110911387=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T) > 0) then'
      
        '110911388=      AMOUNT         = SUBSTRING(AMOUNT FROM 1 FOR POS' +
        'ITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT)-1);'
      '110911389='
      
        '110911390=    if (POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUN' +
        'T_VSEGO_) > 0) then'
      
        '110911391=      AMOUNT_VSEGO_  = SUBSTRING(AMOUNT_VSEGO_ FROM 1 ' +
        'FOR POSITION(RPAD('#39'.'#39', DECIMAL_ + 1, '#39'0'#39') IN AMOUNT_VSEGO_)-1);'
      '110911392='
      '110911393=    SUSPEND;'
      '110911394=  END'
      '110911395=WHEN ANY DO BEGIN'
      '110911396=    Err_code = -20500;'
      
        '110911397=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1063#1045#1050#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110911398=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110911399=  END'
      '110911400=end'
      '110911401=;'
      
        '110911402=UPDATE SYSTEM_SETUP SET S_VALUE = 11091 WHERE SYSTEM_S' +
        'ETUP = 3;'
      
        '110911403=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110911404=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '110920=ALTER PROCEDURE G_READ_G_PRODCAT_LIST('
      '110921=  TYPE_ INTEGER = 0,'
      
        '110922=  G_PRODUCT_PAR_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR =' +
        ' NULL)'
      '110923=RETURNS ('
      '110924=  SORT_COL INTEGER,'
      '110925=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '110926=  G_PRODUCT_PAR TYPE OF COLUMN G_PRODUCT.G_PRODUCT_PAR,'
      '110927=  NAME VARCHAR(500))'
      '110928=AS'
      '110929=DECLARE VARIABLE LVL_ INTEGER;'
      '1109210=BEGIN'
      '1109211='
      '1109212=  IF (COALESCE(TYPE_, 0) = 0) THEN'
      '1109213=      FOR'
      '1109214=        SELECT'
      
        '1109215=            DECODE(T.G_PRODUCT, -1, 0, T.g_product) SORT' +
        '_COL,'
      '1109216=            T.G_PRODUCT,'
      '1109217=            T.G_PRODUCT_PAR,'
      '1109218=            T.NAME,'
      '1109219=            0'
      '1109220=        FROM G_PRODUCT T'
      '1109221=        WHERE T.IS_CATEGORY = 1'
      '1109222=        ORDER BY T.NAME'
      '1109223=        INTO'
      '1109224=            :SORT_COL,'
      '1109225=            :G_PRODUCT,'
      '1109226=            :G_PRODUCT_PAR,'
      '1109227=            :NAME,'
      '1109228=            :LVL_'
      '1109229=      DO'
      '1109230=        suspend;'
      '1109231='
      
        '1109232=  -- '#1054#1041#1067#1063#1053#1054' '#1048#1045#1056#1040#1056#1061#1048#1063#1045#1057#1050#1048#1049' '#1053#1045' '#1053#1059#1046#1045#1053', '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1042' '#1057#1051#1059#1063#1040 +
        #1045', '#1050#1054#1043#1044#1040' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1067#1057#1058#1040#1042#1051#1071#1045#1058' '#1058#1054#1042#1040#1056#1067' '#1050#1040#1050' '#1050#1053#1054#1055#1050#1048' '#1042' '#1056#1052#1050
      
        '1109233=  -- '#1057#1045#1049#1063#1040#1057' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040' '#1057#1058#1054#1048#1058' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070', '#1055#1054#1057#1051#1045' '#1056#1054#1044#1048 +
        #1058#1045#1051#1045#1049' '#1044#1045#1058#1050#1048' '#1055#1054#1049#1044#1059#1058' '#1058#1054#1046#1045' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1070
      
