      '11096438=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '11096439=                 INTO :KASSA_POP_;'
      '11096440='
      
        '11096441=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) ' +
        'THEN BEGIN'
      '11096442=              PNT_ = '#39'09'#39';'
      
        '11096443=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' '#1054#1053 +
        #1040' '#1045#1057#1058#1068
      '11096444=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '11096445=                    EXECUTE PROCEDURE K_UPD_KASSA(:KASS' +
        'A_POP_,'
      
        '11096446=                                                  0,   ' +
        '  -- ACTION_'
      
        '11096447=                                                  :G_PR' +
        'IHOD_,'
      
        '11096448=                                                  :SUMM' +
        '_PRIHOD_,'
      
        '11096449=                                                  :Z_DA' +
        'TE_,'
      
        '11096450=                                                  NULL,' +
        '   --NOTE_'
      
        '11096451=                                                  :ZAKA' +
        'Z_,'
      '11096452=                                                  NULL,'
      
        '11096453=                                                  :G_PA' +
        'YMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '11096454=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '11096455=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '11096456=                    PNT_ = '#39'10'#39';'
      
        '11096457=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_'
      
        '11096458=                                                  :G_PR' +
        'IHOD_,'
      
        '11096459=                                                  :SUMM' +
        '_PRIHOD_,'
      
        '11096460=                                                  :Z_DA' +
        'TE_,'
      
        '11096461=                                                  NULL,' +
        '   --NOTE_ => :NOTE_,'
      
        '11096462=                                                  :ZAKA' +
        'Z_,'
      '11096463=                                                  NULL,'
      
        '11096464=                                                  :G_PA' +
        'YMENT_TYPE_,'
      
        '11096465=                                                  :G_TO' +
        'CHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '11096466=              END'
      '11096467='
      
        '11096468=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053 +
        #1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '11096469=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053 +
        #1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '11096470=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYME' +
        'NT_TYPE_) THEN BEGIN'
      '11096471=                PNT_ = '#39'11'#39';'
      '11096472=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11096473=                    EXECUTE PROCEDURE K_DEL_KASSA(:KASS' +
        'A_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_' +
        'MSG);'
      '11096474=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '11096475=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '11096476=                      EXIT;'
      '11096477=                    END'
      '11096478='
      
        '11096479=                    EXECUTE PROCEDURE K_INS_KASSA(0,   ' +
        '  -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '11096480=                                                  :G_PR' +
