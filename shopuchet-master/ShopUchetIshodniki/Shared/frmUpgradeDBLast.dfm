        ';'
      '1101461671=                    END'
      '1101461672=                END'
      '1101461673=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461674=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PN' +
        'T_||'#39' '#39'||ERR_MSG;'
      '1101461675=                  EXIT;'
      '1101461676=                END'
      '1101461677='
      
        '1101461678=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~' +
        #39';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101461679=            END'
      '1101461680='
      
        '1101461681=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051 +
        #1048' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101461682=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101461683=                FROM KASSA K'
      '1101461684=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101461685=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA||'#39'~'#39
      '1101461686=                UNION'
      '1101461687=                SELECT KASSA, 1 PAYMENT_TYPE'
      '1101461688=                  FROM KASSA K'
      '1101461689=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '1101461690=                   AND K.SUMM = 0'
      '1101461691=                UNION'
      
        '1101461692=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101461693=                FROM KASSA_BEZNAL K'
      '1101461694=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '1101461695=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||' +
        'K.KASSA_BEZNAL||'#39'~'#39
      '1101461696=                UNION'
      
        '1101461697=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_' +
        'TYPE'
      '1101461698=                FROM KASSA_BEZNAL K'
      '1101461699=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101461700=                 AND K.SUMM = 0'
      '1101461701=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101461702=            DO BEGIN'
      '1101461703=                PNT_ = '#39'08'#39';'
      
        '1101461704=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_' +
        ', :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101461705=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461706=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||' +
        'PNT_||'#39' '#39'||ERR_MSG;'
      '1101461707=                    EXIT;'
      '1101461708=                END'
      '1101461709=            END'
      '1101461710='
      
        '1101461711=            --=======================================' +
        '=========================='
      '1101461712=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101461713=            --=======================================' +
        '=========================='
      
        '1101461714=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057 +
        #1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '1101461715=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040 +
        #1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '1101461716=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055 +
        #1054' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '1101461717=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101461718=                SELECT K.KASSA'
      '1101461719=                FROM KASSA K'
      '1101461720=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101461721=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101461722=                 INTO :KASSA_POP_;'
      '1101461723=            ELSE'
      '1101461724=                SELECT K.KASSA_BEZNAL'
      '1101461725=                FROM KASSA_BEZNAL K'
      '1101461726=                WHERE K.ZAKAZ = :ZAKAZ_'
      '1101461727=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '1101461728=                 INTO :KASSA_POP_;'
      '1101461729='
      
        '1101461730=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101461731=              PNT_ = '#39'09'#39';'
      
        '1101461732=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' ' +
        #1054#1053#1040' '#1045#1057#1058#1068
      '1101461733=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '1101461734=                    EXECUTE PROCEDURE K_UPD_KASSA(:KA' +
        'SSA_POP_,'
      
        '1101461735=                                                  0, ' +
        '    -- ACTION_'
      
        '1101461736=                                                  :G_' +
        'PRIHOD_,'
      
        '1101461737=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101461738=                                                  :Z_' +
        'DATE_,'
      
        '1101461739=                                                  NUL' +
        'L,   --NOTE_'
      
        '1101461740=                                                  :ZA' +
        'KAZ_,'
      
        '1101461741=                                                  NUL' +
        'L,'
      
        '1101461742=                                                  :G_' +
        'PAYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101461743=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101461744=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '1101461745=                    PNT_ = '#39'10'#39';'
      
        '1101461746=                    EXECUTE PROCEDURE K_INS_KASSA(0, ' +
        '    -- ACTION_ => :ACTION_'
      
        '1101461747=                                                  :G_' +
        'PRIHOD_,'
      
        '1101461748=                                                  :SU' +
        'MM_PRIHOD_,'
      
        '1101461749=                                                  :Z_' +
        'DATE_,'
      
        '1101461750=                                                  NUL' +
        'L,   --NOTE_ => :NOTE_,'
      
        '1101461751=                                                  :ZA' +
        'KAZ_,'
      
        '1101461752=                                                  NUL' +
        'L,'
      
        '1101461753=                                                  :G_' +
        'PAYMENT_TYPE_,'
      
        '1101461754=                                                  :G_' +
        'TOCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101461755=              END'
      '1101461756='
      
        '1101461757=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101461758=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059',' +
        ' '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101461759=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAY' +
        'MENT_TYPE_) THEN BEGIN'
      '1101461760=                PNT_ = '#39'11'#39';'
      '1101461761=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101461762=                    EXECUTE PROCEDURE K_DEL_KASSA(:KA' +
        'SSA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1101461763=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101461764=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39 +
        '||PNT_||'#39' '#39'||ERR_MSG;'
