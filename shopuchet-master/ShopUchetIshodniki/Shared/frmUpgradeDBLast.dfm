        '110402188=      -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' ' +
        #1059#1055#1040#1050#1054#1042#1050#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1057' '#1050#1040#1057#1057#1067
      
        '110402189=      -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' '#1044#1040#1053#1053#1054 +
        #1052#1059' '#1055#1056#1048#1061#1054#1044#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '110402190=      IF (IS_VOZVRAT_ = 0) THEN'
      '110402191=        G_PRIHOD_RASHOD_ = 2;'
      '110402192=      ELSE'
      '110402193=        G_PRIHOD_RASHOD_ = 3;'
      '110402194='
      '110402195=      WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110402196=            PNT_ = '#39#39'09'#39#39';'
      '110402197=            POS_TILDA_ = POSITION('#39#39'~'#39#39' IN PAYMENTS_);'
      
        '110402198=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110402199=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110402200=            ELSE'
      
        '110402201=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110402202='
      '110402203=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110402204=                RETURNING_VALUES :KASSA_, :PAYMENT_DAT' +
        'E_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110402205='
      
        '110402206=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39#39'~'#39#39' IN PAYMENTS_)) + 1);'
      '110402207=            IF (KASSA_ = 0 AND PAYMENT_SUMM_ > 0) THEN'
      
        '110402208=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110402209=                                              :G_PRIHO' +
        'D_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '110402210=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110402211=                                              :PAYMENT' +
        '_DATE_,'
      
        '110402212=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110402213=                                              NULL,   ' +
        '--ZAKAZ_'
      
        '110402214=                                              :SKLAD_P' +
        'ARENT_,'
      
        '110402215=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110402216=                                              :G_TOCHK' +
        'A_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110402217='
      
        '110402218=            -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058 +
        #1040' '#1053#1045' '#1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      '110402219=            ELSE BEGIN'
      
        '110402220=                -- '#1054#1055#1056#1045#1044#1045#1051#1071#1070' '#1050#1040#1050#1054#1049' '#1056#1040#1057#1063#1045#1058' - '#1053#1040#1051#1048#1063#1053#1067#1049' '#1048 +
        #1051#1048' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1067#1049
      '110402221=                SELECT 1'
      '110402222=                  FROM KASSA K'
      '110402223=                 WHERE K.KASSA = :KASSA_'
      '110402224=                UNION ALL'
      '110402225=                SELECT 2'
      '110402226=                  FROM KASSA_BEZNAL KB'
      '110402227=                 WHERE KB.KASSA_BEZNAL = :KASSA_'
      '110402228=                 INTO :PAYMENT_TYPE_OLD_;'
      '110402229='
      
        '110402230=                IF (PAYMENT_TYPE_OLD_ = PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110402231=                      PNT_ = '#39#39'010'#39#39';'
      
        '110402232=                      EXECUTE PROCEDURE K_UPD_KASSA(:K' +
        'ASSA_,'
      
        '110402233=                                                    1,' +
        '     -- ACTION_'
      
        '110402234=                                                    :G' +
        '_PRIHOD_RASHOD_,'
      
        '110402235=                                                    :P' +
        'AYMENT_SUMM_,'
      
        '110402236=                                                    :P' +
        'AYMENT_DATE_,'
      
        '110402237=                                                    NU' +
        'LL,   --NOTE_'
      
        '110402238=                                                    NU' +
        'LL,  --ZAKAZ'
      
        '110402239=                                                    :S' +
        'KLAD_PARENT_,'
      
        '110402240=                                                    :P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110402241='
      
        '110402242=                -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040 +
        #1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110402243=                -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040 +
        #1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110402244=                END ELSE IF (PAYMENT_TYPE_OLD_ <> PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110402245=                      PNT_ = '#39#39'011'#39#39';'
      
        '110402246=                      EXECUTE PROCEDURE K_DEL_KASSA(:K' +
        'ASSA_, :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG' +
        ');'
      '110402247=                      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110402248=                        ERR_MSG = PROCNAME||'#39#39' -> PNT_' +
        ' '#39#39'||PNT_||'#39#39' '#39#39'||ERR_MSG;'
      '110402249=                        EXIT;'
      '110402250=                      END'
      '110402251='
      
        '110402252=                      EXECUTE PROCEDURE K_INS_KASSA(1,' +
        '     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110402253=                                                    :G' +
