      '110533834=                          AND O.OTHER = D.OTHER'
      
        '110533835=                          AND D.G_PRODUCT = G.G_PRODUC' +
        'T'
      '110533836=                        UNION ALL'
      
        '110533837=                        SELECT COALESCE(D.SUMM, 0) AMO' +
        'UNT'
      
        '110533838=                          FROM ZAKAZ Z, ZAKAZ_DETAILS ' +
        'D'
      '110533839=                         WHERE Z.ZAKAZ = D.ZAKAZ'
      
        '110533840=                           AND Z.Z_DATE BETWEEN :DATE_' +
        'BEGIN_ AND :DATE_END_'
      
        '110533841=                           AND :G_TOCHKA_ARR_ CONTAINI' +
