        '1102503660=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR POS_TILDA_ - 1);'
      '1102503661=                ELSE'
      
        '1102503662=                  STR_ = SUBSTRING(PAYMENTS_ FROM 1 F' +
        'OR CHAR_LENGTH(PAYMENTS_) - 1);'
      '1102503663='
      
        '1102503664=                EXECUTE PROCEDURE PARSE_FROM_ARRAY(:S' +
        'TR_)'
      
        '1102503665=                    RETURNING_VALUES :KASSA_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '1102503666='
      
