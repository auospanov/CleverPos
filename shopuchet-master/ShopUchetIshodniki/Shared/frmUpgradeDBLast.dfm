        'ur_num),'
      
        '11049271=                     G.barcode         = DECODE(CHAR_LE' +
        'NGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE)'
      '11049272=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '11049273='
      
        '11049274=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39 +
        '||UPPER(TRIM(:ARTICUL_))||'#39#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39#39';'
      '11049275=            END ELSE'
      
        '11049276=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_CL' +
        'IENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- '#1042 +
        #1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '11049277=              ERR_MSG_ = '#39#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39#39'|' +
        '|UPPER(TRIM(:ARTICUL_))||'#39#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39#39'||G_PRODUCT_N' +
        'AME_||'#39#39'.'#39#39';'
      '11049278=        END'
      '11049279=    END ELSE'
      
        '11049280=      EXECUTE PROCEDURE get_free_articul RETURNING_VALU' +
        'ES (:ARTICUL_);'
      '11049281='
      
        '11049282=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052',' +
        ' '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '11049283=    PNT_ = '#39#39'02a'#39#39';'
      
        '11049284=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH(' +
        'TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '11049285=        SELECT G.G_PRODUCT,'
      '11049286=               G.NAME'
      '11049287=          FROM G_PRODUCT G'
      
        '11049288=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_NU' +
        'M_)'
      '11049289=           AND TRIM(G.nomenclatur_num) <> '#39#39#39#39
      '11049290=          INTO :G_PRODUCT_,'
      '11049291=               :G_PRODUCT_NAME_;'
      '11049292='
      
        '11049293=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050#1042 +
        #1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '11049294=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '11049295=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '11049296=              UPDATE G_PRODUCT G'
