      '1106017578=ALTER PROCEDURE G_READ_G_PRIHOD_RASHOD_LIST('
      '1106017579=  ACTION_ TYPE OF COLUMN G_PRIHOD_RASHOD.DO_ACTION)'
      '1106017580=RETURNS ('
      
        '1106017581=  G_PRIHOD_RASHOD TYPE OF COLUMN G_PRIHOD_RASHOD.G_PR' +
        'IHOD_RASHOD,'
      '1106017582=  DO_ACTION VARCHAR(10),'
      '1106017583=  NAME TYPE OF COLUMN G_PRIHOD_RASHOD.NAME)'
      '1106017584=AS'
      '1106017585=begin'
      '1106017586=  FOR'
      
        '1106017587=    select G_PRIHOD_RASHOD, DECODE(DO_ACTION, 0, '#39#1055#1056#1048 +
        #1061#1054#1044#39', 1, '#39#1056#1040#1057#1061#1054#1044#39') DO_ACTION, NAME'
      '1106017588=    from G_PRIHOD_RASHOD'
      '1106017589=    where DO_ACTION = DECODE(:ACTION_,'
      '1106017590=                             NULL, DO_ACTION,'
      '1106017591=                             2, DO_ACTION,'
      '1106017592=                             :ACTION_)'
      '1106017593=      AND G_PRIHOD_RASHOD NOT IN (1,2,3,4)'
      '1106017594=    into :G_PRIHOD_RASHOD, :DO_ACTION, :NAME'
      '1106017595=  DO'
      '1106017596=    suspend;'
      '1106017597=end'
      '1106017598=;'
      '1106017599='
      '1106017600=ALTER PROCEDURE G_READ_RUKOVODITEL_LIST('
      '1106017601=  GLAVBUH_OR_RUKOVODITEL_ INTEGER)'
      '1106017602=RETURNS ('
      '1106017603=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1106017604=  FM TYPE OF COLUMN G_OFFICIAL.FM,'
      '1106017605=  NM TYPE OF COLUMN G_OFFICIAL.NM,'
      '1106017606=  FT TYPE OF COLUMN G_OFFICIAL.FT,'
      '1106017607=  FIO_DOC TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '1106017608=  RNN TYPE OF COLUMN G_OFFICIAL.RNN,'
      '1106017609=  IDN TYPE OF COLUMN G_OFFICIAL.IDN,'
      '1106017610=  DT TYPE OF COLUMN G_OFFICIAL.DT,'
      '1106017611=  G_ID_KIND TYPE OF COLUMN G_OFFICIAL.G_ID_KIND,'
      '1106017612=  ID_NUM TYPE OF COLUMN G_OFFICIAL.ID_NUM,'
      '1106017613=  ID_DATE TYPE OF COLUMN G_OFFICIAL.ID_DATE,'
      '1106017614=  ID_ISSUER TYPE OF COLUMN G_OFFICIAL.ID_ISSUER,'
      
        '1106017615=  G_APPOINTMENT TYPE OF COLUMN G_OFFICIAL.G_APPOINTME' +
        'NT,'
      
        '1106017616=  IS_RUKOVODITEL TYPE OF COLUMN G_OFFICIAL.IS_RUKOVOD' +
        'ITEL,'
      '1106017617=  IS_GLAVBUH TYPE OF COLUMN G_OFFICIAL.IS_GLAVBUH,'
      '1106017618=  APP_NAME TYPE OF COLUMN G_APPOINTMENT.NAME)'
      '1106017619=AS'
      '1106017620=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '1106017621=begin'
      '1106017622=  IF (GLAVBUH_OR_RUKOVODITEL_ = 1) THEN'
      '1106017623=    FOR'
      '1106017624=      SELECT t.G_OFFICIAL,'
      '1106017625=             T.FM,'
      '1106017626=             T.NM,'
      '1106017627=             T.FT,'
      '1106017628=             T.FIO_DOC,'
      '1106017629=             T.RNN,'
      '1106017630=             T.IDN,'
      '1106017631=             T.DT,'
      '1106017632=             T.G_ID_KIND,'
      '1106017633=             T.ID_NUM,'
      '1106017634=             T.ID_DATE,'
      '1106017635=             T.ID_ISSUER,'
      '1106017636=             T.G_APPOINTMENT,'
      '1106017637=             T.IS_RUKOVODITEL,'
      '1106017638=             T.IS_GLAVBUH,'
      '1106017639=             G.NAME'
      '1106017640=        FROM g_OFFICIAL t,'
      '1106017641=             G_APPOINTMENT G'
      '1106017642=       WHERE T.G_APPOINTMENT = G.G_APPOINTMENT'
      '1106017643=         AND T.IS_RUKOVODITEL = 1'
      '1106017644=      INTO :G_OFFICIAL,'
      '1106017645=           :FM,'
      '1106017646=           :NM,'
      '1106017647=           :FT,'
      '1106017648=           :FIO_DOC,'
      '1106017649=           :RNN,'
      '1106017650=           :IDN,'
      '1106017651=           :DT,'
      '1106017652=           :G_ID_KIND,'
      '1106017653=           :ID_NUM,'
      '1106017654=           :ID_DATE,'
      '1106017655=           :ID_ISSUER,'
      '1106017656=           :G_APPOINTMENT,'
      '1106017657=           :IS_RUKOVODITEL,'
      '1106017658=           :IS_GLAVBUH,'
      '1106017659=           :APP_NAME'
      '1106017660=    DO'
      '1106017661=      SUSPEND;'
      '1106017662=  ELSE BEGIN'
      '1106017663=    SELECT COUNT(*)'
      '1106017664=      FROM g_OFFICIAL t'
      '1106017665=     WHERE T.IS_GLAVBUH = 1'
      '1106017666=     INTO :CNT_;'
      '1106017667='
      '1106017668=    IF (CNT_ > 0) THEN'
      '1106017669=      FOR'
      
        '1106017670=          SELECT t.G_OFFICIAL, t.FM, t.NM, t.FT, t.FI' +
        'O_DOC, t.RNN, t.IDN, t.DT, t.G_ID_KIND, t.ID_NUM, t.ID_DATE, t.I' +
        'D_ISSUER, t.G_APPOINTMENT, t.IS_RUKOVODITEL, t.IS_GLAVBUH,'
      '1106017671=                 G.NAME APP_NAME'
      '1106017672=            FROM g_OFFICIAL t,'
      '1106017673=                 G_APPOINTMENT G'
      '1106017674=           WHERE T.G_APPOINTMENT = G.G_APPOINTMENT'
      '1106017675=             AND T.IS_GLAVBUH = 1'
      
        '1106017676=          INTO :G_OFFICIAL, :FM, :NM, :FT, :FIO_DOC, ' +
        ':RNN, :IDN, :DT, :G_ID_KIND, :ID_NUM, :ID_DATE, :ID_ISSUER, :G_A' +
        'PPOINTMENT,'
      
        '1106017677=               :IS_RUKOVODITEL, :IS_GLAVBUH, :APP_NAM' +
        'E'
      '1106017678=      DO'
      '1106017679=        SUSPEND;'
      '1106017680=    ELSE'
      '1106017681=      FOR'
      '1106017682=          SELECT 0,'
      '1106017683=                 '#39#1053#1077' '#1087#1088#1077#1076#1091#1089#1084#1086#1090#1088#1077#1085#39
      '1106017684=            FROM RDB$DATABASE'
      '1106017685=          INTO :G_OFFICIAL, :FIO_DOC'
      '1106017686=      DO'
      '1106017687=        SUSPEND;'
      '1106017688=  END'
      '1106017689=end'
      '1106017690=;'
      '1106017691='
      '1106017692=ALTER PROCEDURE G_TOCHKA_DEL('
      '1106017693=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
      '1106017694=RETURNS ('
      '1106017695=  ERR_CODE INTEGER,'
      '1106017696=  ERR_MSG VARCHAR(1024))'
      '1106017697=AS'
      '1106017698=declare variable KASSA_  TYPE OF COLUMN KASSA.KASSA;'
      '1106017699=BEGIN'
      '1106017700=  IF (G_TOCHKA_ = 1) THEN BEGIN'
      '1106017701=    ERR_CODE = -20500;'
      
        '1106017702=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077#1083#1100#1079#1103' '#1091 +
        #1076#1072#1083#1080#1090#1100' '#1086#1089#1085#1086#1074#1085#1086#1081' '#1089#1082#1083#1072#1076'.'#39') RETURNING_VALUES (:ERR_MSG);'
      '1106017703=    EXIT;'
      '1106017704=  END'
      '1106017705='
      '1106017706=  DELETE FROM KASSA_STATE S'
      '1106017707=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1106017708='
      '1106017709=  DELETE FROM KASSA S'
      '1106017710=  WHERE S.G_TOCHKA = :G_TOCHKA_;'
      '1106017711='
      '1106017712=  FOR SELECT KASSA_BEZNAL'
      '1106017713=        FROM KASSA_BEZNAL'
      '1106017714=       WHERE G_TOCHKA = :G_TOCHKA_'
      '1106017715=        INTO :KASSA_'
      '1106017716=  DO BEGIN'
      
        '1106017717=    EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) RETURNI' +
        'NG_VALUES (:ERR_CODE, :ERR_MSG);'
      '1106017718=    IF (:ERR_CODE <> 0) THEN'
      '1106017719=      EXIT;'
      '1106017720=  END'
      '1106017721='
      '1106017722=  UPDATE G_OFFICIAL O'
      '1106017723=     SET O.G_TOCHKA = NULL'
      '1106017724=   WHERE O.G_TOCHKA = :G_TOCHKA_;'
      '1106017725='
      '1106017726=  DELETE FROM INVOICE I'
      '1106017727=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1106017728=                      FROM ZAKAZ'
      '1106017729=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1106017730='
      '1106017731=  DELETE FROM INVOICE_PAY I'
      '1106017732=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1106017733=                      FROM ZAKAZ'
      '1106017734=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1106017735='
      '1106017736=  DELETE FROM WAYBILL I'
      '1106017737=  WHERE I.ZAKAZ IN (SELECT ZAKAZ'
      '1106017738=                      FROM ZAKAZ'
      '1106017739=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1106017740='
      '1106017741=  DELETE FROM LT_ZAKAZ_REAL R'
      '1106017742=  WHERE R.ZAKAZ_DETAILS IN (SELECT ZD.ZAKAZ_DETAILS'
      
        '1106017743=                              FROM ZAKAZ Z, ZAKAZ_DET' +
        'AILS ZD'
      
        '1106017744=                             WHERE Z.G_TOCHKA = :G_TO' +
        'CHKA_'
      
        '1106017745=                               AND Z.ZAKAZ = ZD.ZAKAZ' +
        ');'
      '1106017746='
      '1106017747=  DELETE FROM ZAKAZ_NA_REAL D'
      
        '1106017748=  WHERE D.ZAKAZ_REAL_PARENT IN (SELECT ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1106017749=                                  FROM ZAKAZ_REAL_PAR' +
        'ENT'
      
        '1106017750=                                 WHERE G_TOCHKA = :G_' +
        'TOCHKA_);'
      '1106017751='
      '1106017752=  DELETE FROM ZAKAZ_REAL_PARENT D'
      '1106017753=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1106017754='
      '1106017755=  DELETE FROM ZAKAZ_DETAILS D'
      '1106017756=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1106017757=                      FROM ZAKAZ'
      '1106017758=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1106017759='
      '1106017760=  DELETE FROM ZAKAZ D'
      '1106017761=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1106017762='
      '1106017763=  DELETE FROM SKLAD D'
      '1106017764=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1106017765='
      '1106017766=  DELETE FROM SKLAD_PARENT D'
      '1106017767=  WHERE D.G_TOCHKA = :G_TOCHKA_;'
      '1106017768='
      '1106017769=  DELETE FROM ZAKAZ_DETAILS D'
      '1106017770=  WHERE D.ZAKAZ IN (SELECT ZAKAZ'
      '1106017771=                      FROM ZAKAZ'
      '1106017772=                     WHERE G_TOCHKA = :G_TOCHKA_);'
      '1106017773='
      '1106017774=  DELETE FROM LT_SKLAD_PRODUCT'
      '1106017775=  WHERE G_TOCHKA = :G_TOCHKA_;'
      '1106017776='
      '1106017777=  DELETE FROM G_TOCHKA'
      '1106017778=  WHERE (G_TOCHKA = :G_TOCHKA_);'
      '1106017779=END'
      '1106017780=;'
      '1106017781='
      '1106017782=ALTER PROCEDURE G_TOCHKA_GET('
      '1106017783=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA)'
