      '1102461826='
      
        '1102461827=      -- '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058' '#1055#1054#1044#1057#1063#1045#1058#1040' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1054#1050' '#1055#1054 +
        ' '#1050#1051#1048#1045#1053#1058#1059', '#1040' '#1058#1040#1050#1046#1045' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042', '#1045#1057#1051#1048' '#1054#1053#1040' '#1053#1045' 0'
      
        '1102461828=      -- '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1041#1054#1053#1059#1057#1054#1042' <> 0, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1054#1055#1051#1040#1058#1040' ' +
        #1041#1054#1053#1059#1057#1040#1052#1048', '#1053#1040#1044#1054' '#1054#1058#1053#1071#1058#1068' '#1054#1058' '#1054#1041#1065#1045#1049' '#1057#1059#1052#1052#1067' '#1053#1040#1050#1054#1055#1051#1045#1053#1048#1049'.'
      
        '1102461829=      -- '#1053#1054' '#1055#1056#1054#1062#1045#1053#1058' '#1054#1058' '#1057#1059#1052#1052#1067' '#1055#1054#1050#1059#1055#1050#1048' '#1055#1056#1048#1041#1040#1042#1051#1071#1070' '#1042' '#1051#1070#1041#1054 +
        #1052' '#1057#1051#1059#1063#1040#1045
      
        '1102461830=      -- 21.05.2019 '#1056#1045#1064#1048#1051' '#1044#1045#1051#1040#1058#1068' '#1069#1058#1054' '#1053#1045' '#1044#1051#1071' "'#1063#1040#1057#1058#1053#1054#1043#1054 +
        ' '#1051#1048#1062#1040'"'
      '1102461831=      IF (G_CLIENT_ <> 10) THEN BEGIN'
      '1102461832=          UPDATE G_DISCONT_CARD D'
      
        '1102461833=          SET D.SUMM = D.SUMM - COALESCE(:SUMM_BONUS_' +
        ', 0) + :SUMM_BONUS_GOT_,'
      '1102461834=              D.SUMM_ALL = D.SUMM_ALL + :SUMM_'
      '1102461835=          WHERE D.G_CLIENT = :G_CLIENT_'
      '1102461836=          RETURNING'
      '1102461837=            D.SUMM_ALL'
      '1102461838=          INTO'
      '1102461839=            :CLIENT_SUMM_ALL_;'
      '1102461840='
      '1102461841=          SELECT G.SKIDKA_VAL, G.BONUS_VAL'
      '1102461842=            FROM G_CLIENT_DISC_VAL_GRID G'
      '1102461843=           WHERE :CLIENT_SUMM_ALL_ > G.SUMM_FROM'
      '1102461844=             AND :CLIENT_SUMM_ALL_ <= G.SUMM_TO'
      '1102461845=          ORDER BY G.SUMM_FROM'
      '1102461846=          ROWS 1 TO 1'
      '1102461847=          INTO :NEW_SKIDKA_VAL_, :NEW_BONUS_VAL_;'
      '1102461848='
      '1102461849=          IF (COALESCE(NEW_SKIDKA_VAL_, 0) > 0) THEN'
      '1102461850=            UPDATE G_CLIENT G'
      '1102461851=               SET G.SKIDKA = :NEW_SKIDKA_VAL_'
      '1102461852=             WHERE G.G_CLIENT = :G_CLIENT_'
      '1102461853=               AND G.SKIDKA < :NEW_SKIDKA_VAL_;'
      '1102461854='
      '1102461855=          IF (COALESCE(NEW_BONUS_VAL_, 0) > 0) THEN'
      '1102461856=            UPDATE G_DISCONT_CARD D'
      '1102461857=               SET D.N_PERCENT = :NEW_BONUS_VAL_'
      '1102461858=             WHERE D.G_CLIENT = :G_CLIENT_'
      '1102461859=               AND D.N_PERCENT < :NEW_BONUS_VAL_;'
      '1102461860=      END'
      '1102461861='
      
        '1102461862=      -- 07.09.2021 '#1057#1050#1056#1048#1055#1071' '#1057#1045#1056#1044#1062#1045' '#1055#1056#1048#1064#1051#1054#1057#1068' '#1069#1058#1054#1058' '#1041#1051#1054#1050' ' +
        #1057' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045#1052' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040' '#1059#1041#1056#1040#1058#1068' - '#1057#1051#1048#1064#1050#1054#1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042', ' +
        #1050#1054#1058#1054#1056#1067#1045' '#1053#1059#1046#1053#1054' '#1054#1058#1056#1040#1041#1040#1058#1067#1042#1040#1058#1068
      
        '1102461863=      -- 1) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1059#1044#1040#1051#1048#1051' '#1053#1040#1063#1048#1057 +
        #1051#1045#1053#1048#1045' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102461864=      -- 2) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1053#1040#1063#1048 +
        #1057#1051#1045#1053#1048#1071' '#1055#1054' '#1047#1040#1056#1055#1051#1040#1058#1045'?'
      
        '1102461865=      -- 3) '#1063#1058#1054' '#1044#1045#1051#1040#1058#1068' '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1048#1047#1052#1045#1053#1048#1051' '#1044#1040#1058#1059 +
        ' '#1055#1056#1054#1044#1040#1046#1048'?'
      
        '1102461866=      -- 4) '#1042#1040#1051#1048#1058#1057#1071' '#1057#1048#1053#1061#1056#1054#1053#1048#1047#1040#1062#1048#1071', '#1045#1057#1051#1048' '#1042' '#1054#1044#1053#1054#1052' '#1052#1045#1057#1058#1045 +
        ' '#1059#1044#1040#1051#1048#1051#1048' '#1055#1056#1054#1044#1040#1046#1059' '#1055#1056#1054#1044#1040#1042#1062#1040', '#1040' '#1042' '#1044#1056#1059#1043#1054#1052' '#1041#1068#1070#1058' '#1053#1054#1042#1067#1045' '#1055#1056#1054#1044#1040#1046#1048
      '1102461867=      -- '#1053#1040#1063#1048#1057#1051#1071#1070' '#1047#1040#1056#1055#1051#1040#1058#1059' '#1055#1056#1054#1044#1040#1042#1062#1059
      '1102461868=      PNT_ = '#39'07'#39';'
      
        '1102461869=      /*IF (G_OFFICIAL_ IS NOT NULL AND DO_NOT_SALES_' +
        'COMM_ = 0 AND IS_SPISANIE_ = 0 AND SALES_COMM_SUMM_ALL_ > 0) THE' +
        'N BEGIN'
      '1102461870=        SELECT S.S_VALUE'
      '1102461871=          FROM SYSTEM_SETUP S'
      '1102461872=         WHERE S.SYSTEM_SETUP = 4'
      '1102461873=          INTO :WHEN_CHARGE_SALES_COMM_;'
      '1102461874='
      '1102461875=        -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1102461876=        IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1102461877=          ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1102461878='
      
        '1102461879=        -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' '#1044#1040#1058#1059 +
        ' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      '1102461880=        ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THEN'
      
        '1102461881=          ACTION_DATE_ZP_ = CURRENT_DATE + (7 - DECOD' +
        'E(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY FROM' +
        ' CURRENT_DATE)));'
      '1102461882='
      '1102461883=        -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1102461884=        ELSE'
      
        '1102461885=           ACTION_DATE_ZP_ = Current_date - EXTRACT(D' +
        'AY FROM current_date) + 32 - EXTRACT(DAY FROM current_date - EXT' +
        'RACT(DAY FROM current_date) + 32);'
      '1102461886='
      '1102461887=        KASSA_ZP_ID_ = NULL;'
      '1102461888=        SELECT K.KASSA, K.SUMM'
      '1102461889=        FROM KASSA K'
      '1102461890=        WHERE K.G_PRIHOD_RASHOD = -1'
      '1102461891=         AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1102461892=         AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1102461893=         AND K.G_TOCHKA = :G_TOCHKA_'
      '1102461894=         INTO :KASSA_ZP_ID_, :SALES_COMM_SUMM_ITER_;'
      '1102461895='
      
        '1102461896=        LOG_BODY_KASSA_ = '#39#1056#1072#1089#1093#1086#1076' '#1080#1079' '#1082#1072#1089#1089#1099' '#1086#1090' "'#39' || E' +
        'XTRACT(day FROM ACTION_DATE_ZP_) || '#39'.'#39' || EXTRACT(month FROM AC' +
        'TION_DATE_ZP_)||'#39'.'#39' || EXTRACT(year FROM ACTION_DATE_ZP_) || '#39'"'#39 +
        ';'
      '1102461897='
      '1102461898=        IF (KASSA_ZP_ID_ IS NULL) THEN BEGIN'
      
        '1102461899=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1102461900=                                          -1,     --:' +
        'G_PRIHOD_RASHOD_,'
      
        '1102461901=                                          :SALES_COMM' +
        '_SUMM_ALL_,'
      
        '1102461902=                                          :ACTION_DAT' +
        'E_ZP_,'
      
        '1102461903=                                          :OFFICIAL_N' +
        'AME_,'
      
        '1102461904=                                          NULL,     -' +
        '-:ZAKAZ_,'
      
        '1102461905=                                          NULL,     -' +
        '-:SKLAD_,'
      '1102461906=                                          1,'
      '1102461907=                                          :G_TOCHKA_,'
      
        '1102461908=                                          :UPLOAD_TO_' +
        'EXT_APP_,'
      
        '1102461909=                                          :G_OFFICIAL' +
        '_'
      
        '1102461910=                                          ) RETURNING' +
        '_VALUES (:KASSA_ZP_ID_, :ERR_CODE, :ERR_MSG);'
      '1102461911=            LOG_KASSA_OPER_TYPE_ = 1;'
      
        '1102461912=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'", '#1089#1091#1084#1084#1072' "'#39' || SALES_COMM_SU' +
        'MM_ALL_ || '#39'".'#39';'
      '1102461913='
      '1102461914=        END ELSE BEGIN'
      
        '1102461915=            SALES_COMM_SUMM_ALL_ = SALES_COMM_SUMM_IT' +
        'ER_ + SALES_COMM_SUMM_ALL_;'
      '1102461916=            LOG_KASSA_OPER_TYPE_ = 2;'
      
        '1102461917=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39', '#1047 +
        #1055' '#1087#1088#1086#1076#1072#1074#1094#1091' "'#39' || OFFICIAL_NAME_ || '#39'". '#1048#1079#1084#1077#1085#1077#1085#1072' '#1089#1091#1084#1084#1072' '#1089' "'#39' || SA' +
        'LES_COMM_SUMM_ITER_ || '#39'"'#39';'
      
        '1102461918=            LOG_BODY_KASSA_ = LOG_BODY_KASSA_ || '#39' '#1085#1072 +
        ' "'#39' || SALES_COMM_SUMM_ALL_ || '#39'".'#39';'
      '1102461919='
      
        '1102461920=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_ZP_I' +
        'D_,'
      
        '1102461921=                                          1,     -- A' +
        'CTION_'
      
        '1102461922=                                          -1,     --:' +
