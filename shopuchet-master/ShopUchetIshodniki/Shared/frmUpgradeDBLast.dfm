      '110202285=  PNT_ = '#39'00'#39';'
      
        '110202286=  IF ((SELECT COUNT(*) FROM KASSA_BEZNAL_STATE K WHERE' +
        ' K.K_DATE = CURRENT_DATE) = 0) THEN BEGIN'
      '110202287=    INSERT INTO KASSA_BEZNAL_STATE'
      
        '110202288=      (KASSA_BEZNAL_STATE, K_DATE, INPUT, DEBET, CREDI' +
        'T, OUTPUT)'
      '110202289=    VALUES'
      
