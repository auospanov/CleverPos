      '1101131709=                      END'
      '1101131710='
      
        '1101131711=                      EXECUTE PROCEDURE K_INS_KASSA(1' +
        ',     -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101131712=                                                    :' +
        'G_PRIHOD_RASHOD_,     -- G_PRIHOD_RASHOD_'
      
        '1101131713=                                                    :' +
