      '110220360='
      '110220361='
      
        '110220362=/*****************************************************' +
        '*************************/'
      
        '110220363=/****                      Altering stored procedures ' +
        '                     ****/'
      
        '110220364=/*****************************************************' +
        '*************************/'
      '110220365=ALTER PROCEDURE GET_SKLAD('
      '110220366=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110220367=  MODE_ INTEGER)'
      '110220368=RETURNS ('
      '110220369=  G_PROD_NAME_ TYPE OF COLUMN G_PRODUCT.NAME,'
      
        '110220370=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110220371=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110220372=  G_CLIENT_ TYPE OF COLUMN SKLAD_PARENT.G_CLIENT,'
      
        '110220373=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD_PARENT.G_PAYMEN' +
        'T_TYPE,'
      '110220374=  OSNOVANIE_ TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '110220375=  NOTE_ TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '110220376=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110220377=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110220378=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY,'
      
        '110220379=  IS_PAYED_ALL_ TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '110220380=  CNT_T_ INTEGER,'
      
        '110220381=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110220382=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110220383=  HAVERIGHT_ INTEGER,'
      '110220384=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110220385=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ','
      
        '110220386=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      '110220387=  ERR_CODE INTEGER,'
      '110220388=  ERR_MSG VARCHAR(1024))'
      '110220389=AS'
      '110220390=/*'
      
        '110220391=MODE_ - '#1085#1091#1078#1077#1085' '#1076#1083#1103' "'#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102'". 0 - '#1086#1073#1099#1095#1085#1086#1077' '#1076#1086#1073#1072#1074#1083 +
        #1077#1085#1080#1077', 1 - '#1076#1086#1073#1072#1074#1080#1090#1100' '#1082#1086#1087#1080#1102
      '110220392=*/'
      
        '110220393=DECLARE VARIABLE G_OFFICIAL_CUR_ TYPE OF COLUMN G_OFFI' +
        'CIAL.G_OFFICIAL;'
      
        '110220394=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.IS_VOZVRAT;'
      '110220395=begin'
      
        '110220396=  -- 21.06.2015 - '#1090#1077#1087#1077#1088#1100' '#1073#1091#1076#1091' '#1079#1072#1087#1088#1072#1096#1080#1074#1072#1090#1100' '#1074#1089#1077#1075#1076#1072' '#1080' '#1087#1088#1080 +
        ' INS '#1080' '#1087#1088#1080' UPD'
      '110220397=  -- '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1087#1088#1080#1093#1086#1076#1086#1074' '#1090#1086#1074#1072#1088#1072', '#1085#1091#1078#1085#1086' '#1076#1083#1103' '#1083#1080#1094#1077#1085#1079#1080#1080
      '110220398=  CNT_T_ = 0;'
      '110220399=  SELECT COUNT(*)'
      '110220400=    FROM (SELECT S.SKLAD'
      '110220401=            FROM SKLAD_PARENT S ROWS 1 TO 100)'
      '110220402=    INTO :CNT_T_;'
      '110220403='
      '110220404=  SELECT'
      '110220405=    T.DATE_RECEIPT,'
      '110220406=    T.TIME_RECEIPT,'
      '110220407=    T.G_CLIENT,'
      '110220408=    T.G_PAYMENT_TYPE,'
      '110220409=    T.G_NONCASH_PAY_TYPE,'
      '110220410=    T.OSNOVANIE,'
      '110220411=    T.NOTE,'
      '110220412=    T.SUMM,'
      '110220413=    T.SUMM_FACT,'
      '110220414=    T.IS_PAYED_ALL'
      '110220415=    ,T.SUMM_CURRENCY'
      '110220416=    ,T.is_expected'
      '110220417=    ,T.IS_VOZVRAT'
      '110220418=  FROM SKLAD_PARENT T'
      '110220419=  WHERE T.SKLAD = :SKLAD_'
      '110220420=  INTO'
      '110220421=    :DATE_RECEIPT_,'
      '110220422=    :TIME_RECEIPT_,'
      '110220423=    :G_CLIENT_,'
      '110220424=    :G_PAYMENT_TYPE_,'
      '110220425=    :G_NONCASH_PAY_TYPE_,'
      '110220426=    :OSNOVANIE_,'
      '110220427=    :NOTE_,'
      '110220428=    :SUMM_,'
      '110220429=    :SUMM_FACT_,'
      '110220430=    :IS_PAYED_ALL_'
      '110220431=    ,:SUMM_CURRENCY_'
      '110220432=    ,:IS_EXPECTED_'
      '110220433=    ,:IS_VOZVRAT_;'
      '110220434='
      '110220435=  -- '#1047#1040#1055#1054#1051#1053#1071#1070' '#1042#1056#1045#1052#1045#1053#1053#1059#1070' '#1058#1040#1041#1051#1048#1062#1059' '#1058#1054#1042#1040#1056#1040#1052#1048
      
        '110220436=  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1057#1054#1047#1044#1040#1053#1048#1045' '#1050#1054#1055#1048#1048', '#1048' '#1042' '#1048#1057#1061#1054#1044#1053#1054#1052' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1045#1057 +
        #1058#1068' '#1052#1040#1056#1050#1048#1056#1054#1042#1040#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' - '#1045#1043#1054' '#1042' '#1050#1054#1055#1048#1070' '#1053#1045' '#1044#1054#1041#1040#1042#1051#1071#1070', '#1055#1059#1057#1058#1068' '#1042#1056#1059#1063#1053#1059#1070' ' +
        #1055#1056#1054#1041#1048#1042#1040#1070#1058
      
        '110220437=  INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT, PRI' +
        'CE, SUMM, NDS, NDS_SUMM, SKLAD_PARENT, PRICE_CURRENCY, SUMM_CURR' +
        'ENCY,'
      
        '110220438=                        charge_ROZN_proc, PRICE_ROZN, ' +
        'charge_opt_proc, PRICE_OPT)'
      
        '110220439=  SELECT DECODE(:MODE_, 0, SKLAD, GEN_ID(GEN_DETAILS_T' +
        'MP, 1)), S.G_PRODUCT, AMOUNT, S.PRICE, SUMM, NDS, NDS_SUMM, :SKL' +
        'AD_,'
      '110220440=         PRICE_CURRENCY, SUMM_CURRENCY,'
      
        '110220441=         DECODE(S.PRICE, 0, 0, ROUND((G.PRICE/S.PRICE ' +
        '- 1)*100, 2)),'
      '110220442=         G.PRICE,'
      
        '110220443=         DECODE(S.PRICE, 0, 0, ROUND((G.volume_price/S' +
        '.PRICE - 1)*100, 2)),'
      '110220444=         G.VOLUME_PRICE'
      '110220445=    FROM SKLAD S, G_PRODUCT G'
      '110220446=   WHERE SKLAD_PARENT = :SKLAD_'
      '110220447=     AND S.G_PRODUCT = G.G_PRODUCT'
      '110220448=     AND ((:MODE_ = 0)'
      '110220449=          OR'
      '110220450=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 0)'
      '110220451=          OR'
      
        '110220452=          (:MODE_ = 1 AND :IS_VOZVRAT_ = 1 AND CHAR_LE' +
        'NGTH(S.MARK_CODE) = 0)'
      '110220453=         )'
      '110220454=   ORDER BY SKLAD;'
      '110220455='
      '110220456=  -- '#1048#1065#1059' '#1055#1054#1055#1059#1058#1053#1059#1070' '#1057#1058#1040#1058#1068#1070' '#1050' '#1047#1040#1050#1040#1047#1059
      '110220457=  SELECT K.G_PRIHOD_RASHOD,'
      '110220458=         K.SUMM'
      
        '110220459=    FROM (select * from KASSA union all select * from ' +
        'kassa_beznal) K'
      '110220460=   WHERE K.SKLAD = :SKLAD_'
      '110220461=     AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '110220462=    INTO :G_PRIHOD_,'
      '110220463=         :SUMM_PRIHOD_;'
      '110220464='
      
        '110220465=  EXECUTE PROCEDURE PARSE_TO_ARRAY(:SKLAD_, 0) RETURNI' +
        'NG_VALUES :PAYMENTS_;'
      '110220466='
      
        '110220467=  -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1047#1040#1050#1040#1047#1040' '#1059#1046#1045' '#1053#1045' '#1057#1045#1043#1054#1044#1053#1071#1064#1053#1071#1071', '#1058#1054' '#1055#1056#1054#1042#1045#1056#1071#1070' ' +
        #1045#1057#1058#1068' '#1051#1048' '#1055#1056#1040#1042#1054' '#1059' '#1063#1045#1051#1054#1042#1045#1050#1040' '#1053#1040' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1045' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1047#1040' '#1055#1056#1054#1064#1051#1067#1045' ' +
        #1044#1040#1058#1067
      
        '110220468=  -- '#1055#1054' '#1059#1052#1054#1051#1063#1040#1053#1048#1070' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042#1057#1045#1043#1044#1040' 1, '#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1041#1059#1044 +
        #1059' '#1055#1056#1054#1057#1058#1054' '#1058#1059#1055#1054' '#1055#1056#1054#1042#1045#1056#1071#1058#1068' '#1050#1040#1046#1044#1067#1049' '#1056#1040#1047' '#1069#1058#1059' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070', '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1054#1053 +
        #1040' 0, '#1058#1054' '#1061#1045#1056
      '110220469=  HaveRight_ = 1;'
      '110220470=  IF (DATE_RECEIPT_ < CURRENT_DATE) THEN BEGIN'
      '110220471=    SELECT ID'
      '110220472=      FROM CUR_PARAMS'
      '110220473=     WHERE CUR_PARAMS = 1'
      '110220474=      INTO :G_OFFICIAL_CUR_;'
      '110220475='
      
        '110220476=    if (G_OFFICIAL_CUR_ IS NULL) then     --'#1077#1089#1083#1080' '#1090#1072#1073#1083#1080 +
        #1094#1072' '#1085#1072' '#1079#1072#1087#1086#1083#1085#1077#1085#1072', '#1079#1085#1072#1095#1080#1090' '#1083#1080#1073#1086' '#1086#1076#1080#1085' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1100' '#1073#1077#1079' '#1087#1072#1088#1086#1083#1103', '#1083#1080#1073#1086' ' +
        #1074#1086#1086#1073#1097#1077' '#1087#1086#1083#1100#1079#1086#1074#1072#1090#1077#1083#1077#1081' '#1085#1077#1090
      '110220477=      HaveRight_ = 1;'
      '110220478=    else'
      
        '110220479=      EXECUTE PROCEDURE GET_OFFIC_HAVE_RIGHT(:G_OFFICI' +
        'AL_CUR_, 101) RETURNING_VALUES(:HaveRight_);'
      '110220480=  END'
      '110220481=end'
      '110220482=;'
      '110220483='
      '110220484=ALTER PROCEDURE INS_SKLAD('
      '110220485=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110220486=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEI' +
        'PT,'
      
        '110220487=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECEI' +
        'PT,'
      '110220488=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      '110220489=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE,'
      '110220490=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '110220491=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '110220492=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD.IS_VOZVRAT,'
      '110220493=  SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '110220494=  SUMM_FACT_ TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '110220495=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_RA' +
        'SHOD,'
      '110220496=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '110220497=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '110220498=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CURR' +
        'ENCY = 0,'
      
        '110220499=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTED' +
        ' = 0,'
      '110220500=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '110220501=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NULL' +
        ','
      '110220502=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '110220503=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = N' +
        'ULL,'
      '110220504=  REC_ID_ TYPE OF COLUMN SKLAD_PARENT.REC_ID = NULL,'
      
        '110220505=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE = NULL)'
      '110220506=RETURNS ('
      '110220507=  SKLAD_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '110220508=  ERR_CODE INTEGER,'
      '110220509=  ERR_MSG VARCHAR(1024))'
      '110220510=AS'
      '110220511=-- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1048#1047' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1067' '#1042' '#1056#1045#1040#1051#1068#1053#1059#1070
      
        '110220512=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1048#1057#1055#1054#1051#1068#1047#1059#1045#1058#1057#1071' '#1050#1040#1050' '#1044#1051#1071' '#1054#1041#1067#1063#1053#1054#1043#1054' '#1055#1056#1048#1061#1054#1044#1040' '#1058#1054#1042 +
        #1040#1056#1040' '#1058#1040#1050' '#1048' '#1044#1051#1071' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040
      '110220513=-- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1058#1040#1050#1046#1045' '#1061#1056#1040#1053#1048#1058#1057#1071' '#1042' '#1058#1040#1041#1051#1048#1062#1045' SKLAD.'
      '110220514=-- 1) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1047#1040#1055#1054#1051#1053#1045#1053' '#1055#1056#1048#1047#1053#1040#1050' IS_VOZVRAT_ = 1'
      
        '110220515=-- 2) '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' - '#1041#1059#1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1059' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055 +
        #1050#1048
      
        '110220516=-- 3) '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT - '#1058#1059#1044#1040' '#1041#1059#1044#1059' ' +
        #1057#1058#1040#1042#1048#1058#1068' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048' '#1053#1040' '#1052#1054#1052#1045#1053#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1044#1051#1071' '#1054#1058#1063#1045#1058#1040' "'#1055#1056#1048#1041#1067#1051#1068'"'
      
        '110220517=--    '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1054#1049' '#1058#1040#1041#1051#1048#1062#1045' '#1069#1058#1048' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1051#1045#1046#1040#1058' '#1042' '#1050#1054#1051#1054#1053#1050 +
        #1040#1061' PRICE, SUMM, '#1057#1044#1045#1051#1040#1053#1054' '#1058#1040#1050', '#1063#1058#1054#1041#1067' '#1057#1054#1061#1056#1040#1053#1048#1051#1057#1071' '#1045#1044#1048#1053#1067#1049' '#1055#1056#1048#1053#1062#1048#1055' '#1057#1054#1047 +
        #1044#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044#1040'.'
      
        '110220518=--    '#1055#1054#1069#1058#1054#1052#1059' '#1042' '#1050#1054#1051#1054#1053#1050#1048' PRICE_VOZVRAT, SUMM_VOZVRAT '#1041#1059 +
        #1044#1059' '#1057#1058#1040#1042#1048#1058#1068' '#1047#1053#1040#1063#1045#1053#1048#1071' '#1048#1047' PRICE, SUMM, '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1045#1053#1053#1054' '#1042' PRICE, SUMM' +
        ' '#1041#1059#1044#1059
      '110220519=--    '#1042#1057#1058#1040#1042#1051#1071#1058#1068' '#1047#1040#1042#1045#1044#1054#1052#1054' '#1042#1067#1063#1048#1057#1051#1045#1053#1053#1067#1045' '#1062#1045#1053#1067' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1048
      
        '110220520=-- 4) '#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070' '#1055#1056#1048#1047 +
        #1053#1040#1050' IS_VOZVRAT_ = 2, '#1055#1056#1048' '#1069#1058#1054' '#1044#1045#1053#1068#1043#1048' '#1057' '#1050#1040#1057#1057#1067' '#1053#1045' '#1042#1067#1063#1048#1058#1040#1070', '#1058'.'#1050'. '#1054#1053#1048 +
        ' '#1058#1059#1044#1040' '#1048' '#1053#1045' '#1055#1054#1057#1058#1059#1055#1040#1051#1048
      '110220521=--'
      
        '110220522=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECTE' +
        'D = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '110220523=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055#1056 +
        #1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' ' +
        #1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      '110220524='
      
        '110220525=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056 +
        #1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '110220526=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD'#39';'
      '110220527=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110220528=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      
        '110220529=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT ' +
        '= 0;'
      '110220530=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '110220531=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '110220532=DECLARE VARIABLE RNDS_ NUMERIC(15,2) = 0;'
      
        '110220533=DECLARE VARIABLE RNDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM = 0;'
      
        '110220534=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD' +
        ' = 0;'
      '110220535=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '110220536=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN G_PRI' +
        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110220537=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110220538=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110220539=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110220540=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110220541=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110220542=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110220543=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110220544=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110220545=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110220546=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110220547=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110220548=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      
        '110220549=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK_' +
        'CODE;'
      
        '110220550=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COST' +
        '_PRICE;'
      '110220551=BEGIN'
      '110220552='
      '110220553=  PNT_ = '#39'00'#39';'
      '110220554=  IS_THIS_LAST_ = 0;'
      '110220555='
      '110220556=  IF (G_TOCHKA_ IS NULL) THEN'
      '110220557=    SELECT ID'
      '110220558=      FROM CUR_PARAMS'
      '110220559=     WHERE CUR_PARAMS = 2'
      '110220560=      INTO :G_TOCHKA_;'
      '110220561='
      '110220562=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110220563=  IF (G_OFFICIAL_ IS NULL) THEN'
      '110220564=      SELECT ID'
      '110220565=        FROM CUR_PARAMS'
      '110220566=       WHERE CUR_PARAMS = 1'
      '110220567=        INTO :G_OFFICIAL_;'
      '110220568='
      '110220569=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110220570=                            DATE_RECEIPT,'
      '110220571=                            TIME_RECEIPT,'
      '110220572=                            G_CLIENT,'
      '110220573=                            G_PAYMENT_TYPE,'
      '110220574=                            OSNOVANIE,'
      '110220575=                            NOTE,'
      '110220576=                            SUMM,'
      '110220577=                            SUMM_FACT,'
      '110220578=                            SUMM_CURRENCY,'
      '110220579=                            IS_PAYED_ALL,'
      '110220580=                            IS_VOZVRAT,'
      '110220581=                            G_TOCHKA'
      '110220582=                            ,G_OFFICIAL'
      '110220583=                            ,IS_EXPECTED'
      '110220584=                            ,G_NONCASH_PAY_TYPE'
      '110220585=                            ,REC_ID)'
      '110220586=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110220587=          :DATE_RECEIPT_,'
      '110220588=          :TIME_RECEIPT_,'
      '110220589=          :G_CLIENT_,'
      '110220590=          :G_PAYMENT_TYPE_,'
      '110220591=          :OSNOVANIE_,'
      '110220592=          :NOTE_,'
      '110220593=          :SUMM_,'
      '110220594=          :SUMM_FACT_,'
      '110220595=          :SUMM_CURRENCY_,'
      
        '110220596=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE ' +
        '0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057 +
        #1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110220597=          :IS_VOZVRAT_,'
      '110220598=          :G_TOCHKA_'
      '110220599=          ,:G_OFFICIAL_'
      '110220600=          ,:IS_EXPECTED_'
      '110220601=          ,:G_NONCASH_PAY_TYPE_'
      '110220602=          ,:REC_ID_)'
      '110220603=  RETURNING'
      '110220604=    SKLAD'
      '110220605=  INTO'
      '110220606=    :SKLAD_;'
      '110220607='
      '110220608=  PNT_ = '#39'01'#39';'
      '110220609=  FOR SELECT SKLAD,'
      '110220610=             T.G_PRODUCT,'
      '110220611=             AMOUNT,'
      '110220612=             T.PRICE,'
      '110220613=             SUMM,'
      '110220614=             NDS,'
      '110220615=             NDS_SUMM'
      '110220616=             ,PRICE_CURRENCY'
      '110220617=             ,SUMM_CURRENCY'
      '110220618=             ,PRICE_ROZN'
      '110220619=             ,GG.PRICE'
      '110220620=             ,T.MARK_CODE'
      '110220621=             ,T.COST_PRICE'
      '110220622=        FROM SKLAD_TMP T,'
      '110220623=             G_PRODUCT GG'
      '110220624=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110220625=      ORDER BY 1'
      '110220626=      INTO :SKLAD_TMP_,'
      '110220627=           :RG_PRODUCT_,'
      '110220628=           :RAMOUNT_,'
      '110220629=           :RPRICE_,'
      '110220630=           :RSUMM_,'
      '110220631=           :RNDS_,'
      '110220632=           :RNDS_SUMM_'
      '110220633=           ,:PRICE_CURRENCY_'
      '110220634=           ,:SUMM_CURRENCY_TMP_'
      '110220635=           ,:SALE_PRICE_'
      '110220636=           ,:SALE_PRICE_CUR_'
      '110220637=           ,:MARK_CODE_'
      '110220638=           ,:COST_PRICE_'
      '110220639=  DO BEGIN'
      '110220640=    IF (IS_VOZVRAT_ IN (0,4)) THEN BEGIN'
      
        '110220641=      -- '#1054#1041#1053#1059#1051#1071#1070' '#1055#1056#1045#1044#1067#1044#1059#1065#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1045' '#1055#1056#1048#1047#1053#1040#1050' IS_LAST, ' +
        #1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053 +
        #1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '110220642=      -- '#1053#1054' '#1054#1041#1053#1059#1051#1071#1070', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' '#1041#1054#1051#1068 +
        #1064#1045' '#1063#1045#1052' '#1059' '#1047#1040#1055#1048#1057#1048' '#1057' IS_LAST = 1'
      '110220643=      IS_THIS_LAST_ = 0;'
      '110220644=      SELECT MAX(SK.DATE_RECEIPT)'
      '110220645=        FROM SKLAD SK'
      '110220646=      WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110220647=         AND SK.IS_LAST = 1'
      '110220648=         AND SK.G_TOCHKA = :G_TOCHKA_'
      '110220649=        INTO :DATE_LAST_;'
      '110220650='
      
        '110220651=      IF ((ROW_COUNT = 0) or (DATE_LAST_ is null) or (' +
        'DATE_RECEIPT_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '110220652=        UPDATE SKLAD SK'
      '110220653=           SET SK.IS_LAST = 0'
      '110220654=         WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110220655=           AND SK.IS_LAST = 1'
      '110220656=           AND SK.G_TOCHKA = :G_TOCHKA_;'
      '110220657='
      '110220658=        IS_THIS_LAST_ = 1;'
      '110220659=      END'
      '110220660=    END'
      '110220661='
      '110220662=    INSERT INTO SKLAD'
      '110220663=    ('
      '110220664=     SKLAD,'
      '110220665=     SKLAD_PARENT,'
      '110220666=     DATE_RECEIPT,'
      '110220667=     G_CLIENT,'
      '110220668=     G_PRODUCT,'
      '110220669=     AMOUNT,'
      '110220670=     PRICE,'
      '110220671=     SUMM,'
      '110220672=     G_PAYMENT_TYPE,'
      '110220673=     OSNOVANIE,'
      '110220674=     NOTE,'
      '110220675=     NDS,'
      '110220676=     NDS_SUMM,'
      '110220677=     IS_LAST,'
      '110220678=     IS_VOZVRAT,'
      '110220679=     G_TOCHKA'
      '110220680=     ,PRICE_CURRENCY'
      '110220681=     ,SUMM_CURRENCY'
      '110220682=     ,MARK_CODE'
      '110220683=     ,COST_PRICE'
      '110220684=    ) VALUES ('
      '110220685=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110220686=     :SKLAD_,'
      '110220687=     :DATE_RECEIPT_,'
      '110220688=     :G_CLIENT_,'
      '110220689=     :RG_PRODUCT_,'
      '110220690=     :RAMOUNT_,'
      '110220691=     :RPRICE_,'
      '110220692=     :RSUMM_,'
      '110220693=     :G_PAYMENT_TYPE_,'
      '110220694=     :OSNOVANIE_,'
      '110220695=     :NOTE_,'
      '110220696=     :RNDS_,'
      '110220697=     :RNDS_SUMM_,'
      
        '110220698=     DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1054#1057 +
        #1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' '#1055#1056#1054 +
        #1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' '#1041#1059#1044 +
        #1045#1058' 0'
      '110220699=     :IS_VOZVRAT_,'
      '110220700=     :G_TOCHKA_'
      '110220701=     ,:PRICE_CURRENCY_'
      '110220702=     ,:SUMM_CURRENCY_TMP_'
      '110220703=     ,:MARK_CODE_'
      '110220704=     ,:COST_PRICE_'
      '110220705=    );'
      '110220706='
      
        '110220707=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110220708=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110220709=        PNT_ = '#39'02'#39';'
      '110220710=        UPDATE LT_SKLAD_PRODUCT L'
      '110220711=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '110220712=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110220713=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110220714=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110220715='
      '110220716=        IF (ROW_COUNT = 0) THEN'
      
        '110220717=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110220718=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :RG' +
        '_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110220719=    END'
      '110220720='
      
        '110220721=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054 +
        #1044#1045
      '110220722=      UPDATE G_PRODUCT G'
      '110220723=         SET G.PRICE = :SALE_PRICE_'
      '110220724=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110220725=  END'
      '110220726=  ----------------------------------------'
      '110220727='
      
        '110220728=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110220729=  PNT_ = '#39'05'#39';'
      
        '110220730=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110220731=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110220732=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110220733=      ELSE'
      '110220734=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110220735='
      
        '110220736=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110220737=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110220738=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110220739=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110220740=                                        :SUMM_FACT_,'
      
        '110220741=                                        :DATE_RECEIPT_' +
        ','
      
        '110220742=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110220743=                                        NULL,   --ZAKA' +
        'Z_'
      '110220744=                                        :SKLAD_,'
      
        '110220745=                                        :G_PAYMENT_TYP' +
        'E_,'
      '110220746=                                        :G_TOCHKA_,'
      
        '110220747=                                        :UPLOAD_TO_EXT' +
        '_APP_'
      
        '110220748=                                        ) RETURNING_VA' +
        'LUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110220749=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110220750=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110220751=            EXIT;'
      '110220752=          END'
      '110220753=      END ELSE BEGIN'
      '110220754=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110220755=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110220756=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110220757=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110220758=            ELSE'
      
        '110220759=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110220760='
      '110220761=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110220762=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110220763='
      
        '110220764=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110220765='
      '110220766=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110220767=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110220768=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110220769=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110220770=                                              :PAYMENT' +
        '_DATE_,'
      
        '110220771=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110220772=                                              NULL,   ' +
        '--ZAKAZ_'
      '110220773=                                              :SKLAD_,'
      
        '110220774=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110220775=                                              :G_TOCHK' +
        'A_,'
      
        '110220776=                                              :UPLOAD_' +
        'TO_EXT_APP_'
      
        '110220777=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110220778=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110220779=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110220780=                  EXIT;'
      '110220781=                END'
      '110220782=            END'
      '110220783=          END'
      '110220784=      END'
      '110220785=  END'
      '110220786='
      '110220787=  DELETE FROM SKLAD_TMP;'
      '110220788='
      
        '110220789=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110220790=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110220791=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110220792=                                  G_PRIHOD_,'
      '110220793=                                  :SUMM_PRIHOD_,'
      '110220794=                                  :DATE_RECEIPT_,'
      
        '110220795=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110220796=                                  NULL,   --:ZAKAZ_,'
      '110220797=                                  :SKLAD_,'
      '110220798=                                  :G_PAYMENT_TYPE_,'
      '110220799=                                  :G_TOCHKA_,'
      '110220800=                                  :UPLOAD_TO_EXT_APP_'
      
        '110220801=                                  ) RETURNING_VALUES (' +
        ':KASSA_, :ERR_CODE, :ERR_MSG);'
      '110220802=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110220803=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110220804=      EXIT;'
      '110220805=    END'
      '110220806=  END'
      '110220807='
      
        '110220808=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO_' +
        'EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1043 +
        #1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '110220809=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, 1' +
        ', 2)) THEN'
      
        '110220810=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER, IS_LOADED_MOB)'
      '110220811=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '110220812=            2,'
      '110220813=            :SKLAD_,'
      '110220814=            1,'
      
        '110220815=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ' +
        'ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' ' +
        #1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '110220816=           );'
      '110220817='
      '110220818=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
        '110220819=  EXECUTE PROCEDURE LOG_OPER_INS(:IS_VOZVRAT_, :USER_I' +
        'D_, :SKLAD_, :DATE_RECEIPT_, 1, :SUMM_, :LOG_BODY_, 1);'
      '110220820=END'
      '110220821=;'
      '110220822='
      '110220823=ALTER PROCEDURE P_REP_ZAKAZI_LIST('
      '110220824=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      
        '110220825=  G_CLIENT_CAT_ TYPE OF COLUMN G_CLIENT.G_CLIENT_PAREN' +
        'T,'
      '110220826=  G_OFFICIAL_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110220827=  DATE_BEGIN_ DATE,'
      '110220828=  DATE_END_ DATE,'
      '110220829=  TIME_BEGIN_ TIME,'
      '110220830=  TIME_END_ TIME,'
      '110220831=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '110220832=  G_PRODUCT_ BLOB SUB_TYPE 1,'
      '110220833=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1,'
      '110220834=  G_SUPPLIER_ TYPE OF COLUMN G_CLIENT.G_CLIENT = 0)'
      '110220835=RETURNS ('
      '110220836=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '110220837=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '110220838=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '110220839=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT' +
        '_TENGE,'
      
        '110220840=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS.DISCOUNT_' +
        'SUMM,'
      '110220841=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110220842=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '110220843=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110220844=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110220845=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '110220846=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR' +
        '_NUM,'
      '110220847=  BRAND TYPE OF COLUMN G_PRODUCT.BRAND,'
      '110220848=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110220849=  Z_DATE BLOB SUB_TYPE 1,'
      '110220850=  ROW INTEGER,'
      '110220851=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '110220852=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '110220853=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110220854=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110220855=  OFFICIAL_NAME TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110220856=  ERR_CODE INTEGER,'
      '110220857=  ERR_MSG VARCHAR(1024))'
      '110220858=AS'
      
        '110220859=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_ZAKAZI_' +
        'LIST'#39';'
      '110220860=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '110220861=DECLARE VARIABLE Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME;'
      
        '110220862=DECLARE VARIABLE Z_DATE_ BLOB SUB_TYPE 1 SEGMENT SIZE ' +
        '80;'
      
        '110220863=DECLARE VARIABLE ARTICUL_ TYPE OF COLUMN G_PRODUCT.ART' +
        'ICUL;'
      
        '110220864=DECLARE VARIABLE BARCODE_ TYPE OF COLUMN G_PRODUCT.BAR' +
        'CODE;'
      
        '110220865=DECLARE VARIABLE NOMENCLATUR_NUM_ TYPE OF COLUMN G_PRO' +
        'DUCT.BARCODE;'
      
        '110220866=DECLARE VARIABLE BRAND_ TYPE OF COLUMN G_PRODUCT.BRAND' +
        ';'
      
        '110220867=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.' +
        'AMOUNT;'
      
        '110220868=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.' +
        'NAME;'
      
        '110220869=DECLARE VARIABLE PAYMENT_NAME_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.NAME;'
      
        '110220870=DECLARE VARIABLE CLIENT_NAME_ TYPE OF COLUMN G_CLIENT.' +
        'NAME;'
      
        '110220871=DECLARE VARIABLE PRICE_ TYPE OF COLUMN ZAKAZ_DETAILS.P' +
        'RICE;'
      
        '110220872=DECLARE VARIABLE SUMM_ TYPE OF COLUMN ZAKAZ_DETAILS.SU' +
        'MM = 0;'
      
        '110220873=DECLARE VARIABLE SUMM_ROLL_ TYPE OF COLUMN ZAKAZ_DETAI' +
        'LS.SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110220874=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ_DETAIL' +
        'S.SUMM = 0; /* '#1048#1058#1054#1043' */'
      
        '110220875=DECLARE VARIABLE DISCOUNT_TENGE_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS.DISCOUNT_TENGE;'
      
        '110220876=DECLARE VARIABLE DISCOUNT_SUMM_ TYPE OF COLUMN ZAKAZ_D' +
        'ETAILS.DISCOUNT_SUMM = 0;'
      
        '110220877=DECLARE VARIABLE DISCOUNT_SUMM_ROLL_ TYPE OF COLUMN ZA' +
        'KAZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1055#1056#1054#1052#1045#1046#1059#1058#1054#1063#1053#1067#1049' */'
      
        '110220878=DECLARE VARIABLE DISCOUNT_SUMM_ALL_ TYPE OF COLUMN ZAK' +
        'AZ_DETAILS.DISCOUNT_SUMM = 0; /* '#1048#1058#1054#1043' */'
      '110220879=DECLARE VARIABLE PATH_ TYPE OF COLUMN P_REP_TREE.PATH;'
      
        '110220880=DECLARE VARIABLE LAST_PATH_ TYPE OF COLUMN P_REP_TREE.' +
        'PATH = '#39#39';'
      '110220881=DECLARE VARIABLE I INTEGER = 1;'
      '110220882=DECLARE VARIABLE NOTE_ TYPE OF COLUMN ZAKAZ.NOTE;'
      
        '110220883=DECLARE VARIABLE UNIT_NAME_ TYPE OF COLUMN G_UNIT.NAME' +
        ';'
      
        '110220884=DECLARE VARIABLE SUMM_CASH_ TYPE OF COLUMN ZAKAZ.SUMM_' +
        'CASH;'
      
        '110220885=DECLARE VARIABLE SUMM_NONCASH_ TYPE OF COLUMN ZAKAZ.SU' +
        'MM_NONCASH;'
      
        '110220886=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFIC' +
        'IAL.FIO_DOC;'
      '110220887=BEGIN'
      '110220888=  DELETE FROM P_REP_ZAKAZI_LIST_TABLE;'
      '110220889=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, -2);'
      '110220890='
      
        '110220891=  FOR SELECT lpad(extract(day from Z.Z_DATE),2,'#39'0'#39') ||' +
        ' '#39'.'#39' || lpad(extract(month from Z.Z_DATE),2,'#39'0'#39') || '#39'.'#39' || extra' +
        'ct(year from Z.Z_DATE),'
      '110220892=             Z.Z_TIME,'
      '110220893=             GP.ARTICUL,'
      '110220894=             GP.BARCODE,'
      '110220895=             GP.NOMENCLATUR_NUM,'
      '110220896=             GP.BRAND,'
      '110220897=             GP.NAME,'
      '110220898=             ZD.AMOUNT,'
      '110220899=             ZD.PRICE,'
      '110220900=             ZD.DISCOUNT_TENGE,'
      '110220901=             ZD.SUMM,'
      '110220902=             ZD.DISCOUNT_SUMM,'
      '110220903=             GC.NAME,'
      '110220904=             P.NAME,'
      '110220905=             TR.PATH,'
      '110220906=             Z.NOTE,'
      '110220907=             U.SHORT_NAME,'
      '110220908=             Z.SUMM_CASH,'
      '110220909=             Z.SUMM_NONCASH,'
      
        '110220910=             COALESCE(O.FM, '#39#39')||'#39' '#39'||COALESCE(O.NM, '#39 +
        #39')'
      
        '110220911=      FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL O ON Z.G' +
        '_OFFICIAL = O.G_OFFICIAL,'
      '110220912=           ZAKAZ_DETAILS ZD,'
      '110220913=           G_CLIENT GC,'
      '110220914=           G_PAYMENT_TYPE P,'
      '110220915=           G_PRODUCT GP,'
      '110220916=           G_UNIT U,'
      '110220917=           P_REP_TREE TR'
      
        '110220918=     WHERE :G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||Z.G_TOCHKA||' +
        #39'-'#39
      '110220919=       AND Z.IS_SPISANIE IN (0,2)'
      '110220920=       AND Z.IS_RESERVE = 0'
      '110220921=       AND Z.ZAKAZ = ZD.ZAKAZ'
      '110220922=       AND Z.G_CLIENT = GC.G_CLIENT'
      '110220923=       AND Z.G_PAYMENT_TYPE = P.G_PAYMENT_TYPE'
      '110220924=       AND ZD.G_PRODUCT = GP.G_PRODUCT'
      '110220925=       AND GP.G_PRODUCT_PAR = TR.G_PRODUCT'
      '110220926=       AND GP.G_UNIT = U.G_UNIT'
      '110220927=       -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110220928=       AND Z.G_CLIENT = COALESCE(:G_CLIENT_, COALESCE(' +
        'Z.G_CLIENT, 1))'
      
        '110220929=       AND GC.G_CLIENT_PARENT = COALESCE(:G_CLIENT_CAT' +
        '_, GC.G_CLIENT_PARENT)'
      
        '110220930=       AND COALESCE(Z.G_OFFICIAL, 1) = COALESCE(:G_OFF' +
        'ICIAL_, COALESCE(Z.G_OFFICIAL, 1))'
      
        '110220931=       AND ((Z.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_ AND :TIME_BEGIN_ IS NULL)'
      '110220932=            OR'
      
        '110220933=            ((Z.Z_DATE + Z.Z_TIME) BETWEEN (:DATE_BEGI' +
        'N_ + :TIME_BEGIN_) AND (:DATE_END_ + :TIME_END_) AND :TIME_BEGIN' +
        '_ IS NOT NULL)'
      '110220934=           )/*'
      
        '110220935=       AND ((Z.Z_TIME BETWEEN :TIME_BEGIN_ AND :TIME_E' +
        'ND_ AND :TIME_BEGIN_ IS NOT NULL)'
      '110220936=            OR'
      '110220937=            :TIME_BEGIN_ IS NULL)*/'
      
        '110220938=       AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||TR.G_PRODUCT' +
        '||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '110220939=             OR'
      '110220940=             (:G_CATEGORY_ IS NULL)'
      '110220941=           )'
      
        '110220942=       AND ((:G_PRODUCT_ CONTAINING '#39'~'#39'||GP.G_PRODUCT|' +
        '|'#39'~'#39' AND :G_PRODUCT_ IS NOT NULL)'
      '110220943=             OR'
      '110220944=            (:G_PRODUCT_ IS NULL)'
      '110220945=           )'
      '110220946=       AND ((EXISTS (SELECT 1'
      '110220947=                       FROM SKLAD S'
      '110220948=                      WHERE S.G_CLIENT = :G_SUPPLIER_'
      '110220949=                        AND S.G_PRODUCT = GP.G_PRODUCT'
      
        '110220950=                        AND :G_TOCHKA_ARR_ CONTAINING ' +
        #39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_SUPPLIER_, 0) <> 0)'
      '110220951=              OR'
      '110220952=              COALESCE(:G_SUPPLIER_, 0) = 0)'
      '110220953='
      '110220954=     ORDER BY TR.PATH, Z.Z_DATE, Z.Z_TIME, GP.NAME'
      
        '110220955=     INTO :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCODE_, :N' +
        'OMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,'
      
        '110220956=          :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_, :' +
        'CLIENT_NAME_, :PAYMENT_NAME_, :PATH_, :NOTE_, :UNIT_NAME_,'
      '110220957=          :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAME_'
      '110220958=  DO BEGIN'
      '110220959=    IF (LAST_PATH_ <> PATH_) THEN BEGIN'
      
        '110220960=        IF (LAST_PATH_ <> '#39#39') THEN BEGIN   -- '#1045#1057#1051#1048' '#1069#1058#1054 +
        ' '#1053#1045' '#1057#1040#1052#1040#1071' '#1055#1045#1056#1042#1040#1071' '#1042#1057#1058#1040#1042#1050#1040' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      '110220961=            --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110220962=            INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "' +
        'DATE", SUMM, DISCOUNT_SUMM, ROW)'
      
        '110220963=            VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_' +
        ', :DISCOUNT_SUMM_ROLL_, 1);'
      '110220964='
      '110220965=            -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110220966=            SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110220967=            DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + ' +
        'DISCOUNT_SUMM_ROLL_;'
      '110220968=            SUMM_ROLL_ = 0;'
      '110220969=            DISCOUNT_SUMM_ROLL_ = 0;'
      '110220970=            I = I + 1;'
      '110220971=        END'
      '110220972='
      '110220973=        --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1043#1054#1051#1054#1042#1054#1050' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110220974=        INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE' +
        '", ROW)'
      '110220975=        VALUES (:I, :PATH_, 1);'
      '110220976=        I = I + 1;'
      '110220977=    END'
      '110220978='
      
        '110220979=    INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", "' +
        'TIME", ARTICUL, BARCODE, NOMENCLATUR_NUM, BRAND, NAME, AMOUNT, P' +
        'RICE, DISCOUNT, SUMM,'
      
        '110220980=                                         DISCOUNT_SUMM' +
        ', CLIENT_NAME, PAYMENT_TYPE, NOTE, ROW, UNIT_NAME,'
      
        '110220981=                                         SUMM_CASH, SU' +
        'MM_NONCASH, OFFICIAL_NAME)'
      
        '110220982=    VALUES (:I, :Z_DATE_, :Z_TIME_, :ARTICUL_, :BARCOD' +
        'E_, :NOMENCLATUR_NUM_, :BRAND_, :TOVAR_NAME_, :AMOUNT_, :PRICE_,' +
        ' :DISCOUNT_TENGE_, :SUMM_, :DISCOUNT_SUMM_,'
      
        '110220983=            :CLIENT_NAME_, :PAYMENT_NAME_, :NOTE_, 0, ' +
        ':UNIT_NAME_,'
      
        '110220984=            :SUMM_CASH_, :SUMM_NONCASH_, :OFFICIAL_NAM' +
        'E_);'
      '110220985='
      '110220986=    I = I + 1;'
      '110220987=    SUMM_ROLL_ = SUMM_ROLL_ + SUMM_;'
      
        '110220988=    DISCOUNT_SUMM_ROLL_ = DISCOUNT_SUMM_ROLL_ + DISCOU' +
        'NT_SUMM_;'
      '110220989=    LAST_PATH_ = PATH_;'
      '110220990=  END'
      '110220991='
      '110220992=  --'#1042#1057#1058#1040#1042#1051#1071#1070' '#1048#1058#1054#1043#1054' '#1050#1040#1058#1045#1043#1054#1056#1048#1048
      
        '110220993=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SUM' +
        'M, DISCOUNT_SUMM, ROW)'
      
        '110220994=  VALUES (:I, '#39#1048#1090#1086#1075#1086' '#1087#1086' '#1075#1088#1091#1087#1087#1077#39', :SUMM_ROLL_, :DISCOUN' +
        'T_SUMM_ROLL_, 1);'
      '110220995='
      '110220996=  -- '#1058#1054#1058#1040#1051' '#1057#1059#1052#1052#1067
      '110220997=  SUMM_ALL_ = SUMM_ALL_ + SUMM_ROLL_;'
      
        '110220998=  DISCOUNT_SUMM_ALL_ = DISCOUNT_SUMM_ALL_ + DISCOUNT_S' +
        'UMM_ROLL_;'
      '110220999='
      
        '1102201000=  INSERT INTO P_REP_ZAKAZI_LIST_TABLE (ID, "DATE", SU' +
        'MM, DISCOUNT_SUMM, ROW)'
      
        '1102201001=  VALUES (:I, '#39#1048#1090#1086#1075#1086#39', :SUMM_ALL_, :DISCOUNT_SUMM_ALL' +
        '_, 2);'
      '1102201002='
      
        '1102201003=  FOR SELECT "DATE", "TIME", ARTICUL, BARCODE, NOMENC' +
        'LATUR_NUM, BRAND, NAME, AMOUNT, PRICE, DISCOUNT, SUMM, DISCOUNT_' +
        'SUMM, CLIENT_NAME,'
      
        '1102201004=             PAYMENT_TYPE, ROW, NOTE, UNIT_NAME, SUMM' +
        '_CASH, SUMM_NONCASH, OFFICIAL_NAME'
      '1102201005=      FROM P_REP_ZAKAZI_LIST_TABLE'
      
        '1102201006=      INTO :Z_DATE, :Z_TIME, :ARTICUL, :BARCODE, :NOM' +
        'ENCLATUR_NUM, :BRAND, :TOVAR_NAME,'
      
        '1102201007=           :AMOUNT, :PRICE, :DISCOUNT_TENGE, :SUMM, :' +
        'DISCOUNT_SUMM, :CLIENT_NAME, :PAYMENT_NAME, :ROW,'
      
        '1102201008=           :NOTE, :UNIT_NAME, :SUMM_CASH, :SUMM_NONCA' +
        'SH, :OFFICIAL_NAME'
      '1102201009=  do suspend;'
      '1102201010='
      '1102201011=WHEN ANY DO BEGIN'
      '1102201012=    Err_code = -20500;'
      
        '1102201013=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055 +
        #1056#1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1054#1058#1063#1045#1058#1040' '#1054' '#1055#1056#1054#1044#1040#1046#1040#1061'!'#39') RETURNING_VALUES (:ERR_MSG)' +
        ';'
      
        '1102201014=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_M' +
        'SG;'
      '1102201015=  END'
      '1102201016=end'
      '1102201017=;'
      '1102201018='
      '1102201019=ALTER PROCEDURE UPD_SKLAD('
      '1102201020=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102201021=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1102201022=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102201023=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102201024=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102201025=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102201026=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102201027=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102201028=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1102201029=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102201030=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102201031=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102201032=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102201033=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102201034=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102201035=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102201036=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102201037=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL)'
      '1102201038=RETURNS ('
      '1102201039=  ERR_CODE INTEGER,'
      '1102201040=  ERR_MSG VARCHAR(1024))'
      '1102201041=AS'
      
        '1102201042=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1102201043=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      
        '1102201044=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057 +
        #1056#1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102201045=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1102201046=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102201047=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1102201048=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1102201049=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1102201050=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1102201051=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1102201052=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1102201053=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1102201054=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1102201055=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102201056=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1102201057=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102201058=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1102201059=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1102201060=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1102201061=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1102201062=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102201063=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102201064=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102201065=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102201066=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102201067=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102201068=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1102201069=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1102201070=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102201071=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102201072=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1102201073=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1102201074=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1102201075=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1102201076=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      '1102201077=BEGIN'
      '1102201078='
      '1102201079=  IS_THIS_LAST_ = 0;'
      '1102201080='
      '1102201081=  SELECT S.G_TOCHKA,'
      '1102201082=         S.IS_VOZVRAT,'
      '1102201083=         S.G_PAYMENT_TYPE'
      '1102201084=         ,S.is_expected'
      '1102201085=    FROM SKLAD_parent S'
      '1102201086=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1102201087=    INTO :G_TOCHKA_,'
      '1102201088=         :IS_VOZVRAT_,'
      '1102201089=         :G_PAYMENT_TYPE_OLD_'
      '1102201090=         ,:IS_EXPECTED_OLD_;'
      '1102201091='
      '1102201092=  PNT_ = '#39'00'#39';'
      '1102201093=  UPDATE SKLAD_PARENT'
      '1102201094=  SET'
      
        '1102201095=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1102201096=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1102201097=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1102201098=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1102201099=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102201100=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102201101=   SUMM      = :SUMM_,'
      '1102201102=   SUMM_FACT = :SUMM_FACT_,'
      '1102201103=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1102201104=   IS_PAYED_ALL  = CASE WHEN :SUMM_ <= :SUMM_FACT_ TH' +
        'EN 1 ELSE 0 END,  --IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, ' +
        '1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050 +
        #1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102201105=   IS_EXPECTED  = :IS_EXPECTED_'
      '1102201106=   ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102201107=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1102201108='
      
        '1102201109=  ---------------------------------------------------' +
        '----------'
      
        '1102201110=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1102201111=  PNT_ = '#39'02'#39';'
      '1102201112=  FOR SELECT SKLAD'
      '1102201113=        FROM SKLAD S'
      '1102201114=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1102201115=         AND NOT EXISTS (SELECT 1'
      '1102201116=                           FROM SKLAD_TMP T'
      '1102201117=                        WHERE T.SKLAD = S.SKLAD)'
      '1102201118=  INTO :SKLAD_'
      '1102201119=  DO BEGIN'
      
        '1102201120=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1102201121=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102201122=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102201123=      EXIT;'
      '1102201124=    END'
      '1102201125=  END'
      '1102201126='
      
        '1102201127=  ---------------------------------------------------' +
        '----------'
      
        '1102201128=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1102201129=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1102201130=  PNT_ = '#39'03'#39';'
      '1102201131=  FOR SELECT S.SKLAD,'
      '1102201132=             S.G_PRODUCT,'
      '1102201133=             S.AMOUNT,'
      '1102201134=             S.PRICE,'
      '1102201135=             S.SUMM,'
      '1102201136=             S.NDS,'
      '1102201137=             S.NDS_SUMM,'
      '1102201138=             T.SKLAD,'
      '1102201139=             T.AMOUNT,'
      '1102201140=             T.IS_LAST,'
      '1102201141=             T.DATE_RECEIPT'
      '1102201142=             ,S.PRICE_CURRENCY'
      '1102201143=             ,S.SUMM_CURRENCY'
      '1102201144=             ,S.PRICE_ROZN'
      
        '1102201145=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1102201146=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1102201147=  INTO :SKLAD_,'
      '1102201148=       :G_PRODUCT_,'
      '1102201149=       :AMOUNT_,'
      '1102201150=       :PRICE_,'
      '1102201151=       :SUMM_ONE_,'
      '1102201152=       :NDS_,'
      '1102201153=       :NDS_SUMM_,'
      '1102201154=       :SKLAD_OLD_,'
      '1102201155=       :AMOUNT_OLD_,'
      '1102201156=       :IS_THIS_LAST_,'
      '1102201157=       :DATE_RECEIPT_OLD_'
      '1102201158=       ,:PRICE_CURRENCY_'
      '1102201159=       ,:SUMM_CURRENCY_TMP_'
      '1102201160=       ,:SALE_PRICE_'
      '1102201161=       ,:SALE_PRICE_CUR_'
      '1102201162=  DO BEGIN'
      
        '1102201163=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102201164=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1102201165=        PNT_ = '#39'04'#39';'
      
        '1102201166=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1102201167=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1102201168=                          ,PRICE_CURRENCY'
      '1102201169=                          ,SUMM_CURRENCY)'
      
        '1102201170=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1102201171=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102201172=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1102201173=               ,:PRICE_CURRENCY_'
      '1102201174=               ,:SUMM_CURRENCY_TMP_'
      '1102201175=               );'
      '1102201176='
      
        '1102201177=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1102201178=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1102201179=            UPDATE LT_SKLAD_PRODUCT L'
      '1102201180=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102201181=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102201182=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102201183=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102201184='
      '1102201185=            IF (ROW_COUNT = 0) THEN'
      
        '1102201186=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102201187=        END'
      '1102201188='
      
        '1102201189=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102201190=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
