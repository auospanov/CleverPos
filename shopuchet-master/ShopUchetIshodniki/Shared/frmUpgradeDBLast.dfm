      '1101825474='
      '1101825475=                    PNT_ = '#39'06'#39';'
      
        '1101825476=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
        'YPE_) THEN'
      
        '1101825477=                        EXECUTE PROCEDURE K_UPD_KASSA' +
        '(:KASSA_,'
      
        '1101825478=                                                     ' +
        ' 0,     -- ACTION_'
      
        '1101825479=                                                     ' +
        ' 1,     --:G_PRIHOD_RASHOD_,'
      
        '1101825480=                                                     ' +
        ' :PAYMENT_SUMM_,'
      
        '1101825481=                                                     ' +
        ' :PAYMENT_DATE_,'
      
        '1101825482=                                                     ' +
