        '110752480=          -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071 +
        ' '#1055#1056#1048#1061#1054#1044#1040
      '110752481=          PNT_ = '#39'025'#39';'
      '110752482=          FOR SELECT SKLAD,'
