      '110621121=                    END'
      '110621122=                END'
      '110621123=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621124=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110621125=                  EXIT;'
      '110621126=                END'
      '110621127='
      
        '110621128=                KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39 +
        ';   -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '110621129=            END'
      '110621130='
      
        '110621131=            -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048 +
        ' '#1051#1048' '#1059#1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '110621132=            FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '110621133=                FROM KASSA K'
      '110621134=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110621135=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K' +
        '.KASSA||'#39'~'#39
      '110621136=                UNION'
      '110621137=                SELECT KASSA, 1 PAYMENT_TYPE'
      '110621138=                  FROM KASSA K'
      '110621139=                 WHERE K.ZAKAZ = :ZAKAZ_'
      '110621140=                   AND K.SUMM = 0'
      '110621141=                UNION'
      
        '110621142=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110621143=                FROM KASSA_BEZNAL K'
      '110621144=                WHERE K.ZAKAZ = :ZAKAZ_'
      
        '110621145=                 AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K' +
        '.KASSA_BEZNAL||'#39'~'#39
      '110621146=                UNION'
      
        '110621147=                SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_T' +
        'YPE'
      '110621148=                FROM KASSA_BEZNAL K'
      '110621149=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110621150=                 AND K.SUMM = 0'
      '110621151=                INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '110621152=            DO BEGIN'
      '110621153=                PNT_ = '#39'08'#39';'
      
        '110621154=                EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_,' +
        ' :PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '110621155=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621156=                    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||P' +
        'NT_||'#39' '#39'||ERR_MSG;'
      '110621157=                    EXIT;'
      '110621158=                END'
      '110621159=            END'
      '110621160='
      
        '110621161=            --========================================' +
        '========================='
      '110621162=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '110621163=            --========================================' +
        '========================='
      
        '110621164=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058 +
        #1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '110621165=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055 +
        #1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '110621166=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054 +
        ' '#1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '110621167=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '110621168=                SELECT K.KASSA'
      '110621169=                FROM KASSA K'
      '110621170=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110621171=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110621172=                 INTO :KASSA_POP_;'
      '110621173=            ELSE'
      '110621174=                SELECT K.KASSA_BEZNAL'
      '110621175=                FROM KASSA_BEZNAL K'
      '110621176=                WHERE K.ZAKAZ = :ZAKAZ_'
      '110621177=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '110621178=                 INTO :KASSA_POP_;'
      '110621179='
      
        '110621180=            IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_)' +
        ' THEN BEGIN'
      '110621181=              PNT_ = '#39'09'#39';'
      
        '110621182=              -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1059#1070' '#1057#1058#1040#1058#1068#1070', '#1045#1057#1051#1048' '#1054 +
        #1053#1040' '#1045#1057#1058#1068
      '110621183=              IF (KASSA_POP_ IS NOT NULL) THEN'
      
        '110621184=                    EXECUTE PROCEDURE K_UPD_KASSA(:KAS' +
        'SA_POP_,'
      
        '110621185=                                                  0,  ' +
        '   -- ACTION_'
      
        '110621186=                                                  :G_P' +
        'RIHOD_,'
      
        '110621187=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110621188=                                                  :Z_D' +
        'ATE_,'
      
        '110621189=                                                  NULL' +
        ',   --NOTE_'
      
        '110621190=                                                  :ZAK' +
        'AZ_,'
      
        '110621191=                                                  NULL' +
        ','
      
        '110621192=                                                  :G_P' +
        'AYMENT_TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '110621193=              -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '110621194=              ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      '110621195=                    PNT_ = '#39'10'#39';'
      
        '110621196=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_'
      
        '110621197=                                                  :G_P' +
        'RIHOD_,'
      
        '110621198=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110621199=                                                  :Z_D' +
        'ATE_,'
      
        '110621200=                                                  NULL' +
        ',   --NOTE_ => :NOTE_,'
      
        '110621201=                                                  :ZAK' +
        'AZ_,'
      
        '110621202=                                                  NULL' +
        ','
      
        '110621203=                                                  :G_P' +
        'AYMENT_TYPE_,'
      
        '110621204=                                                  :G_T' +
        'OCHKA_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110621205=              END'
      '110621206='
      
        '110621207=            -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', ' +
        #1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '110621208=            -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', ' +
        #1053#1040#1044#1054' '#1059#1044#1040#1051#1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '110621209=            END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYM' +
        'ENT_TYPE_) THEN BEGIN'
      '110621210=                PNT_ = '#39'11'#39';'
      '110621211=                IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110621212=                    EXECUTE PROCEDURE K_DEL_KASSA(:KAS' +
        'SA_POP_, :G_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR' +
        '_MSG);'
      '110621213=                    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110621214=                      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'|' +
        '|PNT_||'#39' '#39'||ERR_MSG;'
      '110621215=                      EXIT;'
      '110621216=                    END'
      '110621217='
      
        '110621218=                    EXECUTE PROCEDURE K_INS_KASSA(0,  ' +
        '   -- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110621219=                                                  :G_P' +
        'RIHOD_,'
      
        '110621220=                                                  :SUM' +
        'M_PRIHOD_,'
      
        '110621221=                                                  :Z_D' +
        'ATE_,'
      
        '110621222=                                                  NULL' +
