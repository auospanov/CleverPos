        ' '#1044#1040#1058#1040' '#1055#1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '11075778=            UPDATE SKLAD SK'
      '11075779=               SET SK.IS_LAST = 0'
      '11075780=             WHERE SK.G_PRODUCT = :G_PRODUCT'
      '11075781=               AND SK.IS_LAST = 1'
      '11075782=               AND SK.G_TOCHKA = :G_CLIENT_;'
      '11075783='
      '11075784=            IS_THIS_LAST_ = 1;'
      '11075785=        END */'
      '11075786='
      '11075787='
      '11075788=        INSERT INTO SKLAD'
      '11075789=        ('
      '11075790=         SKLAD,'
      '11075791=         SKLAD_PARENT,'
      '11075792=         DATE_RECEIPT,'
      '11075793=         G_CLIENT,'
      '11075794=         G_PRODUCT,'
      '11075795=         AMOUNT,'
      '11075796=         PRICE,'
      '11075797=         SUMM,'
      '11075798=         G_PAYMENT_TYPE,'
      '11075799=         OSNOVANIE,'
      '11075800=         NOTE,'
      '11075801=         NDS,'
      '11075802=         NDS_SUMM,'
      '11075803=         IS_LAST,'
      '11075804=         IS_VOZVRAT,'
      '11075805=         G_TOCHKA'
      '11075806=        ) VALUES ('
      '11075807=         GEN_ID(GEN_DETAILS_TMP, 1),'
      '11075808=         :SKLAD_,'
      '11075809=         :Z_DATE_,'
      '11075810=         :G_TOCHKA_,'
      '11075811=         :G_PRODUCT,'
      '11075812=         :AMOUNT,'
      '11075813=         :PRICE,'
      '11075814=         :SUMM,'
      '11075815=         :G_PAYMENT_TYPE_,'
      '11075816=         :OSNOVANIE_,'
      '11075817=         :NOTE_,'
      '11075818=         0,  --:RNDS_,'
      '11075819=         0,  --:RNDS_SUMM_,'
      
        '11075820=         DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058#1054' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047#1040' ' +
        #1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044#1040' ' +
        #1041#1059#1044#1045#1058' 0'
      '11075821=         3,  --:IS_VOZVRAT_,'
      '11075822=         :G_CLIENT_'
      '11075823=        );'
      '11075824='
      
        '11075825=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' '#1045 +
        #1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '11075826=        PNT_ = '#39'02'#39';'
      '11075827=        UPDATE LT_SKLAD_PRODUCT L'
      '11075828=           SET L.AMOUNT = L.AMOUNT + :AMOUNT'
      '11075829=         WHERE L.G_PRODUCT = :G_PRODUCT'
      '11075830=           AND L.G_TOCHKA = :G_CLIENT_;'
      '11075831='
      '11075832=        IF (ROW_COUNT = 0) THEN'
      
        '11075833=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUC' +
        'T, G_PRODUCT, AMOUNT, G_TOCHKA) VALUES (GEN_ID(GEN_LT_SKLAD_PROD' +
        'UCT, 1), :G_PRODUCT, :AMOUNT, :G_CLIENT_);'
      '11075834=      END'
      '11075835=  END'
      '11075836='
      '11075837=  DELETE FROM ZAKAZ_DETAILS_TMP;'
      '11075838='
      
        '11075839=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050#1054 +
        #1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      '11075840=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '11075841=    EXECUTE PROCEDURE K_INS_KASSA(0,     -- ACTION_ => ' +
        ':ACTION_'
      '11075842=                                  G_PRIHOD_,'
      '11075843=                                  :SUMM_PRIHOD_,'
      '11075844=                                  :Z_DATE_,'
      
        '11075845=                                  NULL,   --NOTE_ => :N' +
        'OTE_,'
