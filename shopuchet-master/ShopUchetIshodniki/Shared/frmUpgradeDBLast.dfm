        'HOD_RASHOD.G_PRIHOD_RASHOD;'
      
        '110249364=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PAREN' +
        'T.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '110249365=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042#1050 +
        #1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '110249366=DECLARE VARIABLE PAYMENT_ID_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      
        '110249367=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.AC' +
        'TION_DATE;'
      
        '110249368=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.SU' +
        'MM;'
      
        '110249369=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYMEN' +
        'T_TYPE.G_PAYMENT_TYPE;'
      '110249370=DECLARE VARIABLE STR_ VARCHAR(500);'
      '110249371=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '110249372=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD.' +
        'PRICE_CURRENCY;'
      
        '110249373=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SKL' +
        'AD.SUMM_CURRENCY;'
      
        '110249374=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP.' +
        'PRICE_ROZN;'
      
        '110249375=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PROD' +
        'UCT.PRICE;'
      
        '110249376=DECLARE VARIABLE MARK_CODE_ TYPE OF COLUMN SKLAD.MARK_' +
        'CODE;'
      
        '110249377=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.COST' +
        '_PRICE;'
      
        '110249378=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM_BONUS_GOT;'
      
        '110249379=DECLARE VARIABLE SUMM_BONUS_ TYPE OF COLUMN G_DISCONT_' +
        'CARD.SUMM;'
      
        '110249380=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DISC' +
        'ONT_CARD.SUMM;'
      
        '110249381=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.S' +
        'UMM;'
      '110249382=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '110249383=DECLARE VARIABLE CNT_ INTEGER = 0;'
      '110249384=BEGIN'
      '110249385='
      '110249386=  PNT_ = '#39'00'#39';'
      '110249387=  IS_THIS_LAST_ = 0;'
      '110249388='
      '110249389=  IF (G_TOCHKA_ IS NULL) THEN'
      '110249390=    SELECT ID'
      '110249391=      FROM CUR_PARAMS'
      '110249392=     WHERE CUR_PARAMS = 2'
      '110249393=      INTO :G_TOCHKA_;'
      '110249394='
      '110249395=  IF (G_TOCHKA_ IS NULL) THEN BEGIN'
      '110249396=    ERR_CODE = -20500;'
      
        '110249397=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1053#1077' '#1091#1082#1072#1079#1072#1085 +
        ' '#1089#1082#1083#1072#1076' '#1087#1088#1086#1076#1072#1078#1080'! '#1054#1073#1088#1072#1090#1080#1090#1077#1089#1100' '#1082' '#1088#1072#1079#1088#1072#1073#1086#1090#1095#1080#1082#1091'!'#39') RETURNING_VALUES (:' +
        'ERR_MSG);'
      '110249398=    ERR_MSG = PROCNAME||'#39' -> PNT_ 00 '#39'||ERR_MSG;'
      '110249399=    EXIT;'
      '110249400=  END'
      '110249401='
      
        '110249402=  -- '#1045#1057#1051#1048' '#1054#1060#1054#1056#1052#1051#1071#1045#1058#1057#1071' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1059#1046#1053#1054' '#1059#1063#1045#1057#1058#1068', '#1063#1058#1054#1041#1067' ' +
        #1042#1054#1047#1042#1056#1040#1058#1054#1042' '#1055#1054' '#1053#1045#1052#1059' '#1053#1045' '#1041#1067#1051#1054' '#1041#1054#1051#1068#1064#1045', '#1063#1045#1052' '#1058#1054#1042#1040#1056#1054#1042' '#1042' '#1057#1040#1052#1054#1049' '#1055#1056#1054#1044#1040#1046#1045
      '110249403=  PNT_ = '#39'00.1'#39';'
      
        '110249404=  IF (IS_VOZVRAT_ = 1 AND COALESCE(ZAKAZ_, 0) <> 0) TH' +
        'EN BEGIN'
      '110249405=     SELECT COUNT(A.G_PRODUCT)'
      '110249406=        FROM ('
      '110249407=            SELECT G_PRODUCT, SUM(AMOUNT) ORDERED'
      '110249408=            FROM ZAKAZ_DETAILS ZD'
      '110249409=            WHERE ZD.ZAKAZ = :ZAKAZ_'
      '110249410=            GROUP BY ZD.G_PRODUCT'
      '110249411=        ) A'
      '110249412=        INNER JOIN ('
      '110249413=            SELECT G_PRODUCT, SUM(RETURNED) RETURNED'
      '110249414=              FROM ('
      
        '110249415=                    SELECT G_PRODUCT, SUM(AMOUNT) RETU' +
        'RNED'
      '110249416=                    FROM SKLAD O, SKLAD_PARENT SP'
      '110249417=                    WHERE SP.ZAKAZ = :ZAKAZ_'
      '110249418=                      AND SP.SKLAD = O.SKLAD_PARENT'
      '110249419=                      AND SP.IS_VOZVRAT = 1'
      '110249420=                    GROUP BY O.G_PRODUCT'
      '110249421=                    UNION ALL'
      
        '110249422=                    SELECT T.G_PRODUCT, SUM(T.AMOUNT) ' +
        'RETURNED'
      '110249423=                    FROM SKLAD_TMP T'
      '110249424=                    GROUP BY T.G_PRODUCT'
      '110249425=                    )'
      '110249426=            GROUP BY G_PRODUCT'
      '110249427=        ) B ON B.G_PRODUCT = A.G_PRODUCT'
      '110249428=        WHERE ORDERED < RETURNED'
      '110249429=     INTO :CNT_;'
      '110249430='
      '110249431=     IF (CNT_ > 0) THEN BEGIN'
      '110249432=         ERR_CODE = -20500;'
      
        '110249433=         EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1042#1099' '#1087 +
        #1099#1090#1072#1077#1090#1077#1089#1100' '#1074#1077#1088#1085#1091#1090#1100' '#1090#1086#1074#1072#1088#1086#1074' '#1073#1086#1083#1100#1096#1077', '#1095#1077#1084' '#1074' '#1089#1072#1084#1086#1081' '#1087#1088#1086#1076#1072#1078#1077'!'
      
        '110249434='#1055#1088#1086#1074#1077#1088#1100#1090#1077' '#1082#1086#1083#1080#1095#1077#1089#1090#1074#1086' '#1074#1086#1079#1074#1088#1072#1097#1072#1077#1084#1086#1075#1086' '#1090#1086#1074#1072#1088#1072', '#1072' '#1090#1072#1082#1078#1077' '#1085#1077' ' +
        #1073#1099#1083#1080' '#1091#1078#1077' '#1086#1092#1086#1088#1084#1083#1077#1085#1099' '#1074#1086#1079#1074#1088#1072#1090#1099' '#1087#1086' '#1076#1072#1085#1085#1086#1084#1091' '#1095#1077#1082#1091'!'#39') RETURNING_VALUES ' +
        '(:ERR_MSG);'
      
        '110249435=         ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '110249436=         EXIT;'
      '110249437=     END'
      '110249438=  END'
      '110249439='
      '110249440=  --'#1053#1040#1061#1054#1046#1059' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071
      '110249441=  IF (G_OFFICIAL_ IS NULL) THEN'
      '110249442=      SELECT ID'
      '110249443=        FROM CUR_PARAMS'
      '110249444=       WHERE CUR_PARAMS = 1'
      '110249445=        INTO :G_OFFICIAL_;'
      '110249446='
      '110249447=  INSERT INTO SKLAD_PARENT (SKLAD,'
      '110249448=                            DATE_RECEIPT,'
      '110249449=                            TIME_RECEIPT,'
      '110249450=                            G_CLIENT,'
      '110249451=                            G_PAYMENT_TYPE,'
      '110249452=                            OSNOVANIE,'
      '110249453=                            NOTE,'
      '110249454=                            SUMM,'
      '110249455=                            SUMM_FACT,'
      '110249456=                            SUMM_CURRENCY,'
      '110249457=                            IS_PAYED_ALL,'
      '110249458=                            IS_VOZVRAT,'
      '110249459=                            G_TOCHKA'
      '110249460=                            ,G_OFFICIAL'
      '110249461=                            ,IS_EXPECTED'
      '110249462=                            ,G_NONCASH_PAY_TYPE'
      '110249463=                            ,REC_ID'
      '110249464=                            ,ZAKAZ)'
      '110249465=  VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110249466=          :DATE_RECEIPT_,'
      '110249467=          :TIME_RECEIPT_,'
      '110249468=          :G_CLIENT_,'
      '110249469=          :G_PAYMENT_TYPE_,'
      '110249470=          :OSNOVANIE_,'
      '110249471=          :NOTE_,'
      '110249472=          :SUMM_,'
      '110249473=          :SUMM_FACT_,'
      '110249474=          :SUMM_CURRENCY_,'
      
        '110249475=          CASE WHEN :SUMM_ <= :SUMM_FACT_ THEN 1 ELSE ' +
        '0 END,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057 +
        #1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '110249476=          :IS_VOZVRAT_,'
      '110249477=          :G_TOCHKA_'
      '110249478=          ,:G_OFFICIAL_'
      '110249479=          ,:IS_EXPECTED_'
      '110249480=          ,:G_NONCASH_PAY_TYPE_'
      '110249481=          ,:REC_ID_'
      '110249482=          ,:ZAKAZ_)'
      '110249483=  RETURNING'
      '110249484=    SKLAD'
      '110249485=  INTO'
      '110249486=    :SKLAD_;'
      '110249487='
      '110249488=  PNT_ = '#39'01'#39';'
      '110249489=  FOR SELECT SKLAD,'
      '110249490=             T.G_PRODUCT,'
      '110249491=             AMOUNT,'
      '110249492=             T.PRICE,'
      '110249493=             SUMM,'
      '110249494=             NDS,'
      '110249495=             NDS_SUMM'
      '110249496=             ,PRICE_CURRENCY'
      '110249497=             ,SUMM_CURRENCY'
      '110249498=             ,PRICE_ROZN'
      '110249499=             ,GG.PRICE'
      '110249500=             ,T.MARK_CODE'
      '110249501=             ,T.COST_PRICE'
      '110249502=        FROM SKLAD_TMP T,'
      '110249503=             G_PRODUCT GG'
      '110249504=       WHERE T.G_PRODUCT = GG.G_PRODUCT'
      '110249505=      ORDER BY 1'
      '110249506=      INTO :SKLAD_TMP_,'
      '110249507=           :RG_PRODUCT_,'
      '110249508=           :RAMOUNT_,'
      '110249509=           :RPRICE_,'
      '110249510=           :RSUMM_,'
      '110249511=           :RNDS_,'
      '110249512=           :RNDS_SUMM_'
      '110249513=           ,:PRICE_CURRENCY_'
      '110249514=           ,:SUMM_CURRENCY_TMP_'
      '110249515=           ,:SALE_PRICE_'
      '110249516=           ,:SALE_PRICE_CUR_'
      '110249517=           ,:MARK_CODE_'
      '110249518=           ,:COST_PRICE_'
      '110249519=  DO BEGIN'
      '110249520=    INSERT INTO SKLAD'
      '110249521=    ('
      '110249522=     SKLAD,'
      '110249523=     SKLAD_PARENT,'
      '110249524=     DATE_RECEIPT,'
      '110249525=     G_CLIENT,'
      '110249526=     G_PRODUCT,'
      '110249527=     AMOUNT,'
      '110249528=     PRICE,'
      '110249529=     SUMM,'
      '110249530=     G_PAYMENT_TYPE,'
      '110249531=     OSNOVANIE,'
      '110249532=     NOTE,'
      '110249533=     NDS,'
      '110249534=     NDS_SUMM,'
      '110249535=     IS_LAST,'
      '110249536=     IS_VOZVRAT,'
      '110249537=     G_TOCHKA'
      '110249538=     ,PRICE_CURRENCY'
      '110249539=     ,SUMM_CURRENCY'
      '110249540=     ,MARK_CODE'
      '110249541=     ,COST_PRICE'
      '110249542=    ) VALUES ('
      '110249543=     :SKLAD_TMP_,   --GEN_ID(GEN_SKLAD, 1),'
      '110249544=     :SKLAD_,'
      '110249545=     :DATE_RECEIPT_,'
      '110249546=     :G_CLIENT_,'
      '110249547=     :RG_PRODUCT_,'
      '110249548=     :RAMOUNT_,'
      '110249549=     :RPRICE_,'
      '110249550=     :RSUMM_,'
      '110249551=     :G_PAYMENT_TYPE_,'
      '110249552=     :OSNOVANIE_,'
      '110249553=     :NOTE_,'
      '110249554=     COALESCE(:RNDS_, 0),'
      '110249555=     COALESCE(:RNDS_SUMM_, 0),'
      
        '110249556=     0, --DECODE(:IS_THIS_LAST_, 1, 1, 0),  -- '#1045#1057#1051#1048' '#1069#1058 +
        #1054' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1057#1058#1040#1042#1050#1040', '#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' 1, '#1040' '#1058#1054' '#1042#1044#1056#1059#1043' '#1051#1045#1055#1071#1058' '#1055#1054#1057#1058#1040#1042#1050#1059' '#1047 +
        #1040' '#1055#1056#1054#1064#1051#1059#1070' '#1044#1040#1058#1059', '#1042#1054#1047#1042#1056#1040#1058' '#1052#1045#1053#1071' '#1053#1045' '#1042#1054#1051#1053#1059#1045#1058', '#1058'.'#1050'. '#1055#1056#1048' '#1042#1054#1047#1042#1056#1040#1058#1045' '#1042#1057#1045#1043#1044 +
        #1040' '#1041#1059#1044#1045#1058' 0'
      '110249557=     :IS_VOZVRAT_,'
      '110249558=     :G_TOCHKA_'
      '110249559=     ,:PRICE_CURRENCY_'
      '110249560=     ,:SUMM_CURRENCY_TMP_'
      '110249561=     ,:MARK_CODE_'
      '110249562=     ,:COST_PRICE_'
      '110249563=    );'
      '110249564='
      
        '110249565=    IF (IS_EXPECTED_ = 0) THEN BEGIN          -- '#1058#1054#1051#1068#1050 +
        #1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      
        '110249566=        -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045#1053#1071#1070' ' +
        #1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042#1050#1059
      '110249567=        PNT_ = '#39'02'#39';'
      '110249568=        UPDATE LT_SKLAD_PRODUCT L'
      '110249569=           SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      '110249570=               L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_APP_'
      '110249571=         WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110249572=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '110249573='
      '110249574=        IF (ROW_COUNT = 0) THEN'
      
        '110249575=          INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODU' +
        'CT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110249576=          VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1), :RG' +
        '_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110249577=    END'
      '110249578='
      
        '110249579=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT_' +
        ' = 0 AND SALE_PRICE_ <> 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054 +
        #1044#1045
      '110249580=      UPDATE G_PRODUCT G'
      '110249581=         SET G.PRICE = :SALE_PRICE_'
      '110249582=       WHERE G.G_PRODUCT = :RG_PRODUCT_;'
      '110249583=  END'
      '110249584=  ----------------------------------------'
      '110249585='
      
        '110249586=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1050#1040#1057#1057#1059' '#1054' '#1056#1040#1057#1061#1054#1044#1045' '#1044#1045#1053#1045#1046#1053#1067#1061' '#1057#1056#1045#1044#1057#1058 +
        #1042', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070', ' +
        #1048' '#1053#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1058#1054#1042#1040#1056#1054#1042' '#1053#1040' '#1044#1056#1059#1043#1054#1049' '#1057#1050#1051#1040#1044
      '110249587=  PNT_ = '#39'05'#39';'
      
        '110249588=  IF (IS_VOZVRAT_ IN (0,1) AND SUMM_FACT_ > 0) THEN BE' +
        'GIN'
      '110249589=      IF (:IS_VOZVRAT_ = 1) THEN'
      '110249590=        G_PRIHOD_RASHOD_ = 3;  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040
      '110249591=      ELSE'
      '110249592=        G_PRIHOD_RASHOD_ = 2;  -- '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      '110249593='
      
        '110249594=      -- '#1044#1051#1071' '#1044#1056#1059#1043#1048#1061' '#1055#1056#1054#1062#1045#1044#1059#1056' '#1057#1044#1045#1051#1040#1070' '#1055#1054' '#1057#1058#1040#1056#1054#1052#1059' '#1055#1059#1058#1048', '#1063 +
        #1058#1054#1041#1067' '#1058#1040#1052' '#1053#1045' '#1043#1054#1056#1054#1044#1048#1058#1068' '#1052#1040#1057#1057#1048#1042' PAYMENTS_, '#1048#1051#1048' '#1045#1057#1051#1048' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1054#1044#1048#1053 +
        ' '#1055#1051#1040#1058#1045#1046
      '110249595=      IF (PAYMENTS_ IS NULL) THEN BEGIN'
      
        '110249596=          EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTI' +
        'ON_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110249597=                                        :G_PRIHOD_RASH' +
        'OD_,'
      '110249598=                                        :SUMM_FACT_,'
      
        '110249599=                                        :DATE_RECEIPT_' +
        ','
      
        '110249600=                                        NULL,   --NOTE' +
        '_ => :NOTE_,'
      
        '110249601=                                        NULL,   --ZAKA' +
        'Z_'
      '110249602=                                        :SKLAD_,'
      
        '110249603=                                        :G_PAYMENT_TYP' +
        'E_,'
      '110249604=                                        :G_TOCHKA_,'
      
        '110249605=                                        :UPLOAD_TO_EXT' +
        '_APP_'
      
        '110249606=                                        ) RETURNING_VA' +
        'LUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110249607=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110249608=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110249609=            EXIT;'
      '110249610=          END'
      '110249611=      END ELSE BEGIN'
      '110249612=          WHILE (CHAR_LENGTH(PAYMENTS_) > 0) DO BEGIN'
      '110249613=            POS_TILDA_ = POSITION('#39'~'#39' IN PAYMENTS_);'
      
        '110249614=            IF (CHAR_LENGTH(PAYMENTS_) <> POS_TILDA_) ' +
        'THEN'
      
        '110249615=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR PO' +
        'S_TILDA_ - 1);'
      '110249616=            ELSE'
      
        '110249617=              STR_ = SUBSTRING(PAYMENTS_ FROM 1 FOR CH' +
        'AR_LENGTH(PAYMENTS_) - 1);'
      '110249618='
      '110249619=            EXECUTE PROCEDURE PARSE_FROM_ARRAY(:STR_)'
      
        '110249620=                RETURNING_VALUES :PAYMENT_ID_, :PAYMEN' +
        'T_DATE_, :PAYMENT_SUMM_, :PAYMENT_TYPE_;'
      '110249621='
      
        '110249622=            PAYMENTS_   = SUBSTRING(PAYMENTS_ FROM (PO' +
        'SITION('#39'~'#39' IN PAYMENTS_)) + 1);'
      '110249623='
      '110249624=            IF (PAYMENT_SUMM_ > 0) THEN BEGIN'
      
        '110249625=                EXECUTE PROCEDURE K_INS_KASSA(1,     -' +
        '- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110249626=                                              :G_PRIHO' +
        'D_RASHOD_,'
      
        '110249627=                                              :PAYMENT' +
        '_SUMM_,'
      
        '110249628=                                              :PAYMENT' +
        '_DATE_,'
      
        '110249629=                                              NULL,   ' +
        '--NOTE_ => :NOTE_,'
      
        '110249630=                                              NULL,   ' +
        '--ZAKAZ_'
      '110249631=                                              :SKLAD_,'
      
        '110249632=                                              :PAYMENT' +
        '_TYPE_,'
      
        '110249633=                                              :G_TOCHK' +
        'A_,'
      
        '110249634=                                              :UPLOAD_' +
        'TO_EXT_APP_'
      
        '110249635=                                              ) RETURN' +
        'ING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110249636=                IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110249637=                  ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT' +
        '_||'#39' '#39'||ERR_MSG;'
      '110249638=                  EXIT;'
      '110249639=                END'
      '110249640=            END'
      '110249641=          END'
      '110249642=      END'
      '110249643=  END'
      '110249644='
      '110249645=  -- 28.04.2022'
      
        '110249646=  -- '#1045#1057#1051#1048' '#1054#1060#1054#1056#1052#1051#1071#1045#1058#1057#1071' '#1042#1054#1047#1042#1056#1040#1058' '#1053#1040' '#1054#1057#1053#1054#1042#1045' '#1055#1056#1054#1044#1040#1046#1048', '#1058#1054' '#1053#1040 +
        #1044#1054' '#1054#1058#1053#1048#1052#1040#1058#1068' '#1057#1059#1052#1052#1059' '#1041#1054#1053#1059#1057#1054#1042' '#1047#1040' '#1069#1058#1059' '#1055#1056#1054#1044#1040#1046#1059
      
        '110249647=  -- '#1055#1056#1048#1063#1045#1052' '#1042#1045#1056#1053#1059#1058#1068' '#1048#1047' '#1042#1057#1045#1049' '#1055#1056#1054#1044#1040#1046#1048' '#1052#1054#1043#1059#1058' '#1058#1054#1051#1068#1050#1054' '#1063#1040#1057#1058#1068 +
        ', '#1055#1054#1069#1058#1054#1052#1059' '#1053#1040#1044#1054' '#1057#1063#1048#1058#1040#1058#1068
      
        '110249648=  -- '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1050' '#1052#1054#1052#1045#1053#1058#1059' '#1042#1054#1047#1042#1056#1040#1058#1040' '#1052#1054#1046#1045#1058' '#1048#1047#1052#1045#1053#1048#1058#1068#1057 +
        #1071', '#1055#1054#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1042#1067#1063#1048#1057#1051#1071#1058#1068' '#1050#1040#1050#1054#1049' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1058#1054#1043#1044#1040' '#1041#1067#1051
      
        '110249649=  -- '#1055#1054' '#1061#1054#1056#1054#1064#1045#1052#1059' '#1045#1065#1045' '#1053#1040#1044#1054' '#1057#1056#1040#1047#1059' '#1055#1045#1056#1045#1057#1063#1048#1058#1067#1042#1040#1058#1068' '#1045#1043#1054' '#1055#1056#1054#1062 +
        #1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1042' '#1057#1054#1054#1058#1042#1045#1058#1057#1058#1042#1048#1048' '#1057' '#1051#1045#1057#1045#1053#1050#1054#1049', '#1053#1054' '#1055#1054#1050#1040' '#1053#1045' '#1041#1059#1044#1059' '#1069#1058#1054#1043#1054' '#1044#1045#1051#1040 +
        #1058#1068
      
        '110249650=  IF (ZAKAZ_ IS NOT NULL AND IS_VOZVRAT_ = 1) THEN BEG' +
        'IN'
      '110249651=     /*SELECT Z.SUMM_BONUS_GOT,'
      '110249652=            Z.SUMM'
      '110249653=       FROM ZAKAZ Z'
      '110249654=      WHERE ZAKAZ = :ZAKAZ_'
      '110249655=       INTO :SUMM_BONUS_GOT_,'
      '110249656=            :ZAKAZ_SUMM_;'
      '110249657='
      '110249658=     IF (ZAKAZ_SUMM_ = SUMM_) THEN'
      '110249659=       BONUS_TO_MINUS_ = SUMM_BONUS_GOT_;'
      '110249660='
      '110249661=     ELSE BEGIN'
      
        '110249662=       BONUS_PERCENT_ = SUMM_BONUS_GOT_ / ZAKAZ_SUMM_;' +
        '  -- '#1053#1040#1061#1054#1046#1059' '#1055#1056#1054#1062#1045#1053#1058' '#1041#1054#1053#1059#1057#1040' '#1053#1040' '#1058#1054#1058' '#1052#1054#1052#1045#1053#1058
      '110249663='
      
        '110249664=       BONUS_TO_MINUS_ = ROUND(SUMM_ * BONUS_PERCENT_,' +
        ' 2);   -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056#1040#1058#1040
      '110249665=     END'
      '110249666='
      '110249667=     UPDATE G_DISCONT_CARD G'
      '110249668=        SET G.SUMM = G.SUMM - :BONUS_TO_MINUS_,'
      '110249669=            G.SUMM_ALL = G.SUMM_ALL - :SUMM_'
      '110249670=      WHERE G.G_CLIENT = :G_CLIENT_;*/'
      '110249671='
      '110249672=    SELECT G.SUMM'
      '110249673=      FROM G_DISCONT_CARD G'
      '110249674=     WHERE G.G_CLIENT = :G_CLIENT_'
      '110249675=      INTO :SUMM_BONUS_;'
      '110249676='
      '110249677=    IF (:SUMM_BONUS_ > 0) THEN BEGIN'
      '110249678=       SELECT SUM(Z.SUMM_BONUS_GOT),'
      '110249679=              SUM(Z.SUMM)'
      '110249680=         FROM ZAKAZ Z'
      '110249681=        WHERE Z.G_CLIENT = :G_CLIENT_'
      '110249682=         INTO :SUMM_BONUS_GOT_,'
      '110249683=              :SUMM_ALL_;'
      '110249684='
      
        '110249685=       SELECT ROUND( SUM(SP.SUMM * (Z.SUMM_BONUS_GOT /' +
        ' Z.SUMM)), 2),  -- '#1057#1050#1054#1051#1068#1050#1054' '#1041#1054#1053#1059#1057#1054#1042' '#1042#1067#1061#1054#1044#1048#1058' '#1055#1054' '#1050#1040#1046#1044#1054#1049' '#1057#1059#1052#1052#1045' '#1042#1054#1047#1042#1056 +
        #1040#1058#1040
      '110249686=              SUM(SP.SUMM)'
      '110249687=         FROM SKLAD_PARENT SP, ZAKAZ Z'
      '110249688=        WHERE SP.G_CLIENT = :G_CLIENT_'
      '110249689=          AND SP.ZAKAZ = Z.ZAKAZ'
      '110249690=         INTO :BONUS_TO_MINUS_,'
      '110249691=              :SUMM_TO_MINUS_;'
      '110249692='
      '110249693=       UPDATE G_DISCONT_CARD G'
      
        '110249694=          SET G.SUMM = :SUMM_BONUS_GOT_ - :BONUS_TO_MI' +
        'NUS_,'
      
        '110249695=              G.SUMM_ALL = :SUMM_ALL_ - :SUMM_TO_MINUS' +
        '_'
      '110249696=        WHERE G.G_CLIENT = :G_CLIENT_;'
      '110249697=    END'
      '110249698=  END'
      '110249699='
      '110249700=  DELETE FROM SKLAD_TMP;'
      '110249701='
      
        '110249702=  -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1040', '#1053#1040#1055#1056#1048#1052#1045#1056' '#1059#1055#1040#1050 +
        #1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1056#1040#1057#1061#1054#1044' '#1048#1047' '#1050#1040#1057#1057#1067
      '110249703=  IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '110249704=    EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION_ =>' +
        ' :ACTION_'
      '110249705=                                  G_PRIHOD_,'
      '110249706=                                  :SUMM_PRIHOD_,'
      '110249707=                                  :DATE_RECEIPT_,'
      
        '110249708=                                  NULL,   --NOTE_ => :' +
        'NOTE_,'
      '110249709=                                  NULL,   --:ZAKAZ_,'
      '110249710=                                  :SKLAD_,'
      '110249711=                                  :G_PAYMENT_TYPE_,'
      '110249712=                                  :G_TOCHKA_,'
      '110249713=                                  :UPLOAD_TO_EXT_APP_'
      
        '110249714=                                  ) RETURNING_VALUES (' +
        ':KASSA_, :ERR_CODE, :ERR_MSG);'
      '110249715=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110249716=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_' +
        'MSG;'
      '110249717=      EXIT;'
      '110249718=    END'
      '110249719=  END'
      '110249720='
      
        '110249721=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059', '#1045#1057#1051#1048' UPLOAD_TO_' +
        'EXT_APP_ = 2, '#1047#1053#1040#1063#1048#1058' '#1047#1040#1043#1056#1059#1047#1050#1040' '#1048#1044#1045#1058' '#1057' '#1052#1054#1041#1048#1051#1067' '#1048' '#1042' '#1052#1054#1041#1048#1051#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1043 +
        #1056#1059#1047#1048#1058#1068' '#1053#1045' '#1053#1059#1046#1053#1054
      
        '110249722=  IF (UPLOAD_TO_EXT_APP_ <> 0 AND IS_VOZVRAT_ IN (0, 1' +
        ', 2)) THEN'
      
        '110249723=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TYP' +
        'E, ID, OPER, IS_LOADED_MOB)'
      '110249724=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1),'
      '110249725=            2,'
      '110249726=            :SKLAD_,'
      '110249727=            1,'
      
        '110249728=            (CASE WHEN :UPLOAD_TO_EXT_APP_ = 2 THEN 1 ' +
        'ELSE 0 END)   -- '#1055#1054#1063#1045#1052#1059'-'#1058#1054' '#1053#1040#1044#1054' '#1054#1041#1056#1040#1052#1051#1071#1058#1068' '#1042' '#1057#1050#1054#1041#1050#1048', '#1048#1053#1040#1063#1045' '#1055#1054#1058#1054#1052' ' +
        #1054#1041#1053#1054#1042#1051#1045#1053#1048#1071' '#1042' '#1045#1050#1047#1045#1064#1053#1048#1050#1045' '#1053#1045' '#1053#1040#1050#1040#1058#1067#1042#1040#1070#1058#1057#1071
      '110249729=           );'
      '110249730='
      '110249731=  -- '#1042#1057#1058#1040#1042#1050#1040' '#1042' '#1046#1059#1056#1053#1040#1051' '#1054#1055#1045#1056#1040#1062#1048#1049
      
