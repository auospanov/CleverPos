      '1101241274=  END'
      '1101241275='
      '1101241276=  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101241277=  IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_VOZVRAT_ = 0) THE' +
        'N'
      
        '1101241278=    INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJECT_TY' +
        'PE, ID, OPER)'
      
        '1101241279=    VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKLAD_PA' +
        'RENT_, 2);'
      '1101241280=end'
      '1101241281=;'
      '1101241282='
      '1101241283='
      
        '1101241284=/****************************************************' +
        '**************************/'
      
        '1101241285=/****                   Restoring deactivated procedu' +
        'res                   ****/'
      
        '1101241286=/****************************************************' +
        '**************************/'
      '1101241287=ALTER PROCEDURE DEL_PRODUCT('
      '1101241288=  SKLAD_ TYPE OF COLUMN OTHER.SKLAD_PARENT_ID)'
      '1101241289=RETURNS ('
      '1101241290=  ERR_CODE INTEGER,'
      '1101241291=  ERR_MSG VARCHAR(1024))'
      '1101241292=AS'
      '1101241293=/*'
      
        '1101241294='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1101241295='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1101241296=*/'
      
        '1101241297=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DEL_PRODUCT' +
        #39';'
      '1101241298=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101241299=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1101241300=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN LT_SKLAD_PROD' +
        'UCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045' */'
      
        '1101241301=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101241302=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101241303=DECLARE VARIABLE ARRIVAL_TYPE_ TYPE OF COLUMN OTHER.A' +
        'RRIVAL_TYPE;'
      
        '1101241304=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1101241305=BEGIN'
      '1101241306='
      '1101241307=  PNT_ = '#39'00'#39';'
      '1101241308=  SELECT O.G_TOCHKA'
      '1101241309=    FROM SKLAD_PARENT O'
      '1101241310=   WHERE O.SKLAD = :SKLAD_'
      '1101241311=    INTO :G_TOCHKA_;'
      '1101241312='
      '1101241313=  FOR SELECT D.AMOUNT'
      '1101241314=            ,D.G_PRODUCT'
      '1101241315=            ,O.ARRIVAL_TYPE'
      '1101241316=        FROM OTHER O,'
      '1101241317=             OTHER_DETAILS D'
      '1101241318=       WHERE O.sklad_parent_id = :SKLAD_'
      '1101241319=         AND O.OTHER = D.OTHER'
      '1101241320=        INTO :AMOUNT_NEED_'
      '1101241321=            ,:G_PRODUCT_KIT_'
      '1101241322=            ,:ARRIVAL_TYPE_'
      '1101241323=  DO BEGIN'
      '1101241324=    UPDATE LT_SKLAD_PRODUCT L'
      
        '1101241325=       SET L.AMOUNT = L.AMOUNT + DECODE(:ARRIVAL_TYPE' +
        '_, 0, -:AMOUNT_NEED_, :AMOUNT_NEED_)   -- '#1045#1057#1051#1048' '#1041#1067#1051' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040 +
        ', '#1058#1054' '#1054#1058#1053#1048#1052#1040#1070' '#1048' '#1053#1040#1054#1041#1054#1056#1054#1058
      '1101241326=     WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1101241327=       AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101241328=  END'
      '1101241329='
      '1101241330=  PNT_ = '#39'01'#39';'
      
        '1101241331=  DELETE FROM OTHER_DETAILS D WHERE EXISTS (SELECT 1 ' +
        'FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_ AND OTHER = D.OTHER);'
      '1101241332=  DELETE FROM OTHER WHERE SKLAD_PARENT_ID = :SKLAD_;'
      '1101241333='
      '1101241334=  PNT_ = '#39'02'#39';'
      
        '1101241335=  EXECUTE PROCEDURE DEL_SKLAD(:SKLAD_, NULL) RETURNIN' +
        'G_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101241336=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241337=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101241338=      EXIT;'
      '1101241339=  END'
      '1101241340=END'
      '1101241341=;'
      '1101241342='
      '1101241343=ALTER PROCEDURE DEL_ZAKAZ('
      '1101241344=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101241345=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE = 0,'
      '1101241346=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101241347=RETURNS ('
      '1101241348=  ERR_CODE INTEGER,'
      '1101241349=  ERR_MSG VARCHAR(1024))'
      '1101241350=AS'
      '1101241351=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'DEL_ZAKAZ'#39';'
      '1101241352=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '1101241353=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1101241354=DECLARE VARIABLE SUMM_ZAKAZ_ TYPE OF COLUMN ZAKAZ.SUM' +
        'M;'
      
        '1101241355=DECLARE VARIABLE SUMM_PAY_BONUS_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS;'
      
        '1101241356=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1101241357=DECLARE VARIABLE G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_' +
        'CLIENT;'
      
        '1101241358=DECLARE VARIABLE DO_NOT_SALES_COMM_ TYPE OF COLUMN G_' +
        'OFFICIAL.DO_NOT_SALES_COMM;'
      
        '1101241359=DECLARE VARIABLE OFFICIAL_NAME_ TYPE OF COLUMN G_OFFI' +
        'CIAL.FM;'
      
        '1101241360=DECLARE VARIABLE WHEN_CHARGE_SALES_COMM_ TYPE OF COLU' +
        'MN SYSTEM_SETUP.S_VALUE;'
      
        '1101241361=DECLARE VARIABLE SALES_COMM_SUMM_ITER_ TYPE OF COLUMN' +
        ' G_PRODUCT.SALES_COMM;'
      
        '1101241362=DECLARE VARIABLE SALES_COMM_OLD_ TYPE OF COLUMN G_PRO' +
        'DUCT.SALES_COMM;'
      
        '1101241363=DECLARE VARIABLE ACTION_DATE_ZP_ TYPE OF COLUMN KASSA' +
        '.ACTION_DATE;'
      
        '1101241364=DECLARE VARIABLE G_OFFICIAL_ TYPE OF COLUMN G_OFFICIA' +
        'L.G_OFFICIAL;'
      
        '1101241365=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN ZAKAZ.G_TOC' +
        'HKA;'
      '1101241366=BEGIN'
      
        '1101241367=  --*************************************************' +
        '***************'
      '1101241368=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      '1101241369=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      '1101241370=      SELECT Z.SUMM,'
      '1101241371=             Z.SUMM_BONUS,'
      '1101241372=             Z.SUMM_BONUS_GOT,'
      '1101241373=             Z.G_CLIENT,'
      '1101241374=             Z.G_OFFICIAL,'
      '1101241375=             COALESCE(G.DO_NOT_SALES_COMM, 1),'
      '1101241376=             G.FM'
      '1101241377=             ,Z.G_TOCHKA'
      
        '1101241378=        FROM ZAKAZ Z LEFT OUTER JOIN G_OFFICIAL G ON ' +
        'Z.G_OFFICIAL = G.G_OFFICIAL'
      '1101241379=       WHERE Z.ZAKAZ = :ZAKAZ_'
      '1101241380=        INTO :SUMM_ZAKAZ_,'
      '1101241381=             :SUMM_PAY_BONUS_,'
      '1101241382=             :SUMM_BONUS_GOT_,'
      '1101241383=             :G_CLIENT_,'
      '1101241384=             :G_OFFICIAL_,'
      '1101241385=             :DO_NOT_SALES_COMM_,'
      '1101241386=             :OFFICIAL_NAME_'
      '1101241387=             ,:G_TOCHKA_;'
      '1101241388='
      
        '1101241389=      -- '#1055#1045#1056#1045#1044' '#1059#1044#1040#1051#1045#1053#1048#1045#1052' '#1057#1054#1061#1056#1040#1053#1070' '#1057#1059#1052#1052#1059' '#1055#1056#1045#1063#1048#1058#1040#1070#1065#1059#1070#1057#1071' ' +
        #1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101241390=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ') THEN'
      '1101241391=        SELECT SUM(ZD.SALES_COMM)'
      '1101241392=          FROM ZAKAZ_DETAILS ZD'
      '1101241393=         WHERE ZD.ZAKAZ = :ZAKAZ_'
      '1101241394=          INTO :SALES_COMM_OLD_;'
      '1101241395='
      '1101241396=      -- '#1059#1044#1040#1051#1071#1070' '#1044#1045#1058#1040#1051#1048
      '1101241397=      PNT_ = '#39'01'#39';'
      
        '1101241398=      EXECUTE PROCEDURE DEL_ZAKAZ_DETAIL(:ZAKAZ_) RET' +
        'URNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101241399=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241400=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101241401=        EXIT;'
      '1101241402=      END'
      '1101241403='
      '1101241404=      -------------------------------------'
      '1101241405=      PNT_ = '#39'02'#39';'
      '1101241406=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1054#1041#1056#1040#1058#1053#1054
      
        '1101241407=      -- '#1058'.'#1050'. '#1057' 27.04.2017 '#1042' '#1047#1040#1050#1040#1047#1045' '#1052#1054#1043#1059#1058' '#1041#1067#1058#1068' '#1050#1040#1050' '#1053#1040 +
        #1051#1048#1063#1053#1067#1045' '#1055#1051#1040#1058#1045#1046#1048', '#1058#1040#1050' '#1048' '#1041#1045#1047' '#1053#1040#1051#1048#1063#1053#1067#1045', '#1058#1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1044#1042#1040' '#1059#1044#1040#1051#1045 +
        #1053#1048#1071' '#1055#1054#1044#1056#1071#1044
      '1101241408=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1053#1040#1051#1048#1063#1053#1054#1049
      '1101241409=      FOR SELECT S.KASSA'
      '1101241410=            FROM KASSA S'
      '1101241411=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1101241412=            INTO :KASSA_'
      '1101241413=      DO BEGIN'
      
        '1101241414=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 1) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101241415=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241416=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101241417=            EXIT;'
      '1101241418=          END'
      '1101241419=      END'
      '1101241420='
      '1101241421=      -- '#1059#1041#1048#1056#1040#1070' '#1057#1059#1052#1052#1059' '#1048#1047' '#1050#1040#1057#1057#1067' '#1041#1045#1047#1053#1040#1051#1048#1063#1053#1054#1049
      '1101241422=      PNT_ = '#39'03'#39';'
      '1101241423=      FOR SELECT S.KASSA_BEZNAL'
      '1101241424=            FROM KASSA_BEZNAL S'
      '1101241425=           WHERE S.ZAKAZ = :ZAKAZ_'
      '1101241426=            INTO :KASSA_'
      '1101241427=      DO BEGIN'
      
        '1101241428=          EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, 2) R' +
        'ETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101241429=          IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241430=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' ' +
        #39'||ERR_MSG;'
      '1101241431=            EXIT;'
      '1101241432=          END'
      '1101241433=      END'
      '1101241434=      -------------------------------------'
      '1101241435='
      
        '1101241436=      --=============================================' +
        '===================='
      '1101241437=      -- '#1041#1051#1054#1050' '#1059#1044#1040#1051#1045#1053#1048#1071' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1040
      
        '1101241438=      --=============================================' +
        '===================='
      '1101241439=      PNT_ = '#39'03.1'#39';'
      
        '1101241440=      IF (DO_NOT_SALES_COMM_ = 0 AND IS_SPISANIE_ = 0' +
        ' AND SALES_COMM_OLD_ > 0) THEN BEGIN'
      '1101241441=            KASSA_ = NULL;'
      '1101241442='
      '1101241443=            SELECT S.S_VALUE'
      '1101241444=              FROM SYSTEM_SETUP S'
      '1101241445=             WHERE S.SYSTEM_SETUP = 4'
      '1101241446=              INTO :WHEN_CHARGE_SALES_COMM_;'
      '1101241447='
      '1101241448=            -- '#1045#1046#1045#1044#1053#1045#1042#1053#1054
      '1101241449=            IF (WHEN_CHARGE_SALES_COMM_ = 0) THEN'
      '1101241450=              ACTION_DATE_ZP_ = CURRENT_DATE;'
      '1101241451='
      
        '1101241452=            -- '#1045#1046#1045#1053#1045#1044#1045#1051#1068#1053#1054' '#1055#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071#1052', '#1042#1067#1063#1048#1057#1051#1071#1070' ' +
        #1044#1040#1058#1059' '#1041#1051#1048#1046#1040#1049#1064#1045#1043#1054' '#1042#1054#1057#1050#1056#1045#1057#1045#1053#1068#1071
      
        '1101241453=            ELSE IF (WHEN_CHARGE_SALES_COMM_ = 1) THE' +
        'N'
      
        '1101241454=              ACTION_DATE_ZP_ = CURRENT_DATE + (7 - D' +
        'ECODE(EXTRACT(WEEKDAY FROM CURRENT_DATE), 0, 7, EXTRACT(WEEKDAY ' +
        'FROM CURRENT_DATE)));'
      '1101241455='
      '1101241456=            -- '#1045#1046#1045#1052#1045#1057#1071#1063#1053#1054' '#1042' '#1055#1054#1057#1051#1045#1044#1053#1048#1049' '#1044#1045#1053#1068' '#1052#1045#1057#1071#1062#1040
      '1101241457=            ELSE'
      
        '1101241458=               ACTION_DATE_ZP_ = Current_date - EXTRA' +
        'CT(DAY FROM current_date) + 32 - EXTRACT(DAY FROM current_date -' +
        ' EXTRACT(DAY FROM current_date) + 32);'
      '1101241459='
      '1101241460=            SELECT K.KASSA, K.SUMM'
      '1101241461=            FROM KASSA K'
      '1101241462=            WHERE K.G_PRIHOD_RASHOD = -1'
      '1101241463=             AND K.G_OFFICIAL = :G_OFFICIAL_'
      '1101241464=             AND K.ACTION_DATE = :ACTION_DATE_ZP_'
      '1101241465=             AND K.G_TOCHKA = :G_TOCHKA_'
      '1101241466=             INTO :KASSA_, :SALES_COMM_SUMM_ITER_;'
      '1101241467='
      '1101241468=            IF (KASSA_ IS NULL) THEN BEGIN'
      
        '1101241469=                EXECUTE PROCEDURE K_INS_KASSA(1,     ' +
        '-- ACTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '1101241470=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1101241471=                                              -:SALES' +
        '_COMM_OLD_,'
      
        '1101241472=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1101241473=                                              :OFFICI' +
        'AL_NAME_,'
      
        '1101241474=                                              NULL,  ' +
        '   --:ZAKAZ_,'
      
        '1101241475=                                              NULL,  ' +
        '   --:SKLAD_,'
      '1101241476=                                              1,'
      
        '1101241477=                                              (SELECT' +
        ' ID FROM CUR_PARAMS WHERE CUR_PARAMS = 2),'
      
        '1101241478=                                              :G_OFFI' +
        'CIAL_) RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101241479=            END ELSE'
      
        '1101241480=                EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_' +
        ','
      
        '1101241481=                                              1,     ' +
        '-- ACTION_'
      
        '1101241482=                                              -1,    ' +
        ' --:G_PRIHOD_RASHOD_,'
      
        '1101241483=                                              :SALES_' +
        'COMM_SUMM_ITER_ - :SALES_COMM_OLD_,'
      
        '1101241484=                                              :ACTION' +
        '_DATE_ZP_,'
      
        '1101241485=                                              :OFFICI' +
        'AL_NAME_,   --NOTE_'
      '1101241486=                                              NULL,'
      '1101241487=                                              NULL,'
      '1101241488=                                              1,'
      
        '1101241489=                                              G_OFFIC' +
        'IAL_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101241490='
      '1101241491=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241492=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101241493=              EXIT;'
      '1101241494=            END'
      '1101241495=      END'
      '1101241496=      -- '#1050#1054#1053#1045#1062' '#1041#1051#1054#1050#1040' '#1053#1040#1063#1048#1057#1051#1045#1053#1048#1045' '#1047#1040#1056#1055#1051#1040#1058#1067' '#1055#1056#1054#1044#1040#1042#1062#1059
      
        '1101241497=      --=============================================' +
        '===================='
      '1101241498='
      
        '1101241499=      -- '#1045#1057#1051#1048' '#1050#1040#1050#1040#1071'-'#1058#1054' '#1063#1040#1057#1058#1068' '#1041#1067#1051#1040' '#1054#1055#1051#1040#1063#1045#1053#1040' '#1041#1054#1053#1059#1057#1040#1052#1048' -' +
        ' '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1048#1061', '#1058#1054' '#1045#1057#1058#1068' '#1047#1040#1050#1048#1044#1067#1042#1040#1070' '#1050#1051#1048#1045#1053#1058#1059' '#1054#1041#1056#1040#1058#1053#1054' '#1053#1040' '#1053#1040#1050#1054#1055#1051#1045 +
        #1053#1048#1071
      '1101241500=      -- '#1040' '#1047#1040#1056#1040#1041#1054#1058#1040#1053#1053#1067#1045' '#1041#1054#1053#1059#1057#1067' '#1054#1058#1053#1048#1052#1040#1070
      
        '1101241501=      -- '#1040' '#1058#1040#1050#1046#1045' '#1054#1058#1053#1048#1052#1040#1070' '#1057#1059#1052#1052#1059' '#1047#1040#1050#1040#1047#1040' '#1054#1058' '#1054#1041#1064#1045#1049' '#1057#1059#1052#1052#1067' ' +
        #1055#1054#1050#1059#1055#1054#1050' '#1050#1051#1048#1045#1053#1058#1040
      '1101241502=      UPDATE G_DISCONT_CARD G'
      
        '1101241503=      SET G.SUMM = G.SUMM + COALESCE(:SUMM_PAY_BONUS_' +
        ', 0) - :SUMM_BONUS_GOT_,'
      
        '1101241504=          G.SUMM_ALL = DECODE(COALESCE(G.SUMM_ALL, 0)' +
        ', 0, G.SUMM_ALL, G.SUMM_ALL - :SUMM_ZAKAZ_)'
      '1101241505=      WHERE G.G_CLIENT = :G_CLIENT_;'
      '1101241506='
      '1101241507=      PNT_ = '#39'04'#39';'
      '1101241508=      UPDATE INVOICE I'
      '1101241509=         SET I.ZAKAZ = NULL'
      '1101241510=       WHERE I.ZAKAZ = :zakaz_;'
      '1101241511='
      '1101241512=      UPDATE INVOICE_PAY I'
      '1101241513=         SET I.ZAKAZ = NULL'
      '1101241514=       WHERE I.ZAKAZ = :zakaz_;'
      '1101241515='
      '1101241516=      UPDATE WAYBILL W'
      '1101241517=         SET W.ZAKAZ = NULL'
      '1101241518=       WHERE W.ZAKAZ = :zakaz_;'
      '1101241519=      --********************************************'
      '1101241520='
      '1101241521=      PNT_ = '#39'015'#39';'
      '1101241522=      DELETE FROM zakaz'
      '1101241523=      WHERE zakaz = :zakaz_;'
      '1101241524='
      '1101241525=      -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      
        '1101241526=      IF (UPLOAD_TO_EXT_APP_ = 1 AND IS_SPISANIE_ = 0' +
        ') THEN'
      
        '1101241527=        INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJEC' +
        'T_TYPE, ID, OPER)'
      
        '1101241528=        VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 1, :ZAKA' +
        'Z_, 3);'
      '1101241529=  END'
      '1101241530=  -- '#1050#1054#1053#1045#1062' '#1059#1044#1040#1051#1045#1053#1048#1045' '#1054#1041#1067#1063#1053#1054#1049' '#1055#1056#1054#1044#1040#1046#1048
      
        '1101241531=  --*************************************************' +
        '***************************'
      '1101241532=  -- '#1059#1044#1040#1051#1045#1053#1048#1045' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1071' '#1058#1054#1042#1040#1056#1040' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '1101241533=  ELSE BEGIN'
      '1101241534=    PNT_ = '#39'20'#39';'
      
        '1101241535=    EXECUTE PROCEDURE DEL_SKLAD(:ZAKAZ_, NULL) RETURN' +
        'ING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101241536=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241537=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101241538=      EXIT;'
      '1101241539=    END'
      '1101241540=  END'
      '1101241541='
      '1101241542=when sqlcode -530 DO'
      '1101241543=  begin'
      '1101241544=    ERR_CODE = -20500;'
      
        '1101241545=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1059' '#1076#1072#1085#1085#1086#1081 +
        ' '#1079#1072#1087#1080#1089#1080' '#1077#1089#1090#1100' '#1076#1086#1095#1077#1088#1085#1080#1077' '#1079#1072#1087#1080#1089#1080'. '#1059#1076#1072#1083#1080#1090#1077' '#1074#1085#1072#1095#1072#1083#1077' '#1080#1093'!'#39') RETURNING_VA' +
        'LUES (:ERR_MSG);'
      '1101241546=    ERR_MSG = PROCNAME||'#39' PNT_ = '#39'||PNT_||ERR_MSG;'
      '1101241547=  end'
      '1101241548=end'
      '1101241549=;'
      '1101241550='
      '1101241551=ALTER PROCEDURE DO_PRODUCT('
      '1101241552=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101241553=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1101241554=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101241555=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101241556=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '1101241557=RETURNS ('
      '1101241558=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1101241559=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101241560=  ERR_CODE INTEGER,'
      '1101241561=  ERR_MSG VARCHAR(1024))'
      '1101241562=AS'
      '1101241563=/*'
      
        '1101241564='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1055#1056#1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '1101241565='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '1101241566=*/'
      
        '1101241567=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39 +
        ';'
      '1101241568=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101241569=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040 +
        #1042#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '1101241570=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRO' +
        'DUCT;'
      
        '1101241571=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD' +
        '_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '1101241572=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_S' +
        'KLAD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062 +
        #1067' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '1101241573=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '1101241574=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PROD' +
        'UCT.G_PRODUCT;'
      
        '1101241575=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUM' +
        'M;'
      '1101241576=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '1101241577=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101241578=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS' +
        '.AMOUNT;'
      '1101241579=BEGIN'
      '1101241580=  PNT_ = '#39'00'#39';'
      '1101241581=  COST_PRICE_ = 0;'
      '1101241582='
      '1101241583=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101241584=    SELECT ID'
      '1101241585=      FROM CUR_PARAMS'
      '1101241586=     WHERE CUR_PARAMS = 2'
      '1101241587=      INTO :G_TOCHKA_;'
      '1101241588='
      '1101241589=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '1101241590=  SELECT P.S_VALUE'
      '1101241591=    FROM SYSTEM_SETUP P'
      '1101241592=   WHERE P.SYSTEM_SETUP = 2'
      '1101241593=    INTO :CAN_SELL_;'
      '1101241594='
      '1101241595=  FOR SELECT :G_PRODUCT_IN_,'
      '1101241596=             :AMOUNT_IN_'
      '1101241597=        FROM RDB$DATABASE'
      '1101241598=      UNION ALL'
      '1101241599=      SELECT G_PRODUCT,'
      '1101241600=             AMOUNT'
      '1101241601=        FROM ZAKAZ_DETAILS_TMP'
      '1101241602=        INTO :G_PRODUCT_,'
      '1101241603=             :AMOUNT_'
      '1101241604=  DO BEGIN'
      '1101241605=      SELECT MAX(G.NAME)'
      '1101241606=        FROM G_PRODUCT G,'
      '1101241607=             G_PRODUCT_KIT K'
      '1101241608=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '1101241609=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '1101241610=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_' +
        'PRODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TO' +
        'CHKA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '1101241611=        INTO :NAME_;'
      '1101241612='
      
        '1101241613=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN B' +
        'EGIN'
      '1101241614=        ERR_CODE = -20500;'
      
        '1101241615=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072 +
        #1090#1086#1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087 +
        #1088#1086#1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '1101241616=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101241617=        EXIT;'
      '1101241618=      END'
      '1101241619='
      '1101241620=      PNT_ = '#39'01'#39';'
      
        '1101241621=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARR' +
        'IVAL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '1101241622=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_,' +
        ' 0, 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '1101241623=      RETURNING OTHER'
      '1101241624=      INTO :OTHER_;'
      '1101241625='
      '1101241626=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '1101241627=      FOR SELECT K.G_PRODUCT_ITEM'
      '1101241628=                ,K.AMOUNT*:AMOUNT_'
      '1101241629=                ,K.amount'
      '1101241630=                ,G.G_PRODUCT'
      '1101241631=            FROM G_PRODUCT_KIT K'
      '1101241632=                ,G_PRODUCT G'
      '1101241633=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '1101241634=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '1101241635=            INTO :ITEM_'
      '1101241636=                ,:AMOUNT_NEED_'
      '1101241637=                ,:AMOUNT_NEED_ONE_'
      '1101241638=                ,:G_PRODUCT_KIT_'
      '1101241639=      DO BEGIN'
      
        '1101241640=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PROD' +
        'UCT_KIT_, NULL, 1)'
      '1101241641=          RETURNING_VALUES :SELF_PRICE_;'
      '1101241642='
      '1101241643=        UPDATE LT_SKLAD_PRODUCT L'
      '1101241644=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '1101241645=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '1101241646=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101241647='
      '1101241648=        IF (ROW_COUNT = 0) THEN'
      
        '1101241649=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID' +
        '(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :' +
        'G_TOCHKA_);'
      '1101241650='
      
        '1101241651=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTH' +
        'ER, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '1101241652=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_' +
        ', :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '1101241653='
      
        '1101241654=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*' +
        'SELF_PRICE_;'
      '1101241655=      END'
      '1101241656='
      
        '1101241657=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040 +
        #1063#1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '1101241658=      PNT_ = '#39'02'#39';'
      
        '1101241659=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101241660=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '1101241661='
      '1101241662=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101241663=                              :DATE_,'
      '1101241664=                              CURRENT_TIME,'
      '1101241665=                              NULL, --:G_CLIENT__,'
      
        '1101241666=                              NULL, --:G_PAYMENT_TYPE' +
        '__,'
      '1101241667=                              NULL, --:OSNOVANIE__,'
      '1101241668=                              :NOTE_,'
      '1101241669=                              4, --:IS_VOZVRAT_,'
      '1101241670=                              :AMOUNT_*:COST_PRICE_,'
      '1101241671=                              :AMOUNT_*:COST_PRICE_,'
      '1101241672=                              0, --:G_PRIHOD_,'
      '1101241673=                              0 --:SUMM_PRIHOD_)'
      '1101241674=                              ,NULL     --PAYMENTS_'
      
        '1101241675=                             )RETURNING_VALUES :SKLAD' +
        '_, :ERR_CODE, :ERR_MSG;'
      '1101241676=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101241677=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101241678=          EXIT;'
      '1101241679=      END'
      '1101241680='
      '1101241681=      UPDATE OTHER O'
      '1101241682=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '1101241683=      WHERE O.OTHER = :OTHER_;'
      '1101241684=  END'
      '1101241685=END'
      '1101241686=;'
      '1101241687='
      '1101241688=ALTER PROCEDURE P_REP_ZAYAVKA_POSTAVSHIK('
      '1101241689=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101241690=  BEGIN_DATE_ DATE,'
      '1101241691=  END_DATE_ DATE,'
      '1101241692=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101241693=  DO_SKLAD_ INTEGER,'
      '1101241694=  MODE_ INTEGER,'
      '1101241695=  MODE_VYBOR_ INTEGER,'
      '1101241696=  MODE_VAL_ INTEGER,'
      '1101241697=  NEW_VAL_ MY_NUMERIC_5,'
      '1101241698=  ROUND_MODE_ INTEGER)'
      '1101241699=RETURNS ('
      '1101241700=  G_PRODUCT TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101241701=  CATEGORY_NAME TYPE OF COLUMN P_REP_TREE.PATH,'
      '1101241702=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '1101241703=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '1101241704=  AMOUNT_CUR TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      '1101241705=  MIN_AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '1101241706=  AMOUNT_TO_ZAKAZ TYPE OF COLUMN LT_SKLAD_PRODUCT.AMO' +
        'UNT,'
      '1101241707=  ERR_CODE INTEGER,'
      '1101241708=  ERR_MSG VARCHAR(1024))'
      '1101241709=AS'
      '1101241710=/*'
      
        '1101241711='#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1044#1054#1047#1040#1050#1040#1047#1040' '#1058#1054#1042#1040#1056#1040' '#1059' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1055#1056 +
        #1048' '#1055#1045#1063#1040#1058#1048' '#1047#1040#1071#1042#1050#1048' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', '#1048' '#1055#1056#1048' '#1046#1045#1051#1040#1053#1048#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1071' '#1057#1054#1047#1044#1040#1058#1068' '#1057 +
        #1056#1040#1047#1059' '#1053#1040#1050#1051#1040#1044#1053#1059#1070'.'
      
        '1101241712='#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1055#1056#1054#1057#1058#1054' '#1042#1067#1047#1067#1042#1040#1045#1058#1057#1071' '#1042#1058#1054#1056#1054#1049' '#1056#1040#1047', '#1057#1051#1045#1044#1054#1052', '#1055 +
        #1054#1057#1051#1045' '#1055#1045#1063#1040#1058#1048', '#1048' '#1055#1054#1061' '#1063#1058#1054' '#1044#1042#1054#1049#1053#1040#1071' '#1053#1040#1043#1056#1059#1047#1050#1040' '#1053#1040' '#1057#1045#1056#1042#1045#1056'.'
      
        '1101241713=DO_SKLAD_   - 0 '#1053#1045' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040', 1 - '#1044#1045#1051#1040#1058#1068' '#1055 +
        #1056#1048#1061#1054#1044' '#1058#1054#1042#1040#1056#1040
      
        '1101241714=MODE_       - 0 '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040', 1 -' +
        ' '#1047#1040#1050#1040#1047#1040#1058#1068' '#1044#1054' '#1053#1059#1051#1071
      
        '1101241715=MODE_VYBOR  - 0 '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058#1054#1042#1040#1056#1067', 1 - '#1042#1067#1041#1056#1040#1058#1068' '#1042#1057#1045' '#1058 +
        #1054#1042#1040#1056#1067' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040', 2 - '#1042#1067#1041#1056#1040#1058#1068' '#1058#1054#1042#1040#1056#1067', '#1050#1054#1058#1054#1056#1067#1045' '#1042#1061#1054#1044#1071#1058' '#1042' '#1053#1040#1050#1051#1040#1044#1053#1067#1045 +
        ' '#1047#1040#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1040
      '1101241716=MODE_VAL_   - 0 '#1064#1058#1059#1050#1048', 1 - '#1055#1056#1054#1062#1045#1053#1058#1067
      
        '1101241717=NEW_VAL_    - '#1047#1053#1040#1063#1045#1053#1048#1045' '#1057#1050#1054#1051#1068#1050#1054' '#1044#1054#1041#1040#1042#1048#1058#1068' '#1064#1058#1059#1050' '#1050' '#1047#1040#1050#1040#1047#1067 +
        #1042#1040#1045#1052#1054#1052#1059' '#1058#1054#1042#1040#1056#1059
      
        '1101241718=ROUND_MODE_ 0 - '#1094#1077#1083#1099#1077', 1 '#1076#1077#1089#1103#1090#1082#1080', 2 '#1089#1086#1090#1085#1080', 3 '#1090#1099#1089#1103#1095#1080' *' +
        '/'
      '1101241719=DECLARE VARIABLE ROUND_ INTEGER;'
      '1101241720=DECLARE VARIABLE SQL_STR_ VARCHAR(1000);'
      
        '1101241721=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      
        '1101241722=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD_PA' +
        'RENT;'
      '1101241723=BEGIN'
      '1101241724=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '1101241725='
      '1101241726=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101241727=    SELECT ID'
      '1101241728=      FROM CUR_PARAMS'
      '1101241729=     WHERE CUR_PARAMS = 2'
      '1101241730=      INTO :G_TOCHKA_;'
      '1101241731='
      '1101241732=  IF (ROUND_MODE_ = 0) THEN'
      '1101241733=      ROUND_ = 0;'
      '1101241734=  ELSE IF (ROUND_MODE_ = 1) THEN'
      '1101241735=      ROUND_ = -1;'
      '1101241736=  ELSE IF (ROUND_MODE_ = 2) THEN'
      '1101241737=      ROUND_ = -2;'
      '1101241738=  ELSE IF (ROUND_MODE_ = 3) THEN'
      '1101241739=      ROUND_ = -3;'
      '1101241740=  ELSE IF (ROUND_MODE_ = -1) THEN'
      '1101241741=      ROUND_ = 5;'
      '1101241742='
      
        '1101241743=  SQL_STR_ = '#39'SELECT G.G_PRODUCT, GP.PATH, G.NAME, G.' +
        'ARTICUL, COALESCE(LT.AMOUNT, 0), G.MIN_AMOUNT, '#39';'
      '1101241744='
      
        '1101241745=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1044#1054' '#1052#1048#1053#1048#1052#1040#1051#1068#1053#1054#1043#1054' '#1054#1057#1058#1040#1058#1050#1040 +
        ' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101241746=  IF (MODE_ = 0) THEN BEGIN'
      
        '1101241747=    SQL_STR_ = SQL_STR_ || '#39'ROUND((G.MIN_AMOUNT - COA' +
        'LESCE(LT.AMOUNT,0))'#39';'
      '1101241748=    IF (MODE_VAL_ = 0) THEN'
      '1101241749=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1101241750=    ELSE'
      
        '1101241751=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1101241752='
      '1101241753=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1101241754=  END'
      '1101241755=  -- '#1045#1057#1051#1048' '#1042#1067#1058#1040#1065#1048#1058#1068' '#1044#1054' '#1053#1059#1051#1045#1042#1054#1049' '#1057#1059#1052#1052#1067
      '1101241756=  ELSE IF (MODE_ = 1) THEN BEGIN'
      '1101241757=    SQL_STR_ = SQL_STR_ || '#39'ROUND(ABS(LT.AMOUNT)'#39';'
      '1101241758=    IF (MODE_VAL_ = 0) THEN'
      '1101241759=        SQL_STR_ = SQL_STR_ || '#39' + :NEW_VAL_'#39';'
      '1101241760=    ELSE'
      
        '1101241761=        SQL_STR_ = SQL_STR_ || '#39' * (1 + CAST(:NEW_VAL' +
        '_ AS DOUBLE PRECISION)/100)'#39';'
      '1101241762='
      '1101241763=    SQL_STR_ = SQL_STR_ || '#39', :ROUND_)'#39';'
      '1101241764=  END'
      '1101241765='
      
        '1101241766=  SQL_STR_ = SQL_STR_ || '#39' FROM G_PRODUCT G LEFT OUTE' +
        'R JOIN LT_SKLAD_PRODUCT LT ON G.G_PRODUCT = LT.G_PRODUCT AND LT.' +
        'G_TOCHKA = :G_TOCHKA_, P_REP_TREE GP'#39'||'
      
        '1101241767=            '#39' WHERE G.IS_ACTIVE = 1 AND G.G_PRODUCT_P' +
        'AR = GP.G_PRODUCT '#39';'
      '1101241768='
      '1101241769=  IF (MODE_VYBOR_ <> 0) THEN BEGIN'
      '1101241770=    SQL_STR_ = SQL_STR_ ||'#39'AND EXISTS (SELECT 1'#39'||'
      
        '1101241771=                                        '#39' FROM SKLAD ' +
        'S'#39'||'
      
        '1101241772=                                        '#39' WHERE S.G_C' +
        'LIENT = :G_CLIENT_'#39'||'
      
        '1101241773=                                        '#39' AND S.G_PRO' +
        'DUCT = G.G_PRODUCT'#39'||'
      
        '1101241774=                                        '#39' AND S.G_TOC' +
        'HKA = :G_TOCHKA_ '#39';'
      '1101241775=    IF (MODE_VYBOR_ = 2) THEN'
      
        '1101241776=      SQL_STR_ = SQL_STR_ ||'#39'AND S.DATE_RECEIPT BETWE' +
        'EN :BEGIN_DATE_ AND :END_DATE_'#39';'
      '1101241777=    ELSE'
      
        '1101241778=      SQL_STR_ = SQL_STR_ ||'#39'AND :BEGIN_DATE_ IS NOT ' +
        'NULL AND :END_DATE_ IS NOT NULL'#39';  -- '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053 +
        #1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045', '#1040' '#1044#1040#1058#1040' '#1050#1040#1050#1040#1071'-'#1053#1048#1041#1059#1044#1068' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' '#1042#1057 +
        #1045#1043#1044#1040
      '1101241779=    SQL_STR_ = SQL_STR_ ||'#39') '#39';'
      '1101241780=  END ELSE BEGIN'
      
        '1101241781=    SQL_STR_ = SQL_STR_ ||'#39' AND :G_CLIENT_ <> -999999' +
        '9 AND :BEGIN_DATE_ IS NOT NULL AND :END_DATE_ IS NOT NULL '#39';  --' +
        ' '#1048#1053#1040#1063#1045' '#1041#1059#1044#1045#1058' '#1056#1059#1043#1040#1058#1068#1057#1071' '#1063#1058#1054' '#1053#1045#1058' '#1058#1040#1050#1048#1061' '#1055#1040#1056#1040#1052#1045#1058#1056#1054#1042' '#1042' '#1047#1040#1055#1056#1054#1057#1045
      '1101241782=  END'
      '1101241783='
      '1101241784=  IF (MODE_ = 0) THEN'
      
        '1101241785=    SQL_STR_ = SQL_STR_ || '#39' AND (LT.AMOUNT < G.MIN_A' +
        'MOUNT OR LT.G_PRODUCT IS NULL) AND G.MIN_AMOUNT <> 0'#39';'
      '1101241786=  ELSE IF (MODE_ = 1) THEN'
      '1101241787=    SQL_STR_ = SQL_STR_ || '#39' AND LT.AMOUNT < 0'#39';'
      
        '1101241788=  SQL_STR_ = SQL_STR_ || '#39' ORDER BY GP.PATH, G.NAME, ' +
        'G.ARTICUL'#39';'
      '1101241789='
      '1101241790=  -- '#1045#1057#1051#1048' '#1053#1059#1046#1053#1054' '#1044#1045#1051#1040#1058#1068' '#1055#1056#1048#1061#1054#1044#1053#1059#1070' '#1053#1040#1050#1051#1040#1044#1053#1059#1070
      '1101241791=  IF (DO_SKLAD_ = 1) THEN BEGIN'
      '1101241792=      FOR EXECUTE STATEMENT'
      
        '1101241793=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1101241794=          INTO :G_PRODUCT,'
      '1101241795=               :CATEGORY_NAME,'
      '1101241796=               :NAME,'
      '1101241797=               :ARTICUL,'
      '1101241798=               :AMOUNT_CUR,'
      '1101241799=               :MIN_AMOUNT,'
      '1101241800=               :AMOUNT_TO_ZAKAZ'
      '1101241801=        DO BEGIN'
      
        '1101241802=            EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_' +
        'PRODUCT, :G_TOCHKA_, 0)'
      '1101241803=              RETURNING_VALUES :COST_PRICE_;'
      '1101241804='
      
        '1101241805=            INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, ' +
        'AMOUNT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101241806=              VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_' +
        'PRODUCT, :AMOUNT_TO_ZAKAZ, :COST_PRICE_, :COST_PRICE_*:AMOUNT_TO' +
        '_ZAKAZ, 0, 0);'
      '1101241807=        END'
      '1101241808='
      '1101241809=        EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101241810=                                      CURRENT_DATE,'
      '1101241811=                                      CURRENT_TIME,'
      '1101241812=                                      :G_CLIENT_,'
      '1101241813=                                      1,'
      
        '1101241814=                                      NULL, --:OSNOVA' +
        'NIE__,'
      
        '1101241815=                                      NULL, --:NOTE__' +
        ','
      
        '1101241816=                                      0, --:IS_VOZVRA' +
        'T_,'
      
        '1101241817=                                      (SELECT SUM(S.S' +
        'UMM) FROM SKLAD_TMP S),'
      
        '1101241818=                                      0, -- :SUMM_FAC' +
        'T_'
      
        '1101241819=                                      0, --:G_PRIHOD_' +
        ','
      
        '1101241820=                                      0 --:SUMM_PRIHO' +
        'D_)'
      
        '1101241821=                                      ,NULL --PAYMENT' +
        'S'
      
        '1101241822=                                     )RETURNING_VALUE' +
        'S :SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1101241823=        IF (ERR_CODE <> 0) THEN BEGIN'
      
        '1101241824=          ERR_MSG  = '#39#1054#1096#1080#1073#1082#1072' '#1087#1088#1080' '#1089#1086#1079#1076#1072#1085#1080#1080' '#1087#1088#1080#1093#1086#1076#1072' '#1090#1086#1074 +
        #1072#1088#1072'.'#39'||ERR_MSG;'
      '1101241825=          EXIT;'
      '1101241826=        END'
      '1101241827=  END'
      '1101241828=  ELSE BEGIN'
      '1101241829=      FOR EXECUTE STATEMENT'
      
        '1101241830=          (:SQL_STR_) (ROUND_ := ROUND_, NEW_VAL_ := ' +
        'NEW_VAL_, G_CLIENT_ := G_CLIENT_, G_TOCHKA_ := :G_TOCHKA_, BEGIN' +
        '_DATE_ := :BEGIN_DATE_, END_DATE_ := :END_DATE_)'
      '1101241831=      INTO :G_PRODUCT,'
      '1101241832=           :CATEGORY_NAME,'
      '1101241833=           :NAME,'
      '1101241834=           :ARTICUL,'
      '1101241835=           :AMOUNT_CUR,'
      '1101241836=           :MIN_AMOUNT,'
      '1101241837=           :AMOUNT_TO_ZAKAZ'
      '1101241838=      DO SUSPEND;'
      '1101241839=  END'
      '1101241840=END'
      '1101241841=;'
      '1101241842='
      '1101241843=ALTER PROCEDURE PAY_ZAKAZ_NA_REAL('
      '1101241844=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101241845=  Z_DATE_ TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '1101241846=  Z_TIME_ TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '1101241847=  G_CLIENT_ TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      
        '1101241848=  G_PAYMENT_TYPE_ TYPE OF COLUMN ZAKAZ.G_PAYMENT_TYPE' +
        ','
      '1101241849=  OSNOVANIE_ TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '1101241850=  IS_SPISANIE_ TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '1101241851=  NOTE_ TYPE OF COLUMN ZAKAZ.NOTE,'
      '1101241852=  SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101241853=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ_NA_REAL.SUMM_PAYED,'
      '1101241854=  UPLOAD_TO_EXT_APP_ INTEGER = 0)'
      '1101241855=RETURNS ('
      '1101241856=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '1101241857=  ERR_CODE INTEGER,'
      '1101241858=  ERR_MSG VARCHAR(1024))'
      '1101241859=AS'
      
        '1101241860=-- '#1041#1059#1044#1059' '#1044#1045#1051#1040#1058#1068' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1059#1070' '#1055#1056#1054#1044#1040#1046#1059', '#1057' '#1058#1054#1049' '#1051#1048#1064#1068' '#1056#1040#1047#1053#1048#1062 +
        #1045#1049' '#1063#1058#1054' '#1055#1054#1057#1058#1040#1042#1051#1070' '#1042' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ.IS_SPISANIE = 2'
      
        '1101241861=-- '#1058'.'#1050'. '#1055#1056#1048' '#1054#1060#1054#1056#1052#1051#1045#1053#1048#1048' '#1042#1067#1044#1040#1063#1048' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1044' '#1056#1045#1040#1051', '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1041#1067#1051#1054' '#1059#1046#1045' '#1057#1055#1048#1057#1040#1053#1054' '#1057#1054' '#1057#1050#1051#1040#1044#1040', '#1058#1054
      
        '1101241862=-- '#1057#1044#1045#1051#1040#1070' '#1058#1059#1058' "'#1055#1057#1045#1042#1044#1054'"-'#1055#1054#1055#1054#1051#1053#1045#1053#1048#1045', '#1058#1054' '#1045#1057#1058#1068' '#1058#1059#1055#1054' '#1055#1056#1048#1041#1040 +
        #1042#1051#1070' '#1050' '#1054#1057#1058#1040#1058#1050#1040#1052' '#1053#1040' '#1057#1050#1051#1040#1044#1045' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1054#1055#1051#1040#1063#1048#1042#1040#1045#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040
      
        '1101241863=-- '#1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1069#1058#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042#1057#1045' '#1056#1040#1042 +
        #1053#1054' '#1057#1055#1048#1064#1045#1058#1057#1071
      '1101241864='
      
        '1101241865=-- '#1045#1057#1051#1048' IS_SPISANIE = 3, '#1047#1053#1040#1063#1048#1058' '#1048#1044#1045#1058' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', ' +
        #1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      '1101241866=-- '#1055#1056#1054#1057#1058#1054' '#1055#1045#1056#1045#1050#1054#1052#1055#1048#1051' 24,12,2018'
      
        '1101241867=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'PAY_ZAKAZ_NA' +
        '_REAL'#39';'
      '1101241868=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101241869=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101241870=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.' +
        'G_PRODUCT;'
      
        '1101241871=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.AMOUNT_ALL;'
      
        '1101241872=DECLARE VARIABLE Z_SUMM_ TYPE OF COLUMN ZAKAZ_NA_REAL' +
        '.SUMM_PAYED;'
      
        '1101241873=DECLARE VARIABLE ZAKAZ_NA_REAL_ TYPE OF COLUMN ZAKAZ_' +
        'NA_REAL.ZAKAZ_NA_REAL;'
      
        '1101241874=DECLARE VARIABLE ZAKAZ_DETAILS_ TYPE OF COLUMN ZAKAZ_' +
        'DETAILS_TMP_REAL.ZAKAZ_DETAILS;'
      '1101241875=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1101241876=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '1101241877=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_S' +
        'UMM;'
      '1101241878=BEGIN'
      '1101241879='
      '1101241880=  IF (G_TOCHKA_ IS NULL) THEN'
      '1101241881=    SELECT ID'
      '1101241882=      FROM CUR_PARAMS'
      '1101241883=     WHERE CUR_PARAMS = 2'
      '1101241884=      INTO :G_TOCHKA_;'
      '1101241885='
      
        '1101241886=  --*************************************************' +
        '*************************************************'
      
        '1101241887=  --*************************************************' +
        '*************************************************'
      '1101241888=  --   '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101241889=  --*************************************************' +
        '*************************************************'
      
        '1101241890=  --*************************************************' +
        '*************************************************'
      '1101241891=  IF (IS_SPISANIE_ <> 3) THEN BEGIN'
      
        '1101241892=      -- '#1042#1054#1057#1057#1058#1040#1053#1040#1042#1051#1048#1042#1040#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045', ' +
        #1055#1054#1058#1054#1052' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' INS_ZAKAZ '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1054#1058#1053#1048#1052#1045#1058#1068#1057#1071
      '1101241893=      FOR SELECT T.AMOUNT, T.G_PRODUCT'
      '1101241894=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101241895=            INTO :AMOUNT_,'
      '1101241896=                 :G_PRODUCT_'
      '1101241897=      DO BEGIN'
      '1101241898=          UPDATE LT_SKLAD_PRODUCT L'
      '1101241899=             SET L.AMOUNT = L.AMOUNT + :AMOUNT_'
      '1101241900=           WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1101241901=             AND L.G_TOCHKA = :G_TOCHKA_;'
      '1101241902=      END'
      '1101241903='
      '1101241904=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' ZAKAZ_DETAILS_TMP'
      
        '1101241905=      INSERT INTO ZAKAZ_DETAILS_TMP(ZAKAZ_DETAILS, ZA' +
        'KAZ, G_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TEN' +
        'GE,'
      
        '1101241906=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM, COST_PRICE)'
      
        '1101241907=      SELECT ZAKAZ_DETAILS, ZAKAZ, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE, DISCOUNT_SUMM, NDS,'
      '1101241908=             NDS_SUMM, COST_PRICE'
      '1101241909=      FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101241910='
      '1101241911=      EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      '1101241912=                                  :Z_DATE_,'
      '1101241913=                                  :Z_TIME_,'
      '1101241914=                                  :G_CLIENT_,'
      '1101241915=                                  :G_PAYMENT_TYPE_,'
      '1101241916=                                  :OSNOVANIE_,'
      
        '1101241917=                                  :IS_SPISANIE_,   --' +
        ' :IS_SPISANIE_'
      '1101241918=                                  :NOTE_,'
      
        '1101241919=                                  :SUMM_,  -- '#1057#1059#1052#1052#1040' '#1047 +
        #1040#1050#1040#1047#1040
      
        '1101241920=                                  :SUMM_FACT_,  -- '#1048' ' +
        #1057#1059#1052#1052#1040' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1040#1071' '#1042' '#1069#1058#1054#1052' '#1057#1051#1059#1063#1040#1045' '#1041#1059#1044#1059#1058' '#1057#1054#1042#1055#1040#1044#1040#1058#1068
      
        '1101241921=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 1, SUMM_FACT_, 0),'
      
        '1101241922=                                  DECODE(G_PAYMENT_TY' +
        'PE_, 2, SUMM_FACT_, 0),'
      '1101241923=                                  0, --SUMM_BONUS_'
      
        '1101241924=                                  0, --SUMM_BONUS_GOT' +
        '_'
      
        '1101241925=                                  null,         -- '#1057#1058 +
        #1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040
      
        '1101241926=                                  0,            -- '#1057#1059 +
        #1052#1052#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1044#1054#1055'. '#1057#1058#1040#1058#1068#1045
      '1101241927=                                  0,    --BY_RECIPE'
      '1101241928=                                  0     --IS_RESERVE'
      '1101241929=                                  ,NULL  -- PAYMENTS_'
      '1101241930=                                  ,0     --IS_MEBEL_'
      
        '1101241931=                                  ,NULL  --DOSTAVSHIK' +
        '_'
      
        '1101241932=                                  ,NULL  --DELIVERY_D' +
        'ATE'
      '1101241933=                                  ,NULL  --ADDRESS_'
      '1101241934=                                  ,NULL  --PRICE_'
      '1101241935=                                  ,UPLOAD_TO_EXT_APP_'
      '1101241936=                                  )'
      '1101241937=      RETURNING_VALUES :ZAKAZ_, :ERR_CODE, :ERR_MSG;'
      '1101241938='
      '1101241939=      if (ERR_CODE <> 0) then BEGIN'
      '1101241940=        ERR_CODE = -20500;'
      '1101241941=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101241942=        Exit;'
      '1101241943=      END'
      '1101241944='
      
        '1101241945=      -- '#1058'.'#1050'. '#1057#1054#1047#1044#1040#1051#1057#1071' '#1047#1040#1050#1040#1047' '#1050#1040#1050' '#1054#1041#1067#1063#1053#1067#1049' - '#1044#1045#1051#1040#1070' '#1045#1052#1059' ' +
        #1040#1055#1044#1045#1049#1058' '#1055#1054#1051#1071' ZAKAZ.IS_SPISANIE = 2, '#1058#1048#1055#1040' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1042#1067#1044#1040#1053#1053#1067#1049 +
        ' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '1101241946=      -- '#1057#1056#1040#1047#1059' '#1053#1045' '#1052#1054#1043#1059', '#1058'.'#1050'. '#1055#1056#1054#1062#1045#1044#1059#1056#1040' INS_ZAKAZ '#1058#1054#1043#1044 +
        #1040' '#1048#1044#1045#1058' '#1055#1054' '#1044#1056#1059#1043#1054#1049' '#1042#1045#1058#1050#1045
      
        '1101241947=      -- '#1044#1045#1051#1040#1070' '#1069#1058#1054', '#1063#1058#1054#1041#1067' '#1055#1054#1058#1054#1052' '#1042' '#1054#1058#1063#1045#1058#1045' '#1054' '#1055#1056#1048#1041#1067#1051#1048', '#1054 +
        #1055#1051#1040#1063#1045#1053#1053#1067#1045' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051', '#1042#1067#1061#1054#1044#1048#1051#1048' '#1054#1058#1044#1045#1051#1068#1053#1067#1052#1048' '#1057#1058#1056#1054#1050#1040#1052#1048' '#1042#1053#1048#1047#1059'. '#1042 +
        #1045#1044#1068' '#1061#1054#1063#1045#1058#1057#1071' '#1059#1042#1048#1044#1045#1058#1068
      
        '1101241948=      -- '#1048#1047' '#1054#1041#1065#1045#1049' '#1050#1040#1056#1058#1048#1053#1067' '#1055#1056#1054#1044#1040#1046', '#1057#1050#1054#1051#1068#1050#1054' '#1055#1056#1048#1041#1067#1051#1048' '#1055#1054#1051 +
        #1059#1063#1045#1053#1054' '#1048#1052#1045#1053#1053#1054' '#1047#1040' '#1058#1054#1042#1040#1056#1067' '#1055#1054#1044' '#1056#1045#1040#1051
      '1101241949=      UPDATE ZAKAZ'
      '1101241950=         SET IS_SPISANIE = 2'
      '1101241951=       WHERE ZAKAZ = :ZAKAZ_;'
      '1101241952='
      
        '1101241953=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101241954=      FOR SELECT T.AMOUNT,'
      '1101241955=                 T.SUMM,'
      '1101241956=                 T.G_PRODUCT,'
      '1101241957=                 T.ZAKAZ_NA_REAL,'
      '1101241958=                 T.ZAKAZ_DETAILS'
      '1101241959=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101241960=            INTO :AMOUNT_,'
      '1101241961=                 :Z_SUMM_,'
      '1101241962=                 :G_PRODUCT_,'
      '1101241963=                 :ZAKAZ_NA_REAL_,'
      '1101241964=                 :ZAKAZ_DETAILS_'
      '1101241965=      DO BEGIN'
      '1101241966=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101241967=         SET ZR.AMOUNT_PAYED = ZR.AMOUNT_PAYED + :AMO' +
        'UNT_,'
      
        '1101241968=             ZR.SUMM_PAYED   = ZR.SUMM_PAYED + :Z_SUM' +
        'M_,'
      
        '1101241969=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101241970=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101241971='
      
        '1101241972=        -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041 +
        ' ZAKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101241973=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, ZAKAZ_DETAILS)'
      
        '1101241974=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, :ZAKAZ_DETAILS_);'
      '1101241975=      END'
      '1101241976=  END'
      '1101241977=  --  '#1050#1054#1053#1045#1062' '#1042#1067#1044#1040#1063#1040' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101241978=  --*************************************************' +
        '*************************************************'
      
        '1101241979=  --*************************************************' +
        '*************************************************'
      '1101241980='
      
        '1101241981=  --*************************************************' +
        '*************************************************'
      
        '1101241982=  --*************************************************' +
        '*************************************************'
      '1101241983=  -- '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101241984=  --*************************************************' +
        '*************************************************'
      
        '1101241985=  --*************************************************' +
        '*************************************************'
      '1101241986=  ELSE BEGIN'
      '1101241987=      -- '#1055#1045#1056#1045#1053#1054#1064#1059' '#1042#1057#1045' '#1042' SKLAD_TMP '#1048' '#1055#1054#1055#1059#1058#1053#1054
      
        '1101241988=      -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1047#1040#1055#1048#1057#1068' '#1042' '#1057#1042#1071#1047#1059#1070#1065#1059#1070' '#1058#1040#1041#1051#1048#1062#1059'. '#1057#1042#1071#1047#1041' Z' +
        'AKAZ_DETAILS - ZAKAZ_REAL'
      
        '1101241989=      -- '#1054#1041#1053#1054#1042#1051#1071#1070' '#1058#1040#1041#1051#1048#1062#1059' ZAKAZ_NA_REAL - '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' ' +
        #1054#1055#1051#1040#1063#1045#1053#1053#1054#1043#1054' '#1048' '#1058#1044
      '1101241990=      FOR SELECT T.AMOUNT,'
      '1101241991=                 T.SUMM,'
      '1101241992=                 T.G_PRODUCT,'
      '1101241993=                 T.ZAKAZ_NA_REAL,'
      '1101241994=                 T.ZAKAZ_DETAILS'
      '1101241995=                 ,T.PRICE'
      '1101241996=                 ,T.NDS'
      '1101241997=                 ,T.NDS_SUMM'
      '1101241998=            FROM ZAKAZ_DETAILS_TMP_REAL T'
      '1101241999=            INTO :AMOUNT_,'
      '1101242000=                 :Z_SUMM_,'
      '1101242001=                 :G_PRODUCT_,'
      '1101242002=                 :ZAKAZ_NA_REAL_,'
      '1101242003=                 :ZAKAZ_DETAILS_'
      '1101242004=                 ,:PRICE_'
      '1101242005=                 ,:NDS_'
      '1101242006=                 ,:NDS_SUMM_'
      '1101242007=      DO BEGIN'
      
        '1101242008=        INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOU' +
        'NT, PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101242009=        VALUES(GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT' +
        '_, :AMOUNT_, :PRICE_, :Z_SUMM_, :NDS_, :NDS_SUMM_);'
      '1101242010='
      
        '1101242011=        INSERT INTO LT_ZAKAZ_REAL (LT_ZAKAZ_REAL, ZAK' +
        'AZ_NA_REAL, SKLAD)'
      
        '1101242012=        VALUES (GEN_ID(GEN_LT_ZAKAZ_REAL, 1), :ZAKAZ_' +
        'NA_REAL_, GEN_ID(GEN_DETAILS_TMP, 0));'
      '1101242013='
      '1101242014=        UPDATE ZAKAZ_NA_REAL ZR'
      
        '1101242015=         SET ZR.AMOUNT_RETURNED = COALESCE(ZR.AMOUNT_' +
        'RETURNED, 0) + :AMOUNT_,'
      
        '1101242016=             ZR.SUMM_RETURNED   = COALESCE(ZR.SUMM_RE' +
        'TURNED, 0) + :Z_SUMM_,'
      
        '1101242017=             ZR.IS_PAYED_ALL = DECODE(ZR.AMOUNT_ALL, ' +
        'COALESCE(ZR.AMOUNT_PAYED, 0) + COALESCE(ZR.AMOUNT_RETURNED, 0) +' +
        ' :AMOUNT_, 1, 0)'
      '1101242018=        WHERE ZR.ZAKAZ_NA_REAL = :ZAKAZ_NA_REAL_;'
      '1101242019=      END'
      '1101242020='
      '1101242021=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '1101242022=                                  :Z_DATE_,'
      '1101242023=                                  :Z_TIME_,'
      '1101242024=                                  :G_CLIENT_,'
      '1101242025=                                  :G_PAYMENT_TYPE_,'
      '1101242026=                                  :OSNOVANIE_,'
      '1101242027=                                  :NOTE_,'
      
        '1101242028=                                  2,        --:IS_VOZ' +
        'VRAT_,   -- '#1055#1045#1056#1045#1044#1040#1070' '#1057#1070#1044#1040' 2, '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' '#1041#1059#1044#1059' '#1040#1053#1040#1051#1048#1047#1048#1056#1054#1042#1040#1058#1068' '#1069#1058#1059' 2' +
        '-'#1050#1059
      '1101242029=                                  :SUMM_,'
      '1101242030=                                  :SUMM_FACT_,'
      
        '1101242031=                                  NULL,     --:G_PRIH' +
        'OD_,'
      
        '1101242032=                                  NULL      --:SUMM_P' +
        'RIHOD_'
      
        '1101242033=                                  ,NULL     -- PAYMEN' +
        'TS'
      
        '1101242034=                                  ) RETURNING_VALUES ' +
        ':SKLAD_, :ERR_CODE, :ERR_MSG;'
      '1101242035='
      '1101242036=      if (ERR_CODE <> 0) then BEGIN'
      '1101242037=        ERR_CODE = -20500;'
      '1101242038=        ERR_MSG = PROCNAME||'#39' -> '#39'||ERR_MSG;'
      '1101242039=        Exit;'
      '1101242040=      END'
      '1101242041=  END'
      '1101242042=  --  '#1050#1054#1053#1045#1062' '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040', '#1042#1067#1044#1040#1053#1053#1054#1043#1054' '#1055#1054#1044' '#1056#1045#1040#1051#1048#1047#1040#1062#1048#1070
      
        '1101242043=  --*************************************************' +
        '*************************************************'
      
        '1101242044=  --*************************************************' +
        '*************************************************'
      '1101242045='
      '1101242046=  DELETE FROM ZAKAZ_DETAILS_TMP_REAL;'
      '1101242047=END'
      '1101242048=;'
      '1101242049='
      '1101242050=ALTER PROCEDURE R_UNIFICATION('
      '1101242051=  MODE_ INTEGER)'
      '1101242052=RETURNS ('
      '1101242053=  COUNT_SPIS_ INTEGER,'
      '1101242054=  COUNT_PRIH_ INTEGER,'
      '1101242055=  ERR_CODE INTEGER,'
      '1101242056=  ERR_MSG VARCHAR(1024))'
      '1101242057=AS'
      
        '1101242058=DECLARE VARIABLE PROCNAME VARCHAR(15) = '#39'R_UNIFICATIO' +
        'N'#39';'
      '1101242059=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1101242060=DECLARE VARIABLE REVISION_ TYPE OF COLUMN REVISION.RE' +
        'VISION;'
      
        '1101242061=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN REVISION.G' +
        '_PRODUCT;'
      
        '1101242062=DECLARE VARIABLE AMOUNT_BD_ TYPE OF COLUMN REVISION.A' +
        'MOUNT_BD;'
      
        '1101242063=DECLARE VARIABLE AMOUNT_REAL_ TYPE OF COLUMN REVISION' +
        '.AMOUNT_REAL;'
      
        '1101242064=DECLARE VARIABLE PRICE_LAST_ TYPE OF COLUMN SKLAD.PRI' +
        'CE;'
      '1101242065=DECLARE VARIABLE ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ;'
      
        '1101242066=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SU' +
        'MM;'
      
        '1101242067=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'KLAD;'
      
        '1101242068=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      
        '1101242069=DECLARE VARIABLE COST_PRICE_ TYPE OF COLUMN ZAKAZ_DET' +
        'AILS.COST_PRICE;'
      '1101242070=BEGIN'
      '1101242071='
      '1101242072=  COUNT_SPIS_ = 0;'
      '1101242073=  COUNT_PRIH_ = 0;'
      '1101242074='
      '1101242075=  SELECT ID'
      '1101242076=    FROM CUR_PARAMS'
      '1101242077=   WHERE CUR_PARAMS = 2'
      '1101242078=    INTO :G_TOCHKA_;'
      '1101242079='
      
        '1101242080=  FOR SELECT REVISION, G_PRODUCT, AMOUNT_BD, AMOUNT_R' +
        'EAL'
      '1101242081=      FROM REVISION'
      '1101242082=      WHERE G_TOCHKA = :G_TOCHKA_'
      
        '1101242083=      INTO :REVISION_, :G_PRODUCT_, :AMOUNT_BD_, :AMO' +
        'UNT_REAL_'
      '1101242084=  DO BEGIN'
      
        '1101242085=    IF ((AMOUNT_BD_ > AMOUNT_REAL_) and (MODE_ in (0,' +
        '2))) THEN BEGIN'
      
        '1101242086=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_, NULL, 1)'
      '1101242087=        RETURNING_VALUES :COST_PRICE_;'
      '1101242088='
      
        '1101242089=      INSERT INTO ZAKAZ_DETAILS_TMP (ZAKAZ_DETAILS, G' +
        '_PRODUCT, AMOUNT, PRICE, SUMM, DISCOUNT_PERC, DISCOUNT_TENGE,'
      
        '1101242090=                                     DISCOUNT_SUMM, N' +
        'DS, NDS_SUMM)'
      
        '1101242091=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_BD_ - :AMOUNT_REAL_, :COST_PRICE_, :COST_PRICE_ * (:AM' +
        'OUNT_BD_ - :AMOUNT_REAL_), 0, 0, 0, 0, 0);'
      '1101242092='
      '1101242093=      COUNT_SPIS_ = COUNT_SPIS_ + 1;'
      '1101242094=    END'
      '1101242095='
      
        '1101242096=    if ((AMOUNT_BD_ < AMOUNT_REAL_) and (MODE_ in (0,' +
        '1))) then BEGIN'
      '1101242097=      SELECT S.price'
      '1101242098=        FROM SKLAD S'
      '1101242099=       WHERE S.IS_VOZVRAT IN (0, 4)'
      '1101242100=         AND S.g_product = :G_PRODUCT_'
      '1101242101=         AND S.G_TOCHKA = :G_TOCHKA_'
      
        '1101242102=         AND S.date_receipt = (SELECT MAX(DD.DATE_REC' +
        'EIPT)'
      '1101242103=                                 FROM SKLAD DD'
      
        '1101242104=                                WHERE DD.g_product = ' +
        ':G_PRODUCT_'
      
        '1101242105=                                  AND DD.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '1101242106=                                  AND DD.IS_VOZVRAT I' +
        'N (0, 4)'
      '1101242107=                                )'
      '1101242108=        ORDER BY s.sklad DESC'
      '1101242109=        ROWS 1 TO 1'
      '1101242110=        INTO :PRICE_LAST_;'
      '1101242111='
      '1101242112=    /* SELECT S.PRICE'
      '1101242113=        FROM SKLAD S'
      '1101242114=       WHERE S.IS_LAST = 1'
      '1101242115=         AND S.G_PRODUCT = :G_PRODUCT_'
      '1101242116=         AND S.G_TOCHKA = :G_TOCHKA_'
      '1101242117=        INTO :PRICE_LAST_; */'
      '1101242118='
      
        '1101242119=      PRICE_LAST_ = COALESCE(PRICE_LAST_, 0);   -- '#1042#1044 +
        #1056#1059#1043' '#1053#1048#1063#1045#1043#1054' '#1053#1045' '#1053#1040#1049#1044#1045#1053#1054
      '1101242120='
      
        '1101242121=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT' +
        ', PRICE, SUMM, NDS, NDS_SUMM)'
      
        '1101242122=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_' +
        ', :AMOUNT_REAL_ - :AMOUNT_BD_, :PRICE_LAST_, (:AMOUNT_REAL_ - :A' +
        'MOUNT_BD_) * :PRICE_LAST_, 0, 0);'
      '1101242123='
      '1101242124=      COUNT_PRIH_ = COUNT_PRIH_ + 1;'
      '1101242125=    END'
      '1101242126='
      '1101242127=    UPDATE REVISION R'
      '1101242128=       SET R.IS_UNIFIED = 1'
      '1101242129=     WHERE R.REVISION = :REVISION_;'
      '1101242130=  END'
      '1101242131='
      '1101242132=  PNT_ = '#39'01'#39';'
      '1101242133=  IF (COUNT_SPIS_ > 0 ) THEN BEGIN'
      '1101242134=    SELECT SUM(S.SUMM)'
      '1101242135=      FROM ZAKAZ_DETAILS_TMP S'
      '1101242136=      INTO :SUMM_;'
      '1101242137='
      '1101242138=    EXECUTE PROCEDURE INS_ZAKAZ(:G_TOCHKA_,'
      
        '1101242139=                                CURRENT_DATE, --:Z_DA' +
        'TE_,'
      
        '1101242140=                                CURRENT_TIME, --:Z_TI' +
        'ME'
      
        '1101242141=                                10,          --:G_CLI' +
        'ENT_,   '#1063#1040#1057#1058#1053#1054#1045' '#1051#1048#1062#1054
      
        '1101242142=                                1,            --:G_PA' +
        'YMENT_TYPE_,'
      
        '1101242143=                                NULL,         --:OSNO' +
        'VANIE_,'
      
        '1101242144=                                1,              --:IS' +
        '_SPISANIE_,'
      
        '1101242145=                                NULL,           --:NO' +
        'TE_,'
      
        '1101242146=                                :SUMM_,              ' +
        '--:SUMM_,'
      
        '1101242147=                                :SUMM_,              ' +
        '--:SUMM_FACT_,'
      
        '1101242148=                                0,              --SUM' +
        'M_BONUS_'
      
        '1101242149=                                0,              --SUM' +
        'M_BONUS_GOT'
      
        '1101242150=                                NULL,           --:G_' +
        'PRIHOD_,'
      '1101242151=                                NULL,'
      
        '1101242152=                                0,        -- BY_RECIP' +
        'E'
      
        '1101242153=                                0         -- IS_RESER' +
        'VE'
      '1101242154=                                ,NULL  -- PAYMENTS_'
      '1101242155=                                ,0     -- SUMM_CASH'
      
        '1101242156=                                ,0     -- SUMM_NONCAS' +
        'H'
      
        '1101242157=                                ) RETURNING_VALUES :Z' +
        'AKAZ_, :ERR_CODE, :ERR_MSG;'
      '1101242158=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101242159=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101242160=      EXIT;'
      '1101242161=    END'
      '1101242162=  END'
      '1101242163='
      '1101242164=  PNT_ = '#39'02'#39';'
      '1101242165=  IF (COUNT_PRIH_ > 0) THEN BEGIN'
      '1101242166=    SELECT SUM(S.SUMM)'
      '1101242167=      FROM SKLAD_TMP S'
      '1101242168=      INTO :SUMM_;'
      '1101242169='
      '1101242170=    EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      
        '1101242171=                                CURRENT_DATE,   --:DA' +
        'TE_RECEIPT_,'
      '1101242172=                                CURRENT_TIME,'
      
        '1101242173=                                NULL,           --:G_' +
        'CLIENT_,'
      
        '1101242174=                                1,              --:G_' +
        'PAYMENT_TYPE_,'
      
        '1101242175=                                NULL,           --:OS' +
        'NOVANIE_,'
      
        '1101242176=                                '#39#1056#1045#1042#1048#1047#1048#1071' '#1054#1057#1058#1040#1058#1050#1054#1042#39',  ' +
        '         --:NOTE_,'
      
        '1101242177=                                5,              --:IS' +
        '_VOZVRAT_,'
      '1101242178=                                :SUMM_,'
      '1101242179=                                :SUMM_,'
      
        '1101242180=                                NULL,           --:G_' +
        'PRIHOD_,'
      
        '1101242181=                                NULL            --:SU' +
        'MM_PRIHOD_'
      '1101242182=                                ,NULL  --PAYMENTS'
      '1101242183=                                )'
      
        '1101242184=        RETURNING_VALUES :SKLAD_, :ERR_CODE, :ERR_MSG' +
        ';'
      '1101242185=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101242186=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1101242187=      EXIT;'
      '1101242188=    END'
      '1101242189=  END'
      '1101242190=END'
      '1101242191=;'
      
        '1101242192=UPDATE SYSTEM_SETUP SET S_VALUE = 110124 WHERE SYSTEM' +
        '_SETUP = 3;'
      
        '1101242193=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, ' +
        'RDB$DESCRIPTION=NULL;'
      '1101242194=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101250=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD('
      '1101251=  OBJECT_TYPE_ INTEGER)'
      '1101252=RETURNS ('
      '1101253=  OPER /* TYPE OF COLUMN SYNC_EXT_APP.OPER */ INTEGER,'
      '1101254=  ZAKAZ /* TYPE OF COLUMN ZAKAZ.ZAKAZ */ BIGINT,'
      '1101255=  Z_DATE /* TYPE OF COLUMN ZAKAZ.Z_DATE */ DATE,'
      '1101256=  Z_TIME /* TYPE OF COLUMN ZAKAZ.Z_TIME */ TIME,'
      
        '1101257=  OSNOVANIE /* TYPE OF COLUMN ZAKAZ.OSNOVANIE */ VARCHAR' +
        '(150),'
      '1101258=  NOTE /* TYPE OF COLUMN ZAKAZ.NOTE */ VARCHAR(200),'
      
        '1101259=  CLIENT_ID /* TYPE OF COLUMN G_CLIENT.G_CLIENT */ BIGIN' +
        'T,'
      '11012510=  IDN /* TYPE OF COLUMN G_CLIENT.IDN */ VARCHAR(12),'
      
        '11012511=  CLIENT_NAME /* TYPE OF COLUMN G_CLIENT.NAME */ VARCHA' +
        'R(250),'
      
        '11012512=  SKLAD_NAME /* TYPE OF COLUMN G_TOCHKA.NAME */ VARCHAR' +
        '(250),'
      
        '11012513=  SUMM_CASH /* TYPE OF COLUMN ZAKAZ.SUMM_CASH */ NUMERI' +
        'C(15,2),'
      
        '11012514=  SUMM_NONCASH /* TYPE OF COLUMN ZAKAZ.SUMM_NONCASH */ ' +
        'NUMERIC(15,2),'
      '11012515=  SUMM_SERT /* MY_NUMERIC */ NUMERIC(15,2),'
      
        '11012516=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11012517=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11012518=  NOMENCLATUR_NUM /* TYPE OF COLUMN G_PRODUCT.NOMENCLAT' +
        'UR_NUM */ VARCHAR(150),'
      
        '11012519=  TOVAR_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARCHA' +
        'R(250),'
      
        '11012520=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT */ NUME' +
        'RIC(18,5),'
      
        '11012521=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS.PRICE */ NUMERI' +
        'C(15,2),'
      
        '11012522=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS.SUMM */ NUMERIC(' +
        '15,2),'
      
        '11012523=  SYNC_EXT_APP /* TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_' +
        'APP */ BIGINT)'
      '11012524=AS'
      '11012525=BEGIN'
      '11012526=  SUSPEND;'
      '11012527=END'
      '11012528=;'
      '11012529='
      '11012530='
      
        '11012531=/******************************************************' +
        '************************/'
      
        '11012532=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11012533=/******************************************************' +
        '************************/'
      '11012534=ALTER PROCEDURE SYNC_EXT_APP_UPLOAD('
      '11012535=  OBJECT_TYPE_ INTEGER)'
      '11012536=RETURNS ('
      '11012537=  OPER TYPE OF COLUMN SYNC_EXT_APP.OPER,'
      '11012538=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '11012539=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '11012540=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '11012541=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '11012542=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '11012543=  CLIENT_ID TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '11012544=  IDN TYPE OF COLUMN G_CLIENT.IDN,'
      '11012545=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '11012546=  SKLAD_NAME TYPE OF COLUMN G_TOCHKA.NAME,'
      '11012547=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '11012548=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '11012549=  SUMM_SERT MY_NUMERIC,'
      '11012550=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '11012551=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      
        '11012552=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11012553=  TOVAR_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11012554=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '11012555=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS.PRICE,'
      '11012556=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS.SUMM,'
      
        '11012557=  SYNC_EXT_APP TYPE OF COLUMN SYNC_EXT_APP.SYNC_EXT_APP' +
        ')'
      '11012558=AS'
      '11012559=/*'
      '11012560=*/'
      '11012561=BEGIN'
      '11012562=  FOR SELECT S.OPER'
      '11012563=              ,Z.ZAKAZ'
      '11012564=              ,Z.Z_DATE'
      '11012565=              ,Z.Z_TIME'
      '11012566=              ,C.G_CLIENT ID'
      '11012567=              ,C.IDN'
      '11012568=              ,C.NAME CLIENT_NAME'
      '11012569=              ,G.NAME SKLAD_NAME'
      '11012570=              ,Z.SUMM_CASH'
      '11012571=              ,Z.SUMM_NONCASH'
      '11012572=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '11012573=              ,P.ARTICUL'
      '11012574=              ,P.BARCODE'
      '11012575=              ,P.NOMENCLATUR_NUM'
      '11012576=              ,P.NAME'
      '11012577=              ,ZD.AMOUNT'
      '11012578=              ,ZD.PRICE - ZD.DISCOUNT_TENGE PRICE'
      '11012579=              ,ZD.SUMM'
      '11012580=              ,S.SYNC_EXT_APP'
      '11012581=              ,Z.OSNOVANIE'
      '11012582=              ,Z.NOTE'
      '11012583=         FROM SYNC_EXT_APP S'
      '11012584=              ,ZAKAZ Z'
      '11012585=              ,ZAKAZ_DETAILS ZD'
      '11012586=              ,G_TOCHKA G'
      '11012587=              ,G_CLIENT C'
      '11012588=              ,G_PRODUCT P'
      '11012589=        WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '11012590=          AND S.OBJECT_TYPE = 1'
      '11012591=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '11012592=          AND S.ID = Z.ZAKAZ'
      '11012593=          AND Z.ZAKAZ = ZD.ZAKAZ'
      '11012594=          AND Z.G_TOCHKA = G.G_TOCHKA'
      '11012595=          AND Z.G_CLIENT = C.G_CLIENT'
      '11012596=          AND ZD.G_PRODUCT = P.G_PRODUCT'
      '11012597=        UNION ALL'
      '11012598=        SELECT S.OPER'
      '11012599=               ,S.ID'
      '110125100=               ,NULL Z_DATE'
      '110125101=               ,NULL Z_TIME'
      '110125102=               ,NULL ID'
      '110125103=               ,NULL IDN'
      '110125104=               ,NULL CLIENT_NAME'
      '110125105=               ,NULL SKLAD_NAME'
      '110125106=               ,0 SUMM_CASH'
      '110125107=               ,0 SUMM_NONCASH'
      '110125108=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110125109=               ,NULL ARTICUL'
      '110125110=               ,NULL BARCODE'
      '110125111=               ,NULL NOMENCLATUR_NUM'
      '110125112=               ,NULL'
      '110125113=               ,0 AMOUNT'
      '110125114=               ,0 PRICE'
      '110125115=               ,0 SUMM'
      '110125116=               ,S.SYNC_EXT_APP'
      '110125117=               ,NULL OSNOVANIE'
      '110125118=               ,NULL NOTE'
      '110125119=          FROM SYNC_EXT_APP S'
      '110125120=         WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110125121=           AND S.OBJECT_TYPE = 1'
      '110125122=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110125123=        UNION ALL'
      '110125124=        SELECT S.OPER'
      '110125125=              ,SP.SKLAD ZAKAZ'
      '110125126=              ,SP.DATE_RECEIPT Z_DATE'
      '110125127=              ,NULL Z_TIME'
      '110125128=              ,C.G_CLIENT ID'
      '110125129=              ,C.IDN'
      '110125130=              ,C.NAME CLIENT_NAME'
      '110125131=              ,G.NAME SKLAD_NAME'
      
        '110125132=              ,(SELECT SUM(KS.SUMM) FROM KASSA KS WHER' +
        'E KS.SKLAD = SP.SKLAD) SUMM_CASH'
      
        '110125133=              ,(SELECT SUM(KS.SUMM) FROM KASSA_BEZNAL ' +
        'KS WHERE KS.SKLAD = SP.SKLAD) SUMM_NONCASH'
      '110125134=              ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110125135=              ,P.ARTICUL'
      '110125136=              ,P.BARCODE'
      '110125137=              ,P.NOMENCLATUR_NUM'
      '110125138=              ,P.NAME'
      '110125139=              ,SD.AMOUNT'
      '110125140=              ,SD.PRICE'
      '110125141=              ,SD.SUMM'
      '110125142=              ,S.SYNC_EXT_APP'
      '110125143=              ,SP.OSNOVANIE'
      '110125144=              ,SP.NOTE'
      '110125145=         FROM SYNC_EXT_APP S'
      '110125146=              ,SKLAD_PARENT SP'
      '110125147=              ,SKLAD SD'
      '110125148=              ,G_TOCHKA G'
      '110125149=              ,G_CLIENT C'
      '110125150=              ,G_PRODUCT P'
      '110125151=        WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110125152=          AND S.OBJECT_TYPE = 2'
      '110125153=          AND S.OPER <> 3        -- '#1050#1056#1054#1052#1045' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110125154=          AND S.ID = SP.SKLAD'
      '110125155=          AND SP.SKLAD = SD.SKLAD_PARENT'
      '110125156=          AND SP.G_TOCHKA = G.G_TOCHKA'
      '110125157=          AND SP.G_CLIENT = C.G_CLIENT'
      '110125158=          AND SD.G_PRODUCT = P.G_PRODUCT'
      '110125159=        UNION ALL'
      '110125160=        SELECT S.OPER'
      '110125161=               ,S.ID'
      '110125162=               ,NULL Z_DATE'
      '110125163=               ,NULL Z_TIME'
      '110125164=               ,NULL ID'
      '110125165=               ,NULL IDN'
      '110125166=               ,NULL CLIENT_NAME'
      '110125167=               ,NULL SKLAD_NAME'
      '110125168=               ,0 SUMM_CASH'
      '110125169=               ,0 SUMM_NONCASH'
      '110125170=               ,0 SUMM_SERT        -- '#1053#1040' '#1041#1059#1044#1059#1065#1045#1045
      '110125171=               ,NULL ARTICUL'
      '110125172=               ,NULL BARCODE'
      '110125173=               ,NULL NOMENCLATUR_NUM'
      '110125174=               ,NULL'
      '110125175=               ,0 AMOUNT'
      '110125176=               ,0 PRICE'
      '110125177=               ,0 SUMM'
      '110125178=               ,S.SYNC_EXT_APP'
      '110125179=               ,NULL OSNOVANIE'
      '110125180=               ,NULL NOTE'
      '110125181=          FROM SYNC_EXT_APP S'
      '110125182=         WHERE S.OBJECT_TYPE = :OBJECT_TYPE_'
      '110125183=           AND S.OBJECT_TYPE = 2'
      '110125184=           AND S.OPER = 3        -- '#1058#1054#1051#1068#1050#1054' '#1059#1044#1040#1051#1045#1053#1048#1071
      '110125185=        ORDER BY 1, 3, 4, 2, 10'
      '110125186=         INTO :OPER,'
      '110125187=              :ZAKAZ,'
      '110125188=              :Z_DATE,'
      '110125189=              :Z_TIME,'
      '110125190=              :CLIENT_ID,'
      '110125191=              :IDN,'
      '110125192=              :CLIENT_NAME,'
      '110125193=              :SKLAD_NAME,'
      '110125194=              :SUMM_CASH,'
      '110125195=              :SUMM_NONCASH,'
      '110125196=              :SUMM_SERT,'
      '110125197=              :ARTICUL,'
      '110125198=              :BARCODE,'
      '110125199=              :NOMENCLATUR_NUM,'
      '110125200=              :TOVAR_NAME,'
      '110125201=              :AMOUNT,'
      '110125202=              :PRICE,'
      '110125203=              :SUMM,'
      '110125204=              :SYNC_EXT_APP,'
      '110125205=              :OSNOVANIE,'
      '110125206=              :NOTE'
      '110125207=  DO'
      '110125208=    SUSPEND;'
      '110125209=END'
      '110125210=;'
      
        '110125211=UPDATE SYSTEM_SETUP SET S_VALUE = 110125 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110125212=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110125213=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101260=ALTER PROCEDURE P_REP_PRICE_LIST('
      '1101261=  G_CATEGORY_ BLOB SUB_TYPE 1,'
      '1101262=  INCLUDE_NOL_ INTEGER,'
      '1101263=  INCLUDE_FEW_ INTEGER,'
      '1101264=  SORT_BY_NAME_ INTEGER,'
      '1101265=  G_CLIENT_ TYPE OF COLUMN G_CLIENT.G_CLIENT,'
      '1101266=  G_TOCHKA_ARR_ BLOB SUB_TYPE 1 = '#39#39')'
      '1101267=RETURNS ('
      '1101268=  PERIOD_ VARCHAR(40),'
      '1101269=  ROW_NUM VARCHAR(15),'
      '11012610=  ARTICUL VARCHAR(1000),'
      '11012611=  BARCODE VARCHAR(30),'
      
        '11012612=  NOMENCLATUR_NUM TYPE OF COLUMN G_PRODUCT.NOMENCLATUR_' +
        'NUM,'
      '11012613=  NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '11012614=  UNIT_NAME TYPE OF COLUMN G_UNIT.NAME,'
      '11012615=  PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      '11012616=  VOLUME_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11012617=  SKIDKA_PRICE TYPE OF COLUMN G_PRODUCT.VOLUME_PRICE,'
      '11012618=  AMOUNT TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT,'
      
        '11012619=  AMOUNT_RESERVE TYPE OF COLUMN LT_SKLAD_PRODUCT.AMOUNT' +
        '_RESERVE,'
      '11012620=  SUMM TYPE OF COLUMN SKLAD.SUMM,'
      '11012621=  PRICE_SELF TYPE OF COLUMN SKLAD.PRICE,'
      '11012622=  SUMM_SELF TYPE OF COLUMN SKLAD.SUMM,'
      '11012623=  TOVAR_NAME VARCHAR(250),'
      '11012624=  CROSSCODE TYPE OF COLUMN G_PRODUCT.CROSSCODE,'
      '11012625=  NOTE TYPE OF COLUMN G_PRODUCT.NOTE,'
      '11012626=  IS_CATEGORY TYPE OF COLUMN G_PRODUCT.IS_CATEGORY,'
      '11012627=  PLACE TYPE OF COLUMN G_PRODUCT.PLACE,'
      '11012628=  ERR_CODE INTEGER,'
      '11012629=  ERR_MSG VARCHAR(1024))'
      '11012630=AS'
      '11012631=-- '#1055#1056#1054#1062#1045#1044#1059#1056#1040' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040
      
        '11012632=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'P_REP_PRICE_LI' +
        'ST'#39';'
      '11012633=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11012634=DECLARE VARIABLE I INTEGER = 1;'
      '11012635=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '11012636=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11012637=DECLARE VARIABLE PATH_ TYPE OF COLUMN G_PRODUCT.NAME; /' +
        '* '#1044#1051#1071' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1048' */'
      
        '11012638=DECLARE VARIABLE PATH_NAME_ TYPE OF COLUMN G_PRODUCT.NA' +
        'ME;'
      
        '11012639=DECLARE VARIABLE TOVAR_NAME_ TYPE OF COLUMN G_PRODUCT.N' +
        'AME;'
      
        '11012640=DECLARE VARIABLE FORMULA_ TYPE OF COLUMN SYSTEM_SETUP.S' +
        '_VALUE; /* '#1056#1040#1057#1063#1045#1058' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' '#1058#1054#1042#1040#1056#1040': 0 - '#1057#1056#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1047#1040#1050#1059#1055#1050#1048 +
        ', 1 - '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1062#1045#1053#1040' '#1055#1054#1057#1058#1059#1055#1051#1045#1053#1048#1071' */'
      
        '11012641=DECLARE VARIABLE SORT_COL_ TYPE OF COLUMN G_PRODUCT.NAM' +
        'E; /* '#1055#1057#1045#1042#1044#1054#1050#1054#1051#1054#1053#1050#1040', '#1050#1054#1058#1054#1056#1040#1071' '#1053#1045' '#1042#1067#1042#1054#1044#1048#1058#1057#1071' '#1042' '#1054#1058#1063#1045#1058', '#1053#1054' '#1055#1054' '#1053#1045#1049' '#1048#1044#1045 +
        #1058' '#1057#1054#1056#1058#1048#1056#1054#1042#1050#1040', '#1057#1054#1056#1058#1048#1056#1059#1045#1058#1057#1071' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1051#1048#1041#1054' '#1055#1054' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045#1070' '#1058#1054#1042#1040 +
        #1056#1040', '#1047#1040#1042#1048#1057#1048#1058' '#1054#1058' SORT_BY_NAME_ */'
      '11012642=BEGIN'
      '11012643='
      
        '11012644=  DELETE FROM P_REP_PRICE_LIST_TABLE WHERE P_REP_PRICE_' +
        'LIST_TABLE = P_REP_PRICE_LIST_TABLE;'
      '11012645=  EXECUTE PROCEDURE P_REP_BUILD_TREE(0, 0);'
      '11012646='
      '11012647=  SELECT S.S_VALUE'
      '11012648=    FROM SYSTEM_SETUP S'
      '11012649=   WHERE S.SYSTEM_SETUP = 1'
      '11012650=    INTO :FORMULA_;'
      '11012651='
      '11012652=  FOR SELECT GP.PATH,'
      '11012653=             GP.G_PRODUCT'
      '11012654=        FROM P_REP_TREE GP'
      '11012655=       WHERE EXISTS (SELECT 1'
      '11012656=                       FROM G_PRODUCT'
      '11012657=                      WHERE IS_CATEGORY = 0'
      
        '11012658=                        AND G_PRODUCT_PAR = GP.G_PRODUC' +
        'T'
      '11012659=                    )'
      
        '11012660=         AND ((:G_CATEGORY_ CONTAINING '#39'~'#39'||GP.G_PRODUC' +
        'T||'#39'~'#39' AND :G_CATEGORY_ IS NOT NULL)'
      '11012661=              OR'
      '11012662=              (:G_CATEGORY_ is NULL)'
      '11012663=             )'
      '11012664=       ORDER BY 1, 2'
      '11012665=       INTO :PATH_NAME_,'
      '11012666=            :G_PRODUCT_'
      '11012667=  DO BEGIN'
      
        '11012668=      -- '#1055#1054' '#1059#1057#1051#1054#1042#1048#1071#1052' '#1060#1048#1051#1068#1058#1056#1040' '#1052#1054#1046#1053#1054' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057 +
        ' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' '#1048#1051#1048' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1058#1054#1051#1068#1050#1054' '#1058#1045', '#1059' '#1050#1054#1058#1054#1056#1067#1061' '#1052#1040#1051#1054#1045' '#1050#1054#1051#1048#1063#1045 +
        #1057#1058#1042#1054
      
        '11012669=      -- '#1055#1054' '#1069#1058#1054#1052#1059' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1058#1059#1058' '#1057#1045#1051#1045#1050#1058' '#1044#1045#1051#1040#1058#1068' '#1048' '#1042#1050#1051#1070#1063#1040#1058#1068 +
        ' '#1048#1051#1048' '#1053#1045' '#1042#1050#1051#1070#1063#1040#1058#1068' '#1050#1040#1058#1045#1043#1054#1056#1048#1070
      '11012670=      SELECT COUNT(G.G_PRODUCT)'
      
        '11012671=        FROM G_PRODUCT G LEFT OUTER JOIN (SELECT SUM(LL' +
        '.AMOUNT) AMOUNT, LL.G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '11012672=                                          WHERE :G_TOCH' +
        'KA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PRODUCT) ' +
        'L ON G.G_PRODUCT = L.G_PRODUCT'
      '11012673=       WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '11012674=         -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '11012675=         AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AND (CO' +
        'ALESCE(:INCLUDE_FEW_, 0) = 0))'
      '11012676=              OR'
      
        '11012677=              ((L.AMOUNT > 0 AND COALESCE(:INCLUDE_NOL_' +
        ', 0) = 1)'
      '11012678=              or'
      
        '11012679=              (L.AMOUNT <= 5 AND COALESCE(:INCLUDE_FEW_' +
        ', 0) = 1))'
      '11012680=             )'
      '11012681=         -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '11012682=         AND ((EXISTS (SELECT 1'
      '11012683=                       FROM SKLAD S'
      '11012684=                      WHERE S.G_CLIENT = :G_CLIENT_'
      '11012685=                        AND S.G_PRODUCT = G.G_PRODUCT'
      
        '11012686=                        AND :G_TOCHKA_ARR_ CONTAINING '#39 +
        '-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '11012687=              OR'
      '11012688=              COALESCE(:G_CLIENT_, 0) = 0)'
      '11012689=        INTO :CNT_;'
      '11012690='
      '11012691=      IF (CNT_ > 0) THEN BEGIN'
      
        '11012692=        INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRICE' +
        '_LIST_TABLE, ARTICUL, IS_CATEGORY)'
      
        '11012693=        VALUES (GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1), ' +
        ':PATH_NAME_, 1);'
      '11012694='
      
        '11012695=          INSERT INTO P_REP_PRICE_LIST_TABLE (P_REP_PRI' +
        'CE_LIST_TABLE,'
      '11012696=                                              ARTICUL,'
      '11012697=                                              BARCODE,'
      
        '11012698=                                              NOMENCLAT' +
        'UR_NUM,'
      '11012699=                                              NAME,'
      
        '110126100=                                              UNIT_NAM' +
        'E,'
      '110126101=                                              PRICE,'
      
        '110126102=                                              VOLUME_P' +
        'RICE,'
      
        '110126103=                                              SKIDKA_P' +
        'RICE,'
      '110126104=                                              AMOUNT,'
      
        '110126105=                                              AMOUNT_R' +
        'ESERVE,'
      '110126106=                                              SUMM,'
      
        '110126107=                                              PRICE_SE' +
        'LF,'
      
        '110126108=                                              SORT_COL' +
        ','
      
        '110126109=                                              IS_CATEG' +
        'ORY,'
      '110126110=                                              NOTE,'
      
        '110126111=                                              CROSSCOD' +
        'E,'
      '110126112=                                              PLACE)'
      
        '110126113=          SELECT GEN_ID(GEN_P_REP_PRICE_LIST_TABLE, 1)' +
        ','
      '110126114=                 G.ARTICUL,'
      '110126115=                 G.BARCODE,'
      '110126116=                 G.NOMENCLATUR_NUM,'
      '110126117=                 G.NAME,'
      '110126118=                 U.SHORT_NAME,'
      '110126119=                 G.PRICE,'
      '110126120=                 G.VOLUME_PRICE,'
      '110126121=                 G.PRICE - GD.SKIDKA_SUM,'
      '110126122=                 COALESCE(S.AMOUNT, 0),'
      '110126123=                 COALESCE(S.AMOUNT_RESERVE, 0),'
      
        '110126124=                 CAST(COALESCE(S.AMOUNT, 0) AS MY_NUME' +
        'RIC) * G.PRICE,'
      '110126125=                 COALESCE((-- '#1048#1065#1059' '#1047#1040#1050#1059#1055#1054#1063#1053#1059#1070' '#1062#1045#1053#1059
      
        '110126126=                  -- '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071' '#1062#1045#1053#1040' '#1042' '#1047#1040#1042#1048#1057#1048#1052#1054#1057#1058#1048' '#1054#1058' ' +
        #1053#1040#1057#1058#1056#1054#1045#1050' '#1041#1059#1044#1045#1058' '#1057#1063#1048#1058#1040#1058#1068#1057#1071' '#1058#1040#1050
      
        '110126127=                  -- 0 - '#1057#1056#1045#1044#1053#1045#1045' '#1047#1053#1040#1063#1045#1053#1048#1045' '#1055#1054#1057#1051#1045#1044#1053#1048#1061' 5 ' +
        #1047#1040#1050#1059#1055#1054#1050
      '110126128=                  -- 1 - '#1062#1045#1053#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1047#1040#1050#1059#1055#1050#1048
      '110126129=                  DECODE(:FORMULA_,'
      '110126130=                         0,'
      
        '110126131=                         (SELECT ROUND(SUM(T.AMOUNT * ' +
        'T.PRICE)/SUM(T.AMOUNT), 2)'
      
        '110126132=                            FROM (SELECT S.AMOUNT, S.P' +
        'RICE'
      
        '110126133=                                    FROM SKLAD_PARENT ' +
        'SP,'
      '110126134=                                         SKLAD S'
      
        '110126135=                                   WHERE :G_TOCHKA_ARR' +
        '_ CONTAINING '#39'-'#39'||SP.G_TOCHKA||'#39'-'#39
      
        '110126136=                                     AND SP.DATE_RECEI' +
        'PT <= CURRENT_DATE'
      
        '110126137=                                     AND SP.SKLAD = S.' +
        'SKLAD_PARENT'
      
        '110126138=                                     AND S.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110126139=                                     AND SP.IS_VOZVRAT' +
        ' IN (0, 3, 4)'
      
        '110126140=                                    ORDER BY S.DATE_RE' +
        'CEIPT DESC ROWS 1 TO 5) T),'
      '110126141=                         1,'
      '110126142=                         (SELECT S.PRICE'
      '110126143=                            FROM SKLAD S'
      
        '110126144=                           WHERE S.SKLAD = (SELECT MAX' +
        '(SS.SKLAD)   --'#1058'.'#1050'. '#1052#1054#1043#1059#1058' '#1057#1053#1048#1052#1040#1058#1068' '#1054#1058#1063#1045#1058' '#1055#1054' '#1053#1045#1057#1050#1054#1051#1068#1050#1048#1052' '#1057#1050#1051#1040#1044#1040#1052', '#1058 +
        #1054' '#1055#1056#1048#1044#1045#1058#1057#1071' '#1044#1045#1051#1040#1058#1068' '#1063#1045#1056#1045#1047' '#1052#1040#1050#1057', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1041#1059#1044#1045#1058' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' IS_LAST' +
        ' = 1'
      
        '110126145=                                              FROM SKL' +
        'AD SS'
      
        '110126146=                                             WHERE :G_' +
        'TOCHKA_ARR_ CONTAINING '#39'-'#39'||SS.G_TOCHKA||'#39'-'#39
      
        '110126147=                                               AND SS.' +
        'G_PRODUCT = G.G_PRODUCT'
      
        '110126148=                                               AND SS.' +
        'IS_LAST = 1)'
      '110126149=                         ))), 0) spr,'
      
        '110126150=                 DECODE(:SORT_BY_NAME_, 0, G.ARTICUL, ' +
        '1, G.NAME),'
      '110126151=                 0'
      '110126152=                 ,G.NOTE'
      
        '110126153=                 ,REPLACE(G.CROSSCODE, '#39'~'#39', '#39','#39') CROSS' +
        'CODE'
      '110126154=                 ,G.PLACE'
      
        '110126155=            FROM G_PRODUCT G LEFT OUTER JOIN (SELECT G' +
        '_PRODUCT, D.SKIDKA_PROC, D.SKIDKA_SUM'
      
        '110126156=                                                FROM G' +
        '_DISCOUNT D'
      
        '110126157=                                                WHERE ' +
        '((D.DATE_BEGIN <= CURRENT_TIMESTAMP  -- '#1058#1054#1051#1068#1050#1054' '#1040#1050#1058#1048#1042#1053#1067#1045
      
        '110126158=                                                      ' +
        '  AND D.DATE_END >= CURRENT_TIMESTAMP'
      
        '110126159=                                                      ' +
        '  AND D.DATE_BEGIN IS NOT NULL AND D.DATE_END IS NOT NULL'
      
        '110126160=                                                      ' +
        ')'
      
        '110126161=                                                      ' +
        'OR'
      
        '110126162=                                                      ' +
        '(D.DATE_BEGIN IS NULL AND D.DATE_END IS NULL))'
      
        '110126163=                                                 AND (' +
        '(:G_TOCHKA_ARR_ CONTAINING '#39'-'#39'||D.G_TOCHKA||'#39'-'#39')'
      
        '110126164=                                                     O' +
        'R'
      
        '110126165=                                                     (' +
        'D.G_TOCHKA IS NULL))'
      
        '110126166=                                              ) GD ON ' +
        'G.G_PRODUCT = GD.G_PRODUCT'
      
        '110126167=                             LEFT OUTER JOIN G_UNIT U ' +
        'ON G.G_UNIT = U.G_UNIT'
      
        '110126168=                             LEFT OUTER JOIN (SELECT S' +
        'UM(LL.AMOUNT) AMOUNT, SUM(LL.AMOUNT_RESERVE) AMOUNT_RESERVE, LL.' +
        'G_PRODUCT FROM LT_SKLAD_PRODUCT LL'
      
        '110126169=                                              WHERE :G' +
        '_TOCHKA_ARR_ CONTAINING '#39'-'#39'||LL.G_TOCHKA||'#39'-'#39' GROUP BY LL.G_PROD' +
        'UCT) S ON G.G_PRODUCT = S.G_PRODUCT'
      '110126170=           WHERE G.G_PRODUCT_PAR = :G_PRODUCT_'
      '110126171=             AND G.IS_CATEGORY = 0'
      '110126172=             AND G.is_active = 1'
      '110126173=             -- '#1059#1057#1051#1054#1042#1048#1071' '#1060#1048#1051#1068#1058#1056#1040
      
        '110126174=             AND (((COALESCE(:INCLUDE_NOL_, 0) = 0) AN' +
        'D (COALESCE(:INCLUDE_FEW_, 0) = 0))'
      '110126175=                  OR'
      
        '110126176=                  ((S.AMOUNT > 0 AND COALESCE(:INCLUDE' +
        '_NOL_, 0) = 1)'
      '110126177=                  or'
      
        '110126178=                  (S.AMOUNT <= 5 AND COALESCE(:INCLUDE' +
        '_FEW_, 0) = 1))'
      '110126179=                 )'
      '110126180=             -- '#1055#1054' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059
      '110126181=             AND ((EXISTS (SELECT 1'
      '110126182=                           FROM SKLAD S'
      
        '110126183=                          WHERE S.G_CLIENT = :G_CLIENT' +
        '_'
      
        '110126184=                            AND S.G_PRODUCT = G.G_PROD' +
        'UCT'
      
        '110126185=                            AND :G_TOCHKA_ARR_ CONTAIN' +
        'ING '#39'-'#39'||S.G_TOCHKA||'#39'-'#39') AND COALESCE(:G_CLIENT_, 0) <> 0)'
      '110126186=                  OR'
      '110126187=                  COALESCE(:G_CLIENT_, 0) = 0)'
      '110126188=           ORDER BY 14;'
      '110126189=      END'
      '110126190=  END'
      '110126191='
      
        '110126192=  PERIOD_ = '#39#1053#1072' '#1076#1072#1090#1091' '#39'||lpad(EXTRACT(DAY FROM CURRENT_' +
        'DATE), 2, '#39'0'#39')||'#39'.'#39'||lpad(EXTRACT(MONTH FROM CURRENT_DATE), 2, 0' +
        ')||'#39'.'#39'||EXTRACT(YEAR FROM CURRENT_DATE);'
      '110126193='
      
        '110126194=  FOR SELECT :I, ARTICUL, BARCODE, NOMENCLATUR_NUM, CR' +
        'OSSCODE, PLACE, NAME, NOTE, UNIT_NAME, PRICE, VOLUME_PRICE, SKID' +
        'KA_PRICE, AMOUNT, AMOUNT_RESERVE, SUMM, PRICE_SELF, AMOUNT*PRICE' +
        '_SELF, IS_CATEGORY,'
      '110126195=             DECODE(IS_CATEGORY, 0, NAME, ARTICUL)'
      '110126196=      FROM P_REP_PRICE_LIST_TABLE'
      
        '110126197=      INTO :ROW_NUM, :ARTICUL, :BARCODE, :NOMENCLATUR_' +
        'NUM, :CROSSCODE, :PLACE, :NAME, :NOTE, :UNIT_NAME, :PRICE, :VOLU' +
        'ME_PRICE, :SKIDKA_PRICE, :AMOUNT, :AMOUNT_RESERVE, :SUMM, :PRICE' +
        '_SELF, :SUMM_SELF, :IS_CATEGORY, :TOVAR_NAME'
      '110126198=  DO BEGIN'
      '110126199=    I = I + 1;'
      '110126200=    SUSPEND;'
      '110126201=  END'
      '110126202='
      '110126203=     /*'
      '110126204=     '#1086#1089#1090#1072#1074#1083#1102' '#1090#1091#1090' '#1080#1077#1088#1072#1088#1093#1080#1095#1077#1089#1082#1080#1081' '#1089#1077#1083#1077#1082#1090
      '110126205='
      '110126206=     SELECT :I,'
      
        '110126207=             SS.ARTICUL,   -- '#1045#1057#1051#1048' '#1050#1040#1058#1045#1043#1054#1056#1048#1071', '#1058#1054' '#1042#1067#1042#1045#1044 +
        #1059' '#1057#1070#1044#1040' '#1053#1040#1048#1052#1045#1053#1054#1042#1040#1053#1048#1045
      '110126208=             SS.NAME,           -- '#1040' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' '#1055#1059#1057#1058#1054
      '110126209=             U.SHORT_NAME UNIT_NAME,'
      '110126210=             SS.PRICE,'
      '110126211=             SS.VOLUME_PRICE,'
      '110126212=             (SS.PRICE - GD.SKIDKA_SUM) SKIDPRICE,'
      
        '110126213=             DECODE(SS.IS_CATEGORY, 1, NULL, COALESCE(' +
        'S.AMOUNT, 0)),'
      '110126214=             SS.IS_CATEGORY'
      '110126215=        FROM (WITH RECURSIVE TREE'
      '110126216=              AS (SELECT T.G_PRODUCT,'
      '110126217=                       T.NAME AS ARTICUL,'
      
        '110126218=                       CAST(NULL AS VARCHAR(500)) NAME' +
        ','
      
        '110126219=                       CAST(NULL AS NUMERIC(15,2)) PRI' +
        'CE,'
      
        '110126220=                       CAST(NULL AS NUMERIC(15,2)) VOL' +
        'UME_PRICE,'
      '110126221=                       T.IS_CATEGORY,'
      '110126222=                       NULL G_UNIT'
      '110126223=                  FROM G_PRODUCT T'
      '110126224=                 WHERE T.G_PRODUCT_PAR IS NULL'
      
        '110126225=                   AND :G_CATEGORY_ CONTAINING '#39'~'#39'||T.' +
        'G_PRODUCT||'#39'~'#39
      '110126226=                UNION ALL'
      '110126227=                SELECT T.G_PRODUCT,'
      '110126228=                       DECODE(T. T.ARTICUL,'
      '110126229=                       T.NAME,'
      '110126230=                       T.PRICE,'
      '110126231=                       T.VOLUME_PRICE,'
      '110126232=                       T.IS_CATEGORY,'
      '110126233=                       T.G_UNIT'
      
        '110126234=                  FROM G_PRODUCT T INNER JOIN TREE PRI' +
        'OR ON PRIOR.G_PRODUCT = T.G_PRODUCT_PAR'
      '110126235=                 WHERE T.IS_ACTIVE = 1'
      '110126236=                )'
      '110126237=             SELECT * FROM TREE) SS'
      
        '110126238=             LEFT OUTER JOIN LT_SKLAD_PRODUCT S ON SS.' +
        'G_PRODUCT = S.G_PRODUCT'
      
        '110126239=             LEFT OUTER JOIN G_UNIT U ON SS.G_UNIT = U' +
        '.G_UNIT'
      
        '110126240=             LEFT OUTER JOIN G_DISCOUNT GD ON SS.G_PRO' +
        'DUCT = GD.G_PRODUCT'
      '110126241=    INTO :ROW_NUM,'
      '110126242=        :ARTICUL,'
      '110126243=        :NAME,'
      '110126244=        :UNIT_NAME,'
      '110126245=        :PRICE,'
      '110126246=        :VOLUME_PRICE,'
      '110126247=        :SKIDKA_PRICE,'
      '110126248=        :AMOUNT,'
      '110126249=        :IS_CATEGORY'
      '110126250=    DO BEGIN'
      '110126251=      I = I + 1;'
      '110126252=      SUSPEND;'
      '110126253=    END  */'
      '110126254=WHEN ANY DO BEGIN'
      '110126255=    Err_code = -20500;'
      
        '110126256=    EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050#1040' '#1055#1056 +
        #1048' '#1060#1054#1056#1052#1048#1056#1054#1042#1040#1053#1048#1048' '#1055#1056#1040#1049#1057#1051#1048#1057#1058#1040'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '110126257=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110126258=  END'
      '110126259=end'
      '110126260=;'
      
        '110126261=UPDATE SYSTEM_SETUP SET S_VALUE = 110126 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110126262=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110126263=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101270=ALTER PROCEDURE DO_PRODUCT('
      '1101271=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      '1101272=  DATE_ TYPE OF COLUMN SKLAD_PARENT.DATE_RECEIPT,'
      '1101273=  G_PRODUCT_IN_ TYPE OF COLUMN G_PRODUCT.G_PRODUCT,'
      '1101274=  AMOUNT_IN_ TYPE OF COLUMN ZAKAZ_DETAILS.AMOUNT,'
      '1101275=  NOTE_ TYPE OF COLUMN OTHER.NOTE)'
      '1101276=RETURNS ('
      '1101277=  SKLAD_ TYPE OF COLUMN OTHER.OTHER,'
      '1101278=  COST_PRICE_ TYPE OF COLUMN SKLAD.SUMM,'
      '1101279=  ERR_CODE INTEGER,'
      '11012710=  ERR_MSG VARCHAR(1024))'
      '11012711=AS'
      '11012712=/*'
      
        '11012713='#1055#1056#1054#1048#1047#1042#1054#1044#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040', '#1057#1070#1044#1040' '#1055#1045#1056#1045#1044#1040#1045#1058#1057#1071' ID '#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1055#1056 +
        #1054#1048#1047#1042#1054#1044#1048#1052#1054#1043#1054' '#1058#1054#1042#1040#1056#1040' '#1048' '#1042#1057#1045'.'
      '11012714='#1058#1059#1058' '#1055#1054#1061#1054#1044#1059' '#1057#1063#1048#1058#1040#1045#1058#1057#1071' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1048' '#1055#1056#1054#1063#1045#1045
      '11012715=*/'
      '11012716=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'DO_PRODUCT'#39';'
      '11012717=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '11012718=DECLARE VARIABLE CAN_SELL_ INTEGER; /* '#1052#1054#1046#1053#1054' '#1051#1048' '#1055#1056#1054#1044#1040#1042#1040 +
        #1058#1068' '#1058#1054#1042#1040#1056#1067' '#1057' '#1053#1059#1051#1045#1042#1067#1052' '#1054#1057#1058#1040#1058#1050#1054#1052' */'
      
        '11012719=DECLARE VARIABLE ITEM_ TYPE OF COLUMN G_PRODUCT.G_PRODU' +
        'CT;'
      
        '11012720=DECLARE VARIABLE AMOUNT_NEED_ TYPE OF COLUMN LT_SKLAD_P' +
        'RODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' */'
      
        '11012721=DECLARE VARIABLE AMOUNT_NEED_ONE_ TYPE OF COLUMN LT_SKL' +
        'AD_PRODUCT.AMOUNT; /* '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1044#1051#1071' '#1054#1044#1053#1054#1049' '#1045#1044#1048#1053#1048#1062#1067' ' +
        #1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1059#1046#1053#1054' '#1044#1051#1071' '#1056#1040#1057#1063#1045#1058#1040' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1048' */'
      '11012722=DECLARE VARIABLE NAME_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11012723=DECLARE VARIABLE G_PRODUCT_KIT_ TYPE OF COLUMN G_PRODUC' +
        'T.G_PRODUCT;'
      '11012724=DECLARE VARIABLE SELF_PRICE_ TYPE OF COLUMN SKLAD.SUMM;'
      '11012725=DECLARE VARIABLE OTHER_ TYPE OF COLUMN OTHER.OTHER;'
      
        '11012726=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN G_PRODUCT.G_' +
        'PRODUCT;'
      
        '11012727=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN ZAKAZ_DETAILS.A' +
        'MOUNT;'
      '11012728=BEGIN'
      '11012729=  PNT_ = '#39'00'#39';'
      '11012730=  COST_PRICE_ = 0;'
      '11012731='
      '11012732=  IF (G_TOCHKA_ IS NULL) THEN'
      '11012733=    SELECT ID'
      '11012734=      FROM CUR_PARAMS'
      '11012735=     WHERE CUR_PARAMS = 2'
      '11012736=      INTO :G_TOCHKA_;'
      '11012737='
      '11012738=  -- '#1055#1056#1054#1042#1045#1056#1050#1040' - '#1061#1042#1040#1058#1040#1045#1058' '#1051#1048' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1040' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061
      '11012739=  SELECT P.S_VALUE'
      '11012740=    FROM SYSTEM_SETUP P'
      '11012741=   WHERE P.SYSTEM_SETUP = 2'
      '11012742=    INTO :CAN_SELL_;'
      '11012743='
      '11012744=  FOR SELECT :G_PRODUCT_IN_,'
      '11012745=             :AMOUNT_IN_'
      '11012746=        FROM RDB$DATABASE'
      '11012747=       WHERE :G_PRODUCT_IN_ IS NOT NULL'
      '11012748=      UNION ALL'
      '11012749=      SELECT G_PRODUCT,'
      '11012750=             AMOUNT'
      '11012751=        FROM ZAKAZ_DETAILS_TMP'
      '11012752=       WHERE :G_PRODUCT_IN_ IS NULL'
      '11012753=        INTO :G_PRODUCT_,'
      '11012754=             :AMOUNT_'
      '11012755=  DO BEGIN'
      '11012756=      SELECT MAX(G.NAME)'
      '11012757=        FROM G_PRODUCT G,'
      '11012758=             G_PRODUCT_KIT K'
      '11012759=       WHERE G.G_PRODUCT = K.G_PRODUCT_ITEM'
      '11012760=         AND K.G_PRODUCT = :G_PRODUCT_'
      
        '11012761=         AND COALESCE((SELECT L.AMOUNT FROM LT_SKLAD_PR' +
        'ODUCT L WHERE G.G_PRODUCT = L.G_PRODUCT AND L.G_TOCHKA = :G_TOCH' +
        'KA_), 0) < (K.AMOUNT * :AMOUNT_)'
      '11012762=        INTO :NAME_;'
      '11012763='
      
        '11012764=      IF (NAME_ IS NOT NULL AND CAN_SELL_ = 0) THEN BEG' +
        'IN'
      '11012765=        ERR_CODE = -20500;'
      
        '11012766=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1089#1090#1072#1090#1086 +
        #1082' '#1089#1086#1089#1090#1072#1074#1083#1103#1102#1097#1077#1081' "'#39'||NAME_||'#39'" '#1084#1077#1085#1100#1096#1077' '#1085#1077#1086#1073#1093#1086#1076#1080#1084#1086#1075#1086'! '#1053#1077#1074#1086#1079#1084#1086#1078#1085#1086' '#1087#1088#1086 +
        #1080#1079#1074#1077#1089#1090#1080' '#1087#1088#1086#1076#1091#1082#1090'!'#39') RETURNING_VALUES (:ERR_MSG);'
      
        '11012767=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '11012768=        EXIT;'
      '11012769=      END'
      '11012770='
      '11012771=      PNT_ = '#39'01'#39';'
      
        '11012772=      INSERT INTO OTHER (OTHER, OP_DATE, OP_TYPE, ARRIV' +
        'AL_TYPE, /*PARENT_ID,*/ NOTE, G_TOCHKA)'
      
        '11012773=      VALUES (GEN_ID(GEN_OTHER_OPERATION, 1), :DATE_, 0' +
        ', 1, /*:OTHER_,*/ :NOTE_, :G_TOCHKA_)'
      '11012774=      RETURNING OTHER'
      '11012775=      INTO :OTHER_;'
      '11012776='
      '11012777=      -- '#1044#1045#1051#1040#1070' '#1059#1061#1054#1044' '#1057#1054#1057#1058#1040#1042#1051#1071#1070#1065#1048#1061' '#1057#1054' '#1057#1050#1051#1040#1044#1040
      '11012778=      FOR SELECT K.G_PRODUCT_ITEM'
      '11012779=                ,K.AMOUNT*:AMOUNT_'
      '11012780=                ,K.amount'
      '11012781=                ,G.G_PRODUCT'
      '11012782=            FROM G_PRODUCT_KIT K'
      '11012783=                ,G_PRODUCT G'
      '11012784=           WHERE K.G_PRODUCT = :G_PRODUCT_'
      '11012785=             AND K.G_PRODUCT_ITEM = G.G_PRODUCT'
      '11012786=            INTO :ITEM_'
      '11012787=                ,:AMOUNT_NEED_'
      '11012788=                ,:AMOUNT_NEED_ONE_'
      '11012789=                ,:G_PRODUCT_KIT_'
      '11012790=      DO BEGIN'
      
        '11012791=        EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUC' +
        'T_KIT_, NULL, 1)'
      '11012792=          RETURNING_VALUES :SELF_PRICE_;'
      '11012793='
      '11012794=        UPDATE LT_SKLAD_PRODUCT L'
      '11012795=           SET L.AMOUNT = L.AMOUNT - :AMOUNT_NEED_'
      '11012796=         WHERE L.G_PRODUCT = :G_PRODUCT_KIT_'
      '11012797=           AND L.G_TOCHKA = :G_TOCHKA_;'
      '11012798='
      '11012799=        IF (ROW_COUNT = 0) THEN'
      
        '110127100=          INSERT INTO LT_SKLAD_PRODUCT VALUES (GEN_ID(' +
        'GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_KIT_, -:AMOUNT_NEED_, 0, :G' +
        '_TOCHKA_);'
      '110127101='
      
        '110127102=        INSERT INTO OTHER_DETAILS (OTHER_DETAILS, OTHE' +
        'R, G_PRODUCT, AMOUNT, COST_PRICE)'
      
        '110127103=        VALUES (GEN_ID(GEN_OTHER_DETAILS, 1), :OTHER_,' +
        ' :G_PRODUCT_KIT_, :AMOUNT_NEED_, :SELF_PRICE_);'
      '110127104='
      
        '110127105=        COST_PRICE_ = COST_PRICE_ + AMOUNT_NEED_ONE_*S' +
        'ELF_PRICE_;'
      '110127106=      END'
      '110127107='
      
        '110127108=      -- '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1055#1056#1054#1044#1059#1050#1058#1040' '#1053#1040' '#1057#1050#1051#1040#1044', '#1055#1056#1048' '#1069#1058#1054#1052' '#1042#1053#1040#1063 +
        #1040#1051#1045' '#1053#1040#1044#1054' '#1042#1067#1063#1048#1057#1051#1048#1058#1068' '#1057#1045#1041#1045#1057#1058#1054#1048#1052#1054#1057#1058#1068' '#1057#1054#1057#1058#1042#1051#1071#1070#1065#1048#1061
      '110127109=      PNT_ = '#39'02'#39';'
      
        '110127110=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, NDS, NDS_SUMM)'
      
        '110127111=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :COST_PRICE_, :AMOUNT_*:COST_PRICE_, 0, 0);'
      '110127112='
      '110127113=      EXECUTE PROCEDURE INS_SKLAD(:G_TOCHKA_,'
      '110127114=                              :DATE_,'
      '110127115=                              CURRENT_TIME,'
      '110127116=                              NULL, --:G_CLIENT__,'
      
        '110127117=                              NULL, --:G_PAYMENT_TYPE_' +
        '_,'
      '110127118=                              NULL, --:OSNOVANIE__,'
      '110127119=                              :NOTE_,'
      '110127120=                              4, --:IS_VOZVRAT_,'
      '110127121=                              :AMOUNT_*:COST_PRICE_,'
      '110127122=                              :AMOUNT_*:COST_PRICE_,'
      '110127123=                              0, --:G_PRIHOD_,'
      '110127124=                              0 --:SUMM_PRIHOD_)'
      '110127125=                              ,NULL     --PAYMENTS_'
      
        '110127126=                             )RETURNING_VALUES :SKLAD_' +
        ', :ERR_CODE, :ERR_MSG;'
      '110127127=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110127128=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110127129=          EXIT;'
      '110127130=      END'
      '110127131='
      '110127132=      UPDATE OTHER O'
      '110127133=        SET O.SKLAD_PARENT_ID = :SKLAD_'
      '110127134=      WHERE O.OTHER = :OTHER_;'
      '110127135=  END'
      '110127136=END'
      '110127137=;'
      
        '110127138=UPDATE SYSTEM_SETUP SET S_VALUE = 110127 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110127139=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110127140=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101280=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      
        '1101281=  BARCODE_ /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '1101282=  G_TOCHKA_ /* TYPE OF COLUMN G_TOCHKA.G_TOCHKA */ BIGIN' +
        'T,'
      
        '1101283=  IS_VOZVRAT_ /* TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT ' +
        '*/ INTEGER = 0)'
      '1101284=RETURNS ('
      '1101285=  SKLAD_ /* TYPE OF COLUMN SKLAD.SKLAD */ BIGINT,'
      '1101286=  ERR_CODE INTEGER,'
      '1101287=  ERR_MSG VARCHAR(1024))'
      '1101288=AS'
      '1101289=BEGIN'
      '11012810=  SUSPEND;'
      '11012811=END'
      '11012812=;'
      '11012813='
      '11012814=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '11012815=RETURNS ('
      
        '11012816=  ZAKAZ_DETAILS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAK' +
        'AZ_DETAILS */ BIGINT,'
      
        '11012817=  ZAKAZ /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ */ BI' +
        'GINT,'
      
        '11012818=  G_PRODUCT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODU' +
        'CT */ BIGINT,'
      
        '11012819=  AMOUNT /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT */ ' +
        'NUMERIC(18,5),'
      
        '11012820=  PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11012821=  SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM */ NUME' +
        'RIC(15,2),'
      
        '11012822=  DISCOUNT_PERC /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_PERC */ NUMERIC(15,2),'
      
        '11012823=  DISCOUNT_TENGE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DI' +
        'SCOUNT_TENGE */ NUMERIC(15,2),'
      
        '11012824=  DISCOUNT_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DIS' +
        'COUNT_SUMM */ NUMERIC(15,2),'
      
        '11012825=  NDS /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS */ NUMERI' +
        'C(15,2),'
      
        '11012826=  NDS_SUMM /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM' +
        ' */ NUMERIC(15,2),'
      
        '11012827=  PRODUCT_NAME /* TYPE OF COLUMN G_PRODUCT.NAME */ VARC' +
        'HAR(250),'
      
        '11012828=  BARCODE /* TYPE OF COLUMN G_PRODUCT.BARCODE */ VARCHA' +
        'R(30),'
      
        '11012829=  ARTICUL /* TYPE OF COLUMN G_PRODUCT.ARTICUL */ VARCHA' +
        'R(30),'
      
        '11012830=  PRODUCT_PRICE /* TYPE OF COLUMN G_PRODUCT.PRICE */ NU' +
        'MERIC(15,2),'
      
        '11012831=  COST_PRICE /* TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_P' +
        'RICE */ NUMERIC(15,2),'
      '11012832=  IS_KIT /* TYPE OF COLUMN G_PRODUCT.IS_KIT */ INTEGER)'
      '11012833=AS'
      '11012834=BEGIN'
      '11012835=  SUSPEND;'
      '11012836=END'
      '11012837=;'
      '11012838='
      '11012839='
      
        '11012840=/******************************************************' +
        '************************/'
      
        '11012841=/****                      Altering stored procedures  ' +
        '                    ****/'
      
        '11012842=/******************************************************' +
        '************************/'
      '11012843=ALTER PROCEDURE CLEAR_BASE('
      '11012844=  MODE_ INTEGER = 0)'
      '11012845=AS'
      '11012846=/*'
      '11012847=mode_'
      '11012848=0 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077
      '11012849=1 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1087#1088#1086#1076#1072#1078#1080' '#1080' '#1087#1088#1080#1093#1086#1076#1099
      '11012850=2 - '#1086#1095#1080#1089#1090#1080#1090#1100' '#1074#1089#1077', '#1082#1088#1086#1084#1077' '#1090#1086#1074#1072#1088#1086#1074
      '11012851=*/'
      '11012852=BEGIN'
      '11012853=  delete from LT_ZAKAZ_REAL;'
      '11012854=  delete from REVISION;'
      '11012855='
      '11012856=  delete from kassa;'
      '11012857=  delete from kassa_state;'
      '11012858='
      '11012859=  delete from kassa_beznal;'
      '11012860=  delete from kassa_beznal_state;'
      '11012861='
      '11012862=  delete from waybill;'
      '11012863=  delete from invoice;'
      '11012864=  delete from INVOICE_PAY;'
      '11012865=  delete from docs;'
      '11012866=  delete from other_details;'
      '11012867=  delete from other;'
      '11012868='
      '11012869=  delete from zakaz_details;'
      '11012870=  delete from zakaz;'
      '11012871='
      '11012872=  delete from zakaz_na_real;'
      '11012873=  delete from ZAKAZ_real_parent;'
      '11012874='
      '11012875=  delete from sklad;'
      '11012876=  delete from sklad_parent;'
      '11012877='
      '11012878=  update lt_sklad_product l'
      '11012879=     set l.AMOUNT = 0,'
      '11012880=         l.AMOUNT_RESERVE = 0;'
      '11012881='
      '11012882=  IF (MODE_ IN (0, 2)) THEN BEGIN'
      '11012883=    delete from g_address;'
      '11012884=    delete from g_account;'
      '11012885=    delete from G_DISCONT_CARD;'
      '11012886=    delete from DELIVERY;'
      '11012887='
      
        '11012888=    --'#1076#1077#1083#1072#1102' '#1089#1085#1072#1095#1072#1083#1072' '#1072#1087#1076#1077#1081#1090' '#1087#1072#1088#1077#1085#1090#1086#1074', '#1095#1090#1086#1073#1099' '#1091#1076#1072#1083#1077#1085#1080#1077' '#1087#1088#1086 +
        #1096#1083#1086' '#1075#1083#1072#1076#1082#1086
      
        '11012889=    update g_client c set c.G_CLIENT_PARENT = null wher' +
        'e c.G_CLIENT <> 10;'
      
        '11012890=    delete from g_client c where c.G_CLIENT not in (9,1' +
        '0);'
      '11012891=    delete from g_discount;'
      
        '11012892=    delete from g_prihod_rashod where g_prihod_rashod n' +
        'ot in (-5,-1,0,1,2,3);'
      '11012893=    delete from g_firm_address;'
      '11012894=    delete from g_firm_account;'
      '11012895=    delete from g_firm_rekvizit;'
      '11012896=    delete from G_OFFICIAL_RIGHT;'
      '11012897=    delete from g_official;'
      '11012898='
      '11012899=    IF (mode_ = 0) THEN begin'
      '110128100=      delete from G_PRODUCT_IMAGE;'
      '110128101=      delete from G_PRODUCT_KIT;'
      '110128102=      delete from LT_BARCODE;'
      '110128103=      delete from LT_SKLAD_PRODUCT;'
      '110128104=      delete from G_PRODUCT g where g.IS_CATEGORY = 0;'
      '110128105=      update g_product g set g.g_product_par = null;'
      
        '110128106=      delete from G_PRODUCT g where g.IS_CATEGORY = 1 ' +
        'and g.G_PRODUCT <> -1;'
      '110128107=      delete from g_unit where g_unit <> 1;'
      '110128108=    end'
      '110128109='
      '110128110=  END'
      '110128111=END'
      '110128112=;'
      '110128113='
      '110128114=ALTER PROCEDURE INS_SKLAD_TMP_BY_BARCODE('
      '110128115=  BARCODE_ TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110128116=  G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TOCHKA,'
      
        '110128117=  IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT =' +
        ' 0)'
      '110128118=RETURNS ('
      '110128119=  SKLAD_ TYPE OF COLUMN SKLAD.SKLAD,'
      '110128120=  ERR_CODE INTEGER,'
      '110128121=  ERR_MSG VARCHAR(1024))'
      '110128122=AS'
      '110128123=/*'
      '110128124='#1055#1088#1086#1094#1077#1076#1091#1088#1072' '#1085#1072#1093#1086#1076#1080#1090' '#1080' '#1074#1089#1090#1072#1074#1083#1103#1077#1090' '#1090#1086#1074#1072#1088
      '110128125=*/'
      
        '110128126=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'INS_SKLAD_TM' +
        'P'#39';'
      '110128127=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '110128128=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '110128129=DECLARE VARIABLE G_PRODUCT_CATEGORY_ TYPE OF COLUMN G_' +
        'PRODUCT.G_PRODUCT_PAR;'
      '110128130=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      
        '110128131=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN G_PRODUCT.' +
        'PRICE;'
      
        '110128132=DECLARE VARIABLE VOLUME_PRICE_ TYPE OF COLUMN G_PRODUC' +
        'T.VOLUME_PRICE;'
      '110128133=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      '110128134=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      '110128135=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.NDS;'
      
        '110128136=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.NDS_SU' +
        'MM;'
      
        '110128137=DECLARE VARIABLE IS_KIT_ TYPE OF COLUMN G_PRODUCT.IS_K' +
        'IT;'
      '110128138=BEGIN'
      '110128139='
      '110128140=  PNT_ = '#39'01'#39';'
      
        '110128141=  EXECUTE PROCEDURE G_GET_G_PRODUCT_BY_BARCODE(:BARCOD' +
        'E_, NULL, NULL, NULL, NULL)'
      
        '110128142=      RETURNING_VALUES :G_PRODUCT_, :G_PRODUCT_CATEGOR' +
        'Y_, :SALE_PRICE_, :VOLUME_PRICE_, :AMOUNT_, :IS_KIT_, :ERR_CODE,' +
        ' :ERR_MSG;'
      '110128143='
      '110128144=  IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110128145=    ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR_MS' +
        'G;'
      '110128146=    EXIT;'
      '110128147=  END'
      '110128148='
      '110128149=  PNT_ = '#39'02'#39';'
      '110128150=  IF (IS_VOZVRAT_ = 0) THEN BEGIN'
      
        '110128151=      EXECUTE PROCEDURE GET_LAST_SELF_PRICE(:G_PRODUCT' +
        '_, :G_TOCHKA_, 0)'
      '110128152=          RETURNING_VALUES :PRICE_;'
      '110128153='
      '110128154=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110128155=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ER' +
        'R_MSG;'
      '110128156=        EXIT;'
      '110128157=      END'
      '110128158=  END ELSE'
      '110128159=    PRICE_ = SALE_PRICE_;'
      '110128160='
      '110128161=  AMOUNT_ = 1;'
      '110128162='
      '110128163=  SELECT T.SKLAD'
      '110128164=    FROM SKLAD_TMP T'
      '110128165=   WHERE T.G_PRODUCT = :G_PRODUCT_'
      '110128166=     AND T.PRICE = :PRICE_'
      '110128167=    INTO :SKLAD_;'
      '110128168='
      '110128169=  IF (SKLAD_ IS NOT NULL) THEN'
      '110128170=    UPDATE SKLAD_TMP T'
      '110128171=       SET T.AMOUNT = T.AMOUNT + :AMOUNT_,'
      '110128172=           T.SUMM = (T.AMOUNT + :AMOUNT_) * :PRICE_'
      '110128173=     WHERE T.SKLAD = :SKLAD_;'
      '110128174='
      '110128175=  ELSE'
      
        '110128176=      INSERT INTO SKLAD_TMP (SKLAD, G_PRODUCT, AMOUNT,' +
        ' PRICE, SUMM, charge_ROZN_proc, PRICE_ROZN, charge_opt_proc, PRI' +
        'CE_OPT)'
      
        '110128177=      VALUES (GEN_ID(GEN_DETAILS_TMP, 1), :G_PRODUCT_,' +
        ' :AMOUNT_, :PRICE_, :AMOUNT_ * :PRICE_,'
      
        '110128178=             DECODE(:PRICE_, 0, 0, ROUND((:SALE_PRICE_' +
        '/:PRICE_ - 1)*100, 2)),'
      '110128179=             :SALE_PRICE_,'
      
        '110128180=             DECODE(:PRICE_, 0, 0, ROUND((:VOLUME_PRIC' +
        'E_/:PRICE_ - 1)*100, 2)),'
      '110128181=             :VOLUME_PRICE_)'
      '110128182=      RETURNING SKLAD'
      '110128183=      INTO :SKLAD_;'
      '110128184=end'
      '110128185=;'
      '110128186='
      '110128187=ALTER PROCEDURE READ_ZAKAZ_DETAILS_LIST_TMP'
      '110128188=RETURNS ('
      
        '110128189=  ZAKAZ_DETAILS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ' +
        '_DETAILS,'
      '110128190=  ZAKAZ TYPE OF COLUMN ZAKAZ_DETAILS_TMP.ZAKAZ,'
      
        '110128191=  G_PRODUCT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.G_PRODUCT' +
        ','
      '110128192=  AMOUNT TYPE OF COLUMN ZAKAZ_DETAILS_TMP.AMOUNT,'
      '110128193=  PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.PRICE,'
      '110128194=  SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.SUMM,'
      
        '110128195=  DISCOUNT_PERC TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_PERC,'
      
        '110128196=  DISCOUNT_TENGE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISC' +
        'OUNT_TENGE,'
      
        '110128197=  DISCOUNT_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.DISCO' +
        'UNT_SUMM,'
      '110128198=  NDS TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS,'
      '110128199=  NDS_SUMM TYPE OF COLUMN ZAKAZ_DETAILS_TMP.NDS_SUMM,'
      '110128200=  PRODUCT_NAME TYPE OF COLUMN G_PRODUCT.NAME,'
      '110128201=  BARCODE TYPE OF COLUMN G_PRODUCT.BARCODE,'
      '110128202=  ARTICUL TYPE OF COLUMN G_PRODUCT.ARTICUL,'
      '110128203=  PRODUCT_PRICE TYPE OF COLUMN G_PRODUCT.PRICE,'
      
        '110128204=  COST_PRICE TYPE OF COLUMN ZAKAZ_DETAILS_TMP.COST_PRI' +
        'CE,'
      '110128205=  IS_KIT TYPE OF COLUMN G_PRODUCT.IS_KIT)'
      '110128206=AS'
      '110128207=begin'
      '110128208='
      '110128209=  FOR'
      '110128210=    SELECT T.ZAKAZ_DETAILS,'
      '110128211=           T.ZAKAZ,'
      '110128212=           T.G_PRODUCT,'
      '110128213=           T.AMOUNT,'
      '110128214=           T.PRICE,'
      '110128215=           T.SUMM,'
      '110128216=           T.DISCOUNT_PERC,'
      '110128217=           T.DISCOUNT_TENGE,'
      '110128218=           T.DISCOUNT_SUMM,'
      '110128219=           T.NDS,'
      '110128220=           T.NDS_SUMM,'
      '110128221=           P.NAME PRODUCT_NAME'
      '110128222=           ,P.BARCODE'
      '110128223=           ,P.ARTICUL'
      '110128224=           ,P.PRICE'
      '110128225=           ,P.IS_KIT'
      '110128226=           ,T.COST_PRICE'
      '110128227=      FROM ZAKAZ_DETAILS_TMP T,'
      '110128228=           G_PRODUCT P'
      '110128229=     WHERE T.G_PRODUCT = P.G_PRODUCT'
      '110128230=    ORDER BY t.ZAKAZ_DETAILS'
      '110128231=    INTO :ZAKAZ_DETAILS,'
      '110128232=          :ZAKAZ,'
      '110128233=          :G_PRODUCT,'
      '110128234=          :AMOUNT,'
