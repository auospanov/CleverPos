      '1102252451=  PAYMENT_NAME TYPE OF COLUMN G_PAYMENT_TYPE.NAME,'
      '1102252452=  OSNOVANIE TYPE OF COLUMN SKLAD_PARENT.OSNOVANIE,'
      '1102252453=  NOTE TYPE OF COLUMN SKLAD_PARENT.NOTE,'
      '1102252454=  SUMM TYPE OF COLUMN SKLAD_PARENT.SUMM,'
      '1102252455=  SUMM_FACT TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      '1102252456=  SUMM_SALE TYPE OF COLUMN SKLAD_PARENT.SUMM_FACT,'
      
        '1102252457=  IS_PAYED_ALL TYPE OF COLUMN SKLAD_PARENT.IS_PAYED_A' +
        'LL,'
      '1102252458=  IS_VOZVRAT TYPE OF COLUMN SKLAD_PARENT.IS_VOZVRAT,'
      '1102252459=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '1102252460=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      
        '1102252461=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYP' +
        'E.G_NONCASH_PAY_TYPE,'
      
        '1102252462=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PA' +
        'Y_TYPE.NAME)'
      '1102252463=AS'
      '1102252464=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '1102252465=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102252466=BEGIN'
      '1102252467='
      '1102252468=  SELECT ID'
      '1102252469=    FROM CUR_PARAMS'
      '1102252470=   WHERE CUR_PARAMS = 2'
      '1102252471=    INTO :G_TOCHKA_;'
      '1102252472='
      '1102252473=  SELECT COUNT(*)'
      '1102252474=    FROM SKLAD_PARENT T'
      
        '1102252475=   WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :DAT' +
        'E_END_'
      
        '1102252476=     AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :IS_' +
        'VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '1102252477=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1102252478=     AND T.G_TOCHKA = :G_TOCHKA_'
      '1102252479=    INTO CNT_;'
      '1102252480='
      '1102252481=  if (CNT_ = 0) then'
      '1102252482=    SELECT MAX(T.DATE_RECEIPT)'
      '1102252483=      FROM SKLAD_PARENT T'
      '1102252484=     WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      
        '1102252485=       AND ((T.IS_VOZVRAT IN (:IS_VOZVRAT_, 5) AND :I' +
        'S_VOZVRAT_ <> 1)   -- 5 - '#1058#1048#1055' '#1056#1045#1042#1048#1047#1048#1071
      
        '1102252486=           OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZVRAT_' +
        ' = 1))'
      '1102252487=       AND T.G_TOCHKA = :G_TOCHKA_'
      '1102252488=      INTO :DATE_BEGIN_;'
      '1102252489='
      '1102252490=  -- '#1055#1056#1048#1061#1054#1044#1067'/'#1042#1054#1047#1042#1056#1040#1058
      '1102252491=  IF (IS_VOZVRAT_ <> 3) THEN BEGIN'
      '1102252492=      FOR'
      '1102252493=        SELECT T.SKLAD,'
      '1102252494=               T.DATE_RECEIPT,'
      '1102252495=               T.TIME_RECEIPT,'
      '1102252496=               T.G_CLIENT,'
      '1102252497=               GC.NAME,'
      '1102252498=               T.G_PAYMENT_TYPE,'
      '1102252499=               PT.NAME,'
      
        '1102252500=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1102252501=                            FROM SKLAD D, G_PRODUCT G'
      
        '1102252502=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1102252503=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1102252504=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR,*/'
      '1102252505=               T.OSNOVANIE,'
      '1102252506=               T.NOTE,'
      '1102252507=               T.SUMM,'
      '1102252508=               T.SUMM_FACT,'
      
        '1102252509=               (SELECT SUM(S.AMOUNT * G.PRICE) FROM S' +
        'KLAD S, G_PRODUCT G'
      
        '1102252510=                 WHERE S.SKLAD_PARENT = T.SKLAD AND S' +
        '.G_PRODUCT = G.G_PRODUCT),'
      '1102252511=               T.IS_PAYED_ALL,'
      '1102252512=               T.IS_VOZVRAT,'
      '1102252513=               T.g_official,'
      
        '1102252514=               COALESCE(GO.fio_doc, GO.FM||'#39' '#39'||GO.nm' +
        ')'
      '1102252515=               ,GN.G_NONCASH_PAY_TYPE'
      '1102252516=               ,GN.NAME'
      '1102252517=          FROM SKLAD_PARENT T'
      
        '1102252518=                    LEFT OUTER JOIN G_CLIENT GC ON T.' +
        'G_CLIENT = GC.G_CLIENT'
      
        '1102252519=                    LEFT OUTER JOIN G_PAYMENT_TYPE PT' +
        ' ON T.G_PAYMENT_TYPE = PT.G_PAYMENT_TYPE'
      
        '1102252520=                    LEFT OUTER JOIN G_OFFICIAL GO ON ' +
        'T.g_official = GO.G_OFFICIAL'
      
        '1102252521=                    LEFT OUTER JOIN G_NONCASH_PAY_TYP' +
        'E GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '1102252522=         WHERE ((T.IS_VOZVRAT in (0, 5) AND :IS_VOZVR' +
        'AT_ = 0)'
      
        '1102252523=               OR (T.IS_VOZVRAT IN (1,2) AND :IS_VOZV' +
        'RAT_ = 1))'
      '1102252524=           AND T.G_TOCHKA = :G_TOCHKA_'
      
        '1102252525=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1102252526=        ORDER BY T.DATE_RECEIPT, T.SKLAD, GC.NAME'
      '1102252527=        INTO :SKLAD,'
      '1102252528=             :DATE_RECEIPT,'
      '1102252529=             :TIME_RECEIPT,'
      '1102252530=             :G_CLIENT,'
      '1102252531=             :CLIENT_NAME,'
      '1102252532=             :G_PAYMENT_TYPE,'
      '1102252533=             :PAYMENT_NAME,'
      '1102252534=             --:DETAILS_STR,'
      '1102252535=             :OSNOVANIE,'
      '1102252536=             :NOTE,'
      '1102252537=             :SUMM,'
      '1102252538=             :SUMM_FACT,'
      '1102252539=             :SUMM_SALE,'
      '1102252540=             :IS_PAYED_ALL,'
      '1102252541=             :IS_VOZVRAT,'
      '1102252542=             :G_OFFICIAL,'
      '1102252543=             :G_OFFICIAL_FIO'
      '1102252544=             ,:G_NONCASH_PAY_TYPE'
      '1102252545=             ,:G_NONCASH_PAY_TYPE_NAME'
      '1102252546=      DO'
      '1102252547=        suspend;'
      '1102252548='
      
        '1102252549=  --'#1055#1056#1048#1061#1054#1044' '#1057' '#1044#1056#1059#1043#1054#1043#1054' '#1057#1050#1051#1040#1044#1040', '#1047#1044#1045#1057#1068' '#1044#1040#1053#1053#1067#1049' '#1057#1050#1051#1040#1044' '#1057#1058#1054#1048#1058 +
        ' '#1050#1040#1050' '#1050#1051#1048#1045#1053#1058', '#1040' '#1042' G_TOCHKA '#1057#1058#1054#1048#1058' '#1057#1050#1051#1040#1044'-'#1055#1054#1057#1058#1040#1042#1065#1048#1050
      '1102252550=  END ELSE BEGIN'
      '1102252551=      FOR'
      '1102252552=        SELECT T.SKLAD,'
      '1102252553=               T.DATE_RECEIPT,'
      '1102252554=               T.G_TOCHKA,'
      '1102252555=               G.NAME,'
      
        '1102252556=               /*SUBSTRING((SELECT LIST(G.NAME||'#39'('#39'||' +
        'D.AMOUNT||'#39')'#39', '#39', '#39')'
      '1102252557=                            FROM SKLAD D, G_PRODUCT G'
      
        '1102252558=                           WHERE D.G_PRODUCT = G.G_PR' +
        'ODUCT'
      
        '1102252559=                             AND D.SKLAD_PARENT = T.S' +
        'KLAD'
      
        '1102252560=                           GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999) DETAILS_STR, */'
      '1102252561=               T.OSNOVANIE,'
      '1102252562=               T.NOTE,'
      '1102252563=               T.SUMM'
      
        '1102252564=          FROM SKLAD_PARENT T LEFT OUTER JOIN G_TOCHK' +
        'A G ON T.G_CLIENT = G.G_TOCHKA'
      '1102252565=         WHERE T.G_TOCHKA = :G_TOCHKA_'
      '1102252566=           AND T.IS_VOZVRAT = 3'
      
        '1102252567=           AND T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AN' +
        'D :DATE_END_'
      '1102252568=        ORDER BY T.DATE_RECEIPT, T.SKLAD, G.NAME'
      '1102252569=        INTO :SKLAD,'
      '1102252570=             :DATE_RECEIPT,'
      '1102252571=             :G_CLIENT,'
      '1102252572=             :CLIENT_NAME,'
      '1102252573=             --:DETAILS_STR,'
      '1102252574=             :OSNOVANIE,'
      '1102252575=             :NOTE,'
      '1102252576=             :SUMM'
      '1102252577=      DO'
      '1102252578=        suspend;'
      '1102252579=  END'
      '1102252580=end'
      '1102252581=;'
      '1102252582='
      '1102252583=ALTER PROCEDURE UPD_SKLAD('
      '1102252584=  SKLAD_PARENT_ TYPE OF COLUMN SKLAD_PARENT.SKLAD,'
      '1102252585=  DATE_RECEIPT_ TYPE OF COLUMN SKLAD.DATE_RECEIPT,'
      
        '1102252586=  TIME_RECEIPT_ TYPE OF COLUMN SKLAD_PARENT.TIME_RECE' +
        'IPT,'
      '1102252587=  G_CLIENT_ TYPE OF COLUMN SKLAD.G_CLIENT,'
      
        '1102252588=  G_PAYMENT_TYPE_ TYPE OF COLUMN SKLAD.G_PAYMENT_TYPE' +
        ','
      '1102252589=  OSNOVANIE_ TYPE OF COLUMN SKLAD.OSNOVANIE,'
      '1102252590=  NOTE_ TYPE OF COLUMN SKLAD.NOTE,'
      '1102252591=  SUMM_ TYPE OF COLUMN ZAKAZ.SUMM,'
      '1102252592=  SUMM_FACT_ TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      
        '1102252593=  G_PRIHOD_ TYPE OF COLUMN G_PRIHOD_RASHOD.G_PRIHOD_R' +
        'ASHOD,'
      '1102252594=  SUMM_PRIHOD_ TYPE OF COLUMN KASSA.SUMM,'
      '1102252595=  PAYMENTS_ BLOB SUB_TYPE 1,'
      
        '1102252596=  SUMM_CURRENCY_ TYPE OF COLUMN SKLAD_PARENT.SUMM_CUR' +
        'RENCY = 0,'
      
        '1102252597=  IS_EXPECTED_ TYPE OF COLUMN SKLAD_PARENT.IS_EXPECTE' +
        'D = 0,'
      '1102252598=  UPLOAD_TO_EXT_APP_ INTEGER = 0,'
      
        '1102252599=  USER_ID_ TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL = NUL' +
        'L,'
      '1102252600=  LOG_BODY_ TYPE OF COLUMN LOG_OPER.BODY = NULL,'
      
        '1102252601=  G_NONCASH_PAY_TYPE_ TYPE OF COLUMN G_NONCASH_PAY_TY' +
        'PE.G_NONCASH_PAY_TYPE = NULL,'
      '1102252602=  ZAKAZ_ TYPE OF COLUMN ZAKAZ.ZAKAZ = NULL)'
      '1102252603=RETURNS ('
      '1102252604=  ERR_CODE INTEGER,'
      '1102252605=  ERR_MSG VARCHAR(1024))'
      '1102252606=AS'
      
        '1102252607=-- 02.07.2018 '#1055#1054#1050#1040' '#1056#1045#1064#1048#1051' '#1058#1040#1050', '#1063#1058#1054' '#1044#1040#1046#1045' '#1045#1057#1051#1048' IS_EXPECT' +
        'ED = 1, '#1058#1054' '#1042#1057#1045' '#1056#1040#1042#1053#1054' '#1057#1058#1040#1042#1051#1070' '#1045#1043#1054' '#1050#1040#1050' IS_LAST = 1'
      
        '1102252608=-- '#1048' '#1052#1053#1045' '#1051#1045#1043#1063#1045' '#1048' '#1050#1040#1046#1045#1058#1057#1071' '#1058#1040#1050' '#1055#1056#1040#1042#1048#1051#1068#1053#1045#1045', '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1055 +
        #1056#1054#1044#1040#1042#1045#1062' '#1047#1040#1050#1040#1047#1040#1051' '#1055#1040#1056#1058#1048#1070', '#1040' '#1048#1044#1058#1048' '#1041#1059#1044#1045#1058' 30 '#1044#1053#1045#1049', '#1040' '#1042#1044#1056#1059#1043' '#1047#1040#1050#1059#1055#1054#1063#1053#1040#1071 +
        ' '#1059#1046#1045' '#1048#1047#1052#1045#1053#1048#1051#1040#1057#1068
      
        '1102252609=-- UPLOAD_TO_EXT_APP_ - '#1042#1067#1043#1056#1059#1046#1040#1058#1068' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057 +
        #1056#1045#1044#1059', '#1053#1040#1055#1056#1048#1052#1045#1056', 1'#1057'. 1 - '#1044#1051#1071' '#1042#1057#1045#1061', 2 - '#1050#1056#1054#1052#1045' '#1052#1054#1041#1048#1051#1067
      '1102252610=DECLARE VARIABLE PROCNAME VARCHAR(255) = '#39'UPD_SKLAD'#39';'
      '1102252611=DECLARE VARIABLE PNT_ VARCHAR(5);'
      
        '1102252612=DECLARE VARIABLE KASSA_POP_ TYPE OF COLUMN KASSA.KASS' +
        'A;'
      '1102252613=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      
        '1102252614=DECLARE VARIABLE SKLAD_OLD_ TYPE OF COLUMN SKLAD.SKLA' +
        'D;'
      
        '1102252615=DECLARE VARIABLE IS_EXPECTED_OLD_ TYPE OF COLUMN SKLA' +
        'D_PARENT.IS_EXPECTED;'
      
        '1102252616=DECLARE VARIABLE G_PRODUCT_ TYPE OF COLUMN SKLAD.G_PR' +
        'ODUCT;'
      '1102252617=DECLARE VARIABLE AMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT;'
      
        '1102252618=DECLARE VARIABLE AMOUNT_OLD_ TYPE OF COLUMN SKLAD.AMO' +
        'UNT;'
      
        '1102252619=DECLARE VARIABLE DATE_RECEIPT_OLD_ TYPE OF COLUMN SKL' +
        'AD.DATE_RECEIPT;'
      '1102252620=DECLARE VARIABLE PRICE_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102252621=DECLARE VARIABLE SUMM_ONE_ TYPE OF COLUMN SKLAD.SUMM;'
      '1102252622=DECLARE VARIABLE NDS_ TYPE OF COLUMN SKLAD.PRICE;'
      '1102252623=DECLARE VARIABLE NDS_SUMM_ TYPE OF COLUMN SKLAD.SUMM;'
      
        '1102252624=DECLARE VARIABLE IS_VOZVRAT_ TYPE OF COLUMN SKLAD_PAR' +
        'ENT.IS_VOZVRAT;'
      
        '1102252625=DECLARE VARIABLE G_PAYMENT_TYPE_OLD_ TYPE OF COLUMN S' +
        'KLAD.G_PAYMENT_TYPE; /* '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1044#1054' '#1042#1053#1045#1057#1045#1053#1048#1071' '#1048#1047#1052#1045#1053#1045#1053#1048#1049' */'
      
        '1102252626=DECLARE VARIABLE G_PRIHOD_RASHOD_ TYPE OF COLUMN SKLA' +
        'D.G_PAYMENT_TYPE; /* '#1057#1058#1040#1058#1068#1071' '#1056#1040#1057#1061#1054#1044#1054#1042' - '#1055#1054#1050#1059#1055#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058' */'
      
        '1102252627=DECLARE VARIABLE DATE_LAST_ TYPE OF COLUMN SKLAD_PARE' +
        'NT.DATE_RECEIPT; /* '#1044#1040#1058#1040' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054#1057#1058#1040#1042#1050#1048' */'
      
        '1102252628=DECLARE VARIABLE IS_THIS_LAST_ INTEGER; /* '#1069#1058#1040' '#1055#1054#1057#1058#1040#1042 +
        #1050#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071'?  0 - '#1053#1045#1058', 1 - '#1044#1040' */'
      
        '1102252629=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_' +
        'TOCHKA;'
      '1102252630=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '1102252631=DECLARE VARIABLE PAYMENT_DATE_ TYPE OF COLUMN KASSA.A' +
        'CTION_DATE;'
      
        '1102252632=DECLARE VARIABLE PAYMENT_SUMM_ TYPE OF COLUMN KASSA.S' +
        'UMM;'
      
        '1102252633=DECLARE VARIABLE PAYMENT_TYPE_ TYPE OF COLUMN G_PAYME' +
        'NT_TYPE.G_PAYMENT_TYPE;'
      
        '1102252634=DECLARE VARIABLE PAYMENT_TYPE_OLD_ TYPE OF COLUMN G_P' +
        'AYMENT_TYPE.G_PAYMENT_TYPE;'
      '1102252635=DECLARE VARIABLE STR_ VARCHAR(500);'
      '1102252636=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      
        '1102252637=DECLARE VARIABLE KASSA_STR_ VARCHAR(3000) = '#39'~'#39'; /* '#1044 +
        #1051#1071' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1055#1051#1040#1058#1045#1046#1045#1049' '#1053#1040' '#1059#1044#1040#1051#1045#1053#1048#1045' */'
      
        '1102252638=DECLARE VARIABLE PRICE_CURRENCY_ TYPE OF COLUMN SKLAD' +
        '.PRICE_CURRENCY;'
      
        '1102252639=DECLARE VARIABLE SUMM_CURRENCY_TMP_ TYPE OF COLUMN SK' +
        'LAD.SUMM_CURRENCY;'
      
        '1102252640=DECLARE VARIABLE SALE_PRICE_ TYPE OF COLUMN SKLAD_TMP' +
        '.PRICE_ROZN;'
      
        '1102252641=DECLARE VARIABLE SALE_PRICE_CUR_ TYPE OF COLUMN G_PRO' +
        'DUCT.PRICE;'
      
        '1102252642=DECLARE VARIABLE SUMM_BONUS_GOT_ TYPE OF COLUMN ZAKAZ' +
        '.SUMM_BONUS_GOT;'
      
        '1102252643=DECLARE VARIABLE BONUS_TO_MINUS_ TYPE OF COLUMN G_DIS' +
        'CONT_CARD.SUMM;'
      
        '1102252644=DECLARE VARIABLE SUMM_TO_MINUS_ TYPE OF COLUMN ZAKAZ.' +
        'SUMM;'
      '1102252645=DECLARE VARIABLE SUMM_ALL_ TYPE OF COLUMN ZAKAZ.SUMM;'
      '1102252646=BEGIN'
      '1102252647='
      '1102252648=  IS_THIS_LAST_ = 0;'
      '1102252649='
      '1102252650=  SELECT S.G_TOCHKA,'
      '1102252651=         S.IS_VOZVRAT,'
      '1102252652=         S.G_PAYMENT_TYPE'
      '1102252653=         ,S.is_expected'
      
        '1102252654=         ,S.ZAKAZ          -- '#1055#1056#1048' '#1040#1055#1044#1045#1049#1058#1045' '#1053#1045' '#1055#1056#1048#1061#1054#1044#1048#1058 +
        ' '#1057' '#1045#1050#1047#1045#1064#1053#1048#1050#1040
      '1102252655=    FROM SKLAD_parent S'
      '1102252656=   WHERE S.SKLAD = :SKLAD_PARENT_'
      '1102252657=    INTO :G_TOCHKA_,'
      '1102252658=         :IS_VOZVRAT_,'
      '1102252659=         :G_PAYMENT_TYPE_OLD_'
      '1102252660=         ,:IS_EXPECTED_OLD_'
      '1102252661=         ,:ZAKAZ_;'
      '1102252662='
      '1102252663=  PNT_ = '#39'00'#39';'
      '1102252664=  UPDATE SKLAD_PARENT'
      '1102252665=  SET'
      
        '1102252666=   DATE_RECEIPT = COALESCE(:DATE_RECEIPT_, DATE_RECEI' +
        'PT),'
      
        '1102252667=   TIME_RECEIPT = COALESCE(:TIME_RECEIPT_, TIME_RECEI' +
        'PT),'
      
        '1102252668=   G_PAYMENT_TYPE = COALESCE(:G_PAYMENT_TYPE_, G_PAYM' +
        'ENT_TYPE),'
      '1102252669=   G_CLIENT = COALESCE(:G_CLIENT_, G_CLIENT),'
      '1102252670=   OSNOVANIE = COALESCE(:OSNOVANIE_, OSNOVANIE),'
      '1102252671=   NOTE      = COALESCE(:NOTE_, NOTE),'
      '1102252672=   SUMM      = :SUMM_,'
      '1102252673=   SUMM_FACT = :SUMM_FACT_,'
      '1102252674=   SUMM_CURRENCY = :SUMM_CURRENCY_,'
      
        '1102252675=   IS_PAYED_ALL  = CASE WHEN :SUMM_ <= :SUMM_FACT_ TH' +
        'EN 1 ELSE 0 END,  --IS_PAYED_ALL  = DECODE(:SUMM_, :SUMM_FACT_, ' +
        '1, 0)  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047#1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050 +
        #1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' 0'
      '1102252676=   IS_EXPECTED  = :IS_EXPECTED_'
      '1102252677=   ,G_NONCASH_PAY_TYPE = :G_NONCASH_PAY_TYPE_'
      '1102252678=  WHERE SKLAD    = :SKLAD_PARENT_;'
      '1102252679='
      
        '1102252680=  ---------------------------------------------------' +
        '----------'
      
        '1102252681=  -- '#1059#1044#1040#1051#1071#1070', '#1042#1057#1045' '#1063#1045#1043#1054' '#1053#1045#1058' '#1055#1054#1057#1051#1045' '#1056#1045#1044#1040#1050#1058#1048#1056#1054#1042#1040#1053#1048#1071' '#1055#1056#1048#1061#1054#1044 +
        #1040
      '1102252682=  PNT_ = '#39'02'#39';'
      '1102252683=  FOR SELECT SKLAD'
      '1102252684=        FROM SKLAD S'
      '1102252685=       WHERE S.SKLAD_PARENT = :SKLAD_PARENT_'
      '1102252686=         AND NOT EXISTS (SELECT 1'
      '1102252687=                           FROM SKLAD_TMP T'
      '1102252688=                        WHERE T.SKLAD = S.SKLAD)'
      '1102252689=  INTO :SKLAD_'
      '1102252690=  DO BEGIN'
      
        '1102252691=    EXECUTE PROCEDURE DEL_SKLAD_DETAIL(:SKLAD_PARENT_' +
        ', :SKLAD_, :UPLOAD_TO_EXT_APP_) RETURNING_VALUES (:ERR_CODE, :ER' +
        'R_MSG);'
      '1102252692=    IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102252693=      ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||ERR' +
        '_MSG;'
      '1102252694=      EXIT;'
      '1102252695=    END'
      '1102252696=  END'
      '1102252697='
      
        '1102252698=  ---------------------------------------------------' +
        '----------'
      
        '1102252699=  -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042#1057#1045', '#1063#1045#1043#1054' '#1053#1045#1058' '#1042' '#1057#1058#1040#1056#1054#1052' '#1055#1056#1048#1061#1054#1044#1045', '#1052#1054#1046#1045#1058' '#1044 +
        #1054#1041#1040#1042#1048#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1067#1061' '#1055#1054#1047#1048#1062#1048#1049
      '1102252700=  -- '#1048' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1057#1058#1040#1056#1067#1045' '#1055#1054#1047#1048#1062#1048#1048
      '1102252701=  PNT_ = '#39'03'#39';'
      '1102252702=  FOR SELECT S.SKLAD,'
      '1102252703=             S.G_PRODUCT,'
      '1102252704=             S.AMOUNT,'
      '1102252705=             S.PRICE,'
      '1102252706=             S.SUMM,'
      '1102252707=             S.NDS,'
      '1102252708=             S.NDS_SUMM,'
      '1102252709=             T.SKLAD,'
      '1102252710=             T.AMOUNT,'
      '1102252711=             T.IS_LAST,'
      '1102252712=             T.DATE_RECEIPT'
      '1102252713=             ,S.PRICE_CURRENCY'
      '1102252714=             ,S.SUMM_CURRENCY'
      '1102252715=             ,S.PRICE_ROZN'
      
        '1102252716=             ,(SELECT PRICE FROM G_PRODUCT G WHERE G.' +
        'G_PRODUCT = S.G_PRODUCT)'
      
        '1102252717=        FROM SKLAD_TMP S LEFT OUTER JOIN (SELECT SKLA' +
        'D, AMOUNT, IS_LAST, DATE_RECEIPT FROM SKLAD WHERE SKLAD_PARENT =' +
        ' :SKLAD_PARENT_) T ON S.SKLAD = T.SKLAD'
      '1102252718=  INTO :SKLAD_,'
      '1102252719=       :G_PRODUCT_,'
      '1102252720=       :AMOUNT_,'
      '1102252721=       :PRICE_,'
      '1102252722=       :SUMM_ONE_,'
      '1102252723=       :NDS_,'
      '1102252724=       :NDS_SUMM_,'
      '1102252725=       :SKLAD_OLD_,'
      '1102252726=       :AMOUNT_OLD_,'
      '1102252727=       :IS_THIS_LAST_,'
      '1102252728=       :DATE_RECEIPT_OLD_'
      '1102252729=       ,:PRICE_CURRENCY_'
      '1102252730=       ,:SUMM_CURRENCY_TMP_'
      '1102252731=       ,:SALE_PRICE_'
      '1102252732=       ,:SALE_PRICE_CUR_'
      '1102252733=  DO BEGIN'
      
        '1102252734=    -- '#1045#1057#1051#1048' '#1055#1056#1048#1061#1054#1044' '#1053#1054#1042#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1054#1049' '#1053#1045' '#1041#1067#1051#1054' '#1042' '#1057#1058 +
        #1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102252735=    IF (SKLAD_OLD_ IS NULL) then BEGIN'
      '1102252736=        PNT_ = '#39'04'#39';'
      
        '1102252737=        INSERT INTO SKLAD (SKLAD, SKLAD_PARENT, DATE_' +
        'RECEIPT, G_CLIENT, G_PRODUCT, AMOUNT, PRICE, SUMM, G_PAYMENT_TYP' +
        'E, NDS, NDS_SUMM,'
      
        '1102252738=                          IS_LAST, NOTE, OSNOVANIE, I' +
        'S_VOZVRAT, G_TOCHKA'
      '1102252739=                          ,PRICE_CURRENCY'
      '1102252740=                          ,SUMM_CURRENCY)'
      
        '1102252741=        VALUES (:SKLAD_, :SKLAD_PARENT_, :DATE_RECEIP' +
        'T_, :G_CLIENT_, :G_PRODUCT_, :AMOUNT_, :PRICE_, :SUMM_ONE_, :G_P' +
        'AYMENT_TYPE_, :NDS_, :NDS_SUMM_,'
      
        '1102252742=               0  -- '#1042#1057#1045#1043#1044#1040' '#1057#1058#1040#1042#1051#1070' 0, '#1040' '#1040#1053#1040#1051#1048#1047#1048#1056#1059#1070' '#1055#1054 +
        #1057#1051#1045#1044#1053#1071#1071' '#1048#1051#1048' '#1053#1045' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1055#1054#1058#1054#1052
      
        '1102252743=               ,:NOTE_,  :OSNOVANIE_, :IS_VOZVRAT_, :' +
        'G_TOCHKA_'
      '1102252744=               ,:PRICE_CURRENCY_'
      '1102252745=               ,:SUMM_CURRENCY_TMP_'
      '1102252746=               );'
      '1102252747='
      
        '1102252748=        IF (IS_EXPECTED_ = 0) THEN BEGIN          -- ' +
        #1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045' "'#1058#1054#1042#1040#1056' '#1042' '#1055#1059#1058#1048'"'
      '1102252749=            -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      '1102252750=            UPDATE LT_SKLAD_PRODUCT L'
      '1102252751=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102252752=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102252753=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102252754=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102252755='
      '1102252756=            IF (ROW_COUNT = 0) THEN'
      
        '1102252757=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102252758=        END'
      '1102252759='
      
        '1102252760=        -- '#1045#1057#1051#1048' '#1053#1045' '#1042#1054#1047#1042#1056#1040#1058', '#1058#1054' '#1053#1040#1044#1054' '#1055#1056#1054#1057#1058#1040#1042#1048#1058#1068' '#1055#1056#1048#1047#1053#1040 +
        #1050' IS_LAST, '#1054#1053' '#1053#1059#1046#1045#1053' '#1058#1054#1051#1068#1050#1054' '#1044#1051#1071' '#1058#1054#1043#1054', '#1063#1058#1054#1041#1067' '#1055#1056#1048' '#1057#1055#1048#1057#1040#1053#1048#1048' '#1048' '#1042#1054#1047#1042#1056#1040 +
        #1058#1045' '#1058#1054#1042#1040#1056#1040' '#1053#1040#1049#1058#1048' '#1062#1045#1053#1059', '#1055#1054' '#1050#1054#1058#1054#1056#1054#1049' '#1057#1055#1048#1057#1040#1058#1068' '#1048#1051#1048' '#1042#1054#1047#1042#1056#1040#1058#1048#1058#1068' '#1058#1054#1042#1040#1056
      
        '1102252761=        -- '#1045#1057#1051#1048' '#1042#1044#1056#1059#1043' '#1058#1059#1058' '#1044#1040#1058#1040' '#1052#1045#1053#1071#1045#1058#1057#1071' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1063#1045 +
        #1052' '#1041#1067#1051#1054' '#1056#1040#1053#1068#1064#1045', '#1048' '#1044#1040#1053#1040#1071' '#1047#1040#1055#1048#1057#1068' '#1048' '#1041#1067#1051#1040' IS_LAST, '#1058#1054' '#1055#1056#1054#1057#1058#1040#1042#1051#1045#1053#1048#1045' '#1055#1056 +
        #1048#1047#1053#1040#1050#1040' IS_LAST '#1044#1056#1059#1043#1054#1049' '#1055#1054#1057#1051#1045#1044#1053#1045#1049' '#1055#1054' '#1044#1040#1058#1045' '#1055#1054#1057#1058#1040#1042#1050#1045
      
        '1102252762=        -- '#1055#1056#1054#1048#1047#1042#1054#1044#1048#1058#1057#1071' '#1059#1046#1045' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' DEL_SKLAD_DET' +
        'AIL '#1048' '#1047#1044#1045#1057#1068' '#1055#1040#1056#1048#1058#1057#1071' '#1053#1045' '#1053#1040#1044#1054' '#1054#1041' '#1069#1058#1054#1052
      '1102252763=        PNT_ = '#39'05'#39';'
      '1102252764=        IF (IS_VOZVRAT_ = 0) then BEGIN'
      '1102252765=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102252766=              FROM SKLAD SK'
      '1102252767=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102252768=               AND SK.IS_LAST = 1'
      '1102252769=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102252770=              INTO :DATE_LAST_;'
      '1102252771='
      
        '1102252772=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ >= DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055 +
        #1054#1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102252773=              UPDATE SKLAD SK'
      '1102252774=                 SET SK.IS_LAST = 0'
      '1102252775=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102252776=                 AND SK.IS_LAST = 1'
      '1102252777=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102252778='
      '1102252779=              UPDATE SKLAD SK'
      '1102252780=                 SET SK.IS_LAST = 1'
      '1102252781=               WHERE SK.SKLAD = :SKLAD_;'
      '1102252782=            END'
      '1102252783=        END'
      
        '1102252784=    -- '#1045#1057#1051#1048' '#1048#1047#1052#1045#1053#1045#1053#1048#1045' '#1057#1058#1040#1056#1054#1049' '#1044#1045#1058#1040#1051#1048', '#1050#1054#1058#1054#1056#1040#1071' '#1041#1067#1051#1040' '#1042' '#1057 +
        #1058#1040#1056#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '1102252785=    END ELSE BEGIN'
      '1102252786=        PNT_ = '#39'06'#39';'
      '1102252787=        UPDATE SKLAD S'
      '1102252788=           SET S.DATE_RECEIPT = :DATE_RECEIPT_,'
      '1102252789=               S.G_CLIENT = :G_CLIENT_,'
      '1102252790=               S.AMOUNT   = :AMOUNT_,'
      '1102252791=               S.PRICE    = :PRICE_,'
      '1102252792=               S.SUMM     = :SUMM_ONE_,'
      '1102252793=               S.G_PAYMENT_TYPE = :G_PAYMENT_TYPE_,'
      '1102252794=               S.NDS      = :NDS_,'
      '1102252795=               S.NDS_SUMM = :NDS_SUMM_,'
      '1102252796=               S.OSNOVANIE = :OSNOVANIE_,'
      '1102252797=               S.NOTE      = :NOTE_'
      '1102252798=               ,S.PRICE_CURRENCY = :PRICE_CURRENCY_'
      
        '1102252799=               ,S.SUMM_CURRENCY  = :SUMM_CURRENCY_TMP' +
        '_'
      '1102252800=         WHERE S.SKLAD = :SKLAD_;'
      '1102252801='
      '1102252802=        -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040
      
        '1102252803=        IF (IS_EXPECTED_ = IS_EXPECTED_OLD_ AND IS_EX' +
        'PECTED_ = 0) THEN BEGIN'
      '1102252804=            if (AMOUNT_OLD_ > AMOUNT_) then'
      '1102252805=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102252806=                 SET L.AMOUNT = L.AMOUNT - (:AMOUNT_O' +
        'LD_ - :AMOUNT_),'
      
        '1102252807=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102252808=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102252809=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102252810='
      '1102252811=            ELSE if (AMOUNT_ > AMOUNT_OLD_) then'
      '1102252812=              UPDATE LT_SKLAD_PRODUCT L'
      
        '1102252813=                 SET L.AMOUNT = L.AMOUNT + (:AMOUNT_ ' +
        '- :AMOUNT_OLD_),'
      
        '1102252814=                     L.NEED_TO_EXPORT = :UPLOAD_TO_EX' +
        'T_APP_'
      '1102252815=               WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102252816=                 AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102252817=        END'
      
        '1102252818=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1041#1067#1051' '#1042' '#1055#1059#1058#1048' '#1048' '#1055#1056#1048#1064#1045#1051' '#1053#1040' '#1057#1050#1051#1040#1044', '#1058 +
        #1054' '#1053#1040#1044#1054' '#1055#1056#1048#1041#1040#1042#1048#1058#1068' '#1050' '#1057#1050#1051#1040#1044#1059
      
        '1102252819=        ELSE IF (IS_EXPECTED_OLD_ = 1 AND IS_EXPECTED' +
        '_ = 0) THEN BEGIN'
      '1102252820=            UPDATE LT_SKLAD_PRODUCT L'
      '1102252821=               SET L.AMOUNT = L.AMOUNT + :AMOUNT_,'
      
        '1102252822=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102252823=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102252824=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102252825='
      '1102252826=            IF (ROW_COUNT = 0) THEN'
      
        '1102252827=              INSERT INTO LT_SKLAD_PRODUCT VALUES (GE' +
        'N_ID(GEN_LT_SKLAD_PRODUCT, 1), :G_PRODUCT_, :AMOUNT_, 0, :G_TOCH' +
        'KA_, :UPLOAD_TO_EXT_APP_);'
      '1102252828=        END'
      
        '1102252829=        -- '#1045#1057#1051#1048' '#1055#1054#1051#1068#1047#1054#1042#1040#1058#1045#1051#1068' '#1042#1044#1056#1059#1043' '#1056#1045#1064#1048#1051' '#1057#1053#1054#1042#1040' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' '#1043#1040#1051#1050#1059' - '#1042' '#1055#1059#1058#1048
      
        '1102252830=        ELSE IF (IS_EXPECTED_OLD_ = 0 AND IS_EXPECTED' +
        '_ = 1) THEN BEGIN'
      '1102252831=            UPDATE LT_SKLAD_PRODUCT L'
      
        '1102252832=               SET L.AMOUNT = L.AMOUNT - (:AMOUNT_OLD' +
        '_ - :AMOUNT_) - :AMOUNT_,'
      
        '1102252833=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_' +
        'APP_'
      '1102252834=             WHERE L.G_PRODUCT = :G_PRODUCT_'
      '1102252835=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '1102252836=        END'
      '1102252837='
      
        '1102252838=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1041#1054#1051#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' '#1053#1045#1058' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042 +
        #1048#1058#1068' IS_LAST = 1'
      '1102252839=        PNT_ = '#39'07'#39';'
      
        '1102252840=        IF ((DATE_RECEIPT_ >= DATE_RECEIPT_OLD_) AND ' +
        '(IS_THIS_LAST_ = 0) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102252841=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102252842=              FROM SKLAD SK'
      '1102252843=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102252844=               AND SK.IS_LAST = 1'
      '1102252845=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102252846=              INTO :DATE_LAST_;'
      '1102252847='
      
        '1102252848=            IF ((DATE_LAST_ IS NULL) OR (DATE_RECEIPT' +
        '_ > DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1055#1045#1056#1042#1040#1071' '#1055#1054#1057#1058#1040#1042#1050#1040' '#1048#1051#1048' '#1044#1040#1058#1040' '#1055#1054 +
        #1057#1058#1040#1042#1050#1048' '#1041#1054#1051#1068#1064#1045' '#1063#1045#1052' '#1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102252849=              UPDATE SKLAD SK'
      '1102252850=                 SET SK.IS_LAST = 0'
      '1102252851=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102252852=                 AND SK.IS_LAST = 1'
      '1102252853=                 AND SK.G_TOCHKA = :G_TOCHKA_;'
      '1102252854='
      '1102252855=              UPDATE SKLAD SK'
      '1102252856=                 SET SK.IS_LAST = 1'
      '1102252857=               WHERE SK.SKLAD = :SKLAD_;'
      '1102252858=            END'
      '1102252859=        END'
      '1102252860='
      
        '1102252861=        -- '#1045#1057#1051#1048' '#1044#1040#1058#1040' '#1055#1054#1052#1045#1053#1071#1051#1040#1057#1068' '#1053#1040' '#1052#1045#1053#1068#1064#1059#1070' '#1048' '#1059' '#1047#1040#1055#1048#1057#1048 +
        ' IS_LAST = 1, '#1058#1054' '#1042#1044#1056#1059#1043' '#1054#1053#1040' '#1058#1045#1055#1045#1056#1068' '#1053#1045#1055#1054#1057#1051#1045#1044#1053#1071#1071' '#1048' '#1045#1049' '#1053#1040#1044#1054' '#1055#1054#1057#1058#1040#1042#1048#1058 +
        #1068' IS_LAST = 0'
      '1102252862=        PNT_ = '#39'08'#39';'
      
        '1102252863=        IF ((DATE_RECEIPT_ < DATE_RECEIPT_OLD_) AND (' +
        'IS_THIS_LAST_ = 1) AND (IS_VOZVRAT_ = 0)) THEN BEGIN'
      '1102252864=            SELECT MAX(SK.DATE_RECEIPT)'
      '1102252865=              FROM SKLAD SK'
      '1102252866=             WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102252867=               AND SK.SKLAD_PARENT <> :SKLAD_PARENT_'
      '1102252868=               AND SK.G_TOCHKA = :G_TOCHKA_'
      '1102252869=               AND SK.is_vozvrat IN (0,4)'
      '1102252870=              INTO :DATE_LAST_;'
      '1102252871='
      
        '1102252872=            IF ((DATE_LAST_ IS NOT NULL) AND (DATE_RE' +
        'CEIPT_ < DATE_LAST_)) THEN BEGIN  -- '#1045#1057#1051#1048' '#1053#1054#1042#1040#1071' '#1044#1040#1058#1040' '#1052#1045#1053#1068#1064#1045' '#1063#1045#1052' ' +
        #1055#1054#1057#1051#1045#1044#1053#1071#1071
      '1102252873=              UPDATE SKLAD SK'
      '1102252874=                 SET SK.IS_LAST = 0'
      '1102252875=               WHERE SK.SKLAD = :SKLAD_;'
      '1102252876='
      '1102252877=               UPDATE SKLAD SK'
      '1102252878=                 SET SK.IS_LAST = 1'
      '1102252879=               WHERE SK.G_PRODUCT = :G_PRODUCT_'
      '1102252880=                 AND SK.SKLAD = (SELECT MAX(SS.SKLAD)'
      '1102252881=                                   FROM SKLAD SS'
      
        '1102252882=                                  WHERE SS.G_PRODUCT ' +
        '= SK.G_PRODUCT'
      
        '1102252883=                                    AND SS.DATE_RECEI' +
        'PT = :DATE_LAST_'
      
        '1102252884=                                    AND SS.G_TOCHKA =' +
        ' :G_TOCHKA_'
      
        '1102252885=                                    AND SS.is_vozvrat' +
        ' IN (0,4));'
      '1102252886='
      '1102252887=            END'
      
        '1102252888=            -- '#1041#1067#1051' '#1058#1040#1050#1054#1049' '#1057#1051#1059#1063#1040#1049'. '#1059' '#1040#1053#1044#1056' '#1050#1040#1050#1048#1052'-'#1058#1054' '#1041#1054#1050#1054 +
        #1052' '#1055#1054#1071#1042#1048#1051#1048#1057#1068' '#1058#1054#1042#1040#1056#1067' '#1057' IS_LAST = 0, '#1061#1054#1058#1071' '#1041#1067#1051' '#1042#1057#1045#1043#1054' '#1054#1044#1048#1053' '#1055#1056#1048#1061#1054#1044' '#1055#1054' ' +
        #1053#1048#1052'.'
      
        '1102252889=            -- '#1055#1054#1069#1058#1054#1052#1059' '#1058#1059#1058' '#1045#1057#1051#1048' DATE_LAST_ IS NULL '#1041#1059 +
        #1044#1059' '#1055#1056#1048#1053#1059#1044#1048#1058#1045#1051#1068#1053#1054' '#1055#1054' '#1053#1048#1052' '#1042#1067#1057#1058#1040#1042#1051#1071#1058#1068' 1'
      
        '1102252890=            ELSE IF ((DATE_LAST_ IS NULL) AND (IS_THI' +
        'S_LAST_ = 1)) THEN BEGIN'
      '1102252891=              UPDATE SKLAD SK'
      '1102252892=                 SET SK.IS_LAST = 1'
      '1102252893=               WHERE SK.SKLAD = :SKLAD_;'
      '1102252894=            END'
      '1102252895=        END'
      '1102252896=    END'
      '1102252897='
      
        '1102252898=    IF (SALE_PRICE_ <> SALE_PRICE_CUR_ AND IS_VOZVRAT' +
        '_ = 0) THEN   -- '#1062#1045#1053#1059' '#1052#1045#1053#1071#1070' '#1058#1054#1051#1068#1050#1054' '#1055#1056#1048' '#1055#1056#1048#1061#1054#1044#1045
      '1102252899=      UPDATE G_PRODUCT G'
      '1102252900=         SET G.PRICE = :SALE_PRICE_'
      '1102252901=       WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '1102252902=  END'
      '1102252903='
      
        '1102252904=  IF (IS_VOZVRAT_ <> 5) THEN BEGIN  -- '#1054#1055#1045#1056#1040#1062#1048#1048' '#1057' '#1050#1040#1057 +
        #1057#1054#1049' '#1044#1045#1051#1040#1070', '#1045#1057#1051#1048' '#1069#1058#1054' '#1053#1045' '#1056#1045#1042#1048#1047#1048#1071
      '1102252905=      ----------------------------------------'
      
        '1102252906=      -- '#1052#1045#1053#1071#1070' '#1057#1059#1052#1052#1059' '#1042' '#1050#1040#1057#1057#1045', '#1058'.'#1050'. '#1070#1047#1045#1056' '#1052#1054#1046#1045#1058' '#1055#1045#1056#1045#1041#1048#1058 +
        #1068' '#1044#1040#1058#1059' '#1042' '#1055#1056#1048#1061#1054#1044#1045', '#1058#1054' '#1051#1059#1063#1064#1045' '#1059#1044#1040#1051#1048#1058#1068' '#1047#1040#1055#1048#1057#1048' '#1042' '#1050#1040#1057#1057#1045' '#1047#1040' '#1069#1058#1054' '#1063#1048#1057#1051#1054','
      
        '1102252907=      -- '#1048' '#1057#1054#1047#1044#1040#1058#1068' '#1053#1054#1042#1054#1045', '#1058'.'#1050'. '#1042' '#1050#1040#1057#1057#1045' '#1059' '#1052#1045#1053#1071' '#1047#1040#1042#1071#1047#1050#1048 +
        ' '#1048#1052#1045#1053#1053#1054' '#1055#1054' '#1044#1040#1058#1040#1052'  - '#1058#1045#1055#1045#1056#1068' '#1069#1058#1054' '#1044#1045#1051#1040#1045#1058#1057#1071' '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1045' K_UPD_KASSA'
      '1102252908=      -- '#1042#1054#1047#1052#1054#1046#1053#1054' 4 '#1042#1040#1056#1048#1040#1053#1058#1040' '#1056#1040#1047#1042#1048#1058#1048#1071' '#1057#1054#1041#1067#1058#1048#1049':'
      
        '1102252909=      -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' ' +
        #1048#1047#1052#1045#1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1044#1042#1048#1046#1045#1053#1048#1071' ('#1045#1057#1051#1048' '#1052#1045#1053#1071#1051#1054 +
