        '11018393=           LEFT OUTER JOIN (SELECT * FROM G_ADDRESS WHE' +
        'RE IS_DEFAULT = 1) GA ON C.G_CLIENT = GA.G_CLIENT'
      
        '11018394=           LEFT OUTER JOIN (SELECT B.BIK, B.NAME BANK_N' +
        'AME, A.ACCOUNT, A.G_CLIENT FROM G_BANK B, G_ACCOUNT A'
      
        '11018395=                            WHERE A.G_BANK = B.G_BANK A' +
        'ND A.IS_DEFAULT = 1) GB ON C.G_CLIENT = GB.G_CLIENT'
      '11018396=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '11018397=      AND Z.G_CLIENT = C.G_CLIENT'
      '11018398=      AND :MODE_ <> 3'
      '11018399=    UNION ALL'
      '110183100=    SELECT'
      '110183101=      c.name||COALESCE(DECODE(:CURRENCY_, 0, '#39#39','
      
        '110183102=                             '#39', '#1048#1053#1053#39'||COALESCE(R.IDN, ' +
        #39#39')||'#39', '#1050#1055#1055' , '#39'||COALESCE(AD.ADDRESS,'#39#39')||'
      
        '110183103=                             '#39', '#1088'/'#1089' '#39'||COALESCE(GF.ACC' +
        'OUNT, '#39#39')),'
      '110183104=                       '#39#39'),'
      '110183105=      S.DATE_RECEIPT Z_DATE'
      '110183106=    FROM SKLAD_PARENT S,'
      '110183107=         G_TOCHKA C,'
      
        '110183108=         G_FIRM_REKVIZIT R LEFT OUTER JOIN G_FIRM_ADDR' +
        'ESS AD ON AD.G_FIRM_REKVIZIT = R.G_FIRM_REKVIZIT AND AD.IS_DEFAU' +
        'LT = 1'
      
        '110183109=           LEFT OUTER JOIN G_FIRM_ACCOUNT GF ON GF.G_F' +
        'IRM_REKVIZIT = R.G_FIRM_REKVIZIT AND GF.IS_DEFAULT = 1'
      '110183110=    WHERE S.SKLAD = :ZAKAZ_'
      '110183111=      AND S.G_TOCHKA = C.G_TOCHKA'
      '110183112=      AND R.IS_DEFAULT = 1'
      '110183113=      AND :MODE_ = 3'
      '110183114=    INTO'
      '110183115=      :GRUZOPOLUCHATEL_,'
      '110183116=      :INIT_DATE_;'
      '110183117='
      
        '110183118=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054 +
        #1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '110183119=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054' ' +
        #1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '110183120=    PNT_ = '#39'05'#39';'
      '110183121=    SELECT C.id'
      '110183122=      FROM cur_params C'
      '110183123=     WHERE C.cur_params = 1'
      '110183124=    INTO :G_OFFICIAL_;'
      '110183125='
      '110183126=    IF (ROW_COUNT = 0) then BEGIN'
      '110183127=        SELECT MIN(O.G_OFFICIAL)'
      '110183128=          FROM G_OFFICIAL O'
      '110183129=          INTO :G_OFFICIAL_;'
      '110183130=        IF (ROW_COUNT = 0) then BEGIN'
      '110183131=            Err_Code = -20500;'
      
        '110183132=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057 +
        #1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      
        '110183133=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110183134=            EXIT;'
      '110183135=        END'
      '110183136=    END'
      '110183137='
      '110183138=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '110183139=    SELECT O.G_OFFICIAL'
      '110183140=    FROM G_OFFICIAL O'
      '110183141=    WHERE O.IS_RUKOVODITEL = 1'
      '110183142=    INTO :G_OFFICIAL_RUKOVOD_;'
      '110183143='
      '110183144=    --'#1048#1065#1059' '#1075#1083#1072#1074#1073#1091#1093#1072
      '110183145=    SELECT O.G_OFFICIAL'
      '110183146=    FROM G_OFFICIAL O'
      '110183147=    WHERE O.IS_GLAVBUH = 1'
      '110183148=    INTO :GLAVBUH_;'
      '110183149='
      
        '110183150=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1053#1040#1050#1051#1040#1044#1053#1054#1049', '#1057#1053#1040#1063#1040#1051#1040' '#1057#1044#1045#1051#1040#1051 +
        ' '#1042#1048#1044#1040' "0000123", '#1040' '#1055#1054#1058#1054#1052' '#1055#1051#1070#1053#1059#1051' '#1048' '#1057#1044#1045#1051#1040#1051' '#1054#1041#1067#1063#1053#1054' "123"'
      
        '110183151=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(M' +
        'AX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMERI' +
        'C(15))) + 1) FROM INVOICE_PAY'
      
        '110183152=    /*SELECT CAST(MAX(CAST(NUM AS NUMERIC(15)))+1 AS V' +
        'ARCHAR(20)) -- COALESCE '#1055#1054#1057#1058#1040#1042#1048#1051
      '110183153=      FROM WAYBILL P'
      '110183154=    INTO :NUM_;*/'
      '110183155=    NUM_ = 1;'
      '110183156='
      
        '110183157=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1042#1054#1054#1041#1065#1045' ' +
        #1053#1045#1058
      '110183158=      NUM_ = '#39'1'#39';'
      '110183159=  END'
      '110183160=END'
      '110183161=;'
      '110183162='
      '110183163='
      
        '110183164=UPDATE SYSTEM_SETUP SET S_VALUE = 110183 WHERE SYSTEM_' +
        'SETUP = 3;'
      
        '110183165=UPDATE RDB$PROCEDURES SET RDB$PROCEDURE_SOURCE=NULL, R' +
        'DB$DESCRIPTION=NULL;'
      '110183166=UPDATE rdb$relation_fields SET RDB$DESCRIPTION=NULL;'
      '1101840='
      '1101841=ALTER PROCEDURE W_GET_WAYBILL('
      '1101842=  WAYBILL_ TYPE OF COLUMN WAYBILL.WAYBILL,'
      '1101843=  ZAKAZ_ TYPE OF COLUMN INVOICE.ZAKAZ,'
      '1101844=  CURRENCY_ INTEGER,'
      '1101845=  MODE_ INTEGER)'
      '1101846=RETURNS ('
      '1101847=  NUM_ TYPE OF COLUMN WAYBILL.NUM,'
      '1101848=  INIT_DATE_ TYPE OF COLUMN WAYBILL.INIT_DATE,'
      '1101849=  G_FIRM_ TYPE OF COLUMN DOCS.G_FIRM,'
      '11018410=  POSTAVSHIK_ TYPE OF COLUMN WAYBILL.POSTAVSHIK,'
      '11018411=  IDN_ TYPE OF COLUMN WAYBILL.IDN,'
      
        '11018412=  GRUZOPOLUCHATEL_ TYPE OF COLUMN WAYBILL.GRUZOPOLUCHAT' +
        'EL,'
      
        '11018413=  OTVETST_ZA_POST_ TYPE OF COLUMN WAYBILL.OTVETST_ZA_PO' +
        'ST,'
      '11018414=  TRANSP_ORG_ TYPE OF COLUMN WAYBILL.TRANSP_ORG,'
      '11018415=  TRANSP_NAKLAD_ TYPE OF COLUMN WAYBILL.TRANSP_NAKLAD,'
      
        '11018416=  G_OFFICIAL_RUKOVOD_ TYPE OF COLUMN WAYBILL.G_OFFICIAL' +
        '_RUKOVOD,'
      '11018417=  G_OFFICIAL_ TYPE OF COLUMN WAYBILL.G_OFFICIAL,'
      '11018418=  ZAKAZ_SAVED_ TYPE OF COLUMN WAYBILL.ZAKAZ,'
      '11018419=  GLAVBUH_ TYPE OF COLUMN WAYBILL.GLAVBUH,'
      '11018420=  DOVERENNOST_ TYPE OF COLUMN WAYBILL.DOVERENNOST,'
      
        '11018421=  DOVERENNOST_FIO_ TYPE OF COLUMN WAYBILL.DOVERENNOST_F' +
        'IO,'
      '11018422=  ERR_CODE INTEGER,'
      '11018423=  ERR_MSG VARCHAR(1024))'
      '11018424=AS'
      
        '11018425=DECLARE VARIABLE PROCNAME VARCHAR(30) = '#39'W_GET_WAYBILL'#39 +
        ';'
      '11018426=DECLARE VARIABLE PNT_ VARCHAR(5);'
      '11018427=BEGIN'
      '11018428=  SELECT'
      '11018429=    NUM,'
      '11018430=    INIT_DATE,'
      '11018431=    G_FIRM,'
      '11018432=    POSTAVSHIK,'
      '11018433=    IDN,'
      '11018434=    GRUZOPOLUCHATEL,'
      '11018435=    OTVETST_ZA_POST,'
      '11018436=    TRANSP_ORG,'
      '11018437=    TRANSP_NAKLAD,'
      '11018438=    G_OFFICIAL_RUKOVOD,'
      '11018439=    G_OFFICIAL,'
      '11018440=    ZAKAZ,'
      '11018441=    GLAVBUH,'
      '11018442=    doverennost,'
      '11018443=    doverennost_FIO'
      '11018444=  FROM WAYBILL'
      '11018445=  WHERE WAYBILL = :WAYBILL_'
      '11018446=  INTO'
      '11018447=    :NUM_,'
      '11018448=    :INIT_DATE_,'
      '11018449=    :G_FIRM_,'
      '11018450=    :POSTAVSHIK_,'
      '11018451=    :IDN_,'
      '11018452=    :GRUZOPOLUCHATEL_,'
      '11018453=    :OTVETST_ZA_POST_,'
      '11018454=    :TRANSP_ORG_,'
      '11018455=    :TRANSP_NAKLAD_,'
      '11018456=    :G_OFFICIAL_RUKOVOD_,'
      '11018457=    :G_OFFICIAL_,'
      '11018458=    :ZAKAZ_SAVED_'
      '11018459=    ,:GLAVBUH_'
      '11018460=    ,:doverennost_'
      '11018461=    ,:doverennost_fio_;'
      '11018462='
      '11018463=  IF (ROW_COUNT = 0) then BEGIN'
      '11018464=  --**************************************************'
      
        '11018465=    -- '#1047#1053#1040#1063#1048#1058' '#1053#1040#1050#1051#1040#1044#1053#1040#1071' '#1045#1065#1045' '#1053#1045' '#1057#1054#1047#1044#1040#1053#1040', '#1047#1040#1055#1054#1051#1053#1070' '#1045#1045' '#1055#1056#1045#1044 +
        #1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1052#1048' '#1044#1040#1053#1053#1067#1052
      '11018466=    -- '#1048#1053#1060#1054#1056#1052#1040#1062#1048#1071' '#1054' '#1052#1054#1045#1049' '#1060#1048#1056#1052#1045
      '11018467=    SELECT'
      '11018468=      G.G_FIRM_REKVIZIT,'
      '11018469=      G.NAME||DECODE(:CURRENCY_, 0, '#39#39','
      
        '11018470=                     '#39', '#1048#1053#1053#39'||COALESCE(G.IDN, '#39#39')||'#39', '#1050 +
        #1055#1055#39'||COALESCE(G.KPP, '#39#39')||'#39', '#39'||COALESCE(GF.ADDRESS,'#39#39')||'#39', '#1090#1077#1083'.' +
        #39'||COALESCE(GF.PHONE, '#39#39')||'
      
        '11018471=                     '#39', '#1088'/'#1089' '#39'||COALESCE(GB.ACCOUNT, '#39#39')' +
        '||'#39' '#1074' '#1073#1072#1085#1082#1077' '#39'||GB.BANK_NAME||'#39' '#1041#1048#1050' '#39'||GB.BIK||'#39' '#1082'/'#1089' '#39'),'
      '11018472=      G.IDN'
      '11018473=    FROM G_FIRM_REKVIZIT g'
      
        '11018474=           LEFT OUTER JOIN (SELECT * FROM G_FIRM_ADDRES' +
        'S WHERE IS_DEFAULT = 1) GF ON G.G_FIRM_REKVIZIT = GF.G_FIRM_REKV' +
        'IZIT'
      
        '11018475=           LEFT OUTER JOIN (SELECT B.BIK, B.NAME BANK_N' +
        'AME, A.ACCOUNT, A.G_FIRM_REKVIZIT'
      
        '11018476=                              FROM G_BANK B, G_FIRM_ACC' +
        'OUNT A'
      
        '11018477=                             WHERE A.G_BANK = B.G_BANK ' +
        'AND A.IS_DEFAULT = 1) GB ON G.G_FIRM_REKVIZIT = GB.G_FIRM_REKVIZ' +
        'IT'
      '11018478=    WHERE G.IS_DEFAULT = 1'
      '11018479=    INTO'
      '11018480=      :G_FIRM_,'
      '11018481=      :POSTAVSHIK_,'
      '11018482=      :IDN_;'
      '11018483='
      '11018484=    -- '#1048#1053#1060#1054' '#1054' '#1047#1040#1050#1040#1047#1045' '#1048' '#1050#1051#1048#1045#1053#1058#1045
      '11018485=    SELECT'
      
        '11018486=      DECODE(CHAR_LENGTH(COALESCE(c.name_FULL, '#39#39')), 0,' +
        ' C.NAME, c.name_FULL)||COALESCE(DECODE(:CURRENCY_, 0, '#39#39','
      
        '11018487=                             '#39', '#1048#1053#1053#39'||COALESCE(C.IDN, '#39 +
        #39')||'#39', '#1050#1055#1055' , '#39'||COALESCE(GA.ADDRESS,'#39#39')||'#39', '#1090#1077#1083'.'#39'||COALESCE(GA.P' +
        'HONE, '#39#39')||'
      
        '11018488=                             '#39', '#1088'/'#1089' '#39'||COALESCE(GB.ACCO' +
        'UNT, '#39#39')||'#39' '#1074' '#1073#1072#1085#1082#1077' '#39'||GB.BANK_NAME||'#39' '#1041#1048#1050' '#39'||GB.BIK||'#39' '#1082'/'#1089' '#39'),'
      '11018489=                       '#39#39'),'
      '11018490=      z.Z_DATE'
      '11018491=    FROM ZAKAZ Z,'
      '11018492=         G_CLIENT C'
      
        '11018493=           LEFT OUTER JOIN (SELECT * FROM G_ADDRESS WHE' +
        'RE IS_DEFAULT = 1) GA ON C.G_CLIENT = GA.G_CLIENT'
      
        '11018494=           LEFT OUTER JOIN (SELECT B.BIK, B.NAME BANK_N' +
        'AME, A.ACCOUNT, A.G_CLIENT FROM G_BANK B, G_ACCOUNT A'
      
        '11018495=                            WHERE A.G_BANK = B.G_BANK A' +
        'ND A.IS_DEFAULT = 1) GB ON C.G_CLIENT = GB.G_CLIENT'
      '11018496=    WHERE Z.ZAKAZ = :ZAKAZ_'
      '11018497=      AND Z.G_CLIENT = C.G_CLIENT'
      '11018498=      AND :MODE_ <> 3'
      '11018499=    UNION ALL'
      '110184100=    SELECT'
      '110184101=      c.name||COALESCE(DECODE(:CURRENCY_, 0, '#39#39','
      
        '110184102=                             '#39', '#1048#1053#1053#39'||COALESCE(R.IDN, ' +
        #39#39')||'#39', '#1050#1055#1055' , '#39'||COALESCE(AD.ADDRESS,'#39#39')||'
      
        '110184103=                             '#39', '#1088'/'#1089' '#39'||COALESCE(GF.ACC' +
        'OUNT, '#39#39')),'
      '110184104=                       '#39#39'),'
      '110184105=      S.DATE_RECEIPT Z_DATE'
      '110184106=    FROM SKLAD_PARENT S,'
      '110184107=         G_TOCHKA C,'
      
        '110184108=         G_FIRM_REKVIZIT R LEFT OUTER JOIN G_FIRM_ADDR' +
        'ESS AD ON AD.G_FIRM_REKVIZIT = R.G_FIRM_REKVIZIT AND AD.IS_DEFAU' +
        'LT = 1'
      
        '110184109=           LEFT OUTER JOIN G_FIRM_ACCOUNT GF ON GF.G_F' +
        'IRM_REKVIZIT = R.G_FIRM_REKVIZIT AND GF.IS_DEFAULT = 1'
      '110184110=    WHERE S.SKLAD = :ZAKAZ_'
      '110184111=      AND S.G_TOCHKA = C.G_TOCHKA'
      '110184112=      AND R.IS_DEFAULT = 1'
      '110184113=      AND :MODE_ = 3'
      '110184114=    INTO'
      '110184115=      :GRUZOPOLUCHATEL_,'
      '110184116=      :INIT_DATE_;'
      '110184117='
      
        '110184118=    --'#1048#1065#1059' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1071', '#1045#1057#1051#1048' '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1057#1054#1058#1056#1059#1044#1053#1048#1050#1054#1042', '#1063#1058#1054 +
        #1041#1067' '#1053#1045' '#1044#1040#1042#1040#1051#1054' '#1054#1064#1048#1041#1050#1059
      
        '110184119=    -- '#1042#1054#1054#1041#1065#1045' '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1055#1045#1056#1045#1044#1045#1051#1040#1058#1068' '#1058#1040#1050', '#1063#1058#1054' '#1058#1054#1058' '#1050#1058#1054' ' +
        #1056#1040#1057#1055#1045#1063#1040#1058#1067#1042#1040#1045#1058', '#1058#1054#1058' '#1048' '#1048#1057#1055#1054#1051#1053#1048#1058#1045#1051#1068' '#1055#1054' '#1048#1044#1045#1045
      '110184120=    PNT_ = '#39'05'#39';'
      '110184121=    SELECT C.id'
      '110184122=      FROM cur_params C'
      '110184123=     WHERE C.cur_params = 1'
      '110184124=    INTO :G_OFFICIAL_;'
      '110184125='
      '110184126=    IF (ROW_COUNT = 0) then BEGIN'
      '110184127=        SELECT MIN(O.G_OFFICIAL)'
      '110184128=          FROM G_OFFICIAL O'
      '110184129=          INTO :G_OFFICIAL_;'
      '110184130=        IF (ROW_COUNT = 0) then BEGIN'
      '110184131=            Err_Code = -20500;'
      
        '110184132=            EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1057 +
        #1087#1088#1072#1074#1086#1095#1085#1080#1082' '#1089#1086#1090#1088#1091#1076#1085#1080#1082#1086#1074' '#1087#1091#1089#1090'! '#1047#1072#1087#1086#1083#1085#1080#1090#1077' '#1076#1072#1085#1085#1099#1077'!'#39') RETURNING_VALUES' +
        ' (:ERR_MSG);'
      
        '110184133=            ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39 +
        '||ERR_MSG;'
      '110184134=            EXIT;'
      '110184135=        END'
      '110184136=    END'
      '110184137='
      '110184138=    --'#1048#1065#1059' '#1088#1091#1082#1086#1074#1086#1076#1080#1090#1077#1083#1103
      '110184139=    SELECT O.G_OFFICIAL'
      '110184140=    FROM G_OFFICIAL O'
      '110184141=    WHERE O.IS_RUKOVODITEL = 1'
      '110184142=    INTO :G_OFFICIAL_RUKOVOD_;'
      '110184143='
      '110184144=    --'#1048#1065#1059' '#1075#1083#1072#1074#1073#1091#1093#1072
      '110184145=    SELECT O.G_OFFICIAL'
      '110184146=    FROM G_OFFICIAL O'
      '110184147=    WHERE O.IS_GLAVBUH = 1'
      '110184148=    INTO :GLAVBUH_;'
      '110184149='
      '110184150=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1067#1049' '#1053#1054#1052#1045#1056' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      
        '110184151=    --select substring('#39'0000000000'#39' from CHAR_LENGTH(M' +
        'AX(CAST(NUM AS NUMERIC(15))))+1 for 10)||(MAX(CAST(NUM AS NUMERI' +
        'C(15))) + 1) FROM INVOICE_PAY'
      '110184152=    PNT_ = '#39'GENNM'#39';'
      
        '110184153=    SELECT LPAD(CAST(MAX(CAST(TRIM(REPLACE(NUM, ASCII_' +
        'CHAR(13) || ASCII_CHAR(10), '#39#39')) AS NUMERIC(15)))+1 AS VARCHAR(2' +
        '0)), 10, '#39'0'#39')'
      '110184154=      FROM WAYBILL P'
      '110184155=    INTO :NUM_;'
      '110184156='
      
        '110184157=    if (NUM_ IS NULL) then  -- '#1042#1044#1056#1059#1043' '#1053#1040#1050#1051#1040#1044#1053#1067#1061' '#1042#1054#1054#1041#1065#1045' ' +
        #1053#1045#1058
      '110184158=      NUM_ = '#39'1'#39';'
      '110184159=  END'
      '110184160=WHEN ANY DO BEGIN'
      '110184161=    IF (PNT_ = '#39'GENNM'#39') THEN BEGIN'
      '110184162=        NUM_ = '#39'0000000000'#39';'
      '110184163=    END'
      '110184164=    ELSE BEGIN'
      '110184165=        Err_code = -20500;'
      
        '110184166=        EXECUTE PROCEDURE GET_ERR_MSG(ERR_CODE, '#39#1054#1064#1048#1041#1050 +
