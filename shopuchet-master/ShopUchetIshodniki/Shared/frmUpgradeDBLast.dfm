      '1102503690=                    SELECT 2'
      '1102503691=                      FROM KASSA_BEZNAL KB'
      '1102503692=                     WHERE KB.KASSA_BEZNAL = :KASSA_'
      '1102503693=                     INTO :PAYMENT_TYPE_OLD_;'
      '1102503694='
      '1102503695=                    PNT_ = '#39'06'#39';'
      
        '1102503696=                    IF (PAYMENT_TYPE_OLD_ = PAYMENT_T' +
