      '1101131720=                END'
      '1101131721=            END'
      '1101131722=            IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101131723=              ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||' +
        #39' '#39'||ERR_MSG;'
      '1101131724=              EXIT;'
      '1101131725=            END'
      '1101131726='
      
        '1101131727=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101131728=      END'
      '1101131729='
      
        '1101131730=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101131731=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101131732=            FROM KASSA K'
      '1101131733=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101131734=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1101131735=           UNION'
      '1101131736=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1101131737=            FROM KASSA K'
      '1101131738=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101131739=             AND K.SUMM = 0'
      '1101131740=          UNION'
      '1101131741=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101131742=            FROM KASSA_BEZNAL K'
      '1101131743=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101131744=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA_BEZNAL||'#39'~'#39
      '1101131745=          UNION'
      '1101131746=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101131747=            FROM KASSA_BEZNAL K'
      '1101131748=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101131749=             AND K.SUMM = 0'
      '1101131750=            INTO :KASSA_, :PAYMENT_TYPE_OLD_'
      '1101131751=      DO BEGIN'
      '1101131752=        PNT_ = '#39'011A'#39';'
      
        '1101131753=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_, :PAYME' +
        'NT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101131754=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101131755=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101131756=          EXIT;'
      '1101131757=        END'
      '1101131758=      END'
      '1101131759=  END'
      '1101131760='
      
        '1101131761=  -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1056#1040#1057#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058 +
        #1040#1058#1068#1048
      '1101131762=  IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '1101131763=    SELECT K.KASSA'
      '1101131764=      FROM KASSA K'
      '1101131765=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101131766=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101131767=      INTO :KASSA_POP_;'
      '1101131768=  ELSE'
      '1101131769=    SELECT K.KASSA_BEZNAL'
      '1101131770=      FROM KASSA_BEZNAL K'
      '1101131771=     WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101131772=       AND K.G_PRIHOD_RASHOD NOT IN (2, 3)'
      '1101131773=       INTO :KASSA_POP_;'
      '1101131774='
      
        '1101131775=  -- 1) '#1055#1056#1048#1061#1054#1044' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1055#1054#1057#1054#1041' '#1056#1040#1057#1063#1045#1058#1040' '#1053#1045' '#1048#1047#1052#1045 +
        #1053#1045#1053', '#1058#1054#1043#1044#1040' '#1055#1054' '#1050#1040#1057#1057#1045'_'#1041#1045#1047#1053#1040#1051' '#1044#1054#1051#1046#1053#1067' '#1041#1067#1058#1068' '#1048#1047#1052#1045#1053#1045#1053#1048#1071
      
        '1101131776=  IF (G_PAYMENT_TYPE_OLD_ = G_PAYMENT_TYPE_) THEN BEG' +
        'IN'
      '1101131777=      PNT_ = '#39'012'#39';'
      '1101131778=      IF (KASSA_POP_ IS NOT NULL) then BEGIN'
      
        '1101131779=            EXECUTE PROCEDURE K_UPD_KASSA(:KASSA_POP_' +
        ','
      
        '1101131780=                                          1,     -- A' +
        'CTION_'
      '1101131781=                                          :G_PRIHOD_,'
      
        '1101131782=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101131783=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101131784=                                          NULL,   --N' +
        'OTE_'
      '1101131785=                                          NULL,'
      
        '1101131786=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101131787=                                          :G_PAYMENT_' +
        'TYPE_) RETURNING_VALUES :ERR_CODE, :ERR_MSG;'
      '1101131788=      -- '#1057#1054#1047#1044#1040#1070' '#1053#1054#1042#1059#1070' '#1045#1057#1051#1048' '#1045#1045' '#1053#1045#1058
      '1101131789=      END ELSE IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101131790=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_'
      '1101131791=                                          :G_PRIHOD_,'
      
        '1101131792=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101131793=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101131794=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      '1101131795=                                          NULL,'
      
        '1101131796=                                          :SKLAD_PARE' +
        'NT_,'
      
        '1101131797=                                          :G_PAYMENT_' +
        'TYPE_,'
      
        '1101131798=                                          :G_TOCHKA_)' +
        ' RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1101131799=      END'
      '1101131800=      IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101131801=        ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||E' +
        'RR_MSG;'
      '1101131802=        EXIT;'
      '1101131803=      END'
      '1101131804='
      
        '1101131805=  -- 3) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1041#1045#1047#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1053#1040#1051
      
        '1101131806=  -- 4) '#1047#1040#1050#1040#1047' '#1041#1067#1051' '#1055#1054' '#1053#1040#1051#1059', '#1057#1058#1040#1051' '#1055#1054' '#1041#1045#1047#1053#1040#1051#1059', '#1053#1040#1044#1054' '#1059#1044#1040#1051 +
        #1048#1058#1068' '#1048#1047' '#1050#1040#1057#1057#1067'_'#1053#1040#1051' '#1048' '#1042#1053#1045#1057#1058#1048' '#1042' '#1050#1040#1057#1057#1059'_'#1041#1045#1047#1053#1040#1051
      
        '1101131807=  END ELSE IF (G_PAYMENT_TYPE_OLD_ <> G_PAYMENT_TYPE_' +
        ') THEN BEGIN'
      '1101131808=        PNT_ = '#39'013'#39';'
      
        '1101131809=        EXECUTE PROCEDURE K_DEL_KASSA(:KASSA_POP_, :G' +
        '_PAYMENT_TYPE_OLD_) RETURNING_VALUES (:ERR_CODE, :ERR_MSG);'
      '1101131810=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1101131811=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1101131812=          EXIT;'
      '1101131813=        END'
      '1101131814=        IF (SUMM_PRIHOD_ > 0) THEN BEGIN'
      
        '1101131815=            EXECUTE PROCEDURE K_INS_KASSA(1,     -- A' +
        'CTION_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      '1101131816=                                          :G_PRIHOD_,'
      
        '1101131817=                                          :SUMM_PRIHO' +
        'D_,'
      
        '1101131818=                                          :DATE_RECEI' +
        'PT_,'
      
        '1101131819=                                          NULL,   --N' +
        'OTE_ => :NOTE_,'
      
        '1101131820=                                          NULL,   --Z' +
