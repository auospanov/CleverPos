        ', '#39#1085#1077' '#1091#1082#1072#1079#1072#1085#39') FROM 1 FOR 300), 4, '#39#1042#1086#1079#1074#1088#1072#1090' '#1090#1086#1074#1072#1088#1072' '#1087#1086#1089#1090#1072#1074#1097#1080#1082#1091' '#39'|' +
