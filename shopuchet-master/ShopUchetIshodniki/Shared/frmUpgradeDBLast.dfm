      '110202296=                 '#39' from RDB$DATABASE) cd '#39'||'
      '110202297=                 '#39'ON (c.K_DATE = cd.K_DATE) '#39'||'
      '110202298=                 '#39'WHEN NOT MATCHED THEN '#39'||'
      
