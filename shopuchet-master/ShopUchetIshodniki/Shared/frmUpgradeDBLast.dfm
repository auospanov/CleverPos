      '1101627727=                 ,:NDS_SUMM_'
      '1101627728=                 ,:DISCOUNT_TENGE_'
      '1101627729=      DO BEGIN'
      
        '1101627730=        INSERT INTO SKLAD(SKLAD, G_PRODUCT, DATE_RECE' +
