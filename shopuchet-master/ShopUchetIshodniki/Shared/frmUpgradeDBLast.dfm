      '1101241170=            END'
      '1101241171='
      
        '1101241172=            KASSA_STR_  = KASSA_STR_ ||KASSA_||'#39'~'#39';  ' +
        ' -- '#1055#1056#1048' '#1048#1053#1057#1045#1056#1058#1045' '#1047#1044#1045#1057#1068' '#1041#1059#1044#1045#1058' KASSA_ '#1057' '#1053#1054#1042#1067#1052' ID'
      '1101241173=      END'
      '1101241174='
      
        '1101241175=      -- '#1055#1054#1057#1051#1045' '#1062#1048#1050#1051#1040' '#1055#1054' '#1055#1051#1040#1058#1045#1046#1040#1052' - '#1055#1056#1054#1042#1045#1056#1071#1070' '#1041#1067#1051#1048' '#1051#1048' '#1059 +
        #1044#1040#1051#1045#1053#1067' '#1050#1040#1050#1048#1045'-'#1058#1054' '#1055#1051#1040#1058#1045#1046#1048
      '1101241176=      FOR SELECT KASSA, 1 PAYMENT_TYPE'
      '1101241177=            FROM KASSA K'
      '1101241178=           WHERE K.SKLAD = :SKLAD_PARENT_'
      
        '1101241179=             AND NOT :KASSA_STR_ CONTAINING '#39'~'#39'||K.KA' +
        'SSA||'#39'~'#39
      '1101241180=           UNION'
      '1101241181=          SELECT KASSA, 1 PAYMENT_TYPE'
      '1101241182=            FROM KASSA K'
      '1101241183=           WHERE K.SKLAD = :SKLAD_PARENT_'
      '1101241184=             AND K.SUMM = 0'
      '1101241185=          UNION'
      '1101241186=          SELECT KASSA_BEZNAL KASSA, 2 PAYMENT_TYPE'
      '1101241187=            FROM KASSA_BEZNAL K'
