      '1102281608=        :REC_AMOUNT_OUT_,'
      '1102281609=        :REC_LAST_SUPPLIER_,'
      '1102281610=        0);'
      '1102281611='
      
        '1102281612=      AMOUNT_PRIHOD_  = AMOUNT_PRIHOD_ + REC_AMOUNT_P' +
        'RIHOD_;'
      
        '1102281613=      SUMM_PRIHOD_    = SUMM_PRIHOD_   + REC_SUMM_PRI' +
        'HOD_;'
      
        '1102281614=      AMOUNT_UHOD_    = AMOUNT_UHOD_   + REC_AMOUNT_U' +
        'HOD_;'
      
        '1102281615=      SUMM_UHOD_      = SUMM_UHOD_     + REC_SUMM_UHO' +
        'D_;'
      
        '1102281616=      AMOUNT_SPISANO_ = AMOUNT_SPISANO_  + REC_AMOUNT' +
        '_SPISANO_;'
      
        '1102281617=      SUMM_SPISANO_   = SUMM_SPISANO_    + REC_SUMM_S' +
        'PISANO_;'
      
        '1102281618=      AMOUNT_VOZVRAT_ = AMOUNT_VOZVRAT_  + REC_AMOUNT' +
        '_VOZVRAT_;'
      
        '1102281619=      SUMM_VOZVRAT_      = SUMM_VOZVRAT_    + REC_SUM' +
        'M_VOZVRAT_;'
      
        '1102281620=      AMOUNT_PRIHOD_SKL_ = AMOUNT_PRIHOD_SKL_ + REC_A' +
        'MOUNT_PRIHOD_SKL_;'
      
        '1102281621=      SUMM_PRIHOD_SKL_   = SUMM_PRIHOD_SKL_ + REC_SUM' +
        'M_PRIHOD_SKL_;'
      
        '1102281622=      AMOUNT_UHOD_SKL_   = AMOUNT_UHOD_SKL_ + REC_AMO' +
        'UNT_UHOD_SKL_;'
      
        '1102281623=      SUMM_UHOD_SKL_     = SUMM_UHOD_SKL_ + REC_SUMM_' +
        'UHOD_SKL_;'
      '1102281624='
