      '1102011934=                                :SKLAD_PARENT_,'
      '1102011935=                                1,'
      '1102011936=                                :G_TOCHKA_,'
      
        '1102011937=                                :UPLOAD_TO_EXT_APP_) ' +
        'RETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '1102011938=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '1102011939=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'|' +
        '|ERR_MSG;'
      '1102011940=          EXIT;'
      '1102011941=        END'
      '1102011942='
      '1102011943=        DELETE FROM SKLAD_TMP;'
      '1102011944='
      '1102011945=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '1102011946=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '1102011947=          INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJ' +
        'ECT_TYPE, ID, OPER)'
      
        '1102011948=          VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SK' +
        'LAD_, 1);'
      '1102011949=      END'
      '1102011950=    END'
      '1102011951='
      
        '1102011952=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055 +
        #1054#1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '1102011953=    if (ERR_MSG_ IS NOT NULL) then'
      '1102011954=      ERR_MSG = ERR_MSG_;'
      '1102011955='
      '1102011956=WHEN ANY DO BEGIN'
      '1102011957=    IF (GDSCODE = 335544652) THEN BEGIN'
      '1102011958=        Err_code = GDSCODE;'
      
        '1102011959=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1042#1099' '#1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1080 +
        #1084#1087#1086#1088#1090#1080#1088#1086#1074#1072#1090#1100' '#1090#1086#1074#1072#1088#1099' '#1089' '#1086#1076#1080#1085#1072#1082#1086#1074#1099#1084' '#1079#1085#1072#1095#1077#1085#1080#1077#1084'!'#39';'
      '1102011960=        IF (PNT_ = '#39'02'#39') THEN'
      
        '1102011961=            ERR_MSG = ERR_MSG || '#39' '#1040#1088#1090#1080#1082#1091#1083' '#39' || ARTIC' +
        'UL_ || '#39'.'#39';'
      '1102011962=        ELSE'
      
