      '1101321400=              :DISCOUNT_SUMM,'
      '1101321401=              :NDS,'
      '1101321402=              :NDS_SUMM'
      '1101321403=      DO BEGIN'
      '1101321404=          -- '#1052#1045#1053#1071#1070' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1058#1054#1042#1040#1056#1040' '#1053#1040' '#1057#1050#1051#1040#1044#1045
      '1101321405=          UPDATE LT_SKLAD_PRODUCT L'
