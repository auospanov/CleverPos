        'UNT, '#39#39')||'#39' '#1074' '#1073#1072#1085#1082#1077' '#39'||GB.BANK_NAME||'#39' '#1041#1048#1050' '#39'||GB.BIK||'#39' '#1082'/'#1089' '#39'),'
      '11018389=                       '#39#39'),'
