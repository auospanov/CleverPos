        'ENT.SKLAD;'
      
        '11024246=DECLARE VARIABLE SUMM_ TYPE OF COLUMN SKLAD_PARENT.SUMM' +
        ';'
      
        '11024247=DECLARE VARIABLE SUMM_UE_ TYPE OF COLUMN SKLAD_PARENT.S' +
        'UMM_CURRENCY;'
      '11024248=DECLARE VARIABLE SKLAD_ TYPE OF COLUMN SKLAD.SKLAD;'
      '11024249=DECLARE VARIABLE KASSA_ TYPE OF COLUMN KASSA.KASSA;'
      
        '11024250=DECLARE VARIABLE SKLAD_TMP_ TYPE OF COLUMN SKLAD.SKLAD ' +
        '= 0;'
      
        '11024251=DECLARE VARIABLE RG_PRODUCT_ TYPE OF COLUMN SKLAD.G_PRO' +
        'DUCT;'
      
        '11024252=DECLARE VARIABLE RAMOUNT_ TYPE OF COLUMN SKLAD.AMOUNT =' +
        ' 0;'
      '11024253=DECLARE VARIABLE RPRICE_ NUMERIC(15,2) = 0;'
      '11024254=DECLARE VARIABLE RPRICE_UE_ NUMERIC(15,2) = 0;'
      '11024255=DECLARE VARIABLE RSUMM_ NUMERIC(15,2) = 0;'
      '11024256=DECLARE VARIABLE RSUMM_UE_ NUMERIC(15,2) = 0;'
      '11024257=DECLARE VARIABLE ERR_MSG_ VARCHAR(1024) = NULL;'
      
        '11024258=DECLARE VARIABLE G_TOCHKA_ TYPE OF COLUMN G_TOCHKA.G_TO' +
        'CHKA;'
      '11024259=DECLARE VARIABLE POS_TILDA_ INTEGER;'
      '11024260=DECLARE VARIABLE STR_ TYPE OF COLUMN G_PRODUCT.NAME;'
      
        '11024261=DECLARE VARIABLE LT_BARCODE_ TYPE OF COLUMN LT_BARCODE.' +
        'BARCODE;'
      '11024262=DECLARE VARIABLE DOP_BARCODE_LOCAL_ VARCHAR(1000);'
      '11024263=BEGIN'
      '11024264=    ERR_MSG = '#39#39';'
      '11024265=    PNT_ = '#39'00'#39';'
      '11024266='
      
        '11024267=    --'#1050#1054#1053#1042#1045#1056#1058#1048#1056#1059#1070' CROSCCODE '#1042' '#1053#1059#1046#1053#1067#1049' '#1052#1053#1045' '#1042#1048#1044', '#1052#1053#1045' '#1041#1059#1044#1045#1058 +
        ' '#1055#1056#1048#1061#1054#1044#1048#1058#1068' "000457, 7775843, SS88988, 98888"'
      
        '11024268=    --'#1052#1053#1045' '#1053#1059#1046#1053#1054' '#1055#1056#1048#1042#1045#1057#1058#1048' '#1050' '#1042#1048#1044#1059' "000457~7775843~SS88988' +
        '~98888~"'
      
        '11024269=    --'#1042#1055#1054#1051#1053#1045' '#1042#1054#1047#1052#1054#1046#1053#1054', '#1063#1058#1054' '#1042' '#1050#1054#1053#1062#1045' '#1041#1059#1044#1045#1058' '#1047#1040#1055#1071#1058#1040#1071', '#1054#1058' '#1053#1045 +
        #1045' '#1053#1059#1046#1053#1054' '#1048#1047#1041#1040#1042#1048#1058#1068#1057#1071
      '11024270=    IF (CHAR_LENGTH(TRIM(CROSSCODE_)) > 0) THEN BEGIN'
      
        '11024271=        CROSSCODE_ = REPLACE(TRIM(CROSSCODE_), '#39','#39', '#39'~'#39 +
        ');'
      '11024272=        CROSSCODE_ = REPLACE(CROSSCODE_, '#39' '#39', '#39#39');'
      '11024273=        IF (RIGHT(CROSSCODE_, 1) <> '#39'~'#39') THEN'
      '11024274=          CROSSCODE_ = CROSSCODE_||'#39'~'#39';'
      '11024275=    END ELSE'
      '11024276=        CROSSCODE_ = NULL;'
      '11024277='
      
        '11024278=    ---------------------------------------------------' +
        '---------------'
      
        '11024279=    -- '#1055#1056#1045#1044#1042#1040#1056#1048#1058#1045#1051#1068#1053#1054' '#1057#1054#1047#1044#1040#1052' '#1043#1056#1059#1055#1055#1059' '#1058#1054#1042#1040#1056#1054#1042', '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049 +
        ' '#1053#1045#1058
      
        '11024280=    -- '#1043#1056#1059#1055#1055#1040' '#1058#1054#1042#1040#1056#1054#1042' '#1052#1054#1046#1045#1058' '#1057#1054#1044#1045#1056#1046#1040#1058#1068' '#1058#1040#1050' "'#1048#1075#1088#1091#1096#1082#1080'~'#1052#1103#1075#1082 +
        #1080#1077' '#1048#1075#1088#1091#1096#1082#1080'~'#1052#1077#1076#1074#1077#1076#1080'", '#1041#1059#1044#1059' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057' '#1057#1051#1045#1042#1040'-'#1053#1040#1055#1056#1040#1042#1054
      '11024281=    -- '#1045#1057#1051#1048' '#1053#1045#1058' "'#1048#1043#1056#1059#1064#1050#1048'", '#1058#1054' '#1057#1054#1047#1044#1040#1070', '#1048' '#1044#1040#1051#1045#1045
      
        '11024282=    -- '#1055#1054' '#1059#1052#1059' '#1053#1040#1044#1054' '#1041#1067' '#1056#1040#1057#1050#1056#1059#1063#1048#1042#1040#1058#1068' '#1057#1055#1056#1040#1042#1040'-'#1053#1040#1051#1045#1042#1054', '#1053#1054' '#1058#1040 +
        #1052' '#1052#1053#1054#1043#1054' '#1053#1070#1040#1053#1057#1054#1042' '#1048' '#1055#1054#1044#1042#1054#1044#1053#1067#1061' '#1050#1040#1052#1053#1045#1049
      '11024283=    IF (DO_SEARCH_CATEGORY_ = 1) THEN BEGIN'
      
        '11024284=        WHILE (CHAR_LENGTH(CATEGORY_NAME_) > 0) DO BEGI' +
        'N'
      '11024285=            G_PRODUCT_PAR_ = NULL;'
      
        '11024286=            POS_TILDA_ = POSITION('#39'~'#39' IN CATEGORY_NAME_' +
        ');'
      '11024287=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '11024288=              STR_ = CATEGORY_NAME_;'
      '11024289=              CATEGORY_NAME_ = '#39#39';'
      '11024290=            END ELSE'
      
        '11024291=              STR_ = SUBSTRING(CATEGORY_NAME_ FROM 1 FO' +
        'R POS_TILDA_ - 1);'
      '11024292='
      '11024293=            SELECT G_PRODUCT'
      '11024294=              FROM G_PRODUCT G'
      '11024295=             WHERE G.NAME = :STR_'
      '11024296=               AND G.IS_CATEGORY = 1'
      
        '11024297=               AND ((G.G_PRODUCT_PAR = :G_PRODUCT_PAR_P' +
        'REV_ AND :G_PRODUCT_PAR_PREV_ IS NOT NULL)'
      '11024298=                   OR'
      
        '11024299=                   (G.G_PRODUCT_PAR IS NULL AND :G_PROD' +
        'UCT_PAR_PREV_ IS NULL))'
      '110242100=              INTO G_PRODUCT_PAR_;'
      '110242101=            IF (G_PRODUCT_PAR_ IS NULL) THEN'
      
        '110242102=                INSERT INTO G_PRODUCT (G_PRODUCT, G_PR' +
        'ODUCT_PAR, NAME, IS_CATEGORY, IS_KIT)'
      
        '110242103=                VALUES (GEN_ID(GEN_G_PRODUCT, 1), :G_P' +
        'RODUCT_PAR_PREV_, :STR_, 1, 0)'
      '110242104=                RETURNING G_PRODUCT'
      '110242105=                INTO :G_PRODUCT_PAR_;'
      '110242106='
      '110242107=            G_PRODUCT_PAR_PREV_ = G_PRODUCT_PAR_;'
      
        '110242108=            CATEGORY_NAME_      = SUBSTRING(CATEGORY_N' +
        'AME_ FROM (POSITION('#39'~'#39' IN CATEGORY_NAME_)) + 1);'
      '110242109=        END'
      '110242110=    END'
      
        '110242111=    --------------------------------------------------' +
        '----------------'
      '110242112='
      '110242113=    PNT_ = '#39'01'#39';'
      '110242114=    SELECT ID'
      '110242115=      FROM CUR_PARAMS'
      '110242116=    WHERE CUR_PARAMS = 2'
      '110242117=      INTO :G_TOCHKA_;'
      '110242118='
      '110242119=    IF (CHAR_LENGTH(TRIM(:NAME_G_UNIT_)) > 0) THEN'
      '110242120=        SELECT G.G_UNIT'
      '110242121=          FROM G_UNIT G'
      
        '110242122=        WHERE TRIM(UPPER(G.SHORT_NAME)) = TRIM(UPPER(:' +
        'NAME_G_UNIT_))'
      '110242123=          INTO :G_UNIT_;'
      
        '110242124=    if (ROW_COUNT = 0 OR CHAR_LENGTH(TRIM(:NAME_G_UNIT' +
        '_)) = 0 ) then'
      '110242125=      G_UNIT_ = 1;  -- '#1055#1054#1057#1058#1040#1042#1051#1070' '#1064#1058#1059#1050#1059' '#1040#1042#1058#1054#1052#1040#1058#1054#1052
      '110242126='
      
        '110242127=    -- '#1057#1044#1045#1051#1040#1051' '#1055#1054#1048#1057#1050' '#1055#1054' '#1044#1054#1055' '#1064#1058#1056#1048#1061#1050#1054#1044#1059' '#1058#1059#1058' '#1055#1054#1058#1054#1052#1059' '#1063#1058#1054' '#1069#1058 +
        #1054' '#1053#1040#1044#1054' '#1041#1059#1044#1045#1058' '#1048#1057#1055#1054#1051#1068#1047#1054#1042#1040#1058#1068' '#1055#1054#1058#1054#1052' '#1048' '#1055#1056#1048' '#1055#1054#1048#1057#1050#1045' '#1040#1056#1058#1048#1050#1059#1051#1040' '#1048' '#1055#1056#1048' '#1055#1054#1048#1057 +
        #1050#1045' '#1064#1058#1056#1048#1061#1050#1054#1044#1040
      
        '110242128=    -- '#1042#1057#1058#1040#1042#1050#1040' '#1044#1054#1055' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1042', '#1056#1040#1047#1059#1052#1045#1045#1058#1057#1071' '#1041#1059#1044#1045#1058' '#1056#1040#1041#1054#1058#1040 +
        #1058#1068' '#1052#1045#1044#1051#1045#1053#1053#1045#1045', '#1058'.'#1050'. '#1041#1059#1044#1045#1058' '#1055#1054#1048#1057#1050' '#1050#1040#1046#1044#1054#1043#1054' '#1064#1058#1056#1048#1061#1050#1054#1044#1040' '#1055#1054' '#1054#1057#1053#1054#1042#1053#1054#1049' '#1058#1040#1041 +
        #1051#1045' '#1048' '#1055#1054' '#1044#1054#1055#1040#1052
      
        '110242129=    -- '#1053#1040#1049#1044#1045#1053#1053#1067#1049' '#1058#1054#1042#1040#1056' '#1042#1057#1058#1040#1042#1051#1071#1070' '#1042' G_PRODUCT_DOP_ '#1048' G_P' +
        'RODUCT_NAME_DOP_'
      '110242130=    PNT_ = '#39'01.1'#39';'
      
        '110242131=    IF (CHAR_LENGTH(TRIM(:DOP_BARCODE_)) > 0) THEN BEG' +
        'IN'
      '110242132=        DOP_BARCODE_LOCAL_ = DOP_BARCODE_;'
      
        '110242133=        WHILE (CHAR_LENGTH(DOP_BARCODE_LOCAL_) > 0) DO' +
        ' BEGIN'
      
        '110242134=            POS_TILDA_ = POSITION('#39','#39' IN DOP_BARCODE_L' +
        'OCAL_);'
      '110242135=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110242136=              LT_BARCODE_ = DOP_BARCODE_LOCAL_;'
      '110242137=              DOP_BARCODE_LOCAL_ = '#39#39';'
      '110242138=            END ELSE'
      
        '110242139=              LT_BARCODE_ = SUBSTRING(DOP_BARCODE_LOCA' +
        'L_ FROM 1 FOR POS_TILDA_ - 1);'
      '110242140='
      '110242141=            SELECT G.G_PRODUCT,'
      '110242142=                   G.NAME'
      '110242143=              FROM G_PRODUCT G'
      '110242144=             WHERE G.BARCODE = TRIM(:LT_BARCODE_)'
      '110242145=               AND TRIM(G.BARCODE) <> '#39#39
      '110242146=               AND G.IS_ACTIVE = 1'
      '110242147=              INTO :G_PRODUCT_DOP_,'
      '110242148=                   :G_PRODUCT_NAME_DOP_;'
      '110242149='
      '110242150=            IF (COALESCE(G_PRODUCT_DOP_, 0) = 0) THEN'
      '110242151=              SELECT G.G_PRODUCT,'
      '110242152=                     G.NAME'
      '110242153=                FROM G_PRODUCT G, LT_BARCODE L'
      '110242154=               WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110242155=                 AND L.BARCODE = TRIM(:LT_BARCODE_)'
      '110242156=                 AND TRIM(L.BARCODE) <> '#39#39
      '110242157=                 AND G.IS_ACTIVE = 1'
      '110242158=                INTO :G_PRODUCT_DOP_,'
      '110242159=                     :G_PRODUCT_NAME_DOP_;'
      '110242160='
      '110242161=            IF (G_PRODUCT_DOP_ <> 0) THEN'
      '110242162=              BREAK;'
      '110242163='
      
        '110242164=            DOP_BARCODE_LOCAL_ = SUBSTRING(DOP_BARCODE' +
        '_LOCAL_ FROM (POS_TILDA_ + 1));'
      '110242165=        END'
      '110242166=    END'
      '110242167='
      '110242168=    PNT_ = '#39'02'#39';'
      
        '110242169=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1040#1056#1058#1048#1050#1059#1051#1054#1052' '#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059 +
        #1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052
      '110242170=    IF (CHAR_LENGTH(TRIM(:ARTICUL_)) > 0) THEN BEGIN'
      '110242171=        SELECT G.G_PRODUCT,'
      '110242172=               G.NAME'
      '110242173=          FROM G_PRODUCT G'
      
        '110242174=         WHERE UPPER(G.ARTICUL) = UPPER(TRIM(:ARTICUL_' +
        '))'
      '110242175=           AND TRIM(G.ARTICUL) <> '#39#39
      '110242176=           AND G.IS_ACTIVE = 1'
      '110242177=          INTO :G_PRODUCT_,'
      '110242178=               :G_PRODUCT_NAME_;'
      '110242179='
      '110242180=        PNT_ = '#39'02.1'#39';'
      
        '110242181=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      
        '110242182=        -- '#1045#1057#1051#1048' '#1058#1054#1042#1040#1056' '#1053#1045' '#1057#1054#1042#1055#1040#1044#1040#1045#1058' '#1057' '#1058#1045#1052', '#1063#1058#1054' '#1041#1067#1051' '#1053#1040#1049#1044 +
        #1045#1053' '#1042#1067#1064#1045' '#1055#1054' '#1044#1054#1055' '#1064#1058#1056#1048#1061#1050#1054#1044#1059' - '#1058#1054' '#1054#1064#1048#1041#1050#1040
      '110242183=        IF (COALESCE(G_PRODUCT_, 0) <> 0) THEN BEGIN'
      '110242184='
      '110242185=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      
        '110242186=              IF (BARCODE_IS_MAIN_ = 0 OR (BARCODE_IS_' +
        'MAIN_ = 1 AND TRIM(BARCODE_) = '#39#39')) THEN BEGIN -- '#1045#1057#1051#1048' '#1064#1058#1056#1048#1061#1050#1054#1044' ' +
        #1055#1059#1057#1058#1054#1049', '#1058#1054' '#1048#1044#1059' '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110242187='
      
        '110242188=                  IF (G_PRODUCT_DOP_ <> 0 AND G_PRODUC' +
        'T_ <> G_PRODUCT_DOP_) THEN BEGIN'
      '110242189=                    Err_code = -20500;'
      
        '110242190=                    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'!  '#1040#1088 +
        #1090#1080#1082#1091#1083' '#1090#1086#1074#1072#1088#1072' "'#39' || ARTICUL_ || '#39'". '#1044#1086#1087'. '#1096#1090#1088#1080#1093#1082#1086#1076' "'#39'||LT_BARCODE_' +
        '|| '#39'" '#1091#1078#1077' '#1087#1088#1080#1085#1072#1076#1083#1077#1078#1080#1090' '#1076#1088#1091#1075#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||G_PRODUCT_NAME_DOP_||'#39'"' +
        '.'#39';'
      '110242191=                    EXIT;'
      '110242192=                  END'
      '110242193='
      '110242194=                  IF (TRIM(BARCODE_) = '#39#39') THEN'
      
        '110242195=                     EXECUTE PROCEDURE get_free_BARCOD' +
        'E(13, null) RETURNING_VALUES (:BARCODE_);'
      '110242196='
      '110242197=                  UPDATE G_PRODUCT G'
      '110242198=                     SET G.NAME = :NAME_,'
      '110242199=                         G.G_UNIT = :G_UNIT_,'
      
        '110242200=                         G.PRICE  = DECODE(:PRICE_, -9' +
        '99, G.PRICE, :PRICE_),'
      
        '110242201=                         G.VOLUME_PRICE = DECODE(:VOLU' +
        'ME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110242202=                         G.PACK_AMOUNT = DECODE(:PACK_' +
        'AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110242203=                         G.BARCODE     = DECODE(CHAR_L' +
        'ENGTH(:BARCODE_), 0, G.BARCODE, :BARCODE_),'
      
        '110242204=                         G.MF_COUNTRY  = DECODE(CHAR_L' +
        'ENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110242205=                         G.PLACE = DECODE(CHAR_LENGTH(' +
        ':PLACE_), 0, G.PLACE, :PLACE_),'
      
        '110242206=                         G.nomenclatur_num = DECODE(CH' +
        'AR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR' +
        '_NUM_),'
      
        '110242207=                         G.KOD_TNVD        = DECODE(CH' +
        'AR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110242208=                         G.CROSSCODE      = COALESCE(:' +
        'CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, ' +
        'G.CROSSCODE, :CROSSCODE_),'
      
        '110242209=                         G.BRAND          = DECODE(CHA' +
        'R_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '110242210=                         G.G_PRODUCT_PAR  = COALESCE(:' +
        'G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110242211=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110242212='
      '110242213=                  -- '#1042#1057#1058#1040#1042#1050#1040' '#1044#1054#1055' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1042
      
        '110242214=                  IF (CHAR_LENGTH(TRIM(:DOP_BARCODE_))' +
        ' > 0) THEN BEGIN'
      
        '110242215=                      DOP_BARCODE_LOCAL_ = DOP_BARCODE' +
        '_;'
      
        '110242216=                      WHILE (CHAR_LENGTH(DOP_BARCODE_L' +
        'OCAL_) > 0) DO BEGIN'
      
        '110242217=                        POS_TILDA_ = POSITION('#39','#39' IN D' +
        'OP_BARCODE_LOCAL_);'
      '110242218=                        IF (POS_TILDA_ = 0) THEN BEGIN'
      
        '110242219=                          LT_BARCODE_ = DOP_BARCODE_LO' +
        'CAL_;'
      '110242220=                          DOP_BARCODE_LOCAL_ = '#39#39';'
      '110242221=                        END'
      '110242222=                        ELSE'
      
        '110242223=                          LT_BARCODE_ = SUBSTRING(DOP_' +
        'BARCODE_LOCAL_ FROM 1 FOR POS_TILDA_ - 1);'
      '110242224='
      
        '110242225=                        UPDATE OR INSERT INTO LT_BARCO' +
        'DE (LT_BARCODE, G_PRODUCT, BARCODE)'
      
        '110242226=                        VALUES (GEN_ID(GEN_LT_BARCODE,' +
        ' 1), :G_PRODUCT_, :LT_BARCODE_)'
      '110242227=                        MATCHING (G_PRODUCT, BARCODE);'
      '110242228='
      
        '110242229=                        DOP_BARCODE_LOCAL_ = SUBSTRING' +
        '(DOP_BARCODE_LOCAL_ FROM (POS_TILDA_ + 1));'
      '110242230=                      END'
      '110242231=                  END'
      '110242232='
      
        '110242233=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086 +
        #1084' '#39'||UPPER(TRIM(:ARTICUL_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110242234='
      
        '110242235=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110242236=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110242237=                      INSERT INTO SYNC_EXT_APP (SYNC_E' +
        'XT_APP, OBJECT_TYPE, ID, OPER)'
      
        '110242238=                      SELECT GEN_ID(GEN_SYNC_EXT_APP, ' +
        '1), 4, :G_PRODUCT_, 2'
      '110242239=                        FROM RDB$DATABASE'
      
        '110242240=                       WHERE NOT EXISTS (SELECT 1 FROM' +
        ' SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT' +
        '_ AND AP.IS_LOADING = 0);'
      '110242241=              END'
      '110242242=              ELSE'
      '110242243=                G_PRODUCT_ = 0;'
      '110242244=            END ELSE'
      
        '110242245=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110242246=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1072#1088#1090#1080#1082#1091#1083#1086#1084' '#39'||' +
        'UPPER(TRIM(:ARTICUL_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_NAME' +
        '_||'#39'.'#39';'
      '110242247=        END'
      '110242248=    END ELSE'
      
        '110242249=      EXECUTE PROCEDURE get_free_articul RETURNING_VAL' +
        'UES (:ARTICUL_);'
      '110242250='
      
        '110242251=    /* 17.02.2021 '#1088#1077#1096#1080#1083' '#1095#1090#1086' '#1086#1085' '#1085#1077' '#1076#1086#1083#1078#1077#1085' '#1073#1099#1090#1100' '#1091#1085#1080#1082#1072#1083#1100#1085 +
        #1099#1084
      
        '110242252=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1067#1052' '#1053#1054#1052#1045#1056#1054#1052 +
        ', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048#1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059
      '110242253=    PNT_ = '#39'02a'#39';'
      
        '110242254=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:NOMENCLATUR_NUM_)) > 0)) then begin'
      '110242255=        SELECT G.G_PRODUCT,'
      '110242256=               G.NAME'
      '110242257=          FROM G_PRODUCT G'
      
        '110242258=         WHERE G.nomenclatur_num = TRIM(:NOMENCLATUR_N' +
        'UM_)'
      '110242259=           AND TRIM(G.nomenclatur_num) <> '#39#39
      '110242260=           AND G.IS_ACTIVE = 1'
      '110242261=          INTO :G_PRODUCT_,'
      '110242262=               :G_PRODUCT_NAME_;'
      '110242263='
      
        '110242264=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110242265=        IF (COALESCE(G_PRODUCT_, 0) <> 0) then BEGIN'
      '110242266=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110242267=              UPDATE G_PRODUCT G'
      '110242268=                 SET G.NAME = :NAME_,'
      '110242269=                     G.G_UNIT = :G_UNIT_,'
      '110242270=                     G.PRICE  = :PRICE_,'
      '110242271=                     G.VOLUME_PRICE = :VOLUME_PRICE_,'
      '110242272=                     G.PACK_AMOUNT = :PACK_AMOUNT_,'
      '110242273=                     G.MF_COUNTRY  = :MF_COUNTRY_,'
      '110242274=                     G.PLACE = :PLACE_,'
      
        '110242275=                     G.articul         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.articul)), 0, :ARTICUL_,G.articul),'
      
        '110242276=                     G.nomenclatur_num = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.nomenclatur_num)), 0, :NOMENCLATUR_NUM_, G.nomencla' +
        'tur_num),'
      
        '110242277=                     G.barcode         = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.BARCODE)), 0, :BARCODE_, G.BARCODE),'
      
        '110242278=                     G.KOD_TNVD        = DECODE(CHAR_L' +
        'ENGTH(TRIM(G.KOD_TNVD)), 0, :KOD_TNVD_, G.KOD_TNVD)'
      '110242279=                     ,G.CROSSCODE      = :CROSSCODE_'
      '110242280=                     ,G.BRAND          = :BRAND_'
      '110242281=               WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110242282='
      
        '110242283=              ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086#1084 +
        #1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110242284=            END ELSE'
      
        '110242285=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110242286=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1085#1086#1084#1077#1085#1082#1083'. '#1085#1086 +
        #1084#1077#1088#1086#1084' '#39'||UPPER(TRIM(:NOMENCLATUR_NUM_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - ' +
        #39'||G_PRODUCT_NAME_||'#39'.'#39';'
      '110242287=        END'
      '110242288=    end'
      '110242289=    */'
      '110242290='
      
        '110242291=    -- '#1045#1057#1058#1068' '#1051#1048' '#1058#1054#1042#1040#1056' '#1057' '#1055#1054#1044#1054#1041#1053#1067#1052' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1052', '#1055#1056#1048' '#1059#1057#1051#1054#1042#1048 +
        #1048' '#1063#1058#1054' '#1059#1046#1045' '#1053#1045' '#1053#1040#1049#1044#1045#1053' G_PRODUCT_ '#1055#1054' '#1040#1056#1058#1048#1050#1059#1051#1059' '#1048#1051#1048' '#1053#1054#1052#1045#1053#1050#1051#1040#1058#1059#1056#1053#1054#1052#1059' '#1053 +
        #1054#1052#1045#1056#1059
      '110242292=    PNT_ = '#39'02.2'#39';'
      
        '110242293=    if ((COALESCE(G_PRODUCT_, 0) = 0) AND (CHAR_LENGTH' +
        '(TRIM(:BARCODE_)) > 0)) THEN BEGIN'
      '110242294=        SELECT G.G_PRODUCT,'
      '110242295=               G.NAME'
      '110242296=          FROM G_PRODUCT G'
      '110242297=         WHERE G.BARCODE = TRIM(:BARCODE_)'
      '110242298=           AND TRIM(G.BARCODE) <> '#39#39
      '110242299=           AND G.IS_ACTIVE = 1'
      '110242300=          INTO :G_PRODUCT_,'
      '110242301=               :G_PRODUCT_NAME_;'
      '110242302='
      '110242303=        IF (COALESCE(G_PRODUCT_, 0) = 0) then'
      '110242304=          SELECT G.G_PRODUCT,'
      '110242305=                 G.NAME'
      '110242306=            FROM G_PRODUCT G, LT_BARCODE L'
      '110242307=           WHERE G.G_PRODUCT = L.G_PRODUCT'
      '110242308=             AND L.BARCODE = TRIM(:BARCODE_)'
      '110242309=             AND TRIM(L.BARCODE) <> '#39#39
      '110242310=             AND G.IS_ACTIVE = 1'
      '110242311=            INTO :G_PRODUCT_,'
      '110242312=                 :G_PRODUCT_NAME_;'
      '110242313='
      
        '110242314=        -- '#1045#1057#1051#1048' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056' '#1045#1057#1058#1068', '#1058#1054' '#1051#1048#1041#1054' '#1054#1041#1053#1054#1042#1051#1071#1070' '#1056#1045#1050 +
        #1042#1048#1047#1048#1058#1067', '#1051#1048#1041#1054' '#1042#1067#1044#1040#1070' '#1054#1064#1048#1041#1050#1059
      '110242315=        IF (COALESCE(G_PRODUCT_, 0) <> 0) THEN BEGIN'
      '110242316=            IF (UPDATE_IF_EXIST_ = 1) THEN BEGIN'
      '110242317=              IF (BARCODE_IS_MAIN_ = 1) THEN BEGIN'
      '110242318='
      
        '110242319=                  IF (G_PRODUCT_DOP_ <> 0 AND G_PRODUC' +
        'T_ <> G_PRODUCT_DOP_) THEN BEGIN'
      '110242320=                    Err_code = -20500;'
      
        '110242321=                    ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'!  '#1064#1090 +
        #1088#1080#1093#1082#1086#1076' '#1090#1086#1074#1072#1088#1072' "'#39' || TRIM(:BARCODE_) || '#39'". '#1044#1086#1087'. '#1096#1090#1088#1080#1093#1082#1086#1076' "'#39'||LT_' +
        'BARCODE_|| '#39'" '#1091#1078#1077' '#1087#1088#1080#1085#1072#1076#1083#1077#1078#1080#1090' '#1076#1088#1091#1075#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||G_PRODUCT_NAME_' +
        'DOP_||'#39'".'#39';'
      '110242322=                    EXIT;'
      '110242323=                  END'
      '110242324='
      '110242325=                  UPDATE G_PRODUCT G'
      '110242326=                     SET G.NAME = :NAME_,'
      '110242327=                         G.G_UNIT = :G_UNIT_,'
      
        '110242328=                         G.PRICE  = DECODE(:PRICE_, -9' +
        '99, G.PRICE, :PRICE_),'
      
        '110242329=                         G.VOLUME_PRICE = DECODE(:VOLU' +
        'ME_PRICE_, -999, G.VOLUME_PRICE, :VOLUME_PRICE_),'
      
        '110242330=                         G.PACK_AMOUNT = DECODE(:PACK_' +
        'AMOUNT_, -999, G.PACK_AMOUNT, :PACK_AMOUNT_),'
      
        '110242331=                         G.articul         = DECODE(CH' +
        'AR_LENGTH(:ARTICUL_), 0, G.articul, :ARTICUL_),'
      
        '110242332=                         G.MF_COUNTRY  = DECODE(CHAR_L' +
        'ENGTH(:MF_COUNTRY_), 0, G.MF_COUNTRY, :MF_COUNTRY_),'
      
        '110242333=                         G.PLACE = DECODE(CHAR_LENGTH(' +
        ':PLACE_), 0, G.PLACE, :PLACE_),'
      
        '110242334=                         G.nomenclatur_num = DECODE(CH' +
        'AR_LENGTH(:NOMENCLATUR_NUM_), 0, G.nomenclatur_num, :NOMENCLATUR' +
        '_NUM_),'
      
        '110242335=                         G.KOD_TNVD        = DECODE(CH' +
        'AR_LENGTH(:KOD_TNVD_), 0, G.KOD_TNVD, :KOD_TNVD_),'
      
        '110242336=                         G.CROSSCODE      = COALESCE(:' +
        'CROSSCODE_, G.CROSSCODE), --DECODE(CHAR_LENGTH(:CROSSCODE_), 0, ' +
        'G.CROSSCODE, :CROSSCODE_),'
      
        '110242337=                         G.BRAND          = DECODE(CHA' +
        'R_LENGTH(:BRAND_), 0, G.BRAND, :BRAND_),'
      
        '110242338=                         G.G_PRODUCT_PAR  = COALESCE(:' +
        'G_PRODUCT_PAR_, G.G_PRODUCT_PAR)'
      '110242339=                   WHERE G.G_PRODUCT = :G_PRODUCT_;'
      '110242340='
      '110242341=                  -- '#1042#1057#1058#1040#1042#1050#1040' '#1044#1054#1055' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1042
      
        '110242342=                  IF (CHAR_LENGTH(TRIM(:DOP_BARCODE_))' +
        ' > 0) THEN BEGIN'
      
        '110242343=                      DOP_BARCODE_LOCAL_ = DOP_BARCODE' +
        '_;'
      
        '110242344=                      WHILE (CHAR_LENGTH(DOP_BARCODE_L' +
        'OCAL_) > 0) DO BEGIN'
      
        '110242345=                        POS_TILDA_ = POSITION('#39','#39' IN D' +
        'OP_BARCODE_LOCAL_);'
      '110242346=                        IF (POS_TILDA_ = 0) THEN BEGIN'
      
        '110242347=                          LT_BARCODE_ = DOP_BARCODE_LO' +
        'CAL_;'
      '110242348=                          DOP_BARCODE_LOCAL_ = '#39#39';'
      '110242349=                        END'
      '110242350=                        ELSE'
      
        '110242351=                          LT_BARCODE_ = SUBSTRING(DOP_' +
        'BARCODE_LOCAL_ FROM 1 FOR POS_TILDA_ - 1);'
      '110242352='
      
        '110242353=                        UPDATE OR INSERT INTO LT_BARCO' +
        'DE (LT_BARCODE, G_PRODUCT, BARCODE)'
      
        '110242354=                        VALUES (GEN_ID(GEN_LT_BARCODE,' +
        ' 1), :G_PRODUCT_, :LT_BARCODE_)'
      '110242355=                        MATCHING (G_PRODUCT, BARCODE);'
      '110242356='
      
        '110242357=                        DOP_BARCODE_LOCAL_ = SUBSTRING' +
        '(DOP_BARCODE_LOCAL_ FROM (POS_TILDA_ + 1));'
      '110242358=                      END'
      '110242359=                  END'
      '110242360='
      
        '110242361=                  ERR_MSG_ = '#39#1058#1086#1074#1072#1088#1091' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076 +
        #1086#1084' '#39'||UPPER(TRIM(:BARCODE_))||'#39' '#1086#1073#1085#1086#1074#1083#1077#1085#1099' '#1088#1077#1082#1074#1080#1079#1080#1090#1099'.'#39';'
      '110242362='
      
        '110242363=                  -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059',' +
        ' '#1044#1054#1041#1040#1042#1051#1071#1045#1058#1057#1071' '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1058#1040#1052' '#1053#1045#1058' '#1047#1040#1055#1048#1057#1045#1049' '#1055#1054' '#1069#1058#1054#1049' ID, '#1047#1040#1063#1045#1052' '#1044#1059#1041#1051#1048
      '110242364=                  IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110242365=                      INSERT INTO SYNC_EXT_APP (SYNC_E' +
        'XT_APP, OBJECT_TYPE, ID, OPER)'
      
        '110242366=                      SELECT GEN_ID(GEN_SYNC_EXT_APP, ' +
        '1), 4, :G_PRODUCT_, 2'
      '110242367=                        FROM RDB$DATABASE'
      
        '110242368=                       WHERE NOT EXISTS (SELECT 1 FROM' +
        ' SYNC_EXT_APP AP WHERE AP.OBJECT_TYPE = 4 AND AP.ID = :G_PRODUCT' +
        '_ AND AP.IS_LOADING = 0);'
      '110242369=              END'
      '110242370=            END ELSE'
      
        '110242371=              if ((G_PRODUCT_ <> 0) AND ((COALESCE(G_C' +
        'LIENT_, 0) = 0) or (COALESCE(:SELF_PRICE_, 0) = 0))) then    -- ' +
        #1042#1067#1042#1054#1046#1059' '#1044#1040#1053#1053#1054#1045' '#1057#1054#1054#1041#1065#1045#1053#1048#1045', '#1058#1054#1051#1068#1050#1054' '#1045#1057#1051#1048' '#1053#1045#1058' '#1055#1056#1048#1061#1054#1044#1040' '#1055#1054' '#1058#1054#1042#1040#1056#1059
      
        '110242372=                ERR_MSG_ = '#39#1058#1086#1074#1072#1088' '#1089' '#1076#1072#1085#1085#1099#1084' '#1096#1090#1088#1080#1093#1082#1086#1076#1086#1084' ' +
        #39'||UPPER(TRIM(:BARCODE_))||'#39' '#1091#1078#1077' '#1080#1084#1077#1077#1090#1089#1103' '#1074' '#1073#1072#1079#1077' - '#39'||G_PRODUCT_N' +
        'AME_||'#39'.'#39';'
      '110242373=        END'
      
        '110242374=    END ELSE IF (CHAR_LENGTH(TRIM(:BARCODE_)) = 0) THE' +
        'N'
      
        '110242375=      EXECUTE PROCEDURE get_free_BARCODE(13, null) RET' +
        'URNING_VALUES (:BARCODE_);'
      '110242376='
      
        '110242377=    --================================================' +
        '========='
      '110242378=    -- '#1053#1045#1055#1054#1057#1056#1045#1044#1057#1058#1042#1045#1053#1053#1054' '#1042#1057#1058#1040#1042#1050#1040' '#1058#1054#1042#1040#1056#1040' '#1042' '#1058#1040#1041#1051#1048#1062#1059
      
        '110242379=    --================================================' +
        '========='
      '110242380=    PNT_ = '#39'02b'#39';'
      '110242381=    IF (COALESCE(G_PRODUCT_, 0) = 0) THEN BEGIN'
      '110242382='
      '110242383=        IF (G_PRODUCT_DOP_ <> 0) THEN BEGIN'
      '110242384=          Err_code = -20500;'
      
        '110242385=          ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'!  '#1058#1086#1074#1072#1088' "'#39' || ' +
        'NAME_ || '#39'". '#1044#1086#1087'. '#1096#1090#1088#1080#1093#1082#1086#1076' "'#39'||LT_BARCODE_|| '#39'" '#1091#1078#1077' '#1087#1088#1080#1085#1072#1076#1083#1077#1078#1080#1090' ' +
        #1076#1088#1091#1075#1086#1084#1091' '#1090#1086#1074#1072#1088#1091' "'#39'||G_PRODUCT_NAME_DOP_||'#39'".'#39';'
      '110242386=          EXIT;'
      '110242387=        END'
      '110242388='
      '110242389=        IF (PRICE_ = -999) THEN'
      '110242390=          PRICE_ = 0;'
      '110242391=        IF (VOLUME_PRICE_ = -999) THEN'
      '110242392=          VOLUME_PRICE_ = 0;'
      '110242393=        IF (PACK_AMOUNT_ = -999) THEN'
      '110242394=          PACK_AMOUNT_ = 0;'
      '110242395='
      
        '110242396=        INSERT INTO G_PRODUCT (G_PRODUCT, G_PRODUCT_PA' +
        'R, ARTICUL, NOMENCLATUR_NUM, BARCODE, NAME, G_UNIT, PRICE, VOLUM' +
        'E_PRICE,'
      
        '110242397=                               IS_CATEGORY, PACK_AMOUN' +
        'T, MF_COUNTRY, NOTE, PLACE, KOD_TNVD, CROSSCODE, BRAND)'
      
        '110242398=        VALUES (GEN_ID(GEN_G_PRODUCT, 1), COALESCE(:G_' +
        'PRODUCT_PAR_, -1), :ARTICUL_, :NOMENCLATUR_NUM_, :BARCODE_, :NAM' +
        'E_, :G_UNIT_, :PRICE_,'
      
        '110242399=                :VOLUME_PRICE_, 0, :PACK_AMOUNT_, :MF_' +
        'COUNTRY_, :NOTE_, :PLACE_, :KOD_TNVD_, :CROSSCODE_, :BRAND_)'
      '110242400=        RETURNING G_PRODUCT'
      '110242401=        INTO :G_PRODUCT_;'
      '110242402='
      
        '110242403=        INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_PRODUCT' +
        ', G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXPORT)'
      
        '110242404=        VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1) , :G_P' +
        'RODUCT_, 0, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110242405='
      '110242406=        -- '#1042#1057#1058#1040#1042#1050#1040' '#1044#1054#1055' '#1064#1058#1056#1048#1061#1050#1054#1044#1054#1042
      
        '110242407=        IF (CHAR_LENGTH(TRIM(:DOP_BARCODE_)) > 0) THEN' +
        ' BEGIN'
      '110242408=          DOP_BARCODE_LOCAL_ = DOP_BARCODE_;'
      
        '110242409=          WHILE (CHAR_LENGTH(DOP_BARCODE_LOCAL_) > 0) ' +
        'DO BEGIN'
      
        '110242410=            POS_TILDA_ = POSITION('#39','#39' IN DOP_BARCODE_L' +
        'OCAL_);'
      '110242411=            IF (POS_TILDA_ = 0) THEN BEGIN'
      '110242412=              LT_BARCODE_ = DOP_BARCODE_LOCAL_;'
      '110242413=              DOP_BARCODE_LOCAL_ = '#39#39';'
      '110242414=            END'
      '110242415=            ELSE'
      
        '110242416=              LT_BARCODE_ = SUBSTRING(DOP_BARCODE_LOCA' +
        'L_ FROM 1 FOR POS_TILDA_ - 1);'
      '110242417='
      
        '110242418=            INSERT INTO LT_BARCODE (LT_BARCODE, G_PROD' +
        'UCT, BARCODE)'
      
        '110242419=            VALUES (GEN_ID(GEN_LT_BARCODE, 1), :G_PROD' +
        'UCT_, :LT_BARCODE_);'
      '110242420='
      
        '110242421=            DOP_BARCODE_LOCAL_ = SUBSTRING(DOP_BARCODE' +
        '_LOCAL_ FROM (POS_TILDA_ + 1));'
      '110242422=          END'
      '110242423=        END'
      '110242424='
      '110242425=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110242426=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110242427=            INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OB' +
        'JECT_TYPE, ID, OPER)'
      
        '110242428=            VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 4, :G' +
        '_PRODUCT_, 1);'
      '110242429=    END'
      '110242430='
      
        '110242431=    -- '#1045#1057#1051#1048' '#1062#1045#1053#1040' '#1055#1056#1048#1061#1054#1044#1040' '#1053#1045' '#1055#1059#1057#1058#1040#1071' - '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1058 +
        #1054#1042#1040#1056#1040', '#1047#1040#1053#1054#1064#1059' '#1055#1054#1050#1040' '#1042#1054' '#1042#1056#1045#1052#1045#1053#1053#1059#1070', '#1063#1058#1054#1041#1067' '#1055#1054' '#1042#1057#1045#1052' '#1058#1054#1042#1040#1056#1040#1052' '#1055#1054#1058#1054#1052' '#1057#1044#1045 +
        #1051#1040#1058#1068' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1042' '#1054#1044#1053#1054#1049' '#1053#1040#1050#1051#1040#1044#1053#1054#1049
      '110242432=    PNT_ = '#39'03'#39';'
      '110242433=    IF (COALESCE(:AMOUNT_, 0) > 0) THEN BEGIN'
      '110242434=        EXECUTE PROCEDURE ins_sklad_TMP(:g_product_,'
      '110242435=                                       :AMOUNT_,'
      '110242436=                                       :SELF_PRICE_,'
      
        '110242437=                                       :AMOUNT_ * :SEL' +
        'F_PRICE_,'
      '110242438=                                       0, --nds_,'
      '110242439=                                       0 --nds_summ_,'
      
        '110242440=                                       ,:SELF_PRICE_UE' +
        '_'
      
        '110242441=                                       ,:AMOUNT_ * :SE' +
        'LF_PRICE_UE_'
      
        '110242442=                                       ) RETURNING_VAL' +
        'UES (:sklad_, :ERR_CODE, :ERR_MSG);'
      '110242443=        IF (ERR_CODE <> 0) THEN BEGIN'
      '110242444=          ERR_MSG  = '#39' PNT_ '#39'||PNT_||'#39' -> '#39'||ERR_MSG;'
      '110242445=          EXIT;'
      '110242446=        END'
      '110242447=    END'
      '110242448='
      
        '110242449=    -- '#1042#1057#1058#1040#1042#1051#1071#1070' '#1054#1041#1065#1048#1049' '#1055#1056#1048#1061#1054#1044' '#1045#1057#1051#1048' '#1069#1058#1054' '#1055#1056#1048#1064#1051#1040' '#1055#1054#1057#1051#1045#1044#1053#1071#1071 +
        ' '#1047#1040#1055#1048#1057#1068
      '110242450=    PNT_ = '#39'04'#39';'
      '110242451=    IF (COALESCE(IS_THIS_LAST_, 0) = 1) THEN BEGIN'
      
        '110242452=      SELECT COUNT(T.SKLAD)      -- '#1041#1067#1051' '#1051#1048' '#1042#1054#1054#1041#1065#1045' '#1055#1056#1048#1061 +
        #1054#1044
      '110242453=        FROM SKLAD_TMP T'
      '110242454=        INTO :CNT_;'
      '110242455='
      '110242456=      if (CNT_ > 0) then BEGIN'
      '110242457=        SELECT SUM(T.SUMM), SUM(T.SUMM_CURRENCY)'
      '110242458=          FROM SKLAD_TMP T'
      '110242459=          INTO :SUMM_, :SUMM_UE_;'
      '110242460='
      '110242461=        INSERT INTO SKLAD_PARENT (SKLAD,'
      '110242462=                                DATE_RECEIPT,'
      '110242463=                                TIME_RECEIPT,'
      '110242464=                                G_CLIENT,'
      '110242465=                                G_PAYMENT_TYPE,'
      '110242466=                                OSNOVANIE,'
      '110242467=                                NOTE,'
      '110242468=                                SUMM,'
      '110242469=                                SUMM_FACT,'
      '110242470=                                SUMM_CURRENCY,'
      '110242471=                                IS_PAYED_ALL,'
      '110242472=                                IS_VOZVRAT,'
      '110242473=                                G_TOCHKA)'
      '110242474=        VALUES (GEN_ID(GEN_SKLAD, 1),'
      '110242475=                CURRENT_DATE,'
      '110242476=                CURRENT_TIME,'
      '110242477=                :G_CLIENT_,'
      '110242478=                1,'
      '110242479=                NULL,  --:OSNOVANIE_,'
      '110242480=                NULL,  -- :NOTE_,'
      '110242481=                :SUMM_,'
      '110242482=                :SUMM_,'
      '110242483=                :SUMM_UE_,'
      
        '110242484=                1,  -- IS_PAYED_ALL , '#1045#1057#1051#1048' '#1057#1059#1052#1052#1040' '#1047#1040#1050#1040#1047 +
        #1040' '#1056#1040#1042#1053#1040' '#1057#1059#1052#1052#1045' '#1060#1040#1050#1058#1048#1063#1045#1057#1050#1054#1049', '#1058#1054' '#1057#1058#1040#1042#1051#1070' "'#1055#1054#1051#1053#1054#1057#1058#1068#1070' '#1054#1055#1051#1040#1063#1045#1053'", '#1048#1053#1040#1063#1045' ' +
        '0'
      '110242485=                0,'
      '110242486=                :G_TOCHKA_)'
      '110242487=        RETURNING'
      '110242488=          SKLAD'
      '110242489=        INTO'
      '110242490=          :SKLAD_PARENT_;'
      '110242491='
      '110242492=        PNT_ = '#39'05'#39';'
      '110242493=        FOR SELECT SKLAD,'
      '110242494=                   G_PRODUCT,'
      '110242495=                   AMOUNT,'
      '110242496=                   PRICE,'
      '110242497=                   SUMM'
      '110242498=                   ,PRICE_CURRENCY'
      '110242499=                   ,SUMM_CURRENCY'
      '110242500=              FROM SKLAD_TMP'
      '110242501=             ORDER BY 1'
      '110242502=              INTO :SKLAD_TMP_,'
      '110242503=                   :RG_PRODUCT_,'
      '110242504=                   :RAMOUNT_,'
      '110242505=                   :RPRICE_,'
      '110242506=                   :RSUMM_'
      '110242507=                   ,:RPRICE_UE_'
      '110242508=                   ,:RSUMM_UE_'
      '110242509=        DO BEGIN'
      '110242510='
      '110242511=            /*UPDATE SKLAD SK'
      '110242512=               SET SK.IS_LAST = 0'
      '110242513=             WHERE SK.G_PRODUCT = :RG_PRODUCT_'
      '110242514=               AND SK.IS_LAST = 1;*/'
      '110242515='
      '110242516=            INSERT INTO SKLAD'
      '110242517=            ('
      '110242518=             SKLAD,'
      '110242519=             SKLAD_PARENT,'
      '110242520=             DATE_RECEIPT,'
      '110242521=             G_CLIENT,'
      '110242522=             G_PRODUCT,'
      '110242523=             AMOUNT,'
      '110242524=             PRICE,'
      '110242525=             SUMM,'
      '110242526=             G_PAYMENT_TYPE,'
      '110242527=             OSNOVANIE,'
      '110242528=             NOTE,'
      '110242529=             NDS,'
      '110242530=             NDS_SUMM,'
      '110242531=             IS_LAST,'
      '110242532=             IS_VOZVRAT,'
      '110242533=             G_TOCHKA'
      '110242534=             ,PRICE_CURRENCY'
      '110242535=             ,SUMM_CURRENCY'
      '110242536=            ) VALUES ('
      '110242537=             :SKLAD_TMP_,'
      '110242538=             :SKLAD_PARENT_,'
      '110242539=             CURRENT_DATE,'
      '110242540=             :G_CLIENT_,'
      '110242541=             :RG_PRODUCT_,'
      '110242542=             :RAMOUNT_,'
      '110242543=             :RPRICE_,'
      '110242544=             :RSUMM_,'
      '110242545=             1,       --:G_PAYMENT_TYPE_,'
      '110242546=             NULL,    --:OSNOVANIE_,'
      '110242547=             NULL,    --:NOTE_,'
      '110242548=             0,       --:RNDS_,'
      '110242549=             0,       --:RNDS_SUMM_,'
      '110242550=             0,       --IS_LAST_'
      '110242551=             0,        --:IS_VOZVRAT_'
      '110242552=             :G_TOCHKA_'
      '110242553=             ,:RPRICE_UE_'
      '110242554=             ,:RSUMM_UE_'
      '110242555=            );'
      '110242556='
      
        '110242557=            -- '#1057#1056#1040#1042#1053#1048#1042#1040#1070', '#1045#1057#1051#1048' '#1045#1057#1058#1068' '#1058#1040#1050#1054#1049' '#1058#1054#1042#1040#1056', '#1058#1054' '#1052#1045 +
        #1053#1071#1070' '#1045#1043#1054' '#1050#1054#1051#1048#1063#1045#1057#1058#1042#1054' '#1042' '#1058#1040#1041#1051#1048#1062#1045' '#1054#1057#1058#1040#1058#1050#1054#1042', '#1045#1057#1051#1048' '#1053#1045#1058#1059', '#1058#1054' '#1044#1045#1051#1040#1070' '#1042#1057#1058#1040#1042 +
        #1050#1059
      '110242558=            PNT_ = '#39'06'#39';'
      '110242559=            UPDATE LT_SKLAD_PRODUCT L'
      '110242560=               SET L.AMOUNT = L.AMOUNT + :RAMOUNT_,'
      
        '110242561=                   L.NEED_TO_EXPORT = :UPLOAD_TO_EXT_A' +
        'PP_'
      '110242562=             WHERE L.G_PRODUCT = :RG_PRODUCT_'
      '110242563=               AND L.G_TOCHKA = :G_TOCHKA_;'
      '110242564='
      '110242565=            PNT_ = '#39'06a'#39';'
      '110242566=            IF (ROW_COUNT = 0) THEN'
      
        '110242567=              INSERT INTO LT_SKLAD_PRODUCT (LT_SKLAD_P' +
        'RODUCT, G_PRODUCT, AMOUNT, AMOUNT_RESERVE, G_TOCHKA, NEED_TO_EXP' +
        'ORT)'
      
        '110242568=              VALUES (GEN_ID(GEN_LT_SKLAD_PRODUCT, 1),' +
        ' :RG_PRODUCT_, :RAMOUNT_, 0, :G_TOCHKA_, :UPLOAD_TO_EXT_APP_);'
      '110242569=        END'
      '110242570='
      '110242571=        PNT_ = '#39'07'#39';'
      
        '110242572=        EXECUTE PROCEDURE K_INS_KASSA(1,     -- ACTION' +
        '_ => :ACTION_,  '#1056#1040#1057#1061#1054#1044
      
        '110242573=                                2,    --:G_PRIHOD_RASH' +
        'OD_,'
      '110242574=                                :SUMM_,'
      '110242575=                                CURRENT_DATE,'
      
        '110242576=                                NULL,   --NOTE_ => :NO' +
        'TE_,'
      '110242577=                                NULL,   --ZAKAZ_'
      '110242578=                                :SKLAD_PARENT_,'
      '110242579=                                1,'
      '110242580=                                :G_TOCHKA_,'
      
        '110242581=                                :UPLOAD_TO_EXT_APP_) R' +
        'ETURNING_VALUES (:KASSA_, :ERR_CODE, :ERR_MSG);'
      '110242582=        IF (:ERR_CODE <> 0) THEN BEGIN'
      
        '110242583=          ERR_MSG = PROCNAME||'#39' -> PNT_ '#39'||PNT_||'#39' '#39'||' +
        'ERR_MSG;'
      '110242584=          EXIT;'
      '110242585=        END'
      '110242586='
      '110242587=        DELETE FROM SKLAD_TMP;'
      '110242588='
      '110242589=        -- '#1042#1067#1043#1056#1059#1046#1040#1070' '#1044#1040#1053#1053#1067#1045' '#1042#1054' '#1042#1053#1045#1064#1053#1070#1070' '#1057#1056#1045#1044#1059
      '110242590=        IF (UPLOAD_TO_EXT_APP_ = 1) THEN'
      
        '110242591=          INSERT INTO SYNC_EXT_APP (SYNC_EXT_APP, OBJE' +
        'CT_TYPE, ID, OPER)'
      
        '110242592=          VALUES (GEN_ID(GEN_SYNC_EXT_APP, 1), 2, :SKL' +
        'AD_, 1);'
      '110242593=      END'
      '110242594=    END'
      '110242595='
      
        '110242596=    -- '#1042' '#1055#1056#1054#1062#1045#1057#1057#1045' '#1055#1045#1056#1045#1052#1045#1053#1053#1040#1071' ERR_MSG '#1053#1045#1057#1050#1054#1051#1068#1050#1054' '#1056#1040#1047', '#1055#1054 +
        #1069#1058#1054#1052#1059' '#1057#1044#1045#1051#1040#1051' '#1063#1045#1056#1045#1047' '#1044#1056#1059#1043#1059#1070' '#1055#1045#1056#1045#1052#1045#1053#1053#1059#1070
      '110242597=    if (ERR_MSG_ IS NOT NULL) then'
      '110242598=      ERR_MSG = ERR_MSG_;'
      '110242599='
      '110242600=WHEN ANY DO BEGIN'
      '110242601=    IF (GDSCODE = 335544652) THEN BEGIN'
      '110242602=        Err_code = GDSCODE;'
      
        '110242603=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1042#1099' '#1087#1099#1090#1072#1077#1090#1077#1089#1100' '#1080#1084 +
        #1087#1086#1088#1090#1080#1088#1086#1074#1072#1090#1100' '#1090#1086#1074#1072#1088#1099' '#1089' '#1086#1076#1080#1085#1072#1082#1086#1074#1099#1084' '#1079#1085#1072#1095#1077#1085#1080#1077#1084'!'#39';'
      '110242604=        IF (PNT_ = '#39'02'#39') THEN'
      
        '110242605=            ERR_MSG = ERR_MSG || '#39' '#1040#1088#1090#1080#1082#1091#1083' '#39' || ARTICU' +
        'L_ || '#39'.'#39';'
      '110242606=        ELSE'
      
        '110242607=            ERR_MSG = ERR_MSG || '#39' '#1050#1086#1076' '#39'||gdscode||'#39' -' +
        '-> PNT_ '#39'||PNT_;'
      '110242608=    END ELSE BEGIN'
      '110242609=        Err_code = gdscode;'
      
        '110242610=        ERR_MSG = '#39#1054#1064#1048#1041#1050#1040' '#1055#1056#1048' '#1048#1052#1055#1054#1056#1058#1045'! '#1050#1086#1076' '#39'||gdscode|' +
        '|'#39' --> PNT_ '#39'||PNT_;'
      '110242611=    END'
      '110242612=  END'
      '110242613=END'
      '110242614=;'
      '110242615='
      '110242616=ALTER PROCEDURE READ_ZAKAZ_LIST('
      '110242617=  DATE_BEGIN_ DATE,'
      '110242618=  DATE_END_ DATE,'
      '110242619=  IS_SPISANIE_ INTEGER,'
      '110242620=  SALE_OF_GOODS_ INTEGER)'
      '110242621=RETURNS ('
      '110242622=  ZAKAZ TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110242623=  Z_NUM TYPE OF COLUMN ZAKAZ.ZAKAZ,'
      '110242624=  G_TOCHKA TYPE OF COLUMN ZAKAZ.G_TOCHKA,'
      '110242625=  Z_DATE TYPE OF COLUMN ZAKAZ.Z_DATE,'
      '110242626=  Z_TIME TYPE OF COLUMN ZAKAZ.Z_TIME,'
      '110242627=  G_CLIENT TYPE OF COLUMN ZAKAZ.G_CLIENT,'
      '110242628=  OSNOVANIE TYPE OF COLUMN ZAKAZ.OSNOVANIE,'
      '110242629=  NOTE TYPE OF COLUMN ZAKAZ.NOTE,'
      '110242630=  CLIENT_NAME TYPE OF COLUMN G_CLIENT.NAME,'
      '110242631=  DETAILS_STR VARCHAR(3000),'
      '110242632=  IS_SPISANIE TYPE OF COLUMN ZAKAZ.IS_SPISANIE,'
      '110242633=  IS_PAYED_ALL TYPE OF COLUMN ZAKAZ.IS_PAYED_ALL,'
      '110242634=  INVOICE_PAY TYPE OF COLUMN INVOICE_PAY.INVOICE_PAY,'
      '110242635=  INVOICE TYPE OF COLUMN INVOICE.INVOICE,'
      '110242636=  WAYBILL TYPE OF COLUMN WAYBILL.WAYBILL,'
      '110242637=  SUM_ZAKAZ TYPE OF COLUMN ZAKAZ.SUMM,'
      '110242638=  SUM_FACT TYPE OF COLUMN ZAKAZ.SUMM_FACT,'
      '110242639=  SUMM_CASH TYPE OF COLUMN ZAKAZ.SUMM_CASH,'
      '110242640=  SUMM_NONCASH TYPE OF COLUMN ZAKAZ.SUMM_NONCASH,'
      '110242641=  SUMM_PAY_BONUS TYPE OF COLUMN ZAKAZ.SUMM_BONUS,'
      '110242642=  SUMM_BONUS_GOT TYPE OF COLUMN ZAKAZ.SUMM_BONUS_GOT,'
      '110242643=  BY_RECIPE TYPE OF COLUMN ZAKAZ.BY_RECIPE,'
      '110242644=  IS_RESERVE TYPE OF COLUMN ZAKAZ.IS_RESERVE,'
      '110242645=  G_OFFICIAL TYPE OF COLUMN G_OFFICIAL.G_OFFICIAL,'
      '110242646=  G_OFFICIAL_FIO TYPE OF COLUMN G_OFFICIAL.FIO_DOC,'
      '110242647=  ADDRESS TYPE OF COLUMN G_ADDRESS.ADDRESS,'
      
        '110242648=  G_NONCASH_PAY_TYPE TYPE OF COLUMN G_NONCASH_PAY_TYPE' +
        '.G_NONCASH_PAY_TYPE,'
      
        '110242649=  G_NONCASH_PAY_TYPE_NAME TYPE OF COLUMN G_NONCASH_PAY' +
        '_TYPE.NAME,'
      '110242650=  BONUSALL TYPE OF COLUMN G_DISCONT_CARD.SUMM,'
      '110242651=  REQUEST_NUMBER TYPE OF COLUMN ZAKAZ.REQUEST_NUMBER)'
      '110242652=AS'
      '110242653=/*'
      '110242654=IS_SPISANIE_'
      '110242655=0 - '#1054#1041#1067#1063#1053#1040#1071' '#1055#1056#1054#1044#1040#1046#1040
      '110242656=1 - '#1057#1055#1048#1057#1040#1053#1048#1045
      '110242657=2 - '#1055#1056#1054#1044#1040#1046#1040' '#1058#1054#1042#1040#1056#1040' '#1050#1040#1050' '#1054#1055#1051#1040#1058#1040' '#1047#1040' '#1058#1054#1042#1040#1056' '#1055#1054#1044' '#1056#1045#1040#1051
      
        '110242658=4 - '#1042#1054#1047#1042#1056#1040#1058' '#1058#1054#1042#1040#1056#1040' '#1055#1054#1057#1058#1040#1042#1065#1048#1050#1059', 3 - '#1042' '#1055#1056#1054#1062#1045#1044#1059#1056#1040#1061' '#1047#1040#1053#1071#1058#1054 +
        ' '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045#1052' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110242659=*/'
      '110242660=DECLARE VARIABLE CNT_ INTEGER = 0;'
      
        '110242661=DECLARE VARIABLE G_OFFICIAL_LOCAL_ TYPE OF COLUMN G_OF' +
        'FICIAL.G_OFFICIAL;'
      
        '110242662=DECLARE VARIABLE G_OFFICIAL_APPOINT_ TYPE OF COLUMN G_' +
        'OFFICIAL.IS_ISPOLNITEL;'
      '110242663=BEGIN'
      '110242664=  sale_of_goods_ = COALESCE(sale_of_goods_, 0);'
      '110242665=  if (sale_of_goods_ = 0) then'
      '110242666=  begin'
      '110242667=    G_OFFICIAL_LOCAL_ = 0;'
      '110242668=    G_OFFICIAL_APPOINT_ = 1;'
      '110242669=  end'
      '110242670=  else'
      '110242671=  begin'
      '110242672=      SELECT G.G_OFFICIAL,'
      '110242673=             G.IS_RUKOVODITEL + G.IS_GLAVBUH'
      '110242674=        FROM CUR_PARAMS C,'
      '110242675=             G_OFFICIAL G'
      '110242676=       WHERE C.ID = G.G_OFFICIAL'
      '110242677=         AND C.CUR_PARAMS = 1'
      '110242678=        INTO :G_OFFICIAL_LOCAL_,'
      '110242679=             :G_OFFICIAL_APPOINT_;'
      '110242680=  end'
      '110242681='
      '110242682='
      '110242683=  G_OFFICIAL_LOCAL_ = COALESCE(G_OFFICIAL_LOCAL_, 0);'
      
        '110242684=  G_OFFICIAL_APPOINT_ = COALESCE(G_OFFICIAL_APPOINT_, ' +
        '0);'
      '110242685='
      '110242686=  IF (IS_SPISANIE_ <> 3) THEN'
      '110242687=  BEGIN'
      '110242688=      SELECT COUNT(*)'
      '110242689=        FROM ZAKAZ T'
      
        '110242690=       WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE_E' +
        'ND_'
      
        '110242691=        AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS WH' +
        'ERE CUR_PARAMS = 2)'
      
        '110242692=        AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISANIE_' +
        ' = 0'
      '110242693=              AND'
      
        '110242694=              ((:G_OFFICIAL_APPOINT_ = 0 AND T.G_OFFIC' +
        'IAL = :G_OFFICIAL_LOCAL_)'
      '110242695=                OR'
      '110242696=              (:G_OFFICIAL_APPOINT_ = 1 )'
      '110242697=              )'
      '110242698=             )'
      '110242699=             or'
      
        '110242700=             (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS_SP' +
        'ISANIE_ <> 0)'
      '110242701=            )'
      '110242702=        INTO CNT_;'
      '110242703='
      '110242704=      if (CNT_ = 0) then'
      '110242705=        SELECT MAX(T.Z_DATE)'
      '110242706=          FROM ZAKAZ T'
      '110242707=         WHERE T.Z_DATE < :DATE_BEGIN_'
      
        '110242708=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      
        '110242709=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISAN' +
        'IE_ = 0'
      '110242710=              AND'
      
        '110242711=              ((:G_OFFICIAL_APPOINT_ = 0 AND T.G_OFFIC' +
        'IAL = :G_OFFICIAL_LOCAL_)'
      '110242712=                OR'
      '110242713=              (:G_OFFICIAL_APPOINT_ = 1 )'
      '110242714=              )'
      '110242715=             )'
      '110242716=             or'
      
        '110242717=             (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS_SP' +
        'ISANIE_ <> 0)'
      '110242718=            )'
      '110242719=          INTO :DATE_BEGIN_;'
      '110242720='
      '110242721=  END ELSE'
      '110242722=  BEGIN'
      '110242723=      SELECT COUNT(*)'
      '110242724=        FROM SKLAD_PARENT T'
      
        '110242725=       WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND :' +
        'DATE_END_'
      
        '110242726=         AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS W' +
        'HERE CUR_PARAMS = 2)'
      '110242727=        INTO CNT_;'
      '110242728='
      '110242729=      if (CNT_ = 0) then'
      '110242730=        SELECT MAX(T.DATE_RECEIPT)'
      '110242731=          FROM SKLAD_PARENT T'
      '110242732=         WHERE T.DATE_RECEIPT < :DATE_BEGIN_'
      '110242733=           AND T.IS_VOZVRAT = 3'
      
        '110242734=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110242735=          INTO :DATE_BEGIN_;'
      '110242736=  END'
      '110242737='
      '110242738=  -- '#1055#1056#1054#1044#1040#1046#1048
      '110242739=  IF (IS_SPISANIE_ IN (0,2,4)) THEN'
      '110242740=  BEGIN'
      '110242741=      FOR'
      '110242742=        SELECT T.ZAKAZ,'
      
        '110242743=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042 +
        #1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '110242744=               T.G_TOCHKA,'
      '110242745=               T.Z_DATE,'
      '110242746=               T.Z_TIME,'
      '110242747=               T.G_CLIENT,'
      '110242748=               T.OSNOVANIE,'
      '110242749=               T.NOTE,'
      '110242750=               gc.name,'
      
        '110242751=               /*SUBSTRING((SELECT LIST(NAME||'#39'('#39'||AMO' +
        'UNT||'#39')'#39', '#39', '#39')'
      
        '110242752=                            FROM (SELECT G.name, SUM(D' +
        '.amount) AMOUNT'
      
        '110242753=                                    FROM ZAKAZ Z, ZAKA' +
        'Z_DETAILS D, G_PRODUCT G'
      
        '110242754=                                   WHERE D.G_PRODUCT =' +
        ' G.G_PRODUCT'
      
        '110242755=                                     AND D.ZAKAZ = Z.Z' +
        'AKAZ'
      
        '110242756=                                     AND Z.ZAKAZ = T.Z' +
        'AKAZ'
      '110242757=                                   GROUP BY G.name)'
      
        '110242758=                          ) FROM 1 FOR 1500)*/'#39' '#39' DETA' +
        'ILS_STR,'
      '110242759=               T.IS_SPISANIE,'
      
        '110242760=               COALESCE(T.IS_PAYED_ALL, 0) IS_PAYED_AL' +
        'L,'
      '110242761=               IP.INVOICE_PAY,'
      '110242762=               I.INVOICE,'
      '110242763=               W.WAYBILL,'
      '110242764=               T.SUMM,'
      '110242765=               T.SUMM_FACT,'
      '110242766=               COALESCE(t.SUMM_BONUS, 0),'
      '110242767=               COALESCE(t.SUMM_BONUS_GOT, 0),'
      '110242768=               COALESCE(T.BY_RECIPE, 0)'
      '110242769=               ,IS_RESERVE'
      '110242770=               ,T.SUMM_CASH'
      '110242771=               ,T.SUMM_NONCASH'
      '110242772=               ,O.g_official'
      '110242773=               ,COALESCE(O.fio_doc, O.FM||'#39' '#39'||O.nm)'
      '110242774=               ,T.DELIVERY_ADDRESS'
      '110242775=               ,GN.G_NONCASH_PAY_TYPE'
      '110242776=               ,GN.NAME'
      '110242777=               ,GD.SUMM'
      '110242778=               ,T.REQUEST_NUMBER'
      '110242779=          FROM ZAKAZ T'
      
        '110242780=                    LEFT OUTER JOIN G_CLIENT GC ON T.G' +
        '_CLIENT = GC.G_CLIENT'
      
        '110242781=                    LEFT OUTER JOIN INVOICE_PAY IP ON ' +
        'T.ZAKAZ = IP.ZAKAZ'
      
        '110242782=                    LEFT OUTER JOIN INVOICE I ON T.ZAK' +
        'AZ = I.ZAKAZ'
      
        '110242783=                    LEFT OUTER JOIN WAYBILL W ON T.ZAK' +
        'AZ = W.ZAKAZ'
      
        '110242784=                    LEFT OUTER JOIN G_OFFICIAL O ON T.' +
        'g_official = O.g_official'
      
        '110242785=                    LEFT OUTER JOIN G_NONCASH_PAY_TYPE' +
        ' GN ON T.G_NONCASH_PAY_TYPE = GN.G_NONCASH_PAY_TYPE'
      
        '110242786=                    LEFT OUTER JOIN G_DISCONT_CARD GD ' +
        'ON T.G_CLIENT = GD.G_CLIENT'
      
        '110242787=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      
        '110242788=           AND ((T.IS_SPISANIE IN (0,2) AND :IS_SPISAN' +
        'IE_ = 0'
      '110242789=                 AND'
      
        '110242790=                 ((:G_OFFICIAL_APPOINT_ = 0 AND T.G_OF' +
        'FICIAL = :G_OFFICIAL_LOCAL_)'
      '110242791=                   OR'
      '110242792=                  (:G_OFFICIAL_APPOINT_ = 1 )'
      '110242793=                 )'
      '110242794=                )'
      '110242795=                or'
      
        '110242796=                (T.IS_SPISANIE = :IS_SPISANIE_ AND :IS' +
        '_SPISANIE_ <> 0)'
      '110242797=               )'
      
        '110242798=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110242799=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '110242800=        INTO :ZAKAZ,'
      '110242801=             :Z_NUM,'
      '110242802=             :G_TOCHKA,'
      '110242803=             :Z_DATE,'
      '110242804=             :Z_TIME,'
      '110242805=             :G_CLIENT,'
      '110242806=             :OSNOVANIE,'
      '110242807=             :NOTE,'
      '110242808=             :CLIENT_NAME,'
      '110242809=             :DETAILS_STR,'
      '110242810=             :IS_SPISANIE,'
      '110242811=             :IS_PAYED_ALL,'
      '110242812=             :INVOICE_PAY,'
      '110242813=             :INVOICE,'
      '110242814=             :WAYBILL,'
      '110242815=             :SUM_ZAKAZ,'
      '110242816=             :SUM_FACT,'
      '110242817=             :SUMM_PAY_BONUS,'
      '110242818=             :SUMM_BONUS_GOT,'
      '110242819=             :BY_RECIPE'
      '110242820=             ,:IS_RESERVE'
      '110242821=             ,:summ_cash'
      '110242822=             ,:SUMM_NONCASH'
      '110242823=             ,:G_OFFICIAL'
      '110242824=             ,:G_OFFICIAL_FIO'
      '110242825=             ,:ADDRESS'
      '110242826=             ,:G_NONCASH_PAY_TYPE'
      '110242827=             ,:G_NONCASH_PAY_TYPE_NAME'
      '110242828=             ,:BONUSALL'
      '110242829=             ,:REQUEST_NUMBER'
      '110242830=      DO'
      '110242831=        suspend;'
      '110242832='
      '110242833=  -- '#1057#1055#1048#1057#1040#1053#1048#1071
      '110242834=  END ELSE IF (IS_SPISANIE_ = 1) THEN'
      '110242835=  BEGIN'
      '110242836=      FOR'
      '110242837=        SELECT T.ZAKAZ,'
      
        '110242838=               T.ZAKAZ,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042 +
        #1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '110242839=               T.G_TOCHKA,'
      '110242840=               T.Z_DATE,'
      '110242841=               T.Z_TIME,'
      '110242842=               T.G_CLIENT,'
      '110242843=               T.OSNOVANIE,'
      '110242844=               T.NOTE,'
      '110242845=               NULL,'
      '110242846=               SUBSTRING((SELECT'
      
        '110242847=                          LIST(G.NAME||'#39'('#39'||D.AMOUNT||' +
        #39')'#39', '#39', '#39')'
      
        '110242848=                        FROM ZAKAZ_DETAILS D, G_PRODUC' +
        'T G'
      
        '110242849=                        WHERE D.G_PRODUCT = G.G_PRODUC' +
        'T'
      '110242850=                          AND D.ZAKAZ = T.ZAKAZ'
      
        '110242851=                          GROUP BY ZAKAZ) FROM 1 FOR 9' +
        '99) DETAILS_STR,'
      '110242852=               T.IS_SPISANIE,'
      '110242853=               0,'
      '110242854=               NULL,'
      '110242855=               NULL,'
      '110242856=               NULL,'
      '110242857=               T.SUMM,'
      '110242858=               T.SUMM_FACT,'
      '110242859=               0,'
      '110242860=               0,'
      '110242861=               0,'
      '110242862=               T.REQUEST_NUMBER'
      '110242863=          FROM ZAKAZ T'
      
        '110242864=         WHERE T.Z_DATE BETWEEN :DATE_BEGIN_ AND :DATE' +
        '_END_'
      '110242865=           AND T.IS_SPISANIE  = 1'
      
        '110242866=           AND T.G_TOCHKA = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110242867=        ORDER BY T.Z_DATE, T.ZAKAZ'
      '110242868=        INTO :ZAKAZ,'
      '110242869=             :Z_NUM,'
      '110242870=             :G_TOCHKA,'
      '110242871=             :Z_DATE,'
      '110242872=             :Z_TIME,'
      '110242873=             :G_CLIENT,'
      '110242874=             :OSNOVANIE,'
      '110242875=             :NOTE,'
      '110242876=             :CLIENT_NAME,'
      '110242877=             :DETAILS_STR,'
      '110242878=             :IS_SPISANIE,'
      '110242879=             :IS_PAYED_ALL,'
      '110242880=             :INVOICE_PAY,'
      '110242881=             :INVOICE,'
      '110242882=             :WAYBILL,'
      '110242883=             :SUM_ZAKAZ,'
      '110242884=             :SUM_FACT,'
      '110242885=             :SUMM_PAY_BONUS,'
      '110242886=             :SUMM_BONUS_GOT,'
      '110242887=             :BONUSALL,'
      '110242888=             :REQUEST_NUMBER'
      '110242889=      DO'
      '110242890=        suspend;'
      '110242891='
      '110242892=  -- '#1055#1045#1056#1045#1052#1045#1065#1045#1053#1048#1045' '#1052#1045#1046#1044#1059' '#1057#1050#1051#1040#1044#1040#1052#1048
      '110242893=  END ELSE'
      '110242894=  BEGIN'
      '110242895=      FOR'
      '110242896=        SELECT T.SKLAD,'
      
        '110242897=               T.SKLAD,  -- '#1057#1054#1047#1044#1040#1051' '#1053#1040' '#1042#1057#1071#1050#1048#1049' '#1057#1051#1059#1063#1040#1049', '#1042 +
        #1044#1056#1059#1043' '#1042' '#1041#1059#1044#1059#1065#1045#1052' '#1041#1059#1044#1059' '#1042#1056#1059#1063#1053#1059#1070' '#1042#1041#1048#1042#1040#1058#1068' '#1053#1054#1052#1045#1056#1040' '#1047#1040#1050#1040#1047#1054#1042
      '110242898=               T.G_TOCHKA,'
      '110242899=               T.DATE_RECEIPT,'
      '110242900=               T.TIME_RECEIPT,'
      '110242901=               T.G_CLIENT,'
      '110242902=               T.OSNOVANIE,'
      '110242903=               T.NOTE,'
      '110242904=               gc.name,'
      '110242905=               /*SUBSTRING((SELECT'
      
        '110242906=                            LIST(G.NAME||'#39'('#39'||D.AMOUNT' +
        '||'#39')'#39', '#39', '#39')'
      '110242907=                            FROM SKLAD D, G_PRODUCT G'
      
        '110242908=                           WHERE D.G_PRODUCT = G.G_PRO' +
        'DUCT'
      
        '110242909=                             AND D.SKLAD_PARENT = T.SK' +
        'LAD'
      
        '110242910=                            GROUP BY SKLAD_PARENT) FRO' +
        'M 1 FOR 999)*/ '#39#39' DETAILS_STR,'
      '110242911=               T.SUMM,'
      '110242912=               T.IS_VOZVRAT,'
      '110242913=               W.WAYBILL'
      
        '110242914=          FROM SKLAD_PARENT T LEFT OUTER JOIN WAYBILL ' +
        'W ON T.SKLAD = W.ZAKAZ,'
      '110242915=               G_TOCHKA GC'
      
        '110242916=         WHERE T.DATE_RECEIPT BETWEEN :DATE_BEGIN_ AND' +
        ' :DATE_END_'
      
        '110242917=           AND T.G_CLIENT = (SELECT ID FROM CUR_PARAMS' +
        ' WHERE CUR_PARAMS = 2)'
      '110242918=           AND T.G_TOCHKA = GC.G_TOCHKA'
      '110242919=           AND T.IS_VOZVRAT = 3'
      '110242920=        ORDER BY T.DATE_RECEIPT, T.SKLAD'
      '110242921=        INTO :ZAKAZ,'
      '110242922=             :Z_NUM,'
      '110242923=             :G_TOCHKA,'
      '110242924=             :Z_DATE,'
      '110242925=             :Z_TIME,'
      '110242926=             :G_CLIENT,'
      '110242927=             :OSNOVANIE,'
      '110242928=             :NOTE,'
      '110242929=             :CLIENT_NAME,'
      '110242930=             :DETAILS_STR,'
      '110242931=             :SUM_ZAKAZ,'
      '110242932=             :IS_SPISANIE,'
      '110242933=             :WAYBILL'
      '110242934=      DO'
      '110242935=        suspend;'
      '110242936=  END'
      '110242937='
      '110242938=end'
      '110242939=;'
      '110242940='
      '110242941='
      
        '110242942=UPDATE SYSTEM_SETUP SET S_VALUE = 110242 WHERE SYSTEM_' +
