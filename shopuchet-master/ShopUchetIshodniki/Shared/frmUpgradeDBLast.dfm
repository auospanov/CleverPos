      '11060112='
      '11060113=ALTER PROCEDURE DELIVERY_DEL('
      
        '11060114=  DELIVERY_ /* TYPE OF COLUMN DELIVERY.DELIVERY */ INTE' +
        'GER)'
      '11060115=AS'
      '11060116=BEGIN'
