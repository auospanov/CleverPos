      '11096419=                END'
      '11096420=            END'
      '11096421='
      
        '11096422=            --=========================================' +
        '========================'
      '11096423=            -- '#1041#1051#1054#1050' '#1055#1056#1054#1042#1045#1056#1050#1048' '#1057#1054#1055#1059#1058#1057#1058#1042#1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '11096424=            --=========================================' +
        '========================'
      
        '11096425=            -- '#1058#1045#1055#1045#1056#1068' '#1056#1040#1047#1041#1048#1056#1040#1070#1057#1068' '#1057' '#1055#1056#1048#1061#1054#1044#1054#1052' '#1054#1058' '#1057#1054#1055#1059#1058#1057#1058#1042 +
        #1059#1070#1065#1045#1049' '#1057#1058#1040#1058#1068#1048
      
        '11096426=            -- '#1045#1057#1051#1048' '#1055#1054#1055#1059#1058#1053#1054' '#1055#1056#1048#1064#1051#1040' '#1057#1058#1040#1058#1068#1071' '#1055#1056#1048#1061#1054#1044#1040', '#1053#1040#1055#1056 +
        #1048#1052#1045#1056' '#1059#1055#1040#1050#1054#1042#1050#1040' '#1048#1051#1048' '#1044#1054#1057#1058#1040#1042#1050#1040' '#1044#1054' '#1050#1051#1048#1045#1053#1058#1040', '#1058#1054' '#1044#1045#1051#1040#1070' '#1055#1056#1048#1061#1054#1044' '#1042' '#1050#1040#1057#1057#1059
      
        '11096427=            -- '#1053#1054' '#1057#1053#1040#1063#1040#1051#1040' '#1055#1056#1054#1042#1045#1056#1071#1070' - '#1045#1057#1058#1068' '#1051#1048' '#1057#1058#1040#1058#1068#1071' '#1055#1054' ' +
        #1044#1040#1053#1053#1054#1052#1059' '#1047#1040#1050#1040#1047#1059', '#1045#1057#1051#1048' '#1045#1057#1058#1068', '#1058#1054' '#1058#1054#1043#1044#1040' '#1044#1045#1051#1040#1070' '#1040#1055#1044#1045#1049#1058
      '11096428=            IF (G_PAYMENT_TYPE_OLD_ = 1) THEN'
      '11096429=                SELECT K.KASSA'
      '11096430=                FROM KASSA K'
      '11096431=                WHERE K.ZAKAZ = :ZAKAZ_'
      '11096432=                 AND K.G_PRIHOD_RASHOD NOT IN (1, 3)'
      '11096433=                 INTO :KASSA_POP_;'
      '11096434=            ELSE'
      '11096435=                SELECT K.KASSA_BEZNAL'
      '11096436=                FROM KASSA_BEZNAL K'
