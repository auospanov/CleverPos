        7 : SyncInterval := 28800000; // 8 hour
      end;

    end;

    Test_Rekassa := Ini.ReadInteger('DEBUG_MODE', 'Test_Rekassa', 0);
  finally
    FreeAndNil(Ini);
  end;
end;

