    property BARCODE: String read FBARCODE write FBARCODE;
    property G_PROD_FOR_NEW_PRICE : Integer read FG_PROD_FOR_NEW_PRICE write FG_PROD_FOR_NEW_PRICE;  // ФОРМА вызвана для создания старого товара с новой ценой, ПЕРЕДАЕТСЯ ID СТАРОГО ТОВАРА
