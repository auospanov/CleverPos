    FBARCODE  : STRING;  //штрихкод, который будет посдавляться автоматом из PriceList, если форма вызвана при помощи сканера штрихкода
    FBARCODE8 : STRING;
    FBARCODE13 : STRING;
    UpdArr : array of TArr;  // при редактировании товара, массив с обновленными реквизитами составных товаров
    DelArr : array of TArr;  // при редактировании товара, массив с удаленными записями
    InsArr : array of TArr;  // при редактировании товара, массив с новыми записями составных товаров
