  object spReadTovar: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT'
      '        T.G_PRODUCT,'
      '        T.G_PRODUCT_PAR,'
      '        T.ARTICUL,'
      '        T.NOMENCLATUR_NUM,'
      '        T.BARCODE,'
      '        T.NAME,'
      '        T.PRICE,'
      '        T.VOLUME_PRICE,'
      '        T.PACK_AMOUNT,'
      '        T.MF_COUNTRY,'
      '        COALESCE(P.AMOUNT, 0) AMOUNT,'
      '        COALESCE(P.AMOUNT_RESERVE, 0) AMOUNT_RESERVE,'
      
        '        COALESCE((SELECT SUM(Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COA' +
        'LESCE(Z.AMOUNT_RETURNED, 0))'
      '                    FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      
        '                   WHERE Z.G_PRODUCT = T.G_PRODUCT AND Z.IS_PAYE' +
        'D_ALL = 0'
      
        '                     AND ZP.ZAKAZ_REAL_PARENT = Z.ZAKAZ_REAL_PAR' +
        'ENT'
      
        '                     AND ZP.G_TOCHKA = :G_TOCHKA_), 0) AMOUNT_NA' +
        '_REAL,'
      '        T.G_UNIT'
      '        ,T.CROSSCODE'
      '        ,T.IS_ACTIVE'
      '        ,T.NOTE'
      '        ,T.PLACE'
      '    FROM /*(WITH RECURSIVE TREE'
      '                AS (SELECT G.G_PRODUCT'
      '                      FROM G_PRODUCT G'
      
        '                     WHERE G.G_PRODUCT = DECODE(:G_PRODUCT_PAR_,' +
        ' -1, G.G_PRODUCT, :G_PRODUCT_PAR_)'
      '                       AND G.IS_CATEGORY = 1'
      '                    UNION ALL'
      '                    SELECT G.G_PRODUCT'
      
        '                      FROM G_PRODUCT G INNER JOIN TREE PRIOR ON ' +
        'PRIOR.G_PRODUCT = G.G_PRODUCT_PAR'
      '                     WHERE G.IS_CATEGORY = 1'
      '                  )'
      '            SELECT DISTINCT G_PRODUCT FROM TREE) S1,*/'
      '          (SELECT G.G_PRODUCT,'
      '                 G.G_PRODUCT_PAR,'
      '                 G.ARTICUL,'
      '                 G.NOMENCLATUR_NUM,'
      '                 G.BARCODE,'
      '                 G.NAME,'
      '                 G.PRICE,'
      '                 G.VOLUME_PRICE,'
      '                 G.PACK_AMOUNT,'
      '                 G.MF_COUNTRY,'
      '                 COALESCE(U.SHORT_NAME, U.NAME) G_UNIT'
      '                 ,G.CROSSCODE'
      '                 ,G.IS_ACTIVE'
      '                 ,G.NOTE'
      '                 ,G.PLACE'
      '            FROM G_PRODUCT G, G_UNIT U'
      '           WHERE G.IS_CATEGORY = 0'
      '             AND G.IS_ACTIVE = :IS_ACTIVE_'
      '             AND G.G_UNIT = U.G_UNIT'
      '          UNION ALL'
      '          SELECT T1.G_PRODUCT,'
      '                 T1.G_PRODUCT_PAR,'
      '                 T1.ARTICUL,'
      '                 T1.NOMENCLATUR_NUM,'
      '                 B.BARCODE,'
      '                 T1.NAME||'#39' ('#1076#1086#1087'.'#1096#1090#1088#1080#1093#1082#1086#1076')'#39','
      '                 T1.PRICE,'
      '                 T1.VOLUME_PRICE,'
      '                 T1.PACK_AMOUNT,'
      '                 T1.MF_COUNTRY,'
      '                 COALESCE(U.SHORT_NAME, U.NAME) G_UNIT'
      '                 ,T1.CROSSCODE'
      '                 ,T1.IS_ACTIVE'
      '                 ,T1.NOTE'
      '                 ,T1.PLACE'
      '            FROM G_PRODUCT T1, LT_BARCODE B, G_UNIT U'
      '           WHERE IS_CATEGORY = 0'
      '             AND IS_ACTIVE = :IS_ACTIVE_'
      '             AND T1.G_UNIT = U.G_UNIT'
      
        '             AND B.G_PRODUCT = T1.G_PRODUCT) T LEFT OUTER JOIN L' +
        'T_SKLAD_PRODUCT P ON T.G_PRODUCT = P.G_PRODUCT and P.G_TOCHKA = ' +
        ':G_TOCHKA_'
      '    --WHERE T.G_PRODUCT_PAR = S1.G_PRODUCT'
      
        '    WHERE T.G_PRODUCT_PAR = DECODE(CAST(:G_PRODUCT_PAR_ AS BIGIN' +
        'T) , -1, T.G_PRODUCT_PAR, CAST(:G_PRODUCT_PAR_ AS BIGINT))'
      '    ORDER BY 6'
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' '
      ' ')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 16
    Top = 232
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
