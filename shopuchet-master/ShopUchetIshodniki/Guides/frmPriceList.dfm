  object spScalesTovs: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT G.G_PRODUCT,'
      '     G.BARCODE,'
      '     G.NAME,'
      '     G.PRICE'
      'FROM G_PRODUCT G'
      'WHERE G.IS_CATEGORY = 0'
      ' AND G.is_active = 1'
      ' AND SUBSTRING(G.BARCODE FROM 1 FOR 2) = :SCALE_PREFIX_')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 104
    Top = 232
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
