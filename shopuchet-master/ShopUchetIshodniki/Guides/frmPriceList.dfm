  object spReadTovar: TpFIBDataSet
    SelectSQL.Strings = (
      'SELECT T.G_PRODUCT,'
      '        T.G_PRODUCT_PAR,'
      '        T.ARTICUL,'
      '        T.NOMENCLATUR_NUM,'
      '        T.BARCODE,'
      '        T.NAME,'
      '        T.PRICE,'
      '        T.VOLUME_PRICE,'
      '        T.PACK_AMOUNT,'
      '        T.MF_COUNTRY,'
      '        T.BRAND,'
      '        COALESCE(P.AMOUNT, 0) AMOUNT,'
      '        COALESCE(P.AMOUNT_RESERVE, 0) AMOUNT_RESERVE,'
      
        '        COALESCE((SELECT SUM(Z.AMOUNT_ALL - Z.AMOUNT_PAYED - COA' +
        'LESCE(Z.AMOUNT_RETURNED, 0))'
      '                    FROM ZAKAZ_NA_REAL Z, ZAKAZ_REAL_PARENT ZP'
      
        '                   WHERE Z.G_PRODUCT = T.G_PRODUCT AND Z.IS_PAYE' +
        'D_ALL = 0'
      
        '                     AND ZP.ZAKAZ_REAL_PARENT = Z.ZAKAZ_REAL_PAR' +
        'ENT'
      
        '                     AND ZP.G_TOCHKA = :G_TOCHKA_), 0) AMOUNT_NA' +
        '_REAL,'
      '        T.CROSSCODE'
      '        ,T.IS_ACTIVE'
      '        ,T.PLACE'
      '        ,T.SALES_COMM'
      '        ,T.NOTE'
      '        ,T.VES_GRAMM_PRICE'
      '        ,T.VES_GRAMM'
      '        ,T.BARCODE_DOP'
      '    FROM  (SELECT G.G_PRODUCT,'
      '                 G.G_PRODUCT_PAR,'
      '                 G.ARTICUL,'
      '                 G.NOMENCLATUR_NUM,'
      '                 G.BARCODE,'
      '                 G.NAME,'
      '                 G.PRICE,'
      '                 G.VOLUME_PRICE,'
      '                 G.PACK_AMOUNT,'
      '                 G.MF_COUNTRY,'
      '                 G.BRAND,'
      '                 G.CROSSCODE'
      '                 ,G.IS_ACTIVE'
      '                 ,G.PLACE'
      '                 ,G.SALES_COMM'
      '                 ,G.NOTE'
      #9#9' ,G.VES_GRAMM_PRICE'
      '                 ,G.VES_GRAMM'
      
        '                 ,(SELECT LIST(B.BARCODE) from LT_BARCODE B WHER' +
        'E B.G_PRODUCT = G.G_PRODUCT) AS BARCODE_DOP'
      '            FROM G_PRODUCT G'
      '           WHERE G.IS_CATEGORY = 0'
      
        '             AND G.IS_ACTIVE = :IS_ACTIVE_) T LEFT OUTER JOIN LT' +
        '_SKLAD_PRODUCT P ON T.G_PRODUCT = P.G_PRODUCT and P.G_TOCHKA = :' +
        'G_TOCHKA_'
      
        '    WHERE T.G_PRODUCT_PAR = DECODE(CAST(:G_PRODUCT_PAR_ AS BIGIN' +
        'T), -1, T.G_PRODUCT_PAR, CAST(:G_PRODUCT_PAR_ AS BIGINT))'
      '    ORDER BY 6')
    Transaction = tranRead
    Database = MainDM.dbMain
    Left = 16
    Top = 232
    poSQLINT64ToBCD = True
    poAskRecordCount = True
  end
