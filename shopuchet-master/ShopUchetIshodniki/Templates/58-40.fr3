isible := False;  &#13;&#10;      //Page1.PaperHeight := 28;&#13;&#10;    end else begin&#13;&#10;      if &#60;price&#62; = null then begin&#13;&#10;        m_Price.Visible := False;&#13;&#10;        {if &#60;name_t&#62; = null then          &#13;&#10;          m_Slogan.Top := 63&#13;&#10;        else&#13;&#10;          m_Slogan.Top := 97;                                          &#13;&#10;        {if &#60;name_t&#62; = null then&#13;&#10;          Page1.PaperHeight := 25                                                                                                              &#13;&#10;        else                  &#13;&#10;          Page1.PaperHeight := 33;}    &#13;&#10;      end;&#13;&#10;      if &#60;slogan&#62; = null then begin&#13;&#10;        m_Slogan.Visible := False;&#13;&#10;        {if &#60;name_t&#62; = null then&#13;&#10;          Page1.PaperHeight := 25                                                                                                              &#13;&#10;        else begin                            &#13;&#10;          m_Price.Top := 100;  &#13;&#10;          Page1.PaperHeight := 33;&#13;&#10;        end}    &#13;&#10;      end;&#13;&#10;    end;&#13;&#10;  end;              &#13;&#10;&#13;&#10;  if &#60;barcode8&#62; = null then&#13;&#10;    BarCode8.Visible := False;&#13;&#10;  if &#60;barcode13&#62; = null then&#13;&#10;    BarCode13.Visible := False;      &#13;&#10;end." PropData="">
