<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CleverApp.ScanPage">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Button
            Text="Сканировать удостоверение"
            Clicked="OnScanClicked" />

        <Image
            x:Name="previewImage"
            HeightRequest="250"
            Aspect="AspectFit" />

        <Label
            x:Name="resultLabel"
            FontSize="14"
            LineBreakMode="WordWrap" />

    </VerticalStackLayout>
</ContentPage>