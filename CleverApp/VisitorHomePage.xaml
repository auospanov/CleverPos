<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CleverApp.VisitorHomePage"
             Title="Журнал посетителей">

    <VerticalStackLayout Padding="30,40" Spacing="25">
        <Label
            x:Name="WelcomeLabel"
            Style="{StaticResource Headline}"
            HorizontalOptions="Center" />

        <Label
            Text="По какому вопросу:"
            FontSize="14" />

        <Picker
            x:Name="ReasonPicker"
            Title="Выберите причину визита"
            HorizontalOptions="Fill" />

        <Button
            Text="Сканировать удостоверение"
            Clicked="OnScanIdClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Выйти"
            Clicked="OnLogoutClicked"
            HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>
